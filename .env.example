# Public, non-secret URL of the separate Cloudflare Reports panel (opened from /admin/analytics, superadmin only).
# Must be https (http only for localhost). Leave unset until the owner approves: the page then shows "not connected".
# Staging example (protected by Cloudflare Access, do not set for production without the owner):
# VITE_ANALYTICS_REPORTS_URL=https://mybrev-analytics-reports-staging.slovo-app.workers.dev/reports
VITE_ANALYTICS_REPORTS_URL=

# Public URL of the SEPARATE feedback Worker (https; http only for localhost). Unset => the form says "not connected" and never fakes a success.
VITE_FEEDBACK_API_URL=
