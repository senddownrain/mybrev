{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/public-prayers-v1.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=1800"
          }
        ]
      },
      {
        "source": "/prayer-source-policy.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "regex": "^/((day|readings|ordo|prayer|p|prayers|settings|feedback|about|sources|documents|picker|compendium|songs|song|bible|login|admin)(/[^/.]+)*/?|index[.]html)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/registerSW.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/manifest.webmanifest",
        "destination": "/manifest.webmanifest"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "regex": "^/((day|readings|ordo|prayer|p|prayers|settings|feedback|about|sources|documents|picker|compendium|songs|song|bible|login|admin)(/[^/.]+)*/?)?$",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "node scripts/verify-public-prayers-hosting.mjs dist/public-prayers-v1.json"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8089
    },
    "ui": {
      "enabled": false
    }
  }
}
