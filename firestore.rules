    function v2GrantPermits(sets) {
      let grant = get(accessV2GrantPath(request.auth.uid)).data;
      return activeAccessV2Grant(grant, request.auth.uid) && accessV2ProfilePermits(grant.codeId, sets);
    }
    function v2CodeHasProfile(codeId, profileId) {
      let code = get(accessV2CodePath(codeId)).data;
      return code != null && code.profileId == profileId;
    }
    function v2MayReadEntitlements(profileId) {
      let grant = get(accessV2GrantPath(request.auth.uid)).data;
      return activeAccessV2Grant(grant, request.auth.uid) && v2CodeHasProfile(grant.codeId, profileId)
        && activeAccessV2Profile(profileId);
    }
    function v2MayResolveCode(codeId) {
      let grant = get(accessV2GrantPath(request.auth.uid)).data;
      return activeAccessV2Grant(grant, request.auth.uid) && grant.codeId == codeId;
    }
    function accessV2Permits(sets) {
