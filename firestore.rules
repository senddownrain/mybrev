    function accessV2ProfilePermits(codeId, sets) {
      let code = get(accessV2CodePath(codeId)).data;
      let profile = code == null ? null : get(accessV2ProfilePath(code.profileId)).data;
      return profile != null && profile.status == 'active' && profile.allowedSets.hasAny(sets);
