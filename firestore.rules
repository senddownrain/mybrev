rules_version = '2';

// Public liturgical content is anonymous. Prayers and their categories are
// served through priestApi (inherited restrictions); administrators edit them.
// Credentials and grants are accessible only to the server Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep in sync with src/constants/admin.js (bootstrap / emergency access).
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          '64MeSP56IWVotVFG7bu8YKeLis12',
          '7mszX2IiXHgjWxj0ZE5vEqdkmoD2'
        ]
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Who is an administrator: each user may check only their own entry;
    // the list is managed in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // All reader access goes through the server policy, including inherited tags.
    match /prayers/{id} {
      allow read, write: if isAdmin();
    }
    match /prayerCategories/{id} {
      allow read, write: if isAdmin();
    }
    // Credentials and grants are server-only, including for client-side admins.
    function serverOnly(collection) {
      return collection in ['priestAccess', 'priestDeviceGrants', 'priestInstallations', 'priestActivationAttempts'];
    }
    match /{collection}/{document=**} {
      allow read: if !(collection in ['admins', 'prayers', 'prayerCategories']) && !serverOnly(collection);
      allow write: if !(collection in ['admins', 'prayers', 'prayerCategories']) && !serverOnly(collection) && isAdmin();
    }
  }
}
