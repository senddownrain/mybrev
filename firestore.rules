        && validAccessV2Profile(request.resource.data)
        && request.resource.data.status == 'active' && request.resource.data.revision == 1
        && sameAccessV2Projection(request.resource.data, getAfter(accessV2EntitlementsPath(profileId)).data);
      allow update: if isAdmin() && validAccessV2Profile(request.resource.data)
