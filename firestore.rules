rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // `admins/{uid}`: no `role` => admin (legacy); `role` admin|superadmin. Any other explicit
    // role grants nothing (legacy UIDs below stay admin). Roles are written only via Console/Admin SDK.
    function legacyAdmin() {
      return request.auth.uid in ['64MeSP56IWVotVFG7bu8YKeLis12', '7mszX2IiXHgjWxj0ZE5vEqdkmoD2'];
    }
    function adminRecord() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') in ['admin', 'superadmin'];
    }
    function isAdmin() {
      return request.auth != null && (legacyAdmin() || adminRecord());
    }
    function hasGrant() {
      return request.auth != null
        && get(/databases/$(database)/documents/priestDeviceGrants/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/priestDeviceGrants/$(request.auth.uid)).data.uid == request.auth.uid;
    }
    function proof(value) { return value is string && value.matches('^[a-f0-9]{64}$'); }
    function shortText(value) { return value is string && value.size() <= 120; }
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function validGrant(uid, data) {
      return data.keys().hasOnly(['uid', 'status', 'deviceName', 'client', 'platform', 'label', 'activatedAt', 'lastActiveAt', 'revokedAt'])
        && data.keys().hasAll(['uid', 'status', 'deviceName', 'client', 'platform', 'label', 'activatedAt', 'lastActiveAt', 'revokedAt'])
        && data.uid == uid && data.status == 'active' && data.client in ['Web', 'Flutter']
        && shortText(data.deviceName) && data.deviceName.size() > 0 && shortText(data.platform) && shortText(data.label)
        && data.activatedAt == request.time && data.lastActiveAt == request.time && data.revokedAt == null;
    }
    function validClaim(uid, data) {
      return data.keys().hasOnly(['uid', 'activationProof', 'createdAt'])
        && data.keys().hasAll(['uid', 'activationProof', 'createdAt'])
        && data.uid == uid && data.createdAt == request.time
        && proof(data.activationProof)
        && data.activationProof == getAfter(/databases/$(database)/documents/priestAccess/settings).data.activeCodeProof;
    }
    function registerGrant(uid) {
      return own(uid)
        && !exists(/databases/$(database)/documents/priestActivationClaims/$(uid))
        && validGrant(uid, request.resource.data)
        && validClaim(uid, getAfter(/databases/$(database)/documents/priestActivationClaims/$(uid)).data);
    }
    function registerClaim(uid) {
      return own(uid)
        && !exists(/databases/$(database)/documents/priestDeviceGrants/$(uid))
        && validClaim(uid, request.resource.data)
        && validGrant(uid, getAfter(/databases/$(database)/documents/priestDeviceGrants/$(uid)).data);
    }
    function contentVersion() {
      return exists(/databases/$(database)/documents/priestContentControl/state)
        ? get(/databases/$(database)/documents/priestContentControl/state).data.version : 0;
    }
    function contentWrite() {
      return isAdmin()
        && legacyCatalogEditing()
        && (!exists(/databases/$(database)/documents/priestContentControl/state)
          || get(/databases/$(database)/documents/priestContentControl/state).data.lockUid == '')
        && getAfter(/databases/$(database)/documents/priestContentControl/state).data.version == contentVersion() + 1;
    }
    function legacyAccessFields() {
      return !request.resource.data.keys().hasAny(['accessSchemaVersion', 'accessSets', 'effectiveAccessSets', 'contentHash']);
    }
    function publicContent() {
      return legacyAccessFields() && request.resource.data.get('priestOnly', false) == false
        && request.resource.data.get('effectivePriestOnly', false) == false;
    }
    // Canonical names remain recognized by the import pipeline, while Web admins
    // may edit attribution freely (up to 500 characters). Preserve unchanged
    // historical longer values without opening access to non-admin writers.
    // BEGIN GENERATED PRAYER SOURCE NAMES
    function canonicalPrayerSource(value) {
      return value is string && value in [
        "",
        "Новы Запавет",
        "Рымскі Імшал",
        "Літургія гадзін",
        "Кампендый ККК",
        "«Парадак хросту дзяцей» (Мінск, 2026)",
        "«Парадак пакаяння» (Мінск, 2016)",
        "«Парадак намашчэння хворых» (Мінск, 2009)",
        "«Святая Камунія і культ эўхарыстычнай таямніцы па-за Імшой» (Мінск, 2017)",
        "Лекцыянарый",
        "«Літургічная агенда» (Мінск, 2010)",
        "«Божа, мы Цябе ўслаўляем» (Мінск, 2026)",
        "«Ойча наш» (Мінск, 2022)",
        "«Прасіце і атрымаеце» (Мінск, 2024)",
        "«Бог Добры» (Пінск, 2022)",
        "«Каб пазналі Цябе» (Гродна, 2014)",
        "Біблія (Чарняўскі)",
        "Библия. Синодальный перевод",
        "The Roman Missal",
        "Catholic.by",
        "Ave Maria",
        "katecheta.narod.ru",
        "kasciolhomiel.by",
        "Святое Пісанне"
      ];
    }
    // END GENERATED PRAYER SOURCE NAMES
    function editablePrayerSource(value) {
      return value is string && value.size() <= 500;
    }
    function validSourceField(field) {
      return !(field in request.resource.data)
        || canonicalPrayerSource(request.resource.data[field])
        || editablePrayerSource(request.resource.data[field])
        || (request.method == 'update' && field in resource.data
          && request.resource.data[field] == resource.data[field]);
    }
    function validSourceFields() {
      return validSourceField('source') && validSourceField('sourceBook');
    }
    function validPrayerSourceField(field, counterpart) {
      return validSourceField(field)
        || (request.method == 'create' && exists(counterpart)
          && field in get(counterpart).data
          && request.resource.data[field] == get(counterpart).data[field]);
    }
    function validPrayerSources(counterpart) {
      return validPrayerSourceField('source', counterpart)
        && validPrayerSourceField('sourceBook', counterpart);
    }
    match /admins/{uid} { allow read: if own(uid); allow write: if false; }
    // Physical separation preserves old Flutter queries with no new filters.
    match /prayers/{id} {
      allow read: if true;
      allow create, update: if contentWrite() && publicContent()
        && validPrayerSources(/databases/$(database)/documents/priestProtectedPrayers/$(id));
      allow delete: if contentWrite();
    }
    match /prayerCategories/{id} {
      allow read: if true;
      allow create, update: if contentWrite() && publicContent();
      allow delete: if contentWrite();
    }
    match /priestProtectedPrayers/{id} {
      allow read: if isAdmin() || hasGrant();
      allow create, update: if contentWrite() && legacyAccessFields()
        && validPrayerSources(/databases/$(database)/documents/prayers/$(id));
      allow delete: if contentWrite();
    }
    match /priestProtectedCategories/{id} {
      allow read: if isAdmin() || hasGrant();
      allow create, update: if contentWrite() && legacyAccessFields();
      allow delete: if contentWrite();
    }
    // Closed prayer drafts: admin-only in both directions (never a flag inside public `prayers`,
    // which older Flutter clients read in full). `admin` and `superadmin` are equal here; a priest
    // grant gives no access. Publishing is a single transaction that also writes the public prayer.
    // Historical rights/import fields remain allowed for editing old documents; they are not publication gates.
    function draftKeys() {
      return ['draftId', 'sourceId', 'sourceBook', 'sourceEdition', 'sourceSha256', 'sourcePageSpan', 'pdfPageStart', 'pdfPageEnd',
        'printedPageStart', 'printedPageEnd', 'originalEntryId', 'title', 'text', 'textFormat', 'source', 'tags', 'categoryIds',
        'copyrightNotices', 'rightsStatus', 'priestOnly', 'originBatch', 'origin', 'reason', 'flagReasons', 'possibleDuplicateIds',
        'status', 'version', 'fingerprint', 'createdBy', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt', 'publishedBy',
        'publishedAt', 'targetPrayerId', 'notes', 'rightsBasis', 'rightsConfirmedBy', 'rightsConfirmedAt'];
    }
    function validDraftFields(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.text is string && data.text.size() > 0 && data.text.size() <= 200000
        && data.textFormat == 'mybrev-markdown'
        && data.tags is list && data.tags.size() <= 40
        && data.status in ['draft', 'published']
        && data.get('priestOnly', false) is bool
        && data.version is int;
    }
    function validDraft(data) {
      return data.keys().hasOnly(draftKeys()) && validDraftFields(data);
    }
    // Historical imported drafts can contain extra fields not written by today's editor.
    // Keep them immutable, but do not reject an admin's edit or publish solely because
    // a legacy field exists. New drafts still require the strict draftKeys() allowlist.
    function validDraftEdit(data) {
      return validDraftFields(data)
        && data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'text', 'source', 'sourceBook', 'sourceEdition', 'tags',
          'categoryIds', 'priestOnly', 'notes', 'status', 'version', 'updatedAt',
          'publishedBy', 'publishedAt', 'targetPrayerId'
        ]);
    }
    function draftPublishedTarget(id, data) {
      return data.targetPrayerId is string
        && data.publishedBy == request.auth.uid && data.publishedAt == request.time
        && getAfter(/databases/$(database)/documents/priestContentControl/state).data.version == contentVersion() + 1
        && ((existsAfter(/databases/$(database)/documents/prayers/$(data.targetPrayerId))
            && getAfter(/databases/$(database)/documents/prayers/$(data.targetPrayerId)).data.get('sourceDraftId', '') == id)
          || (existsAfter(/databases/$(database)/documents/priestProtectedPrayers/$(data.targetPrayerId))
            && getAfter(/databases/$(database)/documents/priestProtectedPrayers/$(data.targetPrayerId)).data.get('sourceDraftId', '') == id));
    }
    match /prayerDrafts/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validDraft(request.resource.data) && validSourceFields() && request.resource.data.version == 1
        && request.resource.data.status == 'draft';
      allow update: if isAdmin() && validDraftEdit(request.resource.data) && validSourceFields()
        && resource.data.status != 'published'
        && request.resource.data.version == resource.data.version + 1
        && (request.resource.data.status != 'published' || draftPublishedTarget(id, request.resource.data));
      allow delete: if false;
      match /audit/{entry} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(['action', 'uid', 'at', 'fromStatus', 'toStatus', 'version', 'note', 'targetPrayerId'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.action is string && request.resource.data.action.size() <= 40;
        allow update, delete: if false;
      }
    }
    match /priestContentControl/state {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && legacyCatalogEditing()
        && request.resource.data.keys().hasOnly(['version', 'lockUid', 'updatedAt'])
        && request.resource.data.version == contentVersion() + 1
        && request.resource.data.lockUid == '' && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/priestContentControl/state) || resource.data.lockUid == '');
      allow delete: if false;
    }
    match /priestAccess/settings {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['activeCodeProof', 'changedAt', 'helpText'])
        && request.resource.data.helpText is string && request.resource.data.helpText.size() <= 1000
        && ((request.resource.data.activeCodeProof == '' && request.resource.data.changedAt == null)
          || (proof(request.resource.data.activeCodeProof)
            && (request.resource.data.changedAt == request.time
              || (resource != null && request.resource.data.activeCodeProof == resource.data.get('activeCodeProof', '') && request.resource.data.changedAt == resource.data.changedAt))));
      allow delete: if false;
    }
    match /priestAccessPublic/help {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['helpText'])
        && request.resource.data.helpText is string && request.resource.data.helpText.size() <= 1000
        && request.resource.data.helpText == getAfter(/databases/$(database)/documents/priestAccess/settings).data.helpText;
      allow delete: if isAdmin();
    }
    match /priestDeviceGrants/{uid} {
      // Legacy grants must be scrubbed by the Admin SDK before owner reads.
      allow get: if isAdmin() || (own(uid)
        && (resource == null || !resource.data.keys().hasAny(['activationProof'])));
      allow list: if isAdmin();
      allow create: if registerGrant(uid);
      allow update: if (own(uid) && resource.data.status == 'active'
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
            && request.resource.data.lastActiveAt == request.time
            && request.time >= resource.data.lastActiveAt + duration.value(1, 'h'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
            && request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time)))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'label'])
          && shortText(request.resource.data.label)
          && ((request.resource.data.status == resource.data.status && request.resource.data.revokedAt == resource.data.revokedAt)
            || (request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time)));
      allow delete: if false;
    }
    match /priestActivationClaims/{uid} {
      allow create: if registerClaim(uid);
      // getAfter() is an internal Rules check, not a client read permission.
      allow read, update, delete: if false;
    }

    // Canonical corpus and index writes require the trusted catalog writer.
    // Only a release operator can change mode. Legacy clients retain reads.
    function legacyCatalogEditing() {
      let rollout = get(/databases/$(database)/documents/priestContentControl/accessSetsV2);
      return rollout == null || (rollout.data.mode == 'legacy' && rollout.data.get('legacyWritesFrozen', false) == false);
    }
    function accessV2GrantPath(uid) {
      return /databases/$(database)/documents/accessDeviceGrantsV2/$(uid);
    }
    function accessV2ClaimPath(uid) {
      return /databases/$(database)/documents/accessActivationClaimsV2/$(uid);
    }
    function accessV2ProfilePath(profileId) {
      return /databases/$(database)/documents/accessProfilesV2/$(profileId);
    }
    function accessV2EntitlementsPath(profileId) {
      return /databases/$(database)/documents/accessProfilesV2/$(profileId)/client/entitlements;
    }
    function accessV2CodePath(codeId) {
      return /databases/$(database)/documents/accessCodesV2/$(codeId);
    }
    function accessV2CodeProfilePath(codeId) {
      return /databases/$(database)/documents/accessCodesV2/$(codeId)/client/profile;
    }
    function accessV2Live() {
      let state = get(/databases/$(database)/documents/priestContentControl/accessSetsV2);
      return state != null && state.data.mode == 'canonical';
    }
    function accessV2Id(value) {
      return value is string && value.matches('^[a-z][a-z0-9-]{0,63}$');
    }
    function accessV2CodeId(value) {
      return value is string && value.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ2-9]{16}$');
    }
    function accessV2SetIds(values) {
      let encoded = values is list ? values.join('!') : '';
      return values is list && (values.size() == 0
        || (encoded.split('!') == values && values.toSet().size() == values.size()
          && encoded.matches('^[a-z][a-z0-9-]{0,63}(![a-z][a-z0-9-]{0,63})*$')));
    }
    function validAccessV2Profile(data) {
      return data.keys().hasOnly(['name', 'status', 'allowedSets', 'revision', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && shortText(data.name)
        && data.status in ['active', 'disabled', 'revoked']
        && accessV2SetIds(data.allowedSets)
        && data.revision is int && data.revision > 0 && data.updatedAt == request.time;
    }
    function sameAccessV2Projection(profile, projection) {
      return profile != null && projection != null
        && projection.keys().hasOnly(['allowedSets', 'revision'])
        && projection.allowedSets == profile.allowedSets && projection.revision == profile.revision;
    }
    function validAccessV2Set(data, setId) {
      return accessV2Id(setId)
        && data.keys().hasOnly(['name', 'status', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && shortText(data.name)
        && data.status == 'active' && data.updatedAt == request.time;
    }
    function activeAccessV2Profile(profileId) {
      let profile = get(accessV2ProfilePath(profileId)).data;
      return profile != null && profile.status == 'active';
