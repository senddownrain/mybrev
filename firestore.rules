        && grant.activatedAt == request.time && grant.lastActiveAt == request.time
        && accessV2CodeAuthorizes(claim);
    }
    function activatingAccessV2(uid) {
      return own(uid) && request.auth.token.firebase.sign_in_provider == 'anonymous' && accessV2Live();
    }
    function activeAccessV2Grant(data, uid) {
      return data != null && data.uid == uid && data.status == 'active' && accessV2CodeId(data.codeId);
