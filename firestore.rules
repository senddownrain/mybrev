    function validAccessV2Code(data) {
      return data.keys().hasOnly(['profileId', 'codeProof', 'status', 'issuedAt', 'disabledAt', 'label'])
        && accessV2Id(data.profileId) && proof(data.codeProof) && shortText(data.label)
        && data.issuedAt is timestamp
        && ((data.status == 'active' && data.disabledAt == null)
          || (data.status == 'disabled' && data.disabledAt == request.time));
    }
    function sameAccessV2CodeProfile(code, projection) {
      return code != null && projection != null && projection.keys().hasOnly(['profileId'])
        && projection.profileId == code.profileId;
    }
    function validAccessV2Grant(uid, data) {
      return data.keys().hasOnly([
          'uid', 'codeId', 'status', 'deviceName', 'client', 'platform', 'label',
          'activatedAt', 'lastActiveAt', 'revokedAt'
        ])
        && data.uid == uid && accessV2CodeId(data.codeId)
        && data.deviceName is string && data.deviceName.size() > 0 && shortText(data.deviceName)
        && data.client in ['Web', 'Flutter'] && shortText(data.platform) && shortText(data.label)
        && data.activatedAt is timestamp && data.lastActiveAt is timestamp
        && ((data.status == 'active' && data.revokedAt == null)
          || (data.status == 'revoked' && data.revokedAt == request.time));
    }
    function validAccessV2Claim(uid, data) {
      return data != null && data.keys().hasOnly(['uid', 'codeId', 'activationProof', 'createdAt'])
        && data.uid == uid && accessV2CodeId(data.codeId)
        && proof(data.activationProof) && data.createdAt == request.time;
    }
    function accessV2CodeAuthorizes(claim) {
      let code = get(accessV2CodePath(claim.codeId)).data;
      return code != null && code.status == 'active'
        && code.codeProof == claim.activationProof && activeAccessV2Profile(code.profileId);
    }
    function validAccessV2Activation(uid, claim, grant) {
      return validAccessV2Claim(uid, claim) && grant != null && validAccessV2Grant(uid, grant)
