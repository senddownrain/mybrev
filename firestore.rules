    match /accessCodesV2/{codeId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && accessV2CodeId(codeId)
        && validAccessV2Code(request.resource.data) && request.resource.data.status == 'active'
        && request.resource.data.issuedAt == request.time && activeAccessV2Profile(request.resource.data.profileId)
        && sameAccessV2CodeProfile(request.resource.data, getAfter(accessV2CodeProfilePath(codeId)).data);
      allow update: if isAdmin() && resource.data.status == 'active'
        && validAccessV2Code(request.resource.data) && request.resource.data.status == 'disabled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disabledAt']);
      match /client/profile {
        allow get: if request.auth != null && accessV2Live() && v2MayResolveCode(codeId);
