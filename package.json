{
  "name": "mybrev",
  "version": "4.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-mdi-subset.mjs",
    "content:version:bump": "node scripts/bump-content-revision.mjs",
    "predev": "npm run icons:generate",
    "dev": "node --no-deprecation ./node_modules/vite/bin/vite.js",
    "prebuild": "npm run icons:generate",
    "build": "node --no-deprecation ./node_modules/vite/bin/vite.js build",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "release:hosting": "node scripts/ensure-clean-worktree.mjs && git push && npm run deploy:hosting",
    "preview": "node --no-deprecation ./node_modules/vite/bin/vite.js preview",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:responsive": "firebase emulators:exec --only firestore --project demo-responsive \"node scripts/smoke-responsive.mjs\"",
    "lint": "eslint . --fix",
    "db:backup": "node scripts/export-firestore-snapshot.mjs",
    "db:snapshot:query": "node scripts/query-firestore-snapshot.mjs",
    "db:audit-firestore-usage": "node scripts/audit-firestore-usage.mjs",
    "db:import-songs": "node scripts/import-songs.mjs",
    "db:import-mass-english": "node scripts/import-mass-english.mjs",
    "db:migrate-mass-content-v4": "node scripts/migrate-mass-content-v4.mjs",
    "db:migrate-mass-latin-rubrics-v4-1": "node scripts/migrate-mass-latin-rubrics-v4-1.mjs",
    "compendium:build": "node scripts/build-compendium.mjs",
    "compendium:check": "node scripts/build-compendium.mjs --check",
    "db:import-compendium": "node scripts/import-compendium.mjs",
    "db:migrate-core-collections": "node scripts/migrate-core-collections.mjs",
    "db:migrate-prayer-categories": "node scripts/migrate-prayer-categories.mjs",
    "db:migrate-priest-access": "node scripts/migrate-priest-access.mjs",
    "test:priest": "node --test tests/priest-*.test.mjs",
    "test:priest:rules": "firebase emulators:exec --only auth,firestore --project demo-rules \"node scripts/test-priest-emulator.mjs\"",
    "smoke:priest": "node scripts/smoke-priest-ui.mjs",
    "db:autofix-prayers": "node scripts/autofix-prayer-markdown.mjs",
    "db:normalize-prayers": "node scripts/normalize-prayer-legacy.mjs",
    "test:prayer-normalization": "node --test tests/prayer-normalization-stage2.test.mjs tests/prayer-formatting.test.mjs tests/prayer-markdown.test.mjs",
    "db:migrate-prayer-sources": "node scripts/migrate-prayer-sources.mjs",
    "db:fix-imported-prayer-sources": "node scripts/fix-imported-prayer-sources.mjs",
    "db:remove-rank-feast-comments": "node scripts/remove-rank-feast-comments.mjs",
    "audit:parsed-readings-content": "node scripts/audit-parsed-readings-content-integrity.mjs",
    "generate:fixed-feasts": "node patchs/generate-db-feasts.mjs",
    "audit:cli": "node scripts/audit-liturgical-data.mjs",
    "audit:fixed-feasts": "node scripts/audit-fixed-feasts.mjs",
    "audit:alternatives": "node scripts/audit-liturgical-alternatives.mjs",
    "audit:intercessions": "node scripts/cleanup-fixed-day-intercessions.mjs",
    "db:cleanup-intercessions": "node scripts/cleanup-fixed-day-intercessions.mjs",
    "db:cleanup-psalm-breaks": "node scripts/cleanup-psalm-cadence-breaks.mjs",
    "db:cleanup-reading-paragraphs": "node scripts/cleanup-reading-paragraphs.mjs",
    "db:cleanup-reading-structures": "node scripts/cleanup-reading-structures.mjs",
    "ordo:extract": "python3 scripts/ordo/extract.py && node scripts/ordo/build.mjs && node scripts/ordo/build-identities.mjs && node scripts/ordo/build-calendar-definitions.mjs",
    "ordo:build": "node scripts/ordo/build.mjs && node scripts/ordo/build-identities.mjs && node scripts/ordo/build-calendar-definitions.mjs",
    "ordo:identities": "node scripts/ordo/build-identities.mjs",
    "ordo:check": "node scripts/ordo/check.mjs && node scripts/ordo/build-identities.mjs --check && node scripts/ordo/build-calendar-definitions.mjs --check",
    "ordo:definitions": "node scripts/ordo/build-calendar-definitions.mjs",
    "ordo:import-calendar": "node scripts/ordo/import-calendar.mjs",
    "ordo:import-feasts": "node scripts/ordo/import-feasts.mjs",
    "ordo:audit-readings": "node scripts/ordo/audit-readings.mjs",
    "liturgy:audit": "node scripts/liturgy/audit.mjs",
    "liturgy:common-seasons": "node scripts/liturgy/common-seasons.mjs",
    "liturgy:common-seasons:check": "node scripts/liturgy/common-seasons.mjs --check",
    "liturgy:common-seasons:plan": "node scripts/liturgy/common-seasons-import-plan.mjs",
    "liturgy:common-seasons:fixture": "node scripts/liturgy/common-seasons-fixture.mjs",
    "liturgy:reading-references": "node scripts/liturgy/build-reading-references.mjs",
    "liturgy:repair-temporal": "node scripts/liturgy/repair-temporal-days.mjs",
    "ordo:docs": "node scripts/ordo/render-differences-doc.mjs",
    "ordo:validate": "node scripts/ordo/validate.mjs",
    "ordo:flutter-fixture": "node scripts/ordo/build-flutter-parity-fixture.mjs",
    "ordo:materialize-transfers": "node scripts/ordo/materialize-transfer-overrides.mjs",
    "ordo:fetch-cache": "node scripts/ordo-fetch-public-cache.mjs",
    "ordo:migrate-ranks": "node scripts/ordo-migrate-ranks.mjs",
    "ordo:missing-content": "node scripts/ordo-missing-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:audit": "node --test tests/liturgical-audit.test.mjs",
    "test:fixed-feasts": "node --test tests/fixed-feasts-audit.test.mjs",
    "test:alternatives": "node --test tests/liturgical-alternatives.test.mjs tests/pastors-hymns.test.mjs",
    "test:parsed-readings": "node --test tests/parsed-readings-identity.test.mjs tests/parsed-readings-content-integrity.test.mjs",
    "test:prayer-markdown": "node --test tests/prayer-markdown.test.mjs",
    "test:ordo": "node --test tests/ordo-*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules \"node tests/firestore-rules/rules-emulator.mjs\"",
    "content:app-bundle": "node scripts/content/build-app-bundle.mjs",
    "content:manifest": "node scripts/content/publish-manifest.mjs",
    "content:app-release": "node scripts/content/build-app-bundle.mjs --compare-live",
    "lectionary:crawl": "node scripts/lectionary/crawl-source.mjs",
    "lectionary:audit": "node scripts/lectionary/audit.mjs",
    "lectionary:resync": "node scripts/lectionary/resync-readings.mjs",
    "lectionary:plan": "node scripts/lectionary/plan-options.mjs",
    "db:migrate-priest-grant-proofs": "node scripts/migrate-priest-grant-proofs.mjs",
    "liturgy:common-seasons:scope": "node scripts/liturgy/common-seasons-import-scope.mjs",
    "test:common-seasons": "node --test tests/common-seasons-*.test.mjs",
    "analytics:perf": "firebase emulators:exec --only firestore --project demo-analytics-perf \"node scripts/analytics/perf-compare.mjs\"",
    "analytics:smoke": "firebase emulators:exec --only firestore --project demo-analytics-smoke \"node scripts/analytics/screens-smoke.mjs\"",
    "test:analytics": "node --test tests/analytics-*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@mdi/font": "^7.4.47",
    "@phosphor-icons/vue": "^2.2.1",
    "@sentry/vue": "^10.41.0",
    "@vueup/vue-quill": "^1.2.0",
    "codemirror": "^6.0.2",
    "date-fns": "^2.30.0",
    "firebase": "^10.14.1",
    "markdown-it": "^15.0.0",
    "moment": "^2.30.1",
    "node-html-parser": "^7.0.1",
    "pinia": "^2.2.6",
    "turndown": "^7.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint-plugin-vue": "^10.8.0",
    "firebase-admin": "^13.6.0",
    "playwright-core": "^1.63.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.83.0",
    "subset-font": "^2.9.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-vuetify": "^2.1.1"
  },
  "description": "Belarusian Catholic prayer book PWA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senddownrain/mybrev.git"
  },
  "keywords": [
    "prayer",
    "catholic",
    "belarusian",
    "pwa"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/senddownrain/mybrev/issues"
  },
  "homepage": "https://github.com/senddownrain/mybrev#readme"
