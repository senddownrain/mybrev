{
  "name": "mybrev",
  "version": "4.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-mdi-subset.mjs",
    "content:version:bump": "node scripts/bump-content-revision.mjs",
    "predev": "npm run icons:generate",
    "dev": "node --no-deprecation ./node_modules/vite/bin/vite.js",
    "prebuild": "npm run icons:generate",
    "build": "node --no-deprecation ./node_modules/vite/bin/vite.js build",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "release:hosting": "node scripts/ensure-clean-worktree.mjs && git push && npm run deploy:hosting",
    "preview": "node --no-deprecation ./node_modules/vite/bin/vite.js preview",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "lint": "eslint . --fix",
    "db:backup": "node scripts/export-firestore-snapshot.mjs",
    "db:snapshot:query": "node scripts/query-firestore-snapshot.mjs",
    "db:import-songs": "node scripts/import-songs.mjs",
    "db:import-mass-english": "node scripts/import-mass-english.mjs",
    "compendium:build": "node scripts/build-compendium.mjs",
    "compendium:check": "node scripts/build-compendium.mjs --check",
    "db:import-compendium": "node scripts/import-compendium.mjs",
    "db:migrate-core-collections": "node scripts/migrate-core-collections.mjs",
    "db:migrate-prayer-categories": "node scripts/migrate-prayer-categories.mjs",
    "db:autofix-prayers": "node scripts/autofix-prayer-markdown.mjs",
    "db:migrate-prayer-sources": "node scripts/migrate-prayer-sources.mjs",
    "db:fix-imported-prayer-sources": "node scripts/fix-imported-prayer-sources.mjs",
    "db:remove-rank-feast-comments": "node scripts/remove-rank-feast-comments.mjs",
    "audit:parsed-readings-content": "node scripts/audit-parsed-readings-content-integrity.mjs",
    "generate:fixed-feasts": "node patchs/generate-db-feasts.mjs",
    "audit:cli": "node scripts/audit-liturgical-data.mjs",
    "audit:fixed-feasts": "node scripts/audit-fixed-feasts.mjs",
    "audit:alternatives": "node scripts/audit-liturgical-alternatives.mjs",
    "audit:intercessions": "node scripts/cleanup-fixed-day-intercessions.mjs",
    "db:cleanup-intercessions": "node scripts/cleanup-fixed-day-intercessions.mjs",
    "db:cleanup-psalm-breaks": "node scripts/cleanup-psalm-cadence-breaks.mjs",
    "ordo:extract": "python3 scripts/ordo/extract.py && node scripts/ordo/build.mjs && node scripts/ordo/build-identities.mjs",
    "ordo:build": "node scripts/ordo/build.mjs && node scripts/ordo/build-identities.mjs",
    "ordo:identities": "node scripts/ordo/build-identities.mjs",
    "ordo:check": "node scripts/ordo/check.mjs && node scripts/ordo/build-identities.mjs --check",
    "ordo:docs": "node scripts/ordo/render-differences-doc.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:audit": "node --test tests/liturgical-audit.test.mjs",
    "test:fixed-feasts": "node --test tests/fixed-feasts-audit.test.mjs",
    "test:alternatives": "node --test tests/liturgical-alternatives.test.mjs",
    "test:parsed-readings": "node --test tests/parsed-readings-identity.test.mjs tests/parsed-readings-content-integrity.test.mjs",
    "test:prayer-markdown": "node --test tests/prayer-markdown.test.mjs",
    "test:ordo": "node --test tests/ordo-*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@mdi/font": "^7.4.47",
    "@phosphor-icons/vue": "^2.2.1",
    "@sentry/vue": "^10.41.0",
    "@vueup/vue-quill": "^1.2.0",
    "codemirror": "^6.0.2",
    "date-fns": "^2.30.0",
    "firebase": "^10.14.1",
    "markdown-it": "^15.0.0",
    "moment": "^2.30.1",
    "node-html-parser": "^7.0.1",
    "pinia": "^2.2.6",
    "turndown": "^7.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint-plugin-vue": "^10.8.0",
    "firebase-admin": "^13.6.0",
    "playwright-core": "^1.63.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.83.0",
    "subset-font": "^2.9.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-vuetify": "^2.1.1"
  },
  "description": "Belarusian Catholic prayer book PWA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senddownrain/mybrev.git"
  },
  "keywords": [
    "prayer",
    "catholic",
    "belarusian",
    "pwa"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/senddownrain/mybrev/issues"
  },
  "homepage": "https://github.com/senddownrain/mybrev#readme"
}
