    "v-calendar": "^3.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.0",
    "vuefire": "^3.2.2",
    "vuetify": "^3.7.4",
    "webfontloader": "^1.6.28"
