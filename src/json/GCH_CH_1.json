// lhcatholicby.GCH_CH_1

[{"GCH_CH_1_ID":"12","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">1, 1-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f\u043a\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u044f\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u0406\u043c \u043d\u0430\u0432\u0435\u043a\u0456. \u041c\u0430\u0440\u0441\u043a\u0456 \u043f\u044f\u0441\u043e\u043a, \u043a\u0440\u043e\u043f\u043b\u0456 \u0434\u0430\u0436\u0434\u0436\u0443 \u0456 \u0434\u043d\u0456 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0445\u0442\u043e \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c? \u041d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0432\u044b\u0441\u044c, \u0437\u044f\u043c\u043d\u0443\u044e \u0448\u044b\u0440, \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0445\u0442\u043e \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435? \u041f\u0435\u0440\u0448\u0430\u0439 \u0437 \u0443\u0441\u044f\u0433\u043e \u0431\u044b\u043b\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0440\u043e\u0437\u0443\u043c \u043c\u0443\u0434\u0440\u044b \u0456\u0441\u043d\u0443\u0435 \u0430\u0434\u0432\u0435\u043a\u0443. \u041a\u0430\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u045e\u0441\u044f \u043a\u043e\u0440\u0430\u043d\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456? \u0406 \u0445\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u044f\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b? \u0410\u0434\u0437\u0456\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0443\u0434\u0440\u044b \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0433\u0440\u043e\u0437\u043d\u044b, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0441\u0432\u0430\u0456\u043c. \u041f\u0430\u043d \u0441\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0435, \u0430\u0433\u043b\u0435\u0434\u0437\u0435\u045e, \u0456 \u0440\u0430\u0437\u043b\u0456\u0447\u044b\u045e \u044f\u0435, \u0456 \u043f\u0440\u0430\u043b\u0456\u045e \u044f\u0435 \u043d\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u0440\u0443, \u0456 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0451\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043b\u0430\u0432\u0430 \u0456 \u043f\u0430\u0445\u0432\u0430\u043b\u0430, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043d\u0435\u0446 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u0456. \u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0441\u044d\u0440\u0446\u0443, \u0434\u0430\u0435 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0434\u043e\u045e\u0433\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0422\u043e\u0439, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435 \u0434\u043e\u0431\u0440\u0430 \u045e \u043a\u0430\u043d\u0446\u044b: \u0443 \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b. \u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0456\u0445\u043d\u0456\u0445 \u043c\u0430\u0446\u0456. \u042f\u043d\u0430 \u0437\u0430\u043a\u043b\u0430\u043b\u0430 \u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u0435\u0447\u043d\u044b \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u043d\u0430 \u0436\u044b\u0446\u044c. \u041f\u0430\u045e\u043d\u0430\u0442\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430, \u044f\u043d\u0430 \u0430\u043f&rsquo;\u044f\u043d\u044f\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u043b\u0430\u0434\u0430\u043c\u0456. \u0423\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0456\u0445\u043d\u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043f\u0430\u0436\u0430\u0434\u0430\u043d\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c, \u0430 \u0456\u0445 \u0441\u0432\u0456\u0440\u043d\u044b &ndash; \u0441\u0432\u0430\u0456\u043c \u0443\u0440\u0430\u0434\u0436\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043d\u0435\u0446 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430, \u0448\u0442\u043e \u0434\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u045e\u0435. \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0433\u043b\u0435\u0434\u0437\u0435\u045e \u044f\u0435, \u043f\u0430\u043b\u0456\u0447\u044b\u045e, \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0440\u043e\u0437\u0443\u043c\u0443 \u043f\u0440\u0430\u043b\u0456\u045e, \u0431\u044b\u0446\u0446\u0430\u043c \u0434\u043e\u0436\u0434\u0436, \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u0445\u0432\u0430\u043b\u043e\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u0451\u0439 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u045e. \u041a\u043e\u0440\u0430\u043d\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430, \u0430 \u044f\u0435 \u0433\u0430\u043b\u0456\u043d\u044b &ndash; \u0434\u043e\u045e\u0433\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 1, 6. 9. 10. 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u045e\u0441\u044f \u043a\u043e\u0440\u0430\u043d\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456? \u041f\u0430\u043d \u043f\u0440\u0430\u043b\u0456\u045e \u044f\u0435 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0451\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u044f\u043a\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u044f\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u0406\u043c \u043d\u0430\u0432\u0435\u043a\u0456. <br \/><span style=\"color: #ff0000;\"><span style=\"color: #ff0000;\">\u041d<\/span>.<\/span> \u0406 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0451\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_1_ID":"13","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">11, 12-28<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430, \u044f\u043d\u044b \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0441\u0456\u043b\u044b \u0456 \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0441\u0442\u0440\u0430\u0448\u044d\u043d\u043d\u0430\u0439 \u0433\u0430\u043b\u0435\u0447\u044b. \u0410\u043b\u0435 \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u043d\u0430 \u0456\u0445; \u0401\u043d \u043f\u0430\u0434\u044b\u043c\u0435 \u0456\u0445 \u0437 \u0456\u0445\u043d\u044f\u0433\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u0446\u0435 \u0456 \u043d\u044f\u0434\u043e\u043b\u044f, \u0436\u044b\u0446\u0446\u0451 \u0456 \u0441\u043c\u0435\u0440\u0446\u044c, \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u041f\u0430\u043d\u0430. \u0414\u0430\u0440 \u041f\u0430\u043d\u0430 \u0441\u043f\u0430\u0447\u043d\u0435 \u043d\u0430 \u043b\u044e\u0434\u0437\u044f\u0445 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u0445, \u0430 \u042f\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u0446\u044c \u0456\u043c \u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u0439 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0441\u043a\u0432\u0430\u043f\u043d\u0430\u0441\u0446\u044e, \u0456 \u0433\u044d\u0442\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u044f\u0433\u043e; \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430: &laquo;\u042f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u043c\u0430\u0433\u0443 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456&raquo;, \u0451\u043d \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u0441\u0443 \u043c\u0456\u043d\u0435, \u0456 \u0451\u043d \u0456\u043d\u0448\u044b\u043c \u043f\u0430\u043a\u0456\u043d\u0435 \u0456\u0445 \u0456 \u043f\u0430\u043c\u0440\u044d.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u0431\u0443\u0434\u0437\u044c \u0432\u0435\u0440\u043d\u044b \u044f\u043c\u0443, \u043f\u0440\u0430\u0446\u0443\u0439 \u0430\u0436 \u0434\u0430 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456. \u041d\u0435 \u0434\u0437\u0456\u0432\u0456\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u0430\u043c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0430\u043b\u0435 \u0432\u0435\u0440 \u041f\u0430\u043d\u0443 \u0456 \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b, \u0431\u043e \u043b\u0451\u0433\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0445\u0443\u0442\u043a\u0430 \u0456 \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u0446\u044c \u0431\u0435\u0434\u043d\u0430\u0433\u0430. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u0445, \u0456 \u0445\u0443\u0442\u043a\u0430 \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u042f\u0433\u043e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041d\u0435 \u043a\u0430\u0436\u044b: &laquo;\u0428\u0442\u043e \u043c\u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0456 \u044f\u043a\u043e\u0435 \u0434\u0430\u0431\u0440\u043e \u043c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043c\u0435\u0446\u044c \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c?&raquo; \u041d\u0435 \u043a\u0430\u0436\u044b: &laquo;\u042f \u0441\u0430\u043c\u0430\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u044b \u0456 \u044f\u043a\u043e\u0435 \u043b\u0456\u0445\u0430 \u043c\u043e\u0436\u0430 \u043c\u044f\u043d\u0435 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0446\u044c?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0447\u0430\u0441 \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u043d\u044f\u0434\u043e\u043b\u044e, \u0430 \u045e \u0447\u0430\u0441 \u043d\u044f\u0434\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u043f\u043e\u0441\u043f\u0435\u0445. \u0414\u043b\u044f \u041f\u0430\u043d\u0430 \u043b\u0451\u0433\u043a\u0430 \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u043c\u0435\u0440\u0446\u0456 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437\u0430 \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u043a\u0456. \u0413\u0430\u0434\u0437\u0456\u043d\u0430 \u043d\u044f\u0434\u043e\u043b\u0456 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0435 \u0437\u0430\u0431\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442, \u0456 \u045e \u043a\u0430\u043d\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043d\u0430 \u044f\u0432\u0443 \u0441\u043f\u0440\u0430\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u041d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0439 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430 \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u043a\u043e\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 11, 19; \u043f\u0430\u0440. \u041b\u043a 12, 17. 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0431\u0430\u0433\u0430\u0442\u044b \u043a\u0430\u0436\u0430: \u042f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u043c\u0430\u0433\u0443 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0451\u043d \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u0441\u0443 \u043c\u0456\u043d\u0435, \u0456 \u0451\u043d \u0456\u043d\u0448\u044b\u043c \u043f\u0430\u043a\u0456\u043d\u0435 \u0456\u0445 \u0456 \u043f\u0430\u043c\u0440\u044d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0430\u0433\u0430\u0442\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u0441\u0430\u043c-\u043d\u0430\u0441\u0430\u043c: \u041f\u0430\u043b\u0430\u043c\u0430\u044e \u0437\u0430\u0441\u0435\u043a\u0456 \u043c\u0430\u0435 \u0456 \u0437\u0431\u0443\u0434\u0443\u044e \u0431\u043e\u043b\u044c\u0448\u044b\u044f, \u0456 \u0437\u0431\u044f\u0440\u0443 \u0442\u0443\u0434\u044b \u045e\u0441\u0451 \u0434\u0430\u0431\u0440\u043e \u043c\u0430\u0451.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u0441\u0443 \u043c\u0456\u043d\u0435, \u0456 \u0451\u043d \u0456\u043d\u0448\u044b\u043c \u043f\u0430\u043a\u0456\u043d\u0435 \u0456\u0445 \u0456 \u043f\u0430\u043c\u0440\u044d.<\/p>\r\n"}, {"GCH_CH_1_ID":"14","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">24, 1-23<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0445\u0432\u0430\u043b\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0443 \u0451\u0439 \u0441\u0430\u043c\u043e\u0439, \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u044f\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. \u041d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u044f\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u0435 \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435 \u0456 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u045e\u0441\u0445\u0432\u0430\u043b\u044f\u0435 \u0441\u044f\u0431\u0435:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f \u0432\u044b\u0439\u0448\u043b\u0430 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0442\u0443\u043c\u0430\u043d\u0430\u043c, \u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u0437\u044f\u043c\u043b\u044e. \u042f \u0436\u044b\u0432\u0443 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0456 \u043c\u043e\u0439 \u0442\u0440\u043e\u043d &ndash; \u0443 \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0430\u0434\u043d\u0430 \u0430\u0431\u044b\u0448\u043b\u0430 \u043d\u0435\u0431\u0430\u0441\u0445\u0456\u043b \u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u043b\u0430 \u045e \u0431\u044f\u0437\u0434\u043e\u043d\u043d\u0443\u044e \u0433\u043b\u044b\u0431. \u041d\u0430 \u0445\u0432\u0430\u043b\u044f\u0445 \u043c\u043e\u0440\u0430, \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u0439, \u043f\u0430-\u043d\u0430\u0434 \u043a\u043e\u0436\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u043f\u043b\u0435\u043c\u0435\u043c \u044f \u0437\u0434\u0430\u0431\u044b\u043b\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435. \u0421\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0456\u0445 \u044f \u0448\u0443\u043a\u0430\u043b\u0430 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u0443 \u0447\u044b\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u044f \u0437\u043c\u0430\u0433\u0443 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0443\u0441\u044f\u0433\u043e, \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435, \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u043c\u0430\u0439\u0433\u043e \u0448\u0430\u0442\u0440\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0423 \u042f\u043a\u0443\u0431\u0435 \u043f\u0430\u0441\u044f\u043b\u0456\u0441\u044f \u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043f\u0440\u044b\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435, \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0443 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c&rdquo;. \u0423 \u0441\u0432\u044f\u0442\u044b\u043c \u0448\u0430\u0442\u0440\u044b \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u044f \u0441\u043b\u0443\u0436\u044b\u043b\u0430 \u0456 \u0442\u0430\u043a \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u0421\u0456\u0451\u043d\u0435. \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u045e \u043c\u043d\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u045e\u043b\u0430\u0434\u0430 \u043c\u0430\u044f. \u0423\u043a\u0430\u0440\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u044f \u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0437\u0435, \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0430, \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u044b\u0440\u0430\u0441\u043b\u0430, \u044f\u043a \u043a\u0435\u0434\u0440 \u0443 \u041b\u0456\u0431\u0430\u043d\u0435, \u044f\u043a \u043a\u0456\u043f\u0430\u0440\u044b\u0441 \u0443 \u0433\u0430\u0440\u0430\u0445 \u0413\u0435\u0440\u043c\u043e\u043d\u0430. \u042f \u0432\u044b\u0440\u0430\u0441\u043b\u0430, \u044f\u043a \u043f\u0430\u043b\u044c\u043c\u0430 \u045e \u042d\u0439\u043d-\u0413\u0435\u0434\u0437\u0456, \u044f\u043a \u043a\u0443\u0441\u0442\u044b \u0440\u0443\u0436\u044b \u045e \u0415\u0440\u044b\u0445\u043e\u043d\u0435, \u044f\u043a \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f \u0430\u043b\u0456\u0432\u0430 \u043d\u0430 \u0440\u0430\u045e\u043d\u0456\u043d\u0435, \u0440\u0430\u0437\u0440\u0430\u0441\u043b\u0430\u0441\u044f, \u044f\u043a \u043f\u043b\u0430\u0442\u0430\u043d. \u042f\u043a \u043a\u0430\u0440\u044b\u0446\u0430 \u0456 \u0430\u043a\u0430\u0446\u044b\u044f, \u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0432\u043e\u0434\u0430\u0440\u0430\u043c \u0443\u0441\u0451, \u044f\u043a \u0430\u0434\u0431\u043e\u0440\u043d\u0430\u0435 \u043c\u0456\u0440\u0430, \u044f\u043a \u0433\u0430\u043b\u044c\u0431\u0430\u043d, \u043e\u043d\u0456\u043a\u0441, \u043b\u0430\u0434\u0430\u043d \u0456 \u043f\u0430\u0445 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u045e \u0448\u0430\u0442\u0440\u044b. \u042f\u043a \u0442\u044d\u0440\u044d\u0431\u0456\u043d\u0442, \u044f \u0440\u0430\u0441\u043a\u0456\u043d\u0443\u043b\u0430 \u0441\u0432\u0430\u0435 \u0433\u0430\u043b\u0456\u043d\u044b &ndash; \u0433\u0430\u043b\u0456\u043d\u044b \u0441\u043b\u0430\u0432\u044b \u0456 \u043b\u0430\u0441\u043a\u0456. \u042f\u043a \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u043f\u0443\u0441\u0446\u0456\u043b\u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456, \u0430 \u043c\u0430\u0435 \u043a\u0432\u0435\u0442\u043a\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u043f\u043b\u0451\u043d \u0441\u043b\u0430\u0432\u044b \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u043c\u044f\u043d\u0435, \u043d\u0430\u0441\u044b\u0446\u044c\u0446\u0435\u0441\u044f \u043c\u0430\u0456\u043c\u0456 \u043f\u043b\u0430\u0434\u0430\u043c\u0456. \u041f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u043c\u0451\u0434, \u0430 \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u0435 \u043c\u043d\u043e\u0439 \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u0441\u043e\u0442\u044b. \u0425\u0442\u043e \u043c\u044f\u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435, \u0437\u0430\u0445\u043e\u0447\u0430 \u044f\u0448\u0447\u044d, \u0430 \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u043f&rsquo;\u0435, \u0442\u043e\u0439 \u0434\u0430\u043b\u0435\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u043c\u0430\u0433\u043d\u0443\u0446\u044c. \u0425\u0442\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u043c\u043d\u0435, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u0435 \u0441\u043e\u0440\u0430\u043c\u0443, \u0430 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435, \u043d\u0435 \u0441\u0430\u0433\u0440\u0430\u0448\u044b\u0446\u044c&raquo;.<br \/>\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 &ndash; \u043a\u043d\u0456\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0417\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439 \u044f\u043a \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c \u042f\u043a\u0443\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 14, 6; \u0421\u0456\u0440 24, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0410\u0439\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u041c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435, \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0443 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0410\u0439\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u041c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"15","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">42, 15 &ndash; 43, 12<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0436\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0431\u0443\u0434\u0443 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430 \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u045e. \u0423 \u0441\u043b\u043e\u0432\u0430\u0445 \u041f\u0430\u043d\u0430 &ndash; \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0421\u043e\u043d\u0446\u0430, \u044f\u043a\u043e\u0435 \u0441\u0432\u0435\u0446\u0456\u0446\u044c, \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u045e\u0441\u0451, \u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u045e\u0441\u0435 \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u041d\u0430\u0432\u0430\u0442 \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u043d\u0435 \u045e\u043f\u0430\u045e\u043d\u0430\u0432\u0430\u0436\u044b\u045e \u041f\u0430\u043d \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0446\u0443\u0434\u044b, \u044f\u043a\u0456\u044f \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u041f\u0430\u043d, \u043a\u0430\u0431 \u0443\u0441\u0451 \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u043b\u0430\u0441\u044f \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0456 \u0441\u044d\u0440\u0446\u0430, \u0456 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0456\u0445 \u0445\u0456\u0442\u0440\u0430\u0441\u0446\u044c, \u0431\u043e \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0432\u0430\u043b\u043e\u0434\u0430\u0435 \u045e\u0441\u0456\u043c\u0456 \u0432\u0435\u0434\u0430\u043c\u0456 \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0437\u043d\u0430\u043a\u0456 \u0447\u0430\u0441\u0443. \u0401\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0456\u043d\u0443\u043b\u0430 \u0456 \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435, \u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u043b\u044f\u0434\u044b \u0442\u0430\u0435\u043c\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e. \u041d\u0435 \u0430\u0431\u043c\u0456\u043d\u0435 \u044f\u0433\u043e \u043d\u0456\u044f\u043a\u0430\u044f \u0434\u0443\u043c\u043a\u0430, \u0430\u0434 \u042f\u0433\u043e \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. \u0401\u043d \u0443\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u0431\u043e \u0401\u043d \u0456\u0441\u043d\u0443\u0435 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u042f\u0433\u043e \u043d\u0435 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u0456 \u043d\u0435 \u0430\u0434\u043d\u044f\u043b\u0456 \u045e \u042f\u0433\u043e, \u0401\u043d \u043d\u0435 \u043c\u0430\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043d\u0456 \u045e \u044f\u043a\u0456\u043c \u0434\u0430\u0440\u0430\u0434\u0446\u044b. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u043d\u044b\u044f \u045e\u0441\u0435 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044b, \u0445\u043e\u0446\u044c \u0456\u0441\u043a\u0440\u0430\u0439 \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043c. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0436\u044b\u0432\u0435 \u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u043f\u0430\u0442\u0440\u044d\u0431\u0435 \u045e\u0441\u0451 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u042f\u043c\u0443. \u0423\u0441\u0451 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0435, \u0430\u0434\u043d\u043e \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443. \u0410\u0434\u043d\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u0456 \u0445\u0442\u043e \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e\u043d\u0443\u044e?<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u043d\u0430\u0440 \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f \u0447\u044b\u0441\u0446\u0456\u043d\u0456 &ndash; \u0442\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043a\u0430\u0440\u0446\u0456\u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043a\u0440\u0430\u0441\u044b. \u0417&rsquo;\u044f\u045e\u043b\u044f\u044e\u0447\u044b\u0441\u044f, \u0441\u043e\u043d\u0446\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u043d\u0430\u043c \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0435, \u0448\u0442\u043e \u044f\u043d\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430. \u0410\u043f\u043e\u045e\u0434\u043d\u0456 \u044f\u043d\u043e \u0432\u044b\u0441\u0443\u0448\u0432\u0430\u0435 \u0437\u044f\u043c\u043b\u044e, \u0445\u0442\u043e \u0436 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0435 \u0436\u0430\u0440 \u044f\u0433\u043e\u043d\u044b? \u0420\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u044e\u0446\u044c \u0433\u043e\u0440\u0430\u043d \u0434\u043b\u044f \u043f\u043b\u0430\u045e\u043a\u0456, \u0430\u043b\u0435 \u0441\u043e\u043d\u0446\u0430 \u045e\u0442\u0440\u0430\u044f \u043c\u0430\u0446\u043d\u0435\u0439 \u043f\u0430\u043b\u0456\u0446\u044c \u0433\u043e\u0440\u044b, \u043f\u0430\u0442\u044b\u0445\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u0456 \u0437\u0456\u0445\u0446\u0456\u0446\u044c \u043f\u0440\u0430\u043c\u0435\u043d\u043d\u0435\u043c, \u0430\u0441\u043b\u044f\u043f\u043b\u044f\u044e\u0447\u044b \u0432\u043e\u0447\u044b. \u0412\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430 \u044f\u043d\u043e \u043f\u0430\u0441\u043f\u0435\u0448\u043d\u0430 \u043f\u0440\u0430\u0431\u044f\u0433\u0430\u0435 \u0448\u043b\u044f\u0445 \u0441\u0432\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u0441\u044f\u0446 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443\u0441\u0456\u043c \u0443 \u0441\u0432\u0430\u044e \u043f\u0430\u0440\u0443, \u043a\u0430\u0431 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0447\u0430\u0441 \u0456 \u0431\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u044b\u043c \u0437\u043d\u0430\u043a\u0430\u043c. \u041c\u0435\u0441\u044f\u0446 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435 \u0434\u043d\u0456 \u0441\u0432\u044f\u0442\u0430\u045e, \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u043c\u044f\u043d\u0448\u0430\u0435\u0446\u0446\u0430, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e\u0448\u044b \u043f\u043e\u045e\u043d\u0456. \u041c\u0435\u0441\u044f\u0446 \u0430\u0434 \u044f\u0435 \u0431\u044f\u0440\u044d \u0441\u0432\u0430\u0451 \u0456\u043c\u044f. \u0401\u043d \u0434\u0437\u0456\u045e\u043d\u0430 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u043c\u0435\u0440\u044b. \u0401\u043d \u0448\u0442\u0430\u043d\u0434\u0430\u0440 \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u0443 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u044f\u043a\u0456 \u043b\u0443\u043d\u0430\u0435 \u043d\u0430 \u043d\u0435\u0431\u0430\u0441\u0445\u0456\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043e\u0440\u0430\u043a \u043a\u0440\u0430\u0441\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u043d\u0435\u0431\u0430, \u044f\u043a\u0430\u044f \u0437\u0437\u044f\u0435 \u0430\u0437\u0434\u043e\u0431\u0430\u0439 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u041f\u0430\u043d\u0430. \u041d\u0430 \u0437\u0430\u0433\u0430\u0434 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u044f\u043d\u044b \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u0441\u0443\u0434\u0443 \u0456 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0432\u0430\u0440\u0442\u0443.<br \/>\u0413\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0432\u044f\u0441\u0451\u043b\u043a\u0443 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u044f\u0435 \u045e\u0447\u044b\u043d\u0456\u045e, \u044f\u043d\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u0437\u0437\u044f\u043d\u043d\u0456! \u0406 \u0430\u0445\u0456\u043d\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u043a\u043e\u043b\u0430\u043c, \u0430 \u043d\u0430\u0446\u044f\u0433\u043d\u0443\u043b\u0456 \u044f\u0435 \u0440\u0443\u043a\u0456 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 4, 11; \u043f\u0430\u0440. \u042d\u0441\u0442 4, 17\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u043d\u0430\u0448 \u041f\u0430\u043d\u0435, \u0422\u044b \u0433\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u0456 \u043f\u0430\u0448\u0430\u043d\u0443, \u0456 \u0441\u0456\u043b\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451, \u0456 \u0437 \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0456 \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451: \u043d\u0435\u0431\u0430, \u0437\u044f\u043c\u043b\u044e \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439. \u0422\u044b &ndash; \u041f\u0430\u043d \u0441\u0443\u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451, \u0456 \u0437 \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0456 \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"16","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">43, 13-33<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0432\u0430\u043b\u0430 \u0411\u043e\u0433\u0430 \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u0430\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u043c \u041f\u0430\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0441\u043d\u0435\u0433 \u0456 \u043f\u0430\u0434\u0433\u0430\u043d\u044f\u0435 \u043c\u0430\u043b\u0430\u043d\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0443\u0434\u0430. \u0410\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b, \u0456 \u0432\u044b\u043b\u044f\u0442\u0430\u044e\u0446\u044c \u0437 \u0456\u0445 \u0430\u0431\u043b\u043e\u043a\u0456, \u044f\u043a \u043f\u0442\u0443\u0448\u043a\u0456. \u041c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439 \u0401\u043d \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0430\u0431\u043b\u043e\u043a\u0456 \u0456 \u0440\u0430\u0437\u0431\u0456\u0432\u0430\u0435 \u043a\u0443\u043b\u0456 \u0433\u0440\u0430\u0434\u0443. \u0410\u0434 \u043f\u043e\u0437\u0456\u0440\u043a\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0442\u0440\u0430\u0441\u0443\u0446\u0446\u0430 \u0433\u043e\u0440\u044b, \u0430 \u043d\u0430 \u0437\u0430\u0433\u0430\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u0434\u0437\u044c\u043c\u0435 \u043f\u0430\u045e\u0434\u043d\u0451\u0432\u044b \u0432\u0435\u0446\u0435\u0440. \u0413\u043e\u043b\u0430\u0441 \u0433\u0440\u043e\u043c\u0443 \u042f\u0433\u043e \u043a\u0430\u0440\u0430\u0435 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a \u0431\u0443\u0440\u0430 \u043f\u0430\u045e\u043d\u043e\u0447\u043d\u0430\u0433\u0430 \u0432\u0435\u0442\u0440\u0443 \u0456 \u0432\u0456\u0445\u0443\u0440\u0430. \u0401\u043d \u0441\u044b\u043f\u0435 \u0441\u043d\u0435\u0433, \u044f\u043a \u043f\u0430\u043b\u0451\u0442 \u043f\u0442\u0443\u0448\u0430\u043a \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430 \u044f\u0433\u043e \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 &ndash; \u044f\u043a \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0441\u0430\u0440\u0430\u043d\u0447\u044b. \u041a\u0440\u0430\u0441\u0430 \u044f\u0433\u043e\u043d\u0430\u0439 \u0431\u0435\u043b\u0456 \u0434\u0437\u0456\u0432\u0456\u0446\u044c \u0432\u043e\u043a\u0430, \u0430 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u044f\u0433\u043e \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0441\u043e\u043b\u044c, \u0401\u043d \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u0435 \u0456\u043d\u0435\u0439 \u043f\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456 \u0437\u0430\u043c\u044f\u0440\u0437\u0430\u0435 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0432\u043e\u0441\u0442\u0440\u0430\u043a\u0430\u043d\u0435\u0447\u043d\u044b\u043c. \u041f\u0430\u0434\u0437\u044c\u043c\u0435 \u043f\u0430\u045e\u043d\u043e\u0447\u043d\u044b \u0432\u0435\u0446\u0435\u0440, \u0456 \u0432\u0430\u0434\u0430 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u043b\u0451\u0434, \u0432\u0430\u0434\u0430 \u044f\u043a \u0431\u044b \u0430\u043f\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0430\u0441\u043f\u0435\u0445\u0456. \u0406 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435 \u0433\u043e\u0440\u044b, \u0432\u044b\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u0442\u044d\u043f \u0456, \u044f\u043a \u0430\u0433\u043e\u043d\u044c, \u043f\u0430\u0436\u044b\u0440\u0430\u0435 \u0442\u0440\u0430\u0432\u0443. \u0410\u043b\u0435 \u0445\u0443\u0442\u043a\u0430 \u045e\u0441\u0451 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435 \u0442\u0443\u043c\u0430\u043d, \u0440\u0430\u0441\u0430, \u0448\u0442\u043e \u0430\u043f\u0430\u0434\u0430\u0435 \u043f\u0430\u0441\u043b\u044f \u0441\u043f\u0451\u043a\u0456, \u0434\u0430\u0435 \u043f\u0440\u0430\u0445\u0430\u043b\u043e\u0434\u0443. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u043c\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u041f\u0430\u043d \u0443\u0442\u0430\u0439\u043c\u0430\u0432\u0430\u045e \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0456 \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u0443 \u0451\u0439 \u0430\u0441\u0442\u0440\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0440\u0430\u043f\u043b\u0430\u045e\u0446\u044b \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0456 \u043c\u044b \u0434\u0437\u0456\u0432\u0456\u043c\u0441\u044f \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0447\u0443\u044e\u0446\u044c \u043d\u0430\u0448\u044b \u0432\u0443\u0448\u044b. \u0411\u043e \u0442\u0430\u043c \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u044f\u043a\u0456\u0445 \u0436\u044b\u0432\u0451\u043b \u0456 \u0441\u0432\u0435\u0442 \u043c\u0430\u0440\u0441\u043a\u0456\u0445 \u043f\u0430\u0447\u0432\u0430\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u041f\u0430\u043d\u0443 \u045e\u0441\u0451 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u0430 \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f, \u0456 \u045e\u0441\u0451 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430\u043c \u042f\u0433\u043e. \u041c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0448\u043c\u0430\u0442 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0435\u043c \u042f\u0433\u043e, \u0430 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0431\u0443\u0434\u0437\u0435: \u0401\u043d \u0451\u0441\u0446\u044c \u0443\u0441\u0456\u043c. \u0414\u0437\u0435 \u043c\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u043c \u0441\u0456\u043b\u0443, \u043a\u0430\u0431 \u0434\u0430\u043b\u0435\u0439 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e? \u0411\u043e \u0401\u043d \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b. \u041f\u0430\u043d \u0433\u0440\u043e\u0437\u043d\u044b \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456, \u0434\u0437\u0456\u045e\u043d\u0430\u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430!<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u041f\u0430\u043d\u0430, \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439\u0446\u0435 \u042f\u0433\u043e, \u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u0430\u0446\u0435, \u0430\u043b\u0435 \u0456 \u0442\u0430\u043a \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u044b. \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u042f\u0433\u043e, \u0437\u0431\u044f\u0440\u044b\u0446\u0435 \u0441\u0456\u043b\u044b, \u043d\u0435 \u0441\u0442\u0430\u043c\u043b\u044f\u0439\u0446\u0435\u0441\u044f, \u0431\u043e \u0456 \u0442\u0430\u043a \u043d\u0435 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0435\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0447\u044b\u045e \u0456 \u043c\u043e\u0433 \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u042f\u0433\u043e \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435? \u0401\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u044b\u0445 \u0437\u0430 \u0442\u044b\u044f, \u0431\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u0433\u043e \u043d\u0435\u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451 \u0456 \u0434\u0430\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0421\u0456\u0440 43, 27. 28<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u041f\u0430\u043d\u0430, \u043c\u044b \u0448\u043c\u0430\u0442 \u043c\u0430\u0433\u043b\u0456 \u0431 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0430\u043b\u0435 \u045e\u0441\u044f\u0433\u043e \u043d\u0435 \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u044b\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435\u043c \u0443\u0441\u0456\u0445 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u045e \u0431\u0443\u0434\u0437\u0435 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430\u043c \u0434\u0430\u043b\u0435\u0439 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e, \u0434\u0437\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u043c \u0441\u0456\u043b\u044b? \u0401\u043d \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b. <span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435\u043c \u0443\u0441\u0456\u0445 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u045e \u0431\u0443\u0434\u0437\u0435 \u041f\u0430\u043d.<\/p>\r\n"}, {"GCH_CH_1_ID":"17","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">44, 1-2. 16 &ndash; 45, 5<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0445\u0432\u0430\u043b\u0430 \u0430\u0439\u0446\u043e\u045e: \u0430\u0434 \u042d\u043d\u043e\u0445\u0430 \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u0456 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0434\u0443. \u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043f\u0440\u0430\u0437 \u0456\u0445 \u0448\u043c\u0430\u0442 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430, \u0432\u0435\u043b\u0456\u0447 \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042d\u043d\u043e\u0445 \u043f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u041f\u0430\u043d\u0443 \u0456 \u0431\u044b\u045e \u0443\u0437\u044f\u0442\u044b \u045e \u043d\u0435\u0431\u0430 \u044f\u043a \u0432\u043e\u0431\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0434\u043b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0439 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c, \u043f\u0430\u0434\u0447\u0430\u0441 \u0433\u043d\u0435\u0432\u0443 \u0431\u044b\u045e \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435\u043c; \u0442\u0430\u043c\u0443 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043c\u0443 \u0430\u0446\u0430\u043b\u0435\u043b\u0430 \u0440\u044d\u0448\u0442\u0430 \u0434\u043b\u044f \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0430\u0442\u043e\u043f. \u041f\u0430\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0456\u043c \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u043a\u0430\u0431 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u043f\u0430\u0442\u043e\u043f\u0430\u043c \u0443\u0441\u044f\u0433\u043e \u0436\u044b\u0432\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0440\u0430\u0433\u0430\u043c &ndash; \u0432\u044f\u043b\u0456\u043a\u0456 \u0430\u0439\u0446\u0435\u0446 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0440\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0437 \u0456\u043c \u0443 \u0445\u0432\u0430\u043b\u0435. \u0401\u043d \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0437\u0430\u043a\u043e\u043d \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0456 \u0431\u044b\u045e \u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u0437 \u0406\u043c, \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u0437\u0430\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c \u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0437 \u043a\u043b\u044f\u0442\u0432\u0430\u044e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u044f\u043c\u0443, \u0448\u0442\u043e \u045e \u044f\u0433\u043e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b; \u0430\u0431\u044f\u0446\u0430\u045e \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u044f\u0433\u043e \u044f\u043a \u043f\u044f\u0441\u043e\u043a \u0437\u044f\u043c\u043b\u0456, \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u044f\u0433\u043e \u044f\u043a \u0437\u043e\u0440\u043a\u0456, \u0434\u0430\u0446\u044c \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0456\u043c \u0430\u0434 \u043c\u043e\u0440\u0430 \u0434\u0430 \u043c\u043e\u0440\u0430 \u0456 \u0430\u0434 \u0440\u0430\u043a\u0456 \u0430\u0436 \u0434\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435 \u0436 \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u0406\u0441\u0430\u0430\u043a\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u044f\u0433\u043e. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0441\u0432\u043e\u0439 \u0443\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u042f\u043a\u0443\u0431\u0430; \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u044f\u0433\u043e \u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u0445, \u0434\u0430\u045e \u044f\u043c\u0443 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e, \u0430\u0434\u043c\u0435\u0440\u0430\u045e \u044f\u0435 \u0447\u0430\u0441\u0442\u043a\u0456 \u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u043f\u0430\u043c\u0456\u0436 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0446\u044e \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0432\u0435\u045e \u0437 \u0456\u0445 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u045e \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u0456\u0445 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043b\u0430\u0441\u043a\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u041c\u0430\u0439\u0441\u0435\u044f. \u041d\u044f\u0445\u0430\u0439 \u044f\u0433\u043e \u043f\u0430\u043c\u044f\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f. \u0423 \u0445\u0432\u0430\u043b\u0435 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e \u044f\u0433\u043e \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u0445, \u0443\u0447\u044b\u043d\u0456\u045e\u0448\u044b \u044f\u0433\u043e \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u0434\u043b\u044f \u0432\u043e\u0440\u0430\u0433\u0430\u045e. \u041f\u0440\u0430\u0437 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u044b \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u045e \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043c\u0456; \u0434\u0430\u045e \u044f\u043c\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0434\u043b\u044f \u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0447\u0430\u0441\u0446\u0456\u043d\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b. \u0410\u0441\u0432\u044f\u0446\u0456\u045e \u044f\u0433\u043e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445. \u0414\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u044f\u043c\u0443 \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0443\u0432\u0451\u045e \u044f\u0433\u043e \u045e \u0446\u0451\u043c\u043d\u044b\u044f \u0445\u043c\u0430\u0440\u044b \u0456 \u0441\u0430\u043c-\u043d\u0430\u0441\u0430\u043c \u0434\u0430\u045e \u044f\u043c\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0437\u0430\u043a\u043e\u043d \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u042f\u043a\u0443\u0431\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c &ndash; \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c. <br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 6, 3; 7, 9; 6, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u0443\u0445\u0430\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439 \u0443\u0441\u0435 \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u044b\u0437\u043d\u0430\u0439, \u0448\u0442\u043e \u0401\u043d \u0411\u043e\u0433 \u043c\u043e\u0446\u043d\u044b \u0456 \u0432\u0435\u0440\u043d\u044b, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043b\u044e\u0431\u043e\u045e \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u0435\u0448 \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u0443\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0441\u0432\u0430\u0451\u0439, \u0443\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0437\u043d\u0430\u0439, \u0448\u0442\u043e \u0401\u043d \u0411\u043e\u0433 \u043c\u043e\u0446\u043d\u044b \u0456 \u0432\u0435\u0440\u043d\u044b, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043b\u044e\u0431\u043e\u045e \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"21","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">1, 1. 6-18&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0448\u043d\u0456\u044f \u043f\u0440\u0430\u043c\u043e\u0432\u044b \u041c\u0430\u0439\u0441\u0435\u044f \u045e \u041c\u0430\u0430\u0431\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u042f\u0440\u0434\u0430\u043d\u0430\u043c \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u045e \u0410\u0440\u0430\u0431\u0435 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0421\u0443\u0444\u0430, \u043f\u0430\u043c\u0456\u0436 \u0424\u0430\u0440\u0430\u043d\u0430\u043c, \u0422\u0430\u0444\u044d\u043b\u0435\u043c, \u041b\u0430\u0431\u0430\u043d\u0430\u043c, \u0425\u0430\u0446\u044d\u0440\u043e\u0442\u0430\u043c \u0456 \u0414\u044b-\u0417\u0430\u0433\u0430\u0431\u0430\u043c:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u043d\u0430 \u0413\u0430\u0440\u044d\u0431\u0435: &ldquo;\u0425\u043e\u043f\u0456\u0446\u044c \u0432\u0430\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0440\u044b. \u041f\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0456 \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0433\u043e\u0440 \u0430\u043c\u0430\u0440\u044d\u044f\u045e, \u0434\u0430 \u045e\u0441\u0456\u0445 \u0441\u0443\u0441\u0435\u0434\u0437\u044f\u045e \u043c\u0430\u0456\u0445 \u0443 \u0410\u0440\u0430\u0431\u0435, \u0443 \u0433\u0430\u0440\u0430\u0445 \u043d\u0430 \u0428\u044d\u0444\u044d\u043b\u0456, \u043d\u0430 \u041d\u044d\u0433\u0435\u0431\u0435 \u0456 \u043d\u0430 \u045e\u0437\u0431\u044f\u0440\u044d\u0436\u0436\u044b \u043c\u043e\u0440\u0430, \u0434\u0430 \u0437\u044f\u043c\u043b\u0456 \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430\u045e \u0456 \u041b\u0456\u0431\u0430\u043d\u0430, \u0430\u0436 \u0434\u0430 \u0440\u0430\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439, \u0440\u0430\u043a\u0456 \u0415\u045e\u0444\u0440\u0430\u0442. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435: \u0434\u0430\u044e \u0432\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0423\u0432\u0430\u0439\u0434\u0437\u0456\u0446\u0435 \u0456 \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u045e \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u0435 \u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0430\u0431\u044f\u0446\u0430\u045e \u0430\u0439\u0446\u0430\u043c \u0432\u0430\u0448\u044b\u043c: \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443, \u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u0456\u0445&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c: &ldquo;\u042f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0430\u0434\u0437\u0456\u043d \u043d\u0435\u0441\u0446\u0456 \u0446\u044f\u0436\u0430\u0440 \u0443\u0441\u0456\u0445 \u0432\u0430\u0441. \u041f\u0430\u043d \u0411\u043e\u0433 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0432\u0430\u0441, \u0456 \u0432\u043e\u0441\u044c \u0441\u0451\u043d\u043d\u044f \u0432\u044b \u0442\u0430\u043a\u0456\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f, \u044f\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0437\u043e\u0440\u043a\u0456. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443 \u0442\u044b\u0441\u044f\u0447\u044b \u0440\u0430\u0437\u043e\u045e \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441, \u044f\u043a \u0430\u0431\u044f\u0446\u0430\u045e \u0432\u0430\u043c. \u0410\u043b\u0435 \u044f\u043a \u0436\u0430 \u043c\u043d\u0435 \u0430\u0434\u043d\u0430\u043c\u0443 \u043d\u0430\u0441\u0456\u0446\u044c \u043a\u043b\u043e\u043f\u0430\u0442\u044b \u0432\u0430\u0448\u044b, \u0446\u044f\u0436\u0430\u0440 \u0432\u0430\u0448 \u0456 \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u0432\u0430\u0448\u044b\u044f? \u0412\u044b\u0431\u0435\u0440\u044b\u0446\u0435 \u0441\u0430\u0431\u0435 \u0441\u044f\u0440\u043e\u0434 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u043c\u0443\u0434\u0440\u044b\u0445, \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0456 \u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u0445, \u0456 \u044f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456&rdquo;. \u0406 \u0432\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u043c\u043d\u0435: &ldquo;\u0414\u043e\u0431\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u043c&rdquo;. \u0422\u0430\u0434\u044b \u0441\u044f\u0440\u043e\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u044f \u0432\u044b\u0431\u0440\u0430\u045e \u043c\u0443\u0436\u043e\u045e \u043c\u0443\u0434\u0440\u044b\u0445 \u0456 \u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430\u043c\u0456 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456: \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430\u043c\u0456 \u043d\u0430\u0434 \u0442\u044b\u0441\u044f\u0447\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430\u043c\u0456 \u043d\u0430\u0434 \u0441\u043e\u0442\u043d\u044f\u043c\u0456, \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0434 \u043f\u044f\u0446\u0446\u044e\u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e \u0456 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0434 \u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e, \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0430\u043c\u0456 \u043d\u0430\u0434 \u0432\u0430\u0448\u044b\u043c\u0456 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u043c\u0456. \u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0441\u0443\u0434\u0434\u0437\u044f\u043c \u0432\u0430\u0448\u044b\u043c \u0443 \u0447\u0430\u0441 \u0442\u043e\u0439, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0432\u044b\u0440\u0430\u0448\u0430\u0439\u0446\u0435 \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0446\u0456 \u0437 \u0447\u0443\u0436\u044b\u043c. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0431\u0435\u0441\u0441\u0442\u0430\u0440\u043e\u043d\u043d\u044b\u043c\u0456 \u045e \u0441\u0443\u0434\u0437\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u044f\u043a \u043c\u0430\u043b\u043e\u0433\u0430, \u0442\u0430\u043a \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u043d\u0456\u043a\u043e\u0433\u0430, \u0431\u043e \u0433\u044d\u0442\u0430 \u0441\u0443\u0434 \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0446\u044f\u0436\u043a\u0430\u0439, \u043f\u0435\u0440\u0430\u0434\u0430\u0439\u0446\u0435 \u044f\u0435 \u043c\u043d\u0435, \u043a\u0430\u0431 \u044f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e&rdquo;. \u0423 \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u044f \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0432\u0430\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0431\u0456\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 10, 17; 1, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448 &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0431\u0430\u0433\u043e\u045e, \u0411\u043e\u0433 \u0432\u044f\u043b\u0456\u043a\u0456, \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u0433\u0440\u043e\u0437\u043d\u044b, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0456 \u043d\u0430 \u0430\u0441\u043e\u0431\u044b, \u043d\u0456 \u043d\u0430 \u0434\u0430\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0431\u0435\u0441\u0441\u0442\u0430\u0440\u043e\u043d\u043d\u044b\u043c\u0456 \u045e \u0441\u0443\u0434\u0437\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u044f\u043a \u043c\u0430\u043b\u043e\u0433\u0430, \u0442\u0430\u043a \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u043e \u0433\u044d\u0442\u0430 \u0441\u0443\u0434 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0456 \u043d\u0430 \u0430\u0441\u043e\u0431\u044b, \u043d\u0456 \u043d\u0430 \u0434\u0430\u0440\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"22","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">4, 1-8. 32-40&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0426\u044f\u043f\u0435\u0440, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043b\u0443\u0445\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0437\u0430\u043a\u043e\u043d\u044b, \u044f\u043a\u0456\u044f \u044f \u0432\u0443\u0447\u0443 \u0432\u0430\u0441 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u0436\u044b\u043b\u0456 \u0432\u044b, \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0456, \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0434\u0430\u0435 \u0432\u0430\u043c \u041f\u0430\u043d, \u0411\u043e\u0433 \u0430\u0439\u0446\u043e\u045e \u0432\u0430\u0448\u044b\u0445. \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0430\u0434\u044b\u043c\u0430\u0439\u0446\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456\u044f \u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c. \u0412\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u0448\u0442\u043e \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0443 \u0411\u0430\u0430\u043b\u044c-\u041f\u044d\u043e\u0440\u044b, \u044f\u043a \u041f\u0430\u043d \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0411\u0430\u0430\u043b\u0435\u043c \u0437 \u041f\u044d\u043e\u0440\u0430, \u0430 \u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0445\u0456\u043b\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0441\u0451\u043d\u043d\u044f \u045e\u0441\u0435 \u0436\u044b\u0432\u044f\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u044f \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0432\u0430\u0441 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u043c \u0456 \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u044f\u043a \u041f\u0430\u043d, \u0411\u043e\u0433 \u043c\u043e\u0439, \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435, \u043a\u0430\u0431 \u0432\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u043e\u044e \u0456\u0434\u0437\u044f\u0446\u0435 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439\u0446\u0435 \u0456\u0445, \u0431\u043e \u0433\u044d\u0442\u0430 &ndash; \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0456 \u0440\u043e\u0437\u0443\u043c \u0432\u0430\u0448 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0443\u0441\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0433\u044d\u0442\u044b\u044f, \u0442\u0430\u043a \u0441\u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u0422\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u043c\u0443\u0434\u0440\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u0451\u043d \u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0440\u043e\u0434!&rdquo; \u0426\u0456 \u0436 \u0451\u0441\u0446\u044c \u0456\u043d\u0448\u044b \u043d\u0430\u0440\u043e\u0434 \u0432\u044f\u043b\u0456\u043a\u0456, \u043a\u0430\u0431 \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0430\u0433\u0456 \u0431\u044b\u043b\u0456 \u0442\u0430\u043a \u0431\u043b\u0456\u0437\u043a\u0430, \u044f\u043a \u0431\u043b\u0456\u0437\u043a\u0456 \u0451\u0441\u0446\u044c \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u043a\u0430\u043b\u0456 \u0431 \u043c\u044b \u043d\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u042f\u0433\u043e? \u0426\u0456 \u0436 \u0451\u0441\u0446\u044c \u0456\u043d\u0448\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431 \u043c\u0435\u045e \u0442\u0430\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0437\u0430\u043a\u043e\u043d\u044b, \u044f\u043a \u0443\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0433\u044d\u0442\u044b, \u0448\u0442\u043e \u044f \u0441\u0451\u043d\u043d\u044f \u0434\u0430\u044e \u0432\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u044b\u0442\u0430\u0439\u0441\u044f \u045e \u0434\u0430\u045e\u043d\u0456\u0445 \u0447\u0430\u0441\u043e\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0430\u0434 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456; \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0440\u0430\u044e \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0430\u0436 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u0446\u0456 \u0431\u044b\u043b\u043e \u043d\u0435\u043a\u0430\u043b\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0442\u0430\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u044f\u043a \u0433\u044d\u0442\u0430, \u0456 \u0446\u0456 \u0431\u044b\u043b\u043e \u0432\u044f\u0434\u043e\u043c\u0430 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435? \u0426\u0456 \u0447\u0443\u045e \u043d\u0430\u0440\u043e\u0434 \u0433\u043e\u043b\u0430\u0441 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u0430\u0433\u043d\u044e, \u044f\u043a \u0442\u044b \u0447\u0443\u045e \u0456 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0436\u044b\u0432\u044b? \u0410\u0431\u043e \u0446\u0456 \u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043d\u0435\u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0456 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u043c\u0456\u0436 \u0456\u043d\u0448\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0440\u0430\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0437\u043d\u0430\u043a\u0456 \u0456 \u0446\u0443\u0434\u044b, \u0456 \u0432\u0430\u0439\u043d\u0443 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0456 \u045e\u0437\u043d\u044f\u0442\u044b\u043c \u043f\u043b\u044f\u0447\u043e\u043c, \u0456 \u043f\u0440\u0430\u0437 \u0447\u044b\u043d\u044b \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u044f &ndash; \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u0432\u0430\u0441 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0448\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u045e \u0415\u0433\u0456\u043f\u0446\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u043f\u0440\u043e\u0447 \u042f\u0433\u043e. \u0417 \u043d\u0435\u0431\u0430 \u0401\u043d \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435 \u0441\u0432\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0456 \u0430\u0433\u043e\u043d\u044c, \u0456 \u0442\u044b \u0447\u0443\u045e \u0441\u043b\u043e\u0432\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u0430\u0433\u043d\u044e, \u0431\u043e \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0430\u0439\u0446\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0441\u043b\u044f \u0456\u0445. \u0401\u043d \u0441\u0430\u043c \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0441\u0456\u043b\u0430\u0439, \u043a\u0430\u0431 \u043f\u0440\u0430\u0433\u043d\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0456 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u044f \u0437\u0430 \u0446\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0446\u044f\u0431\u0435, \u0456 \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0437\u044f\u043c\u043b\u044e \u0456\u0445, \u044f\u043a \u0443 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0435\u0434\u0430\u0439 \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c, \u0448\u0442\u043e \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u043d\u0430 \u043d\u0435\u0431\u0435 \u045e \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u045e\u043d\u0456\u0437\u0435, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0448\u0442\u043e \u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u0441\u0451\u043d\u043d\u044f, \u043a\u0430\u0431 \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u043b\u043e \u0442\u0430\u0431\u0435 \u0456 \u0442\u0432\u0430\u0456\u043c \u0441\u044b\u043d\u0430\u043c \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0434\u043e\u045e\u0433\u0456 \u0431\u044b\u045e \u0442\u0432\u043e\u0439 \u0432\u0435\u043a \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u043d\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0434\u0430\u0435 \u0442\u0430\u0431\u0435 \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 4, 1; 31, 19. 20; \u041f\u0441 81 (80), 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0430\u043d\u0430 \u0456 \u0437\u0430\u043f\u0456\u0448\u044b \u0456\u0445 \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043a\u043d\u0456\u0437\u0435; <span style=\"color: #ff0000;\">*<\/span> \u0456 \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0451\u0434\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043b\u0443\u0445\u0430\u0439, \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u041c\u043e\u0439, \u0445\u0430\u0447\u0443 \u043d\u0430\u0433\u0430\u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u043a\u0430\u0431 \u0442\u044b \u041c\u044f\u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0451\u0434\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"23","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">6, 4-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0417\u0430\u043a\u043e\u043d \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u043b\u0443\u0445\u0430\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c: \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, &ndash; \u041f\u0430\u043d \u0430\u0434\u0437\u0456\u043d\u044b. \u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u044e \u0442\u0432\u0430\u0451\u044e, \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b \u0442\u0432\u0430\u0456\u0445. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u0451\u043d\u043d\u044f \u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435, \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u0443\u0447\u0430\u0439 \u0456\u043c \u0434\u0437\u044f\u0446\u0435\u0439 \u0441\u0432\u0430\u0456\u0445 \u0456 \u0433\u0430\u0432\u0430\u0440\u044b \u043f\u0440\u0430 \u0456\u0445, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0434\u043e\u043c\u0430, \u043f\u0430\u0434\u0447\u0430\u0441 \u0442\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430, \u043a\u043b\u0430\u0434\u0443\u0447\u044b\u0441\u044f \u0441\u043f\u0430\u0446\u044c \u0456 \u045e\u0441\u0442\u0430\u044e\u0447\u044b. \u041f\u0440\u044b\u0432\u044f\u0436\u044b \u0456\u0445, \u044f\u043a \u0437\u043d\u0430\u043a, \u0434\u0430 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0451\u0439, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0430\u0431\u0435 \u044f\u043a \u043f\u0430\u0432\u044f\u0437\u043a\u0430 \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u0447\u044b\u043c\u0430 \u0442\u0432\u0430\u0456\u043c\u0456. \u041d\u0430\u043f\u0456\u0448\u044b \u0456\u0445 \u043d\u0430 \u0432\u0443\u0448\u0430\u043a\u0430\u0445 \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0430 \u0431\u0440\u0430\u043c\u0430\u0445 \u0441\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0430\u0431\u044f\u0446\u0430\u045e \u0430\u0439\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c &ndash; \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443, \u0448\u0442\u043e \u0434\u0430\u0441\u0446\u044c \u0442\u0430\u0431\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0433\u0430\u0440\u0430\u0434\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0442\u044b \u043d\u0435 \u0431\u0443\u0434\u0430\u0432\u0430\u045e, \u0437 \u0434\u0430\u043c\u0430\u043c\u0456, \u043f\u043e\u045e\u043d\u044b\u043c\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u0456\u0445 \u0442\u044b \u043d\u0435 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u045e, \u0441\u0430 \u0441\u0442\u0443\u0434\u043d\u044f\u043c\u0456, \u044f\u043a\u0456\u0445 \u0442\u044b \u043d\u0435 \u043a\u0430\u043f\u0430\u045e, \u0437 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0430\u043b\u0456\u045e\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0442\u044b \u043d\u0435 \u0441\u0430\u0434\u0437\u0456\u045e. \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456 \u043d\u0430\u0441\u044b\u0446\u0456\u0448\u0441\u044f. \u0421\u0446\u0435\u0440\u0430\u0436\u044b\u0441\u044f \u0442\u0430\u0434\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0431\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456. \u0411\u043e\u0439\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u0441\u043b\u0443\u0436\u044b \u042f\u043c\u0443, \u0456 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0439 \u042f\u0433\u043e\u043d\u044b\u043c \u0456\u043c\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0439\u0441\u044f \u0447\u0443\u0436\u044b\u043c \u0431\u0430\u0433\u0430\u043c, \u0431\u0430\u0433\u0430\u043c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u043a\u0440\u0443\u0436\u0430\u044e\u0446\u044c \u0432\u0430\u0441, \u043a\u0430\u0431 \u043d\u0435 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u045e\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0401\u043d \u043d\u0435 \u0441\u0446\u0451\u0440 \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u0446\u044f\u0431\u0435, &ndash; \u0440\u0430\u045e\u043d\u0456\u0432\u044b \u0411\u043e\u0433. \u041d\u0435 \u0441\u043f\u0440\u0430\u0431\u0443\u0439\u0446\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u043b\u0456 \u045e \u041c\u0430\u0441\u0435. \u041f\u0456\u043b\u044c\u043d\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u042f\u0433\u043e, \u0456 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u042f\u0433\u043e, \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0432\u0430\u043c. \u0420\u0430\u0431\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0435 \u0456 \u0434\u043e\u0431\u0440\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u043b\u043e \u0442\u0430\u0431\u0435. \u0422\u0430\u0434\u044b \u0432\u044b\u0439\u0434\u0437\u0435\u0448 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u043f\u0440\u044b\u0433\u043e\u0436\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u041f\u0430\u043d \u0430\u0439\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u043f\u0440\u0430\u0433\u0430\u043d\u044f\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445. \u0422\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0442\u0432\u043e\u0439 \u0441\u044b\u043d \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0441\u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435: &ldquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u0456 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456, \u0456 \u0437\u0430\u043a\u043e\u043d\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448?&rdquo;, \u0430\u0434\u043a\u0430\u0436\u0430\u0448 \u0441\u044b\u043d\u0443 \u0441\u0432\u0430\u0439\u043c\u0443: &ldquo;\u041c\u044b \u0431\u044b\u043b\u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u045e \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u0456 \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u043c\u043e\u0446\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439. \u0406 \u045e\u0447\u044b\u043d\u0456\u045e \u041f\u0430\u043d \u0437\u043d\u0430\u043a\u0456 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0433\u0456\u043f\u0442\u0430, \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u045e\u0441\u044f\u0433\u043e \u044f\u0433\u043e \u0434\u043e\u043c\u0430 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043d\u0430\u0448\u044b\u0445. \u0412\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0430\u0434\u0442\u0443\u043b\u044c, \u043a\u0430\u0431 \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u0430\u0446\u044c \u043d\u0430\u0441 \u0456 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0434\u0430\u0446\u044c \u043f\u0440\u043e\u0434\u043a\u0430\u043c \u043d\u0430\u0448\u044b\u043c. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456, \u0431\u0430\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0434\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a \u0456 \u0441\u0451\u043d\u043d\u044f. \u0406 \u043d\u0430\u0448\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0442\u044b\u043c, \u043a\u0430\u0431 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u044f\u043a\u0456\u044f \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 19 (18), 8. 9; \u0411\u044b\u0446 13, 8. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u041f\u0430\u043d\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0434\u0443\u0448\u0443, \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u0432\u0435\u0440\u043d\u0430\u0435, \u044f\u043d\u043e \u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c.<span style=\"color: #ff0000;\"> *<\/span> \u041d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430 \u044f\u0441\u043d\u044b, \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u043e\u0447\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0417\u0430\u043a\u043e\u043d. \u041b\u044e\u0431\u043e\u045e \u0451\u0441\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0417\u0430\u043a\u043e\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430 \u044f\u0441\u043d\u044b, \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u043e\u0447\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"24","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">7, 6-14; 8, 1-6<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0406\u0437\u0440\u0430\u044d\u043b\u044c &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u043d\u0430\u0440\u043e\u0434<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0422\u044b &ndash; \u043d\u0430\u0440\u043e\u0434, \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u044b \u041f\u0430\u043d\u0443, \u0442\u0432\u0430\u0439\u043c\u0443 \u0411\u043e\u0433\u0443. \u0426\u044f\u0431\u0435 \u0432\u044b\u0431\u0440\u0430\u045e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043a\u0430\u0431 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u043d\u0430 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u0442\u044b \u0431\u044b\u045e \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441 \u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u045e \u0432\u0430\u0441 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044e \u0442\u044b \u043f\u0435\u0440\u0430\u0432\u044b\u0441\u0456\u045e \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0431\u043e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0442\u044b \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u041f\u0430\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441. \u0406 \u043a\u0430\u0431 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u0441\u044f\u0433\u0443, \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u0432\u0430\u0448\u044b\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c, \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0456 \u0432\u044b\u043a\u0443\u043f\u0456\u045e \u0432\u0430\u0441 \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456, \u0437 \u0440\u0443\u043a \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0415\u0433\u0456\u043f\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0432\u0435\u0440\u043d\u044b\u043c, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0442\u044b\u0441\u044f\u0447\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e\u043d\u044b\u044f, \u0430\u043b\u0435 \u044f\u043a\u0456 \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u042f\u0433\u043e. \u0401\u043d \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c, \u0441\u0430\u043c \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0437\u0430\u043a\u043e\u043d, \u044f\u043a\u0456\u044f \u0442\u0430\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u044b \u0433\u044d\u0442\u044b\u044f \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445, \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0442\u0430\u0431\u043e\u044e \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u0430\u0439\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c. \u0406 \u0431\u0443\u0434\u0437\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u043f\u043b\u043e\u0434 \u0437\u044f\u043c\u043b\u0456 \u0442\u0432\u0430\u0451\u0439: \u0437\u0431\u043e\u0436\u0436\u0430 \u0442\u0432\u0430\u0451, \u0432\u0456\u043d\u043e \u0442\u0432\u0430\u0451, \u0430\u043b\u0435\u0439 \u0442\u0432\u043e\u0439, \u043c\u0430\u043b\u0430\u0434\u043d\u044f\u043a \u043a\u0430\u0440\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u0442\u0432\u0430\u0456\u0445 \u043d\u0430 \u0442\u043e\u0439 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u0401\u043d \u043f\u0435\u0440\u0430\u0434 \u0430\u0439\u0446\u0430\u043c\u0456 \u0442\u0432\u0430\u0456\u043c\u0456 \u0430\u0431\u044f\u0446\u0430\u045e \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435 \u0456 \u0441\u044f\u0440\u043e\u0434 \u0431\u044b\u0434\u043b\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u044f\u043f\u043b\u043e\u0434\u043d\u0430\u0433\u0430 \u0446\u0456 \u043d\u044f\u043f\u043b\u043e\u0434\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u0441\u0451\u043d\u043d\u044f, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435, \u043a\u0430\u0431 \u0432\u044b \u0436\u044b\u043b\u0456, \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u043b\u0456\u0441\u044f \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u0435 \u0437\u044f\u043c\u043b\u0451\u0439, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0430\u0431\u044f\u0446\u0430\u045e \u0430\u0439\u0446\u0430\u043c \u0432\u0430\u0448\u044b\u043c. \u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u0443\u0432\u0435\u0441\u044c \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u0432\u0451\u045e \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043f\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e, \u043a\u0430\u0431 \u0441\u043a\u0430\u0440\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c, \u0456 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u045e \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c, \u0446\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0446\u0456 \u043d\u0435. \u0401\u043d \u0441\u043a\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435, \u043c\u0443\u0447\u044b\u045e \u0446\u044f\u0431\u0435 \u0433\u043e\u043b\u0430\u0434\u0430\u043c \u0456 \u043a\u0430\u0440\u043c\u0456\u045e \u043c\u0430\u043d\u043d\u0430\u044e, \u044f\u043a\u043e\u0439 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0442\u044b \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u043f\u0440\u043e\u0434\u043a\u0456 \u0442\u0432\u0430\u0435, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u043d\u0435 \u0430\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0436\u044b\u0432\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041f\u0430\u043d\u0430, \u0436\u044b\u0432\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041d\u0435 \u043f\u0430\u043f\u0441\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0442\u0430\u0431\u0435 \u043d\u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0442\u0432\u0430\u0451, \u043d\u0456 \u043d\u0430\u0433\u0430 \u0442\u0432\u0430\u044f \u043d\u0435 \u0430\u043f\u0443\u0445\u043b\u0430 \u0437\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e. \u0406 \u043f\u0430\u0437\u043d\u0430\u0439 \u0443 \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c, \u0448\u0442\u043e \u044f\u043a \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430, \u0442\u0430\u043a \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0445\u0430\u0434\u0437\u0456 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456, \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u042f\u0433\u043e&raquo;.<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 10, 16; \u0406\u0441 63, 8. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u043c\u0435\u045e \u0434\u0430 \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u043c\u0435\u045e \u0434\u0430 \u043d\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"25","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">9, 7-21. 25-29&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0413\u0440\u0430\u0445\u0456 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0447\u0430\u0441: \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u0456 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439\u0441\u044f, \u044f\u043a \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0422\u044b \u0433\u043d\u044f\u0432\u0456\u045e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0417 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0436 \u0434\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u043d\u0430 \u0433\u044d\u0442\u0430 \u043c\u0435\u0441\u0446\u0430, \u0432\u044b \u0431\u044b\u043b\u0456 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u041f\u0430\u043d\u0443. \u0406 \u043d\u0430 \u0413\u0430\u0440\u044d\u0431\u0435 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u043b\u0456 \u041f\u0430\u043d\u0430, \u0456 \u041f\u0430\u043d \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0432\u0430\u0441 \u0442\u0430\u043a, \u0448\u0442\u043e \u0445\u0430\u0446\u0435\u045e \u0432\u0430\u0441 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443, \u043a\u0430\u0431 \u0443\u0437\u044f\u0446\u044c \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u044f \u0442\u0430\u0431\u043b\u0456\u0446\u044b, \u0441\u043a\u0440\u044b\u0436\u0430\u043b\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u041f\u0430\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0432\u0430\u043c\u0456, \u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u044b \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439, \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0447\u044b \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0430\u0434\u044b, \u0442\u0430\u0434\u044b \u041f\u0430\u043d \u0434\u0430\u045e \u043c\u043d\u0435 \u0434\u0437\u0432\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u044f \u0442\u0430\u0431\u043b\u0456\u0446\u044b, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u0411\u043e\u0436\u044b\u043c. \u0410 \u043d\u0430 \u0456\u0445 \u0431\u044b\u043b\u0456 \u0430\u043c\u0430\u043b\u044c \u0443\u0441\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0432\u0430\u043c \u0441\u044f\u0440\u043e\u0434 \u0430\u0433\u043d\u044e \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0445\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0439\u0448\u043b\u043e \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439, \u041f\u0430\u043d \u0434\u0430\u045e \u043c\u043d\u0435 \u0434\u0437\u0432\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u044f \u0442\u0430\u0431\u043b\u0456\u0446\u044b, \u0434\u0437\u0432\u0435 \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0456 \u0441\u043f\u0443\u0441\u0446\u0456\u0441\u044f \u0430\u0434\u0441\u044e\u043b\u044c, \u0431\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u043d\u0430\u0440\u043e\u0434 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0442\u044b \u0432\u044b\u0432\u0435\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u042f\u043d\u044b \u0445\u0443\u0442\u043a\u0430 \u0441\u044b\u0448\u043b\u0456 \u0441\u0430 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a\u0456 \u0442\u044b \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c. \u0417\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u0430\u0431\u0435 \u043b\u0456\u0442\u0430\u0433\u0430 \u0456\u0434\u0430\u043b\u0430&rdquo;. \u0406\u0437\u043d\u043e\u045e \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0411\u0430\u0447\u0443, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434 \u0437 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u043a\u0430\u0440\u043a\u0430\u043c. \u041f\u0430\u043a\u0456\u043d\u044c \u041c\u044f\u043d\u0435. \u0406 \u042f \u0437\u043d\u0456\u0448\u0447\u0443 \u0456\u0445, \u0456 \u0441\u0430\u0442\u0440\u0443 \u0456\u043c\u044f \u0456\u0445 \u0437-\u043f\u0430\u0434 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0443 \u0446\u044f\u0431\u0435 \u045e \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b \u0456 \u0431\u043e\u043b\u044c\u0448 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u043d\u044b \u0437\u0430 \u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434.&rdquo;<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0456 \u0441\u043f\u0443\u0441\u0446\u0456\u045e\u0441\u044f \u0437 \u0433\u0430\u0440\u044b, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0434\u0437\u0432\u0435 \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u045e \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445, \u0430 \u0433\u0430\u0440\u0430 \u043f\u0430\u043b\u0430\u043b\u0430 \u045e \u0430\u0433\u043d\u0456. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f: \u0432\u043e\u0441\u044c, \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u0430\u0431\u0435 \u043b\u0456\u0442\u0430\u0433\u0430 \u0456\u0434\u0430\u043b\u0430-\u0446\u044f\u043b\u044c\u0446\u0430. \u0412\u044b \u0445\u0443\u0442\u043a\u0430 \u0441\u044b\u0448\u043b\u0456 \u0441\u0430 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a\u0456 \u041f\u0430\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c. \u0406 \u044f \u0441\u0445\u0430\u043f\u0456\u045e \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0442\u0430\u0431\u043b\u0456\u0446\u044b, \u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u045e \u0456\u0445 \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0437 \u0440\u0443\u043a \u0441\u0432\u0430\u0456\u0445, \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0456\u0445 \u043d\u0430 \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445. \u0406 \u045e\u043f\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u044f\u043a \u0440\u0430\u043d\u0435\u0439, \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439 \u043d\u0435 \u0435\u045e \u0445\u043b\u0435\u0431\u0430 \u0456 \u043d\u0435 \u043f\u0456\u045e \u0432\u0430\u0434\u044b \u0437\u0430 \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b, \u044f\u043a\u0456\u043c\u0456 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0432\u044b, \u0443\u0447\u044b\u043d\u0456\u045e\u0448\u044b \u0437\u043b\u043e \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0456 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0448\u044b \u042f\u0433\u043e. \u0411\u043e \u044f \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u042f\u0433\u043e \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u044f \u0456 \u0433\u043d\u0435\u0432\u0443, \u044f\u043a\u0456\u043c\u0456 \u041f\u0430\u043d \u0437\u0430\u043f\u0430\u043b\u0430\u045e, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0432\u0430\u0441. \u041f\u0430\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u043d\u0430 \u0433\u044d\u0442\u044b \u0440\u0430\u0437. \u0406, \u0432\u0435\u043b\u044c\u043c\u0456 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u043d\u0430 \u0410\u0430\u0440\u043e\u043d\u0430, \u041f\u0430\u043d \u0445\u0430\u0446\u0435\u045e \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u044f\u0433\u043e, \u0430\u043b\u0435 \u0442\u0430\u0434\u044b \u044f \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0410\u0430\u0440\u043e\u043d\u0430. \u0410 \u0433\u0440\u044d\u0445 \u0432\u0430\u0448, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0446\u044f\u043b\u044c\u0446\u0430, \u044f \u045e\u0437\u044f\u045e \u0456 \u0441\u043f\u0430\u043b\u0456\u045e \u0443 \u0430\u0433\u043d\u0456, \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u044f\u0433\u043e, \u0456 \u0434\u043e\u0431\u0440\u0430 \u0441\u0446\u0451\u0440 \u044f\u0433\u043e \u0430\u0436 \u0443 \u0434\u0440\u043e\u0431\u043d\u044b \u043f\u044b\u043b, \u0456 \u043a\u0456\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u043f\u043b\u044b\u043d\u044c, \u044f\u043a\u0430\u044f \u0446\u044f\u043a\u043b\u0430 \u0437 \u0433\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u043f\u0430\u045e \u044f, \u0456 \u043b\u044f\u0436\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439, \u0431\u043e \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0445\u043e\u0447\u0430 \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u043f\u0440\u043e\u0441\u044f\u0447\u044b: &ldquo;\u041f\u0430\u043d\u0435 \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u043d\u0435 \u0433\u0443\u0431\u0456 \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e, \u044f\u043a\u0456 \u0422\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0441\u0432\u0430\u0451\u0439 \u0456 \u0432\u044b\u0432\u0435\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u0439. \u0423\u0441\u043f\u043e\u043c\u043d\u0456 \u0441\u043b\u0443\u0433\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0406\u0441\u0430\u0430\u043a\u0430, \u042f\u043a\u0443\u0431\u0430 \u0456 \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0439 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u045e\u043f\u0430\u0440\u0442\u0430\u0441\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u0433\u0430, \u043d\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u0433\u0440\u044d\u0445 \u044f\u0433\u043e, \u043a\u0430\u0431 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0436\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456, \u0437 \u044f\u043a\u043e\u0439 \u0422\u044b \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441: \u041f\u0430\u043d \u043d\u0435 \u0437\u043c\u043e\u0433 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0456\u043c. \u0406 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u0430 \u0456\u0445 \u0432\u044b\u0432\u0435\u045e \u0456\u0445, \u043a\u0430\u0431 \u043f\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0410\u043b\u0435 \u044f\u043d\u044b \u0422\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0422\u0432\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430, \u0422\u044b \u0432\u044b\u0432\u0435\u045e \u0456\u0445 \u043c\u043e\u0446\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u0442\u044b\u043c \u043f\u043b\u044f\u0447\u043e\u043c&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0417\u044b\u0445 32, 11. 13, 14; 33, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0447\u0430\u045e \u043c\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: \u0427\u0430\u043c\u0443 \u0440\u0430\u0437\u0433\u0430\u0440\u044d\u045e\u0441\u044f \u0422\u0432\u043e\u0439 \u0433\u043d\u0435\u045e \u043d\u0430 \u0422\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434? \u0410\u0434\u0445\u0456\u043b\u0456 \u043f\u043e\u043b\u044b\u043c\u044f \u0433\u043d\u0435\u0432\u0443 \u0422\u0432\u0430\u0439\u0433\u043e; \u0443\u0441\u043f\u043e\u043c\u043d\u0456 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0406\u0441\u0430\u0430\u043a\u0430 \u0456 \u042f\u043a\u0443\u0431\u0430, \u044f\u043a\u0456\u043c \u0422\u044b \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0434\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u041f\u0430\u043d \u0430\u0434 \u0437\u043b\u0430, \u044f\u043a\u043e\u0435 \u0434\u0443\u043c\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: \u0422\u044b \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043b\u0430\u0441\u043a\u0443 \u045e \u0432\u0430\u0447\u0430\u0445 \u041c\u0430\u0456\u0445, \u0456 \u042f \u0432\u0435\u0434\u0430\u044e \u0446\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u041f\u0430\u043d \u0430\u0434 \u0437\u043b\u0430, \u044f\u043a\u043e\u0435 \u0434\u0443\u043c\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"26","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">10, 12 &ndash; 11, 9. 26-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0422\u0440\u044d\u0431\u0430 \u0432\u044b\u0431\u0456\u0440\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410 \u0446\u044f\u043f\u0435\u0440, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043b\u0443\u0445\u0430\u0439, \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0426\u044f\u0431\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u0431\u0430\u044f\u045e\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0445\u0430\u0434\u0437\u0456\u045e \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0456 \u043b\u044e\u0431\u0456\u045e \u042f\u0433\u043e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0441\u0432\u0430\u0451\u0439, \u043a\u0430\u0431 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u042f\u0433\u043e\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u0434\u0437\u0435\u043b\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u0431\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043d\u0435\u0431\u0430 \u0456 \u043d\u0435\u0431\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u0437\u044f\u043c\u043b\u044f \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439 \u0456\u0441\u043d\u0443\u0435, \u0430\u0434\u043d\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0442\u0432\u0430\u0456\u0445 \u0430\u0439\u0446\u043e\u045e \u0441\u0445\u0456\u043b\u0456\u045e\u0441\u044f \u041f\u0430\u043d \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0456\u0445, \u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0441\u043b\u044f \u0456\u0445, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0432\u0430\u0441, \u044f\u043a \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0456 \u0441\u0451\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0447\u044b\u043d\u0456\u0446\u0435 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e\u043f\u0430\u0440\u0442\u044b\u043c \u0441\u0432\u043e\u0439 \u043a\u0430\u0440\u0430\u043a, \u0431\u043e \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448 &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0431\u0430\u0433\u043e\u045e \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e, \u0411\u043e\u0433 \u0432\u044f\u043b\u0456\u043a\u0456, \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u0433\u0440\u043e\u0437\u043d\u044b, \u044f\u043a\u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0456 \u043d\u0430 \u0430\u0441\u043e\u0431\u044b, \u043d\u0456 \u043d\u0430 \u0434\u0430\u0440\u044b, \u044f\u043a\u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0441\u0456\u0440\u0430\u0442\u044b \u0456 \u045e\u0434\u0430\u0432\u044b, \u043b\u044e\u0431\u0456\u0446\u044c \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430 \u0456 \u0434\u0430\u0435 \u044f\u043c\u0443 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u0456 \u0432\u044b \u043b\u044e\u0431\u0456\u0446\u0435 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e, \u0431\u043e \u0456 \u0441\u0430\u043c\u0456 \u0431\u044b\u043b\u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c\u0456 \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0439\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b, \u0434\u0430 \u044f\u0433\u043e \u0441\u0445\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0439 \u042f\u0433\u043e\u043d\u044b\u043c \u0456\u043c\u0435\u043c. \u0401\u043d \u0445\u0432\u0430\u043b\u0430 \u0442\u0432\u0430\u044f \u0456 \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0442\u044b\u044f \u0433\u0440\u043e\u0437\u043d\u044b\u044f \u0446\u0443\u0434\u044b, \u044f\u043a\u0456\u044f \u0431\u0430\u0447\u044b\u043b\u0456 \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b. \u041a\u0430\u043b\u0456 \u0430\u0439\u0446\u044b \u0442\u0432\u0430\u0435 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u0415\u0433\u0456\u043f\u0435\u0442, \u0456\u0445 \u0431\u044b\u043b\u043e \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430 \u0446\u044f\u043f\u0435\u0440 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0446\u044f\u0431\u0435, \u044f\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0437\u043e\u0440\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456 \u0456 \u043d\u0430\u043a\u0430\u0437\u044b, \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0437\u043d\u0430\u0439\u0446\u0435 \u0432\u044b \u0441\u0451\u043d\u043d\u044f, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0434\u0437\u0435\u0446\u0456 \u0432\u0430\u0448\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0446\u0443\u0434\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445, \u043c\u043e\u0446\u043d\u0430\u0439 \u0440\u0443\u043a\u0456 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u0442\u0430\u0433\u0430 \u043f\u043b\u044f\u0447\u0430, \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0441\u043f\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u045e\u0447\u044b\u043d\u0456\u045e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0415\u0433\u0456\u043f\u0442\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0443, \u0456 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u044f\u0433\u043e\u043d\u0430\u0439, \u0456 \u045e\u0441\u044f\u043c\u0443 \u0432\u043e\u0439\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443, \u0456 \u043a\u043e\u043d\u044f\u043c, \u0456 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u043c; \u044f\u043a \u043d\u0430\u043a\u0440\u044b\u043b\u0456 \u0456\u0445 \u0432\u043e\u0434\u044b \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u0432\u0430\u0441, \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0456\u0445 \u041f\u0430\u043d \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f; \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0432\u0430\u043c \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u044b \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430, \u0456 \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0414\u0430\u0442\u0430\u043d\u0443 \u0456 \u0410\u0431\u0456\u0440\u0430\u043c\u0443, \u0441\u044b\u043d\u0430\u043c \u042d\u043b\u0456\u044f\u0431\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0441\u044b\u043d\u0430\u043c \u0420\u0443\u0431\u044d\u043d\u0430, \u043a\u0430\u043b\u0456 \u0437\u044f\u043c\u043b\u044f \u0430\u0434\u043a\u0440\u044b\u043b\u0430 \u0441\u0432\u0430\u044e \u043f\u0430\u0448\u0447\u0443 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0456\u0445 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u0445 \u0434\u0430\u043c\u0430\u043c\u0456, \u0448\u0430\u0442\u0440\u0430\u043c\u0456 \u0456 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0447\u044b \u0432\u0430\u0448\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0441\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u044f\u043a\u0456\u044f \u045e\u0447\u044b\u043d\u0456\u045e \u0401\u043d. \u0422\u0430\u043c\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u0434\u0430\u044e \u0432\u0430\u043c \u0441\u0451\u043d\u043d\u044f, \u043a\u0430\u0431 \u0432\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u0437\u043c\u0430\u0433\u043b\u0456 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u044f\u043a\u043e\u0439 \u0456\u0434\u0437\u044f\u0446\u0435; \u043a\u0430\u0431 \u0432\u044b \u0434\u043e\u045e\u0433\u0430 \u0436\u044b\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0434\u0430\u0446\u044c \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u0432\u0430\u0448\u044b\u043c \u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u0456\u0445 &ndash; \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u044f \u0441\u0451\u043d\u043d\u044f \u043a\u043b\u0430\u0434\u0443 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456\u044f \u0441\u0451\u043d\u043d\u044f \u044f \u0434\u0430\u044e \u0432\u0430\u043c. \u041f\u0440\u0430\u043a\u043b\u0451\u043d, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0435\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e \u0448\u043b\u044f\u0445\u0443, \u044f\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0456 \u043a\u0430\u043b\u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0437\u0430 \u0447\u0443\u0436\u044b\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 19; 5, 3; 2, 5\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043b\u044e\u0431\u0456\u043c \u0411\u043e\u0433\u0430, \u0431\u043e \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0443 \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0435, \u0443 \u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0443 \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"27","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">16, 1-17&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0434\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043c\u0435\u0441\u044f\u0446 \u0410\u0431\u0456\u0431 \u0456 \u0441\u0432\u044f\u0442\u043a\u0443\u0439 \u041f\u0430\u0441\u0445\u0443 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u045e \u0433\u044d\u0442\u044b \u043c\u0435\u0441\u044f\u0446 \u043d\u043e\u0447\u0447\u0443 \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u041f\u0440\u044b\u043d\u044f\u0441\u0456 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u0441\u0432\u0430\u0439\u043c\u0443, \u0437 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0437 \u0431\u044b\u043a\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0443 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0432\u044b\u0431\u0435\u0440\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043d\u0430 \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0435\u0448 \u0437 \u0451\u0439 \u0437\u0430\u043a\u0432\u0430\u0448\u0430\u043d\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430; \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u044f\u043c\u0456 \u0434\u0437\u0451\u043d \u0435\u0448 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456, &ndash; \u0445\u043b\u0435\u0431 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u043f\u0435\u0448\u0446\u044b \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, &ndash; \u043a\u0430\u0431 \u0437\u0430\u043f\u043e\u043c\u043d\u0456\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0439\u0441\u0446\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0442\u0432\u0430\u0439\u0433\u043e. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0456\u0434\u0430\u0446\u044c \u0443 \u0446\u044f\u0431\u0435 \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043c\u0435\u0436\u0430\u0445 \u0442\u0432\u0430\u0456\u0445 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u044f\u043c\u0456 \u0434\u0437\u0451\u043d. \u0406 \u0437 \u043c\u044f\u0441\u0430 \u0430\u0445\u0432\u044f\u0440\u044b, \u044f\u043a\u0443\u044e \u0437\u0430\u0431&rsquo;\u0435\u0448 \u0432\u0435\u0447\u0430\u0440\u0430\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430 \u0434\u043d\u044f, \u0437\u0430 \u043d\u043e\u0447 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0440\u0430\u043d\u0456\u0446\u044b. \u041d\u0435 \u0437\u043c\u043e\u0436\u0430\u0448 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u045e \u043d\u0435\u0439\u043a\u0456\u043c \u0437 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0442\u0432\u0430\u0456\u0445, \u044f\u043a\u0456\u044f \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430\u0441\u0446\u044c \u0442\u0430\u0431\u0435, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0432\u044b\u0431\u0435\u0440\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043d\u0430 \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e. \u0422\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u0448 \u0430\u0445\u0432\u044f\u0440\u0443 \u0432\u0435\u0447\u0430\u0440\u0430\u043c \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430, \u0443 \u0447\u0430\u0441 \u0432\u044b\u0439\u0441\u0446\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u041f\u0440\u044b\u0433\u0430\u0442\u0443\u0435\u0448 \u0456 \u0437&rsquo;\u044f\u0441\u0456 \u044f\u0435 \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0432\u044b\u0431\u0435\u0440\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u043f\u0430\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0443 \u0448\u0430\u0442\u0440\u044b \u0441\u0432\u0430\u0435. \u0428\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456, \u0430 \u043d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0442\u0430\u043c\u0443 \u043d\u0435 \u0440\u0430\u0431\u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043b\u0456\u0447\u044b\u0448 \u0441\u0430\u0431\u0435 \u0441\u0435\u043c \u0442\u044b\u0434\u043d\u044f\u045e \u0430\u0434 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0441\u0435\u0440\u043f \u043f\u0430\u0447\u043d\u0435 \u0436\u0430\u0446\u044c \u0437\u0431\u043e\u0436\u0436\u0430. \u0406 \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u0448 \u0441\u0432\u044f\u0442\u0430 \u0422\u044b\u0434\u043d\u044f\u045e \u0443 \u0433\u043e\u043d\u0430\u0440 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0441\u0430 \u0448\u0447\u043e\u0434\u0440\u044b\u043c\u0456 \u0456 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0451\u0439, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0442\u0430\u0433\u043e, \u044f\u043a \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439. \u0411\u0443\u0434\u0437\u0435\u0448 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u0441\u044b\u043d \u0442\u0432\u043e\u0439, \u0456 \u0434\u0430\u0447\u043a\u0430 \u0442\u0432\u0430\u044f, \u0456 \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u043e\u0439, \u0456 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0430 \u0442\u0432\u0430\u044f, \u0456 \u043b\u0435\u0432\u0456\u0442, \u044f\u043a\u0456\u044f \u045e \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u0447\u0443\u0436\u044b\u043d\u0435\u0446 \u0456 \u0441\u0456\u0440\u0430\u0442\u0430, \u0456 \u045e\u0434\u0430\u0432\u0430, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0437 \u0442\u0430\u0431\u043e\u0439 \u0443 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0432\u044b\u0431\u0435\u0440\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043d\u0430 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430 \u0434\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e. \u0406 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u043e\u043c\u043d\u0456\u0446\u044c, \u0448\u0442\u043e \u0442\u044b \u0431\u044b\u045e \u0441\u043b\u0443\u0433\u043e\u044e \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437\u044b \u0433\u044d\u0442\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u0448 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430 \u041d\u0430\u043c\u0451\u0442\u0430\u045e \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u044f\u043c\u0456 \u0434\u0437\u0451\u043d \u043f\u0430\u0441\u043b\u044f \u0437\u0431\u043e\u0440\u0443 \u045e\u0440\u0430\u0434\u0436\u0430\u044e \u0437 \u0442\u043e\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u0434\u0430\u0432\u0456\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0423 \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u0430 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0442\u044b \u0456 \u0441\u044b\u043d \u0442\u0432\u043e\u0439, \u0456 \u0434\u0430\u0447\u043a\u0430 \u0442\u0432\u0430\u044f, \u0456 \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u043e\u0439, \u0456 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0430 \u0442\u0432\u0430\u044f, \u0456 \u043b\u0435\u0432\u0456\u0442, \u0456 \u0447\u0443\u0436\u044b\u043d\u0435\u0446, \u0456 \u0441\u0456\u0440\u0430\u0442\u0430, \u0456 \u045e\u0434\u0430\u0432\u0430, \u044f\u043a\u0456\u044f \u045e \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445. \u0421\u0435\u043c \u0434\u0437\u0451\u043d \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0443 \u0433\u043e\u043d\u0430\u0440 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0443 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0432\u044b\u0431\u0435\u0440\u0430 \u041f\u0430\u043d, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u043b\u0430\u0434\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0440\u0443\u043a \u0442\u0432\u0430\u0456\u0445, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u043e\u0439\u0447\u044b \u045e \u0433\u043e\u0434 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b \u043c\u0443\u0436\u0447\u044b\u043d\u0430 \u0442\u0432\u043e\u0439 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0432\u044b\u0431\u0435\u0440\u0430: \u043d\u0430 \u0441\u0432\u044f\u0442\u0430 \u041f\u0440\u0430\u0441\u043d\u0430\u043a\u043e\u045e, \u043d\u0430 \u0441\u0432\u044f\u0442\u0430 \u0422\u044b\u0434\u043d\u044f\u045e \u0456 \u043d\u0430 \u0441\u0432\u044f\u0442\u0430 \u041d\u0430\u043c\u0451\u0442\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u0437 \u043f\u0443\u0441\u0442\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456. \u0410 \u0434\u0430\u0440 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0430\u0434 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456\u043c \u0401\u043d \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0446\u044f\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 16, 14. 15; \u041d\u0432\u043c 2, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u0430 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0442\u044b \u0456 \u0441\u044b\u043d \u0442\u0432\u043e\u0439, \u0456 \u0434\u0430\u0447\u043a\u0430 \u0442\u0432\u0430\u044f, \u0456 \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u043e\u0439, \u0456 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0430 \u0442\u0432\u0430\u044f, \u0456 \u043b\u0435\u0432\u0456\u0442, \u0456 \u0447\u0443\u0436\u044b\u043d\u0435\u0446, \u0456 \u0441\u0456\u0440\u0430\u0442\u0430, \u0456 \u045e\u0434\u0430\u0432\u0430, \u044f\u043a\u0456\u044f \u045e \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u041f\u0430\u043d, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0441\u0442\u0443\u043f\u043d\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u0432\u0435\u0441\u0442\u043a\u0443 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u0439. \u0410\u0434\u0437\u043d\u0430\u0447\u0430\u0439, \u042e\u0434\u044d\u044f, \u0441\u0432\u044f\u0442\u044b \u0441\u0432\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u041f\u0430\u043d, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"31","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">18, 1-22<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041b\u0435\u0432\u0456\u0442\u044b. \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u0432\u044f\u0442\u0430\u0440\u044b-\u043b\u0435\u0432\u0456\u0442\u044b, \u0443\u0441\u0451 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u041b\u0435\u0432\u0456\u044f, \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437 \u0440\u044d\u0448\u0442\u0430\u0439 \u0406\u0437\u0440\u0430\u044d\u043b\u044f; \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0437 \u0430\u0445\u0432\u044f\u0440 \u041f\u0430\u043d\u0430 \u0456 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u043e\u0437\u044c\u043c\u0443\u0446\u044c \u0437 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445, \u0431\u043e \u041f\u0430\u043d &ndash; \u0447\u0430\u0441\u0442\u043a\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0456\u0445, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043a\u043e\u043d \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0456 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0434\u0430 \u0442\u044b\u0445, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b: \u043a\u0430\u043b\u0456 \u0437\u0430\u0440\u044d\u0436\u0443\u0446\u044c \u0446\u044f\u043b\u044f \u0446\u0456 \u0430\u0432\u0435\u0447\u043a\u0443, \u0434\u0430\u0434\u0443\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u0443 \u043b\u0430\u043f\u0430\u0442\u043a\u0443, \u0434\u0437\u0432\u0435 \u0441\u043a\u0456\u0432\u0456\u0446\u044b, \u0441\u0442\u0440\u0430\u045e\u043d\u0456\u043a, \u043f\u0435\u0440\u0448\u044b \u043f\u043b\u0451\u043d \u0437\u0431\u043e\u0436\u0436\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0432\u0456\u043d\u0430 \u0456 \u0430\u043b\u0435\u044e, \u0432\u043e\u045e\u043d\u044b \u0441\u0430 \u0441\u0442\u0440\u044b\u0436\u043a\u0456 \u0430\u0432\u0435\u0447\u0430\u043a. \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0437 \u0443\u0441\u0456\u0445 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u044f\u045e \u0456 \u0441\u043b\u0443\u0436\u044b\u045e \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0441\u0430\u043c \u0456 \u0441\u044b\u043d\u044b \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043b\u0435\u0432\u0456\u0442 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0432\u0430 \u045e\u0441\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0456, \u0436\u044b\u0432\u0443\u0447\u044b \u0442\u0430\u043c \u044f\u043a \u043f\u0440\u044b\u0448\u043b\u044b, \u0456 \u0437\u0430\u0445\u043e\u0447\u0430 \u043f\u0430\u0439\u0441\u0446\u0456 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u041f\u0430\u043d\u0430\u043c, \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0443\u0441\u0435 \u0431\u0440\u0430\u0442\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u043b\u0435\u0432\u0456\u0442\u044b, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0442\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430\u0441\u0446\u044c \u0442\u0430\u0431\u0435, \u0433\u043b\u044f\u0434\u0437\u0456 &ndash; \u043d\u0435 \u0441\u043c\u0435\u0439 \u043f\u0435\u0440\u0430\u0439\u043c\u0430\u0446\u044c \u0430\u0433\u0456\u0434\u0443 \u0442\u0430\u043c\u0442\u044d\u0439\u0448\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435 \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0431 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0441\u044b\u043d\u0430 \u0446\u0456 \u0434\u0430\u0447\u043a\u0443 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0437 \u0430\u0433\u043e\u043d\u044c, \u0432\u0430\u0440\u0430\u0436\u044b\u045e, \u043d\u0430\u0437\u0456\u0440\u0430\u045e \u0437\u0430 \u0445\u043c\u0430\u0440\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e, \u0437\u0430\u0439\u043c\u0430\u045e\u0441\u044f \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c \u0456 \u0437\u0430\u043a\u043b\u044f\u0446\u0446\u044f\u043c\u0456, \u0432\u044b\u043f\u044b\u0442\u0432\u0430\u045e \u0434\u0443\u0445\u0430\u045e \u0456 \u043f\u0440\u044b\u0432\u0456\u0434\u0430\u045e, \u0437\u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0434\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0411\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0430\u0433\u0456\u0434\u043d\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u044d\u0442\u043a\u0456\u0445 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e \u041f\u0430\u043d \u043f\u0440\u0430\u0433\u043e\u043d\u0456\u0446\u044c \u0456\u0445 \u0430\u0434 \u0442\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430. \u0411\u0443\u0434\u0437\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0441\u0432\u0430\u0456\u043c. \u041d\u0430\u0440\u043e\u0434\u044b, \u0437\u044f\u043c\u043b\u0451\u0439 \u044f\u043a\u0456\u0445 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0435\u0448, \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043e\u045e \u0456 \u043f\u0440\u0430\u0432\u0456\u0434\u0446\u0430\u045e. \u0410\u043b\u0435 \u0442\u0430\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0433\u044d\u0442\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0437 \u0431\u0440\u0430\u0442\u043e\u045e \u0442\u0432\u0430\u0456\u0445, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435. \u042f\u0433\u043e \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u044c, \u044f\u043a \u043f\u0440\u0430\u0441\u0456\u045e \u0442\u044b \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u0413\u0430\u0440\u044d\u0431\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0445\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u0447\u0443\u044e \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043c\u0430\u0439\u0433\u043e \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u045e\u0431\u0430\u0447\u0443 \u0431\u043e\u043b\u044c\u0448 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0430\u0433\u043d\u044e, \u043a\u0430\u0431 \u043c\u043d\u0435 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456&rdquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: &ldquo;\u0414\u043e\u0431\u0440\u0430 \u044f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456. \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0437 \u0431\u0440\u0430\u0442\u043e\u045e \u0456\u0445\u043d\u0456\u0445, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0456 \u045e\u043a\u043b\u0430\u0434\u0443 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0432\u0443\u0441\u043d\u044b \u044f\u0433\u043e\u043d\u044b\u044f, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u044f\u043c\u0443. \u0406 \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u041c\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u041c\u0430\u0451 \u0456\u043c\u044f, \u0437 \u0442\u0430\u0433\u043e \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u042f. \u041f\u0440\u0430\u0440\u043e\u043a \u0436\u0430, \u044f\u043a\u0456 \u0430\u0441\u043c\u0435\u043b\u0456\u0446\u0446\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u041c\u0430\u0451 \u0456\u043c\u044f \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u042f \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u045e \u044f\u043c\u0443 \u043a\u0430\u0437\u0430\u0446\u044c, \u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u0456\u043c\u044f \u0456\u043d\u0448\u044b\u0445 \u0431\u0430\u0433\u043e\u045e, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u0435\u0440\u0446\u0456&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0430\u0448 \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &ldquo;\u042f\u043a \u043c\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u045e?&rdquo;, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0442\u0430\u043a\u0456 \u0437\u043d\u0430\u043a: \u043a\u0430\u043b\u0456 \u043d\u0435\u0439\u043a\u0456 \u043f\u0440\u0430\u0440\u043e\u043a \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u043d\u0435\u0448\u0442\u0430 \u0456 \u043d\u0435 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0433\u044d\u0442\u0430, \u0442\u043e \u041f\u0430\u043d \u043d\u0435 \u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0434\u0443\u043c\u0430\u045e \u0433\u044d\u0442\u0430. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u044f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 18, 18; \u041b\u043a 20, 13b; \u043f\u0430\u0440. \u042f\u043d 6, 14b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0456 \u045e\u043a\u043b\u0430\u0434\u0443 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0432\u0443\u0441\u043d\u044b \u044f\u0433\u043e\u043d\u044b\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u044f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0448\u043b\u044e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u044f\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"32","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f<span style=\"color: #ff0000;\">&nbsp;24, 1 &ndash; 25,4<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0417\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043d\u0430\u043a\u043e\u043d\u0442 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u0430 \u0432\u043e\u0437\u044c\u043c\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0443 \u0456 \u0441\u0442\u0430\u043d\u0435 \u044f\u0435 \u043c\u0443\u0436\u0430\u043c, \u0430\u043b\u0435 \u044f\u043d\u0430 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u045e \u0432\u0430\u0447\u0430\u0445 \u044f\u0433\u043e \u043f\u0440\u0430\u0437 \u043d\u0435\u0448\u0442\u0430 \u0430\u0433\u0456\u0434\u043d\u0430\u0435, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u043f\u0456\u0448\u0430 \u0451\u0439 \u0440\u0430\u0437\u0432\u0430\u0434\u043d\u044b \u043b\u0456\u0441\u0442, \u0434\u0430\u0441\u0446\u044c \u0443 \u0440\u0443\u043a\u0456 \u0451\u0439 \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443. \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u043f\u043e\u0439\u0434\u0437\u0435 \u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0456 \u0434\u0440\u0443\u0433\u0456 \u043c\u0443\u0436 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u044f\u0435, \u043d\u044f\u0445\u0430\u0439 \u0456 \u0451\u043d \u043d\u0430\u043f\u0456\u0448\u0430 \u0451\u0439 \u0440\u0430\u0437\u0432\u0430\u0434\u043d\u044b \u043b\u0456\u0441\u0442 \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u044f\u0435 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443. \u0423 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0430\u0431\u043e \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0440\u044d \u044f\u0435 \u0434\u0440\u0443\u0433\u0456 \u043c\u0443\u0436, \u043f\u0435\u0440\u0448\u044b \u043c\u0443\u0436 \u0443\u0436\u043e \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0430\u0436\u0430\u043d\u0456\u0446\u0446\u0430 \u0437 \u0451\u0439, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u044f. \u0413\u044d\u0442\u0430 \u0430\u0433\u0456\u0434\u043d\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0430 \u0442\u044b \u043d\u0435 \u043d\u0430\u0432\u043e\u0434\u0437\u044c \u0433\u0440\u044d\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430\u0435 \u0442\u0430\u0431\u0435 \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0430\u0436\u0430\u043d\u0456\u045e\u0441\u044f, \u0442\u043e \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u043e\u0439\u0441\u043a\u0430 \u0456 \u043d\u0430 \u044f\u0433\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0456 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0433\u043e\u0434\u0430, \u043a\u0430\u0431 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0437 \u0436\u043e\u043d\u043a\u0430\u044e \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u044f\u0440\u044b \u045e \u0437\u0430\u043b\u043e\u0433 \u0432\u0435\u0440\u0445\u043d\u0456 \u0446\u0456 \u043d\u0456\u0436\u043d\u0456 \u043c\u043b\u044b\u043d\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u045e \u0437\u0430\u043b\u043e\u0433 \u0441\u0430\u043c\u043e \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0432\u044b\u043a\u0440\u0430\u0434\u0437\u0435 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0437 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445, \u0437 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u044f\u043a \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430 \u0446\u0456 \u043f\u0440\u0430\u0434\u0430\u0441\u0446\u044c \u044f\u0433\u043e, \u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b \u0433\u044d\u0442\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0435\u0446. \u0406 \u0442\u044b \u0437\u043d\u0456\u0448\u0447\u044b \u0433\u044d\u0442\u0430\u0435 \u0437\u043b\u043e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u0446\u044f\u0431\u0435 \u043f\u043e\u0448\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u043a\u0430\u0437\u044b, \u043f\u0456\u043b\u044c\u043d\u0430 \u0437\u0432\u0430\u0436\u0430\u0439, \u043a\u0430\u0431 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0451, \u0447\u0430\u043c\u0443 \u0432\u0430\u0441 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u044b-\u043b\u0435\u0432\u0456\u0442\u044b, \u044f\u043a \u044f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u043c. \u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0437\u0440\u0430\u0431\u0456\u045e \u041c\u0456\u0440\u044b\u044f\u043c \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435, \u043a\u0430\u043b\u0456 \u0432\u044b \u0441\u044b\u0448\u043b\u0456 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0435\u0448\u0442\u0430 \u043f\u0430\u0437\u044b\u0447\u044b\u0448 \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443 \u0441\u0432\u0430\u0439\u043c\u0443, \u043d\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u044c \u0443 \u0434\u043e\u043c \u044f\u0433\u043e\u043d\u044b, \u043a\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0437\u0430\u043b\u043e\u0433, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0432\u043e\u043d\u043a\u0456. \u041f\u0430\u0437\u044b\u043a\u043e\u0432\u0435\u0446 \u0441\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0442\u0430\u0431\u0435 \u0437\u0430\u043b\u043e\u0433, \u044f\u043a\u0456 \u045e \u044f\u0433\u043e \u0451\u0441\u0446\u044c. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0431\u0435\u0434\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0435 \u043d\u0430\u0447\u0443\u0439 \u043f\u0430\u0434 \u0437\u0430\u043b\u043e\u0433\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c, \u0430\u043b\u0435 \u0432\u044f\u0440\u043d\u0456 \u044f\u043c\u0443 \u0437\u0430\u043b\u043e\u0433 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430. \u0406 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u0446\u044c \u0451\u043d \u0443 \u0430\u0434\u0437\u0435\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u0430 \u0442\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0439 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0456 \u045e\u0431\u043e\u0433\u0430\u0433\u0430 \u043d\u0430\u0439\u043c\u0456\u0442\u0430 \u0437 \u0431\u0440\u0430\u0442\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0430\u0431\u043e \u0437 \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u0430\u0431\u043e\u0439 \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u043f\u043b\u0430\u0446\u0456 \u044f\u043c\u0443 \u0437\u0430\u0440\u043e\u0431\u0430\u043a \u0437\u0430 \u043f\u0440\u0430\u0446\u0443 \u044f\u0433\u043e \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430, \u0431\u043e \u0451\u043d \u0431\u0435\u0434\u043d\u044b \u0456 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u041f\u0430\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u0442\u0430\u0431\u0435 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0446\u044c\u043a\u0456 \u043d\u0435 \u043d\u044f\u0441\u0443\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0430 \u0441\u044b\u043d\u044b &ndash; \u0437\u0430 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u043c\u0440\u044d \u0437\u0430 \u0441\u0432\u043e\u0439 \u0433\u0440\u044d\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u0440\u0443\u0448\u0430\u0439 \u043f\u0440\u0430\u0432\u0430 \u0447\u0443\u0436\u044b\u043d\u0446\u0430 \u0456 \u0441\u0456\u0440\u0430\u0442\u044b, \u0456 \u043d\u0435 \u0431\u044f\u0440\u044b \u045e \u0437\u0430\u043b\u043e\u0433 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u045e\u0434\u0430\u0432\u044b. \u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u045e \u0442\u044b \u045e \u0415\u0433\u0456\u043f\u0446\u0435 \u0456 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0446\u044f\u0431\u0435 \u0430\u0434\u0442\u0443\u043b\u044c, \u0442\u0430\u043c\u0443 \u044f \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0430. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0436\u0430\u0446\u044c \u0437\u0431\u043e\u0436\u0436\u0430 \u043d\u0430 \u043f\u043e\u043b\u0456 \u0441\u0432\u0430\u0456\u043c \u0456 \u0437\u0430\u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043d\u043e\u043f \u043d\u0430 \u043f\u043e\u043b\u0456, \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0439\u0441\u044f \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u0430\u043b\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u0447\u0443\u0436\u044b\u043d\u0446\u0443, \u0441\u0456\u0440\u0430\u0446\u0435 \u0456 \u045e\u0434\u0430\u0432\u0435, \u043a\u0430\u0431 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0432\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0440\u0443\u043a \u0442\u0432\u0430\u0456\u0445. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0431\u0442\u0440\u0430\u0441\u0430\u0446\u044c \u0430\u043b\u0456\u045e\u043a\u0456 \u0441\u0432\u0430\u0435, \u043d\u0435 \u043f\u0435\u0440\u0430\u0433\u043b\u044f\u0434\u0430\u0439 \u0433\u0430\u043b\u0456\u043d\u0430\u043a &ndash; \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043d\u0435\u0448\u0442\u0430 \u0434\u043b\u044f \u0447\u0443\u0436\u044b\u043d\u0446\u0430, \u0441\u0456\u0440\u0430\u0442\u044b \u0456 \u045e\u0434\u0430\u0432\u044b. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0433\u0440\u043e\u043d\u043a\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0435 \u0437\u0431\u0456\u0440\u0430\u0439 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u0445 \u0440\u044d\u0448\u0442\u043a\u0430\u045e, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u0434\u043b\u044f \u0447\u0443\u0436\u044b\u043d\u0446\u0430, \u0441\u0456\u0440\u0430\u0442\u044b \u0456 \u045e\u0434\u0430\u0432\u044b. \u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u0442\u044b \u0431\u044b\u045e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0443 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0442\u0430\u043c\u0443 \u044f \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e\u0437\u043d\u0456\u043a\u043d\u0435 \u0441\u043f\u0440\u044d\u0447\u043a\u0430 \u043f\u0430\u043c\u0456\u0436 \u043a\u0456\u043c\u0441\u044c\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u043c, \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u044f\u0446\u044c \u0456\u0445, \u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0430 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u0430\u0433\u0430 \u0430\u0441\u0443\u0434\u0437\u044f\u0446\u044c. \u041a\u0430\u043b\u0456 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u044f, \u0441\u0443\u0434\u0434\u0437\u044f \u0437\u0430\u0433\u0430\u0434\u0430\u0435 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u044f\u0433\u043e \u0456 \u0432\u044b\u0441\u044f\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u0435 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044e \u045e\u0434\u0430\u0440\u0430\u045e. \u0410\u0434\u043d\u0430\u043a \u043d\u0435\u043b\u044c\u0433\u0430 \u043b\u0443\u043f\u0446\u0430\u0432\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0447\u044b\u043c \u0441\u0430\u0440\u0430\u043a\u0430 \u045e\u0434\u0430\u0440\u0430\u043c\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043f\u0430\u043c\u043d\u0430\u0436\u044d\u043d\u043d\u0435 \u045e\u0434\u0430\u0440\u0430\u045e \u0442\u0432\u043e\u0439 \u0431\u0440\u0430\u0442 \u043d\u0435 \u0431\u044b\u045e \u0437\u043d\u044f\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u045e \u0432\u0430\u0447\u0430\u0445 \u0442\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u0430\u0432\u044f\u0437\u0432\u0430\u0439 \u043f\u044b\u0441\u044b \u0431\u044b\u043a\u0443, \u044f\u043a\u0456 \u043c\u0430\u043b\u043e\u0446\u0456\u0446\u044c \u043d\u0430 \u0442\u0430\u043a\u0443 \u045e\u0440\u0430\u0434\u0436\u0430\u0439 \u0442\u0432\u043e\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u043a 12, 32-33; \u0421\u0456\u0440 35, 2-3<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u0422\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0442\u0440\u044d\u0431\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0435 \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0434\u0430\u0435 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b. \u0410\u0434\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u0437\u043b\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0435 \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"33","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">26, 1-19&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u0441\u044b\u043d\u043e\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430\u0441\u0446\u044c \u0442\u0430\u0431\u0435 \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u0432\u043e\u0437\u044c\u043c\u0435\u0448 \u044f\u0435 \u0456 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0441\u044f \u043d\u0430 \u0451\u0439. \u0406 \u0432\u043e\u0437\u044c\u043c\u0435\u0448 \u043f\u0435\u0440\u0448\u044b \u043f\u043b\u0451\u043d \u0443\u0441\u0456\u0445 \u043f\u043b\u0430\u0434\u043e\u045e \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0442\u043e\u0439, \u044f\u043a\u0443\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430\u0435 \u0442\u0430\u0431\u0435, \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u0448 \u0443 \u043a\u043e\u0448, \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u044f\u043a\u043e\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0432\u044b\u0431\u0435\u0440\u0430 \u043d\u0430 \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e. \u0406 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u045e \u0442\u044b\u044f \u0434\u043d\u0456, \u0456 \u0441\u043a\u0430\u0436\u0430\u0448 \u044f\u043c\u0443: &ldquo;\u0412\u044b\u0437\u043d\u0430\u044e \u0441\u0451\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0448\u0442\u043e \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0430\u0431\u044f\u0446\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0439\u0446\u0430\u043c\u0456 \u043d\u0430\u0448\u044b\u043c\u0456 \u0434\u0430\u0446\u044c \u043d\u0430\u043c&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u0430\u0440 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u043e\u0448 \u0437 \u0440\u0443\u043a \u0442\u0432\u0430\u0456\u0445 \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u0410 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0411\u043e\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c: &ldquo;\u041c\u043e\u0439 \u0431\u0430\u0446\u044c\u043a\u0430, \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u044b \u0430\u0440\u0430\u043c\u0435\u0435\u0446, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0415\u0433\u0456\u043f\u0435\u0442 \u0456 \u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0442\u0430\u043c \u0437 \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0430\u044e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044e \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u0442\u0430\u043c \u0451\u043d \u0441\u0442\u0430\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u043c \u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0434\u0440\u044d\u043d\u043d\u0430 \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0437 \u043d\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u0456 \u043d\u0430\u0441, \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u044e\u0447\u044b \u0446\u044f\u0436\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u0430\u0439. \u041c\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u0456 \u043f\u0430\u0447\u0443\u045e \u043d\u0430\u0441 \u041f\u0430\u043d, \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435, \u043d\u0430\u0448\u0443\u044e \u043d\u044f\u0434\u043e\u043b\u044e \u0456 \u045e\u0446\u0456\u0441\u043a. \u0406 \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u041f\u0430\u043d \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0456 \u0440\u0430\u0441\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u043f\u043b\u044f\u0447\u043e\u043c, \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0442\u0440\u0430\u0445\u0443, \u0441\u044f\u0440\u043e\u0434 \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0446\u0443\u0434\u0430\u045e. \u0401\u043d \u043f\u0440\u044b\u0432\u0451\u045e \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0448\u0442\u043e \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c. \u0406 \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u044f \u043f\u0440\u044b\u043d\u0451\u0441 \u043f\u0435\u0440\u0448\u044b\u044f \u043f\u043b\u0430\u0434\u044b \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u043c\u043d\u0435, \u041f\u0430\u043d\u0435&rdquo;. \u0422\u0430\u0434\u044b \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u0448 \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u0448\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c. \u0406 \u0431\u0443\u0434\u0437\u0435\u0448 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043b\u0435\u0432\u0456\u0442\u0430\u043c \u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c, \u044f\u043a\u0456\u044f \u0437 \u0442\u0430\u0431\u043e\u0439, \u0443\u0441\u044f\u043c\u0443 \u0434\u0430\u0431\u0440\u0443, \u044f\u043a\u043e\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430\u0435 \u0442\u0430\u0431\u0435 \u0456 \u0442\u0432\u0430\u0439\u043c\u0443 \u0434\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0433\u043e\u0434, \u0433\u043e\u0434 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d, \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u0448 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d \u0437 \u0443\u0440\u0430\u0434\u0436\u0430\u044f\u045e \u0441\u0432\u0430\u0456\u0445, \u043a\u0430\u043b\u0456 \u0430\u0434\u0434\u0430\u0441\u0456 \u043b\u0435\u0432\u0456\u0442\u0443, \u0447\u0443\u0436\u044b\u043d\u0446\u0443, \u0441\u0456\u0440\u0430\u0446\u0435 \u0456 \u045e\u0434\u0430\u0432\u0435, \u043a\u0430\u0431 \u043d\u0430\u0435\u043b\u0456\u0441\u044f \u045e\u0434\u043e\u0441\u0442\u0430\u043b\u044c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u0442\u0430\u0434\u044b \u0441\u043a\u0430\u0436\u0430\u0448 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e: &ldquo;\u042f \u043f\u0440\u044b\u0431\u0440\u0430\u045e \u0437 \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430, \u0456 \u0430\u0434\u0434\u0430\u045e \u043b\u0435\u0432\u0456\u0442\u0443, \u0447\u0443\u0436\u044b\u043d\u0446\u0443, \u0441\u0456\u0440\u0430\u0446\u0435 \u0456 \u045e\u0434\u0430\u0432\u0435, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u0422\u044b \u0434\u0430\u045e \u043c\u043d\u0435. \u042f \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u044b\u045e \u0456 \u043d\u0435 \u0437\u0430\u0431\u044b\u045e \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0437 \u0422\u0432\u0430\u0456\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e. \u042f \u043d\u0435 \u0435\u045e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0436\u0430\u043b\u043e\u0431\u044b, \u043d\u0435 \u0432\u044b\u043d\u043e\u0441\u0456\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u045e \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0442\u0430\u043d\u0435, \u043d\u0435 \u0434\u0430\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u043c\u0443. \u042f \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e \u0433\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043c\u0430\u0439\u0433\u043e, \u0456 \u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0422\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0436\u044b\u0442\u043b\u0430, \u0437 \u043d\u0435\u0431\u0430, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0456 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u043d\u0430\u043c, \u044f\u043a \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0430\u0439\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b. \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439 \u0456\u0445 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0434 \u0443\u0441\u0451\u0439 \u0434\u0443\u0448\u044b \u0441\u0432\u0430\u0451\u0439. \u0421\u0451\u043d\u043d\u044f \u0442\u044b \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e, \u0448\u0442\u043e \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043f\u0430 \u0448\u043b\u044f\u0445\u0430\u0445 \u042f\u0433\u043e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u044b, \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u041f\u0430\u043d \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0442\u0430\u0431\u0435 \u0441\u0451\u043d\u043d\u044f, \u0448\u0442\u043e \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u044f\u043a \u043a\u0430\u0437\u0430\u045e \u0422\u0430\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0443\u0441\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e. \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0434\u043b\u044f \u0445\u0432\u0430\u043b\u044b, \u0456\u043c\u0435\u043d\u0456 \u0456 \u0441\u043b\u0430\u0432\u044b \u0441\u0432\u0430\u0451\u0439, \u043a\u0430\u0431 \u0442\u044b \u0431\u044b\u045e \u0441\u0432\u044f\u0442\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 9\u0430. 10; \u043f\u0430\u0440. \u0414\u0440\u0433 7, 7. 8<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u043d\u0430\u0440\u043e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b; <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"34","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">29, 1-5. 9-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u043a\u043b\u0451\u043d \u043f\u0430\u0440\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u041f\u0430\u043d \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0443 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0444\u0430\u0440\u0430\u043e\u043d\u0443, \u0443\u0441\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u0456 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u044f\u0433\u043e\u043d\u0430\u0439; \u0442\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0431\u0430\u0447\u044b\u043b\u0456 \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u0456 \u0442\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b. \u041f\u0430\u043d \u043d\u0435 \u0434\u0430\u045e \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0456 \u0432\u0430\u0447\u044d\u0439, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c, \u0456 \u0432\u0443\u0448\u044d\u0439, \u043a\u0430\u0431 \u0447\u0443\u0446\u044c, \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f. \u0421\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e \u0432\u0451\u045e \u0432\u0430\u0441 \u043f\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0456 \u043d\u0435 \u043f\u0430\u0440\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0432\u0430\u0448\u0430, \u0456 \u0430\u0431\u0443\u0442\u0430\u043a \u043d\u0435 \u0437\u043d\u0430\u0441\u0456\u045e\u0441\u044f \u043d\u0430 \u0442\u0432\u0430\u0456\u0445 \u043d\u0430\u0433\u0430\u0445. \u0412\u044b \u043d\u0435 \u0435\u043b\u0456 \u0445\u043b\u0435\u0431\u0430, \u043d\u0435 \u043f\u0456\u043b\u0456 \u0432\u0456\u043d\u0430 \u0456 \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u043d\u0430\u043f\u043e\u044e, \u043a\u0430\u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0432\u044b \u0441\u0451\u043d\u043d\u044f \u0441\u0442\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0432\u0430\u0448\u044b \u0456 \u043f\u043b\u044f\u043c\u0451\u043d \u0432\u0430\u0448\u044b\u0445, \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u0456 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0456, \u043a\u043e\u0436\u043d\u044b \u043c\u0443\u0436 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0434\u0437\u0435\u0446\u0456, \u0436\u043e\u043d\u043a\u0456 \u0432\u0430\u0448\u044b \u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u044b \u0432\u0430\u0448\u044b, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0442\u0432\u0430\u0456\u043c \u043b\u0430\u0433\u0435\u0440\u044b &ndash; \u043f\u0430\u0447\u0430\u045e\u0448\u044b \u0437 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0441\u044f\u043a\u0430\u0435 \u0434\u0440\u044d\u0432\u0430, \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0447\u044d\u0440\u043f\u0430\u0435 \u0432\u0430\u0434\u0443. \u0412\u044b \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u044f\u043a\u0456 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0441\u0451\u043d\u043d\u044f \u0437 \u0432\u0430\u043c\u0456 \u043f\u0430\u0434 \u043a\u043b\u044f\u0442\u0432\u0430\u0439, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u044f\u043a \u0430\u0431\u044f\u0446\u0430\u045e \u0442\u0430\u0431\u0435 \u0456 \u044f\u043a \u043a\u043b\u044f\u045e\u0441\u044f \u0430\u0439\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c &ndash; \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0432\u0430\u043c\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e \u0433\u044d\u0442\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e \u043a\u043b\u044f\u0442\u0432\u0443 \u0433\u044d\u0442\u0443, \u0430\u043b\u0435 \u0456 \u0437 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u0441\u0442\u0430\u0456\u0446\u044c \u0437 \u043d\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u0437 \u0442\u044b\u043c\u0456, \u043a\u0430\u0433\u043e \u0441\u0451\u043d\u043d\u044f \u0437 \u043d\u0430\u043c\u0456 \u043d\u044f\u043c\u0430. \u0411\u043e \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u044f\u043a \u043c\u044b \u0436\u044b\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0456 \u044f\u043a \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043c\u0456\u0436 \u044f\u043a\u0456\u0445 \u043d\u0430\u043c \u0434\u0430\u0432\u044f\u043b\u043e\u0441\u044f \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u0412\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456\u0445 \u0430\u0433\u0456\u0434\u0443, \u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0437 \u0434\u0440\u044d\u0432\u0430 \u0456 \u043a\u0430\u043c\u043d\u044e, \u0441\u0430 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a\u0456\u044f \u045e \u0456\u0445. \u041d\u044f\u0445\u0430\u0439 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u043d\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u043d\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043d\u0456 \u0441\u044f\u043c&rsquo;\u0456 \u0446\u0456 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u0447\u044b\u0451 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0431 \u0441\u0451\u043d\u043d\u044f \u0430\u0434 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043f\u0430\u0439\u0448\u043e\u045e\u0448\u044b \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0431\u0430\u0433\u0430\u043c \u0442\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043a\u0430\u0440\u044d\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0430\u0442\u0440\u0443\u0442\u0443 \u0456 \u043f\u0430\u043b\u044b\u043d. \u0406 \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430, \u043f\u0430\u0447\u0443\u045e\u0448\u044b \u0441\u043b\u043e\u0432\u044b \u043a\u043b\u044f\u0442\u0432\u044b \u0433\u044d\u0442\u0430\u0439, \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0441\u044f\u0431\u0435, \u0443 \u0441\u044d\u0440\u0446\u044b \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0421\u043f\u0430\u043a\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u0430 \u043c\u043d\u043e\u0439, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0436\u044b\u0446\u044c \u0437 \u0443\u043f\u0430\u0440\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c,&rdquo; \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u043d\u0430\u043f\u043e\u0435\u043d\u0443\u044e \u0456 \u0437\u0430\u0441\u043e\u0445\u043b\u0443\u044e, \u041f\u0430\u043d \u043d\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u0446\u044c \u044f\u043c\u0443, \u0431\u043e \u0442\u0430\u0434\u044b \u0437\u0430\u043f\u0430\u043b\u0430\u0435 \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430 \u0456 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c \u044f\u0433\u043e \u043d\u0430 \u043c\u0443\u0436\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u0456 \u0437\u0432\u0430\u043b\u044f\u0446\u0446\u0430 \u043d\u0430 \u044f\u0433\u043e \u045e\u0441\u0435 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u044b, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0437\u0435, \u0456 \u0441\u0430\u0442\u0440\u044d \u041f\u0430\u043d \u0456\u043c\u044f \u044f\u0433\u043e\u043d\u0430\u0435 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u0456 \u041f\u0430\u043d \u0432\u044b\u043b\u0443\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u043d\u0430 \u0437\u0433\u0443\u0431\u0443 \u0437 \u0443\u0441\u0456\u0445 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u0445 \u0443 \u043a\u043d\u0456\u0437\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0436\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435, \u0441\u044b\u043d\u044b \u0432\u0430\u0448\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0435\u0439, \u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u043d\u044f\u0434\u043e\u043b\u044e \u0437\u044f\u043c\u043b\u0456 \u0433\u044d\u0442\u0430\u0439, \u044f\u043a\u0456\u043c\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u0435 \u044f\u0435 \u041f\u0430\u043d. \u0421\u0435\u0440\u0430 \u0456 \u0441\u043e\u043b\u044c, \u043f\u0430\u043f\u044f\u043b\u0456\u0448\u0447\u0430 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u044f\u0433\u043e. \u041d\u0435 \u0437\u0430\u0441\u0435\u044e\u0446\u044c \u044f\u0435, \u043d\u0435 \u043f\u0440\u0430\u0440\u0430\u0441\u0446\u0435 \u0456 \u043d\u0435 \u0432\u044b\u0440\u0430\u0441\u0446\u0435 \u043d\u0430 \u0451\u0439 \u043d\u0456\u044f\u043a\u0430\u044f \u0442\u0440\u0430\u0432\u0430, \u044f\u043a \u0443 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0456 \u0421\u0430\u0434\u043e\u043c\u044b, \u0413\u0430\u043c\u043e\u0440\u044b, \u0410\u0434\u043c\u044b \u0456 \u0421\u044d\u0431\u0430\u0456\u043c\u0430, \u044f\u043a\u0456\u044f \u041f\u0430\u043d \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0443 \u0433\u043d\u0435\u0432\u0435 \u0456 \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439. \u0406 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0441\u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u0427\u0430\u043c\u0443 \u041f\u0430\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a \u0437 \u0437\u044f\u043c\u043b\u0451\u0439 \u0433\u044d\u0442\u0430\u0439? \u0427\u0430\u043c\u0443 \u0442\u0430\u043a\u0456 \u043b\u044e\u0442\u044b \u0433\u043d\u0435\u045e?&rdquo; \u0406 \u0430\u0434\u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0456\u0445 \u0430\u0439\u0446\u043e\u045e, \u044f\u043a\u0456 \u041f\u0430\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0456\u043c\u0456, \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u045e \u0456\u0445 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u042f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0447\u0443\u0436\u044b\u043c \u0431\u0430\u0433\u0430\u043c \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0431\u0430\u0433\u0430\u043c, \u044f\u043a\u0456\u0445 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0456 \u044f\u043a\u0456\u0445 \u041f\u0430\u043d \u043d\u0435 \u0434\u0430\u0432\u0430\u045e \u0456\u043c. \u0422\u0430\u043c\u0443 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u045e\u0441\u044f \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u0456 \u0433\u044d\u0442\u0430\u0439, \u0456 \u043d\u0430\u0432\u0451\u045e \u041f\u0430\u043d \u043d\u0430 \u044f\u0435 \u045e\u0441\u0435 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u044b, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e \u043a\u043d\u0456\u0437\u0435 \u0433\u044d\u0442\u0430\u0439. \u0406 \u0432\u044b\u0440\u0432\u0430\u045e \u0456\u0445 \u0437 \u0437\u044f\u043c\u043b\u0456 \u045e \u0433\u043d\u0435\u0432\u0435, \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u0456 \u043f\u0440\u0430\u0433\u043d\u0430\u045e \u0456\u0445 \u043d\u0430 \u0447\u0443\u0436\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0448\u0442\u043e \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0441\u0451\u043d\u043d\u044f&rdquo;.&nbsp;\u0423\u0442\u043e\u0435\u043d\u0430\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u0430 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430\u0435 &ndash; \u043d\u0430\u043c \u0456 \u0441\u044b\u043d\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u043d\u0430\u0432\u0435\u043a\u0456, \u043a\u0430\u0431 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u0417\u0430\u043a\u043e\u043d\u0443 \u0433\u044d\u0442\u0430\u0433\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 3, 13-14; \u043f\u0430\u0440. \u0414\u0440\u0433 8, 14b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c, \u043a\u0430\u0431 \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0441\u0442\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"35","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">30, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u0437\u0431\u0443\u0434\u0443\u0446\u0446\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d, \u044f\u043a\u0456\u044f \u044f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u0439, \u0456 \u0442\u044b \u043f\u0440\u044b\u043c\u0435\u0448 \u0456\u0445 \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0433\u043e\u043d\u0456\u0446\u044c. \u041a\u0430\u043b\u0456 \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e \u0432\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u044f \u0442\u0430\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e, \u0442\u044b \u0456 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u0430\u0434 \u0443\u0441\u0451\u0439 \u0434\u0443\u0448\u044b \u0441\u0432\u0430\u0451\u0439, \u0442\u043e \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0435\u0440\u043d\u0435 \u0446\u044f\u0431\u0435 \u0437 \u0442\u0432\u0430\u0439\u0433\u043e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u044f \u0456 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. \u0417\u043d\u043e\u045e \u0437\u0431\u044f\u0440\u044d \u0446\u044f\u0431\u0435 \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u0440\u0430\u043d\u0435\u0439. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u0433\u043d\u0430\u043d\u044b \u043d\u0430 \u043a\u0440\u0430\u0439 \u043d\u0435\u0431\u0430\u0441\u0445\u0456\u043b\u0443, \u043d\u0430\u0432\u0430\u0442 \u0430\u0434\u0442\u0443\u043b\u044c \u0437\u0431\u044f\u0440\u044d \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0456 \u0430\u0434\u0442\u0443\u043b\u044c \u0437\u0430\u0431\u044f\u0440\u044d \u0446\u044f\u0431\u0435. \u0406 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u043e\u0439 \u0432\u0430\u043b\u043e\u0434\u0430\u043b\u0456 \u0430\u0439\u0446\u044b \u0442\u0432\u0430\u0435, \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u044f\u0435 \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u0456 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u0437\u0430 \u0442\u0432\u0430\u0456\u0445 \u0430\u0439\u0446\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0440\u044d\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451 \u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u0442\u044b \u043b\u044e\u0431\u0456\u045e \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0442\u0432\u0430\u0451\u0439, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435. \u0410 \u045e\u0441\u0435 \u0442\u044b\u044f \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0430\u0431\u0435\u0440\u043d\u0435 \u043d\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0456 \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435. \u0410 \u0442\u044b \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u044f \u0434\u0430\u044e \u0442\u0430\u0431\u0435 \u0441\u0451\u043d\u043d\u044f. \u0406 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0451\u0439, \u0443 \u043f\u043b\u043e\u0434\u0437\u0435 \u045e\u043b\u043e\u043d\u043d\u044f \u0442\u0432\u0430\u0439\u0433\u043e, \u0443 \u043f\u0440\u044b\u043f\u043b\u043e\u0434\u0437\u0435 \u0431\u044b\u0434\u043b\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u0432\u0430 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0433\u043b\u0435\u0431\u044b \u0442\u0432\u0430\u0451\u0439. \u0411\u043e \u041f\u0430\u043d \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0437\u0430 \u045e\u0441\u0451 \u0434\u0430\u0431\u0440\u043e \u0442\u0432\u0430\u0451, \u044f\u043a \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0437\u0430 \u0430\u0439\u0446\u043e\u045e \u0442\u0432\u0430\u0456\u0445. \u0411\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0456 \u043d\u0430\u043a\u0430\u0437\u044b \u042f\u0433\u043e\u043d\u044b\u044f, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0437\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0456 \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u044e \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c, \u044f\u043a\u0443\u044e \u0441\u0451\u043d\u043d\u044f \u0434\u0430\u044e \u0442\u0430\u0431\u0435, &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0446\u044f\u0436\u043a\u0430\u0435 \u0456 \u043d\u0435\u0434\u0430\u0441\u044f\u0433\u0430\u043b\u044c\u043d\u0430\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435. \u042f\u043d\u0430 \u043d\u0435 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u043a\u0430\u0431 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &ldquo;\u0425\u0442\u043e \u0431 \u0443\u0437\u044b\u0448\u043e\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0443 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u0435 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u044f\u0435?&rdquo; \u0406 \u043d\u0435 \u0437\u0430 \u043c\u043e\u0440\u0430\u043c \u044f\u043d\u0430, \u043a\u0430\u0431 \u0432\u044b \u043a\u0430\u0437\u0430\u043b\u0456: &ldquo;\u0425\u0442\u043e \u0431 \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u043f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430 \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u0435 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u044f\u0435?&rdquo; \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0433\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0431\u043b\u0456\u0437\u043a\u0430\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435: \u044f\u043d\u043e \u045e \u0442\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445 \u0456 \u045e \u0442\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u043a\u0430\u0431 \u0442\u044b \u043c\u043e\u0433 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u0434\u0437\u0456, \u0441\u0451\u043d\u043d\u044f \u044f \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0436\u044b\u0446\u0446\u0451 \u0456 \u0448\u0447\u0430\u0441\u0446\u0435, \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435. \u0422\u0430\u043c\u0443 \u0441\u0451\u043d\u043d\u044f \u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u042f\u0433\u043e \u0448\u043b\u044f\u0445\u0430\u043c\u0456, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u042f\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u044b, \u043a\u0430\u0431 \u0442\u044b \u0436\u044b\u045e \u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u045e\u0441\u044f. \u0410 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u045e \u043a\u0440\u0430\u0456\u043d\u0435, \u044f\u043a\u043e\u044e \u0442\u044b \u0456\u0434\u0437\u0435\u0448 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430, \u0456 \u0442\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0437\u0432\u044f\u0434\u0443\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u0442\u044b \u0441\u0442\u0430\u043d\u0435\u0448 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0456\u043d\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u043c, \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456\u043c, &ndash; \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0432\u0430\u043c \u0441\u0451\u043d\u043d\u044f, &ndash; \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0437\u0433\u0456\u043d\u0435\u0446\u0435, \u043d\u0435\u043d\u0430\u0434\u043e\u045e\u0433\u0430 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u043e\u044e \u0456\u0434\u0437\u044f\u0446\u0435 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0443 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u0430\u0441, \u0448\u0442\u043e \u044f \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0441\u043c\u0435\u0440\u0446\u044c, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d. \u0422\u0430\u043c\u0443 \u0432\u044b\u0431\u0435\u0440\u044b \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u0436\u044b\u045e \u0442\u044b \u0456 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0451, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u045e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0456 \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u042f\u0433\u043e. \u0411\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0442\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u0442\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0434\u0430\u0446\u044c \u043f\u0440\u043e\u0434\u043a\u0430\u043c \u0442\u0432\u0430\u0456\u043c &ndash; \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0415\u0440 29, 13-14\u0430; \u041c\u0446 7, 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435.<span style=\"color: #ff0000;\"> *<\/span> \u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u0432\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0456 \u0437\u043c\u044f\u043d\u044e \u0434\u0430 \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0432\u0430\u0448 \u043b\u0451\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0443\u043a\u0430\u0439\u0446\u0435, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435; \u0441\u0442\u0443\u043a\u0430\u0439\u0446\u0435, \u0456 \u0430\u0434\u0447\u044b\u043d\u044f\u0446\u044c \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u0432\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0456 \u0437\u043c\u044f\u043d\u044e \u0434\u0430 \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0432\u0430\u0448 \u043b\u0451\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"36","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">31, 1-15. 23<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0448\u043d\u0456\u044f \u0441\u043b\u043e\u0432\u044b \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0439\u0448\u043e\u045e \u0456, \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e\u0448\u044b \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0433\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0421\u0451\u043d\u043d\u044f \u043c\u043d\u0435 \u0441\u0442\u043e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u044f \u045e\u0436\u043e \u043d\u0435 \u043c\u0430\u0433\u0443 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430 \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0448\u0442\u043e \u0456 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u0422\u044b \u043d\u0435 \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435\u0448 \u0433\u044d\u0442\u0430\u0433\u0430 \u042f\u0440\u0434\u0430\u043d\u0430&rdquo;. \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0441\u0430\u043c \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e. \u0401\u043d \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0456 \u0442\u044b \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0435\u0448 \u0456\u043c\u0456. \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u044f\u043a \u0430\u0431\u044f\u0446\u0430\u045e \u041f\u0430\u043d. \u0406 \u041f\u0430\u043d \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0456\u043c, \u044f\u043a \u0437\u0440\u0430\u0431\u0456\u045e \u0430\u043c\u0430\u0440\u044d\u0439\u0441\u043a\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u044f\u043c \u0421\u0456\u0433\u043e\u043d\u0443 \u0456 \u041e\u0433\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456\u0445\u043d\u044f\u0439, \u043a\u0430\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0456\u0445. \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0456\u0445 \u0432\u0430\u043c, \u0430 \u0432\u044b \u0437\u0440\u043e\u0431\u0456\u0446\u0435 \u0437 \u0456\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u044f \u0434\u0430\u045e \u0432\u0430\u043c. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0443\u0436\u043d\u044b\u044f \u0456 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u044f, \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u0456\u0445, \u0431\u043e \u0441\u0430\u043c \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043f\u043e\u0439\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0401\u043d \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c: &laquo;\u0411\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b \u0456 \u0430\u0434\u0432\u0430\u0436\u043d\u044b, \u0431\u043e \u0442\u044b \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0448 \u0437 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0434\u0430\u0446\u044c \u0430\u0439\u0446\u0430\u043c \u0456\u0445\u043d\u0456\u043c, \u0430 \u0442\u044b \u0430\u0434\u0434\u0430\u0441\u0456 \u044f\u0435 \u0456\u043c \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435. \u041f\u0430\u043d \u0441\u0430\u043c \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0401\u043d \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0441\u044f. \u041f\u0430\u043d, \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0442\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u0439, \u043d\u0435 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0441\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043f\u0456\u0441\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0417\u0430\u043a\u043e\u043d \u0433\u044d\u0442\u044b \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u041b\u0435\u0432\u0456\u044f, \u044f\u043a\u0456\u044f \u043d\u0430\u0441\u0456\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430, \u0456 \u045e\u0441\u0456\u043c \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0440\u0430\u0437 \u0441\u0435\u043c \u0433\u0430\u0434\u043e\u045e, \u0443 \u0433\u043e\u0434 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u0434\u0430\u045e\u0433\u043e\u045e, \u0432\u0430 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u041d\u0430\u043c\u0451\u0442\u0430\u045e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u043a\u0430\u0431 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0401\u043d \u0432\u044b\u0431\u0435\u0440\u0430, \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0435\u0448 \u0441\u043b\u043e\u0432\u044b \u0417\u0430\u043a\u043e\u043d\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u044c. \u0417\u0431\u044f\u0440\u044b \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434: \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u0434\u0437\u044f\u0446\u0435\u0439 \u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0437 \u0442\u0430\u0431\u043e\u0439 \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u043a\u0430\u0431, \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b, \u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0431\u0430\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u0417\u0430\u043a\u043e\u043d\u0443 \u0433\u044d\u0442\u0430\u0433\u0430. \u0410 \u0441\u044b\u043d\u044b \u0456\u0445, \u044f\u043a\u0456\u044f \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u0446\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0434\u043b\u044f \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u044f \u044f\u043a\u043e\u0439 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0412\u043e\u0441\u044c, \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u044e\u0446\u0446\u0430 \u0434\u043d\u0456 \u0442\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u043f\u0430\u043a\u043b\u0456\u0447 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u0456 \u0441\u0442\u0430\u043d\u044c \u0437 \u0456\u043c \u0443 \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u0430\u0434\u0434\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437 \u044f\u043c\u0443&raquo;. \u0406 \u043f\u0430\u0439\u0448\u043e\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d, \u0456 \u0441\u0442\u0430\u043b\u0456 \u045e \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f. \u0417&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0456\u043c \u041f\u0430\u043d \u0443 \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0448\u0430\u0446\u0451\u0440. \u0406 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0443, \u0441\u044b\u043d\u0443 \u041d\u0443\u043d\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u0430\u0446\u0443\u0439\u0441\u044f \u0456 \u0431\u0443\u0434\u0437\u044c \u0430\u0434\u0432\u0430\u0436\u043d\u044b, \u0431\u043e \u0442\u044b \u045e\u0432\u044f\u0434\u0437\u0435\u0448 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u042f \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0456\u043c, \u0456 \u042f \u0431\u0443\u0434\u0443 \u0437 \u0442\u0430\u0431\u043e\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0440\u0433 31, 7b-8; \u041f\u0440\u044b\u043f 3, 26<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b \u0456 \u0430\u0434\u0432\u0430\u0436\u043d\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0422\u0432\u0430\u0456\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d, \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0442\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b \u0431\u043e\u043a\u0443 \u0442\u0432\u0430\u0456\u043c \u0456 \u045e\u0431\u0435\u0440\u0430\u0436\u044d \u043d\u0430\u0433\u0443 \u0442\u0432\u0430\u044e \u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d, \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0442\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"37","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f&nbsp;<span style=\"color: #ff0000;\">32, 48-52; 34, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043c\u0435\u0440\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u043d\u0430 \u0433\u044d\u0442\u0443 \u0433\u0430\u0440\u0443 \u0410\u0431\u0430\u0440\u044b\u043c, \u043d\u0430 \u0433\u0430\u0440\u0443 \u041d\u044d\u0431\u0430, \u0448\u0442\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u041c\u0430\u0430\u0431\u0430 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u0456 \u045e\u0431\u0430\u0447 \u041a\u0430\u043d\u0430\u0430\u043d, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u044e \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0422\u044b \u043f\u0430\u043c\u0440\u044d\u0448 \u0442\u0430\u043c \u043d\u0430 \u0433\u0430\u0440\u044b, \u043d\u0430 \u044f\u043a\u0443\u044e \u045e\u0437\u044b\u0434\u0437\u0435\u0448, \u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u0448\u0441\u044f \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u043f\u0430\u043c\u0451\u0440 \u0410\u0430\u0440\u043e\u043d, \u0431\u0440\u0430\u0442 \u0442\u0432\u043e\u0439, \u043d\u0430 \u0433\u0430\u0440\u044b \u0413\u043e\u0440 \u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u0433\u043e. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043a\u0430\u043b\u044f \u0432\u043e\u0434\u0430\u045e \u041c\u044d\u0440\u044b\u0431\u0430 \u043f\u0430\u0434 \u041a\u0430\u0434\u044d\u0448\u0430\u043c, \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0421\u0456\u043d, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0442\u0430\u043c\u0443 \u0442\u044b \u0437\u0434\u0430\u043b\u0451\u043a \u0443\u0431\u0430\u0447\u044b\u0448 \u0437\u044f\u043c\u043b\u044e, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0448 \u0443 \u0442\u0443\u044e \u043a\u0440\u0430\u0456\u043d\u0443, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u043c \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u0441\u0430 \u0441\u0442\u044d\u043f\u0430\u045e \u041c\u0430\u0430\u0431\u0430 \u043d\u0430 \u0433\u0430\u0440\u0443 \u041d\u044d\u0431\u0430, \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044e \u0424\u0430\u0441\u0433\u0430, \u0448\u0442\u043e \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u044b\u0445\u043e\u043d\u0430. \u0406 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d \u0443\u0432\u0435\u0441\u044c \u043a\u0440\u0430\u0439 \u0413\u0456\u043b\u0435\u0430\u0434 \u0430\u0436\u043d\u043e \u043f\u0430 \u0414\u0430\u043d, \u0443\u0441\u044e \u0437\u044f\u043c\u043b\u044e \u041d\u044d\u0444\u0442\u0430\u043b\u0456\u043c\u0430, \u0456 \u0437\u044f\u043c\u043b\u044e \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0456 \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430, \u0456 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e \u042e\u0434\u044b \u0430\u0436\u043d\u043e \u0434\u0430 \u0417\u0430\u0445\u043e\u0434\u043d\u044f\u0433\u0430 \u043c\u043e\u0440\u0430, \u0456 \u041d\u044d\u0433\u0435\u0431, \u0456 \u0430\u043a\u0440\u0443\u0433\u0443 \u0434\u0430\u043b\u0456\u043d\u044b \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u0433\u043e\u0440\u0430\u0434\u0430 \u043f\u0430\u043b\u044c\u043c, \u0430\u0436 \u0434\u0430 \u0426\u0430\u0430\u0440\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d: &laquo;\u0413\u044d\u0442\u0430 \u0437\u044f\u043c\u043b\u044f, \u044f\u043a\u0443\u044e \u0430\u0431\u044f\u0446\u0430\u045e \u042f \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u0442\u0432\u0430\u0456\u043c \u0434\u0430\u043c \u044f\u0435. \u042f \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u0435 \u0442\u0430\u0431\u0435, \u0442\u0432\u0430\u0456\u043c \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0432\u0430\u0447\u0430\u043c, \u0430\u043b\u0435 \u0442\u044b \u0442\u0443\u0434\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0448&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0430\u043d\u0430, \u043f\u0430\u043c\u0451\u0440 \u0442\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u043b\u0443\u0433\u0430 \u0411\u043e\u0436\u044b, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u041c\u0430\u0430\u0431\u0430. \u0406 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u045e \u0434\u0430\u043b\u0456\u043d\u0435, \u043d\u0430 \u043c\u0430\u0430\u0431\u0441\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u044d\u0442 \u041f\u044d\u043e\u0440\u0430. \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f. \u041c\u0430\u0439\u0441\u0435\u044e \u0431\u044b\u043b\u043e \u0441\u0442\u043e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u043c\u0451\u0440, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0437\u0430\u0446\u044f\u043c\u043d\u0456\u045e\u0441\u044f \u0437\u0440\u043e\u043a \u044f\u0433\u043e\u043d\u044b \u0456 \u043c\u043e\u0446 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u044f\u0433\u043e. \u0406 \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430 \u0441\u0442\u044d\u043f\u0430\u0445 \u041c\u0430\u0430\u0431\u0430 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0434\u0437\u0451\u043d, \u0456 \u043c\u0456\u043d\u0443\u043b\u0456 \u0434\u043d\u0456 \u0436\u0430\u043b\u043e\u0431\u043d\u0430\u0433\u0430 \u043f\u043b\u0430\u0447\u0443 \u043f\u0430 \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0430\u0432\u0456\u043d\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0434\u0443\u0445\u0430\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0431\u043e \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u044f\u0433\u043e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435, \u0456 \u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u044f\u0433\u043e \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0435 \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u0432\u0435\u0434\u0430\u045e \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440, \u043d\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0446\u0443\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c, \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0456 \u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u0439 \u044f\u0433\u043e\u043d\u0430\u0439; \u043d\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u045e \u043c\u043e\u0446\u044b \u0440\u0443\u043a\u0456 \u0456 \u045e\u0441\u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u045e\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 1, 14bc. 16a, 17; \u0421\u0456\u0440 24, 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u0421\u043b\u043e\u0432\u0430 \u043f\u043e\u045e\u043d\u0430\u0435 \u043b\u0430\u0441\u043a\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b. \u0406 \u0437 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043c\u044b \u045e\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456. \u0411\u043e \u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f, <span style=\"color: #ff0000;\">*<\/span> \u043b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u043a\u043e\u043d, \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u044b \u041c\u0430\u0439\u0441\u0435\u0435\u043c, &ndash; \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"41","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 1 &ndash; 2, 12<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u043b\u043e\u043f\u0430\u0442 \u041f\u0430\u045e\u043b\u0430 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0422\u044d\u0441\u0430\u043b\u043e\u043d\u0456\u043a\u0430\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u043b, \u0421\u0456\u043b\u0443\u0430\u043d \u0456 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e \u0443 \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u0456 \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435: \u043b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u0432\u0430\u0441 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u043d\u0430\u0448\u044b\u0445, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e, \u0456 \u043f\u0440\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0410\u0439\u0446\u043e\u043c \u043d\u0430\u0448\u044b\u043c, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435. \u0411\u043e \u043d\u0430\u0448\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430 \u0432\u0430\u0441 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u043b\u043e\u0432\u0435, \u0430\u043b\u0435 \u0456 \u045e \u0441\u0456\u043b\u0435, \u0456 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0456 \u045e \u043f\u043e\u045e\u043d\u0430\u0439 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u0430\u0441\u0446\u0456. \u0412\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u044f\u043a\u0456\u043c\u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u0434\u043b\u044f \u0432\u0430\u0441, \u0431\u0443\u0434\u0443\u0447\u044b \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0441 \u0456 \u041f\u0430\u043d\u0430, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0441\u043b\u043e\u0432\u0430 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0443\u0446\u0456\u0441\u043a\u0443 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0442\u0430\u043a \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0432\u044b \u045e\u0437\u043e\u0440\u0430\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0443 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456 \u0456 \u0410\u0445\u0430\u0456. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u043c \u043f\u0440\u0430\u0433\u0443\u0447\u0430\u043b\u0430 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456 \u0456 \u0410\u0445\u0430\u0456, \u0430\u043b\u0435 \u0456 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0432\u0430\u043b\u0430\u0441\u044f \u0432\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u045e \u0411\u043e\u0433\u0430, \u0442\u0430\u043a \u0448\u0442\u043e \u043d\u0430\u043c \u043d\u044f\u043c\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043d\u0435\u0448\u0442\u0430 \u043a\u0430\u0437\u0430\u0446\u044c. \u042f\u043d\u044b \u0441\u0430\u043c\u0456 \u043f\u0440\u0430 \u043d\u0430\u0441 \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c, \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u043d\u0430\u0448 \u043f\u0440\u044b\u0445\u043e\u0434 \u0434\u0430 \u0432\u0430\u0441 \u0456 \u044f\u043a \u0432\u044b, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0456\u0434\u0430\u043b\u0430\u045e, \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0436\u044b\u0432\u043e\u043c\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u043c\u0443 \u0411\u043e\u0433\u0443 \u0456 \u0447\u0430\u043a\u0430\u0446\u044c \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, &ndash; \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0441\u0430\u043c\u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u043d\u0430\u0448 \u043f\u0440\u044b\u0445\u043e\u0434 \u0434\u0430 \u0432\u0430\u0441 \u043d\u0435 \u0431\u044b\u045e \u0434\u0430\u0440\u044d\u043c\u043d\u044b. \u0425\u043e\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0443 \u0424\u0456\u043b\u0456\u043f\u0430\u0445, \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043c\u044b \u0437\u0430\u0437\u043d\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0430\u0434\u043d\u0430\u043a \u0430\u0434\u0432\u0430\u0436\u044b\u043b\u0456\u0441\u044f \u045e \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u044b\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456. \u0411\u043e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435 \u043d\u0435 \u0437 \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u0443, \u0430\u043b\u0435 \u044f\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0442\u0430\u043a, \u043a\u0430\u0431 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430\u043b\u0435 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f. \u0411\u043e, \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043c\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043d\u0456 \u043b\u0456\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u043d\u0456 \u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u044b\u043c\u0456, \u0411\u043e\u0433 \u0441\u0432\u0435\u0434\u043a\u0430. \u041c\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456 \u0441\u043b\u0430\u0432\u044b \u043d\u0456 \u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u043d\u0456 \u045e \u0432\u0430\u0441, \u043d\u0456 \u045e \u0456\u043d\u0448\u044b\u0445. \u042f\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0431\u044b\u0446\u044c \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0434\u043b\u044f \u0432\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456, \u044f\u043a \u043a\u0430\u0440\u043c\u0456\u043b\u0456\u0446\u0430 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456. \u0412\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u0435\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430\u0446\u0443 \u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u043a\u0430\u043b\u0456, \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u045e\u043d\u0430\u0447\u044b \u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u0431 \u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430 \u0437 \u0432\u0430\u0441, \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435. \u0412\u044b \u0441\u0432\u0435\u0434\u043a\u0456 \u0456 \u0411\u043e\u0433, \u044f\u043a \u0441\u0432\u044f\u0442\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430 \u043c\u044b \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0432\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u0412\u044b \u0436 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0432\u0430\u0441, \u044f\u043a \u0431\u0430\u0446\u044c\u043a\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u0441\u0432\u0430\u0456\u0445, \u043c\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043b\u0456 \u0432\u0430\u0441, \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u043b\u0456 \u0456 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043a\u043b\u0456\u0447\u0430 \u0432\u0430\u0441 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 1, 9b-10; 3, 12\u0430. 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0436\u044b\u0432\u043e\u043c\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u043c\u0443 \u0411\u043e\u0433\u0443 \u0456 \u0447\u0430\u043a\u0430\u0446\u044c \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u043d\u044f\u0445\u0430\u0439 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0432\u0430\u0441 \u043b\u044e\u0431\u043e\u045e\u044e, \u043a\u0430\u0431 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u045e \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"42","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 13 &ndash; 3, 13&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u041f\u0430\u045e\u043b\u0430 \u0437 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u043c\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u0448\u0442\u043e \u0432\u044b, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u0447\u0443\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u0433\u043e \u043d\u0435 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0430\u043b\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u044f\u043a \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0432\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u0411\u0440\u0430\u0442\u044b, \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0439\u043c\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e \u0411\u043e\u0436\u044b\u0445 \u0443 \u042e\u0434\u044d\u0456 \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0431\u043e \u0456 \u0432\u044b \u043d\u0430\u0446\u044f\u0440\u043f\u0435\u043b\u0456\u0441\u044f \u0430\u0434 \u0437\u0435\u043c\u043b\u044f\u043a\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u044f\u043a \u0456 \u044f\u043d\u044b \u0430\u0434 \u044e\u0434\u044d\u044f\u045e, \u044f\u043a\u0456\u044f \u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0437\u0430\u0431\u0456\u043b\u0456, \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0456 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456, \u0456 \u0411\u043e\u0433\u0443 \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0446\u0446\u0430, \u0456 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0440\u0430\u0446\u0456\u0432\u044f\u0446\u0446\u0430. \u042f\u043a\u0456\u044f \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0446\u044c \u043d\u0430\u043c \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0442\u044b\u044f \u043d\u0435 \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b. \u0406 \u0442\u0430\u043a \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u043c\u0435\u0440\u0443 \u0433\u0440\u0430\u0445\u043e\u045e \u0441\u0432\u0430\u0456\u0445. \u0410\u043b\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430\u0440\u044d\u0448\u0446\u0435 \u0433\u043d\u0435\u045e \u0411\u043e\u0436\u044b \u043d\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436, \u0431\u0440\u0430\u0442\u044b, \u0440\u0430\u0437\u043b\u0443\u0447\u0430\u043d\u044b\u044f \u0437 \u0432\u0430\u043c\u0456 \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u0444\u0456\u0437\u0456\u0447\u043d\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0441\u044d\u0440\u0446\u0430\u043c, \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u0430 \u0436\u0430\u0434\u0430\u0435\u043c \u043f\u0430\u0431\u0430\u0447\u044b\u0446\u0446\u0430 \u0437 \u0432\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u043d\u0435\u0430\u0434\u043d\u043e\u0439\u0447\u044b \u0445\u0430\u0446\u0435\u043b\u0456 \u043f\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u044f, \u041f\u0430\u0432\u0435\u043b, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u045e \u043d\u0430\u043c \u0441\u0430\u0442\u0430\u043d\u0430. \u0411\u043e \u0445\u0442\u043e \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u0430\u0431\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0431\u043e \u0432\u044f\u043d\u043e\u043a \u0445\u0432\u0430\u043b\u044b? \u0426\u0456 \u0436 \u043d\u0435 \u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0415\u0437\u0443\u0441\u0430\u043c \u0443 \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430? \u0412\u044b &ndash; \u043d\u0430\u0448\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0434\u0430\u043b\u0435\u0439 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c, \u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456 \u0441\u0430\u043c\u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u045e \u0410\u0442\u044d\u043d\u0430\u0445 \u0456 \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0434\u0430 \u0432\u0430\u0441 \u0426\u0456\u043c\u0430\u0444\u0435\u044f, \u0431\u0440\u0430\u0442\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430 \u0411\u043e\u0433\u0430 \u045e \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443. \u0412\u044b \u0436 \u0441\u0430\u043c\u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043c\u044b \u043d\u0430 \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b. \u041a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u045e \u0432\u0430\u0441, \u043c\u044b \u045e\u0436\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0430\u043c, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443\u0446\u0456\u0441\u043a. \u0406 \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0442\u0430\u043a \u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f. \u0422\u0430\u043c\u0443 \u0456 \u044f \u045e\u0436\u043e \u043d\u0435 \u043c\u043e\u0433 \u0434\u0430\u043b\u0435\u0439 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u0432\u0435\u0440\u0443 \u0432\u0430\u0448\u0443\u044e, \u0446\u0456 \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a \u0456 \u0446\u0456 \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u0439 \u0431\u044b\u043b\u0430 \u043d\u0430\u0448\u0430\u044f \u043f\u0440\u0430\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u0431\u044b\u045e \u0430\u0434 \u0432\u0430\u0441 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0434\u043e\u0431\u0440\u044b\u044f \u0432\u0435\u0441\u0442\u043a\u0456 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443 \u0432\u0435\u0440\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e, \u0456 \u0448\u0442\u043e \u0432\u044b \u0434\u043e\u0431\u0440\u0430 \u045e\u0441\u0446\u044f\u0436 \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u0446\u0435 \u043f\u0440\u0430 \u043d\u0430\u0441, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0430\u0431\u0430\u0447\u044b\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456, \u044f\u043a \u0456 \u043c\u044b \u0437 \u0432\u0430\u043c\u0456. \u0412\u0430 \u045e\u0441\u0451\u0439 \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443 \u043d\u0430\u0448\u044b\u043c \u0432\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430, \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0430 \u043d\u0430\u0441. \u0411\u043e \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0436\u044b\u0432\u0451\u043c, \u043a\u0430\u043b\u0456 \u0432\u044b \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u041f\u0430\u043d\u0443. \u042f\u043a \u0436\u0430 \u043c\u043e\u0436\u0430\u043c \u0430\u0434\u0434\u0437\u044f\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u0437\u0430 \u045e\u0441\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u043c \u0437\u0430 \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u043a\u0430\u043b\u0456 \u045e\u043d\u0430\u0447\u044b \u0456 \u045e\u0434\u0437\u0435\u043d\u044c \u0433\u043e\u0440\u0430\u0447\u0430 \u043c\u043e\u043b\u0456\u043c\u0441\u044f, \u043a\u0430\u0431 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0456 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448, \u0456 \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u0456\u0440\u0443\u0435 \u0434\u0430 \u0432\u0430\u0441 \u0448\u043b\u044f\u0445 \u043d\u0430\u0448. \u0410 \u041f\u0430\u043d \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0432\u0430\u0441 \u0456 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u044e \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0434\u0430 \u045e\u0441\u0456\u0445, \u044f\u043a\u0443\u044e \u0456 \u043c\u044b \u043c\u0430\u0435\u043c \u0434\u0430 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0410\u0439\u0446\u043e\u043c \u043d\u0430\u0448\u044b\u043c \u0443 \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0415\u0437\u0443\u0441\u0430, \u0437 \u0443\u0441\u0456\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u0422\u044d\u0441 3, 12.13\u0430; 2 \u0422\u044d\u0441 2, 16\u0430. 17\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0432\u0430\u0441 \u0456 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u044e \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0434\u0430 \u045e\u0441\u0456\u0445,<span style=\"color: #ff0000;\"> *<\/span> \u043a\u0430\u0431 \u0432\u0430\u0441 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0430\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u0430\u0441 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"43","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0432\u044f\u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043f\u0440\u043e\u0441\u0456\u043c \u0432\u0430\u0441 \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0443 \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435, \u043a\u0430\u0431 \u0432\u044b, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0430\u0434 \u043d\u0430\u0441 \u0442\u043e\u0435, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u0432\u0430\u043c \u0441\u044f\u0431\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u044f\u043a \u0432\u044b \u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u0435 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0431\u043e\u043b\u044c\u0448 \u0443 \u0433\u044d\u0442\u044b\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0456. \u0412\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u044f\u043a\u0456\u044f \u043c\u044b \u0434\u0430\u043b\u0456 \u0432\u0430\u043c \u043d\u0430\u043a\u0430\u0437\u044b \u0430\u0434 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430. \u0411\u043e \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435, \u043a\u0430\u0431 \u0432\u044b \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u0443\u043c\u0435\u045e \u0443\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0448\u0430\u043d\u0435, \u0430 \u043d\u0435 \u045e \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u044b\u043c \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456, \u044f\u043a \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456, \u0448\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0411\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c \u0456 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0431\u043e \u041f\u0430\u043d &ndash; \u043c\u0441\u0446\u0456\u045e\u0446\u0430 \u0437\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u044f\u043a \u043c\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0430\u043c \u0440\u0430\u043d\u0435\u0439 \u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456. \u0411\u043e\u0433 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u043d\u0435 \u0434\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u044b\u043c, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0430\u043b\u0435 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u0456 \u0434\u0430\u0435 \u0432\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u043c\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043f\u0456\u0441\u0430\u0446\u044c \u0432\u0430\u043c \u043f\u0440\u0430 \u0431\u0440\u0430\u0442\u043d\u044e\u044e \u043b\u044e\u0431\u043e\u045e, \u0431\u043e \u0432\u044b \u0441\u0430\u043c\u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0440\u043e\u0431\u0456\u0446\u0435 \u0442\u0430\u043a \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0432\u0430 \u045e\u0441\u0451\u0439 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456. \u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435\u043c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b: \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0439\u0446\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448, \u0456\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u0436\u044b\u0446\u044c \u0443 \u0441\u043f\u0430\u043a\u043e\u0456, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439\u0446\u0435 \u0441\u0432\u0430\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u0456 \u043f\u0440\u0430\u0446\u0443\u0439\u0446\u0435 \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456, \u044f\u043a \u043c\u044b \u043d\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430 \u0430\u0434\u043d\u043e\u0441\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u0437\u0432\u043e\u043d\u043a\u0443, \u0456 \u043a\u0430\u0431 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043c\u0435\u043b\u0456 \u043d\u044f\u0441\u0442\u0430\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u0445\u043e\u0447\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u043a\u0456\u0434\u0430\u0446\u044c \u0432\u0430\u0441 \u0443 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0456 \u043f\u0440\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u043d\u0435 \u0442\u0443\u0436\u044b\u043b\u0456 \u0432\u044b, \u044f\u043a \u0456\u043d\u0448\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u0456. \u041a\u0430\u043b\u0456 \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0411\u043e\u0433 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0443 \u0415\u0437\u0443\u0441\u0435. \u0413\u044d\u0442\u0430 \u043a\u0430\u0436\u0430\u043c \u0432\u0430\u043c \u0443 \u0441\u043b\u043e\u0432\u0435 \u041f\u0430\u043d\u0430, \u0448\u0442\u043e \u043c\u044b, \u0436\u044b\u0432\u044b\u044f, \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f \u0434\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u041f\u0430\u043d\u0430, \u043d\u0435 \u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u043c \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0456. \u0411\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u0456 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430 \u0456 \u0442\u0440\u0443\u0431\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u044b\u0434\u0437\u0435 \u0437 \u043d\u0435\u0431\u0430, \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c\u0456. \u041f\u0430\u0441\u043b\u044f \u043c\u044b, \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f \u0436\u044b\u0432\u044b\u043c\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u043d\u0430 \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u041f\u0430\u043d\u0443 \u045e \u043f\u0430\u0432\u0435\u0442\u0440\u0430, \u0456 \u0433\u044d\u0442\u0430\u043a \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u041f\u0430\u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0433\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 4, 16\u0430; \u041c\u043a 13, 27b; \u043f\u0430\u0440. \u041c\u0446 24, 31\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430\u043c \u041f\u0430\u043d \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u0456 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430 \u0456 \u0442\u0440\u0443\u0431\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u044b\u0434\u0437\u0435 \u0437 \u043d\u0435\u0431\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0437\u0431\u044f\u0440\u044d \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0441\u0432\u0430\u0456\u0445 \u0430\u0434 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0432\u044f\u0442\u0440\u043e\u045e, \u0430\u0434 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u043a\u0440\u0430\u044e \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0430\u0448\u043b\u0435 \u0430\u043d\u0451\u043b\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0437 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u0443\u0447\u0430\u043d\u043d\u0435\u043c \u0442\u0440\u0443\u0431\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437\u0431\u044f\u0440\u044d \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0441\u0432\u0430\u0456\u0445 \u0430\u0434 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0432\u044f\u0442\u0440\u043e\u045e, \u0430\u0434 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u043a\u0440\u0430\u044e \u043d\u0435\u0431\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"44","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">5, 1-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0441\u044b\u043d\u043e\u045e \u0441\u0432\u044f\u0442\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0447\u0430\u0441\u044b \u0456 \u043f\u044d\u045e\u043d\u0443\u044e \u043f\u0430\u0440\u0443 \u043d\u044f\u043c\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043f\u0456\u0441\u0430\u0446\u044c \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0431\u043e \u0432\u044b \u0441\u0430\u043c\u0456 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439 \u0443\u043d\u0430\u0447\u044b. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c: &laquo;\u0421\u043f\u0430\u043a\u043e\u0439 \u0456 \u0431\u044f\u0441\u043f\u0435\u043a\u0430&raquo;, \u0442\u0430\u0434\u044b \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c \u043d\u0435\u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u0430\u044f \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0456\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0430\u043a\u0443\u0442\u044b \u0434\u0430 \u043f\u0430\u0440\u0430\u0434\u0437\u0456\u0445\u0456, \u0456 \u044f\u043d\u044b \u043d\u0435 \u045e\u0446\u044f\u043a\u0443\u0446\u044c. \u0412\u044b \u0436, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u045e \u0446\u0435\u043c\u0440\u044b, \u043a\u0430\u0431 \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u0441\u0442\u0430\u045e \u0432\u0430\u0441, \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439. \u0412\u044b \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0441\u044b\u043d\u044b \u0434\u043d\u044f. \u041c\u044b \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u043d\u0456 \u0434\u0430 \u043d\u043e\u0447\u044b, \u043d\u0456 \u0434\u0430 \u0446\u0435\u043c\u0440\u044b. \u0414\u044b\u043a \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0441\u043f\u0430\u0446\u044c, \u044f\u043a \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f, \u0430\u043b\u0435 \u0447\u0443\u0432\u0430\u0439\u043c\u0430 \u0456 \u0431\u0443\u0434\u0437\u044c\u043c\u0430 \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0448\u0442\u043e \u0441\u043f\u044f\u0446\u044c, \u043d\u043e\u0447\u0447\u0443 \u0441\u043f\u044f\u0446\u044c, \u0456 \u0442\u044b\u044f, \u0448\u0442\u043e \u043f&rsquo;\u044e\u0446\u044c, \u043d\u043e\u0447\u0447\u0443 \u043f&rsquo;\u044f\u043d\u044b\u044f. \u041c\u044b \u0436, \u044f\u043a\u0456\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u043d\u044e, \u0431\u0443\u0434\u0437\u044c\u043c\u0430 \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c\u0456, \u0430\u0434\u0437\u0435\u045e\u0448\u044b \u043f\u0430\u043d\u0446\u044b\u0440 \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0456 \u044f\u043a \u0448\u043b\u0435\u043c &ndash; \u043d\u0430\u0434\u0437\u0435\u044e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u043d\u0435 \u0434\u043b\u044f \u0433\u043d\u0435\u0432\u0443, \u0430\u043b\u0435 \u0434\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b, \u0446\u0456 \u0447\u0443\u0432\u0430\u0435\u043c, \u0446\u0456 \u0441\u043f\u0456\u043c, \u0436\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c. \u0422\u0430\u043c\u0443 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u045e\u0437\u0430\u0435\u043c\u043d\u0430 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0432\u044b \u0456 \u0440\u043e\u0431\u0456\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u0432\u0430\u0436\u0430\u0446\u044c \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456 \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u0432\u0430\u043c\u0456 \u045e \u041f\u0430\u043d\u0443 \u0434\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c \u0432\u0430\u0441. \u041b\u044e\u0431\u0456\u0446\u0435 \u0456\u0445 \u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u0435\u043b\u044f \u043f\u0440\u0430\u0446\u044b \u0456\u0445\u043d\u044f\u0439. \u0416\u044b\u0432\u0456\u0446\u0435 \u045e \u0437\u0433\u043e\u0434\u0437\u0435 \u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e. \u041f\u0440\u043e\u0441\u0456\u043c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b: \u0441\u043f\u044b\u043d\u044f\u0439\u0446\u0435 \u0441\u0432\u0430\u0432\u043e\u043b\u044c\u043d\u044b\u0445, \u0441\u0443\u0446\u044f\u0448\u0430\u0439\u0446\u0435 \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u044b\u0445, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0446\u0435 \u0441\u043b\u0430\u0431\u044b\u0445, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u043c\u0456 \u0434\u0430 \u045e\u0441\u0456\u0445. \u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043d\u0456\u043a\u043e\u043c\u0443 \u0437\u043b\u043e\u043c \u0437\u0430 \u0437\u043b\u043e \u043d\u0435 \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0439\u0446\u0435, \u0430\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0431\u0440\u043e \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u045e\u0441\u0456\u043c. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f. \u0417\u0430 \u045e\u0441\u0451 \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435, \u0431\u043e \u0442\u0430\u043a\u0430\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0432\u0430\u0441 \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u0414\u0443\u0445\u0430 \u043d\u0435 \u0433\u0430\u0441\u0456\u0446\u0435, \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u043c\u0456 \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439\u0446\u0435. \u0423\u0441\u0451 \u043f\u0440\u0430\u0432\u044f\u0440\u0430\u0439\u0446\u0435, \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u043e\u0431\u0440\u0430\u0433\u0430. \u0423\u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u044f\u0445\u0430\u0439 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0446\u0430\u043b\u043a\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0443\u0432\u0435\u0441\u044c \u0434\u0443\u0445 \u0432\u0430\u0448, \u0456 \u0434\u0443\u0448\u0430, \u0456 \u0446\u0435\u043b\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u044e\u0446\u0446\u0430 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u043d\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0412\u0435\u0440\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0430\u0441 \u043a\u043b\u0456\u0447\u0430, \u044f\u043a\u0456 \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u0439\u0446\u0435 \u045e\u0441\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u043c. \u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u0443 \u041f\u0430\u043d\u0443, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043d\u0430 \u045e\u0441\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 5, 9-10; \u041a\u043b\u0441 1, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u043d\u0435 \u0434\u043b\u044f \u0433\u043d\u0435\u0432\u0443, \u0430\u043b\u0435 \u0434\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"45","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e<span style=\"color: #ff0000;\">&nbsp;1, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u043b, \u0421\u0456\u043b\u0443\u0430\u043d \u0456 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e \u0443 \u0411\u043e\u0433\u0443, \u0410\u0439\u0446\u0443 \u043d\u0430\u0448\u044b\u043c, \u0456 \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u041b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443 \u0437\u0430 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u0456 \u0433\u044d\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430\u044f \u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0443\u0441\u0456\u0445 \u0432\u0430\u0441 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e. \u0422\u0430\u043c\u0443 \u043c\u044b \u0441\u0430\u043c\u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u0432\u0430\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e \u0411\u043e\u0436\u044b\u0445 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439 \u0456 \u0432\u0435\u0440\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u0433\u0430\u043d\u0435\u043d\u043d\u044f\u0445 \u0432\u0430\u0448\u044b\u0445 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443, \u044f\u043a\u0456\u044f \u0432\u044b \u0437\u043d\u043e\u0441\u0456\u0446\u0435. \u0413\u044d\u0442\u0430 \u0434\u043e\u043a\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u0443\u0434\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0432\u0430\u0440\u0442\u044b\u043c\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u0435. \u0411\u043e\u0433 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0443\u0446\u0456\u0441\u043a\u0430\u043c \u0442\u044b\u043c, \u0445\u0442\u043e \u0432\u0430\u0441 \u0443\u0446\u0456\u0441\u043a\u0430\u045e. \u0406 \u0432\u0430\u043c, \u044f\u043a\u0456\u044f \u0446\u0435\u0440\u043f\u0456\u0446\u0435 \u045e\u0446\u0456\u0441\u043a, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u043c \u0434\u0430\u0441\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u0434\u0447\u0430\u0441 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439. \u041f\u043e\u043b\u044b\u043c\u0435\u043c \u0430\u0433\u043d\u044e \u0401\u043d \u043f\u0430\u043a\u0430\u0440\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430 \u0456 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f \u0432\u0435\u0447\u043d\u0430\u0439 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u043b\u044e \u0456 \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0445\u0432\u0430\u043b\u044b \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u044b \u0437\u0434\u0437\u0456\u0432\u0456\u0446\u044c \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e. \u0412\u044b \u0436 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0437 \u0432\u0435\u0440\u0430\u044e \u043d\u0430\u0448\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0437\u0430 \u0432\u0430\u0441, \u043a\u0430\u0431 \u043d\u0430\u0448 \u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u0432\u0430\u0441 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u0456 \u0437 \u043c\u043e\u0446\u0430\u044e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u043d\u0430\u043c\u0435\u0440 \u0456 \u0441\u043f\u0440\u0430\u0432\u0443 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0430\u0441\u044f \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u045e \u0432\u0430\u0441, \u0430 \u0432\u044b &ndash; \u0443 \u0406\u043c, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u0422\u044d\u0441 1, 10\u0430; \u041f\u0441 145 (144), 13b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0406\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u0435\u0440\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u0441\u0432\u044f\u0442\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"46","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 1-17<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043d\u0430\u043a\u043e\u043d\u0442 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u0445\u043e\u0434\u0443 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u043a\u0430\u0431 \u0432\u044b \u0442\u0430\u043a \u0445\u0443\u0442\u043a\u0430 \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u043b\u0456 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u043d\u0435 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0414\u0443\u0445\u0430, \u043d\u0456 \u0441\u043b\u043e\u0432\u0430, \u043d\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0430\u0434 \u043d\u0430\u0441, \u0448\u0442\u043e, \u043c\u0430\u045e\u043b\u044f\u045e, \u043d\u0430\u0441\u0442\u0430\u045e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441 \u043d\u0456\u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0431\u043e \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u044b\u043d \u0437\u0433\u0443\u0431\u044b, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0446\u0456\u0432\u0456\u0446\u0446\u0430 \u0456 \u045e\u0437\u0432\u044b\u0448\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u043c \u0456 \u0433\u043e\u0434\u043d\u044b\u043c \u043f\u0430\u0448\u0430\u043d\u044b, \u0442\u0430\u043a \u0448\u0442\u043e \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0430\u0441\u044f\u0434\u0437\u0435, \u0432\u044b\u0434\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0437\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0436 \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u044f \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c \u0430\u0431 \u0433\u044d\u0442\u044b\u043c? \u0406 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u044f\u0433\u043e \u0442\u0440\u044b\u043c\u0430\u0435 \u0430\u0436 \u0434\u0430 \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430. \u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u045e\u0436\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435. \u0425\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u044f\u0433\u043e \u0442\u0440\u044b\u043c\u0430\u0435, \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u043c\u0435\u0441\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a, \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0437\u0430\u0431&rsquo;\u0435 \u043f\u043e\u0434\u044b\u0445\u0430\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f. \u0410 \u043f\u0440\u044b\u0445\u043e\u0434 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0441\u0430\u0442\u0430\u043d\u044b \u0432\u0430 \u045e\u0441\u0451\u0439 \u0441\u0456\u043b\u0435, \u0437\u043d\u0430\u043a\u0430\u0445 \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0446\u0443\u0434\u0430\u0445, \u0456 \u0437 \u0443\u0441\u044f\u043a\u0456\u043c \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c \u0430\u0448\u0443\u043a\u0430\u043d\u0441\u0442\u0432\u0430\u043c \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0456\u0434\u0443\u0446\u044c \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0431\u043e \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0456\u043c \u0411\u043e\u0433 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u0443, \u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u045e\u0441\u0435, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0430\u043b\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443 \u0437\u0430 \u0432\u0430\u0441, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u041f\u0430\u043d\u0430\u043c \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441 \u044f\u043a \u043f\u0435\u0440\u0448\u044b\u0445 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u043f\u0440\u0430\u045e\u0434\u0443. \u0414\u043b\u044f \u0442\u0430\u0433\u043e \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u043a\u0430\u0431 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u043b\u0430\u0432\u044b \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u044f\u043a\u0456\u043c \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u044f\u043a \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435. \u0421\u0430\u043c \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u0411\u043e\u0433, \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448, \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0434\u0430\u045e \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0456 \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u045e \u043b\u0430\u0441\u0446\u044b, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u045e\u043c\u0430\u0446\u0443\u0435 \u0432\u0430\u0441 \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043b\u043e\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 24, 30; 2 \u0422\u044d\u0441 2. 8\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u043d\u0435\u0431\u0435 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0437\u043d\u0430\u043a \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c, \u044f\u043a \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u045e \u0441\u043b\u0430\u0432\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u0434\u044b \u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a, \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0437\u0430\u0431&rsquo;\u0435 \u043f\u043e\u0434\u044b\u0445\u0430\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0431\u0430\u0447\u0430\u0446\u044c, \u044f\u043a \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u045e \u0441\u043b\u0430\u0432\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"47","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">3, 1-18<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0456 \u043f\u0430\u0440\u0430\u0434\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u043b\u0430\u0441\u044f \u0456 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u0443 \u0432\u0430\u0441, \u0456 \u043a\u0430\u0431 \u043c\u044b \u045e\u0441\u0446\u0435\u0440\u0430\u0433\u043b\u0456\u0441\u044f \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u0445 \u0456 \u043b\u0456\u0445\u0456\u0445, \u0431\u043e \u043d\u0435 \u045e\u0441\u0435 \u043c\u0430\u044e\u0446\u044c \u0432\u0435\u0440\u0443. \u0412\u0435\u0440\u043d\u044b \u041f\u0430\u043d, \u044f\u043a\u0456 \u045e\u043c\u0430\u0446\u0443\u0435 \u0432\u0430\u0441 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0430\u0434 \u043b\u0456\u0445\u043e\u0433\u0430. \u041c\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441 \u0443 \u041f\u0430\u043d\u0443, \u0448\u0442\u043e \u0432\u044b \u0440\u043e\u0431\u0456\u0446\u0435 \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c \u0432\u0430\u043c. \u0425\u0430\u0439 \u0436\u0430 \u041f\u0430\u043d \u043f\u0430\u043a\u0456\u0440\u0443\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0432\u044b \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0434\u0440\u044d\u043d\u043d\u0430 \u0456 \u043d\u044f\u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u044f\u0439, \u044f\u043a\u0443\u044e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u043d\u0430\u0441. \u0412\u044b \u0441\u0430\u043c\u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0441, \u0431\u043e \u043c\u044b \u043d\u0435 \u043b\u0430\u0439\u0434\u0430\u0447\u044b\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456 \u043d\u0456 \u045e \u043a\u043e\u0433\u0430 \u043d\u0435 \u0435\u043b\u0456 \u0445\u043b\u0435\u0431\u0430 \u0434\u0430\u0440\u043c\u0430, \u0430\u043b\u0435 \u0446\u044f\u0436\u043a\u0430 \u0456 \u045e \u043c\u0430\u0437\u0430\u043b\u044f\u0445 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u043e\u0447, \u043a\u0430\u0431 \u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430 \u0437 \u0432\u0430\u0441. \u041d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043c\u0435\u043b\u0456 \u045e\u043b\u0430\u0434\u044b, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u0434\u0430\u0446\u044c \u0432\u0430\u043c \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u0439\u043c\u0430\u043d\u043d\u044f. \u041a\u0430\u043b\u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u045e \u0432\u0430\u0441, \u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u0432\u0430\u043c: \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0456 \u043d\u0435 \u0435\u0441\u0446\u044c. \u0410\u043b\u0435 \u043c\u044b \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u0430: \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u043e\u0431\u044f\u0446\u044c, \u0430\u043b\u0435 \u0437\u0430\u0439\u043c\u0430\u044e\u0446\u0446\u0430 \u043c\u0430\u0440\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456. \u0422\u0430\u043a\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0456\u0445 \u0443 \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0435\u043b\u0456 \u045e\u043b\u0430\u0441\u043d\u044b \u0445\u043b\u0435\u0431. \u0412\u044b \u0436, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0447\u0430\u0441\u0430\u043c \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430, \u0442\u0430\u0433\u043e \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u044b \u043d\u0435 \u0441\u044f\u0431\u0440\u0443\u0439\u0446\u0435 \u0437 \u0456\u043c, \u043a\u0430\u0431 \u0431\u044b\u045e \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u0435 \u044f\u0433\u043e \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u0430\u043b\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u044f\u043a \u0431\u0440\u0430\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u041f\u0430\u043d \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u044f\u0445\u0430\u0439 \u0432\u0430 \u045e\u0441\u0456\u043c \u0456 \u045e\u0441\u044f\u043b\u044f\u043a \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c. \u041f\u0430\u043d \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043b\u0430\u0441\u043d\u0430\u0440\u0443\u0447\u043d\u0430\u0435 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u043c\u0430\u0451, \u041f\u0430\u045e\u043b\u0430, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0437\u043d\u0430\u043a\u0430\u043c \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456. \u0422\u0430\u043a \u044f \u043f\u0456\u0448\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u0422\u044d\u0441 2, 13b; \u043f\u0430\u0440. \u042d\u0444 1, 13\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u0430\u0447\u0443\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u0433\u043e \u043d\u0435 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0430\u043b\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u044f\u043a \u0411\u043e\u0436\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0406\u043c \u0432\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u045e\u0434\u044b, \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043f\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u0433\u043e \u043d\u0435 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0430\u043b\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u044f\u043a \u0411\u043e\u0436\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"51","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 1-12<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u041f\u0430\u045e\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u043b, \u0430\u043f\u043e\u0441\u0442\u0430\u043b, \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u043d\u0435 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0456 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0411\u043e\u0433\u0430\u043c \u0410\u0439\u0446\u043e\u043c, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0456 \u045e\u0441\u0435 \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u0441\u0430 \u043c\u043d\u043e\u044e, &ndash; \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0413\u0430\u043b\u0430\u0442\u044b\u0456. \u041b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u0430\u0434 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u043a\u0430\u0431 \u0432\u044b\u0440\u0432\u0430\u0446\u044c \u043d\u0430\u0441 \u0437 \u043b\u0456\u0445\u043e\u0433\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043f\u0430 \u0432\u043e\u043b\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u043e\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u043b\u0430\u0441\u043a\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b \u0442\u0430\u043a \u0445\u0443\u0442\u043a\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430\u0432\u0435\u0441\u0446\u044f. \u042f\u043d\u043e, \u0430\u0434\u043d\u0430\u043a, \u043d\u0435 \u0456\u043d\u0448\u0430\u0435, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0451\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u0441 \u0456 \u0445\u043e\u0447\u0443\u0446\u044c \u0441\u043a\u0430\u0437\u0456\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430. \u0410\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0430\u0432\u0430\u0442 \u043c\u044b \u0446\u0456 \u0430\u043d\u0451\u043b \u0437 \u043d\u0435\u0431\u0430 \u043f\u0430\u0447\u0430\u043b\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443, \u044f\u043a\u0430\u044f \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0442\u043e\u0439, \u0448\u0442\u043e \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0432\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b! \u042f\u043a \u0440\u0430\u043d\u0435\u0439 \u043c\u044b \u043a\u0430\u0437\u0430\u043b\u0456, \u0442\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0443: \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0432\u0430\u043c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443, \u044f\u043a\u0430\u044f \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0442\u043e\u0439, \u0448\u0442\u043e \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b! \u0426\u0456 \u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u044f \u0446\u044f\u043f\u0435\u0440 \u0448\u0443\u043a\u0430\u044e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f, \u0446\u0456 \u045e \u0411\u043e\u0433\u0430? \u0426\u0456 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u0446\u044c \u0441\u0442\u0430\u0440\u0430\u044e\u0441\u044f? \u041a\u0430\u043b\u0456 \u0431 \u044f \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c, \u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0441\u043b\u0443\u0433\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430!<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u0435\u0434\u0447\u0443 \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e, \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0411\u043e \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 1, 3-4\u0430. 10\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u0430\u0434 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0431 \u044f \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c, \u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0441\u043b\u0443\u0433\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"52","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 13 &ndash; 2, 10<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u041f\u0430\u045e\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0412\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u043c\u0430\u0451 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u044e\u0434\u0430\u0456\u0437\u043c\u0435, \u044f\u043a \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u044f \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b \u0456 \u043d\u0456\u0448\u0447\u044b\u045e \u044f\u0433\u043e, \u044f\u043a \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u045e \u0443 \u044e\u0434\u0430\u0456\u0437\u043c\u0435 \u043c\u043d\u043e\u0433\u0456\u0445 \u0430\u0434\u043d\u0430\u0433\u043e\u0434\u043a\u0430\u045e \u0437 \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0437\u0430\u0446\u044f\u0442\u044b\u043c \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0439 \u043c\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0436 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043b\u0430\u0441\u043a\u0430\u044e \u0441\u0432\u0430\u0451\u044e, \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u044f \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f \u043d\u0435 \u043f\u0430\u0447\u0430\u045e \u0430\u0434\u0440\u0430\u0437\u0443 \u0440\u0430\u0456\u0446\u0446\u0430 \u0437 \u0446\u0435\u043b\u0430\u043c \u0456 \u043a\u0440\u044b\u0432\u0451\u044e \u0456 \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0434\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043c\u0430\u0456\u0445 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0410\u0440\u0430\u0431\u0456\u044e \u0456 \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0414\u0430\u043c\u0430\u0441\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f, \u043f\u0440\u0430\u0437 \u0442\u0440\u044b \u0433\u0430\u0434\u044b, \u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u041a\u0435\u0444\u0430\u0441\u0430 \u0456 \u043f\u0440\u0430\u0431\u044b\u045e \u0443 \u044f\u0433\u043e \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0434\u0437\u0451\u043d. \u041d\u0456\u043a\u043e\u0433\u0430 \u0436 \u0456\u043d\u0448\u0430\u0433\u0430 \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u044f \u043d\u0435 \u0431\u0430\u0447\u044b\u045e, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u043a\u0443\u0431\u0430, \u0431\u0440\u0430\u0442\u0430 \u041f\u0430\u043d\u0430. \u0423 \u0442\u044b\u043c, \u0448\u0442\u043e \u044f \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u0411\u043e\u0433 \u043c\u043d\u0435 \u0441\u0432\u0435\u0434\u043a\u0430, \u043d\u044f\u043c\u0430 \u043c\u0430\u043d\u044b. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0434\u044b\u0448\u043e\u045e \u044f \u045e \u0437\u0435\u043c\u043b\u0456 \u0421\u0456\u0440\u044b\u0456 \u0456 \u0426\u044b\u043b\u0456\u0446\u044b\u0456. \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0443 \u042e\u0434\u044d\u0456 \u044f \u043d\u0435 \u0431\u044b\u045e \u0432\u044f\u0434\u043e\u043c\u044b \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430, \u044f\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0456\u0445 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0435\u043c, \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435 \u0432\u0435\u0440\u0443, \u044f\u043a\u0443\u044e \u043d\u0435\u043a\u0430\u043b\u0456 \u043d\u0456\u0448\u0447\u044b\u045e. \u0406 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0411\u043e\u0433\u0430 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c, \u043f\u0440\u0430\u0437 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u044f \u0437\u043d\u043e\u045e \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0437 \u0411\u0430\u0440\u043d\u0430\u0431\u0430\u043c, \u0443\u0437\u044f\u045e\u0448\u044b \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u0426\u0456\u0442\u0430. \u0410 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u044f \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f. \u0406 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u045e \u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c; \u0430\u0441\u043e\u0431\u043d\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f \u0431\u044f\u0433\u0443 \u0446\u0456 \u0431\u0435\u0433\u0430\u045e \u0434\u0430\u0440\u044d\u043c\u043d\u0430. \u0410\u043b\u0435 \u043d\u0430\u0432\u0430\u0442 \u0426\u0456\u0442, \u0448\u0442\u043e \u0431\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0433\u0440\u044d\u043a\u0430\u043c, \u043d\u0435 \u0431\u044b\u045e \u0437\u043c\u0443\u0448\u0430\u043d\u044b \u0434\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f. \u0424\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c \u0436\u0430 \u0431\u0440\u0430\u0442\u0430\u043c, \u044f\u043a\u0456\u044f \u0437\u0430\u043a\u0440\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u043f\u0430\u0440\u0443\u0448\u044b\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u043d\u0430\u0448\u0443\u044e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u043c \u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u043a\u0430\u0431 \u043c\u044b \u0442\u0440\u0430\u043f\u0456\u043b\u0456 \u0437\u043d\u043e\u045e \u0443 \u043d\u044f\u0432\u043e\u043b\u044e, \u043c\u044b \u043d\u0435 \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u043d\u0456 \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443, \u043a\u0430\u0431 \u043f\u0440\u0430\u045e\u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, &ndash; \u0430 \u043a\u0456\u043c \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456, \u043c\u044f\u043d\u0435 \u043d\u0435 \u0446\u0456\u043a\u0430\u0432\u0456\u0446\u044c, \u0431\u043e \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u0411\u043e\u0433 \u043d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, &ndash; \u0434\u044b\u043a \u0442\u044b\u044f, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0443, \u043c\u043d\u0435 \u043d\u0435 \u043f\u044f\u0440\u044d\u0447\u044b\u043b\u0456. \u0410\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u043c\u043d\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u044f\u043a \u041f\u044f\u0442\u0440\u0443 &ndash; \u0441\u044f\u0440\u043e\u0434 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 (\u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u041f\u044f\u0442\u0440\u0443 \u045e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0435 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u0456 \u043c\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e), \u0456 \u043a\u0430\u043b\u0456 \u042f\u043a\u0443\u0431, \u041a\u0435\u0444\u0430\u0441 \u0456 \u042f\u043d, \u044f\u043a\u0456\u0445 \u043b\u0456\u0447\u0430\u0446\u044c \u0441\u0442\u0430\u045e\u043f\u0430\u043c\u0456, \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u043c\u043d\u0435 \u043b\u0430\u0441\u043a\u0443, \u044f\u043d\u044b \u043f\u0430\u0434\u0430\u043b\u0456 \u043c\u043d\u0435 \u0456 \u0411\u0430\u0440\u043d\u0430\u0431\u0435 \u043f\u0440\u0430\u0432\u0456\u0446\u0443 \u043d\u0430 \u0437\u043d\u0430\u043a \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043d\u0430\u043c \u0456\u0441\u0446\u0456 \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430 \u0456\u043c &ndash; \u0434\u0430 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u043e\u043c\u043d\u0456\u043b\u0456 \u043f\u0440\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u044f \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0440\u0430\u0431\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 10; \u0413\u0430\u043b 2, 8<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u044f \u0441\u0442\u0430\u045e \u0442\u044b\u043c, \u0447\u044b\u043c \u0451\u0441\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043b\u0430\u0441\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u044f, \u0434\u0430\u0437\u0435\u043d\u0430\u044f \u043c\u043d\u0435, \u043d\u0435 \u0431\u044b\u043b\u0430 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u041f\u044f\u0442\u0440\u0443 \u045e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0435 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u0456 \u043c\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. <span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043b\u0430\u0441\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u044f, \u0434\u0430\u0437\u0435\u043d\u0430\u044f \u043c\u043d\u0435, \u043d\u0435 \u0431\u044b\u043b\u0430 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"53","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e<span style=\"color: #ff0000;\">&nbsp;2, 11 &ndash; 3, 14<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0436\u044b\u0432\u0435 \u0437 \u0432\u0435\u0440\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u041a\u0435\u0444\u0430\u0441 \u043f\u0440\u044b\u0431\u044b\u045e \u0443 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u044e, \u0434\u044b\u043a \u044f \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0441\u0432\u0430\u044e \u043d\u044f\u0437\u0433\u043e\u0434\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0451\u043d \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u045e \u0434\u0430\u043a\u043e\u0440\u0443. \u0411\u043e \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043f\u0440\u044b\u0431\u044b\u043b\u0456 \u0430\u0434 \u042f\u043a\u0443\u0431\u0430, \u0451\u043d \u0435\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0442\u044b\u044f \u0437&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f, \u043f\u0430\u0447\u0430\u045e \u0430\u0434\u0434\u0430\u043b\u044f\u0446\u0446\u0430 \u0456 \u0430\u0434\u0430\u0441\u0430\u0431\u043b\u044f\u0446\u0446\u0430, \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445. \u0406 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0456\u0447\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u044e\u0434\u044d\u0456, \u0442\u0430\u043a \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0411\u0430\u0440\u043d\u0430\u0431\u0443 \u0437\u0432\u044f\u043b\u0430 \u0456\u0445\u043d\u044f\u044f \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c. \u0410\u043b\u0435, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0431\u043e\u0447\u044b\u043b\u0456 \u0441\u0430 \u0448\u043b\u044f\u0445\u0443 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u041a\u0435\u0444\u0430\u0441\u0443 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456: &laquo;\u041a\u0430\u043b\u0456 \u0442\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u044e\u0434\u044d\u0435\u043c, \u0436\u044b\u0432\u0435\u0448 \u043f\u0430-\u044f\u0437\u044b\u0447\u043d\u0456\u0446\u043a\u0443, \u0430 \u043d\u0435 \u043f\u0430-\u044e\u0434\u044d\u0439\u0441\u043a\u0443, \u0442\u043e \u0447\u0430\u043c\u0443 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0435\u0448 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0436\u044b\u0446\u044c \u043f\u0430-\u044e\u0434\u044d\u0439\u0441\u043a\u0443?&raquo; \u041c\u044b \u043f\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435 \u044e\u0434\u044d\u0456, \u0430 \u043d\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. \u0412\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044e \u0417\u0430\u043a\u043e\u043d\u0443, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0417\u0430\u043a\u043e\u043d\u0443; \u0431\u043e \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043c\u044b, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0441\u0430\u043c\u0456 \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0433\u0440\u044d\u0448\u043d\u044b\u043c\u0456, \u0446\u0456 \u0436 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0441\u043b\u0443\u0433\u0430 \u0433\u0440\u0430\u0445\u0443? \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u043d\u0435! \u0411\u043e \u043a\u0430\u043b\u0456 \u044f \u0430\u0434\u0431\u0443\u0434\u043e\u045e\u0432\u0430\u044e \u0437\u043d\u043e\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u0430\u043d\u0435\u0439 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u045e, \u0442\u043e \u0441\u044f\u0431\u0435 \u0440\u0430\u0431\u043b\u044e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u043c. \u041f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d \u044f \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430. \u042f \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0406 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410 \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0432\u0443 \u045e \u0446\u0435\u043b\u0435, \u0442\u043e \u0436\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435. \u041d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u044e \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439. \u0410 \u043a\u0430\u043b\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d, \u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0434\u0430\u0440\u044d\u043c\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0433\u0430\u043b\u0430\u0442\u044b, \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u044f\u043a\u0456\u0445 \u0431\u044b\u045e \u043d\u0430\u043a\u0440\u044d\u0441\u043b\u0435\u043d\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u0437\u0430\u0447\u0430\u0440\u0430\u0432\u0430\u045e \u0432\u0430\u0441? \u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0430\u0434\u043d\u043e \u0445\u0430\u0447\u0443 \u0430\u0434 \u0432\u0430\u0441 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430: \u0446\u0456 \u043f\u0440\u0430\u0437 \u0443\u0447\u044b\u043d\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0414\u0443\u0445\u0430, \u0446\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b? \u0426\u0456 \u0432\u044b \u0442\u0430\u043a\u0456\u044f \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043a\u0430\u0431 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0442\u0430\u0435 \u0434\u0443\u0445\u0430\u043c \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u0446\u044c \u0446\u044f\u043f\u0435\u0440 \u0446\u0435\u043b\u0430\u043c? \u041d\u044f\u045e\u0436\u043e \u043c\u0430\u0440\u043d\u0430 \u0432\u044b \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0446\u044f\u0440\u043f\u0435\u043b\u0456? \u041c\u043e\u0436\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043c\u0430\u0440\u043d\u0430! \u0426\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0435 \u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0437\u043d\u0430\u043a\u0456, \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u0437 \u0443\u0447\u044b\u043d\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0430\u0431\u043e \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0411\u043e\u0433\u0443, \u0456 \u0433\u044d\u0442\u0430 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0414\u044b\u043a \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0433\u044d\u0442\u0430 \u0441\u044b\u043d\u044b \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u0406 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0443\u0436\u043e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u043b\u0430 \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0423 \u0442\u0430\u0431\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b&raquo;. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u043d\u044b\u043c \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430\u043c. \u0422\u044b\u044f, \u0445\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0447\u044b\u043d\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043f\u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u0417\u0430\u043a\u043e\u043d\u0443&raquo;. \u0410 \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0417\u0430\u043a\u043e\u043d\u0443 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0433\u044d\u0442\u0430 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430, \u0431\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0437 \u0432\u0435\u0440\u044b \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435. \u0417\u0430\u043a\u043e\u043d \u0436\u0430 \u043d\u0435 \u0437 \u0432\u0435\u0440\u044b, \u0430\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b \u0417\u0430\u043a\u043e\u043d\u0443, \u0442\u043e\u0439 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0456\u043c. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443 \u0417\u0430\u043a\u043e\u043d\u0443, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c \u0437\u0430 \u043d\u0430\u0441, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0456\u0441\u0456\u0446\u044c \u043d\u0430 \u0434\u0440\u044d\u0432\u0435&raquo;, \u043a\u0430\u0431 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430 \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0430\u0441\u044f \u043d\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 2, 16. 21b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044e \u0417\u0430\u043a\u043e\u043d\u0443, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0417\u0430\u043a\u043e\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d, \u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0434\u0430\u0440\u044d\u043c\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"54","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">3, 15 &ndash; 4, 7&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0420\u043e\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0437\u0430\u0446\u0432\u0435\u0440\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0435 \u0456 \u043d\u0435 \u0437\u043c\u044f\u043d\u044f\u0435. \u0412\u043e\u0441\u044c \u0436\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0456 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443. \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;I \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c&raquo;, \u0431\u044b\u0446\u0446\u0430\u043c \u043c\u043d\u043e\u0433\u0456\u043c, \u0430\u043b\u0435 \u044f\u043a \u0430\u0434\u043d\u0430\u043c\u0443: &laquo;I \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u0442\u0432\u0430\u0439\u043c\u0443&raquo;, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0413\u044d\u0442\u0430 \u0432\u043e\u0441\u044c \u043a\u0430\u0436\u0443: \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0411\u043e\u0433\u0430\u043c \u0437\u0430\u0446\u0432\u0435\u0440\u0434\u0436\u0430\u043d\u0430\u0433\u0430, \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044f\u0435 \u0417\u0430\u043a\u043e\u043d, \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u0447\u0430\u0442\u044b\u0440\u044b\u0441\u0442\u0430 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u043a\u0430\u0431 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0437 \u0417\u0430\u043a\u043e\u043d\u0443, \u0442\u043e \u043d\u0435 \u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f. \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0436 \u0430\u0434\u0430\u0440\u044b\u045e \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u0442\u043e \u0442\u0430\u0434\u044b \u0417\u0430\u043a\u043e\u043d? \u0401\u043d \u0434\u0437\u0435\u043b\u044f \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0430\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0434\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0430\u0442\u043e\u043c\u0430\u043a, \u044f\u043a\u043e\u043c\u0443 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u043f\u0440\u0430\u0437 \u0430\u043d\u0451\u043b\u0430\u045e \u0443 \u0440\u0443\u043a\u0456 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430. \u0422\u043e\u0439, \u0445\u0442\u043e \u0430\u0434\u0437\u0456\u043d, \u043d\u0435 \u043c\u0430\u0435 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430, \u0430 \u0411\u043e\u0433 \u0430\u0434\u0437\u0456\u043d. \u0426\u0456 \u0436 \u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u0446\u0456\u0432\u0456\u0446\u0446\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c \u0411\u043e\u0436\u044b\u043c? \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u043d\u0435. \u041a\u0430\u043b\u0456 \u0431 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0431\u044b\u045e \u0417\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u043c\u043e\u0433 \u0431\u044b \u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451, \u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u044b\u043d\u0456\u043a\u0430\u043b\u0430 \u0431 \u0437 \u0417\u0430\u043a\u043e\u043d\u0443. \u0410\u043b\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0430 \u045e\u0441\u0451 \u043f\u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u043c, \u043a\u0430\u0431 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0430\u044e \u0417\u0430\u043a\u043e\u043d\u0443 \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0432\u0435\u0440\u044b. \u0422\u0430\u043c\u0443 \u0417\u0430\u043a\u043e\u043d \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u043c, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443. \u0423\u0441\u0435 \u0432\u044b \u0441\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0411\u043e \u045e\u0441\u0435 \u0432\u044b, \u0445\u0442\u043e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f. \u041d\u044f\u043c\u0430 \u045e\u0436\u043e \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0433\u0440\u044d\u043a\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u0440\u0430\u0431\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u043d\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0431\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f, \u0442\u043e \u0432\u044b \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u043f\u0430\u043a\u0443\u043b\u044c \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430 \u0434\u0437\u0456\u0446\u044f, \u0451\u043d \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u043b\u0443\u0433\u0456, \u0445\u043e\u0446\u044c \u0451\u043d \u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0430\u043b\u0435 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0433\u0430 \u0430\u0439\u0446\u043e\u043c \u0447\u0430\u0441\u0443 \u0430\u043f\u0435\u043a\u0443\u043d\u0430\u043c \u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c. \u0422\u0430\u043a \u0456 \u043c\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u0431\u044b\u043b\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0441\u0442\u044b\u0445\u0456\u044f\u043c \u0441\u0432\u0435\u0442\u0443. \u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0441\u044b\u043d\u044b, \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0414\u0443\u0445\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430!&raquo; \u0422\u0430\u043c\u0443 \u0442\u044b \u045e\u0436\u043e \u043d\u0435 \u0441\u043b\u0443\u0433\u0430, \u0430 \u0441\u044b\u043d, \u0430 \u043a\u0430\u043b\u0456 \u0441\u044b\u043d, \u0442\u043e \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430 \u0411\u043e\u0436\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 3, 27. 28; \u043f\u0430\u0440. \u042d\u0444 4, 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0441\u0435 \u0432\u044b, \u0445\u0442\u043e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f. \u041d\u044f\u043c\u0430 \u045e\u0436\u043e \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0433\u0440\u044d\u043a\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0433\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"55","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 8-31&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0430 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0422\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0432\u044b \u0411\u043e\u0433\u0430, \u0432\u044b \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0442\u044b\u043c, \u044f\u043a\u0456\u044f \u043f\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0431\u0430\u0433\u0430\u043c\u0456. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u043a\u0430\u043b\u0456 \u0432\u044b \u045e\u0436\u043e \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0441\u0430\u043c\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c, \u0447\u0430\u0433\u043e \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0435\u0441\u044f \u0434\u0430 \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b\u0445 \u0456 \u043c\u0430\u0440\u043d\u044b\u0445 \u0441\u0442\u044b\u0445\u0456\u044f\u045e, \u044f\u043a\u0456\u043c \u0437\u043d\u043e\u045e \u0445\u043e\u0447\u0430\u0446\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c? \u0412\u044b \u0437\u0432\u0430\u0436\u0430\u0435\u0446\u0435 \u043d\u0430 \u0434\u043d\u0456, \u043c\u0435\u0441\u044f\u0446\u044b, \u0447\u0430\u0441\u044b \u0456 \u0433\u0430\u0434\u044b! \u0411\u0430\u044e\u0441\u044f, \u0446\u0456 \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u044f \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0432\u0430\u0441?<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u044f, \u0431\u043e \u0456 \u044f \u0442\u0430\u043a\u0456, \u044f\u043a \u0432\u044b. \u0412\u044b \u043c\u044f\u043d\u0435 \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u043b\u0456. \u0412\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0445\u0432\u043e\u0440\u044b. \u0423 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0432\u0430\u0448\u044b\u043c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u0451\u0439 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0432\u044b \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u043a \u0411\u043e\u0436\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0434\u0437\u0435 \u0436 \u0432\u0430\u0448\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c? \u0421\u0432\u0435\u0434\u0447\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0431 \u0431\u044b\u043b\u043e \u043c\u043e\u0436\u043d\u0430, \u0432\u044b \u0432\u044b\u0440\u0432\u0430\u043b\u0456 \u0431 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u043c\u043d\u0435. \u0426\u0456 \u0436 \u044f \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0432\u0430\u0441 \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b \u0432\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0443? \u042f\u043d\u044b \u0440\u0443\u043f\u044f\u0446\u0446\u0430 \u0430\u0431 \u0432\u0430\u0441 \u043d\u0435 \u0437 \u0434\u043e\u0431\u0440\u044b\u0445 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0430\u0434 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0432\u044b \u0440\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0431 \u0456\u0445. \u0413\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430 &ndash; \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0431 \u0434\u043e\u0431\u0440\u044b\u043c \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u044f \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441. \u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441. \u0425\u0430\u0446\u0435\u045e \u0431\u044b \u0431\u044b\u0446\u044c \u0443 \u0432\u0430\u0441 \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u043c\u043e\u0439, \u0431\u043e \u0441\u0430\u043c \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0437 \u0432\u0430\u043c\u0456 \u0440\u0430\u0431\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0436\u044b\u0446\u0435 \u043c\u043d\u0435, \u0432\u044b, \u044f\u043a\u0456\u044f \u0445\u043e\u0447\u0430\u0446\u0435 \u0436\u044b\u0446\u044c \u043f\u0430\u0434 \u0417\u0430\u043a\u043e\u043d\u0430\u043c, \u0446\u0456 \u0436 \u0432\u044b \u043d\u0435 \u0447\u0443\u0435\u0446\u0435 \u0417\u0430\u043a\u043e\u043d\u0443? \u041d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u0448\u0442\u043e \u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0431\u044b\u043b\u043e \u0434\u0432\u0430 \u0441\u044b\u043d\u044b: \u0430\u0434\u0437\u0456\u043d \u0430\u0434 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b, \u0434\u0440\u0443\u0433\u0456 \u0430\u0434 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439. \u0410\u043b\u0435 \u0442\u043e\u0439, \u0448\u0442\u043e \u0430\u0434 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0430 \u0442\u043e\u0439, \u0448\u0442\u043e \u0430\u0434 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439 &ndash; \u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f. \u0423 \u0433\u044d\u0442\u044b\u043c \u0451\u0441\u0446\u044c \u0430\u043b\u0435\u0433\u043e\u0440\u044b\u044f: \u0433\u044d\u0442\u0430 \u0434\u0432\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u044b. \u0410\u0434\u0437\u0456\u043d, \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439, \u044f\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0434\u043b\u044f \u043d\u044f\u0432\u043e\u043b\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0410\u0433\u0430\u0440. \u0411\u043e \u0410\u0433\u0430\u0440 &ndash; \u0433\u044d\u0442\u0430 \u0433\u0430\u0440\u0430 \u0421\u0456\u043d\u0430\u0439 \u0443 \u0410\u0440\u0430\u0431\u0456\u0456 \u0456 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u043c\u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0443, \u0431\u043e \u0451\u043d \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0437 \u0441\u044b\u043d\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0448\u0442\u043e \u045e\u0433\u0430\u0440\u044b, \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b, \u0451\u043d &ndash; \u043d\u0430\u0448\u0430\u044f \u043c\u0430\u0446\u0456. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0423\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f, \u0448\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u043b\u0430; \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0456 \u0456 \u0437\u0430\u043a\u0440\u044b\u0447\u044b, \u044f\u043a\u0430\u044f \u043d\u0435 \u0446\u044f\u0440\u043f\u0435\u043b\u0430 \u0440\u043e\u0434\u0430\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u0439 \u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u044f\u0446\u0435\u0439, \u0447\u044b\u043c \u0443 \u0442\u043e\u0439, \u0448\u0442\u043e \u043c\u0430\u0435 \u043c\u0443\u0436\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0436, \u0431\u0440\u0430\u0442\u044b, \u0442\u0430\u043a \u044f\u043a I\u0441\u0430\u0430\u043a, \u0434\u0437\u0435\u0446\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f. \u0410\u043b\u0435 \u044f\u043a \u0456 \u0442\u0430\u0434\u044b \u0442\u043e\u0439, \u0448\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u0445\u0430, \u0442\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440. \u0410 \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435? &laquo;\u0412\u044b\u0433\u0430\u043d\u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u0443 \u0456 \u044f\u0435 \u0441\u044b\u043d\u0430, \u0431\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0441\u044b\u043d \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u044b\u043d\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439&raquo;. \u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u043d\u0435 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b, \u0430\u043b\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 4, 28. 31; 5, 1; 2 \u041a\u0430\u0440 3, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b, \u0431\u0440\u0430\u0442\u044b, \u0442\u0430\u043a \u044f\u043a I\u0441\u0430\u0430\u043a, \u0434\u0437\u0435\u0446\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f. \u041c\u044b \u0434\u0437\u0435\u0446\u0456 \u043d\u0435 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b, \u0430\u043b\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439. <span style=\"color: #ff0000;\">*<\/span> \u0414\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0432\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c, \u0430 \u0434\u0437\u0435 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0442\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0432\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"56","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">5, 1-25<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0432\u0430\u0431\u043e\u0434\u0430 \u045e \u0436\u044b\u0446\u0446\u0456 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0414\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0432\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0422\u0430\u043c\u0443 \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u044f\u0440\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456. \u0412\u043e\u0441\u044c \u044f, \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u043a\u0430\u043b\u0456 \u0432\u044b \u0434\u0430\u0441\u0446\u0451 \u0441\u044f\u0431\u0435 \u0430\u0431\u0440\u044d\u0437\u0430\u0446\u044c, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430\u043c \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430. \u042f\u0448\u0447\u044d \u0441\u0432\u0435\u0434\u0447\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d. \u0412\u044b, \u0448\u0442\u043e \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0435 \u0441\u044f\u0431\u0435 \u0417\u0430\u043a\u043e\u043d\u0430\u043c, \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u0434\u043f\u0430\u043b\u0456 \u0430\u0434 \u043b\u0430\u0441\u043a\u0456. \u041c\u044b \u0436 \u0443 \u0434\u0443\u0445\u0443 \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0447\u0430\u043a\u0430\u0435\u043c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043c\u043e\u0446\u044b \u043d\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u043d\u0456 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0432\u0435\u0440\u0430, \u044f\u043a\u0430\u044f \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0431\u0435\u0433\u043b\u0456 \u0434\u043e\u0431\u0440\u0430, \u0456 \u0445\u0442\u043e \u0436 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u045e \u0432\u0430\u043c \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435? \u041f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u043d\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0432\u0430\u0441 \u043a\u043b\u0456\u0447\u0430. \u041c\u0430\u043b\u0430\u044f \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0430 \u045e\u0441\u0451 \u0446\u0435\u0441\u0442\u0430 \u043a\u0432\u0430\u0441\u0456\u0446\u044c. \u041d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441 \u044f \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b \u045e \u041f\u0430\u043d\u0443, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0434\u0443\u043c\u0430\u0446\u044c \u0456\u043d\u0430\u043a\u0448. \u0410 \u0445\u0442\u043e \u0431\u0443\u043d\u0442\u0443\u0435 \u0432\u0430\u0441, \u0442\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u043d\u044b, \u0445\u0442\u043e \u0431 \u0451\u043d \u043d\u0435 \u0431\u044b\u045e. \u0411\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u044f \u0456 \u0434\u0430\u043b\u0435\u0439 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u0442\u043e \u0447\u0430\u043c\u0443 \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c? \u0422\u0430\u0434\u044b \u0437\u043d\u0456\u043a\u043b\u0430 \u0431 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435 \u043a\u0440\u044b\u0436\u0430. \u041e, \u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0441\u043a\u0430\u043b\u0435\u0447\u0430\u043d\u044b\u044f \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0432\u0430\u0441 \u0431\u0443\u043d\u0442\u0443\u044e\u0446\u044c!<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b, \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0434\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b. \u0422\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u043a\u0430\u0431 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u0446\u0435\u043b\u0443, \u0430\u043b\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u045e\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0430\u0434\u043d\u044b\u043c: \u043b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0443\u0441\u0430\u0435\u0446\u0435 \u0456 \u0437&rsquo;\u044f\u0434\u0430\u0435\u0446\u0435, \u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u0432\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e!<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043a\u0430\u0436\u0443: \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u0445\u0430 \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439\u0446\u0435. \u0411\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0446\u0435\u043b\u0430 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u0430\u0446\u044c \u0434\u0443\u0445\u0443, \u0430 \u0434\u0443\u0445 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0446\u0435\u043b\u0443, \u0431\u043e \u044f\u043d\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0445\u0430\u0446\u0435\u043b\u0456 \u0431. \u041a\u0430\u043b\u0456 \u043a\u0456\u0440\u0443\u0435 \u0432\u0430\u043c\u0456 \u0434\u0443\u0445, \u0442\u043e \u0432\u044b \u043d\u0435 \u043f\u0430\u0434 \u0417\u0430\u043a\u043e\u043d\u0430\u043c. \u0423\u0447\u044b\u043d\u043a\u0456 \u0436 \u0446\u0435\u043b\u0430 \u0432\u044f\u0434\u043e\u043c\u044b\u044f, \u0430 \u0433\u044d\u0442\u0430: \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0430, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0440\u0430\u0437\u0431\u044d\u0448\u0447\u0430\u043d\u0430\u0441\u0446\u044c, \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430, \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430, \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c, \u0441\u043f\u0440\u044d\u0447\u043a\u0456, \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c, \u0433\u043d\u0435\u045e, \u0441\u0432\u0430\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0437\u0432\u0430\u0434\u044b, \u0435\u0440\u0430\u0441\u0456, \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c, \u043f&rsquo;\u044f\u043d\u0441\u0442\u0432\u0430, \u043d\u0435\u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430. \u041a\u0430\u0436\u0443 \u0432\u0430\u043c \u0437\u043d\u043e\u045e, \u044f\u043a \u0456 \u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u044d\u0442\u0430 \u0440\u043e\u0431\u0456\u0446\u044c, \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u0410 \u043f\u043b\u0451\u043d \u0434\u0443\u0445\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u043a\u043e\u0439, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044c, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c. \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u0445 \u043d\u044f\u043c\u0430 \u0417\u0430\u043a\u043e\u043d\u0443. \u0410 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0446\u0435\u043b\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c\u0456 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u041a\u0430\u043b\u0456 \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430, \u0442\u043e \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 5, 18. 22\u0430. 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043a\u0456\u0440\u0443\u0435 \u0432\u0430\u043c\u0456 \u0434\u0443\u0445, \u0442\u043e \u0432\u044b \u043d\u0435 \u043f\u0430\u0434 \u0417\u0430\u043a\u043e\u043d\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u043f\u043b\u0451\u043d \u0434\u0443\u0445\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u043a\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430, \u0442\u043e \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043f\u043b\u0451\u043d \u0434\u0443\u0445\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"57","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;\u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">5, 26 &ndash; 6, 18&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0417\u0430\u043a\u043b\u0456\u043a \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430, \u0442\u043e \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0443\u0441\u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u0434\u0440\u0430\u0436\u043d\u044f\u0447\u044b \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u0431 \u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0456\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443 \u043d\u0435\u0447\u044b\u043c, \u0432\u044b, \u0448\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u0434\u0443\u0445\u0443, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u044f\u0433\u043e \u0437 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044e, \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0456 \u0441\u0430\u043c\u0456\u043c \u043d\u0435 \u045e\u043f\u0430\u0441\u0446\u0456. \u041d\u0430\u0441\u0456\u0446\u0435 \u0446\u044f\u0436\u0430\u0440\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0442\u0430\u043a \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u0446\u0435 \u0437\u0430\u043a\u043e\u043d \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0451\u043d \u043b\u0435\u043f\u0448\u044b, \u0430 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c, \u0442\u043e\u0439 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0430\u0448\u0443\u043a\u0432\u0430\u0435. \u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0447\u044b\u043d\u044b, \u0456 \u0442\u0430\u0434\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u043b\u0430\u0432\u0443, \u0430 \u043d\u0435 \u045e \u0456\u043d\u0448\u044b\u043c. \u041a\u043e\u0436\u043d\u044b \u0436 \u043f\u0430\u043d\u044f\u0441\u0435 \u0441\u0432\u043e\u0439 \u0443\u043b\u0430\u0441\u043d\u044b \u0446\u044f\u0436\u0430\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c, \u0434\u0437\u0435\u043b\u0456\u0446\u0446\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0434\u0430\u0431\u0440\u043e\u043c \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0433\u043e \u043d\u0430\u0432\u0443\u0447\u0430\u0435. \u041d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435: \u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0446\u0446\u0430 \u0437 \u0441\u044f\u0431\u0435; \u0431\u043e \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0441\u0435\u0435, \u0442\u043e\u0435 \u0456 \u043f\u0430\u0436\u043d\u0435. \u0425\u0442\u043e \u0441\u0435\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435, \u0442\u043e\u0439 \u0437 \u0446\u0435\u043b\u0430 \u043f\u0430\u0436\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435, \u0430 \u0445\u0442\u043e \u0441\u0435\u0435 \u045e \u0434\u0443\u0445\u0443, \u0442\u043e\u0439 \u0437 \u0434\u0443\u0445\u0430 \u043f\u0430\u0436\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041d\u0435 \u0441\u043f\u044b\u043d\u044f\u0439\u043c\u0430\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u0456 \u0436\u0430\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u043d\u0435\u043c. \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0447\u0430\u0441, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u045e\u0441\u0456\u043c, \u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 &ndash; \u0431\u043b\u0456\u0437\u043a\u0456\u043c \u043f\u0430 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u043d\u044c\u0446\u0435, \u044f\u043a\u0456\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u043b\u0456\u0442\u0430\u0440\u0430\u043c\u0456 \u044f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c \u0443\u043b\u0430\u0441\u043d\u0430\u0440\u0443\u0447\u043d\u0430. \u0422\u044b\u044f, \u0448\u0442\u043e \u0445\u043e\u0447\u0443\u0446\u044c \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0432\u0430\u043c \u0446\u0435\u043b\u0430\u043c, \u0437\u043c\u0443\u0448\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0434\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u0437\u0430 \u043a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u0430. \u0410 \u0442\u044b\u044f, \u0448\u0442\u043e \u0430\u0431\u0440\u0430\u0437\u0430\u044e\u0446\u0446\u0430, \u0441\u0430\u043c\u0456 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0417\u0430\u043a\u043e\u043d, \u0430 \u0445\u043e\u0447\u0443\u0446\u044c \u0432\u0430\u0441 \u0430\u0431\u0440\u044d\u0437\u0430\u0446\u044c, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u0446\u0435\u043b\u0430 \u0432\u0430\u0448\u0430\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u043d\u0435 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f &ndash; \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443. \u0411\u043e \u043d\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0456 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u043d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u0406 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u0430, &ndash; \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0411\u043e\u0436\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0440\u044d\u0448\u0446\u0435, \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0435 \u043c\u044f\u043d\u0435, \u0431\u043e \u044f \u043d\u0430\u0448\u0443 \u043d\u0430 \u0446\u0435\u043b\u0435 \u0441\u0432\u0430\u0456\u043c \u0440\u0430\u043d\u044b \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u0434\u0443\u0445\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u0431\u0440\u0430\u0442\u044b. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 6, 7b-8; \u042f\u043d 6, 63\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0441\u0435\u0435, \u0442\u043e\u0435 \u0456 \u043f\u0430\u0436\u043d\u0435. \u0425\u0442\u043e \u0441\u0435\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435, \u0442\u043e\u0439 \u0437 \u0446\u0435\u043b\u0430 \u043f\u0430\u0436\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0441\u0435\u0435 \u045e \u0434\u0443\u0445\u0443, \u0442\u043e\u0439 \u0437 \u0434\u0443\u0445\u0430 \u043f\u0430\u0436\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0443\u0445 \u0430\u0436\u044b\u045e\u043b\u044f\u0435, \u0446\u0435\u043b\u0430 \u0436 \u043d\u0456 \u043d\u0430 \u0448\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0441\u0435\u0435 \u045e \u0434\u0443\u0445\u0443, \u0442\u043e\u0439 \u0437 \u0434\u0443\u0445\u0430 \u043f\u0430\u0436\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n"}, {"GCH_CH_1_ID":"61","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e<span style=\"color: #ff0000;\">&nbsp;1, 1-7. 20-33<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0417\u0430\u0430\u0445\u0432\u043e\u0442\u0430 \u0434\u0430 \u0432\u044b\u0431\u0430\u0440\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430, \u0441\u044b\u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u044b, \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0441\u043b\u043e\u0432\u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430, \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0433\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0443\u0434\u0430 \u0456 \u0434\u043e\u0431\u0440\u0430\u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c \u043a\u0435\u043c\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u043c &ndash; \u0432\u0435\u0434\u044b \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c. \u041c\u0443\u0434\u0440\u044b \u043f\u0440\u0430\u0437 \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u0435 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0432\u0435\u0434\u044b, \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u043d\u0430\u0431\u044b\u0432\u0430\u0435 \u045e\u043c\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044c \u0456 \u0456\u043d\u0448\u0430\u0441\u043a\u0430\u0437\u0430\u043d\u043d\u0435, \u0441\u043b\u043e\u0432\u044b \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0456 \u0437\u0430\u0433\u0430\u0434\u043a\u0456 \u0456\u0445\u043d\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0432\u0435\u0434\u0430\u045e. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u043d\u0430\u0432\u0443\u043a\u0430\u044e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0433\u0440\u044d\u0431\u0443\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0433\u0443\u043a\u0430\u0435 \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u0430\u0445, \u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u0430\u0445 \u0443\u0437\u043d\u0456\u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441; \u043d\u0430 \u0448\u0443\u043c\u043d\u044b\u0445 \u0441\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u044f\u0445 \u0433\u0443\u043a\u0430\u0435 \u044f\u043d\u0430, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u045e \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0456\u0445 \u0431\u0440\u0430\u043c\u0430\u0445: &laquo;\u0414\u0430\u043a\u0443\u043b\u044c, \u043f\u0440\u0430\u0441\u0442\u0430\u043a\u0456, \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0433\u043b\u0443\u043f\u043e\u0442\u0443? \u041d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0456, \u0434\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0437 \u043a\u043f\u0456\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f &ndash; \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c \u043d\u0430\u0432\u0443\u043a\u0430\u0439? \u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u043c\u0430\u0456\u0445 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u045e, \u044f \u0432\u044b\u043b\u044c\u044e \u043d\u0430 \u0432\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0430, \u0432\u044b\u044f\u045e\u043b\u044e \u0432\u0430\u043c \u0441\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b. \u0411\u043e \u044f \u0433\u0443\u043a\u0430\u043b\u0430, \u0430 \u0432\u044b \u0430\u0434\u043c\u043e\u0432\u0456\u043b\u0456\u0441\u044f, \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u043b\u0430 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443, \u0430\u043b\u0435 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e. \u0412\u044b \u043f\u0430\u0433\u0440\u044d\u0431\u0430\u0432\u0430\u043b\u0456 \u045e\u0441\u0456\u043c\u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043c\u0456 \u043c\u0430\u0456\u043c\u0456, \u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u043b\u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u043c\u0430\u0456\u0445 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u045e. \u0414\u044b\u043a \u0456 \u044f \u0431\u0443\u0434\u0443 \u0441\u043c\u044f\u044f\u0446\u0446\u0430 \u0437 \u0432\u0430\u0448\u0430\u0433\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f, \u0456 \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0430\u0445\u043e\u043f\u0456\u0446\u044c \u0432\u0430\u0441 \u0441\u0442\u0440\u0430\u0445, \u043a\u0430\u043b\u0456 \u0441\u0442\u0440\u0430\u0445 \u0441\u044b\u0434\u0437\u0435 \u043d\u0430 \u0432\u0430\u0441 \u044f\u043a \u0431\u0443\u0440\u0430, \u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435 \u043d\u0430\u0434\u044b\u0434\u0437\u0435 \u044f\u043a \u0432\u0456\u0445\u043e\u0440, \u043a\u0430\u043b\u0456 \u0430\u0431\u0440\u044b\u043d\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u0430\u0441 \u0433\u043e\u0440\u0430 \u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435. \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0430\u0434\u043a\u0430\u0436\u0443; \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c. \u0411\u043e \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u043b\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0456 \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043b\u0456 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430. \u041d\u0435 \u0445\u0430\u0446\u0435\u043b\u0456 \u043c\u0430\u0456\u0445 \u043f\u0430\u0440\u0430\u0434\u0430\u045e, \u0433\u0440\u044d\u0431\u0430\u0432\u0430\u043b\u0456 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0430\u0456\u043c \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456 \u043f\u043b\u0430\u0434\u044b \u0434\u0430\u0440\u043e\u0433\u0456 \u0441\u0432\u0430\u0451\u0439 \u0456 \u043d\u0430\u0441\u044b\u0446\u044f\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043c\u0456. \u0411\u043e \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u043d\u0435\u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u0445 \u0437\u0430\u0431&rsquo;\u0435 \u0456\u0445, \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0437\u0430\u0433\u0443\u0431\u0456\u0446\u044c \u0456\u0445. \u0410\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u043c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u0437\u043b\u043e\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 12, 16b; <\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 3, 18b-19\u0430; 1, 23\u0430. 24b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043b\u0456\u0447\u044b\u0446\u0435 \u0441\u044f\u0431\u0435 \u043c\u0443\u0434\u0440\u044b\u043c\u0456. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u043c\u0443\u0434\u0440\u044b\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430 \u045e \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446 \u0456 \u0411\u043e\u0436\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430 \u045e \u0411\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"62","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">3, 1-20<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u042f\u043a \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c?<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u0435 \u043c\u043e\u0439, \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u043c\u0430\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u0456 \u043d\u0430\u043a\u0430\u0437\u044b \u043c\u0430\u0435 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451; \u0431\u043e \u0434\u0430\u045e\u0433\u0456\u044f \u0434\u043d\u0456 \u0456 \u0433\u0430\u0434\u044b \u0436\u044b\u0446\u0446\u044f \u0434\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u044f\u043d\u044b \u0434\u0430\u0434\u0443\u0446\u044c \u0442\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435; \u0437\u0430\u0432\u044f\u0436\u044b \u0456\u0445 \u043d\u0430 \u0448\u044b\u0456 \u0441\u0432\u0430\u0451\u0439, \u043d\u0430\u043f\u0456\u0448\u044b \u0456\u0445 \u043d\u0430 \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0422\u0430\u0434\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043b\u0430\u0441\u043a\u0443 \u0456 \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u0411\u043e\u0433\u0430 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u041f\u0430\u043d\u0430 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u043d\u0435 \u0430\u043f\u0456\u0440\u0430\u0439\u0441\u044f \u043d\u0430 \u0441\u0432\u043e\u0439 \u0440\u043e\u0437\u0443\u043c. \u041d\u0430 \u045e\u0441\u0456\u0445 \u0434\u0430\u0440\u043e\u0433\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0439 \u042f\u0433\u043e, \u0456 \u0401\u043d \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456 \u0434\u0430\u0440\u043e\u0433\u0456 \u0442\u0432\u0430\u0435. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0434\u0440\u044b\u043c \u0443 \u0432\u0430\u0447\u0430\u0445 \u0441\u0432\u0430\u0456\u0445, \u0430\u043b\u0435 \u0431\u043e\u0439\u0441\u044f \u041f\u0430\u043d\u0430 \u0456 \u045e\u0445\u0456\u043b\u044f\u0439\u0441\u044f \u0430\u0434 \u0437\u043b\u0430. \u0413\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u043b\u0435\u043a\u0430\u043c \u0434\u043b\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u043d\u0430\u043f\u043e\u0435\u043c \u0434\u043b\u044f \u0442\u0432\u0430\u0456\u0445 \u043a\u0430\u0441\u0446\u0435\u0439. \u0423\u0448\u0430\u043d\u0443\u0439 \u041f\u0430\u043d\u0430 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456 \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u043b\u0451\u043d\u0430\u043c \u0437 \u0443\u0441\u044f\u0433\u043e \u043f\u0440\u044b\u0431\u044b\u0442\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e. \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0432\u0456\u0440\u043d\u044b \u0442\u0432\u0430\u0435, \u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0435 \u0432\u0456\u043d\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043b\u0456\u0432\u0430\u0446\u0446\u0430 \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043a\u0440\u0430\u0439 \u0434\u0430\u0432\u0456\u043b\u0430\u045e \u0442\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0433\u0440\u044d\u0431\u0443\u0439, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439, \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043c \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0437\u043d\u0435\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439\u0441\u044f \u0430\u0434 \u042f\u0433\u043e \u0432\u044b\u043c\u043e\u0432\u0430\u045e. \u0411\u043e \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u0430\u0433\u043e \u043a\u0430\u0440\u0430\u0435, \u044f\u043a \u0430\u0439\u0446\u0435\u0446 \u0441\u044b\u043d\u0430, \u0443 \u044f\u043a\u0456\u043c \u043c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u0434\u0430\u0431\u044b\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0430\u0431\u044b\u045e \u0440\u043e\u0437\u0443\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u044f\u0435 \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430, \u0456 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0430\u0434 \u044f\u0435 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0430\u0434 \u0437\u043e\u043b\u0430\u0442\u0430: \u044f\u043d\u0430 \u0434\u0430\u0440\u0430\u0436\u044d\u0439 \u0437\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456; \u043d\u0456\u044f\u043a\u0430\u0435 \u0437\u043b\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0451\u0439; \u044f\u043d\u0430 \u0434\u043e\u0431\u0440\u0430 \u0432\u044f\u0434\u043e\u043c\u0430\u044f \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u044f\u0435; \u0456 \u043d\u0456\u0448\u0442\u043e \u0437 \u0436\u0430\u0434\u0430\u043d\u0430\u0433\u0430 \u0442\u0430\u0431\u043e\u044e \u043d\u0435 \u0437\u0440\u0430\u045e\u043d\u0430\u0435\u0446\u0446\u0430 \u0437 \u0451\u0439. \u0414\u0430\u045e\u0436\u044b\u043d\u044f \u0434\u0437\u0451\u043d &ndash; \u0443 \u044f\u0435 \u043f\u0440\u0430\u0432\u0456\u0446\u044b, \u0456 \u045e \u043b\u0435\u0432\u0430\u0439 \u0440\u0443\u0446\u044d &ndash; \u044f\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u0441\u043b\u0430\u0432\u0430. \u042f\u0435 \u0434\u0430\u0440\u043e\u0433\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456, \u0456 \u045e\u0441\u0435 \u044f\u0435 \u0441\u0446\u0435\u0436\u043a\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u043a\u043e\u0439. \u0414\u0440\u044d\u0432\u0430\u043c \u0436\u044b\u0446\u0446\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043d\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0434\u0430\u0431\u044b\u045e \u044f\u0435, \u0430 \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u044f\u0435 &ndash; \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044e \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u043b\u0456\u0441\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456, \u0456 \u0445\u043c\u0430\u0440\u044b \u0434\u0430\u043b\u0456 \u0440\u0430\u0441\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0440\u044b\u043f 3, 11. 12; \u0413\u0431\u0440 12, 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0433\u0440\u044d\u0431\u0443\u0439 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043c \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0437\u043d\u0435\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439\u0441\u044f \u0430\u0434 \u042f\u0433\u043e \u0432\u044b\u043c\u043e\u0432\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u0430\u0433\u043e \u043a\u0430\u0440\u0430\u0435, \u044f\u043a \u0430\u0439\u0446\u0435\u0446 \u0441\u044b\u043d\u0430, \u0443 \u044f\u043a\u0456\u043c \u043c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441, \u044f\u043a \u0434\u0430 \u0441\u044b\u043d\u043e\u045e. \u0426\u0456 \u0436 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u0441\u044b\u043d, \u044f\u043a\u043e\u0433\u0430 \u0431 \u043d\u0435 \u043a\u0430\u0440\u0430\u045e \u0431\u0430\u0446\u044c\u043a\u0430?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u0430\u0433\u043e \u043a\u0430\u0440\u0430\u0435, \u044f\u043a \u0430\u0439\u0446\u0435\u0446 \u0441\u044b\u043d\u0430, \u0443 \u044f\u043a\u0456\u043c \u043c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"63","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">8, 1-5. 12-36&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0445\u0432\u0430\u043b\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043d\u0435 \u0433\u0443\u043a\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430 \u0440\u043e\u0437\u0443\u043c \u0446\u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0435 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441? \u042f\u043d\u0430 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u045e\u0437\u0432\u044b\u0448\u0448\u0430\u045e, \u043a\u0430\u043b\u044f \u0434\u0430\u0440\u043e\u0433\u0456, \u043d\u0430 \u0440\u043e\u0441\u0442\u0430\u043d\u044f\u0445. \u042f\u043d\u0430 \u0433\u043e\u043b\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435 \u043a\u0430\u043b\u044f \u0431\u0440\u0430\u043c\u0430\u045e, \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0433\u043e\u0440\u0430\u0434, \u043f\u0440\u044b \u0434\u0437\u0432\u044f\u0440\u0430\u0445. &laquo;\u0414\u0430 \u0432\u0430\u0441, \u043b\u044e\u0434\u0437\u0456, \u044f \u0433\u0443\u043a\u0430\u044e, \u0456 \u0433\u043e\u043b\u0430\u0441 \u043c\u043e\u0439 \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445. \u041d\u0435\u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u044f! \u041d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456! \u041d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f! \u041f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u0435 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430!<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0436\u044b\u0432\u0443 \u0437 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044e \u0456 \u043d\u0430\u0431\u044b\u043b\u0430 \u045e\u043c\u0435\u043d\u043d\u0435 \u0434\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0440\u0430\u0434\u044b. \u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 &ndash; \u0443 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456 \u0434\u0430 \u0437\u043b\u0430, \u0442\u0430\u043c\u0443 \u044f \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443 \u043f\u044b\u0445\u0443 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0434\u0430\u0440\u043e\u0433\u0443 \u0437\u043b\u0430 \u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u044f \u0432\u0443\u0441\u043d\u044b. \u0423 \u043c\u044f\u043d\u0435 \u043f\u0430\u0440\u0430\u0434\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c; \u044f &ndash; \u0440\u043e\u0437\u0443\u043c, \u0443 \u043c\u044f\u043d\u0435 \u0441\u0456\u043b\u0430. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043d\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0456, \u0456 \u043f\u0440\u0430\u0432\u0456\u0446\u0435\u043b\u0456 \u045e\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043d\u0435 \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u043a\u043d\u044f\u0437\u0456 \u0456 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0441\u0443\u0434\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043b\u044e\u0431\u043b\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u0430 \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u043c\u044f\u043d\u0435, \u0442\u043e\u0439 \u0437\u043d\u043e\u0439\u0434\u0437\u0435. \u0411\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u0441\u043b\u0430\u0432\u0430 &ndash; \u0441\u0430 \u043c\u043d\u043e\u044e, \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u044f \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u041f\u043b\u0430\u0434\u044b \u043c\u0430\u0435 \u043b\u0435\u043f\u0448\u044b\u044f \u0437\u0430 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0435 \u0437\u043e\u043b\u0430\u0442\u0430, \u0430 \u043f\u0440\u044b\u0431\u044b\u0442\u0430\u043a \u0430\u0434 \u043c\u044f\u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0435 \u0441\u0440\u044d\u0431\u0440\u0430. \u042f \u0456\u0434\u0443 \u0434\u0430\u0440\u043e\u0433\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430 \u0441\u0446\u0435\u0436\u043a\u0430\u0445 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0456 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0456\u0445\u043d\u0456\u044f \u044f \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0448\u043b\u044f\u0445\u0443 \u0441\u0432\u0430\u0439\u0433\u043e, \u043f\u0435\u0440\u0430\u0434 \u0434\u0437\u0435\u044f\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443. \u0410\u0434\u0432\u0435\u043a\u0443 \u044f \u0431\u044b\u043b\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430, \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043f\u0435\u0440\u0430\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c \u0437\u044f\u043c\u043b\u0456. \u042f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u044f\u0448\u0447\u044d \u043d\u0456 \u0431\u0435\u0437\u0434\u0430\u043d\u0456, \u043d\u0456 \u043a\u0440\u044b\u043d\u0456\u0446, \u043f\u043e\u045e\u043d\u044b\u0445 \u0432\u0430\u0434\u044b. \u041f\u0435\u0440\u0448, \u0447\u044b\u043c \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u0433\u043e\u0440\u044b, \u0440\u0430\u043d\u0435\u0439 \u0437\u0430 \u043f\u0430\u0433\u043e\u0440\u043a\u0456 \u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0401\u043d \u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u043d\u0456 \u043f\u0430\u043b\u0451\u045e, \u043d\u0456 \u043f\u0435\u0440\u0448\u044b\u0445 \u043f\u044b\u043b\u0456\u043d\u0430\u043a \u0441\u0443\u0441\u0432\u0435\u0442\u0443. \u041a\u0430\u043b\u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b, \u044f \u0431\u044b\u043b\u0430 \u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043a\u0440\u044d\u0441\u043b\u0456\u045e \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u0435 \u043d\u0430\u0434 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u044f\u044e \u0431\u0435\u0437\u0434\u0430\u043d\u0456, \u043a\u0430\u043b\u0456 \u045e\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u045e \u0443\u0432\u0435\u0440\u0441\u0435 \u0430\u0431\u043b\u043e\u043a\u0456, \u043a\u0430\u043b\u0456 \u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0431\u0435\u0437\u0434\u0430\u043d\u0456, \u043a\u0430\u043b\u0456 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u045e \u043c\u0435\u0436\u044b \u043c\u043e\u0440\u0443, \u043a\u0430\u0431 \u0432\u043e\u0434\u044b \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043f\u0430-\u0437\u0430 \u0431\u0435\u0440\u0430\u0433\u0456 \u044f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0437\u0430\u043a\u043b\u0430\u0434\u0432\u0430\u045e \u0430\u0441\u043d\u043e\u0432\u044b \u0437\u044f\u043c\u043b\u0456, \u0442\u0430\u0434\u044b \u0431\u044b\u043b\u0430 \u043f\u0440\u044b \u0406\u043c, \u044f\u043a \u043c\u0430\u0439\u0441\u0442\u0430\u0440, \u0431\u044b\u043b\u0430 \u0448\u0442\u043e\u0434\u043d\u044f \u042f\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435\u043c, \u0432\u0435\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u0432\u0435\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043d\u044b\u043c \u043a\u043e\u043b\u0435 \u042f\u0433\u043e, \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u044f \u0431\u044b\u043b\u0430 \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c\u0456 \u0441\u044b\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0446\u044f\u043f\u0435\u0440, \u0441\u044b\u043d\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435: \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u0456\u0445 \u0434\u0430\u0440\u043e\u0433. \u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0443\u0434\u0440\u044b\u044f \u0456 \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0456\u0445. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0441\u043b\u0443\u0445\u0430\u0435 \u043c\u044f\u043d\u0435, \u044f\u043a\u0456 \u0447\u0443\u0432\u0430\u0435 \u043f\u0440\u044b \u043c\u0430\u0456\u0445 \u0434\u0437\u0432\u044f\u0440\u0430\u0445 \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u0431 \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u0443\u0448\u0430\u043a\u0456 \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u043c\u0430\u0456\u0445. \u0411\u043e \u0445\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043c\u044f\u043d\u0435, \u0442\u043e\u0439 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0436\u044b\u0446\u0446\u0451 \u0456 \u0437\u0434\u0430\u0431\u044b\u045e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430. \u0410\u043b\u0435 \u0445\u0442\u043e \u0430\u0431\u0440\u0430\u0436\u0430\u0435 \u043c\u044f\u043d\u0435, \u0442\u043e\u0439 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 8, 22; \u042f\u043d 1, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0437\u0434\u0430\u045e\u043d\u0430, \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0434\u0430\u045e\u043d\u0430, \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"64","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">9, 1-18&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0433\u043b\u0443\u043f\u043e\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u0434\u043e\u043c \u0441\u0432\u043e\u0439 \u0456 \u0432\u044b\u0447\u0430\u0441\u0430\u043b\u0430 \u0441\u0435\u043c \u043a\u0430\u043b\u043e\u043d\u0430\u045e \u044f\u0433\u043e, \u0437\u0430\u0431\u0456\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u0437\u043c\u044f\u0448\u0430\u043b\u0430 \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451 \u0456 \u0441\u0442\u043e\u043b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430. \u0412\u044b\u0441\u043b\u0430\u043b\u0430 \u0441\u043b\u0443\u0436\u0430\u043d\u0430\u043a \u0441\u0432\u0430\u0456\u0445 \u0456 \u043a\u043b\u0456\u0447\u0430 \u0437 \u0432\u044f\u0440\u0448\u044b\u043d\u044c \u0443\u0437\u0432\u044b\u0448\u0448\u0430\u045e \u0433\u043e\u0440\u0430\u0434\u0430: &laquo;\u0425\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u044e\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u043c\u0443 \u044f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u0435\u0448\u0446\u0435 \u0445\u043b\u0435\u0431 \u043c\u043e\u0439, \u043f\u0456\u0446\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0437\u043c\u044f\u0448\u0430\u043b\u0430. \u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0433\u043b\u0443\u043f\u043e\u0442\u0443 \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0436\u044b\u0446\u044c, \u0445\u0430\u0434\u0437\u0456\u0446\u0435 \u0448\u043b\u044f\u0445\u0430\u043c \u0440\u043e\u0437\u0443\u043c\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0430, \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0430\u043d\u044c\u0431\u0443, \u0430 \u0445\u0442\u043e \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0430, \u0440\u044b\u0437\u044b\u043a\u0443\u0435 \u0431\u044b\u0446\u044c \u0437\u043d\u044f\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b\u043c. \u041d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0439 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0430, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u0446\u044f\u0431\u0435; \u0434\u0430\u043a\u0430\u0440\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0433\u0430, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435. \u0414\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u043c\u0443, \u0456 \u0451\u043d \u043f\u0430\u043c\u0443\u0434\u0440\u044d\u0435; \u043d\u0430\u0432\u0443\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0456 \u0451\u043d \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u0435\u0434\u044b. \u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 &ndash; \u0440\u043e\u0437\u0443\u043c. \u0411\u043e \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u0430\u0446\u0446\u0430 \u0434\u043d\u0456 \u0442\u0432\u0430\u0435, \u0456 \u0434\u0430\u0434\u0430\u0434\u0443\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u0433\u0430\u0434\u044b \u0436\u044b\u0446\u0446\u044f. \u041a\u0430\u043b\u0456 \u0442\u044b \u0441\u0442\u0430\u045e \u043c\u0443\u0434\u0440\u044b\u043c, \u0442\u043e \u0441\u0442\u0430\u045e \u043c\u0443\u0434\u0440\u044b\u043c \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0435\u0448\u0441\u044f, \u0442\u044b \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0446\u0435\u0440\u043f\u0456\u0448. \u0413\u043b\u0443\u043f\u043e\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043a\u043b\u0456\u0432\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u044f, \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430. \u042f\u043d\u0430 \u0441\u0435\u043b\u0430 \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c \u043d\u0430 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0456, \u0441\u044f\u0440\u043e\u0434 \u0443\u0437\u0433\u043e\u0440\u043a\u0430\u045e \u0433\u043e\u0440\u0430\u0434\u0430, \u043a\u0430\u0431 \u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456: &laquo;\u0425\u0442\u043e \u043d\u0435\u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b, \u043d\u044f\u0445\u0430\u0439 \u0437\u0432\u0435\u0440\u043d\u0435 \u0441\u044e\u0434\u044b!&raquo;, \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u043c\u0443 \u044f\u043d\u0430 \u043a\u0430\u0436\u0430: &laquo;\u041a\u0440\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0432\u0430\u0434\u0430 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u044f, \u0430 \u0445\u043b\u0435\u0431, \u0448\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e\u043f\u043e\u0442\u0430\u0439, \u0441\u043c\u0430\u0447\u043d\u044b!&raquo; \u0410 \u0451\u043d \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0442\u0430\u043c &ndash; \u0446\u0435\u043d\u0456; \u0448\u0442\u043e \u0437\u0430\u043f\u0440\u043e\u0448\u0430\u043d\u044b\u044f \u0451\u0439 \u0441\u044b\u0448\u043b\u0456 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 14, 16-17; \u041f\u0440\u044b\u043f 9, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0430\u043b\u0430\u0434\u0436\u0432\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0432\u044f\u0447\u044d\u0440\u0443 <span style=\"color: #ff0000;\">\/<\/span> \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0437\u0430\u043f\u0440\u043e\u0448\u0430\u043d\u044b\u043c: <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0431\u043e \u045e\u0436\u043e \u045e\u0441\u0451 \u0433\u0430\u0442\u043e\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u0435\u0448\u0446\u0435 \u0445\u043b\u0435\u0431 \u043c\u043e\u0439, \u043f\u0456\u0446\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0437\u043c\u044f\u0448\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0431\u043e \u045e\u0436\u043e \u045e\u0441\u0451 \u0433\u0430\u0442\u043e\u0432\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"65","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">10, 6-32&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0420\u043e\u0437\u043d\u044b\u044f \u0441\u0435\u043d\u0442\u044d\u043d\u0446\u044b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0430 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u043d\u0430\u0441\u0456\u043b\u043b\u0435. \u041f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f, \u0430 \u0456\u043c\u044f \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0437\u0430\u0433\u0456\u043d\u0435. \u041c\u0443\u0434\u0440\u044b \u0441\u044d\u0440\u0446\u0430\u043c \u043f\u0440\u044b\u043c\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0441\u0445\u0456\u0431\u0456\u0446\u044c \u0432\u0443\u0441\u043d\u0430\u043c\u0456. \u0425\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430, \u0436\u044b\u0432\u0435 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u0430 \u0445\u0442\u043e \u0441\u043a\u0440\u044b\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0456, \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043a\u0440\u044b\u0442\u044b. \u0425\u0442\u043e \u043c\u0456\u0440\u0433\u0430\u0435 \u0432\u0430\u0447\u044b\u043c\u0430, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u0430 \u0432\u0443\u0441\u043d\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u045e\u043f\u0430\u0434\u043a\u0443. \u0412\u0443\u0441\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u043d\u0430\u0441\u0456\u043b\u043b\u0435. \u041d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0441\u0432\u0430\u0440\u043a\u0456, \u0430\u043b\u0435 \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0432\u0443\u0441\u043d\u0430\u0445 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0451\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430 \u0440\u043e\u0437\u0433\u0430 &ndash; \u043d\u0430 \u0441\u043f\u0456\u043d\u0435 \u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0440\u043e\u0437\u0443\u043c\u0443. \u041c\u0443\u0434\u0440\u044b\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0432\u0435\u0434\u044b, \u0430 \u0432\u0443\u0441\u043d\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0431\u043b\u0456\u0437\u043a\u0456\u044f \u0434\u0430 \u0437\u0433\u0443\u0431\u044b. \u041c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u0430\u0433\u0430 &ndash; \u044f\u0433\u043e \u043c\u043e\u0446\u043d\u044b \u0433\u043e\u0440\u0430\u0434, \u0437\u0433\u0443\u0431\u0430 \u0431\u0435\u0434\u043d\u044b\u0445 &ndash; \u0456\u0445 \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u044c. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0437\u0430\u0440\u043e\u0431\u0430\u043a \u0441\u043f\u0440\u044b\u044f\u0435 \u0436\u044b\u0446\u0446\u044e, \u043f\u0440\u044b\u0431\u044b\u0442\u0430\u043a \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0433\u0440\u0430\u0445\u0443. \u0421\u0446\u0435\u0436\u043a\u0430\u044e \u0436\u044b\u0446\u0446\u044f \u0456\u0434\u0437\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0430 \u0445\u0442\u043e \u0430\u0434\u043a\u0456\u0434\u0430\u0435 \u0437\u0430\u045e\u0432\u0430\u0433\u0443 &ndash; \u0431\u043b\u0443\u043a\u0430\u0435. \u0425\u0442\u043e \u0445\u0430\u0432\u0430\u0435 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c, \u0443 \u0442\u0430\u0433\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u0456 \u0445\u0442\u043e \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0432\u0430\u0435 \u0430\u0431\u043c\u043e\u0432\u0443, \u0442\u043e\u0439 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b. \u0423 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0456 \u043d\u0435 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u0433\u0440\u0430\u0445\u0443, \u0430 \u0445\u0442\u043e \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b &ndash; \u0440\u0430\u0437\u0443\u043c\u043d\u044b. \u0427\u044b\u0441\u0442\u0430\u0435 \u0441\u0440\u044d\u0431\u0440\u0430 &ndash; \u044f\u0437\u044b\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0441\u044d\u0440\u0446\u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 &ndash; \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0443\u0441\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0436\u044b\u0432\u044f\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445, \u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0437 \u043d\u044f\u0441\u0442\u0430\u0447\u044b \u0440\u043e\u0437\u0443\u043c\u0443 \u043f\u0430\u043c\u0440\u0443\u0446\u044c. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435, \u0456 \u043f\u0440\u0430\u0446\u0430 \u043d\u0435 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u044f\u0433\u043e. \u042f\u043a \u0434\u043b\u044f \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0451\u0441\u0446\u044c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430, \u0442\u0430\u043a \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 &ndash; \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u0427\u0430\u0433\u043e \u043d\u044f\u0433\u043e\u0434\u043d\u044b \u0431\u0430\u0456\u0446\u0446\u0430, \u0442\u043e\u0435 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u044f\u0433\u043e, \u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0432\u0456\u0445\u043e\u0440, \u0442\u043e \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043c\u0430\u0435 \u0432\u0435\u0447\u043d\u044b \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a. \u0427\u044b\u043c \u0451\u0441\u0446\u044c \u0432\u043e\u0446\u0430\u0442 \u0434\u043b\u044f \u0437\u0443\u0431\u043e\u045e \u0456 \u0434\u044b\u043c \u0434\u043b\u044f \u0432\u0430\u0447\u044d\u0439, \u0442\u044b\u043c \u0451\u0441\u0446\u044c \u043b\u044f\u043d\u0456\u0432\u044b \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u0434\u043d\u0456, \u0430 \u0433\u0430\u0434\u044b \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0441\u043a\u0430\u0440\u0430\u0447\u0430\u044e\u0446\u0446\u0430. \u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0443\u0432\u0435\u043d\u0447\u0432\u0430\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430 \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u043f\u0430\u043c\u0456\u0440\u0430\u0435. \u0428\u043b\u044f\u0445 \u041f\u0430\u043d\u0430 &ndash; \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f \u0434\u043b\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0430 \u0434\u043b\u044f \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430 &ndash; \u0437\u0433\u0443\u0431\u0430. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0435\u0446\u0446\u0430, \u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0412\u0443\u0441\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430 \u044f\u0437\u044b\u043a \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0446\u044f\u0442\u044b. \u0412\u0443\u0441\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u043f\u043e\u045e\u043d\u044b\u044f \u0434\u043e\u0431\u0440\u0430\u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u0432\u0443\u0441\u043d\u044b \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 &ndash; \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u0448\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 37 (36), 30. 31\u0430; 112 (111), 6b. 7a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0443\u0441\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u043a\u0430\u0436\u0443\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u044f\u0437\u044b\u043a \u044f\u0433\u043e\u043d\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0417\u0430\u043a\u043e\u043d \u0411\u043e\u0436\u044b \u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0432\u0435\u0447\u043d\u0430\u0439 \u043f\u0430\u043c\u044f\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0451\u043d \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0439 \u043d\u0430\u0432\u0456\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u0411\u043e\u0436\u044b \u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"66","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">15, 8-9. 16-17. 25-26. 29. 33; 16, 1-9; 17, 5&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445\u0432\u044f\u0440\u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0430\u0433\u0456\u0434\u043d\u0430\u044f \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u0445 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443. \u0410\u0433\u0456\u0434\u043d\u044b \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0448\u043b\u044f\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430, \u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0448\u043b\u044f\u0445\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0401\u043d \u043b\u044e\u0431\u0456\u0446\u044c. \u041b\u0435\u043f\u0448 \u043c\u0430\u043b\u0430 \u045e \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430, \u0447\u044b\u043c \u0441\u043a\u0430\u0440\u0431 \u0432\u044f\u043b\u0456\u043a\u0456, \u0456 \u0442\u0440\u044b\u0432\u043e\u0433\u0430 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e. \u041b\u0435\u043f\u0448 \u043f\u0430\u0441\u0456\u043b\u0430\u043a \u0437 \u0433\u0430\u0440\u043e\u0434\u043d\u0456\u043d\u044b \u0456 \u0437 \u0456\u043c \u043b\u044e\u0431\u043e\u045e, \u0447\u044b\u043c \u043a\u043e\u0440\u043c\u043d\u044b \u0432\u043e\u043b \u0456 \u0437 \u0456\u043c \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c. \u0414\u043e\u043c \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u0445 \u0440\u0443\u0439\u043d\u0443\u0435 \u041f\u0430\u043d, \u0430 \u043c\u0435\u0436\u044b \u045e\u0434\u0430\u0432\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435. \u0410\u0433\u0456\u0434\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u043b\u0456\u0445\u0456\u044f \u0437\u0430\u0434\u0443\u043c\u044b, \u0430 \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u042f\u043c\u0443. \u041f\u0430\u043d \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445, \u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0447\u0443\u0435. \u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u0441\u043b\u0430\u0432\u0443 \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u043f\u0430\u043a\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043c\u0435\u0440\u044b \u0441\u044d\u0440\u0446\u0430 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043c\u043e\u0432\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u041f\u0430\u043d\u0430. \u0423\u0441\u0435 \u0448\u043b\u044f\u0445\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437\u0434\u0430\u044e\u0446\u0446\u0430 \u044f\u043c\u0443 \u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u0430\u043b\u0435 \u041f\u0430\u043d \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0432\u0430\u0442 \u0434\u0443\u0445\u0430\u045e. \u0414\u0430\u0440\u0443\u0447\u044b \u041f\u0430\u043d\u0443 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u0456 \u0401\u043d \u0443\u043c\u0430\u0446\u0443\u0435 \u0434\u0443\u043c\u043a\u0456 \u0442\u0432\u0430\u0435. \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0443\u0441\u0451 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0456 \u043d\u0430\u0432\u0430\u0442 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u043b\u0456\u0445\u0430. \u0410\u0433\u0456\u0434\u043d\u044b \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u043a\u043e\u0436\u043d\u044b \u043f\u044b\u0445\u043b\u0456\u0432\u044b \u0441\u044d\u0440\u0446\u0430\u043c; \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u0446\u044c \u043f\u044d\u045e\u043d\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0431\u0435\u0441\u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u0432\u0456\u043d\u0443, \u0430 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u0430\u0434\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0437\u043b\u0430. \u041a\u0430\u043b\u0456 \u0448\u043b\u044f\u0445\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0446\u0446\u0430 \u041f\u0430\u043d\u0443, \u0401\u043d \u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u044f\u0433\u043e \u043f\u0430\u044f\u0434\u043d\u0430\u0435 \u0437 \u0456\u043c. \u041b\u0435\u043f\u0448 \u043c\u0430\u043b\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0447\u044b\u043c \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0440\u044b\u0431\u044b\u0442\u0430\u043a \u0443 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456. \u0421\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0431\u0434\u0443\u043c\u0432\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u0441\u0432\u0430\u044e, \u0430 \u041f\u0430\u043d \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u044f\u0433\u043e \u043a\u0440\u043e\u043a\u0456. \u0425\u0442\u043e \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0435\u0446\u0446\u0430 \u0437 \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u044f\u0433\u043e, \u0430 \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0437 \u0431\u044f\u0434\u044b, \u043d\u0435 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 6, 12b. 13a; \u041f\u0440\u044b\u043f 15, 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0446\u0435\u0440\u0430\u0436\u044b\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0431\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. <span style=\"color: #ff0000;\">*<\/span> \u0411\u0443\u0434\u0437\u0435\u0448 \u0431\u0430\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u0441\u043b\u0430\u0432\u0443 \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u043f\u0430\u043a\u043e\u0440\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u0435\u0448 \u0431\u0430\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"67","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">31, 10-31<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0445\u0432\u0430\u043b\u0430 \u0430\u0434\u0432\u0430\u0436\u043d\u0430\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0416\u0430\u043d\u0447\u044b\u043d\u0443 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0445\u0442\u043e \u0436 \u0437\u043d\u043e\u0439\u0434\u0437\u0435? \u0426\u0430\u043d\u0430 \u044f\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0437\u0430 \u043f\u0435\u0440\u043b\u044b. \u0414\u0430\u0432\u044f\u0440\u0430\u0435 \u0451\u0439 \u0441\u044d\u0440\u0446\u0430 \u043c\u0443\u0436\u0430 \u044f\u0435, \u0456 \u0451\u043d \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u043f\u0440\u044b\u0431\u044b\u0442\u043a\u0443. \u042f\u043d\u0430 \u0430\u0434\u043f\u043b\u043e\u0447\u0432\u0430\u0435 \u044f\u043c\u0443 \u0434\u0430\u0431\u0440\u043e\u043c, \u0430 \u043d\u0435 \u0437\u043b\u043e\u043c \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0448\u0443\u043a\u0430\u0435 \u0432\u043e\u045e\u043d\u0443 \u0456 \u043b\u0451\u043d \u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u0430\u0446\u0443\u0435 \u0440\u0443\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456. \u042f\u043a \u043a\u0443\u043f\u0435\u0446\u043a\u0456 \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c, \u044f\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0435\u0436\u0443 \u0437\u0434\u0430\u043b\u0451\u043a. \u0423\u0441\u0442\u0430\u0435, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u0446\u0451\u043c\u043d\u0430, \u0456 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0432\u0430\u0435 \u0435\u0436\u0430\u0439 \u0434\u043e\u043c, \u0430 \u0441\u043b\u0443\u0433\u0430\u043c \u0440\u0430\u0437\u0434\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0434\u0443\u043c\u0430\u0435 \u043f\u0440\u0430 \u043f\u043e\u043b\u0435 \u0456 \u043a\u0443\u043f\u043b\u044f\u0435 \u044f\u0433\u043e; \u043d\u0430 \u0437\u0430\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0441\u0430\u0434\u0437\u0456\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a. \u042f\u043d\u0430 \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435. \u042f\u0435 \u043b\u044f\u043c\u043f\u0430 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435 \u045e\u043d\u0430\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u0434\u0430 \u043f\u0440&aacute;\u0441\u043d\u0456\u0446\u044b, \u0456 \u043f\u0430\u043b\u044c\u0446\u044b \u044f\u0435 \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u0435\u0440\u0430\u0446\u044f\u043d\u043e. \u0414\u0430\u043b\u043e\u043d\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u045e\u0431\u043e\u0433\u0430\u043c\u0443 \u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043f\u0430\u0434\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u043c\u0443. \u0421\u043d\u0435\u0433 \u043d\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u044b \u0434\u043b\u044f \u044f\u0435 \u0434\u043e\u043c\u0443, \u0431\u043e \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u044f\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0441\u0430\u043c\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u044f\u0435 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430 \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u043b\u0451\u043d\u0443 \u0456 \u043f\u0443\u0440\u043f\u0443\u0440\u044b. \u042f\u0435 \u043c\u0443\u0436\u0430 \u043f\u0430\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445, \u043a\u0430\u043b\u0456 \u0451\u043d \u0441\u044f\u0434\u0430\u0435 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0430\u043b\u0430\u0442\u043d\u043e \u0456 \u043f\u0440\u0430\u0434\u0430\u0435 \u044f\u0433\u043e, \u0456 \u0434\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043a\u0443\u043f\u0446\u0430\u043c \u043f\u0430\u044f\u0441\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0446 \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c &ndash; \u044f\u0435 \u0448\u0430\u0442\u044b, \u044f\u043d\u0430 \u045e\u0441\u043c\u0456\u0445\u0430\u0435\u0446\u0446\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0434\u043d\u044f\u043c. \u0410\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0432\u0443\u0441\u043d\u044b, \u0456 \u044f\u0435 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u043f\u043e\u045e\u043d\u044b\u044f \u0432\u0435\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u043e\u0431\u0440\u0430 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043a\u0443 \u0456 \u043d\u0435 \u043a\u0430\u0448\u0442\u0443\u0435 \u0445\u043b\u0435\u0431\u0430 \u043b\u044f\u043d\u043e\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0435 \u0441\u044b\u043d\u044b \u043f\u0430\u0434\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u044f\u0435 \u0441\u0430\u043c\u0430\u0439 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439, \u0430 \u043c\u0443\u0436 \u044f\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u044c: &laquo;\u0428\u043c\u0430\u0442 \u0436\u0430\u043d\u0447\u044b\u043d \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430, \u0430\u043b\u0435 \u0442\u044b \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0448 \u0443\u0441\u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0432\u0430\u0431\u043d\u0430\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0437\u043c\u0430\u043d, \u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0416\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0433\u043e\u0434\u043d\u0430\u044f \u043f\u0430\u0445\u0432\u0430\u043b\u044b. \u0410\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0451\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0446\u044b \u0440\u0443\u043a \u044f\u0435, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u044f\u0446\u044c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u0447\u044b\u043d\u044b \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 31, 17. 18; \u043f\u0430\u0440. \u041f\u0441 46 (45), 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u0430 \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435.<span style=\"color: #ff0000;\">*<\/span> \u042f\u0435 \u043b\u044f\u043c\u043f\u0430 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435 \u045e\u043d\u0430\u0447\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0435, \u0456 \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0435\u0446\u0446\u0430; \u0411\u043e\u0433 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0451\u0439, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u0432\u0456\u0442\u0430\u043d\u0430\u043a.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u0435 \u043b\u044f\u043c\u043f\u0430 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435 \u045e\u043d\u0430\u0447\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"71","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u04301, <span style=\"color: #ff0000;\">1-18&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u0456\u0445 \u0440\u044d\u0447\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u044b \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430, \u0441\u044b\u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430\u0432\u0430\u0433\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044f\u045e, &ndash; \u043a\u0430\u0436\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, &ndash; \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044f\u045e \u0456 \u045e\u0441\u0451 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u042f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437 \u0443\u0441\u0451\u0439 \u044f\u0433\u043e \u043f\u0440\u0430\u0446\u044b, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c? \u041f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u043c\u0456\u043d\u0430\u0435, \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u0437\u044f\u043c\u043b\u044f \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u0421\u043e\u043d\u0446\u0430 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0441\u043e\u043d\u0446\u0430 \u0437\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u045e\u0437\u044b\u0448\u043b\u043e. \u0412\u0435\u0446\u0435\u0440 \u0432\u0435\u0435 \u043d\u0430 \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0437\u044c\u043c\u0435 \u0432\u0430\u043a\u043e\u043b, \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0435 \u043a\u043e\u043b\u044b. \u0423\u0441\u0435 \u0440\u044d\u043a\u0456 \u0446\u044f\u043a\u0443\u0446\u044c \u0434\u0430 \u043c\u043e\u0440\u0430, \u0430\u043b\u0435 \u043c\u043e\u0440\u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430; \u0434\u0430 \u043c\u0435\u0441\u0446\u0430, \u0430\u0434\u043a\u0443\u043b\u044c \u0446\u044f\u043a\u0443\u0446\u044c, \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u0440\u044d\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0430\u044f \u0433\u0430\u0432\u043e\u0440\u043a\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0441\u0456\u043b\u0430\u043a, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u0435 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0443\u0441\u044f\u0433\u043e; \u0432\u043e\u043a\u0430 \u043d\u0435 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u045e\u0431\u0430\u0447\u0430\u043d\u044b\u043c, \u0432\u0443\u0445\u0430 \u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043f\u0430\u0447\u0443\u0442\u044b\u043c. \u0428\u0442\u043e \u0431\u044b\u043b\u043e, \u0442\u043e\u0435 \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0437\u0435; \u0430 \u0448\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430, \u0442\u043e\u0435 \u0437\u043d\u043e\u045e \u0443\u0437\u043d\u0456\u043a\u043d\u0435: \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u0411\u044b\u0432\u0430\u0435 \u043d\u0435\u0448\u0442\u0430, \u0430\u0431 \u0447\u044b\u043c \u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u0413\u043b\u044f\u0434\u0437\u0456, \u043d\u043e\u0432\u0430\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456!&rdquo; \u0410\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0430\u0434 \u0432\u044f\u043a\u043e\u045e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u0431\u044b\u043b\u0456. \u041d\u044f\u043c\u0430 \u043f\u0430\u043c\u044f\u0446\u0456 \u0430\u0431 \u043c\u0456\u043d\u0443\u043b\u044b\u043c, \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043f\u0430\u043c\u044f\u0446\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, \u0431\u044b\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0406 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u044f \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c. \u0413\u044d\u0442\u044b \u0446\u044f\u0436\u043a\u0456 \u0437\u0430\u043d\u044f\u0442\u0430\u043a \u0434\u0430\u045e \u0411\u043e\u0433 \u0441\u044b\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u043a\u0430\u0431 \u0437\u0430\u0439\u043c\u0430\u043b\u0456\u0441\u044f \u0456\u043c. \u042f \u0440\u0430\u0437\u0432\u0430\u0436\u044b\u045e \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u0434\u0437\u0435\u044e\u0446\u0446\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c: \u0456 \u0432\u043e\u0441\u044c, \u0443\u0441\u0435 \u044f\u043d\u044b &ndash; \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443. \u0421\u043a\u0440\u044b\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u043f\u0440\u0430\u0441\u0442\u0430\u0446\u044c, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430, \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c. \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u0431\u0435 \u045e \u0441\u044d\u0440\u0446\u044b: &ldquo;\u0412\u043e\u0441\u044c \u044f \u043d\u0430\u0437\u0431\u0456\u0440\u0430\u045e \u0456 \u043d\u0430\u0433\u0440\u0443\u0432\u0430\u0441\u0446\u0456\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u043c\u043d\u043e\u044e \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u0456 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451 \u0431\u0430\u0447\u044b\u043b\u0430 \u0448\u043c\u0430\u0442 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0434\u0430\u045e&rdquo;. \u0406 \u044f \u045e\u043a\u043b\u0430\u045e \u0448\u043c\u0430\u0442 \u0441\u044d\u0440\u0446\u0430 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0434\u0430\u045e, \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430 \u0456 \u0433\u043b\u0443\u043f\u043e\u0442\u044b; \u0456 \u044f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443. \u0411\u043e \u0434\u0437\u0435 \u0448\u043c\u0430\u0442 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0442\u0430\u043c \u0448\u043c\u0430\u0442 \u0441\u0443\u043c\u0443, \u0456 \u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u0434\u0430\u045e, \u0442\u0430\u043c \u0431\u043e\u043b\u044c\u0448 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u043a\u043b 1, 14; 5, 14; 1 \u0426\u0456\u043c 6, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0440\u0430\u0437\u0432\u0430\u0436\u044b\u045e \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u0434\u0437\u0435\u044e\u0446\u0446\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c: \u0456 \u0432\u043e\u0441\u044c, \u0443\u0441\u0435 &ndash; \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u044b\u0439\u0448\u0430\u045e \u0433\u043e\u043b\u044b\u043c \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456, \u0442\u0430\u043a \u0456 \u0430\u0434\u044b\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0437\u0430\u0431\u044f\u0440\u044d \u0437 \u0441\u0430\u0431\u043e\u0439 \u043d\u0456\u0447\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u043c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u043d\u0435\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u044b\u0439\u0448\u0430\u045e \u0433\u043e\u043b\u044b\u043c \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456, \u0442\u0430\u043a \u0456 \u0430\u0434\u044b\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0437\u0430\u0431\u044f\u0440\u044d \u0437 \u0441\u0430\u0431\u043e\u0439 \u043d\u0456\u0447\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"72","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&nbsp;<span style=\"color: #ff0000;\">2, 1-3. 12-26<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0440\u0430\u0441\u043a\u043e\u0448\u044b \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &laquo;\u0406\u0434\u0437\u0456 \u0436, \u0432\u044b\u043f\u0440\u0430\u0431\u0443\u0439 \u0441\u044f\u0431\u0435 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e, \u0441\u043f\u0430\u0437\u043d\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435&raquo;. \u0406 \u0432\u043e\u0441\u044c, \u0433\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u041f\u0440\u0430 \u0441\u043c\u0435\u0445 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u043b\u0443\u043f\u043e\u0442\u0430&raquo;, \u0430 \u043f\u0440\u0430 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c: &laquo;\u0428\u0442\u043e \u0434\u0430\u0435 \u044f\u043d\u0430?&raquo; \u042f \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u0448\u044b\u0446\u044c \u0432\u0456\u043d\u043e\u043c \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0451, \u0430 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0451 \u0432\u0435\u0441\u0446\u0456 \u0434\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0456 \u0430\u0434\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0431\u0430\u0447\u0443, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u043d\u044b \u0440\u043e\u0431\u044f\u0446\u044c \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u044f, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430 \u0456 \u0433\u043b\u0443\u043f\u043e\u0442\u0443, \u0431\u043e \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u044f\u0448\u0447\u044d \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u044f, \u0437\u0432\u044b\u0448 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0436\u043e \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430? \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f, \u0448\u0442\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043c\u0430\u0435 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0433\u043b\u0443\u043f\u043e\u0442\u0430\u044e, \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0430\u0435 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0446\u0435\u043c\u0440\u0430\u0439. \u0423 \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435 \u044f\u0433\u043e\u043d\u0430\u0439, \u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b. \u0406 \u043f\u0430\u0437\u043d\u0430\u045e \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0430\u0434\u0437\u0456\u043d \u043b\u0451\u0441 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u0456\u0445 \u0443\u0441\u0456\u0445. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &laquo;\u0428\u0442\u043e \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430, \u0442\u043e\u0435 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u0456 \u043c\u044f\u043d\u0435, \u0442\u043e \u044f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0437 \u043c\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456?&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0411\u043e \u043c\u0443\u0434\u0440\u0430\u0433\u0430, \u044f\u043a \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430; \u0443 \u0434\u043d\u0456, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c, \u0443\u0441\u0451 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u044b\u0442\u0430. \u0406 \u044f\u043a \u043f\u0430\u043c\u0440\u044d \u043c\u0443\u0434\u0440\u044b, \u0442\u0430\u043a \u043f\u0430\u043c\u0440\u044d \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b. \u0406 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u044f \u0436\u044b\u0446\u0446\u0451, \u0431\u043e \u043b\u0456\u0445\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0456 \u043a\u043e\u0436\u043d\u044b \u0447\u044b\u043d, \u0448\u0442\u043e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c, \u0431\u043e \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443. \u0406 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u044f \u045e\u0441\u044e \u043f\u0440\u0430\u0446\u0443 \u0441\u0432\u0430\u044e, \u0448\u0442\u043e \u044f \u0440\u0430\u0431\u0456\u045e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c, \u0431\u043e \u044f \u043f\u0430\u043a\u0456\u043d\u0443 \u044f\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f \u043c\u044f\u043d\u0435. \u0406 \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435, \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u043c\u0443\u0434\u0440\u044b \u0446\u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b? \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0432\u044b\u043d\u0456\u043a\u0430\u043c\u0456 \u043f\u0440\u0430\u0446\u044b \u043c\u0430\u0451\u0439, \u044f\u043a\u0443\u044e \u044f \u0440\u0430\u0431\u0456\u045e \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u044f\u0431\u0435 \u043c\u0443\u0434\u0440\u044b\u043c \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u0413\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0406 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0440\u043e\u0441\u043f\u0430\u0447 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u0441\u0451\u0439 \u043f\u0440\u0430\u0446\u044b, \u044f\u043a\u0443\u044e \u044f \u0440\u0430\u0431\u0456\u045e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u0432\u0430\u0435, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u0430\u0446\u0443\u0435 \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0432\u0435\u0434\u0430\u043d\u043d\u0435\u043c \u0456 \u045e\u043c\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u043d\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u043b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0442\u044b\u043c \u043d\u0435 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e. \u0406 \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u0436 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0430\u0434 \u0443\u0441\u0451\u0439 \u044f\u0433\u043e \u043f\u0440\u0430\u0446\u044b \u0456 \u043a\u043b\u043e\u043f\u0430\u0442\u0443 \u0441\u044d\u0440\u0446\u0430, \u0437 \u044f\u043a\u0456\u043c\u0456 \u0451\u043d \u043f\u0440\u0430\u0446\u0443\u0435 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c? \u0411\u043e \u045e\u0441\u0435 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u043a\u0443\u0442\u044b, \u0456 \u0441\u043c\u0443\u0442\u0430\u043a &ndash; \u043f\u0440\u0430\u0446\u0430 \u044f\u0433\u043e, \u043d\u0430\u0432\u0430\u0442 \u0443\u043d\u0430\u0447\u044b \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u043c\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. \u0406 \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a \u0435\u0441\u0446\u0456 \u0434\u044b \u043f\u0456\u0446\u044c \u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0446\u044c \u0434\u0443\u0448\u044b \u0441\u0432\u0430\u0451\u0439 \u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0437 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u044d\u0442\u0430 \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u044f\u043d\u043e \u0437 \u0440\u0443\u043a\u0456 \u0411\u043e\u0433\u0430. \u0411\u043e \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0435\u0441\u0446\u0456 \u0430\u043b\u044c\u0431\u043e \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u043c\u0435\u0446\u044c \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u042f\u0433\u043e? \u0411\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u045e \u0432\u0430\u0447\u0430\u0445 \u042f\u0433\u043e, \u0401\u043d \u0434\u0430\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0432\u0435\u0434\u044b \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0443 \u0434\u0430\u045e \u043a\u043b\u043e\u043f\u0430\u0442 \u0437\u0431\u0456\u0440\u0430\u0446\u044c, \u043a\u0430\u0431 \u0441\u0430\u0431\u0440\u0430\u045e \u0456 \u0430\u0434\u0434\u0430\u045e \u0434\u043e\u0431\u0440\u0430\u043c\u0443 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u0413\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u043a\u043b 2, 26; 1 \u0426\u0456\u043c 6, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u045e \u0432\u0430\u0447\u0430\u0445 \u0411\u043e\u0433\u0430, \u0401\u043d \u0434\u0430\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0432\u0435\u0434\u044b \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0443 \u0434\u0430\u045e \u043a\u043b\u043e\u043f\u0430\u0442 \u0437\u0431\u0456\u0440\u0430\u0446\u044c, \u043a\u0430\u0431 \u0441\u0430\u0431\u0440\u0430\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u043a\u043e\u0440\u0430\u043d\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0433\u0440\u043e\u0448\u0430\u0439, \u0443 \u043f\u0430\u0433\u043e\u043d\u0456 \u0437\u0430 \u044f\u043a\u0456\u043c\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u0434\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u043f\u0430\u043a\u0443\u0442\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u043f\u0430\u043d\u043d\u0435 \u0432\u0435\u0442\u0440\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"73","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&nbsp;<span style=\"color: #ff0000;\">3, 1-22&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0420\u043e\u0437\u043d\u044b \u0447\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441, \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u043c\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c: \u0447\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0456 \u0447\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c; \u0447\u0430\u0441 \u0441\u0430\u0434\u0436\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u0437\u0431\u0456\u0440\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u043b\u0456; \u0447\u0430\u0441 \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u043b\u044f\u0447\u044b\u0446\u044c; \u0447\u0430\u0441 \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c; \u0447\u0430\u0441 \u043f\u043b\u0430\u043a\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u0441\u043c\u044f\u044f\u0446\u0446\u0430; \u0447\u0430\u0441 \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u043f\u043b\u044f\u0441\u0430\u0446\u044c; \u0447\u0430\u0441 \u0440\u0430\u0441\u043a\u0456\u0434\u0432\u0430\u0446\u044c \u043a\u0430\u043c\u044f\u043d\u0456 \u0456 \u0447\u0430\u0441 \u0456\u0445 \u0437\u0431\u0456\u0440\u0430\u0446\u044c; \u0447\u0430\u0441 \u0430\u0431\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u0456 \u0447\u0430\u0441 \u0443\u0445\u0456\u043b\u044f\u0446\u0446\u0430 \u0430\u0434 \u0430\u0431\u0434\u044b\u043c\u043a\u0430\u045e; \u0447\u0430\u0441 \u0448\u0443\u043a\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u0433\u0443\u0431\u043b\u044f\u0446\u044c; \u0447\u0430\u0441 \u0437\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u0432\u044b\u043a\u0456\u0434\u0430\u0446\u044c; \u0447\u0430\u0441 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0446\u044c \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0456 \u0447\u0430\u0441 \u0437\u0430\u0448\u044b\u0432\u0430\u0446\u044c; \u0447\u0430\u0441 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c; \u0447\u0430\u0441 \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u0447\u0430\u0441 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u0446\u044c; \u0447\u0430\u0441 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u043c\u0456\u0440\u044b\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0443 \u0437 \u0442\u0430\u0433\u043e, \u043d\u0430\u0434 \u0447\u044b\u043c \u043f\u0440\u0430\u0446\u0443\u0435? \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0437\u0430\u043d\u044f\u0442\u043a\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u0411\u043e\u0433 \u0434\u0430\u045e \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u044f\u043c. \u0401\u043d \u0443\u0441\u0451 \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043e\u0431\u0440\u044b\u043c \u0443 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441; \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u045e \u0443 \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b, \u0430\u043b\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u045e\u0447\u044b\u043d\u0456\u045e \u0411\u043e\u0433 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430. \u042f \u043f\u0430\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0456\u043d\u0448\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u044f\u043a \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u045e \u0436\u044b\u0446\u0446\u0456 \u0441\u0432\u0430\u0456\u043c. \u0406 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u0435\u0441\u0446\u044c \u0456 \u043f&rsquo;\u0435, \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0433\u044d\u0442\u0430 \u0434\u0430\u0440 \u0411\u043e\u0436\u044b. \u042f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e: \u0443\u0441\u0451, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0411\u043e\u0433, \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0433\u044d\u0442\u0430 \u043d\u044f\u043c\u0430 \u0447\u0430\u0433\u043e \u0434\u0430\u0434\u0430\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u043d\u044f\u0446\u044c. \u0406 \u0411\u043e\u0433 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u0442\u0430\u043a, \u043a\u0430\u0431 \u042f\u0433\u043e \u0431\u0430\u044f\u043b\u0456\u0441\u044f. \u0422\u043e\u0435, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0443\u0436\u043e \u0431\u044b\u043b\u043e; \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0435 \u0431\u044b\u0446\u044c, \u0443\u0436\u043e \u0451\u0441\u0446\u044c; \u0456 \u0411\u043e\u0433 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0448\u0447\u044d \u044f \u0431\u0430\u0447\u044b\u045e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c \u043c\u0435\u0441\u0446\u0430 \u0441\u0443\u0434\u0430, \u0430 \u0442\u0430\u043c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435; \u043c\u0435\u0441\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043c \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &laquo;\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0411\u043e\u0433, \u0431\u043e \u0451\u0441\u0446\u044c \u0447\u0430\u0441 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b \u045e\u0447\u044b\u043d\u0430\u043a&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &laquo;\u0428\u0442\u043e \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445, \u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u043f\u0430 \u0441\u0430\u0431\u0435 \u0436\u044b\u0432\u0451\u043b\u044b. \u0411\u043e \u043b\u0451\u0441 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0456 \u043b\u0451\u0441 \u0436\u044b\u0432\u0451\u043b\u044b \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u044b: \u044f\u043a \u0430\u0434\u043d\u044b\u044f \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u0434\u0440\u0443\u0433\u0456\u044f; \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445 \u0443\u0441\u0435 \u043c\u0430\u044e\u0446\u044c; \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u0430\u0435 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043d\u0430\u0434 \u0436\u044b\u0432\u0451\u043b\u0430\u044e, \u0431\u043e \u045e\u0441\u0451 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0423\u0441\u0451 \u0456\u0434\u0437\u0435 \u045e \u0430\u0434\u043d\u043e \u043c\u0435\u0441\u0446\u0430; \u0443\u0441\u0451 \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u0437 \u043f\u044b\u043b\u0443, \u0456 \u045e\u0441\u0451 \u0430\u0431\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u043f\u044b\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0432\u0435\u0434\u0430\u0435, \u0446\u0456 \u0434\u0443\u0445 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0433\u0430\u0440\u0443, \u0456 \u0446\u0456 \u0434\u0443\u0445 \u0436\u044b\u0432\u0451\u043b\u044b \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u043d\u0456\u0437, \u0434\u0430 \u0437\u044f\u043c\u043b\u0456?&raquo; \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0446\u0435\u0448\u044b\u045e\u0441\u044f \u0437 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043b\u0451\u0441 \u044f\u0433\u043e; \u0431\u043e \u0445\u0442\u043e \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u044f\u0433\u043e \u043f\u0430\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041a\u0430\u0440 7, 29b. 31; \u042d\u043a\u043b 3, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u0441 \u043a\u0430\u0440\u043e\u0442\u043a\u0456; \u0442\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0451 \u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441, \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u043c\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"74","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&nbsp;<span style=\"color: #ff0000;\">5, 9 &ndash; 6, 8&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430, \u043d\u0435 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u0456\u043c; \u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u0406 \u0433\u044d\u0442\u0430 &ndash; \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u042f\u043a \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e, \u0442\u0430\u043a \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437&rsquo;\u044f\u0434\u0430\u0435 \u044f\u0433\u043e. \u0406 \u044f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u0456\u043a\u0443 \u044f\u0433\u043e, \u0445\u0456\u0431\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u044f\u0433\u043e \u0432\u0430\u0447\u044b\u043c\u0430 \u0441\u0432\u0430\u0456\u043c\u0456. \u0421\u0430\u043b\u043e\u0434\u043a\u0456 \u0441\u043e\u043d \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u0430 \u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0442\u0430\u0433\u043e, \u0446\u0456 \u043c\u0430\u043b\u0430 \u0437&rsquo;\u0435\u045e, \u0446\u0456 \u043c\u043d\u043e\u0433\u0430. \u0410 \u0437\u0430\u043c\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u0430\u0433\u0430 \u043d\u0435 \u0434\u0430\u0435 \u044f\u043c\u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0456 \u0441\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0431\u0430\u0447\u044b\u045e \u0446\u044f\u0436\u043a\u0443\u044e \u043d\u044f\u0434\u043e\u043b\u044e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c: \u0443\u043b\u0430\u0441\u043d\u0456\u043a \u0437\u0431\u0435\u0440\u0430\u0433\u0430\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0441\u0430\u0431\u0435 \u043d\u0430 \u0448\u043a\u043e\u0434\u0443. \u0411\u043e \u0437\u043d\u0456\u043a\u043b\u0430 \u0442\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u044f\u045e\u0434\u0430\u043b\u0430\u0433\u0430 \u045e\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u044f, \u0456 \u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u044f\u0433\u043e \u0441\u044b\u043d, \u0451\u043d \u0443\u0436\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u0436\u0430 \u044f\u043c\u0443. \u042f\u043a \u0432\u044b\u0439\u0448\u0430\u045e \u0451\u043d \u0433\u043e\u043b\u044b\u043c \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u0442\u0430\u043a \u0456 \u0430\u0434\u044b\u0434\u0437\u0435, \u044f\u043a \u043f\u0440\u044b\u0448\u043e\u045e; \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u043e\u0437\u044c\u043c\u0435 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0443\u0441\u044e \u043f\u0440\u0430\u0446\u0443 \u0441\u0432\u0430\u044e \u0437\u0434\u0430\u0431\u044b\u045e. \u0406 \u0433\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0446\u044f\u0436\u043a\u0430\u044f \u043d\u044f\u0434\u043e\u043b\u044f: \u0443\u0441\u0451, \u044f\u043a \u043f\u0440\u044b\u0439\u0448\u043b\u043e, \u0442\u0430\u043a \u0456 \u0430\u0434\u044b\u0434\u0437\u0435. \u0406 \u0448\u0442\u043e \u0437\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u044f\u043c\u0443 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0451\u043d \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u0430 \u0432\u0435\u0446\u0435\u0440? \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u044f\u0433\u043e \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0446\u0435\u043c\u0440\u0430\u0439. \u0411\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u0446\u0430, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0445\u0432\u0430\u0440\u043e\u0431\u0430\u044e \u0441\u0432\u0430\u0451\u0439 \u0456 \u0433\u043d\u0435\u0432\u0430\u043c. \u0412\u043e\u0441\u044c, \u0448\u0442\u043e \u044f \u045e\u0431\u0430\u0447\u044b\u045e: \u0434\u0430\u0431\u0440\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043c. \u041a\u0430\u0431 \u0435\u0441\u0446\u0456 \u0456 \u043f\u0456\u0446\u044c, \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0437\u0451\u043d \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u0434\u0430\u045e \u044f\u043c\u0443 \u0411\u043e\u0433, \u0431\u043e \u0433\u044d\u0442\u0430 \u044f\u0433\u043e\u043d\u044b \u043b\u0451\u0441. \u0406 \u043a\u0430\u043b\u0456 \u044f\u043a\u043e\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0411\u043e\u0433 \u0434\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c, \u0456 \u0434\u0430\u0435 \u0441\u0456\u043b\u0443 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c \u0456 \u043c\u0435\u0446\u044c \u0447\u0430\u0441\u0442\u043a\u0443 \u0441\u0432\u0430\u044e, \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0442\u043e \u0433\u044d\u0442\u0430 \u0434\u0430\u0440 \u0411\u043e\u0436\u044b. \u0411\u043e \u0451\u043d \u043d\u044f\u0434\u043e\u045e\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u0411\u043e\u0433 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u044f\u0433\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u043b\u0456\u0445\u0430, \u044f\u043a\u043e\u0435 \u044f \u0431\u0430\u0447\u044b\u045e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c: \u0446\u044f\u0436\u0430\u0440\u044b\u0446\u044c \u044f\u043d\u043e \u043d\u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0411\u043e\u0433 \u0434\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0456 \u0441\u043b\u0430\u0432\u0443, \u0456 \u043d\u0435 \u043c\u0430\u0435 \u044f\u0433\u043e \u0434\u0443\u0448\u0430 \u043d\u044f\u0441\u0442\u0430\u0447\u044b \u043d\u0456 \u045e \u0447\u044b\u043c, \u0447\u0430\u0433\u043e \u0431 \u0451\u043d \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u0430\u043b\u0435 \u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0435 \u044f\u043c\u0443 \u0441\u0456\u043b\u044b \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c, \u0456 \u0447\u0443\u0436\u044b\u043d\u0435\u0446 \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435. \u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430 \u0456 \u043b\u0456\u0445\u0430\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0441\u0442\u043e \u0434\u0437\u044f\u0446\u0435\u0439 \u0456 \u0436\u044b\u045e \u0448\u043c\u0430\u0442 \u0433\u0430\u0434\u043e\u045e, \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0456\u0441\u044f \u0431 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0430\u043b\u0435 \u0434\u0443\u0448\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u043d\u0435 \u0446\u0435\u0448\u044b\u043b\u0430\u0441\u044f \u0431 \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c \u0456 \u043d\u0435 \u043c\u0435\u045e \u0431\u044b \u0451\u043d \u043c\u0430\u0433\u0456\u043b\u044b, \u0442\u043e \u044f \u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u043c\u0451\u0440\u0442\u0432\u0430\u043c\u0443 \u043f\u043b\u043e\u0434\u0443 \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u044f\u043c\u0443. \u0411\u043e \u0451\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u0443, \u0456 \u045e \u0446\u0435\u043c\u0440\u044b \u0431\u0443\u0434\u0437\u0435 \u045e\u043a\u0440\u044b\u0442\u0430 \u0456\u043c\u044f \u044f\u0433\u043e\u043d\u0430\u0435. \u0401\u043d \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e \u0441\u043e\u043d\u0446\u0430 \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e. \u0406 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0433\u044d\u0442\u044b \u043f\u043b\u043e\u0434, \u0447\u044b\u043c \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0411\u043e \u043d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u0451\u043d \u0436\u044b\u045e \u0434\u0432\u043e\u0439\u0447\u044b \u0442\u044b\u0441\u044f\u0447\u0443 \u0433\u0430\u0434\u043e\u045e, \u0456 \u043d\u0435 \u043f\u0430\u0431\u0430\u0447\u044b\u045e \u0434\u0430\u0431\u0440\u0430, \u0446\u0456 \u043d\u0435 \u0456\u0434\u0437\u0435 \u0437 \u0443\u0441\u0456\u043c\u0456 \u045e \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u043c\u0435\u0441\u0446\u0430? \u0423\u0441\u044f \u043f\u0440\u0430\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0434\u043b\u044f \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u045e, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0430 \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u043d\u0430\u0434 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c, \u0456 \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u0435 \u044f\u043a \u0436\u044b\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0440\u044b\u043f 30, 8; \u041f\u0441 31 (30), 15\u0430. 16\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0445\u0456\u043b\u044f\u0439 \u0430\u0434 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u043f\u0430\u0434\u043c\u0430\u043d \u0456 \u0445\u043b\u0443\u0441\u043d\u044e <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0435 \u0434\u0430\u0432\u0430\u0439 \u043c\u043d\u0435 \u043d\u0456 \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0430\u043b\u0435 \u045e\u0434\u0437\u044f\u043b\u044f\u0439 \u043c\u043d\u0435 \u0445\u043b\u0435\u0431\u0430, \u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u043d\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435; \u0443 \u0422\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445 \u0434\u043d\u0456 \u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0435 \u0434\u0430\u0432\u0430\u0439 \u043c\u043d\u0435 \u043d\u0456 \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0430\u043b\u0435 \u045e\u0434\u0437\u044f\u043b\u044f\u0439 \u043c\u043d\u0435 \u0445\u043b\u0435\u0431\u0430, \u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"75","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&nbsp;<span style=\"color: #ff0000;\">6, 11 &ndash; 7, 28&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430 \u043c\u0443\u0434\u0440\u044b\u043c <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0435 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u042f\u043a\u0430\u044f \u0436 \u0443 \u0433\u044d\u0442\u044b\u043c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443? \u0411\u043e \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435 \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u0436\u044b\u0446\u0446\u0456? \u0423 \u043b\u0456\u043a\u0443 \u0434\u0437\u0451\u043d \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043d\u044b \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u044e\u0446\u044c \u044f\u043a \u0446\u0435\u043d\u044c. \u0406 \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c? \u0414\u043e\u0431\u0440\u0430\u0435 \u0456\u043c\u044f \u043b\u0435\u043f\u0448\u0430\u0435 \u0437\u0430 \u0434\u043e\u0431\u0440\u044b \u0430\u043b\u0435\u0439, \u0456 \u0434\u0437\u0435\u043d\u044c \u0441\u043c\u0435\u0440\u0446\u0456 &ndash; \u0437\u0430 \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u041b\u0435\u043f\u0448 \u0456\u0441\u0446\u0456 \u045e \u0434\u043e\u043c \u0436\u0430\u043b\u043e\u0431\u044b, \u0447\u044b\u043c \u0443 \u0434\u043e\u043c \u0433\u0430\u0441\u0446\u0456\u043d\u044b, \u0431\u043e \u0442\u0430\u043c \u043a\u0430\u043d\u0435\u0446 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u0436\u044b\u0432\u044b \u043d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u0433\u044d\u0442\u0430 \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0421\u043c\u0443\u0442\u0430\u043a \u043b\u0435\u043f\u0448\u044b \u0437\u0430 \u0441\u043c\u0435\u0445, \u0431\u043e \u045e \u043c\u0430\u0440\u043a\u043e\u0446\u0435 \u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u043e\u0431\u0440\u0430\u0435, \u0456 \u0441\u044d\u0440\u0446\u0430. \u0421\u044d\u0440\u0446\u0430 \u043c\u0443\u0434\u0440\u044b\u0445 \u0443 \u0434\u043e\u043c\u0435 \u0436\u0430\u043b\u043e\u0431\u044b, \u0430 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0443 \u0434\u043e\u043c\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u041b\u0435\u043f\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0434\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0456 \u043c\u0443\u0434\u0440\u0430\u0433\u0430, \u0447\u044b\u043c \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u0432\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445. \u0411\u043e \u0441\u043c\u0435\u0445 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430, \u044f\u043a \u0442\u0440\u044d\u0441\u043a \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0446\u044f\u0440\u043d\u043e\u0432\u0430\u0433\u0430 \u0433\u0430\u043b\u043b\u044f \u043f\u0430\u0434 \u043a\u0430\u0442\u043b\u043e\u043c. \u0406 \u0433\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0411\u043e \u045e\u0446\u0456\u0441\u043a \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u044f\u043c\u0443\u0434\u0440\u044b\u043c \u043c\u0443\u0434\u0440\u0430\u0433\u0430, \u0430 \u043f\u0430\u0434\u0430\u0440\u0443\u043d\u0430\u043a \u043f\u0441\u0443\u0435 \u0441\u044d\u0440\u0446\u0430. \u0417\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u043b\u0435\u043f\u0448\u0430\u0435 \u0437\u0430 \u044f\u0435 \u043f\u0430\u0447\u0430\u0442\u0430\u043a; \u043b\u0435\u043f\u0448 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0434\u0443\u0445, \u0447\u044b\u043c \u0434\u0443\u0445 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u0445\u0443\u0442\u043a\u0456\u043c \u0434\u0430 \u0433\u043d\u0435\u0432\u0443, \u0431\u043e \u0433\u043d\u0435\u045e \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445. \u041d\u0435 \u043f\u044b\u0442\u0430\u0439\u0441\u044f, \u0447\u0430\u043c\u0443 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u044f \u0434\u043d\u0456 \u043b\u0435\u043f\u0448\u044b\u044f \u0437\u0430 \u0433\u044d\u0442\u044b\u044f? \u0411\u043e \u043d\u0435 \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u043f\u044b\u0442\u0430\u0435\u0448\u0441\u044f \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043b\u0435\u043f\u0448\u0430\u044f \u0437\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u044f \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043e\u043d\u0446\u0430. \u0411\u043e \u045e \u0437\u0430\u0446\u0435\u043d\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0430\u0431\u0430\u0440\u043e\u043d\u0430, \u044f\u043a \u0456 \u045e \u0437\u0430\u0446\u0435\u043d\u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0432\u0435\u0434\u044b, \u0431\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0434\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u044f\u0435 \u043c\u0430\u0435. \u0413\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b! \u0425\u0442\u043e \u043c\u043e\u0436\u0430 \u0432\u044b\u043f\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0441\u043a\u0440\u044b\u0432\u0456\u045e? \u0423 \u0434\u0437\u0435\u043d\u044c \u0434\u043e\u0431\u0440\u044b \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0439 \u0437 \u0434\u0430\u0431\u0440\u0430, \u0430\u043b\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f \u0437\u0432\u0430\u0436\u0430\u0439: \u0456 \u0430\u0434\u043d\u043e, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0411\u043e\u0433; \u0456 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0456\u0447\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u044f \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u044f \u0431\u0430\u0447\u044b\u045e \u0443 \u0434\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456: \u044f\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0433\u0456\u043d\u0435 \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b \u0434\u0430\u043b\u0435\u0439 \u0436\u044b\u0432\u0435 \u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u0437\u0430\u043b\u0456\u0448\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430 \u043c\u0443\u0434\u0440\u044b\u043c. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u0430\u0431\u0435 \u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435? \u0410\u043b\u0435 \u043d\u0435 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0441\u044f \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u0430\u0431\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u043d\u0435 \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441?<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u0431\u0440\u0430, \u043a\u0430\u0431 \u0442\u044b \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0442\u0430\u0433\u043e \u043d\u0435 \u0437\u0434\u044b\u0439\u043c\u0430\u045e \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456, \u0431\u043e \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0440\u043e\u0431\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u043c \u0437\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u044f\u0440\u044b\u0445 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435. \u041d\u044f\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456 \u0431 \u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0431\u0440\u043e \u0456 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u045e. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u044f\u0440\u044b \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0447\u0443\u0446\u044c, \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u043e\u0439 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435. \u0411\u043e \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0456 \u0442\u044b \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u045e\u0441\u0451 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f: &laquo;\u0425\u0430\u0447\u0443 \u0431\u044b\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u043c&raquo;, \u0430\u043b\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043c\u044f\u043d\u0435. \u041d\u0435\u0434\u0430\u0441\u044f\u0433\u0430\u043b\u044c\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u0431\u044b\u043b\u043e, \u0456 \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u043c. \u0425\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0451, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c, \u0448\u0443\u043a\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u043e\u0442\u0430, \u0430 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c &ndash; \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430. \u0406 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u044f, \u0448\u0442\u043e \u0433\u043e\u0440\u0448 \u0437\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u0441\u044d\u0440\u0446\u0430 \u044f\u043a\u043e\u0439 \u043d\u0456\u0431\u044b \u0441\u0435\u0442\u043a\u0456 \u0456 \u043f\u0430\u0441\u0442\u043a\u0430, \u0430 \u0440\u0443\u043a\u0456, \u044f\u043a \u043a\u0430\u0439\u0434\u0430\u043d\u044b. \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443, \u0443\u0440\u0430\u0442\u0443\u0435\u0446\u0446\u0430 \u0430\u0434 \u044f\u0435, \u0430\u043b\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0431\u0443\u0434\u0437\u0435 \u0437\u043b\u043e\u045e\u043b\u0435\u043d\u044b \u0451\u0439. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0448\u0442\u043e \u044f \u0430\u0434\u043a\u0440\u044b\u045e, &ndash; \u043a\u0430\u0436\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, &ndash; \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u044e\u0447\u044b \u0430\u0434\u043d\u043e \u0437\u0430 \u0434\u0440\u0443\u0433\u0456\u043c, \u043a\u0430\u0431 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0430\u0434\u043a\u0430\u0437. \u0413\u044d\u0442\u0430\u0433\u0430 \u045e\u0441\u044f\u0433\u043e \u044f \u0448\u0443\u043a\u0430\u045e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043e\u045e. \u0421\u044f\u0440\u043e\u0434 \u0442\u044b\u0441\u044f\u0447\u044b \u044f \u0441\u0443\u0441\u0442\u0440\u044d\u045e \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u0443, \u0430\u043b\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u044f \u043d\u0435 \u0441\u0443\u0441\u0442\u0440\u044d\u045e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0443\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0440\u044b\u043f 20, 9; \u042d\u043a\u043b 7, 20; 1 \u042f\u043d 1, 8. 9<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u042f \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u044f \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u0433\u0440\u0430\u0445\u0443? <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456 \u0431 \u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0431\u0440\u043e \u0456 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443, \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0411\u043e\u0433, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456 \u0431 \u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0431\u0440\u043e \u0456 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"76","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&nbsp;<span style=\"color: #ff0000;\">8, 5 &ndash; 9, 10<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0446\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0437\u043b\u0430, \u0430 \u0441\u044d\u0440\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u0435 \u0447\u0430\u0441 \u0441\u0443\u0434\u0430. \u0414\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b \u0451\u0441\u0446\u044c \u0447\u0430\u0441 \u0441\u0443\u0434\u0430, \u0431\u043e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435. \u0401\u043d \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435, \u0456 \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u043c\u0443, \u044f\u043a \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435? \u041d\u044f\u043c\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0431 \u043c\u0435\u045e \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0434\u0443\u0445\u0430\u043c, \u043a\u0430\u0431 \u0443\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0433\u043e, \u0456 \u043d\u044f\u043c\u0430 \u043c\u043e\u0446\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u045e \u043d\u0430\u0434 \u0434\u043d\u0451\u043c \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u043d\u044f\u043c\u0430 \u0440\u0430\u0442\u0443\u043d\u043a\u0443 \u045e \u0433\u044d\u0442\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435, \u0456 \u0437\u043b\u043e \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u044f\u0433\u043e \u0447\u044b\u043d\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u0430\u0447\u044b\u045e, \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u0443 \u0441\u044d\u0440\u0446\u044b \u043c\u0430\u0456\u043c \u043f\u0440\u0430 \u045e\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u0448\u0442\u043e \u0434\u0437\u0435\u044e\u0446\u0446\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c, \u043f\u0440\u0430 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043d\u0430 \u0448\u043a\u043e\u0434\u0443 \u044f\u043c\u0443. \u042f \u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0445\u0430\u0432\u0430\u043b\u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445, \u0456 \u044f\u043a \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u0437 \u043c\u0435\u0441\u0446\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430, \u0456 \u0437\u0430\u0431\u044b\u043b\u0456\u0441\u044f \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0430\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u044f\u043d\u044b \u0440\u0430\u0431\u0456\u043b\u0456. \u0406 \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u044b\u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u0441\u0443\u0434 \u0437\u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0442\u0430\u043c\u0443 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u044d\u0440\u0446\u0430 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044e \u0434\u0430 \u0437\u043b\u0430. \u0406 \u0445\u043e\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0441\u0442\u043e \u0440\u0430\u0437\u043e\u045e \u0440\u043e\u0431\u0456\u0446\u044c \u0437\u043b\u043e, \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u0446\u0430 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0430\u0434\u043d\u0430\u043a \u044f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c. \u0410 \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043e\u0431\u0440\u0430, \u0456 \u043d\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0451\u043d \u0441\u0430\u0431\u0435 \u0434\u043d\u0456. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0446\u0435\u043d\u044c, \u0431\u043e \u043d\u0435 \u043c\u0430\u0435 \u0451\u043d \u0431\u043e\u044f\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456: \u0451\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u044f\u043a\u0456\u0445 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435 \u043b\u0451\u0441 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445, \u0456 \u0451\u0441\u0446\u044c \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f, \u044f\u043a\u0456\u0445 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435 \u043b\u0451\u0441 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445. \u0406 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: \u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0406 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e \u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0431\u043e \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c, \u044f\u043a \u0435\u0441\u0446\u0456, \u043f\u0456\u0446\u044c \u0434\u044b \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0431\u043e \u0433\u044d\u0442\u0430 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0437 \u0456\u043c \u0443 \u043f\u0440\u0430\u0446\u044b \u0434\u0437\u0451\u043d \u0436\u044b\u0446\u0446\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u044f\u043a\u0456\u044f \u0434\u0430\u045e \u044f\u043c\u0443 \u0411\u043e\u0433 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u042f \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0451 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0446\u044b, \u0448\u0442\u043e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0437-\u0437\u0430 \u044f\u043a\u0456\u0445 \u043d\u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u043d\u0456 \u045e\u043d\u0430\u0447\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0434\u0430\u0435 \u0441\u043d\u0443 \u0441\u0432\u0430\u0456\u043c \u0432\u0430\u0447\u0430\u043c. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u045e\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0411\u043e\u0433\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u0406 \u0445\u043e\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435. \u0422\u0430\u0434\u044b \u044f \u0441\u043a\u0430\u0437\u0430\u045e: \u043c\u0443\u0434\u0440\u044b \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0443\u0441\u0451 \u0442\u043e\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u044f \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0451, \u043a\u0430\u0431 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u043c\u0443\u0434\u0440\u044b\u044f, \u0456 \u043f\u0440\u0430\u0446\u0430 \u0456\u0445\u043d\u044f\u044f &ndash; \u0443 \u0440\u0443\u0446\u044d \u0411\u043e\u0436\u0430\u0439, \u044f\u043a \u043b\u044e\u0431\u043e\u045e, \u0442\u0430\u043a \u0456 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c. \u041d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u044f\u0433\u043e. \u0423\u0441\u0451 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445: \u0430\u0434\u043d\u0430 \u0434\u043e\u043b\u044f \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430, \u0456 \u0434\u043e\u0431\u0440\u0430\u0433\u0430, \u0456 \u0447\u044b\u0441\u0442\u0430\u0433\u0430, \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430, \u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u0434\u0430\u045e\u0446\u044b \u0456 \u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443, \u0443 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0435, \u0456 \u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u043f\u0440\u044b\u0441\u044f\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0437\u043b\u043e \u0432\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c, \u0431\u043e \u0434\u043e\u043b\u044f \u0430\u0434\u043d\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445, \u0456 \u0441\u044d\u0440\u0446\u0430 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0437\u043b\u043e\u043c \u0456 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u0436\u044b\u0446\u0446\u044f \u0456\u0445\u043d\u044f\u0433\u0430. \u0410 \u043f\u0430\u0441\u043b\u044f \u044f\u043d\u044b \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0410\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u043b\u0443\u0447\u0430\u043d\u044b \u0437 \u0443\u0441\u0456\u043c\u0456 \u0436\u044b\u0432\u044b\u043c\u0456, \u043c\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u044e, \u0431\u043e \u0434\u043b\u044f \u044f\u0433\u043e \u043b\u0435\u043f\u0448 \u0431\u044b\u0446\u044c \u0436\u044b\u0432\u044b\u043c \u0441\u0430\u0431\u0430\u043a\u0430\u043c, \u0447\u044b\u043c \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0456\u043b\u044c\u0432\u043e\u043c. \u0411\u043e \u0436\u044b\u0432\u044b\u044f \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u043c\u0440\u0443\u0446\u044c, \u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0456 \u044f\u043d\u044b \u045e\u0436\u043e \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b, \u0431\u043e \u045e \u0437\u0430\u0431\u044b\u0446\u0446\u0451 \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0456\u0445. \u0406\u0445\u043d\u044f\u044f \u043b\u044e\u0431\u043e\u045e, \u044f\u043a \u0456 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u044b \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c \u0456\u0445\u043d\u044f\u044f \u045e\u0436\u043e \u0437\u043d\u0456\u043a\u043b\u0456, \u0456 \u043d\u044f\u043c\u0430 \u045e\u0436\u043e \u0456\u0445 \u0443\u0434\u0437\u0435\u043b\u0443 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0456 \u045e \u0447\u044b\u043c, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u0422\u0430\u043c\u0443 \u0456\u0434\u0437\u0456, \u0435\u0448 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0445\u043b\u0435\u0431 \u0441\u0432\u043e\u0439 \u0456 \u043f\u0456 \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451 \u0437 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u045e\u0441\u0446\u0435\u0448\u044b\u045e\u0441\u044f \u0411\u043e\u0433 \u0442\u0432\u0430\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0442\u0432\u0430\u0451 \u0431\u0443\u0434\u0437\u0435 \u0431\u0435\u043b\u044b\u043c, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u0430\u043b\u0435\u044e \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u0422\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0439 \u0436\u044b\u0446\u0446\u0451 \u0437 \u0436\u043e\u043d\u043a\u0430\u044e, \u044f\u043a\u0443\u044e \u043b\u044e\u0431\u0456\u0448, \u0432\u0430 \u0443\u0441\u0435 \u0434\u043d\u0456 \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0442\u0432\u0430\u0439\u0433\u043e, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u0442\u0430\u0431\u0435 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u0423\u0441\u0435 \u0434\u043d\u0456 &ndash; \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u0442\u0430\u043a\u0456 \u043b\u0451\u0441 \u0442\u0432\u043e\u0439 \u0443 \u0436\u044b\u0446\u0446\u0456 \u0456 \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0440\u0430\u0446\u044b, \u044f\u043a\u0443\u044e \u0442\u044b \u0440\u043e\u0431\u0456\u0448 \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c. \u0423\u0441\u0451, \u0448\u0442\u043e \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0440\u0443\u043a\u0430 \u0442\u0432\u0430\u044f, \u043a\u0430\u0431 \u0440\u0430\u0431\u0456\u0446\u044c, \u0440\u0430\u0431\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0456\u043b\u044b \u0442\u0432\u0430\u0451\u0439, \u0431\u043e \u043d\u044f\u043c\u0430 \u043d\u0456 \u0440\u0430\u0431\u043e\u0442\u044b, \u043d\u0456 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f, \u043d\u0456 \u0432\u0435\u0434\u0430\u045e, \u043d\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u043a\u0443\u0434\u044b \u0442\u044b \u0456\u0434\u0437\u0435\u0448.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 2, 9-10; \u042d\u043a\u043b 8, 17\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u0447\u0430\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0442\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<span style=\"color: #ff0000;\"> *<\/span> \u041d\u0430\u043c \u0436\u0430 \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430, \u0431\u043e \u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0411\u043e\u0436\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0411\u043e\u0436\u044b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043c \u0436\u0430 \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430, \u0431\u043e \u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0411\u043e\u0436\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"77","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #000000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0443\u043c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u0421\u0430\u043b\u043e\u0434\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0432\u0430\u0447\u0430\u043c \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043e\u043d\u0446\u0430. \u041a\u0430\u043b\u0456 \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0448\u043c\u0430\u0442 \u0433\u0430\u0434\u043e\u045e, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u0433\u043e\u0434\u0430\u043c \u0456 \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u044f\u0442\u0430\u0435, \u0448\u0442\u043e \u0434\u0437\u0451\u043d \u043b\u0456\u0445\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0448\u043c\u0430\u0442. \u0423\u0441\u0451, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435, \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c!<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u0420\u0430\u0434\u0443\u0439\u0441\u044f, \u044e\u043d\u0430\u043a, \u0443 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u044e\u043d\u0430\u0446\u0442\u0432\u0430. \u0425\u0430\u0434\u0437\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u0430\u0447\u0430\u0446\u044c \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b. \u0422\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u0437\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0446\u044f\u0431\u0435 \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u043d\u0430 \u0441\u0443\u0434. \u0410\u0434\u0433\u0430\u043d\u044f\u0439 \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0434 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u0430\u0434\u0434\u0430\u043b\u044f\u0439 \u0437\u043b\u043e \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u0431\u043e \u044e\u043d\u0430\u0446\u0442\u0432\u0430 \u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u0434\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0456\u0441\u044f \u0433\u0430\u0434\u044b, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u0442\u044b \u0441\u043a\u0430\u0436\u0430\u0448: \u044f\u043d\u044b \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u043c\u043d\u0435. \u041f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0431\u043b\u044f\u043a\u043b\u0430 \u0441\u043e\u043d\u0446\u0430, \u0441\u0432\u044f\u0442\u043b\u043e, \u043c\u0435\u0441\u044f\u0446 \u0456 \u0437\u043e\u0440\u043a\u0456; \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0445\u043c\u0430\u0440\u044b \u043f\u0430\u0441\u043b\u044f \u0434\u0430\u0436\u0434\u0436\u0443. \u0422\u0430\u0434\u044b \u0437\u0430\u0434\u0440\u044b\u0436\u0430\u0446\u044c \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u0434\u043e\u043c\u0443 \u0456 \u0441\u0445\u0456\u043b\u044f\u0446\u0446\u0430 \u043c\u043e\u0446\u043d\u044b\u044f \u043c\u0443\u0436\u044b. \u0422\u0430\u0434\u044b \u043c\u043b\u044b\u043d\u0430\u0440\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0443\u0442\u043a\u0430 \u0441\u043f\u044b\u043d\u044f\u0446\u044c \u043f\u0440\u0430\u0446\u0443, \u0431\u043e \u0456\u0445 \u0441\u0442\u0430\u043d\u0435 \u043c\u0435\u043d\u0448, \u0456 \u0441\u043f\u0430\u0445\u043c\u0443\u0440\u043d\u0435\u044e\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u043f\u0440\u0430\u0437 \u0432\u043e\u043a\u043d\u044b. \u0422\u0430\u0434\u044b \u0437\u0430\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u0434\u0437\u0432\u0435\u0440\u044b \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u0443, \u0441\u0446\u0456\u0445\u043d\u0435 \u0448\u0443\u043c \u0436\u043e\u0440\u043d\u0430\u045e, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u043d\u0430 \u043a\u0440\u044b\u043a \u043f\u0442\u0443\u0448\u043a\u0456. \u0422\u0430\u0434\u044b \u0437\u0430\u043c\u043e\u045e\u043a\u043d\u0443\u0446\u044c \u0433\u0443\u043a\u0456 \u0441\u043f\u0435\u0432\u0443, \u0442\u0430\u0434\u044b \u043f\u0430\u0447\u043d\u0443\u0446\u044c \u0431\u0430\u044f\u0446\u0446\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u045e \u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u0441\u0442\u0440\u0430\u0445 \u043d\u0430 \u0434\u0430\u0440\u043e\u0437\u0435. \u0422\u0430\u0434\u044b \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u043c\u0456\u043d\u0434\u0430\u043b\u044c, \u043f\u0430\u0446\u044f\u0436\u044d\u0435 \u0441\u0430\u0440\u0430\u043d\u0447\u0430 \u0456 \u0440\u0430\u0441\u0441\u044b\u043f\u043b\u0435\u0446\u0446\u0430 \u043a\u0430\u043f\u0435\u0440\u0441. \u0410\u043b\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u0456 \u043f\u043b\u0430\u0447\u043a\u0456 \u045e\u0436\u043e \u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0430 \u0432\u0443\u043b\u0456\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0440\u0432\u0430\u045e\u0441\u044f \u0441\u0440\u044d\u0431\u043d\u044b \u0448\u043d\u0443\u0440, \u0456 \u043d\u0435 \u0440\u0430\u0437\u043b\u0430\u043c\u0430\u045e\u0441\u044f \u0437\u0430\u043b\u0430\u0442\u044b \u043a\u0443\u0431\u0430\u043a, \u0456 \u043d\u0435 \u0440\u0430\u0437\u0431\u0456\u045e\u0441\u044f \u0437\u0431\u0430\u043d \u043a\u0430\u043b\u044f \u0441\u0442\u0443\u0434\u043d\u0456, \u0456 \u0437\u043b\u0430\u043c\u0430\u043d\u0430\u0435 \u043a\u043e\u043b\u0430 \u043d\u0435 \u0437\u0432\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u043a\u0430\u043b\u043e\u0434\u0437\u0435\u0436. \u0422\u0430\u0434\u044b \u043f\u044b\u043b \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0437\u044f\u043c\u043b\u044e, \u0437 \u044f\u043a\u043e\u0439 \u043f\u0430\u045e\u0441\u0442\u0430\u045e, \u0430 \u0434\u0443\u0445 \u0430\u0434\u044b\u0434\u0437\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u044f\u0433\u043e \u0434\u0430\u045e. \u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044f\u045e, &ndash; \u0441\u043a\u0430\u0437\u0430\u045e \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, &ndash; \u0443\u0441\u0451 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u0410\u043f\u0440\u0430\u0447\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442 \u0431\u044b\u045e \u043c\u0443\u0434\u0440\u044b, \u0451\u043d \u0432\u0443\u0447\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0440\u043e\u0434. \u0421\u043b\u0443\u0445\u0430\u045e, \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0456 \u0441\u043a\u043b\u0430\u0434\u0430\u045e \u0448\u043c\u0430\u0442 \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e. \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442 \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u0440\u0430\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0433\u043e\u0434\u043d\u0430 \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u045e\u0434\u044b. \u0421\u043b\u043e\u0432\u044b \u043c\u0443\u0434\u0440\u044b\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0434\u0437\u0456\u0434\u0430\u045e, \u0430 \u0434\u0430 \u045e\u0431\u0456\u0442\u044b\u0445 \u043c\u043e\u0446\u043d\u0430 \u0446\u0432\u0456\u043a\u043e\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0437\u0431\u043e\u0440\u044b \u0456\u0445\u043d\u0456\u044f, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439, \u0441\u0446\u0435\u0440\u0430\u0436\u044b\u0441\u044f, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u043d\u044e \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u043a\u043d\u0456\u0433 \u043d\u044f\u043c\u0430 \u043a\u0430\u043d\u0446\u0430, \u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430\u0435 \u0432\u044b\u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0441\u0442\u0430\u043c\u043b\u044f\u0435 \u0446\u0435\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #000000;\"><\/span><span style=\"color: #000000;\">\u0412\u043e\u0441\u044c \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u043c\u043e\u0432\u044b, \u044f\u043a\u0443\u044e \u0442\u044b \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e: \u0431\u043e\u0439\u0441\u044f \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0431\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041a\u043e\u0436\u043d\u044b \u045e\u0447\u044b\u043d\u0430\u043a \u0411\u043e\u0433 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u043d\u0430 \u0441\u0443\u0434, \u0456 \u045e\u0441\u0451 \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435, \u0446\u0456 \u0431\u044b\u043b\u043e \u0434\u043e\u0431\u0440\u044b\u043c, \u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 71 (70), 17. 9\u0430; \u041f\u0441 16 (15), 11<\/span><br \/><span style=\"color: #000000;\"><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u0422\u044b \u0432\u0443\u0447\u044b\u045e \u043c\u044f\u043d\u0435 \u0437 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439, \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u044f \u0446\u0443\u0434\u044b \u0422\u0432\u0430\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e.&nbsp;<span style=\"color: #ff0000;\">*<\/span> \u041d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0439 \u043c\u044f\u043d\u0435 \u045e \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456.<\/span><br \/><span style=\"color: #000000;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0434\u0430\u0440\u043e\u0433\u0443 \u0436\u044b\u0446\u0446\u044f \u043c\u043d\u0435 \u043f\u0430\u043a\u0430\u0436\u0430\u0448, \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u0432\u0435\u0447\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0426\u044f\u0431\u0435.<\/span><br \/><span style=\"color: #000000;\"><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0439 \u043c\u044f\u043d\u0435 \u045e \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"81","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">1, 1-22<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443 \u0437\u044f\u043c\u043b\u0456 \u0423\u0446, \u0456\u043c\u044f \u044f\u0433\u043e\u043d\u0430\u0435 \u0401\u045e. \u0413\u044d\u0442\u0430 \u0431\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b, \u044f\u043a\u0456 \u045e\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u0430\u0434 \u0437\u043b\u0430. \u0406 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u045e \u044f\u0433\u043e \u0441\u0435\u043c \u0441\u044b\u043d\u043e\u045e \u0456 \u0442\u0440\u044b \u0434\u0430\u0447\u043a\u0456. \u0406 \u043c\u0435\u045e \u0451\u043d \u0441\u0435\u043c \u0442\u044b\u0441\u044f\u0447 \u0430\u0432\u0435\u0447\u0430\u043a, \u0442\u0440\u044b \u0442\u044b\u0441\u044f\u0447\u044b \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u045e, \u043f\u044f\u0446\u044c\u0441\u043e\u0442 \u043f\u0430\u0440 \u0432\u0430\u043b\u043e\u045e, \u043f\u044f\u0446\u044c\u0441\u043e\u0442 \u0430\u0441\u043b\u0456\u0446 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442 \u0441\u043b\u0443\u0433\u0430\u045e. \u0406 \u0431\u044b\u045e \u0431\u0430\u0433\u0430\u0446\u0435\u0439\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0433\u044d\u0442\u044b \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0423\u0441\u0445\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u044b \u044f\u0433\u043e \u0437\u0431\u0456\u0440\u0430\u043b\u0456\u0441\u044f \u0456 \u043b\u0430\u0434\u0437\u0456\u043b\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u043f\u0430 \u0447\u0430\u0440\u0437\u0435 \u045e \u0434\u043e\u043c\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0456\u0445 \u0432\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0434\u0437\u0435\u043d\u044c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u044b\u043b\u0430\u043b\u0456 \u0456 \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u043b\u0456 \u0442\u0440\u043e\u0445 \u0441\u044f\u0441\u0446\u0451\u0440 \u0441\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0435\u043b\u0456 \u0456 \u043f\u0456\u043b\u0456 \u0437 \u0456\u043c\u0456. \u041a\u0430\u043b\u0456 \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u043d\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u044b, \u0401\u045e \u043a\u043b\u0456\u043a\u0430\u045e \u0456\u0445, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0430\u0431\u0440\u0430\u0434 \u0456\u0445 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f. \u0401\u043d \u0443\u0441\u0442\u0430\u0432\u0430\u045e \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0456\u0445, \u0431\u043e \u043a\u0430\u0437\u0430\u045e \u0401\u045e: &laquo;\u041c\u043e\u0436\u0430 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u044b\u043d\u044b \u043c\u0430\u0435 \u0456 \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u043b\u0456 \u0411\u043e\u0433\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445&raquo;. \u0422\u0430\u043a \u0401\u045e \u0440\u0430\u0431\u0456\u045e \u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u044d\u045e\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0441\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u0441\u0430\u0442\u0430\u043d\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0441\u0430\u0442\u0430\u043d\u0435: &laquo;\u0410\u0434\u043a\u0443\u043b\u044c \u0442\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e?&raquo; \u0421\u0430\u0442\u0430\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443: &laquo;\u042f \u0445\u0430\u0434\u0437\u0456\u045e \u043f\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0430\u0431\u044b\u0448\u043e\u045e \u044f\u0435&raquo;. \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u0442\u0430\u043d\u0435: &laquo;\u0426\u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u0442\u044b \u045e\u0432\u0430\u0433\u0443 \u043d\u0430 \u041c\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u0401\u0432\u0430, \u0431\u043e \u043d\u044f\u043c\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u044f\u0433\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456: \u0451\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u044f\u043a\u0456 \u0431\u0430\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0430 \u0456 \u045e\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u0430\u0434 \u0437\u043b\u0430&raquo;. \u0421\u0430\u0442\u0430\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443 \u045e \u0430\u0434\u043a\u0430\u0437: &laquo;\u0426\u0456 \u0436 \u0437\u0430\u0434\u0430\u0440\u043c\u0430 \u0431\u0430\u0456\u0446\u0446\u0430 \u0401\u045e \u0411\u043e\u0433\u0430? \u0426\u0456 \u043d\u0435 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u045e \u0422\u044b \u0437 \u0443\u0441\u0456\u0445 \u0431\u0430\u043a\u043e\u045e \u044f\u0433\u043e \u0456 \u0434\u043e\u043c \u044f\u0433\u043e\u043d\u044b, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u0430\u0435? \u0421\u043f\u0440\u0430\u0432\u0443 \u0440\u0443\u043a \u044f\u0433\u043e\u043d\u044b\u0445 \u0422\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u0456 \u043c\u0430\u0451\u043d\u0442\u0430\u043a \u044f\u0433\u043e\u043d\u044b \u043f\u0430\u0448\u044b\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0410\u043b\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u0434\u0430\u043a\u0440\u0430\u043d\u0456\u0441\u044f \u0434\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u0430\u0435, &ndash; \u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c?&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0441\u0430\u0442\u0430\u043d\u0435: &laquo;\u0412\u043e\u0441\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u0430\u0435, \u0443 \u0440\u0443\u0446\u044d \u0442\u0432\u0430\u0451\u0439, \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u044f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0439 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0451\u0439&raquo;. \u0406 \u0430\u0434\u044b\u0448\u043e\u045e \u0441\u0430\u0442\u0430\u043d\u0430 \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e\u0439\u0447\u044b, \u043a\u0430\u043b\u0456 \u0441\u044b\u043d\u044b \u0456 \u0434\u043e\u0447\u043a\u0456 \u0401\u0432\u0430 \u0435\u043b\u0456 \u0456 \u043f\u0456\u043b\u0456 \u0432\u0456\u043d\u043e \u045e \u0434\u043e\u043c\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u0435\u0446 \u0434\u0430 \u0401\u0432\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u0430\u043b\u044b \u0430\u0440\u0430\u043b\u0456, \u0430 \u0430\u0441\u043b\u0456\u0446\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456\u0441\u044f \u043a\u0430\u043b\u044f \u0456\u0445. \u0420\u0430\u043f\u0442\u0430\u043c \u043d\u0430\u043f\u0430\u043b\u0456 \u0441\u0430\u0432\u0435\u044f\u043d\u0435 \u0456 \u045e\u0437\u044f\u043b\u0456 \u0456\u0445, \u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0437\u0430\u0431\u0456\u043b\u0456 \u0432\u0430\u0441\u0442\u0440\u044b\u0451\u043c \u043c\u044f\u0447\u0430. \u0423\u0440\u0430\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u0430\u0434\u0437\u0456\u043d, \u043a\u0430\u0431 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0451\u043d \u044f\u0448\u0447\u044d \u0433\u0430\u0432\u0430\u0440\u044b\u045e, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0440\u0443\u0433\u0456 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0410\u0433\u043e\u043d\u044c \u0411\u043e\u0436\u044b \u045e\u043f\u0430\u045e \u0437 \u043d\u0435\u0431\u0430 \u0456 \u0441\u043f\u0430\u043b\u0456\u045e \u0430\u0432\u0435\u0447\u0430\u043a, \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0441\u043b\u0443\u0433\u0430\u045e. \u0423\u0440\u0430\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u0430\u0434\u0437\u0456\u043d, \u043a\u0430\u0431 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u044f\u0448\u0447\u044d \u0433\u0430\u0432\u0430\u0440\u044b\u045e, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456\u043d\u0448\u044b \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0430\u043b\u0434\u044d\u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0440\u044b \u0430\u0442\u0440\u0430\u0434\u044b \u0456 \u043d\u0430\u043f\u0430\u043b\u0456 \u043d\u0430 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u045e, \u0456 \u0437\u0430\u0431\u0440\u0430\u043b\u0456 \u0456\u0445, \u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0437\u0430\u0431\u0456\u043b\u0456 \u0432\u0430\u0441\u0442\u0440\u044b\u0451\u043c \u043c\u044f\u0447\u0430. \u0423\u0440\u0430\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u0430\u0434\u0437\u0456\u043d, \u043a\u0430\u0431 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0448\u0447\u044d \u0451\u043d \u043d\u0435 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u044f\u043a \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456\u043d\u0448\u044b \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0456 \u0434\u043e\u0447\u043a\u0456 \u0442\u0432\u0430\u0435 \u0435\u043b\u0456 \u0456 \u043f\u0456\u043b\u0456 \u0432\u0456\u043d\u043e \u045e \u0434\u043e\u043c\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430, \u0440\u0430\u043f\u0442\u0430\u043c \u043d\u0430\u043b\u044f\u0446\u0435\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0432\u0435\u0446\u0435\u0440 \u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0443 \u0447\u0430\u0442\u044b\u0440\u044b \u0432\u0443\u0433\u043b\u044b \u0434\u043e\u043c\u0443, \u0456 \u0451\u043d \u0443\u043f\u0430\u045e \u043d\u0430 \u0434\u0437\u044f\u0446\u0435\u0439, \u0456 \u044f\u043d\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456. \u0423\u0440\u0430\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u0430\u0434\u0437\u0456\u043d, \u043a\u0430\u0431 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0401\u045e \u0443\u0441\u0442\u0430\u045e \u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u0448\u0430\u0442\u044b \u0441\u0432\u0430\u0435, \u043f\u0430\u0441\u0442\u0440\u044b\u0433 \u0433\u0430\u043b\u0430\u0432\u0443 \u0456, \u0443\u043f\u0430\u045e\u0448\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u043e\u043b\u044b \u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u0456 \u0433\u043e\u043b\u044b \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0442\u0443\u0434\u044b. \u041f\u0430\u043d \u0434\u0430\u045e, \u0456 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo;.<br \/>\u0412\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0401\u045e \u0456 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 2, 10b; 1, 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c? <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d \u0434\u0430\u045e, \u0456 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u043e\u043b\u044b \u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u0456 \u0433\u043e\u043b\u044b \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0442\u0443\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0434\u0430\u045e, \u0456 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"82","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">2, 1-13<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u043a\u0430\u0436\u043e\u043d\u0430\u0433\u0430 \u0401\u0432\u0430 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0440\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e\u0439\u0447\u044b, \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0441\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u0406 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0430\u0442\u0430\u043d\u0430, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u0406 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u041f\u0430\u043d \u0443 \u0441\u0430\u0442\u0430\u043d\u044b: &laquo;\u0410\u0434\u043a\u0443\u043b\u044c \u0442\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e?&raquo; \u0421\u0430\u0442\u0430\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443: &laquo;\u0412\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u045e \u044f \u043f\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0430\u0431\u044b\u0448\u043e\u045e \u044f\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0437\u0430\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0441\u0430\u0442\u0430\u043d\u044b: &laquo;\u0426\u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u0442\u044b \u045e\u0432\u0430\u0433\u0443 \u043d\u0430 \u0441\u043b\u0443\u0433\u0443 \u043c\u0430\u0439\u0433\u043e \u0401\u0432\u0430? \u0411\u043e \u043d\u044f\u043c\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0442\u0430\u043a\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a \u0451\u043d, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u045e\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0437\u043b\u0430. \u0422\u0440\u044b\u0432\u0430\u0435 \u0451\u043d \u0443 \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456, \u0445\u043e\u0446\u044c \u0442\u044b \u0441\u0445\u0456\u043b\u0456\u045e \u041c\u044f\u043d\u0435, \u043a\u0430\u0431 \u042f \u043d\u0456\u0448\u0447\u044b\u045e \u044f\u0433\u043e \u0431\u0435\u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b&raquo;. \u0421\u0430\u0442\u0430\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443: &laquo;\u0428\u0442\u043e\u0441\u044c\u0446\u0456 \u0437\u0430 \u0448\u0442\u043e\u0441\u044c\u0446\u0456; \u0443\u0441\u0451, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u0430\u0435, \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0437\u0430 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451. \u0410\u043b\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u045e\u0434\u0430\u0440 \u0443 \u044f\u0433\u043e\u043d\u044b\u044f \u043a\u043e\u0441\u0442\u043a\u0456 \u0456 \u0446\u0435\u043b\u0430, \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u0422\u0430\u0431\u0435?&raquo; \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u0442\u0430\u043d\u0435: &laquo;\u0412\u043e\u0441\u044c \u0451\u043d \u0443 \u0440\u0443\u0446\u044d \u0442\u0432\u0430\u0451\u0439, \u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0446\u0446\u0451 \u044f\u0433\u043e\u043d\u0430\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u0439!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u044b\u0448\u043e\u045e \u0441\u0430\u0442\u0430\u043d\u0430 \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430 \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0401\u0432\u0430 \u043b\u044e\u0442\u0430\u044e \u043f\u0440\u0430\u043a\u0430\u0437\u0430\u044e \u0430\u0434 \u0441\u0442\u0443\u043f\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0439 \u043d\u0430\u0433\u0456 \u0434\u0430 \u043c\u0430\u043a\u0430\u045e\u043a\u0456 \u0433\u0430\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439. \u0422\u0430\u0434\u044b \u0401\u045e \u0443\u0437\u044f\u045e \u0447\u0430\u0440\u0430\u043f\u043e\u043a, \u043a\u0430\u0431 \u0441\u043a\u0440\u044d\u0431\u0446\u0456\u0441\u044f \u0456\u043c, \u0456 \u0441\u0435\u045e \u0443 \u043f\u043e\u043f\u0435\u043b. \u0410 \u0436\u043e\u043d\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u0422\u044b \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0431\u0443\u0434\u0437\u0435\u0448 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439? \u0417\u0433\u0430\u043d\u044c \u0411\u043e\u0433\u0430 \u0456 \u043f\u0430\u043c\u0440\u044b!&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u0422\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0448, \u044f\u043a \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u044f. \u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c?&raquo; \u0412\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0401\u045e \u0443 \u0441\u043b\u043e\u0432\u0430\u0445 \u0441\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0447\u0443\u043b\u0456 \u0442\u0440\u043e\u0435 \u0441\u044f\u0431\u0440\u043e\u045e \u0401\u0432\u0430 \u043f\u0440\u0430 \u045e\u0441\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0456 \u044f\u0433\u043e, \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u043a\u043e\u0436\u043d\u044b \u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430: \u042d\u043b\u0456\u0444\u0430\u0437 \u0437 \u0422\u044d\u043c\u0430\u043d\u0430, \u0411\u0456\u043b\u0434\u0430\u0434 \u0437 \u0428\u0443\u0430\u0445\u0430 \u0456 \u0421\u0430\u0444\u0430\u0440 \u0437 \u041d\u0430\u0430\u043c\u044b. \u042f\u043d\u044b \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u0439\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u044f\u043c\u0443, \u0456 \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0437\u0434\u0430\u043b\u0451\u043a \u0443\u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u0433\u043e, \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456. \u0423\u0437\u043d\u044f\u043b\u0456 \u043a\u0440\u044b\u043a \u0456 \u043f\u043b\u0430\u043a\u0430\u043b\u0456. \u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451, \u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043f\u044b\u043b \u043d\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0441\u0432\u0430\u0451\u044e \u043f\u0430\u0434 \u043d\u0435\u0431\u0430. \u0421\u044f\u0434\u0437\u0435\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u0435\u043c \u0434\u0437\u0451\u043d \u0456 \u0441\u0435\u043c \u043d\u0430\u0447\u044d\u0439, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u044f\u0433\u043e \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430, \u0431\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 38 (37), 2\u0430. 3\u0430. 4\u0430. 12\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0456 \u043d\u0435 \u043f\u0430\u043f\u0440\u0430\u043a\u0430\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435. \u0422\u0432\u0430\u0435 \u0441\u0442\u0440\u044d\u043b\u044b \u043f\u0440\u0430\u0446\u044f\u043b\u0456 \u043c\u044f\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u043c\u0430 \u0446\u044d\u043b\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c \u0437-\u0437\u0430 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b\u044f, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u043b\u0456 \u043c\u044f\u043d\u0435, \u0456 \u0441\u044f\u0431\u0440\u044b \u043c\u0430\u0435 \u0441\u0442\u0430\u044f\u0446\u044c \u0432\u043e\u0434\u0434\u0430\u043b\u044c \u0430\u0434 \u043c\u0430\u0451\u0439 \u0440\u0430\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u043c\u0430 \u0446\u044d\u043b\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c \u0437-\u0437\u0430 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_1_ID":"83","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">3, 1-26&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043a\u0430\u0440\u0433\u0430 \u0401\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0456 \u043f\u0440\u0430\u043a\u043b\u044f\u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u043e\u0439. \u0406 \u0442\u0430\u043a \u043f\u0430\u0447\u0430\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0401\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0437\u0433\u0456\u043d\u0435 \u0434\u0437\u0435\u043d\u044c, \u0443 \u044f\u043a\u0456 \u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u0456 \u043d\u043e\u0447, \u0443 \u044f\u043a\u0443\u044e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &ldquo;\u0417\u0430\u0447\u0430\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a!&rdquo; \u0414\u0437\u0435\u043d\u044c \u0442\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0446\u0435\u043c\u0440\u0430\u044e; \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u044f\u0433\u043e \u0411\u043e\u0433 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0437\u044f\u0435 \u043d\u0430\u0434 \u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u044f\u0433\u043e \u0446\u0435\u043c\u0440\u0430 \u0456 \u0437\u043c\u0440\u043e\u043a, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u043a\u0440\u044b\u0435 \u044f\u0433\u043e \u0445\u043c\u0430\u0440\u0430, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0443\u0436\u0430\u0435 \u044f\u0433\u043e \u0446\u0435\u043c\u0440\u0430 \u0434\u043d\u044f. \u041d\u044f\u0445\u0430\u0439 \u0442\u0443\u044e \u043d\u043e\u0447 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0437\u043c\u0440\u043e\u043a, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u044f\u0435 \u0441\u044f\u0440\u043e\u0434 \u0434\u0437\u0451\u043d \u0433\u043e\u0434\u0443, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u044f\u043d\u0430 \u045e \u043b\u0456\u043a \u043c\u0435\u0441\u044f\u0446\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0442\u0430\u044f \u043d\u043e\u0447 \u0431\u0443\u0434\u0437\u0435 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u0439, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u044f\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043a\u043b\u044f\u043d\u0443\u0446\u044c \u044f\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u043a\u043b\u0456\u043d\u0430\u0435 \u0434\u0437\u0435\u043d\u044c, \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0440\u0430\u0437\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u041b\u0435\u0432\u0456\u044f\u0442\u0430\u043d\u0430. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0446\u044c\u043c\u044f\u0446\u0446\u0430 \u0437\u0430\u0440\u0430\u043d\u043a\u0456, \u043d\u044f\u0445\u0430\u0439 \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u0447\u0430\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u0445 \u043f\u0440\u043e\u043c\u043d\u044f\u045e \u0441\u0432\u044f\u0442\u043b\u0430. \u0411\u043e \u043d\u0435 \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0430 \u044f\u043d\u0430 \u0431\u0440\u0430\u043c\u044b \u045e\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u0456 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043b\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0430\u0434 \u043c\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u043d\u0435 \u043f\u0430\u043c\u0451\u0440 \u044f, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u0443\u043b\u043e\u043d\u043d\u044f, \u0456 \u043d\u0435 \u0441\u043a\u0430\u043d\u0430\u045e, \u043a\u0430\u043b\u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u043d\u0443\u0442\u0440\u0430? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043c\u044f\u043d\u0435 \u043a\u0430\u043b\u0435\u043d\u0456, \u0430 \u0433\u0440\u0443\u0434\u0437\u0456 \u043a\u0430\u0440\u043c\u0456\u043b\u0456 \u043c\u044f\u043d\u0435? \u0426\u044f\u043f\u0435\u0440 \u0431\u044b \u0446\u0456\u0445\u0430 \u043b\u044f\u0436\u0430\u045e \u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u045e \u0443 \u0441\u043d\u0435 \u0441\u0432\u0430\u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0456 \u045e\u043b\u0430\u0434\u0430\u0440\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456\u044f \u045e\u0437\u043d\u043e\u0441\u0456\u043b\u0456 \u0441\u0430\u0431\u0435 \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u044b, \u0430\u0431\u043e \u0437 \u043a\u043d\u044f\u0437\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0456 \u0434\u0430\u043c\u044b \u0441\u0432\u0430\u0435 \u0441\u0440\u044d\u0431\u0440\u0430\u043c. \u0426\u0456, \u044f\u043a \u0432\u044b\u043a\u0456\u0434\u044b\u0448 \u0441\u0445\u0430\u0432\u0430\u043d\u044b, \u044f \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u045e \u0431\u044b; \u0446\u0456 \u044f\u043a \u0437\u0430\u0447\u0430\u0442\u044b\u044f, \u0448\u0442\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u0432\u044f\u0442\u043b\u0430. \u0422\u0430\u043c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0456 \u045e\u0436\u043e \u043d\u0435 \u043c\u0456\u0442\u0443\u0441\u044f\u0446\u0446\u0430, \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u044b\u044f \u0442\u0430\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u044e\u0446\u044c. \u0422\u0430\u043c \u0432\u044f\u0437\u044c\u043d\u0456 \u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u0431\u044f\u0441\u043f\u0435\u043a\u0430\u0439, \u043d\u0435 \u0447\u0443\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441\u0443 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0430. \u0422\u0430\u043c \u043c\u0430\u043b\u044b \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0440\u043e\u045e\u043d\u044b\u044f, \u0456 \u0441\u043b\u0443\u0433\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0430\u0434 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u043b\u043e, \u0430 \u0436\u044b\u0446\u0446\u0451 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u0433\u043e\u0440\u044b\u0447\u044b \u0434\u0443\u0448\u044d\u045e\u043d\u0430\u0439; \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430 \u044f\u043d\u0430 \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c; \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u045e \u0431\u044b \u044f\u0435 \u0430\u0445\u0432\u043e\u0442\u043d\u0435\u0439, \u0447\u044b\u043c \u0441\u043a\u0430\u0440\u0431; \u0445\u0442\u043e \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0431 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0441\u0446\u0435\u0448\u044b\u045e\u0441\u044f \u0431, \u0448\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043c\u0430\u0433\u0456\u043b\u0443? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u043e\u043c\u0443 \u0448\u043b\u044f\u0445 \u0437\u0430\u043a\u0440\u044b\u0442\u044b \u0456 \u044f\u043a\u043e\u0433\u0430 \u0411\u043e\u0433 \u0430\u0445\u0456\u043d\u0443\u045e \u0437\u043c\u0440\u043e\u043a\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043b\u0430\u0447 \u043c\u043e\u0439 \u0441\u0442\u0430\u045e \u043c\u0430\u0456\u043c \u0445\u043b\u0435\u0431\u0430\u043c, \u0430 \u0441\u0442\u043e\u0433\u043d \u043c\u043e\u0439 \u043b\u044c\u0435\u0446\u0446\u0430, \u044f\u043a \u0432\u0430\u0434\u0430, \u0431\u043e \u0430\u0445\u0430\u043f\u0456\u045e \u043c\u044f\u043d\u0435 \u0441\u0442\u0440\u0430\u0445, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0431\u0430\u044f\u045e\u0441\u044f, \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0430 \u043c\u044f\u043d\u0435. \u042f \u043d\u0435 \u043c\u0430\u044e \u043d\u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u043d\u0456 \u0446\u0456\u0448\u044b\u043d\u0456, \u043d\u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u043a\u0440\u0430\u043c\u044f \u043f\u0430\u043a\u0443\u0442.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 3, 24-26; 6, 13<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u043b\u0430\u0447 \u043c\u043e\u0439 \u0441\u0442\u0430\u045e \u043c\u0430\u0456\u043c \u0445\u043b\u0435\u0431\u0430\u043c, \u0430 \u0441\u0442\u043e\u0433\u043d \u043c\u043e\u0439 \u043b\u044c\u0435\u0446\u0446\u0430, \u044f\u043a \u0432\u0430\u0434\u0430, \u0431\u043e \u0430\u0445\u0430\u043f\u0456\u045e \u043c\u044f\u043d\u0435 \u0441\u0442\u0440\u0430\u0445, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0431\u0430\u044f\u045e\u0441\u044f, \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0430 \u043c\u044f\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0421\u0443\u0441\u0442\u0440\u044d\u045e \u043c\u044f\u043d\u0435 \u0433\u043d\u0435\u045e \u0422\u0432\u043e\u0439, \u041f\u0430\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u043c\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u0430 \u0440\u0430\u0442\u0443\u043d\u0430\u043a \u0430\u0434\u0434\u0430\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0443\u0441\u0442\u0440\u044d\u045e \u043c\u044f\u043d\u0435 \u0433\u043d\u0435\u045e \u0422\u0432\u043e\u0439, \u041f\u0430\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"84","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">7, 1-21<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e, \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0434\u043a\u0430\u0437 \u0401\u045e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0456\u0431\u0430 \u0436\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f, \u0430 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f &ndash; \u0434\u0437\u0451\u043d \u043d\u0430\u0439\u043c\u0456\u0442\u0430? \u042f\u043a \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a \u043f\u0440\u0430\u0433\u043d\u0435 \u0446\u0435\u043d\u044e \u0456 \u044f\u043a \u043d\u0430\u0439\u043c\u0456\u0442 \u043f\u0440\u0430\u0433\u043d\u0435 \u043f\u043b\u0430\u0442\u044b \u0441\u0432\u0430\u0451\u0439, \u0442\u0430\u043a \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043c\u0435\u0441\u044f\u0446\u044b \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456, \u0456 \u043d\u043e\u0447\u044b \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0430\u0434\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u043c\u043d\u0435. \u041a\u0430\u043b\u0456 \u044f \u043a\u043b\u0430\u0434\u0443\u0441\u044f, \u043a\u0430\u0436\u0443: &ldquo;\u041a\u0430\u043b\u0456 \u0436 \u044f \u045e\u0441\u0442\u0430\u043d\u0443?&rdquo; \u0410\u043b\u0435 \u0432\u0435\u0447\u0430\u0440 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430, \u0456 \u044f \u043d\u0435\u043f\u0430\u043a\u043e\u044e\u0441\u044f \u0430\u0436 \u0434\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0435\u043b\u0430 \u043c\u0430\u0451 \u043f\u0430\u043a\u0440\u044b\u0442\u0430 \u0447\u0430\u0440\u0432\u044f\u043a\u0430\u043c\u0456 \u0456 \u0441\u0442\u0440\u0443\u043f\u0430\u043c\u0456; \u0441\u043a\u0443\u0440\u0430 \u043c\u0430\u044f \u043b\u043e\u043f\u0430\u0435\u0446\u0446\u0430 \u0456 \u0433\u043d\u0430\u0456\u0446\u0446\u0430. \u0414\u043d\u0456 \u043c\u0430\u0435 \u0445\u0443\u0442\u0447\u044d\u0439\u0448\u044b\u044f \u0437\u0430 \u0442\u043a\u0430\u0446\u043a\u0456 \u0447\u0430\u045e\u043d\u043e\u043a, \u044f\u043d\u044b \u043c\u0456\u043d\u0430\u044e\u0446\u044c, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u0456. \u041f\u043e\u043c\u043d\u0456, \u0448\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0432\u0435\u0446\u0435\u0440, \u0456 \u0432\u043e\u0447\u044b \u043c\u0430\u0435 \u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u0430\u0441\u0446\u044f. \u041d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u0432\u043e\u043a\u0430, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u043b\u0430 \u043c\u044f\u043d\u0435; \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u043c\u044f\u043d\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435. \u042f\u043a \u0437\u043d\u0456\u043a\u0430\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0442\u0430\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430. \u041d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0451\u043d \u0443 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430. \u0422\u0430\u043c\u0443 \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0456 \u0431\u0443\u0434\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u043c \u0434\u0443\u0445\u0443 \u043c\u0430\u0456\u043c, \u0431\u0443\u0434\u0443 \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0433\u043e\u0440\u044b\u0447\u044b \u0434\u0443\u0448\u044b \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u044f \u043c\u043e\u0440\u0430 \u0446\u0456 \u043c\u0430\u0440\u0441\u043a\u0430\u044f \u043f\u0430\u0447\u0432\u0430\u0440\u0430, \u0448\u0442\u043e \u0422\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e \u0432\u0430\u0440\u0442\u0443? \u041a\u0430\u043b\u0456 \u044f \u0434\u0443\u043c\u0430\u044e: &ldquo;\u041b\u043e\u0436\u0430 \u043c\u0430\u0451 \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u043c\u044f\u043d\u0435, \u043b\u043e\u0436\u0430 \u043c\u0430\u0451 \u0437\u0430\u0431\u044f\u0440\u044d \u043c\u0430\u044e \u0433\u043e\u0440\u044b\u0447&rdquo;, \u0422\u044b \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0448 \u043c\u044f\u043d\u0435 \u0441\u043d\u0430\u043c\u0456, \u043f\u0443\u0436\u0430\u0435\u0448 \u043c\u044f\u043d\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u044f\u043c\u0456. \u041c\u0430\u044f \u0434\u0443\u0448\u0430 \u0432\u044b\u0431\u0440\u0430\u043b\u0430 \u0441\u0430\u043c\u0430\u0433\u0443\u0431\u0441\u0442\u0432\u0430, \u0430 \u043c\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456 &ndash; \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b, \u043d\u0435 \u0431\u0443\u0434\u0443 \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430. \u041f\u0430\u043a\u0456\u043d\u044c \u043c\u044f\u043d\u0435, \u0431\u043e \u043c\u0430\u0435 \u0434\u043d\u0456 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c. \u0425\u0442\u043e \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u0431 \u0422\u044b \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u045e \u044f\u0433\u043e \u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u045e \u043d\u0430 \u044f\u0433\u043e \u045e\u0432\u0430\u0433\u0443, \u043a\u0430\u0431 \u0448\u0442\u043e\u0440\u0430\u043d\u043a\u0443 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u045e \u044f\u0433\u043e \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u045e \u043a\u043e\u0436\u043d\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443? \u042f\u043a \u0434\u043e\u045e\u0433\u0430 \u0422\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448\u044c \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u043c\u044f\u043d\u0435, \u0434\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u0430\u0441\u0456 \u043c\u043d\u0435 \u0445\u043e\u0446\u044c \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u044e \u0441\u043b\u0456\u043d\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u0442\u043e \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u043e \u0410\u0445\u043e\u045e\u043d\u0456\u043a \u043b\u044e\u0434\u0437\u0435\u0439? \u041d\u0430\u0448\u0442\u043e \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u0448\u044d\u043d\u043d\u044e, \u0448\u0442\u043e \u044f \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0446\u044f\u0436\u0430\u0440\u0430\u043c? \u0427\u0430\u043c\u0443 \u0422\u044b \u043d\u0435 \u0434\u0430\u0440\u0443\u0435\u0448 \u043c\u043d\u0435 \u0433\u0440\u0430\u0445\u0443 \u0456 \u043d\u0435 \u0441\u0430\u0442\u0440\u044d\u0448 \u043c\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b? \u041d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u044f \u043b\u044f\u0433\u0443 \u045e \u0437\u044f\u043c\u043b\u044e, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u0443\u043a\u0430\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 7, 5. 7. 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u0435\u043b\u0430 \u043c\u0430\u0451 \u043f\u0430\u043a\u0440\u044b\u0442\u0430 \u0447\u0430\u0440\u0432\u044f\u043a\u0430\u043c\u0456 \u0456 \u0441\u0442\u0440\u0443\u043f\u0430\u043c\u0456; \u0441\u043a\u0443\u0440\u0430 \u043c\u0430\u044f \u043b\u043e\u043f\u0430\u0435\u0446\u0446\u0430 \u0456 \u0433\u043d\u0430\u0456\u0446\u0446\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u041f\u043e\u043c\u043d\u0456, \u041f\u0430\u043d\u0435, \u0448\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0432\u0435\u0446\u0435\u0440.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u043d\u0456 \u043c\u0430\u0435 \u0445\u0443\u0442\u0447\u044d\u0439\u0448\u044b\u044f \u0437\u0430 \u0442\u043a\u0430\u0446\u043a\u0456 \u0447\u0430\u045e\u043d\u043e\u043a, \u044f\u043d\u044b \u043c\u0456\u043d\u0430\u044e\u0446\u044c, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u043e\u043c\u043d\u0456, \u041f\u0430\u043d\u0435, \u0448\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0432\u0435\u0446\u0435\u0440.<\/p>\r\n"}, {"GCH_CH_1_ID":"85","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">11, 1-20<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0430\u0444\u0430\u0440 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u0444\u0430\u0440 \u041d\u0430\u0430\u043c\u0456\u0446\u044f\u043d\u0456\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0456\u0431\u0430 \u043d\u0430 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0435 \u043d\u044f\u043c\u0430 \u0430\u0434\u043a\u0430\u0437\u0443, \u0456 \u043b\u0430\u043f\u0430\u0442\u0443\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u043b\u0443\u0448\u043d\u0430\u0441\u0446\u044c? \u0426\u0456 \u0442\u0432\u0430\u0451 \u043f\u0443\u0441\u0442\u0430\u0441\u043b\u043e\u045e\u0435 \u043f\u0440\u044b\u043c\u0443\u0441\u0456\u0446\u044c \u043c\u0443\u0436\u043e\u045e \u0437\u043c\u043e\u045e\u043a\u043d\u0443\u0446\u044c? \u0410 \u043a\u0430\u043b\u0456 \u0442\u044b \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0435\u0448\u0441\u044f, \u0446\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0434\u044b \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u043f\u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u0446\u044f\u0431\u0435? \u0422\u044b \u043a\u0430\u0436\u0430\u0448: &ldquo;\u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f, \u044f \u0447\u044b\u0441\u0442\u044b \u045e \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445&rdquo;. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0431 \u0411\u043e\u0433 \u0437\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0431 \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0432\u043e\u0439 \u0440\u043e\u0437\u0443\u043c, \u0432\u0435\u0434\u0430\u045e \u0431\u044b, \u0448\u0442\u043e \u0411\u043e\u0433 \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0442\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043c\u043e\u0436\u0430\u0448 \u0442\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0411\u043e\u0433\u0430? \u0426\u0456 \u043c\u043e\u0436\u0430\u0448 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043c\u0435\u0436\u044b \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430? \u0401\u043d \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u043d\u044f\u0431\u0451\u0441\u044b, &ndash; \u0448\u0442\u043e \u0436 \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0437\u0440\u0430\u0431\u0456\u0446\u044c? \u0413\u043b\u044b\u0431\u0435\u0439\u0448\u044b \u0437\u0430 \u0430\u0434\u0445\u043b\u0430\u043d\u044c, &ndash; \u0448\u0442\u043e \u0436 \u043c\u043e\u0436\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c? \u0414\u0430\u045e\u0436\u044d\u0439\u0448\u0430\u044f \u0437\u0430 \u0437\u044f\u043c\u043b\u044e \u042f\u0433\u043e\u043d\u0430\u044f \u043c\u0435\u0440\u0430 \u0456 \u0448\u044b\u0440\u044d\u0439\u0448\u0430\u044f \u0437\u0430 \u043c\u043e\u0440\u0430. \u041a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0437\u0430\u043c\u044b\u043a\u0430\u0435 \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0456 \u0432\u044f\u0434\u0437\u0435 \u043d\u0430 \u0441\u0443\u0434. \u0406 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0446\u0456\u0432\u0456\u0446\u0446\u0430 \u042f\u043c\u0443? \u0401\u043d \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435 \u043b\u044e\u0434\u0437\u0435\u0439 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u0445, \u0456 \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0437\u043b\u043e, \u0446\u0456 \u0436 \u043f\u0430\u043a\u0456\u043d\u0435 \u044f\u0433\u043e \u0431\u0435\u0437 \u0443\u0432\u0430\u0433\u0456? \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0434\u0437\u0456\u043a\u0430\u0433\u0430 \u0430\u0441\u043b\u044f\u043d\u044f\u0446\u0456. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0432\u0430\u0442 \u043f\u0440\u0430\u0441\u0442\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u0448 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0451 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435\u0448 \u0434\u0430 \u042f\u0433\u043e \u0434\u0430\u043b\u043e\u043d\u0456 \u0441\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u0432\u044b\u0434\u0430\u043b\u0456\u0448 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0437 \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0451\u0439 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0448, \u043a\u0430\u0431 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0436\u044b\u043b\u0430 \u045e \u043d\u0430\u043c\u0451\u0442\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u0442\u0430\u0434\u044b \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0430\u0434\u044b\u043c\u0435\u0448 \u0431\u0435\u0437 \u0441\u043e\u0440\u0430\u043c\u0443 \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u043e\u0446\u043d\u044b\u043c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u0430\u044f\u0446\u0446\u0430. \u0422\u0430\u0434\u044b \u0437\u0430\u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a \u043f\u0440\u0430 \u0432\u0430\u0434\u0443, \u0448\u0442\u043e \u0441\u044b\u0448\u043b\u0430. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451, \u0430 \u0446\u0435\u043c\u0440\u0430 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u045e \u0440\u0430\u043d\u0456\u0446\u0443. \u0411\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b, \u0431\u043e \u0451\u0441\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f; \u0430\u0433\u043b\u0435\u0434\u0437\u0456\u0448\u0441\u044f \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u0446\u044c \u0443 \u0431\u044f\u0441\u043f\u0435\u0446\u044b. \u0411\u0443\u0434\u0437\u0435\u0448 \u043b\u044f\u0436\u0430\u0446\u044c, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435, \u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u0456\u0441\u043b\u0456\u0432\u0456\u0446\u044c \u0442\u0430\u0431\u0435. \u0410 \u0432\u043e\u0447\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e \u0430\u0441\u043b\u0430\u0431\u043d\u0443\u0446\u044c, \u0456 \u0434\u0430\u0440\u044d\u043c\u043d\u044b\u043c\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0456\u0445 \u0443\u0446\u0451\u043a\u0456, \u0430 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456\u0445\u043d\u044f\u0439 \u0431\u0443\u0434\u0437\u0435 \u0430\u043f\u043e\u0448\u043d\u044f\u0435 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 4, 8-9\u0430. 10<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u044f\u043b\u044f\u043a \u0443\u0446\u0456\u0441\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u044f. \u041c\u044b \u045e \u0440\u0430\u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0451\u043c\u0441\u044f \u0440\u043e\u0441\u043f\u0430\u0447\u044b. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0441\u0456\u043c \u0443 \u0446\u0435\u043b\u0435 \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0441\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0435 \u043d\u0430\u0448\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"86","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">12, 1-25<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 <\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0434\u043a\u0430\u0437 \u0401\u045e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0432\u044b \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u0456 \u0437 \u0432\u0430\u043c\u0456 \u043f\u0430\u043c\u0440\u044d \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c! \u0410\u043b\u0435 \u0456 \u044f \u043c\u0430\u044e \u0440\u043e\u0437\u0443\u043c, \u044f\u043a \u0432\u044b. \u042f \u043d\u0435 \u0433\u043e\u0440\u0448\u044b \u0437\u0430 \u0432\u0430\u0441. \u0406 \u0445\u0442\u043e \u0436 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0433\u044d\u0442\u0430\u0433\u0430? \u042f \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043c\u0435\u0448\u044b\u0448\u0447\u0430\u043c \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0441\u044f\u0431\u0440\u043e\u045e. \u041a\u0430\u043b\u0456 \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435, \u044f\u043d\u044b \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u044e\u0446\u0446\u0430 \u0437 \u043c\u044f\u043d\u0435, \u0445\u043e\u0446\u044c \u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b. &laquo;\u041f\u0430\u0433\u0430\u0440\u0434\u0430 \u0434\u043b\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u0433\u0430&raquo;, &ndash; \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0435 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b, \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u044b \u0442\u044b\u0445, \u0447\u044b\u0435 \u043d\u043e\u0433\u0456 \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u044e\u0446\u0446\u0430. \u0421\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u043d\u0443\u0435 \u045e \u043d\u0430\u043c\u0451\u0442\u0430\u0445 \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u0411\u043e\u0433\u0430, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0432\u0435\u0441\u0446\u0456 \u0411\u043e\u0433\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0441\u043f\u044b\u0442\u0430\u0439\u0441\u044f \u045e \u0436\u044b\u0432\u0451\u043b\u044b, \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435, \u0443 \u043f\u0442\u0443\u0448\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445, \u0456 \u0430\u0434\u043a\u0430\u0436\u0443\u0446\u044c \u0442\u0430\u0431\u0435; \u0430\u0431\u043e \u0437\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043f\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0440\u044b\u0431\u044b \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u0430\u0446\u044c \u0442\u0430\u0431\u0435. \u0425\u0442\u043e \u0437 \u0456\u0445 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u0433\u044d\u0442\u0430. \u0423 \u042f\u0433\u043e\u043d\u0430\u0439 \u0440\u0443\u0446\u044d \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u044f\u0433\u043e \u0456\u0441\u043d\u0430\u0433\u0430 \u0456 \u0434\u0443\u0445 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0426\u0456 \u0436 \u043d\u0435 \u0432\u0443\u0445\u0430 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u0456 \u0446\u0456 \u043d\u0435 \u044f\u0437\u044b\u043a \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u043c\u0430\u043a \u0435\u0436\u044b? \u0426\u0456 \u0436 \u043d\u044f\u043c\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0430\u0440\u0446\u0430\u045e? \u0426\u0456 \u0436 \u0434\u043e\u045e\u0433\u0456\u044f \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u043d\u0435 \u0432\u0443\u0447\u0430\u0446\u044c \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u043c\u043e\u0446; \u0443 \u042f\u0433\u043e \u043f\u0430\u0440\u0430\u0434\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u0401\u043d \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u0446\u044c, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0431\u0443\u0434\u0443\u0435; \u043a\u0430\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e. \u0401\u043d \u0441\u043f\u044b\u043d\u044f\u0435 \u0432\u043e\u0434\u044b, \u0456 \u045e\u0441\u0451 \u0441\u043e\u0445\u043d\u0435; \u0430 \u043a\u0430\u043b\u0456 \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0456\u0445, \u044f\u043d\u044b \u0437\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u0437\u044f\u043c\u043b\u044e. \u0423 \u042f\u0433\u043e \u0441\u0456\u043b\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430, \u042f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0448\u0443\u043a\u0430\u043d\u044b \u0456 \u0430\u0448\u0443\u043a\u0430\u043d\u0435\u0446. \u0401\u043d \u0431\u043b\u044b\u0442\u0430\u0435 \u0434\u0443\u043c\u043a\u0456 \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u045e \u0456 \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u0440\u043e\u0437\u0443\u043c\u0443. \u0401\u043d \u0440\u0430\u0441\u043f\u0430\u044f\u0441\u0432\u0430\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0437\u0432\u0430\u0435 \u0456\u0445 \u0441\u0446\u0451\u0433\u043d\u044b. \u0421\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u0440\u0430\u0437\u0432\u0430\u0433\u0456, \u0430 \u0432\u043e\u043b\u0430\u0442\u0430\u045e \u0432\u0430\u043b\u044f\u0435. \u0423 \u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u0445 \u0430\u0434\u0431\u0456\u0440\u0430\u0435 \u043c\u043e\u0432\u0443 \u0456 \u0441\u0442\u0430\u0440\u0446\u0430\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u0440\u043e\u0437\u0443\u043c\u0443. \u0410\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u043e\u0440\u0430\u043c\u0430\u043c \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u044b\u0445 \u0456 \u043f\u0430\u0441 \u0432\u043e\u043b\u0430\u0442\u0430\u045e \u0440\u0430\u0437\u0432\u044f\u0437\u0432\u0430\u0435. \u0412\u044b\u044f\u045e\u043b\u044f\u0435 \u045e\u043a\u0440\u044b\u0442\u0430\u0435 \u045e \u0446\u0435\u043c\u0440\u044b, \u0432\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435. \u0401\u043d \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u043c\u043e\u0446 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0432\u044b\u043d\u0456\u0448\u0447\u0430\u0435 \u0456\u0445, \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u0456 \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435. \u0410\u0434\u0431\u0456\u0440\u0430\u0435 \u0440\u043e\u0437\u0443\u043c \u0443 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u0437\u044f\u043c\u043b\u0456, \u0456 \u044f\u043d\u044b \u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u043f\u0430 \u0431\u0435\u0437\u0434\u0430\u0440\u043e\u0436\u0436\u044b. \u041d\u0430\u0432\u043e\u0431\u043c\u0430\u0446\u0430\u043a \u0445\u043e\u0434\u0437\u044f\u0446\u044c \u044f\u043d\u044b \u045e \u0446\u0435\u043c\u0440\u044b \u0431\u0435\u0437 \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0445\u0456\u0441\u0442\u0430\u044e\u0446\u0446\u0430, \u044f\u043a \u043f&rsquo;\u044f\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 12, 13. 14; 23, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u043c\u043e\u0446; \u0443 \u042f\u0433\u043e \u043f\u0430\u0440\u0430\u0434\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0401\u043d \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u0446\u044c, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0431\u0443\u0434\u0443\u0435; <span style=\"color: #ff0000;\">\/<\/span> \u043a\u0430\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0401\u043d \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0437\u043c\u044f\u043d\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u0401\u043d \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e &ndash; \u0432\u044b\u043a\u0430\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0401\u043d \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u0446\u044c, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0431\u0443\u0434\u0443\u0435; <span style=\"color: #ff0000;\">\/<\/span> \u043a\u0430\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_1_ID":"87","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">13, 13 &ndash; 14, 6<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u0443\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0442\u0430\u043a \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044f\u0431\u0440\u0430\u043c: &laquo;\u0417\u043c\u043e\u045e\u043a\u043d\u0456\u0446\u0435, \u044f \u0431\u0443\u0434\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0431 \u043d\u0456 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0430 \u043c\u044f\u043d\u0435. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u044f \u043a\u043b\u0430\u0434\u0443 \u0446\u0435\u043b\u0430 \u043c\u0430\u0451 \u043f\u0430\u043c\u0456\u0436 \u0441\u0432\u0430\u0456\u043c\u0456 \u0437\u0443\u0431\u0430\u043c\u0456, \u0430 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0431\u044f\u0440\u0443 \u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435? \u0412\u043e\u0441\u044c, \u0401\u043d \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u044f \u0431\u0443\u0434\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e. \u0411\u0443\u0434\u0443 \u0431\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u0441\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c. \u0406 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0440\u0430\u0442\u0443\u043d\u0430\u043a, \u0431\u043e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0432\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f. \u0412\u043e\u0441\u044c, \u044f \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0441\u0443\u0434\u043e\u0432\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0456 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0431\u0443\u0434\u0443 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b. \u0406 \u0445\u0442\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435? \u0422\u0430\u0434\u044b \u044f \u0437\u043c\u043e\u045e\u043a\u043d\u0443 \u0456 \u043f\u0430\u043c\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b \u043d\u0435 \u0440\u0430\u0431\u0456 \u0441\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0442\u0430\u0434\u044b \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435. \u0410\u0434\u0432\u044f\u0434\u0437\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0440\u0443\u043a\u0443 \u0422\u0432\u0430\u044e, \u0456 \u0436\u0430\u0445 \u0422\u0432\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u043c\u044f\u043d\u0435. \u041f\u0430\u043a\u043b\u0456\u0447, \u0456 \u044f \u0430\u0434\u043a\u0430\u0436\u0443, \u0430\u043b\u044c\u0431\u043e \u044f \u0431\u0443\u0434\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0430 \u0422\u044b \u0430\u0434\u043a\u0430\u0436\u044b \u043c\u043d\u0435. \u041a\u043e\u043b\u044c\u043a\u0456 \u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0456 \u0433\u0440\u0430\u0445\u043e\u045e? \u041f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u043c\u0430\u0451 \u0456 \u0433\u0440\u044d\u0445 \u043c\u043e\u0439. \u0427\u0430\u043c\u0443 \u0445\u0430\u0432\u0430\u0435\u0448 \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0456 \u043b\u0456\u0447\u044b\u0448 \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c? \u0426\u0456 \u0436 \u043b\u0456\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u043d\u044f\u0441\u0435 \u0432\u0435\u0446\u0435\u0440, \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c \u0456 \u0441\u0443\u0445\u0443\u044e \u0441\u0430\u043b\u043e\u043c\u0456\u043d\u0443 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c? \u0411\u043e \u0422\u044b \u0437\u0430\u043f\u0456\u0441\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0433\u043e\u0440\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0437\u0430\u043b\u0456\u0447\u044b\u045e \u0433\u0440\u0430\u0445\u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439. \u0417\u0432\u044f\u0437\u0430\u045e \u043f\u0443\u0442\u0430\u043c\u0456 \u043d\u043e\u0433\u0456 \u043c\u0430\u0435 \u0456 \u0441\u043e\u0447\u044b\u0448 \u0437\u0430 \u045e\u0441\u0456\u043c\u0456 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456 \u043c\u0430\u0456\u043c\u0456, \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0448 \u0441\u043b\u044f\u0434\u044b \u043d\u043e\u0433 \u043c\u0430\u0456\u0445. \u0410 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0440\u0430\u0441\u043f\u0430\u0434\u0430\u0435\u0446\u0446\u0430, \u044f\u043a \u0433\u043d\u0456\u043b\u043b\u0451, \u044f\u043a \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430, \u0441\u0442\u043e\u0447\u0430\u043d\u0430\u044f \u043c\u043e\u043b\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439, \u043d\u044f\u0448\u043c\u0430\u0442 \u0434\u0437\u0451\u043d, \u0430\u043b\u0435 \u043f\u043e\u045e\u043d\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e. \u041d\u0456\u0431\u044b \u043a\u0432\u0435\u0442\u043a\u0430 \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 \u0451\u043d \u0456 \u0432\u044f\u043d\u0435, \u043c\u0456\u043d\u0430\u0435, \u044f\u043a \u0446\u0435\u043d\u044c, \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0441\u043b\u0435\u0434\u0443. \u041d\u0430 \u044f\u0433\u043e \u0422\u044b \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u0448 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u0432\u044f\u0434\u0437\u0435\u0448 \u044f\u0433\u043e \u043d\u0430 \u0441\u0443\u0434 \u0437 \u0422\u0430\u0431\u043e\u044e? \u0425\u0442\u043e \u0436 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0447\u044b\u0441\u0442\u0430\u0435 \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430? \u041d\u0456\u0445\u0442\u043e. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0434\u043d\u0456 \u044f\u0433\u043e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b, \u0456 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u043c\u0435\u0441\u044f\u0446\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u044f\u0434\u043e\u043c\u0430 \u0422\u0430\u0431\u0435, \u0422\u044b \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u045e \u044f\u0433\u043e \u043c\u0435\u0436\u044b, \u044f\u043a\u0456\u0445 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456. \u0410\u0434\u0432\u044f\u0440\u043d\u0456 \u0430\u0434 \u044f\u0433\u043e \u0441\u0432\u043e\u0439 \u043f\u043e\u0437\u0456\u0440\u043a, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043f\u0430\u0447\u043d\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u044f\u043a \u043d\u0430\u0439\u043c\u0456\u0442, \u0434\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 13, 20. 21; \u043f\u0430\u0440. \u0415\u0440 10, 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u0443\u0434\u0443 \u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435. \u0410\u0434\u0432\u044f\u0434\u0437\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0440\u0443\u043a\u0443 \u0422\u0432\u0430\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0436\u0430\u0445 \u0422\u0432\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043a\u0430\u0440\u0430\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u043c\u0435\u0440\u044b, \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u043d\u0435\u0432\u0443, \u043a\u0430\u0431 \u044f \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0436\u0430\u0445 \u0422\u0432\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u043c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"91","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430 <span style=\"color: #ff0000;\">28, 1-28&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423 \u0441\u0440\u044d\u0431\u0440\u0430 \u0451\u0441\u0446\u044c \u0436\u044b\u043b\u0430, \u0456 \u045e \u0437\u043e\u043b\u0430\u0442\u0430 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u044f\u0433\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u044e\u0446\u044c. \u0416\u0430\u043b\u0435\u0437\u0430 \u0434\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437 \u0440\u0443\u0434\u044b \u0432\u044b\u043f\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0435\u0434\u0437\u044c. \u0426\u0435\u043c\u0440\u0430 \u043c\u0430\u0435 \u0441\u0432\u0430\u0435 \u043c\u0435\u0436\u044b, \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u044b \u044f\u0435 \u0437\u0430\u043a\u0443\u0442\u043e\u043a, \u0430\u0436 \u0434\u0430 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u0445 \u0443 \u0437\u043c\u0440\u043e\u043a\u0443. \u0412\u044b\u043a\u043e\u043f\u0432\u0430\u044e\u0446\u044c \u0448\u0430\u0445\u0442\u0443 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0436\u044b\u043b\u043b\u044f, \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u043d\u043e\u0433\u0456, \u0432\u0456\u0441\u044f\u0446\u044c \u0456 \u043a\u0430\u043b\u044b\u0448\u0443\u0446\u0446\u0430 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u044f\u043c\u043b\u044f, \u043d\u0430 \u044f\u043a\u043e\u0439 \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 \u0445\u043b\u0435\u0431, \u0443\u043d\u0443\u0442\u0440\u044b \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430 \u043d\u0456\u0431\u044b \u0430\u0433\u043d\u0451\u043c. \u041a\u0430\u043c\u044f\u043d\u0456 \u044f\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0444\u0456\u0440\u044b, \u0456 \u045e \u0451\u0439 &ndash; \u043f\u044f\u0441\u0447\u044b\u043d\u043a\u0456 \u0437\u043e\u043b\u0430\u0442\u0430. \u0412\u044b\u0442\u0430\u043f\u0442\u0430\u043d\u0430\u0439 \u0441\u0446\u0435\u0436\u043a\u0456 \u0442\u0443\u0434\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u0430\u044f \u043f\u0442\u0443\u0448\u043a\u0430, \u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430 \u044f\u0435 \u0432\u043e\u043a\u0430 \u044f\u0441\u0442\u0440\u0430\u0431\u0430. \u041d\u0435 \u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u043f\u0430 \u0451\u0439 \u0434\u0437\u0456\u043a\u0456\u044f \u0437\u0432\u044f\u0440\u044b, \u0456 \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0430 \u0451\u0439 \u043b\u0435\u045e. \u041f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u044f, \u0430\u0434 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u0432\u0430\u0440\u043e\u0447\u0430\u0435 \u0433\u043e\u0440\u044b. \u0423 \u0441\u043a\u0430\u043b\u0430\u0445 \u0432\u044b\u0441\u044f\u043a\u0430\u044e\u0446\u0446\u0430 \u0442\u0443\u043d\u044d\u043b\u0456, \u0456 \u045e\u0441\u0451 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u0435 \u0432\u043e\u043a\u0430. \u0421\u043f\u044b\u043d\u044f\u0435 \u043f\u0430\u0442\u043e\u043a\u0456 \u0440\u044d\u043a \u0456 \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0434\u0437\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0434\u0437\u0435 \u0436\u044b\u0432\u0435 \u0440\u043e\u0437\u0443\u043c? \u041d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u044f\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u0456, \u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u044f\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0436\u044b\u0432\u044b\u0445. \u0410\u0434\u0445\u043b\u0430\u043d\u044c \u043a\u0430\u0436\u0430: &ldquo;\u041d\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u044f\u043d\u0430&rdquo;, \u0430 \u043c\u043e\u0440\u0430 \u043a\u0430\u0436\u0430: &ldquo;\u041d\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e \u044f\u043d\u0430&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u043b\u044c\u0433\u0430 \u0434\u0430\u0446\u044c \u0437\u0430 \u044f\u0435 \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u044c \u0437\u0430 \u044f\u0435 \u0441\u0440\u044d\u0431\u0440\u0430 \u044f\u043a \u043f\u043b\u0430\u0442\u0443. \u041d\u0435\u043b\u044c\u0433\u0430 \u043d\u0430\u0431\u044b\u0446\u044c \u044f\u0435 \u0437\u0430 \u0437\u043e\u043b\u0430\u0442\u0430 \u0410\u0444\u0456\u0440\u0443, \u0437\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u043e\u043d\u0456\u043a\u0441 \u0446\u0456 \u0441\u0430\u043f\u0444\u0456\u0440. \u041d\u0435\u043b\u044c\u0433\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0437 \u0451\u044e \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c, \u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u043c\u044f\u043d\u044f\u0446\u044c \u044f\u0435 \u043d\u0430 \u0437\u0430\u043b\u0430\u0442\u044b \u043f\u043e\u0441\u0443\u0434. \u041f\u0440\u0430 \u043a\u0430\u0440\u0430\u043b\u044b \u0456 \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c \u043d\u044f\u043c\u0430 \u0447\u0430\u0433\u043e \u0437\u0433\u0430\u0434\u0432\u0430\u0446\u044c, \u0431\u043e \u043a\u043e\u0448\u0442 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043f\u044f\u0440\u043b\u0456\u043d\u044b. \u041d\u0435\u043b\u044c\u0433\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0437 \u0451\u044e \u044d\u0444\u0456\u043e\u043f\u0441\u043a\u0456 \u0442\u0430\u043f\u0430\u0437, \u0437\u0430 \u0447\u044b\u0441\u0442\u0430\u0435 \u0437\u043e\u043b\u0430\u0442\u0430 \u043d\u0435 \u043a\u0443\u043f\u0456\u0448 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0434\u0437\u0435 \u0436\u044b\u0432\u0435 \u0440\u043e\u0437\u0443\u043c? \u042f\u043d\u0430 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u0432\u0430\u0447\u044d\u0439 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430 \u0456 \u045e\u0442\u043e\u0435\u043d\u0430 \u0430\u0434 \u043f\u0442\u0443\u0448\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445. \u0410\u0431\u0430\u0434\u043e\u043d \u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u041d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u0443\u0448\u044b \u043c\u044b \u0447\u0443\u043b\u0456 \u0447\u0443\u0442\u043a\u0443 \u043f\u0440\u0430 \u044f\u0435&rdquo;. \u0411\u043e\u0433 \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u044f\u0435 \u0448\u043b\u044f\u0445, \u0401\u043d \u0432\u0435\u0434\u0430\u0435 \u044f\u0435 \u043c\u0435\u0441\u0446\u0430. \u0411\u043e \u0401\u043d \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456, \u0431\u0430\u0447\u044b\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c. \u041a\u0430\u043b\u0456 \u0432\u0435\u0442\u0440\u0443 \u0434\u0430\u0432\u0430\u045e \u043c\u043e\u0446 \u0456 \u0432\u043e\u0434\u044b \u043f\u0430\u043c\u0435\u0440\u0430\u045e \u043c\u0435\u0440\u043a\u0430\u044e; \u043a\u0430\u043b\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043f\u0440\u0430\u0432\u0430 \u0434\u043b\u044f \u0434\u0430\u0436\u0434\u0436\u0443 \u0456 \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u043b\u044f \u043c\u0430\u043b\u0430\u043d\u043a\u0456 \u0456 \u0433\u0440\u043e\u043c\u0443, \u0442\u0430\u0434\u044b \u0431\u0430\u0447\u044b\u045e \u044f\u0435, \u043f\u0430\u043c\u0435\u0440\u0430\u045e, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e. \u0410 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0412\u043e\u0441\u044c \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u0451\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0430 \u045e\u043d\u0456\u043a\u0430\u043d\u043d\u0435 \u0437\u043b\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 2, 7; 1, 30\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e, \u0441\u0445\u0430\u0432\u0430\u043d\u0443\u044e \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456 \u0434\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u043d\u0430\u0448\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0456\u0441\u043d\u0443\u0435\u0446\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0443\u044e \u0411\u043e\u0433 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456 \u0434\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u043d\u0430\u0448\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"92","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">29, 1-10; 30, 1. 9-23<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u045e \u0434\u0430\u043b\u0435\u0439 \u043c\u043e\u0432\u0443 \u0441\u0432\u0430\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0442\u043e \u0432\u0435\u0440\u043d\u0435 \u043c\u043d\u0435 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u044f \u043c\u0435\u0441\u044f\u0446\u044b \u0456 \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u043c\u043d\u043e\u044e, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u044b \u0441\u0432\u0435\u0442\u0430\u0447 \u0441\u0432\u044f\u0446\u0456\u045e \u043d\u0430\u0434 \u043c\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u043e\u044e, \u0430 \u044f \u045e \u042f\u0433\u043e\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u0445\u0430\u0434\u0437\u0456\u045e \u0443 \u0446\u0435\u043c\u0440\u044b? \u042f \u0431\u044b\u045e \u044f\u043a \u0443 \u0434\u043d\u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439, \u043a\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u043d\u0430\u0434 \u043c\u0430\u0456\u043c \u043d\u0430\u043c\u0451\u0442\u0430\u043c, \u043a\u0430\u043b\u0456 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u0441\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0434\u0437\u0435\u0446\u0456 \u043c\u0430\u0435 &ndash; \u0432\u0430\u043a\u043e\u043b \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043c\u0430\u0435 \u043d\u043e\u0433\u0456 \u043a\u0443\u043f\u0430\u043b\u0456\u0441\u044f \u045e \u043c\u0430\u043b\u0430\u043a\u0443, \u0456 \u0441\u043a\u0430\u043b\u0430 \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0456\u043b\u0430 \u043c\u043d\u0435 \u043f\u0430\u0442\u043e\u043a\u0430\u043c\u0456 \u0430\u043b\u0435\u044e; \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0437 \u0431\u0440\u0430\u043c\u044b \u0433\u043e\u0440\u0430\u0434\u0430 \u0456 \u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u044b \u0437\u0430\u0439\u043c\u0430\u045e \u043c\u0435\u0441\u0446\u0430 \u0441\u0432\u0430\u0451. \u0425\u043b\u043e\u043f\u0446\u044b, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u043c\u044f\u043d\u0435, \u0445\u0430\u0432\u0430\u043b\u0456\u0441\u044f, \u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u045e\u0441\u0442\u0430\u0432\u0430\u043b\u0456. \u041a\u043d\u044f\u0437\u0456 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0432\u0430\u043b\u0456 \u043f\u0430\u043b\u044c\u0446\u044b \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e. \u0413\u043e\u043b\u0430\u0441 \u0437\u043d\u0430\u0442\u043d\u044b\u0445 \u0437\u0430\u0446\u0456\u0445\u0430\u045e, \u0430 \u044f\u0437\u044b\u043a \u0456\u0445\u043d\u0456 \u043f\u0440\u044b\u0441\u044b\u0445\u0430\u045e \u0434\u0430 \u043f\u0430\u0434\u043d\u044f\u0431\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0446\u044f\u043f\u0435\u0440 \u0441\u043c\u044f\u044e\u0446\u0446\u0430 \u0437 \u043c\u044f\u043d\u0435 \u043c\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b\u044f \u0437\u0430 \u043c\u044f\u043d\u0435, \u0447\u044b\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u044f \u043d\u0435 \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u0431\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u0430\u043a\u0430\u043c\u0456 \u0441\u0442\u0430\u0442\u043a\u0443 \u043c\u0430\u0439\u0433\u043e. \u0426\u044f\u043f\u0435\u0440 \u044f \u0441\u0442\u0430\u045e \u0456\u0445\u043d\u044f\u0439 \u0447\u0430\u0441\u0442\u0443\u0448\u043a\u0430\u0439 \u0456 \u043f\u0440\u044b\u043c\u0430\u045e\u043a\u0430\u0439 \u0443 \u0456\u0445\u043d\u0456\u0445 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u0445. \u042f\u043d\u044b \u0433\u0440\u044d\u0431\u0443\u044e\u0446\u044c \u043c\u043d\u043e\u044e, \u0430\u0434\u0434\u0430\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0456 \u043d\u0435 \u0432\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u043f\u043b\u044f\u0432\u0430\u0446\u044c \u043c\u043d\u0435 \u045e \u0442\u0432\u0430\u0440. \u0426\u044f\u043f\u0435\u0440 \u0401\u043d \u0430\u0441\u043b\u0430\u0431\u0456\u045e \u043c\u043e\u0439 \u043b\u0443\u043a \u0456 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u043c\u044f\u043d\u0435, \u0430 \u044f\u043d\u044b \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0456\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u044f\u0437\u044b\u043a\u0456 \u0441\u0432\u0430\u0435. \u0417 \u043c\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0441\u0442\u0430\u045e \u0433\u044d\u0442\u044b \u0437\u0431\u0440\u043e\u0434. \u042f\u043d\u044b \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u043e\u044e \u043f\u0430\u0441\u0442\u043a\u0443, \u043f\u0440\u0430\u043a\u043b\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0448\u043b\u044f\u0445\u0456 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u0456. \u0417\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u0441\u0446\u0435\u0436\u043a\u0443 \u043c\u0430\u044e, \u0436\u0430\u0434\u0430\u044e\u0446\u044c \u043c\u0430\u0451\u0439 \u0437\u0433\u0443\u0431\u044b, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0456\u0445 \u043f\u0430\u043c\u043e\u0447\u043d\u0456\u043a\u0430\u045e. \u0423\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430, \u044f\u043a \u043f\u0440\u0430\u0437 \u0448\u044b\u0440\u043e\u043a\u0456 \u043f\u0440\u0430\u043b\u043e\u043c, \u043d\u0430\u043b\u044f\u0442\u0430\u044e\u0446\u044c \u044f\u043a \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435. \u0416\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u043c\u044f\u043d\u0435; \u044f\u043a \u0432\u0435\u0446\u0435\u0440, \u0440\u0430\u0437\u0432\u0435\u044f\u043b\u0430\u0441\u044f \u043c\u0430\u044f \u0432\u0435\u043b\u0456\u0447, \u0456 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0430\u0451 \u0437\u043d\u0456\u043a\u0430\u0435, \u044f\u043a \u0432\u043e\u0431\u043b\u0430\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451; \u0434\u043d\u0456 \u043d\u044f\u0434\u043e\u043b\u0456 \u0430\u0433\u0430\u0440\u043d\u0443\u043b\u0456 \u043c\u044f\u043d\u0435. \u0423\u043d\u0430\u0447\u044b \u0431\u043e\u043b\u044c \u043f\u0440\u0430\u0446\u0456\u043d\u0430\u0435 \u043c\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456; \u043d\u0435 \u043c\u0430\u044e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0430\u0434 \u043c\u0430\u0456\u0445 \u0437\u0433\u0440\u044b\u0437\u043e\u0442\u0430\u045e. \u0417 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u0456\u043b\u0430\u044e \u0441\u0445\u0430\u043f\u0456\u045e \u041f\u0430\u043d \u043c\u044f\u043d\u0435 \u0437\u0430 \u0430\u0434\u0437\u0435\u043d\u043d\u0435; \u044f\u043a \u043a\u0440\u0430\u0439 \u043f\u043b\u0430\u0448\u0447\u0430, \u0437\u0432\u044f\u0437\u0432\u0430\u0435 \u043c\u044f\u043d\u0435. \u041a\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u045e \u0431\u0440\u0443\u0434, \u044f \u0441\u0442\u0430\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043f\u044b\u043b\u0443 \u0456 \u043f\u043e\u043f\u0435\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0426\u044f\u0431\u0435, \u0430\u043b\u0435 \u0422\u044b \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043c\u043d\u0435. \u042f \u0441\u0442\u0430\u044e, \u0430\u043b\u0435 \u0422\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0448 \u043d\u0430 \u043c\u044f\u043d\u0435. \u0411\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430 \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u044e, \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0448 \u043c\u044f\u043d\u0435. \u041f\u0430\u0434\u044b\u043c\u0430\u0435\u0448 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0432\u0435\u0446\u0435\u0440, \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u043d\u0451\u0441 \u043c\u044f\u043d\u0435, \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0448 \u043c\u044f\u043d\u0435. \u0412\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0422\u044b \u0432\u044f\u0434\u0437\u0435\u0448 \u043c\u044f\u043d\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u045e \u0434\u043e\u043c, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 30, 17. 19; 7, 16b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d<\/span> \u0423\u043d\u0430\u0447\u044b \u0431\u043e\u043b\u044c \u043f\u0440\u0430\u043d\u0456\u0437\u0432\u0430\u0435 \u043c\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456; \u043d\u0435 \u043c\u0430\u044e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0430\u0434 \u043c\u0430\u0456\u0445 \u0437\u0433\u0440\u044b\u0437\u043e\u0442\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435, \u041f\u0430\u043d, \u0443 \u0431\u0440\u0443\u0434, \u044f \u0441\u0442\u0430\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043f\u044b\u043b\u0443 \u0456 \u043f\u043e\u043f\u0435\u043b\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u044b\u0434\u0437\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0431\u043e \u0434\u043d\u0456 \u043c\u0430\u0435 \u043d\u0456\u0448\u0442\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0456\u043d\u0443\u045e \u041a\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435, \u041f\u0430\u043d, \u0443 \u0431\u0440\u0443\u0434, \u044f \u0441\u0442\u0430\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043f\u044b\u043b\u0443 \u0456 \u043f\u043e\u043f\u0435\u043b\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"93","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">31, 1-8. 13-23. 35-37<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0432\u0430\u0447\u0430\u043c\u0456 \u043c\u0430\u0456\u043c\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0443. \u042f\u043a\u0430\u044f \u0436 \u0434\u043e\u043b\u044f \u043c\u043d\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0430\u0434 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0437 \u0432\u044b\u0448\u044b\u043d\u044f\u045e? \u0426\u0456 \u043d\u0435 \u0437\u0433\u0443\u0431\u0430 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443 \u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e? \u0426\u0456 \u0436 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0401\u043d \u0448\u043b\u044f\u0445\u043e\u045e \u043c\u0430\u0456\u0445 \u0456 \u0446\u0456 \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u043c\u0430\u0435 \u043a\u0440\u043e\u043a\u0456? \u041a\u0430\u043b\u0456 \u044f \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u045e \u043f\u0430\u0434\u043c\u0430\u043d, \u0430 \u043d\u0430\u0433\u0430 \u043c\u0430\u044f \u0441\u043f\u044f\u0448\u0430\u043b\u0430\u0441\u044f \u0434\u0430 \u0430\u0448\u0443\u043a\u0430\u043d\u0441\u0442\u0432\u0430, &ndash; \u043d\u044f\u0445\u0430\u0439 \u0443\u0437\u0432\u0430\u0436\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u043d\u0430 \u0448\u0430\u043b\u044f\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433 \u043f\u0440\u0430 \u043c\u0430\u044e \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u043d\u0430\u0433\u0430 \u043c\u0430\u044f \u045e\u0445\u0456\u043b\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0448\u043b\u044f\u0445\u0443, \u0456 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451 \u043f\u0430\u0439\u0448\u043b\u043e \u0437\u0430 \u043c\u0430\u0456\u043c\u0456 \u0432\u0430\u0447\u0430\u043c\u0456, \u0430 \u043d\u0430 \u0434\u0430\u043b\u043e\u043d\u044f\u0445 \u043c\u0430\u0456\u0445 \u0431\u0440\u0443\u0434, \u0434\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f \u0441\u0435\u044e, \u0435\u0441\u0446\u044c \u0456\u043d\u0448\u044b, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0440\u0430\u0441\u043b\u0430, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0440\u0443\u0448\u044b\u045e \u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0433\u0456 \u043c\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0451\u0439 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0456, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0440\u0433\u0430 \u0456\u0445\u043d\u044f\u044f \u0431\u044b\u043b\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0434\u044b\u043a \u0448\u0442\u043e \u044f \u0437\u0440\u0430\u0431\u043b\u044e, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435? \u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u0447\u0430, \u0448\u0442\u043e \u0430\u0434\u043a\u0430\u0436\u0443 \u042f\u043c\u0443? \u0426\u0456 \u0436 \u0442\u043e\u0439, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456, \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0456\u0445 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0446\u0456?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"background-color: transparent;\">\u0426\u0456 \u0436 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u045e \u044f \u045e \u043f\u0430\u0442\u0440\u044d\u0431\u0435 \u0431\u0435\u0434\u043d\u044b\u043c, \u0446\u0456 \u0436 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e \u0432\u043e\u0447\u044b \u045e\u0434\u0430\u0432\u044b? \u0426\u0456 \u0436 \u044f \u0441\u0430\u043c \u0437&rsquo;\u044f\u0434\u0430\u045e \u0441\u0432\u043e\u0439 \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0445\u043b\u0435\u0431\u0430, \u0456 \u043d\u0435 \u0435\u045e \u0441\u0430 \u043c\u043d\u043e\u044e \u0441\u0456\u0440\u0430\u0442\u0430? \u0411\u043e\u0433 \u0437 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u044f\u043a \u0431\u0430\u0446\u044c\u043a\u0430, \u0456 \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u0441\u0430\u043c \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u043c\u043d\u043e\u044e. \u041a\u0430\u043b\u0456 \u044f \u0431\u0430\u0447\u044b\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u0456\u043d\u0443\u045e \u0437-\u0437\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0446\u0456 \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0435\u045e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0456, \u0456 \u043d\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u043c\u044f\u043d\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u0446\u0451\u0433\u043d\u044b, \u0431\u043e \u0432\u043e\u045e\u043d\u0430\u044e \u0430\u0432\u0435\u0447\u0430\u043a \u043c\u0430\u0456\u0445 \u0451\u043d \u0431\u044b\u045e \u0441\u0430\u0433\u0440\u044d\u0442\u044b; \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u043d\u044f\u045e \u044f \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043d\u0430 \u0441\u0456\u0440\u0430\u0442\u0443, \u0431\u043e \u0431\u0430\u0447\u044b\u045e \u0443 \u0431\u0440\u0430\u043c\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u043c\u0430\u044e, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043f\u043b\u044f\u0447\u043e \u043c\u0430\u0451 \u0430\u0434\u043f\u0430\u0434\u0437\u0435 \u0430\u0434 \u043a\u0430\u0440\u043a\u0443, \u0456 \u0440\u0443\u043a\u0430 \u043c\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u0437\u043b\u0430\u043c\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0443\u0441\u0442\u0430\u0432\u0435. \u0411\u043e \u0436\u0430\u0445 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u0441\u0430 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u044f \u043d\u0435 \u0432\u044b\u0441\u0442\u0430\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0433\u043e \u0422\u044b \u0434\u0430\u0441\u0456 \u043c\u043d\u0435, \u043a\u0430\u0431 \u0451\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u043c\u044f\u043d\u0435? \u042f \u0441\u043a\u043e\u043d\u0447\u044b\u045e, \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0430\u0436\u0430 \u043c\u043d\u0435, \u0430 \u043c\u043e\u0439 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u0430 \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u043b\u0430\u0434\u0437\u0435 \u0437\u0430\u043f\u0456\u0441. \u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u044f \u043f\u0430\u043d\u0451\u0441 \u0431\u044b \u044f\u0433\u043e \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u043b\u044f\u0447\u0430\u0445 \u0456 \u045e\u0441\u043a\u043b\u0430\u045e \u0431\u044b \u044f\u0433\u043e \u043d\u0430 \u0441\u044f\u0431\u0435, \u044f\u043a \u043a\u0430\u0440\u043e\u043d\u0443. \u042f \u0434\u0430\u045e \u0431\u044b \u0441\u043f\u0440\u0430\u0432\u0430\u0437\u0434\u0430\u0447\u0443 \u042f\u043c\u0443 \u0437 \u043c\u0430\u0456\u0445 \u043a\u0440\u043e\u043a\u0430\u045e, \u044f\u043a \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0431\u044b \u0434\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 31, 3; \u041f\u0440\u044b\u043f 15, 3; \u0401\u045e 31, 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u0456 \u043d\u0435 \u0437\u0433\u0443\u0431\u0430 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443 \u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e? <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b: \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0434\u043e\u0431\u0440\u044b\u0445 \u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0426\u0456 \u0436 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0401\u043d \u0448\u043b\u044f\u0445\u043e\u045e \u043c\u0430\u0456\u0445 \u0456 \u0446\u0456 \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u043c\u0430\u0435 \u043a\u0440\u043e\u043a\u0456?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b: \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0434\u043e\u0431\u0440\u044b\u0445 \u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"94","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">32, 1-6; 33, 1-22&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u042d\u043b\u0456\u0433\u0443 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0442\u0440\u043e\u0435 \u043c\u0443\u0436\u043e\u045e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430 \u0401\u0432\u0430, \u0431\u043e \u0451\u043d \u043b\u0456\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c. \u0410\u043b\u0435 \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0433\u043d\u0435\u0432\u0430\u043c \u042d\u043b\u0456\u0433\u0443, \u0441\u044b\u043d \u0411\u0430\u0440\u0430\u043a\u0435\u043b\u0430, \u0411\u0443\u0437\u044b\u0442\u044b \u0437 \u043f\u043b\u0435\u043c\u044f \u0420\u0430\u043c. \u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u0451\u043d \u043d\u0430 \u0401\u0432\u0430 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u043e\u0439 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0411\u043e\u0433. \u0410 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u0442\u0440\u043e\u0445 \u0441\u044f\u0431\u0440\u043e\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c, \u0445\u043e\u0446\u044c \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u043b\u0456 \u0401\u0432\u0430. \u042d\u043b\u0456\u0433\u0443 \u0447\u0430\u043a\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0437 \u0401\u0432\u0430\u043c, \u0431\u043e \u0442\u044b\u044f \u0431\u044b\u043b\u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u0437\u0430 \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u042d\u043b\u0456\u0433\u0443 \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u044f \u0442\u0440\u044b \u043c\u0443\u0436\u044b \u043d\u0435 \u043c\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0433\u043d\u0435\u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u042d\u043b\u0456\u0433\u0443, \u0441\u044b\u043d \u0411\u0430\u0440\u0430\u043a\u0435\u043b\u0430, \u0411\u0443\u0437\u044b\u0442\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u043c\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b, \u0430 \u0432\u044b &ndash; \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f; \u0442\u0430\u043c\u0443 \u044f \u0431\u044b\u045e \u043d\u044f\u0441\u043c\u0435\u043b\u044b \u0456 \u0431\u0430\u044f\u045e\u0441\u044f \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u0435\u0434\u044b. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0401\u045e, \u043c\u0430\u044e \u043c\u043e\u0432\u0443 \u0456 \u0441\u0445\u0456\u043b\u0456 \u0432\u0443\u0445\u0430 \u0434\u0430 \u045e\u0441\u0456\u0445 \u043c\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e. \u0412\u043e\u0441\u044c, \u044f \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435, \u044f\u0437\u044b\u043a \u043c\u043e\u0439 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0430\u0434 \u043f\u0430\u0434\u043d\u044f\u0431\u0435\u043d\u043d\u0435\u043c. \u0417 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u0430 \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u0435 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u043f\u044d\u045e\u043d\u044b\u044f \u0432\u0435\u0434\u044b. \u0414\u0443\u0445 \u0411\u043e\u0433\u0430 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u044f\u043d\u0435, \u0430 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0434\u0430\u043b\u043e \u043c\u043d\u0435 \u0436\u044b\u0446\u0446\u0451. \u041a\u0430\u043b\u0456 \u043c\u043e\u0436\u0430\u0448, \u0430\u0434\u043a\u0430\u0436\u044b \u043c\u043d\u0435. \u0411\u0443\u0434\u0437\u044c \u0433\u0430\u0442\u043e\u0432\u044b, \u0441\u0442\u0430\u043d\u044c \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e. \u0412\u043e\u0441\u044c \u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u0443\u0441\u043d\u044b \u0442\u0432\u0430\u0435, \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0433\u043b\u0456\u043d\u044b. \u0421\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u0446\u044f\u0431\u0435, \u0456 \u0440\u0443\u043a\u0430 \u043c\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u045e, \u0430 \u0432\u0443\u0448\u044b \u043c\u0430\u0435 \u0447\u0443\u043b\u0456 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u045e: &ldquo;\u042f \u0447\u044b\u0441\u0442\u044b, \u0431\u0435\u0437 \u0433\u0440\u0430\u0445\u0443, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u0456 \u043d\u044f\u043c\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0432\u0456\u043d\u044b. \u0410\u0434\u043d\u0430\u043a \u0401\u043d \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u045e\u0432\u0430 \u043c\u043d\u0435, \u043b\u0456\u0447\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c. \u0417\u0430\u043a\u0430\u0432\u0430\u045e \u043d\u043e\u0433\u0456 \u043c\u0430\u0435 \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u0441\u043e\u0447\u044b\u0446\u044c \u0437\u0430 \u045e\u0441\u0456\u043c\u0456 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456 \u043c\u0430\u0456\u043c\u0456&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0443 \u0433\u044d\u0442\u044b\u043c, \u043a\u0430\u0436\u0443, \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u0430 \u0442\u0432\u0430\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u0448\u0441\u044f \u043d\u0430 \u042f\u0433\u043e, \u0448\u0442\u043e \u0401\u043d \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0435 \u0442\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430. \u0411\u043e\u0433 \u043a\u0430\u0436\u0430 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0442\u0430\u043a, \u0430 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0456\u043d\u0430\u043a\u0448, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u0430. \u0423 \u0441\u043d\u0435, \u0443 \u043d\u0430\u0447\u043d\u044b\u0445 \u0431\u0430\u0447\u0430\u043d\u043d\u044f\u0445, \u043a\u0430\u043b\u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0441\u043e\u043d \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u043b\u044e\u0434\u0437\u0435\u0439, \u0443 \u0447\u0430\u0441 \u0434\u0440\u044b\u043c\u043e\u0442\u044b \u043d\u0430 \u043b\u043e\u0436\u043a\u0443. \u0422\u0430\u0434\u044b \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u0443\u0448\u044b \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0456\u0445 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u043c\u0456, \u043a\u0430\u0431 \u0430\u0434\u0432\u0435\u0441\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u0447\u044b\u043d\u0443 \u0456 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u043f\u044b\u0445\u0456, \u043a\u0430\u0431 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0434\u0443\u0448\u0443 \u044f\u0433\u043e\u043d\u0443\u044e \u0430\u0434 \u043f\u0440\u043e\u0440\u0432\u044b \u0456 \u0436\u044b\u0446\u0446\u0451 \u044f\u0433\u043e\u043d\u0430\u0435 \u0430\u0434 \u043f\u0430\u0440\u0430\u0437\u044b \u043c\u0435\u0447\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u044f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u043d\u0430 \u044f\u0433\u043e\u043d\u044b\u043c \u043b\u043e\u0436\u043a\u0443 \u0456 \u043f\u0440\u0430\u0437 \u0431\u043e\u043b\u044c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b \u045e \u043a\u0430\u0441\u0446\u044f\u0445 \u044f\u0433\u043d\u044b\u0445, \u043a\u0430\u043b\u0456 \u0430\u0431\u0440\u044b\u0434\u043d\u0435 \u044f\u043c\u0443 \u0445\u043b\u0435\u0431, \u0430 \u0434\u0443\u0448\u044b \u044f\u0433\u043e\u043d\u0430\u0439 &ndash; \u0441\u043c\u0430\u0447\u043d\u0430\u044f \u0435\u0436\u0430. \u041a\u0430\u043b\u0456 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u043c\u0430\u0440\u043d\u0435\u0435, \u0456 \u0432\u044b\u0441\u0442\u0430\u044e\u0446\u044c \u044f\u0433\u043e\u043d\u044b\u044f \u043a\u043e\u0441\u0442\u043a\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u044f. \u042f\u0433\u043e \u0434\u0443\u0448\u0430 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043c\u0430\u0433\u0456\u043b\u044b, \u0456 \u0436\u044b\u0446\u0446\u0451 \u044f\u0433\u043e\u043d\u0430\u0435 &ndash; \u0434\u0430 \u043a\u0440\u0430\u0456\u043d\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 11, 33-34<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041e \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430!<span style=\"color: #ff0000;\"> *<\/span> \u042f\u043a\u0456\u044f \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u042f\u0433\u043e \u0456 \u043d\u044f\u0437\u0432\u0435\u0434\u0430\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u042f\u0433\u043e\u043d\u044b\u044f! <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u0445\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0440\u043e\u0437\u0443\u043c \u041f\u0430\u043d\u0430? \u0410\u0431\u043e \u0445\u0442\u043e \u0431\u044b\u045e \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456\u044f \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u042f\u0433\u043e \u0456 \u043d\u044f\u0437\u0432\u0435\u0434\u0430\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u042f\u0433\u043e\u043d\u044b\u044f!<\/p>\r\n"}, {"GCH_CH_1_ID":"95","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">38, 1-30<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0401\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0432\u0443 \u0437 \u0432\u0456\u0445\u0443\u0440\u044b: &laquo;\u041a\u0456\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0446\u044f\u043c\u043d\u044f\u0435 \u043f\u0430\u0440\u0430\u0434\u0443 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456? \u041f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435, \u044f\u043a \u043c\u0443\u0436\u0447\u044b\u043d\u0430. \u0421\u043f\u044b\u0442\u0430\u044e \u0446\u044f\u0431\u0435, \u0430 \u0442\u044b \u0430\u0434\u043a\u0430\u0436\u044b \u043c\u043d\u0435!<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435 \u0431\u044b\u045e \u0442\u044b, \u043a\u0430\u043b\u0456 \u042f \u0437\u0430\u0441\u043d\u043e\u045e\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e? \u0421\u043a\u0430\u0436\u044b, \u043a\u0430\u043b\u0456 \u0432\u0435\u0434\u0430\u0435\u0448. \u041c\u043e\u0436\u0430 \u0432\u0435\u0434\u0430\u0435\u0448, \u0445\u0442\u043e \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u045e \u044f\u0435 \u043f\u0430\u043c\u0435\u0440\u044b? \u0410 \u0445\u0442\u043e \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u045e \u043d\u0430\u0434 \u0451\u044e \u043c\u0435\u0440\u043a\u0443? \u041d\u0430 \u0447\u044b\u043c \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430 \u044f\u043d\u0430, \u0456 \u0445\u0442\u043e \u0437\u0430\u043a\u043b\u0430\u045e \u044f\u0435 \u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0440\u0430\u043d\u0456\u0448\u043d\u0456\u044f \u0437\u043e\u0440\u043a\u0456 \u0456 \u0432\u044b\u043a\u0440\u044b\u043a\u0432\u0430\u043b\u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0411\u043e\u0433\u0430? \u0425\u0442\u043e \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u0431\u0440\u0430\u043c\u044b \u043c\u043e\u0440\u0430, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u045e\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f, \u043d\u0456\u0431\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u043d\u0443\u0442\u0440\u0430, \u043a\u0430\u043b\u0456 \u042f \u0445\u043c\u0430\u0440\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435\u043c \u044f\u0433\u043e \u0456 \u0446\u0435\u043c\u0440\u0443 &ndash; \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c? \u042f \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u043c\u0435\u0436\u0430\u0445 \u041c\u0430\u0456\u0445 \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0437\u0430\u043c\u043a\u0456 \u0456 \u0434\u0437\u0432\u0435\u0440\u044b. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0434\u043e\u0439\u0434\u0437\u0435\u0448, \u043d\u0435 \u0434\u0430\u043b\u0435\u0439. \u0422\u0443\u0442 \u0437\u043b\u0430\u043c\u0430\u0435\u0448 \u0441\u0432\u0430\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0445\u0432\u0430\u043b\u0456&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0442\u044b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u045e \u0440\u0430\u043d\u0456\u0446\u044b, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0437\u0430\u0440\u0430\u043d\u0456\u0446\u044b \u043c\u0435\u0441\u0446\u0430 \u044f\u0435, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u043a\u0456\u043d\u0443\u043b\u0430 \u0437 \u044f\u0435 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e? \u0417\u044f\u043c\u043b\u044f \u0437\u043c\u044f\u043d\u044f\u0435\u0446\u0446\u0430, \u044f\u043a \u0433\u043b\u0456\u043d\u0430 \u043f\u0430\u0434 \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u0439, \u0456 \u0440\u0430\u0441\u0444\u0430\u0440\u0431\u0430\u0432\u0430\u043d\u0430 \u044f\u043d\u0430, \u044f\u043a \u0430\u0434\u0437\u0435\u043d\u043d\u0435. \u0410\u0434\u043d\u044f\u0442\u0430 \u045e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u0456\u0445\u043d\u044f\u0435, \u0456 \u0432\u044b\u0441\u043e\u043a\u0430 \u045e\u0437\u043d\u044f\u0442\u0430\u044f \u0440\u0443\u043a\u0430 \u0456\u0445 \u0437\u043b\u0430\u043c\u0430\u043d\u0430? \u0426\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0442\u044b \u0434\u0430 \u043c\u0430\u0440\u0441\u043a\u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0456 \u0446\u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0434\u043d\u043e \u0431\u0435\u0437\u0434\u0430\u043d\u0456? \u0426\u0456 \u0430\u0434\u0447\u044b\u043d\u044f\u043b\u0456\u0441\u044f \u0442\u0430\u0431\u0435 \u0431\u0440\u0430\u043c\u044b \u0441\u043c\u0435\u0440\u0446\u0456, \u0446\u0456 \u0431\u0430\u0447\u044b\u045e \u0442\u044b \u0431\u0440\u0430\u043c\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e? \u0426\u0456 \u0430\u0433\u043b\u044f\u0434\u0430\u045e \u0442\u044b \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u0443 \u0437\u044f\u043c\u043b\u0456? \u0420\u0430\u0441\u043a\u0430\u0436\u044b, \u043a\u0430\u043b\u0456 \u0432\u0435\u0434\u0430\u0435\u0448 \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u044f\u043a\u0456\u043c \u0448\u043b\u044f\u0445\u0443 \u0436\u044b\u0432\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0434\u0437\u0435 \u0442\u043e\u0435 \u043c\u0435\u0441\u0446\u0430 \u0446\u0435\u043c\u0440\u044b, \u043a\u0430\u0431 \u0434\u0430\u0439\u0448\u043e\u045e \u0442\u044b \u0434\u0430 \u0456\u0445\u043d\u0456\u0445 \u043c\u0435\u0436\u0430\u045e \u0456 \u0432\u0435\u0434\u0430\u045e \u0441\u0446\u0435\u0436\u043a\u0456 \u0434\u0430 \u0456\u0445 \u0434\u043e\u043c\u0443? \u0422\u044b \u043f\u0430\u0437\u043d\u0430\u045e \u0433\u044d\u0442\u0430, \u0431\u043e \u045e\u0436\u043e \u0442\u0430\u0434\u044b \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b, \u0456 \u043b\u0456\u0447\u0431\u0430 \u0434\u0437\u0451\u043d \u0442\u0432\u0430\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0430\u044f?<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0442\u044b \u045e \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u044b \u0441\u043d\u0435\u0433\u0443 \u0456 \u0446\u0456 \u0431\u0430\u0447\u044b\u045e \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u044b \u0433\u0440\u0430\u0434\u0443, \u044f\u043a\u0456\u044f \u0441\u0446\u0435\u0440\u0430\u0433\u0443 \u042f \u043d\u0430 \u0447\u0430\u0441 \u043d\u044f\u0434\u043e\u043b\u0456, \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0432\u0430\u0439\u043d\u044b \u0456 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b? \u042f\u043a\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043c\u0435\u0441\u0446\u0430, \u0430\u0434\u043a\u0443\u043b\u044c \u0440\u0430\u0437\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0432\u0435\u0435 \u045e\u0441\u0445\u043e\u0434\u043d\u0456 \u0432\u0435\u0446\u0435\u0440 \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e? \u0425\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043f\u0430\u0442\u043e\u043a\u0430\u045e \u0434\u0430\u0436\u0434\u0436\u0443 \u043a\u0430\u043d\u0430\u0432\u044b \u0456 \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u043b\u044f \u0431\u0443\u0440\u044b \u0437 \u0433\u0440\u044b\u043c\u043e\u0442\u0430\u043c\u0456, \u043a\u0430\u0431 \u0430\u0440\u0430\u0441\u0456\u0446\u044c \u0431\u044f\u0437\u043b\u044e\u0434\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u0434\u0437\u0435 \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u044c \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0443\u044e \u0456 \u0430\u043f\u0443\u0441\u0446\u0435\u043b\u0443\u044e \u0437\u044f\u043c\u043b\u044e \u0456 \u0434\u0430\u0446\u044c \u0440\u043e\u0441\u0442 \u043c\u0430\u043b\u0430\u0434\u043e\u0439 \u0442\u0440\u0430\u0432\u0435? \u0426\u0456 \u043c\u0430\u0435 \u0434\u043e\u0436\u0434\u0436 \u0431\u0430\u0446\u044c\u043a\u0443? \u0406 \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u043a\u0440\u043e\u043f\u043b\u0456 \u0440\u0430\u0441\u044b? \u0417 \u0447\u044b\u0439\u0433\u043e \u045e\u043b\u043e\u043d\u043d\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043b\u0451\u0434? \u0406 \u0445\u0442\u043e \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0456\u043d\u0435\u0439 \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u043b\u0456, \u044f\u043a \u043a\u0430\u043c\u0435\u043d\u044c, \u0446\u0432\u044f\u0440\u0434\u0437\u0435\u044e\u0446\u044c \u0432\u043e\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u044f \u0431\u0435\u0437\u0434\u0430\u043d\u0456 \u0437\u0430\u043c\u044f\u0440\u0437\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 9, 20; \u0401\u045e 38, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0442\u044b, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0447\u0430\u0435\u0448\u0441\u044f \u0437 \u0411\u043e\u0433\u0430\u043c? <span style=\"color: #ff0000;\">*<\/span> \u0426\u0456 \u0441\u043a\u0430\u0436\u0430 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e: \u0427\u0430\u043c\u0443 \u0442\u044b \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e?<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435, \u044f\u043a \u043c\u0443\u0436\u0447\u044b\u043d\u0430. \u0421\u043f\u044b\u0442\u0430\u044e \u0446\u044f\u0431\u0435, \u0430 \u0442\u044b \u0430\u0434\u043a\u0430\u0436\u044b \u043c\u043d\u0435!<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u0456 \u0441\u043a\u0430\u0436\u0430 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e: \u0427\u0430\u043c\u0443 \u0442\u044b \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e?<\/p>\r\n"}, {"GCH_CH_1_ID":"96","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">40, 1-14; 42, 1-6&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0401\u0432\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0426\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043f\u0440\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b\u043c, \u043f\u0430\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e? \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0430\u0436\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435 \u0411\u043e\u0433\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0401\u045e \u041f\u0430\u043d\u0443: &laquo;\u0412\u043e\u0441\u044c \u044f, \u043c\u0430\u043b\u044b, \u0448\u0442\u043e \u0422\u0430\u0431\u0435 \u0430\u0434\u043a\u0430\u0436\u0443? \u0420\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043a\u043b\u0430\u0434\u0443 \u043d\u0430 \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435. \u042f \u0440\u0430\u0437 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0430\u0434\u043a\u0430\u0436\u0443; \u043d\u0430\u0432\u0430\u0442 \u0434\u0432\u043e\u0439\u0447\u044b, \u0430\u043b\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0434\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0401\u0432\u0443 \u0437 \u0432\u0456\u0445\u0443\u0440\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435, \u044f\u043a \u043c\u0443\u0436\u0447\u044b\u043d\u0430. \u0421\u043f\u044b\u0442\u0430\u044e \u0446\u044f\u0431\u0435, \u0430 \u0442\u044b \u0430\u0434\u043a\u0430\u0436\u044b \u043c\u043d\u0435! \u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0445\u043e\u0447\u0430\u0448 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u041c\u0430\u0451 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435, \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u041c\u044f\u043d\u0435, \u043a\u0430\u0431 \u042f \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u045e\u0441\u044f? \u0426\u0456 \u0442\u044b \u043c\u043e\u0446\u043d\u044b \u044f\u043a \u0411\u043e\u0433 \u0456 \u043c\u043e\u0436\u0430\u0448 \u0437\u0430\u0433\u0440\u044b\u043c\u0435\u0446\u044c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u044f\u043a \u0401\u043d?<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043f\u0440\u044b\u0433\u043e\u0436 \u0441\u044f\u0431\u0435 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0456 \u043c\u043e\u0446\u0430\u044e, \u0430\u043f\u0440\u0430\u043d\u0456\u0441\u044f \u045e \u0431\u043b\u044f\u0441\u043a \u0456 \u0441\u043b\u0430\u0432\u0443! \u0412\u044b\u043b\u0456 \u043b\u044e\u0442\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u043d\u0435\u0432\u0443, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u045e\u0446\u0430 \u0456 \u0441\u043a\u0430\u0440\u044b \u044f\u0433\u043e, \u0437\u043d\u0456\u0448\u0447\u044b \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0456\u0445\u043d\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u0445! \u0417\u0430\u043a\u0430\u043f\u0430\u0439 \u0456\u0445 \u0440\u0430\u0437\u0430\u043c \u0443 \u043f\u044b\u043b, \u0430 \u0442\u0432\u0430\u0440\u044b \u0456\u0445\u043d\u0456\u044f \u0437\u0430\u043a\u0440\u044b\u0439. \u0422\u0430\u0434\u044b \u0456 \u042f \u043f\u0440\u044b\u0437\u043d\u0430\u044e, \u0448\u0442\u043e \u043f\u0440\u0430\u0432\u0456\u0446\u0430 \u0442\u0432\u0430\u044f \u043c\u043e\u0436\u0430 \u0446\u044f\u0431\u0435 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443 \u045e \u0430\u0434\u043a\u0430\u0437: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0422\u044b \u045e\u0441\u0451 \u043c\u043e\u0436\u0430\u0448 \u0456 \u0448\u0442\u043e \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0439 \u0437\u0430\u0434\u0443\u043c\u044b \u0422\u0432\u0430\u0451\u0439 \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c. \u0425\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u0430\u0432\u0430\u0435 \u043f\u0430\u0440\u0430\u0434\u0443, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b? \u0422\u0430\u043c\u0443 \u0431\u0435\u0437 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u044f \u043a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0446\u0443\u0434\u044b, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043c\u0430\u0451 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0430 \u044f \u0431\u0443\u0434\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0441\u043f\u044b\u0442\u0430\u044e\u0441\u044f \u045e \u0426\u044f\u0431\u0435, \u0430 \u0422\u044b \u0430\u0434\u043a\u0430\u0436\u044b \u043c\u043d\u0435. \u042f \u0447\u0443\u045e \u043f\u0440\u0430 \u0426\u044f\u0431\u0435 \u0441\u0430 \u0441\u043b\u044b\u0445\u0443 \u0432\u0443\u0448\u044d\u0439; \u0446\u044f\u043f\u0435\u0440 \u0436\u0430 \u043c\u0430\u0435 \u0432\u043e\u0447\u044b \u0431\u0430\u0447\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0422\u0430\u043c\u0443 \u044f \u0432\u044b\u0440\u0430\u043a\u0430\u044e\u0441\u044f \u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0456 \u043a\u0430\u044e\u0441\u044f \u045e \u043f\u044b\u043b\u0435 \u0456 \u043f\u043e\u043f\u0435\u043b\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 42, 5-6; 40, 5. 4b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0447\u0443\u045e \u043f\u0440\u0430 \u0426\u044f\u0431\u0435 \u0441\u0430 \u0441\u043b\u044b\u0445\u0443 \u0432\u0443\u0448\u044d\u0439; \u0446\u044f\u043f\u0435\u0440 \u0436\u0430 \u043c\u0430\u0435 \u0432\u043e\u0447\u044b \u0431\u0430\u0447\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0422\u0430\u043c\u0443 \u044f \u0432\u044b\u0440\u0430\u043a\u0430\u044e\u0441\u044f \u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043a\u0430\u044e\u0441\u044f \u045e \u043f\u044b\u043b\u0435 \u0456 \u043f\u043e\u043f\u0435\u043b\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0440\u0430\u0437 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0430\u0434\u043a\u0430\u0436\u0443; \u043d\u0430\u0432\u0430\u0442 \u0434\u0432\u043e\u0439\u0447\u044b, \u0430\u043b\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0434\u0430\u043c. \u0420\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043a\u043b\u0430\u0434\u0443 \u043d\u0430 \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0426\u0456 \u0441\u043a\u0430\u0436\u0430 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e: \u0427\u0430\u043c\u0443 \u0442\u044b \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e?<\/p>\r\n"}, {"GCH_CH_1_ID":"97","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0401\u0432\u0430&nbsp;<span style=\"color: #ff0000;\">42, 7-16&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0401\u045e, \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c, \u0442\u0440\u044b\u0443\u043c\u0444\u0443\u0435 \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0401\u0432\u0443, \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042d\u043b\u0456\u0444\u0430\u0437\u0443 \u0437 \u0422\u044d\u043c\u0430\u043d\u0430: &laquo;\u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u042f \u043d\u0430 \u0446\u044f\u0431\u0435 \u0456 \u043d\u0430 \u0434\u0432\u0443\u0445 \u0441\u044f\u0431\u0440\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u041c\u044f\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439 \u0401\u045e. \u0414\u044b\u043a \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440, \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0441\u0430\u0431\u0435 \u0441\u0435\u043c \u0446\u044f\u043b\u044c\u0446\u043e\u045e \u0456 \u0441\u0435\u043c \u0431\u0430\u0440\u0430\u043d\u043e\u045e \u0434\u044b \u0456\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0441\u043b\u0443\u0433\u0456 \u041c\u0430\u0439\u0433\u043e \u0401\u0432\u0430 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0456\u0446\u0435 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443, \u0430 \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439 \u0401\u045e \u043f\u0430\u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u0432\u0430\u0441. \u042f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u044e \u044f\u0433\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u044e \u0437 \u0432\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439, \u0445\u043e\u0446\u044c \u0432\u044b \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u041c\u044f\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439 \u0401\u045e&raquo;. \u041f\u0430\u0439\u0448\u043b\u0456 \u042d\u043b\u0456\u0444\u0430\u0437 \u0437 \u0422\u044d\u043c\u0430\u043d\u0430, \u0411\u0456\u043b\u0434\u0430\u0434 \u0437 \u0428\u0443\u0430\u0445 \u0456 \u0421\u0430\u0444\u0430\u0440 \u0437 \u041d\u0430\u0430\u043c\u044b \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u043c \u041f\u0430\u043d. \u0406 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u041f\u0430\u043d \u0401\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044f\u0440\u043d\u0443\u045e \u041f\u0430\u043d \u0434\u0430 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443 \u0401\u0432\u0430 \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0437\u0430 \u044f\u0433\u043e \u0441\u044f\u0431\u0440\u043e\u045e \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0443\u0434\u0432\u0430\u044f \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u0435\u045e \u0401\u045e. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u044f\u0433\u043e \u045e\u0441\u0435 \u0431\u0440\u0430\u0442\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0456 \u045e\u0441\u0435 \u0441\u0451\u0441\u0442\u0440\u044b, \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u045e \u044f\u0433\u043e \u0440\u0430\u043d\u0435\u0439, \u0435\u043b\u0456 \u0437 \u0456\u043c \u0445\u043b\u0435\u0431 \u0443 \u0434\u043e\u043c\u0435 \u044f\u0433\u043e\u043d\u044b\u043c, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u043b\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u0441\u044f\u0433\u043e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f, \u044f\u043a\u043e\u0435 \u041f\u0430\u043d \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u044f\u0433\u043e, \u0456 \u043a\u043e\u0436\u043d\u044b \u0434\u0430\u045e \u044f\u043c\u0443 \u043f\u0430 \u0430\u0434\u043d\u043e\u0439 \u0441\u0440\u044d\u0431\u043d\u0430\u0439 \u043c\u0430\u043d\u0435\u0446\u0435 \u0456 \u043f\u0430 \u0430\u0434\u043d\u044b\u043c \u0437\u0430\u043b\u0430\u0442\u044b\u043c \u043f\u044f\u0440\u0441\u0446\u0451\u043d\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0401\u0432\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u044f. \u0406 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u044f\u0433\u043e \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0430\u0432\u0435\u0447\u0430\u043a, \u0448\u044d\u0441\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u045e, \u0442\u044b\u0441\u044f\u0447\u0430 \u043f\u0430\u0440 \u0432\u0430\u043b\u043e\u045e \u0456 \u0442\u044b\u0441\u044f\u0447\u0430 \u0430\u0441\u043b\u0456\u0446. \u0406 \u0431\u044b\u043b\u043e \u045e \u044f\u0433\u043e \u0441\u0435\u043c \u0441\u044b\u043d\u043e\u045e \u0456 \u0442\u0440\u044b \u0434\u0430\u0447\u043a\u0456. \u041f\u0435\u0440\u0448\u0443\u044e \u0451\u043d \u043d\u0430\u0437\u0432\u0430\u045e \u0413\u0430\u043b\u0443\u0431\u043a\u0430\u0439, \u0434\u0440\u0443\u0433\u0443\u044e &ndash; \u041a\u0432\u0435\u0442\u043a\u0430\u0439 \u0446\u044b\u043d\u0430\u043c\u043e\u043d\u0443, \u0430 \u0442\u0440\u044d\u0446\u044e\u044e &mdash; \u0420\u043e\u0433\u0430\u043c \u0441\u0443\u0440\u043c\u044b. \u0406 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u0442\u0430\u043a\u0456\u0445 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0445, \u044f\u043a \u0434\u043e\u0447\u043a\u0456 \u0401\u0432\u0430. \u0406 \u0434\u0430\u045e \u0456\u043c \u0431\u0430\u0446\u044c\u043a\u0430 \u0456\u0445\u043d\u0456 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043f\u0430\u043c\u0456\u0436 \u0456\u0445 \u0431\u0440\u0430\u0442\u0430\u043c\u0456. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u045e \u0401\u045e \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e \u0456 \u0431\u0430\u0447\u044b\u045e \u0441\u044b\u043d\u043e\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u0456\u0445\u043d\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 42, 7. 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u042d\u043b\u0456\u0444\u0430\u0437\u0443: \u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u042f \u043d\u0430 \u0446\u044f\u0431\u0435 \u0456 \u043d\u0430 \u0434\u0432\u0443\u0445 \u0441\u044f\u0431\u0440\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u041c\u044f\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439 \u0401\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043f\u0430\u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u043b\u044f \u044f\u0433\u043e \u042f \u043d\u0435 \u045e\u0447\u044b\u043d\u044e \u0437 \u0432\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043f\u0430\u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u0432\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"101","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">46, 1-10<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0445\u0432\u0430\u043b\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u0456 \u041a\u0430\u043b\u0435\u0431\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0433\u0443\u0442\u043d\u044b \u045e \u0431\u0456\u0442\u0432\u0435 \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u043f\u0435\u0440\u0430\u0435\u043c\u043d\u0456\u043a \u041c\u0430\u0439\u0441\u0435\u044f \u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u0445, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e, \u044f\u043a \u043a\u0430\u0436\u0430 \u044f\u0433\u043e \u0456\u043c\u044f, \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0443 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u043c\u044f\u0446\u0435\u0436\u043d\u044b\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u0456 \u045e\u0432\u0435\u0441\u0446\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u042f\u043a \u0436\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0451\u043d, \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u043d\u044f\u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u043c\u0435\u0447 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0430\u0440\u0430\u0434\u043e\u045e! \u0425\u0442\u043e \u0434\u0430 \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a\u043e\u0435? \u0413\u044d\u0442\u0430 \u0451\u043d \u0432\u0451\u045e \u0432\u043e\u0439\u043d\u044b \u041f\u0430\u043d\u0430. \u0426\u0456 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u0433\u043e \u0440\u0443\u0446\u044d \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430, \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c \u0441\u0442\u0430\u045e \u044f\u043a \u0434\u0432\u0430? \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0451\u043d \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u043a\u0430\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0456 \u0430\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u044f\u0433\u043e \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d, \u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043a\u0430\u043c\u044f\u043d\u0456\u0441\u0442\u044b \u0433\u0440\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u043e\u0446\u044b. \u0401\u043d \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0443 \u0431\u0456\u0442\u0432\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u043a\u0430\u043b\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e, \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u044b \u044f\u0433\u043e \u0437\u0431\u0440\u043e\u044e, \u0448\u0442\u043e \u0437\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u044f\u043d\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u041c\u0430\u0433\u0443\u0442\u043d\u044b\u043c, \u0430 \u045e \u0434\u043d\u0456 \u041c\u0430\u0439\u0441\u0435\u044f \u0451\u043d \u0440\u0430\u0437\u0430\u043c \u0437 \u041a\u0430\u043b\u0435\u0431\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u042d\u0444\u043e\u043d\u044b, \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0441\u0445\u043e\u0434\u0430\u043c, \u043a\u0430\u0431 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443 \u0434\u044b \u0441\u0446\u0456\u0448\u044b\u0446\u044c \u0437\u043b\u043e\u0441\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u044f\u043d\u044b \u045e\u0434\u0432\u0443\u0445 \u0431\u044b\u043b\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0437 \u043b\u0456\u043a\u0443 \u0448\u0430\u0441\u0446\u0456\u0441\u043e\u0442 \u0442\u044b\u0441\u044f\u0447 \u043f\u0435\u0448\u044b\u0445 \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u0430\u0447\u044b\u043b\u0430\u0441\u044f \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c. \u041f\u0430\u043d \u0430\u0434\u0430\u0440\u044b\u045e \u041a\u0430\u043b\u0435\u0431\u0430 \u0441\u0456\u043b\u0430\u044e, \u044f\u043a\u0430\u044f \u0430\u0436 \u0434\u0430 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u044b \u0456\u043c, \u043a\u0430\u0431 \u0443\u0437\u044b\u0448\u043e\u045e \u0451\u043d \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u044f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0422\u0430\u043a \u0443\u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430 &ndash; \u0456\u0441\u0446\u0456 \u0437\u0430 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 46, 5. 3\u0430. 4\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0451\u043d \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u043a\u0430\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0456 \u0430\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u044f\u0433\u043e \u043d\u0430\u0432\u043e\u043a\u0430\u043b, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d, <span style=\"color: #ff0000;\">\/<\/span> \u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043a\u0430\u043c\u044f\u043d\u0456\u0441\u0442\u044b \u0433\u0440\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u043e\u0446\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0434\u0430 \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a\u043e\u0435? \u0426\u0456 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u0433\u043e \u0440\u0443\u0446\u044d \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d,<span style=\"color: #ff0000;\"> \/<\/span> \u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043a\u0430\u043c\u044f\u043d\u0456\u0441\u0442\u044b \u0433\u0440\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u043e\u0446\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"102","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">1, 1-18&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0440\u043e\u0434 \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u041c\u0430\u0439\u0441\u0435\u044f, \u0441\u043b\u0443\u0433\u0456 \u041f\u0430\u043d\u0430, \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0443, \u0441\u044b\u043d\u0443 \u041d\u0443\u043d\u0430, \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u0441\u0435\u0435\u0432\u0430\u043c\u0443: &laquo;\u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u043f\u0430\u043c\u0451\u0440. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0443\u0441\u0442\u0430\u043d\u044c \u0456 \u043f\u0435\u0440\u0430\u0439\u0434\u0437\u0456 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d \u0433\u044d\u0442\u044b, \u0442\u044b \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b, \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u044e \u0456\u043c, \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041a\u043e\u0436\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u043d\u0430 \u044f\u043a\u043e\u0435 \u0441\u0442\u0443\u043f\u044f\u0446\u044c \u0441\u0442\u0443\u043f\u043d\u0456 \u043d\u043e\u0433 \u0432\u0430\u0448\u044b\u0445, \u042f \u0434\u0430\u043c \u0432\u0430\u043c, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u042f \u041c\u0430\u0439\u0441\u0435\u044e. \u0410\u0434 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0456 \u041b\u0456\u0431\u0430\u043d\u0430 \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u043a\u0456, \u0440\u0430\u043a\u0456 \u0415\u045e\u0444\u0440\u0430\u0442 &ndash; \u0433\u044d\u0442\u0430 \u0432\u0430\u0448\u0430\u044f \u0437\u044f\u043c\u043b\u044f; \u043c\u0435\u0436\u044b \u0432\u0430\u0448\u044b\u044f &ndash; \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u0445\u0435\u0442\u0430\u045e \u0430\u0436 \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043c\u043e\u0440\u0430 \u043d\u0430 \u0437\u0430\u0445\u0430\u0434\u0437\u0435. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0442\u0432\u0430\u0439\u0433\u043e. \u042f\u043a \u0431\u044b\u045e \u042f \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0442\u0430\u043a \u0431\u0443\u0434\u0443 \u0456 \u0437 \u0442\u0430\u0431\u043e\u044e. \u041d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u043b\u044e\u0441\u044f \u0430\u0434 \u0446\u044f\u0431\u0435 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b, \u0431\u043e \u0442\u044b \u0434\u0430\u0441\u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u043c\u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u042f \u0430\u0431\u044f\u0446\u0430\u045e \u0434\u0430\u0446\u044c \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u0456\u0445\u043d\u0456\u043c. \u0422\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u0443\u0436\u043d\u044b, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439 \u0443\u0432\u0435\u0441\u044c \u0437\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435 \u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439. \u041d\u0435 \u045e\u0445\u0456\u043b\u044f\u0439\u0441\u044f \u0430\u0434 \u044f\u0433\u043e \u043d\u0456 \u045e\u043f\u0440\u0430\u0432\u0430, \u043d\u0456 \u045e\u043b\u0435\u0432\u0430, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043f\u043e\u0441\u043f\u0435\u0445 \u0443\u0441\u044e\u0434\u044b, \u0434\u0437\u0435 \u043f\u043e\u0439\u0434\u0437\u0435\u0448. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443 \u0430\u0434 \u0432\u0443\u0441\u043d\u0430\u045e \u0442\u0432\u0430\u0456\u0445; \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0430\u0434 \u0451\u0439 \u0443\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b, \u043a\u0430\u0431 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u045e \u0451\u0439 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430. \u0422\u0430\u0434\u044b \u0442\u0430\u0431\u0435 \u043f\u0430\u0448\u0430\u043d\u0446\u0443\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u043f\u043e\u0441\u043f\u0435\u0445. \u0426\u0456 \u0436 \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u042f \u0442\u0430\u0431\u0435: \u0431\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0441\u044f, \u0431\u043e \u0437 \u0442\u0430\u0431\u043e\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0443\u0441\u044e\u0434\u044b, \u043a\u0443\u0434\u044b \u043d\u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0448&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0440\u0430\u0439\u0434\u0437\u0456\u0446\u0435 \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043b\u0430\u0433\u0435\u0440\u0430 \u0456 \u0434\u0430\u0439\u0446\u0435 \u043d\u0430\u043a\u0430\u0437 \u043d\u0430\u0440\u043e\u0434\u0443: &ldquo;\u041f\u0440\u044b\u0433\u0430\u0442\u0443\u0439\u0446\u0435 \u0441\u0430\u0431\u0435 \u0435\u0436\u0443, \u0431\u043e \u043f\u0440\u0430\u0437 \u0442\u0440\u044b \u0434\u043d\u0456 \u0432\u044b \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d, \u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u0456 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u0451\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u0434\u0430\u0435 \u0432\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044e \u0420\u0443\u0431\u044d\u043d\u0430, \u0413\u0430\u0434\u0430 \u0456 \u043f\u0430\u043b\u043e\u0432\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423\u0441\u043f\u043e\u043c\u043d\u0456\u0446\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u043b\u0443\u0433\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u043a\u0430\u0437\u0430\u045e: &ldquo;\u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0456 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e&rdquo;. \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0436\u043e\u043d\u043a\u0456 \u0456 \u0434\u0437\u0435\u0446\u0456, \u0432\u0430\u0448\u044b\u044f \u0441\u0442\u0430\u0442\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0437\u044f\u043c\u043b\u0456 \u0437\u0430 \u042f\u0440\u0434\u0430\u043d\u0430\u043c, \u0430 \u0432\u044b \u045e\u0441\u0435, \u043c\u0443\u0436\u043d\u044b\u044f \u0432\u0430\u044f\u0440\u044b, \u0456\u0434\u0437\u0456\u0446\u0435, \u0443\u0437\u0431\u0440\u043e\u0456\u045e\u0448\u044b\u0441\u044f, \u043f\u0435\u0440\u0430\u0434 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456, \u043a\u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u0456\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u041f\u0430\u043d \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0431\u0440\u0430\u0442\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u044f\u043a \u0456 \u0432\u0430\u043c, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a \u0456 \u0432\u044b, \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u0434\u0430\u0435 \u0456\u043c. \u0422\u0430\u0434\u044b \u0432\u0435\u0440\u043d\u0435\u0446\u0435\u0441\u044f \u045e \u0437\u044f\u043c\u043b\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0432\u0430\u0448\u0430\u0439, \u044f\u043a\u0443\u044e \u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u043b\u0443\u0433\u0430 \u041f\u0430\u043d\u0430, \u0434\u0430\u045e \u0432\u0430\u043c \u0437\u0430 \u042f\u0440\u0434\u0430\u043d\u0430\u043c \u043d\u0430 \u045e\u0441\u0445\u043e\u0434\u0437\u0435, \u0456 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0435\u0446\u0435 \u0451\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c, \u0437\u0440\u043e\u0431\u0456\u043c, \u0456 \u043a\u0443\u0434\u044b \u043d\u0456 \u043f\u0430\u0448\u043b\u0435\u0448 \u043d\u0430\u0441, \u043f\u043e\u0439\u0434\u0437\u0435\u043c. \u042f\u043a \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u044b \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u044f, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0456 \u0446\u044f\u0431\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u044f\u043a \u0431\u044b\u045e \u0401\u043d \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0431\u0443\u043d\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0437\u0430\u0433\u0430\u0434\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430\u045e \u0442\u0432\u0430\u0456\u0445 \u0432\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0442\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u0435\u0448 \u044f\u043c\u0443, \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b. \u0422\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041d\u0430\u0432 1, 5b. 9; \u043f\u0430\u0440. \u0414\u0440\u0433 31, 20\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0431\u044b\u045e \u042f \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0442\u0430\u043a \u0431\u0443\u0434\u0443 \u0456 \u0437 \u0442\u0430\u0431\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. <span style=\"color: #ff0000;\">*<\/span> \u0411\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b, \u0431\u043e \u0442\u044b \u045e\u0432\u044f\u0434\u0437\u0435\u0448 \u043d\u0430\u0440\u043e\u0434 \u043c\u043e\u0439 \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u0430\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0431\u043e \u0437 \u0442\u0430\u0431\u043e\u044e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u043a\u0443\u0434\u044b \u0431 \u043d\u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0442\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b, \u0431\u043e \u0442\u044b \u045e\u0432\u044f\u0434\u0437\u0435\u0448 \u043d\u0430\u0440\u043e\u0434 \u043c\u043e\u0439 \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u0430\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"103","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">2, 1-24<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423 \u0432\u0435\u0440\u044b \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430 \u0420\u0430\u0445\u0430\u0431 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u0441\u043b\u0430\u045e \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u0437 \u0421\u0456\u0442\u044b\u043c\u0430 \u0434\u0432\u0443\u0445 \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0442\u0430\u0435\u043c\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435, \u0440\u0430\u0437\u0433\u043b\u0435\u0434\u0437\u044c\u0446\u0435 \u043a\u0440\u0430\u0456\u043d\u0443 \u0456 \u0415\u0440\u044b\u0445\u043e\u043d&raquo;. \u042f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0434\u043e\u043c \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u044b \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0420\u0430\u0445\u0430\u0431, \u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043c \u043d\u0430\u043d\u0430\u0447. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u043a\u0430\u0440\u0430\u043b\u044e \u0415\u0440\u044b\u0445\u043e\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0412\u043e\u0441\u044c, \u043d\u0435\u0439\u043a\u0456\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0437 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0441\u044e\u0434\u044b \u045e \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447, \u043a\u0430\u0431 \u0440\u0430\u0437\u0433\u043b\u0435\u0434\u0437\u0435\u0446\u044c \u043a\u0440\u0430\u0456\u043d\u0443&raquo;. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0440\u044b\u0445\u043e\u043d\u0430 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0420\u0430\u0445\u0430\u0431: &laquo;\u0412\u044b\u0432\u044f\u0434\u0437\u0456 \u043c\u0443\u0436\u0447\u044b\u043d, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0446\u044f\u0431\u0435, \u044f\u043a\u0456\u044f \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0434\u043e\u043c \u0442\u0432\u043e\u0439, \u0431\u043e \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0440\u0430\u0437\u0432\u0435\u0434\u0430\u0446\u044c \u0443\u0441\u044e \u043a\u0440\u0430\u0456\u043d\u0443&raquo;. \u0410\u043b\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u045e\u0437\u044f\u043b\u0430 \u0434\u0432\u0443\u0445 \u0433\u044d\u0442\u044b\u0445 \u043c\u0443\u0436\u0447\u044b\u043d, \u0441\u0445\u0430\u0432\u0430\u043b\u0430 \u0456\u0445 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0422\u0430\u043a, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0430\u0434\u043a\u0443\u043b\u044c \u044f\u043d\u044b. \u041d\u0430 \u0437\u043c\u044f\u0440\u043a\u0430\u043d\u043d\u0456, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u0437\u0430\u0447\u044b\u043d\u0456\u043b\u0456 \u0431\u0440\u0430\u043c\u044b, \u044f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456. \u041d\u0435 \u0432\u0435\u0434\u0430\u044e, \u043a\u0443\u0434\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u044b. \u0413\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0445\u0443\u0442\u0447\u044d\u0439 \u0437\u0430 \u0456\u043c\u0456, \u043c\u043e\u0436\u0430 \u0434\u0430\u0433\u043e\u043d\u0456\u0446\u0435 \u0456\u0445&raquo;. \u0410 \u0441\u0430\u043c\u0430 \u0437\u0430\u0432\u044f\u043b\u0430 \u0456\u0445 \u043d\u0430 \u0434\u0430\u0445 \u0456 \u0441\u0445\u0430\u0432\u0430\u043b\u0430 \u045e \u0441\u043d\u0430\u043f\u0430\u0445 \u043b\u0451\u043d\u0443, \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b\u0445 \u043d\u0430 \u0434\u0430\u0445\u0443. \u041f\u0430\u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0437\u0430 \u0456\u043c\u0456 \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u0434\u0430 \u042f\u0440\u0434\u0430\u043d\u0430 \u0434\u0430 \u0441\u0430\u043c\u0430\u0439 \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u044b, \u0430 \u0431\u0440\u0430\u043c\u044b, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0439\u0448\u043b\u0430 \u043f\u0430\u0433\u043e\u043d\u044f, \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u0430\u0447\u044b\u043d\u0456\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0436, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u043b\u0435\u0433\u043b\u0456 \u0441\u043f\u0430\u0446\u044c, \u043f\u0430\u0434\u043d\u044f\u043b\u0430\u0441\u044f \u0434\u0430 \u0456\u0445 \u043d\u0430 \u0434\u0430\u0445 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u0430\u043c: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u041f\u0430\u043d \u0432\u0430\u043c \u0434\u0430\u045e \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0442\u0430\u043c\u0443 \u043c\u044b \u0431\u0430\u0456\u043c\u0441\u044f \u0432\u0430\u0441, \u0456 \u045e\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u0430\u0456\u043d\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u044e\u0446\u044c \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456. \u0411\u043e \u0447\u0443\u043b\u0456 \u043c\u044b, \u044f\u043a \u041f\u0430\u043d \u0432\u044b\u0441\u0443\u0448\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u0432\u043e\u0434\u044b \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430, \u043a\u0430\u043b\u0456 \u0432\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0456 \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0432\u044b \u0437 \u0434\u0432\u0443\u043c\u0430 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0410\u043c\u0430\u0440\u044d\u044f\u045e, \u0448\u0442\u043e \u0436\u044b\u0432\u0443\u0446\u044c \u0437\u0430 \u042f\u0440\u0434\u0430\u043d\u0430\u043c, \u0437 \u0421\u0456\u0445\u043e\u043d\u0430\u043c \u0456 \u041e\u0433\u0430\u043c, \u043d\u0430 \u044f\u043a\u0456\u0445 \u0432\u044b \u043a\u0456\u043d\u0443\u043b\u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0430\u0441\u043b\u0430\u0431\u0435\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0432\u0430\u0433\u0456 \u0441\u044f\u0440\u043e\u0434 \u043c\u0443\u0436\u0447\u044b\u043d \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456, \u0431\u043e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u043d\u0430 \u043d\u0435\u0431\u0435 \u045e\u0433\u0430\u0440\u044b \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u045e\u043d\u0456\u0437\u0435. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0456\u0446\u0435 \u043c\u043d\u0435 \u041f\u0430\u043d\u0430\u043c, \u0448\u0442\u043e \u044f\u043a \u044f \u0430\u043a\u0430\u0437\u0430\u043b\u0430 \u0432\u0430\u043c \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u0430\u043a \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0431\u0430\u0446\u044c\u043a\u0456 \u043c\u0430\u0439\u0433\u043e. \u0414\u0430\u0439\u0446\u0435 \u043c\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0437\u043d\u0430\u043a, \u0448\u0442\u043e \u043f\u0430\u043a\u0456\u043d\u0435\u0446\u0435 \u0436\u044b\u0432\u044b\u043c \u0431\u0430\u0446\u044c\u043a\u0443 \u043c\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u043c\u0430\u044e, \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0441\u044f\u0441\u0446\u0451\u0440 \u043c\u0430\u0456\u0445, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0456\u0445\u043d\u044f\u0435, \u0456 \u045e\u0440\u0430\u0442\u0443\u0435\u0446\u0435 \u043d\u0430\u0448\u044b\u044f \u0436\u044b\u0446\u0446\u0456 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456&raquo;. \u0410\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u0451\u0439 \u043c\u0443\u0436\u0447\u044b\u043d\u044b: &laquo;\u041a\u043b\u044f\u043d\u0451\u043c\u0441\u044f \u0432\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u0432\u044b\u043a\u0440\u044b\u0435\u0446\u0435 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0430\u0448\u0430\u0439 \u0456 \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u043c\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u043c \u0437 \u0442\u0430\u0431\u043e\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b&raquo;. \u0422\u0430\u0434\u044b \u044f\u043d\u0430 \u0441\u043f\u0443\u0441\u0446\u0456\u043b\u0430 \u0456\u0445 \u043d\u0430 \u0432\u044f\u0440\u043e\u045e\u0446\u044b \u043f\u0440\u0430\u0437 \u0430\u043a\u043d\u043e, \u0431\u043e \u0434\u043e\u043c \u044f\u0435 \u0431\u044b\u045e \u0443 \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0456\u043c \u043c\u0443\u0440\u044b \u0456 \u044f\u043d\u0430 \u0436\u044b\u043b\u0430 \u045e \u043c\u0443\u0440\u044b. \u042f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0456\u043c: &laquo;\u0423\u0446\u044f\u043a\u0430\u0439\u0446\u0435 \u045e \u0433\u043e\u0440\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0456\u0441\u044f \u0432\u044b \u0437 \u043f\u0430\u0433\u043e\u043d\u044f\u044e, \u0456 \u0445\u0430\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u043c \u0442\u0440\u044b \u0434\u043d\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0433\u043e\u043d\u044f, \u0430 \u043f\u0430\u0441\u043b\u044f \u0456\u0434\u0437\u0456\u0446\u0435 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0451\u0439: &laquo;\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u043e\u043b\u044c\u043d\u044b\u044f \u0430\u0434 \u043f\u0440\u044b\u0441\u044f\u0433\u0456, \u044f\u043a\u0443\u044e \u0442\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0448 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435: \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u044d\u0442\u044b \u043a\u0440\u0430\u0439, \u043f\u0440\u044b\u0432\u044f\u0436\u044b \u0447\u044b\u0440\u0432\u043e\u043d\u0443\u044e \u0441\u0442\u0443\u0436\u043a\u0443 \u0434\u0430 \u0430\u043a\u043d\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u0442\u044b \u0441\u043f\u0443\u0441\u0446\u0456\u043b\u0430 \u043d\u0430\u0441. \u0410 \u0431\u0430\u0446\u044c\u043a\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u0442\u0432\u0430\u044e, \u0431\u0440\u0430\u0442\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0456 \u045e\u0441\u044e \u0441\u044f\u043c&rsquo;\u044e \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u0437\u044c\u043c\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e \u0434\u043e\u043c. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0434\u043e\u043c\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u0432\u043e\u043d\u043a\u0456, \u0441\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430 \u043d\u0435 \u043c\u044b. \u0406 \u0437\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e \u045e \u0434\u043e\u043c\u0435, \u0430\u0434\u043a\u0430\u0436\u0430\u043c \u043c\u044b, \u043a\u0430\u043b\u0456 \u0447\u044b\u044f-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0440\u0443\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0436 \u0442\u044b \u0440\u0430\u0441\u043a\u0430\u0436\u0430\u0448 \u043f\u0440\u0430 \u0433\u044d\u0442\u0443\u044e \u043d\u0430\u0448\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u043e\u043b\u044c\u043d\u044b\u044f \u0430\u0434 \u043f\u0440\u044b\u0441\u044f\u0433\u0456, \u044f\u043a\u0443\u044e \u0442\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435&raquo;. \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0430\u0448\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e&raquo;. \u0406 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u043b\u0430 \u0456\u0445, \u0430 \u044f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456. \u042f\u043d\u0430 \u0436 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043b\u0430 \u0434\u0430 \u0430\u043a\u043d\u0430 \u0447\u044b\u0440\u0432\u043e\u043d\u0443\u044e \u0441\u0442\u0443\u0436\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u044b\u0448\u043e\u045e\u0448\u044b, \u044f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u0433\u043e\u0440\u044b \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043c \u0442\u0440\u044b \u0434\u043d\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u043f\u0430\u0433\u043e\u043d\u044f. \u0422\u044b\u044f, \u0448\u0442\u043e \u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u0456\u043c\u0456, \u0448\u0443\u043a\u0430\u043b\u0456 \u0456\u0445 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0437\u0435 \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456. \u0422\u0430\u043c\u0443 \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0432\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u043a\u0430\u043b\u0456 \u0441\u044b\u0448\u043b\u0456 \u0437 \u0433\u043e\u0440 \u0456 \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0440\u0430\u043a\u0443. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u0434\u0430 \u0415\u0437\u0443\u0441\u0430, \u0441\u044b\u043d\u0430 \u041d\u0443\u043d\u0430, \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437 \u0456\u043c\u0456 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f. \u042f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u041f\u0430\u043d \u0434\u0430\u045e \u0443\u0441\u044e \u0437\u044f\u043c\u043b\u044e \u0433\u044d\u0442\u0443\u044e \u045e \u0440\u0443\u043a\u0456 \u043d\u0430\u0448\u044b\u044f, \u0430 \u045e\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456 \u0433\u044d\u0442\u0430\u0439 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0430\u0434\u0432\u0430\u0433\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043a 2, 24-26; \u0413\u0431\u0440 11, 31<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0443\u0447\u044b\u043d\u043a\u0456, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0420\u0430\u0445\u0430\u0431, \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430, \u0446\u0456 \u0436 \u043d\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0431\u044b\u043b\u0430 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u043b\u0430 \u0456\u0445 \u0456\u043d\u0448\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439? <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e, \u044f\u043a \u0446\u0435\u043b\u0430 \u0431\u0435\u0437 \u0434\u0443\u0445\u0443 \u043c\u0451\u0440\u0442\u0432\u0430\u0435, \u0442\u0430\u043a \u0456 \u0432\u0435\u0440\u0430 \u043c\u0451\u0440\u0442\u0432\u0430\u044f \u0431\u0435\u0437 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0432\u0435\u0440\u044b \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430 \u0420\u0430\u0445\u0430\u0431 \u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u043b\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u044f\u0432\u0435\u0440\u0443\u0447\u044b\u043c\u0456, \u0431\u043e \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e, \u044f\u043a \u0446\u0435\u043b\u0430 \u0431\u0435\u0437 \u0434\u0443\u0445\u0443 \u043c\u0451\u0440\u0442\u0432\u0430\u0435, \u0442\u0430\u043a \u0456 \u0432\u0435\u0440\u0430 \u043c\u0451\u0440\u0442\u0432\u0430\u044f \u0431\u0435\u0437 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"104","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">3, 1-17; 4, 14-19; 5, 10-12&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0430\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u042f\u0440\u0434\u0430\u043d \u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435 \u041f\u0430\u0441\u0445\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0441\u0442\u0430\u045e \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0441\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0421\u0456\u0442\u044b\u043c\u0430, \u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u0434\u0430 \u042f\u0440\u0434\u0430\u043d\u0430. \u041f\u0435\u0440\u0430\u043d\u0430\u0447\u0430\u0432\u0430\u043b\u0456 \u0442\u0430\u043c, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u0456\u043b\u0456\u0441\u044f. \u041f\u0440\u0430\u0437 \u0442\u0440\u044b \u0434\u043d\u0456 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043b\u0430\u0433\u0435\u0440\u0430 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e-\u043b\u0435\u0432\u0456\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0435\u0441\u0446\u0456 \u044f\u0433\u043e, \u0442\u0430\u0434\u044b \u0440\u0443\u0448\u0446\u0435 \u0437 \u043c\u0435\u0441\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u0456\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u0456\u043c. \u0410\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0456 \u0456\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u043a\u0430\u043b\u044f \u0434\u0437\u0432\u044e\u0445 \u0442\u044b\u0441\u044f\u0447 \u043b\u043e\u043a\u0446\u044f\u045e \u0434\u0430\u045e\u0436\u044b\u043d\u0451\u044e. \u041d\u0435 \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u0434\u0430 \u044f\u0433\u043e \u0431\u043b\u0456\u0437\u043a\u0430, \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456, \u0431\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0432\u044b \u043d\u0435 \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435\u0441\u044f, \u0431\u043e \u0437\u0430\u045e\u0442\u0440\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u041f\u0430\u043d \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0446\u0443\u0434\u044b&raquo;. \u0410 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u0456\u0434\u0437\u0456\u0446\u0435 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c&raquo;. \u0422\u044b\u044f \u045e\u0437\u044f\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0421\u0451\u043d\u043d\u044f \u042f \u043f\u0430\u0447\u043d\u0443 \u045e\u0437\u0432\u044b\u0448\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u043a\u0430\u0431 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u044f\u043a \u042f \u0431\u044b\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0442\u0430\u043a \u0431\u0443\u0434\u0443 \u0456 \u0437 \u0442\u0430\u0431\u043e\u044e. \u0410 \u0442\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c, \u044f\u043a\u0456\u044f \u043d\u043e\u0441\u044f\u0446\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: &ldquo;\u041a\u0430\u043b\u0456 \u043f\u0430\u0434\u044b\u0434\u0437\u0435\u0446\u0435 \u0434\u0430 \u0431\u0435\u0440\u0430\u0433\u0443 \u0432\u043e\u0434\u0430\u045e \u042f\u0440\u0434\u0430\u043d\u0430, \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u045e \u042f\u0440\u0434\u0430\u043d\u0435&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u041f\u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0441\u044e\u0434\u044b \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430&raquo;. \u0406 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0434\u0430\u043b\u0435\u0439: &laquo;\u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0411\u043e\u0433 \u0416\u044b\u0432\u044b \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456 \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0440\u0430\u0433\u043e\u043d\u0456\u0446\u044c \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430\u045e, \u0445\u0435\u0442\u0430\u045e, \u0445\u0456\u0432\u0456\u0442\u0430\u045e, \u043f\u044d\u0440\u044d\u0437\u0456\u0442\u0430\u045e, \u0433\u0456\u0440\u0433\u0430\u0448\u044b\u0442\u0430\u045e, \u0430\u043c\u0430\u0440\u044d\u044f\u045e \u0456 \u0435\u0431\u0443\u0441\u0456\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0432\u0430\u0448\u044b\u043c. \u0412\u043e\u0441\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d. \u0426\u044f\u043f\u0435\u0440 \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0441\u0430\u0431\u0435 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u043c\u0443\u0436\u0447\u044b\u043d, \u043f\u0430 \u0430\u0434\u043d\u044b\u043c \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u044f\u0441\u0443\u0446\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u043f\u0430\u0441\u0442\u0430\u0432\u044f\u0446\u044c \u0441\u0432\u0430\u0435 \u043d\u043e\u0433\u0456 \u045e \u0432\u043e\u0434\u044b \u042f\u0440\u0434\u0430\u043d\u0430, \u044f\u043d\u044b \u0440\u0430\u0437\u0434\u0437\u0435\u043b\u044f\u0446\u0446\u0430, \u0456 \u0442\u044b\u044f, \u0448\u0442\u043e \u0446\u044f\u043a\u0443\u0446\u044c \u0437\u0432\u0435\u0440\u0445\u0443, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u0430\u043b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u043c\u0451\u0442\u0430\u045e, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d, \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u043f\u0430\u0439\u0448\u043b\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443. \u0406 \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b \u043f\u0430\u0434\u044b\u0448\u043b\u0456 \u0434\u0430 \u042f\u0440\u0434\u0430\u043d\u0430 \u0456 \u043d\u043e\u0433\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u045e \u043f\u0440\u044b\u0431\u044f\u0440\u044d\u0436\u043d\u0443\u044e \u0432\u0430\u0434\u0443, \u0430 \u042f\u0440\u0434\u0430\u043d \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0431\u0435\u0440\u0430\u0433\u043e\u045e \u0441\u0432\u0430\u0456\u0445 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u045e\u0441\u044f\u0433\u043e \u0436\u043d\u0456\u0432\u0430, \u0442\u0430\u0434\u044b \u0441\u043f\u044b\u043d\u0456\u043b\u0456\u0441\u044f \u0432\u043e\u0434\u044b, \u0448\u0442\u043e \u0446\u044f\u043a\u0443\u0446\u044c \u0437\u0432\u0435\u0440\u0445\u0443, \u0456 \u0441\u0442\u0430\u043b\u0456 \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u0430\u043b \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u0456 \u0430\u0434 \u0433\u043e\u0440\u0430\u0434\u0430 \u0410\u0434\u0430\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u044f \u0421\u0430\u0440\u0442\u0430\u043d\u0430. \u0410 \u043d\u0456\u0436\u044d\u0439\u0448\u044b\u044f \u0432\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u043f\u043b\u044b\u043b\u0456 \u0434\u0430 \u0410\u0440\u0430\u0431\u0441\u043a\u0430\u0433\u0430 \u043c\u043e\u0440\u0430, \u0430\u0431\u043e \u0421\u0430\u043b\u0451\u043d\u0430\u0433\u0430, \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0437\u044f\u043b\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u0456\u0445. \u0406 \u043d\u0430\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430, \u0446\u0432\u0451\u0440\u0434\u0430 \u0441\u0442\u0430\u044f\u043b\u0456 \u043d\u0430 \u0441\u0443\u0448\u044b \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u042f\u0440\u0434\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e \u043f\u0435\u0440\u0430\u0445\u043e\u0434 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u044f\u043d\u044b \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u044f\u0433\u043e, \u044f\u043a \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u044f \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0417\u0430\u0433\u0430\u0434\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c, \u044f\u043a\u0456\u044f \u043d\u044f\u0441\u0443\u0446\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u0432\u044b\u0439\u0441\u0446\u0456 \u0437 \u042f\u0440\u0434\u0430\u043d\u0430&raquo;. \u0422\u0430\u0434\u044b \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c: &laquo;\u0412\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0437 \u042f\u0440\u0434\u0430\u043d\u0430&raquo;. \u0410 \u043a\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430, \u0432\u044b\u0439\u0448\u043b\u0456 \u0437 \u042f\u0440\u0434\u0430\u043d\u0430, \u0430 \u0441\u0442\u0443\u043f\u043d\u0456 \u043d\u043e\u0433 \u0456\u0445\u043d\u0456\u0445 \u0441\u0442\u0430\u043b\u0456 \u043d\u0430 \u0441\u0443\u0445\u043e\u0439 \u0437\u044f\u043c\u043b\u0456, \u0432\u043e\u0434\u044b \u042f\u0440\u0434\u0430\u043d\u0430 \u043f\u0430\u043f\u043b\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0451 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u043f\u0430\u0432\u0435\u0440\u0445 \u0443\u0441\u0456\u0445 \u0431\u0435\u0440\u0430\u0433\u043e\u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0439\u0448\u0430\u045e \u043d\u0430\u0440\u043e\u0434 \u0437 \u042f\u0440\u0434\u0430\u043d\u0430 \u045e \u0434\u0437\u044f\u0441\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u043b\u0430\u0433\u0435\u0440 \u0443 \u0413\u0456\u043b\u044c\u0433\u0430\u043b\u0435, \u043d\u0430 \u045e\u0441\u0445\u043e\u0434\u043d\u0456\u043c \u0431\u0430\u043a\u0443 \u0415\u0440\u044b\u0445\u043e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043b\u0430\u0433\u0435\u0440 \u0443 \u0413\u0456\u043b\u044c\u0433\u0430\u043b\u0435, \u0443\u0432\u0435\u0447\u0430\u0440\u044b \u043d\u0430 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430 \u044f\u043d\u044b \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043b\u0456 \u041f\u0430\u0441\u0445\u0443 \u043d\u0430 \u0435\u0440\u044b\u0445\u043e\u043d\u0441\u043a\u0430\u0439 \u0440\u0430\u045e\u043d\u0456\u043d\u0435. \u041d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0436 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u0441\u0445\u0456 \u0435\u043b\u0456 \u0437 \u043f\u043b\u0430\u0434\u043e\u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456 \u0456 \u043f\u0440\u0430\u0436\u0430\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435 \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c. \u041c\u0430\u043d\u043d\u0430 \u0436 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u0434\u0430\u0446\u044c \u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0435\u0441\u0446\u0456 \u0437 \u043f\u043b\u0430\u0434\u043e\u045e \u0437\u044f\u043c\u043b\u0456. \u0406 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u043d\u043d\u044b \u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0435\u043b\u0456 \u044f\u043d\u044b \u045e \u0433\u044d\u0442\u044b \u0433\u043e\u0434 \u043f\u043b\u0451\u043d \u0437\u044f\u043c\u043b\u0456 \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041d\u0430\u0432 4, 22-25; \u041f\u0441 114 (113\u0410), 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0432\u044b\u0441\u0443\u0448\u044b\u045e \u044f\u0433\u043e \u0432\u043e\u0434\u044b, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0443\u0447\u044b\u043d\u0456\u045e \u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u044b\u043c \u043c\u043e\u0440\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u044f\u043c\u043b\u0456, \u0448\u0442\u043e \u043c\u043e\u0446\u043d\u0430\u044f \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0442\u043e \u0437 \u0442\u0430\u0431\u043e\u0439, \u043c\u043e\u0440\u0430, \u0448\u0442\u043e \u0442\u044b \u045e\u0446\u044f\u043a\u0430\u0435\u0448? \u0427\u0430\u043c\u0443, \u042f\u0440\u0434\u0430\u043d, \u0442\u044b \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u045e \u043d\u0430\u0437\u0430\u0434?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u044f\u043c\u043b\u0456, \u0448\u0442\u043e \u043c\u043e\u0446\u043d\u0430\u044f \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"105","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">5, 13 &ndash; 6, 21<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0433\u043e\u0440\u0430\u0434 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0431\u044b\u045e \u043f\u0430\u0431\u043b\u0456\u0437\u0443 \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u0451\u043d \u043f\u0430\u0434\u043d\u044f\u045e \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435 \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0456 \u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0440\u0443\u0446\u044d \u043c\u0435\u0447. \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u0456 \u0442\u044b \u0437 \u043d\u0430\u043c\u0456, \u0446\u0456 \u0437 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u043d\u0430\u0448\u044b\u043c\u0456?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435, \u044f \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0432\u043e\u0439\u0441\u043a\u0430 \u041f\u0430\u043d\u0430. \u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u0439\u0448\u043e\u045e&raquo;. \u0422\u0430\u0434\u044b \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0443\u043f\u0430\u045e \u043d\u0456\u0446\u043c\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0428\u0442\u043e \u043c\u043e\u0439 \u0432\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u043a\u0430\u0436\u0430 \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u0439\u043c\u0443?&raquo; \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0432\u043e\u0439\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0417\u0434\u044b\u043c\u0456 \u0430\u0431\u0443\u0442\u0430\u043a \u0441\u0432\u043e\u0439 \u0437 \u043d\u043e\u0433 \u0442\u0432\u0430\u0456\u0445, \u0431\u043e \u043c\u0435\u0441\u0446\u0430, \u043d\u0430 \u044f\u043a\u0456\u043c \u0442\u044b \u0441\u0442\u0430\u0456\u0448, \u0441\u0432\u044f\u0442\u043e\u0435&raquo;. \u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d. \u0410 \u0415\u0440\u044b\u0445\u043e\u043d \u0431\u044b\u045e \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u044f\u0433\u043e \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456, \u042f \u0430\u0434\u0434\u0430\u044e \u045e \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0435 \u0415\u0440\u044b\u0445\u043e\u043d \u0456 \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u0433\u043e \u043c\u0443\u0436\u043d\u044b\u0445 \u0432\u0430\u044f\u0440\u043e\u045e. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0434\u0430 \u0432\u0430\u0439\u043d\u044b, \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u043a\u043e\u043b \u0433\u043e\u0440\u0430\u0434. \u0410\u0431\u044b\u0434\u0437\u0456\u0446\u0435 \u0433\u043e\u0440\u0430\u0434 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437. \u0422\u0430\u043a \u0440\u0430\u0431\u0456 \u0448\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d. \u0421\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043d\u044f\u0445\u0430\u0439 \u043d\u044f\u0441\u0443\u0446\u044c \u0441\u0435\u043c \u0442\u0440\u0443\u0431 \u044e\u0431\u0456\u043b\u0435\u0439\u043d\u044b\u0445 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c. \u041d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0431\u044b\u0434\u0437\u0456\u0446\u0435 \u0433\u043e\u0440\u0430\u0434 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e, \u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u0442\u0440\u0443\u0431\u044f\u0446\u044c \u0443 \u0442\u0440\u0443\u0431\u044b. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u0446\u044c \u044e\u0431\u0456\u043b\u0435\u0439\u043d\u044b \u0440\u043e\u0433, \u0456 \u0432\u044b \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b, \u0442\u0430\u0434\u044b \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043d\u044f\u0445\u0430\u0439 \u043c\u043e\u0446\u043d\u0430 \u0437\u0430\u043a\u0440\u044b\u0447\u044b\u0446\u044c, \u0456 \u0430\u0431\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0442\u0430\u0434\u044b \u043c\u0443\u0440 \u0433\u0430\u0440\u0430\u0434\u0430, \u0430 \u043d\u0430\u0440\u043e\u0434 \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u044f\u0433\u043e, \u043a\u043e\u0436\u043d\u044b \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443. \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430, \u0430 \u0441\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043d\u044f\u0445\u0430\u0439 \u043d\u044f\u0441\u0443\u0446\u044c \u0441\u0435\u043c \u0442\u0440\u0443\u0431 \u044e\u0431\u0456\u043b\u0435\u0439\u043d\u044b\u0445 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c \u041f\u0430\u043d\u0430&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u0430\u043a\u0440\u0443\u0436\u044b\u0446\u0435 \u0433\u043e\u0440\u0430\u0434, \u0430 \u045e\u0437\u0431\u0440\u043e\u0435\u043d\u044b\u044f \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c \u041f\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443, \u0441\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u043b\u0456 \u0441\u0435\u043c \u0442\u0440\u0443\u0431 \u044e\u0431\u0456\u043b\u0435\u0439\u043d\u044b\u0445 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u043f\u0430\u0439\u0448\u043b\u0456 \u0456 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b, \u0430 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430 \u041f\u0430\u043d\u0430 \u0456\u0448\u043e\u045e \u0437\u0430 \u0456\u043c\u0456. \u0423\u0437\u0431\u0440\u043e\u0435\u043d\u044b\u044f \u0456\u0448\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b, \u0430 \u0456\u043d\u0448\u044b\u044f \u0456\u0448\u043b\u0456 \u0437\u0430 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c. \u0422\u0430\u043a \u044f\u043d\u044b \u0456\u0448\u043b\u0456 \u0456 \u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b. \u0410 \u043d\u0430\u0440\u043e\u0434\u0443 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0435 \u043a\u0440\u044b\u0447\u044b\u0446\u0435 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u0432\u0430\u0448 \u0433\u043e\u043b\u0430\u0441, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0434\u0430 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u044f \u043d\u0435 \u0441\u043a\u0430\u0436\u0443 \u0432\u0430\u043c: &ldquo;\u041a\u0440\u044b\u0447\u044b\u0446\u0435!&rdquo; \u0456 \u0442\u0430\u0434\u044b \u043a\u0440\u044b\u043a\u043d\u0435\u0446\u0435&raquo;. \u0406 \u043f\u0430\u043d\u0435\u0441\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430 \u041f\u0430\u043d\u0430 \u0432\u0430\u043a\u043e\u043b \u0433\u043e\u0440\u0430\u0434\u0430, \u0456 \u0430\u0431\u044b\u0448\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437. \u041f\u0430\u0441\u043b\u044f \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u043b\u0430\u0433\u0435\u0440 \u0456 \u043f\u0435\u0440\u0430\u043d\u0430\u0447\u0430\u0432\u0430\u043b\u0456 \u045e \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0443\u0441\u0442\u0430\u045e \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456. \u0421\u0432\u044f\u0442\u0430\u0440\u044b \u045e\u0437\u044f\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430, \u0430 \u0441\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u043b\u0456 \u0441\u0435\u043c \u044e\u0431\u0456\u043b\u0435\u0439\u043d\u044b\u0445 \u0442\u0440\u0443\u0431 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c \u041f\u0430\u043d\u0430, \u0456\u0448\u043b\u0456 \u0456 \u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b. \u0423\u0437\u0431\u0440\u043e\u0435\u043d\u044b\u044f \u0432\u0430\u044f\u0440\u044b \u0456\u0448\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456, \u0430 \u0456\u043d\u0448\u044b\u044f \u0456\u0448\u043b\u0456 \u0437\u0437\u0430\u0434\u0443 \u0437\u0430 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c \u041f\u0430\u043d\u0430. \u0422\u0430\u043a \u0456\u0448\u043b\u0456 \u0456 \u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b. \u041d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0434\u0437\u0435\u043d\u044c \u0437\u043d\u043e\u045e \u0430\u0431\u044b\u0448\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u0433\u043e\u0440\u0430\u0434\u0430 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0456 \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u043b\u0430\u0433\u0435\u0440. \u0420\u0430\u0431\u0456\u043b\u0456 \u0433\u044d\u0442\u0430\u043a \u0448\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d. \u0410 \u043d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0443\u0441\u0442\u0430\u043b\u0456 \u0440\u0430\u043d\u0430, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u043d\u044f\u043b\u0430\u0441\u044f \u0437\u0430\u0440\u0430, \u0456 \u0430\u0431\u044b\u0448\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u0433\u043e\u0440\u0430\u0434\u0430 \u0442\u0430\u043a\u0456\u043c \u0441\u0430\u043c\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e. \u0422\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0431\u044b\u0448\u043b\u0456 \u0433\u043e\u0440\u0430\u0434 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0451\u043c\u044b \u0440\u0430\u0437 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b, \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u041a\u0440\u044b\u0447\u044b\u0446\u0435! \u0411\u043e \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u045e \u0432\u0430\u043c \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434. \u0421\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0451\u043d \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443, \u0451\u043d \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0456\u043c. \u0422\u043e\u043b\u044c\u043a\u0456 \u0420\u0430\u0445\u0430\u0431, \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0436\u044b\u0432\u0430\u044f, \u044f\u043d\u0430 \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u045e \u044f\u0435 \u0434\u043e\u043c\u0435, \u0431\u043e \u044f\u043d\u0430 \u0441\u0445\u0430\u0432\u0430\u043b\u0430 \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u0445 \u043c\u044b \u043f\u0430\u0441\u044b\u043b\u0430\u043b\u0456. \u0412\u044b \u0436 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c, \u043a\u0430\u0431 \u0441\u0430\u043c\u0456\u043c \u043d\u0435 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u043f\u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c. \u0411\u043e \u043a\u0430\u043b\u0456 \u0432\u043e\u0437\u044c\u043c\u0435\u0446\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c, \u0442\u043e \u043d\u0430\u043a\u043b\u0456\u0447\u0430\u0446\u0435 \u043d\u0430 \u043b\u0430\u0433\u0435\u0440 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u043a\u043b\u0451\u043d \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u0435 \u044f\u043c\u0443 \u0431\u044f\u0434\u0443. \u0423\u0441\u0451 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430, \u0456 \u043f\u043e\u0441\u0443\u0434 \u043c\u0435\u0434\u043d\u044b \u0456 \u0436\u0430\u043b\u0435\u0437\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0456 \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0443 \u041f\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u043e\u0434 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e, \u0456 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b. \u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u045e \u043d\u0430\u0440\u043e\u0434 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u0442\u0440\u0443\u0431\u044b, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0430 \u043c\u0443\u0440 \u0430\u0431\u0432\u0430\u043b\u0456\u045e\u0441\u044f. \u0406 \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u043d\u0430\u0440\u043e\u0434 \u0443 \u0433\u043e\u0440\u0430\u0434, \u043a\u043e\u0436\u043d\u044b \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443, \u0456 \u0437\u0430\u0445\u0430\u043f\u0456\u043b\u0456 \u0433\u043e\u0440\u0430\u0434. \u0406 \u043d\u0430\u043a\u043b\u0430\u043b\u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d \u043d\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0430\u0436 \u0434\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0430\u0434 \u044e\u043d\u0430\u043a\u0430 \u0434\u0430 \u0441\u0442\u0430\u0440\u0446\u0430, \u0456 \u0430\u0436 \u0434\u0430 \u0432\u0430\u043b\u043e\u045e, \u0456 \u0430\u0432\u0435\u0447\u0430\u043a, \u0456 \u0430\u0441\u043b\u043e\u045e, &ndash; \u0443\u0441\u0451 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u043c\u0435\u0447\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 25, 1ab. 2ab; \u043f\u0430\u0440. \u0413\u0431\u0440 11, 30<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0435, \u0422\u044b &ndash; \u043c\u043e\u0439 \u0411\u043e\u0433, \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0433\u043e\u0440\u0430\u0434 \u0443 \u0433\u0440\u0443\u0434\u0443 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0451\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0440\u0430\u044e \u0431\u044b\u043b\u0456 \u0437\u0431\u0443\u0440\u0430\u043d\u044b \u043c\u0443\u0440\u044b \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u043a\u0430\u043b\u0456 \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0456\u0445 \u0432\u0430\u043a\u043e\u043b \u0441\u0435\u043c \u0434\u0437\u0451\u043d.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0433\u043e\u0440\u0430\u0434 \u0443 \u0433\u0440\u0443\u0434\u0443 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0451\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"106","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">10, 1-14; 11, 15-17<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b \u0437\u0430\u0432\u0430\u0451\u045e\u0432\u0430\u0435 \u0437\u044f\u043c\u043b\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0410\u0434\u0430\u043d\u0456\u0441\u044d\u0434\u044d\u043a, \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043f\u0430\u0447\u0443\u045e, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0437\u0434\u0430\u0431\u044b\u045e \u0410\u0439 \u0456 \u0430\u0434\u0434\u0430\u045e \u044f\u0433\u043e \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443, \u0456 \u0448\u0442\u043e \u0437 \u0410\u0439 \u0456 \u0437 \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0443\u0447\u044b\u043d\u0456\u045e \u0433\u044d\u0442\u0430\u043a, \u044f\u043a \u0437 \u0415\u0440\u044b\u0445\u043e\u043d\u0430\u043c \u0456 \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0456 \u0448\u0442\u043e \u0436\u044b\u0445\u0430\u0440\u044b \u0413\u0456\u0431\u044d\u043e\u043d\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u043b\u0456 \u043c\u0456\u0440 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u0442\u0430\u0434\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f, \u0431\u043e \u0413\u0456\u0431\u044d\u043e\u043d \u0431\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u043e\u0440\u0430\u0434\u0430\u043c, \u044f\u043a \u0430\u0434\u0437\u0456\u043d \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u0431\u043e \u0431\u044b\u045e \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0410\u0439, \u0456 \u045e\u0441\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u044f\u0433\u043e \u0431\u044b\u043b\u0456 \u0432\u0430\u044f\u0440\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u0410\u0434\u0430\u043d\u0456\u0441\u044d\u0434\u044d\u043a, \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430 \u0425\u0430\u0445\u0430\u043c\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0413\u0435\u0431\u0440\u043e\u043d\u0430, \u0456 \u0434\u0430 \u041f\u0456\u0440\u0430\u043c\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u042f\u0440\u043c\u0443\u0442\u0430, \u0456 \u0434\u0430 \u042f\u0444\u0456\u044f, \u043a\u0430\u0440\u0430\u043b\u044f \u041b\u044f\u043a\u0456\u0448\u0430, \u0456 \u0434\u0430 \u0414\u044d\u0431\u0456\u0440\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u042d\u0433\u043b\u043e\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b\u0446\u0435 \u043c\u043d\u0435 \u045e\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0413\u0456\u0431\u044d\u043e\u043d \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u043c\u0456\u0440 \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u041d\u0430\u0432\u0456\u043d\u044b\u043c \u0456 \u0441\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;. \u0406 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u043f\u044f\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0410\u043c\u0430\u0440\u044d\u0439\u0441\u043a\u0456\u0445: \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043a\u0430\u0440\u043e\u043b\u044c \u0413\u0435\u0431\u0440\u043e\u043d\u0430, \u043a\u0430\u0440\u043e\u043b\u044c \u042f\u0440\u043c\u0443\u0442\u0430, \u043a\u0430\u0440\u043e\u043b\u044c \u041b\u044f\u043a\u0456\u0448\u0430 \u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u042d\u0433\u043b\u043e\u043d\u0430. \u042f\u043d\u044b \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u0441\u0432\u043e\u0439 \u043b\u0430\u0433\u0435\u0440 \u043a\u0430\u043b\u044f \u0413\u0456\u0431\u044d\u043e\u043d\u0430, \u043a\u0430\u0431 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0413\u0456\u0431\u044d\u043e\u043d\u0430 \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0434\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u045e \u043b\u0430\u0433\u0435\u0440 \u0443 \u0413\u0456\u043b\u044c\u0433\u0430\u043b\u044c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0435 \u0430\u0434\u0432\u043e\u0434\u0437\u044c \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u0430\u0434 \u0441\u043b\u0443\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445! \u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0445\u0443\u0442\u0447\u044d\u0439, \u0443\u0440\u0430\u0442\u0443\u0439 \u043d\u0430\u0441 \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u043c, \u0431\u043e \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u0443\u0441\u0435 \u043a\u0430\u0440\u0430\u043b\u0456 \u0430\u043c\u0430\u0440\u044d\u0439\u0441\u043a\u0456\u044f, \u0448\u0442\u043e \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0433\u0430\u0440\u0430\u0445&raquo;. \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0413\u0456\u043b\u044c\u0433\u0430\u043b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c \u0443\u0437\u0431\u0440\u043e\u0435\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u0437 \u0443\u0441\u0456\u043c\u0456 \u043c\u0443\u0436\u043d\u044b\u043c\u0456 \u0432\u0430\u044f\u0440\u0430\u043c\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445, \u0431\u043e \u042f \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u0443 \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0435; \u043d\u0456\u0445\u0442\u043e \u0437 \u0456\u0445 \u043d\u0435 \u045e\u0441\u0442\u043e\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e&raquo;. \u0406 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0456\u0445 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430. \u0423\u0441\u044e \u043d\u043e\u0447 \u0456\u0448\u043e\u045e \u0451\u043d \u0437 \u0413\u0456\u043b\u044c\u0433\u0430\u043b\u044f. \u0410 \u041f\u0430\u043d \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0456\u0445 \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0456\u0445 \u043c\u043e\u0446\u043d\u0430 \u045e \u0413\u0456\u0431\u044d\u043e\u043d\u0435. \u0413\u043d\u0430\u045e \u0456\u0445 \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u0434\u0430 \u045e\u0437\u0432\u044b\u0448\u0448\u0430 \u0411\u044d\u0442 \u0425\u0430\u0440\u043e\u043d \u0456 \u0431\u0456\u045e \u0456\u0445 \u0430\u0436 \u0434\u0430 \u0410\u0437\u044d\u043a\u0456 \u0456 \u0430\u0436 \u0434\u0430 \u041c\u0430\u043a\u0435\u0434\u044b. \u0410 \u043a\u0430\u043b\u0456 \u044f\u043d\u044b, \u0443\u0446\u044f\u043a\u0430\u044e\u0447\u044b \u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0431\u044b\u043b\u0456 \u043d\u0430 \u0441\u0445\u0456\u043b\u0435 \u0411\u044d\u0442 \u0425\u0430\u0440\u043e\u043d, \u041f\u0430\u043d \u043a\u0456\u0434\u0430\u045e \u043d\u0430 \u0456\u0445 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043a\u0430\u043c\u044f\u043d\u0456 \u0430\u0436 \u0434\u0430 \u0410\u0437\u044d\u043a\u0456, \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u044f\u043d\u044b. \u0411\u043e\u043b\u044c\u0448 \u0431\u044b\u043b\u043e \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u0430\u0434 \u0433\u0440\u0430\u0434\u0443 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0447\u044b\u043c \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0437\u0430\u0431\u0456\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043c\u0435\u0447\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u041f\u0430\u043d\u0443 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0432\u044b\u0434\u0430\u045e \u041f\u0430\u043d \u0430\u043c\u0430\u0440\u044d\u044f\u045e \u0443 \u0440\u0443\u043a\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u043c\u0456: &laquo;\u0421\u043e\u043d\u0446\u0430, \u0441\u043f\u044b\u043d\u0456\u0441\u044f \u043d\u0430\u0434 \u0413\u0456\u0431\u044d\u043e\u043d\u0430\u043c, \u0456 \u0442\u044b, \u043c\u0435\u0441\u044f\u0446, \u043d\u0430\u0434 \u0434\u0430\u043b\u0456\u043d\u0430\u044e \u0410\u0439\u044f\u043b\u043e\u043d!&raquo; \u0406 \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430, \u0456 \u0441\u0442\u0430\u045e \u043c\u0435\u0441\u044f\u0446, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0430\u0440\u043e\u0434 \u043f\u043e\u043c\u0441\u0446\u0456\u045e \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c. \u0426\u0456 \u0436 \u043d\u0435 \u0433\u044d\u0442\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430: &laquo;\u0421\u0442\u0430\u043b\u0430 \u0441\u043e\u043d\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0431\u0430 \u0456 \u043d\u0435 \u0441\u043f\u044f\u0448\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u0437\u0430\u0445\u0430\u0434 \u043f\u0440\u0430\u0437 \u0443\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c&raquo;? \u0406 \u043d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u043a\u043e\u0433\u0430 \u0434\u043d\u044f \u043d\u0456 \u0440\u0430\u043d\u0435\u0439, \u043d\u0456 \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u0433\u043e\u043b\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0411\u043e \u041f\u0430\u043d \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e, \u0441\u043b\u0443\u0433\u0443 \u0421\u0432\u0430\u0439\u043c\u0443, \u0442\u0430\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443, \u0456 \u0442\u0430\u043a \u0443\u0447\u044b\u043d\u0456\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d. \u041d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u045e \u0443\u0441\u0451\u0439 \u0442\u043e\u0439 \u0437\u044f\u043c\u043b\u0451\u044e: \u0433\u043e\u0440\u0430\u043c\u0456, \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u044e \u041d\u044d\u0433\u0435\u0431, \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u044e \u0413\u0430\u0448\u044d\u043d, \u0428\u044d\u0444\u044d\u043b\u044f, \u0410\u0440\u0430\u0431\u0430, \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u043c\u0456 \u0433\u043e\u0440\u0430\u043c\u0456 \u0456 \u0456\u0445 \u0440\u0430\u045e\u043d\u0456\u043d\u0430\u043c\u0456. \u0410\u0434 \u0433\u0430\u0440\u044b \u0425\u0430\u043b\u0430\u043a, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u0441\u0446\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0421\u044d\u0456\u0440\u0430, \u0456 \u0430\u0436 \u0434\u0430 \u0411\u0430\u0430\u043b\u044c-\u0413\u0430\u0434\u0430 \u045e \u0434\u0430\u043b\u0456\u043d\u0435 \u041b\u0456\u0431\u0430\u043d\u0430 \u043a\u0430\u043b\u044f \u0433\u0430\u0440\u044b \u0413\u0435\u0440\u043c\u043e\u043d. \u0421\u0445\u0430\u043f\u0456\u045e \u0443\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456\u0445\u043d\u0456\u0445, \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0456\u0445 \u0456 \u0437\u0430\u0431\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0437\u0445 34, 13. 15<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0432\u044b\u0432\u0435\u0434\u0443 \u0430\u0432\u0435\u0447\u0430\u0445 \u043c\u0430\u0456\u0445 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0437 \u043a\u0440\u0430\u0456\u043d\u0430\u045e, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445 \u0443 \u0437\u044f\u043c\u043b\u044e \u0456\u0445\u043d\u044e\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0430 \u0433\u043e\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0456 \u043f\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0441\u044f\u043b\u0435\u043d\u043d\u044f\u0445 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445 \u0456 c\u0430\u043c \u0431\u0443\u0434\u0443 \u045e\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0430 \u0433\u043e\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0456 \u043f\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0441\u044f\u043b\u0435\u043d\u043d\u044f\u0445 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"107","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">24, 1-7. 13-28<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u045e \u0410\u0431\u044f\u0446\u0430\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u0430\u0431\u0440\u0430\u045e \u0443 \u0421\u0456\u0445\u0435\u043c\u0435 \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u0433\u043e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u0456 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u0456 \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430. \u0422\u0430\u0434\u044b \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0410\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f, \u0422\u044d\u0440\u0430\u0445, \u0431\u0430\u0446\u044c\u043a\u0430 \u0410\u0431\u0433\u0430\u0433\u0430\u043c\u0430 \u0456 \u041d\u0430\u0445\u043e\u0440\u0430, \u0437\u0434\u0430\u045e\u043d\u0430 \u0436\u044b\u043b\u0456 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u0431\u0430\u043a\u0443 \u0420\u0430\u043a\u0456 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0447\u0443\u0436\u044b\u043c \u0431\u0430\u0433\u0430\u043c. \u0410\u043b\u0435 \u042f \u045e\u0437\u044f\u045e \u0431\u0430\u0446\u044c\u043a\u0443 \u0432\u0430\u0448\u0430\u0433\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0437 \u043c\u0435\u0436\u0430\u045e \u041c\u0435\u0441\u0430\u043f\u0430\u0442\u0430\u043c\u0456\u0456 \u0456 \u043f\u0440\u0430\u0432\u0451\u045e \u044f\u0433\u043e \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u041a\u0430\u043d\u0430\u0430\u043d, \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u0456 \u0434\u0430\u045e \u044f\u043c\u0443 \u0406\u0441\u0430\u0430\u043a\u0430. \u0406\u0441\u0430\u0430\u043a\u0443 \u0434\u0430\u045e \u042f\u043a\u0443\u0431\u0430 \u0456 \u042d\u0437\u0430\u0432\u0430. \u042d\u0437\u0430\u0432\u0443 \u042f \u0434\u0430\u045e \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0433\u0430\u0440\u0443 \u0421\u044d\u0456\u0440, \u0430 \u042f\u043a\u0443\u0431 \u0456 \u0441\u044b\u043d\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u044b\u0448\u043b\u0456 \u045e \u0415\u0433\u0456\u043f\u0435\u0442. \u0422\u0430\u0434\u044b \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430 \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0415\u0433\u0456\u043f\u0435\u0442 \u0446\u0443\u0434\u0430\u043c\u0456, \u0443\u0447\u044b\u043d\u0435\u043d\u044b\u043c\u0456 \u0442\u0430\u043c, \u0456 \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441. \u042f \u0432\u044b\u0432\u0435\u045e \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0456 \u0432\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043c\u043e\u0440\u0430. \u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0437 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u043c\u0456 \u0456 \u043a\u043e\u043d\u043d\u0456\u0446\u0430\u044e \u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u0430\u0439\u0446\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456 \u0430\u0436 \u0434\u0430 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430. \u0406 \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u041f\u0430\u043d\u0430, \u0430 \u0401\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c\u0456 \u0446\u0435\u043c\u0440\u0443 \u0456 \u043d\u0430\u0432\u0451\u045e \u043d\u0430 \u0456\u0445 \u043c\u043e\u0440\u0430, \u0456 \u044f\u043d\u043e \u043d\u0430\u043a\u0440\u044b\u043b\u0430 \u0456\u0445. \u0411\u0430\u0447\u044b\u043b\u0456 \u0432\u043e\u0447\u044b \u0432\u0430\u0448\u044b\u044f, \u0448\u0442\u043e \u042f \u045e\u0447\u044b\u043d\u0456\u045e \u0443 \u0415\u0433\u0456\u043f\u0446\u0435. \u041f\u043e\u0442\u044b\u043c \u0432\u044b \u0434\u043e\u045e\u0433\u0456 \u0447\u0430\u0441 \u0436\u044b\u043b\u0456 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0434\u0430\u045e \u0432\u0430\u043c \u0437\u044f\u043c\u043b\u044e, \u043d\u0430\u0434 \u044f\u043a\u043e\u044e \u0432\u044b \u043d\u0435 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456, \u0456 \u0433\u0430\u0440\u0430\u0434\u044b, \u044f\u043a\u0456\u0445 \u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456; \u0456 \u0432\u044b \u0436\u044b\u0432\u044f\u0446\u0435 \u045e \u0456\u0445, \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u0446\u0435 \u043f\u043b\u0451\u043d \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u045e \u0456 \u0430\u043b\u0456\u0432\u044b, \u044f\u043a\u0456\u0445 \u0432\u044b \u043d\u0435 \u0441\u0430\u0434\u0436\u0430\u043b\u0456. \u0426\u044f\u043f\u0435\u0440 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0411\u043e\u0433\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u042f\u043c\u0443 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u0456, \u0430\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0431\u0430\u0433\u043e\u045e, \u044f\u043a\u0456\u043c \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043f\u0440\u043e\u0434\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u045e \u041c\u0435\u0441\u0430\u043f\u0430\u0442\u0430\u043c\u0456\u0456 \u0456 \u0415\u0433\u0456\u043f\u0446\u0435, \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u041f\u0430\u043d\u0443. \u041a\u0430\u043b\u0456 \u0432\u0430\u043c \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043a\u0435\u043f\u0441\u043a\u0456\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443, \u0442\u043e \u0437\u0440\u0430\u0431\u0456\u0446\u0435 \u0441\u0451\u043d\u043d\u044f \u0432\u044b\u0431\u0430\u0440, \u043a\u0430\u043c\u0443 \u0445\u043e\u0447\u0430\u0446\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c: \u0446\u0456 \u0431\u0430\u0433\u0430\u043c, \u044f\u043a\u0456\u043c \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043f\u0440\u043e\u0434\u043a\u0456 \u0432\u0430\u0448\u044b\u044f, \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u0431\u0430\u043a\u0443 \u0420\u0430\u043a\u0456, \u0446\u0456 \u0431\u0430\u0433\u0430\u043c \u0430\u043c\u0430\u0440\u044d\u044f\u045e, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u044f\u043a\u0456\u0445 \u0436\u044b\u0432\u044f\u0446\u0435. \u042f \u0436 \u0456 \u043c\u043e\u0439 \u0434\u043e\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u043e\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0456\u043d\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u043c. \u0411\u043e \u041f\u0430\u043d &ndash; \u0411\u043e\u0433 \u043d\u0430\u0448. \u0401\u043d \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0456 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u043d\u0430\u0448\u044b\u0445 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456. \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0448\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u0432\u044f\u043b\u0456\u0437\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u0456 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u045e \u043d\u0430\u0441 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u045e\u0441\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u044f\u043a\u043e\u044e \u0456\u0448\u043b\u0456 \u043c\u044b, \u0456 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043c\u044b. \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u043d\u0430\u0432\u0430\u0442 \u0430\u043c\u0430\u0440\u044d\u044f\u045e, \u044f\u043a\u0456\u044f \u0436\u044b\u043b\u0456 \u043d\u0430 \u0442\u043e\u0439 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043c\u0443 \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443, \u0431\u043e \u0401\u043d &ndash; \u043d\u0430\u0448 \u0411\u043e\u0433&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0412\u044b \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0446\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443, \u0431\u043e \u0401\u043d \u0411\u043e\u0433 \u0441\u0432\u044f\u0442\u044b \u0456 \u0411\u043e\u0433 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u043d\u044b. \u0401\u043d \u043d\u0435 \u0434\u0430\u0440\u0443\u0435 \u0432\u0430\u043c \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0456 \u0433\u0440\u0430\u0445\u043e\u045e. \u041a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430\u043a\u0456\u043d\u0435\u0446\u0435 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0447\u043d\u0435\u0446\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0447\u0443\u0436\u044b\u043c \u0431\u0430\u0433\u0430\u043c, \u0401\u043d \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430, \u0456 \u0441\u043f\u0430\u0448\u043b\u0435 \u043d\u0430 \u0432\u0430\u0441 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456 \u0456 \u0437\u0433\u0443\u0431\u0456\u0446\u044c \u0432\u0430\u0441 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0440\u0430\u0431\u0456\u045e \u0432\u0430\u043c \u0434\u0430\u0431\u0440\u043e&raquo;. \u041d\u0430\u0440\u043e\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u041d\u0435, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443!&raquo; \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0412\u044b \u0441\u0432\u0435\u0434\u043a\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0448\u0442\u043e \u0432\u044b\u0431\u0440\u0430\u043b\u0456 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443&raquo;. \u0406 \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041c\u044b \u0441\u0432\u0435\u0434\u043a\u0456&raquo;. \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u044b\u043a \u0430\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0447\u0443\u0436\u044b\u0445 \u0431\u0430\u0433\u043e\u045e, \u0448\u0442\u043e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0456 \u0441\u0445\u0456\u043b\u0456\u0446\u0435 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;. \u0406 \u043d\u0430\u0440\u043e\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0456 \u0434\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u045e \u0421\u0456\u0445\u0435\u043c\u0435. \u0406 \u0437\u0430\u043f\u0456\u0441\u0430\u045e \u0415\u0437\u0443\u0441 \u0441\u043b\u043e\u0432\u044b \u0433\u044d\u0442\u044b\u044f \u045e \u043a\u043d\u0456\u0437\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0411\u043e\u0436\u0430\u0433\u0430, \u0456 \u045e\u0437\u044f\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u043a\u0430\u043c\u0435\u043d\u044c, \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u0442\u0430\u043c \u043f\u0430\u0434 \u0434\u0443\u0431\u0430\u043c, \u0448\u0442\u043e \u0431\u044b\u045e \u043a\u0430\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0412\u043e\u0441\u044c \u0433\u044d\u0442\u044b \u043a\u0430\u043c\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0434\u043b\u044f \u0432\u0430\u0441, \u0431\u043e \u0451\u043d \u0447\u0443\u045e \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u043d\u0430\u043c. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0434\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0430\u0434\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0430\u0434 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430&raquo;. \u0422\u0430\u0434\u044b \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0434\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041d\u0430\u0432 24, 16. 24; \u043f\u0430\u0440. 1 \u041a\u0430\u0440 8, 5-6<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0456\u043d\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u043c.<span style=\"color: #ff0000;\"> *<\/span> \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u043a \u0437\u0432\u0430\u043d\u044b\u044f \u0431\u0430\u0433\u0456 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0446\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a \u0451\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0431\u0430\u0433\u043e\u045e \u0456 \u0448\u043c\u0430\u0442 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e, \u0442\u043e \u045e \u043d\u0430\u0441 \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"111","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e<span style=\"color: #ff0000;\">&nbsp;2, 6 &ndash; 3, 4&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041a\u0430\u0440\u043e\u0442\u043a\u0456 \u043d\u0430\u0440\u044b\u0441 \u044d\u043f\u043e\u0445\u0456 \u0421\u0443\u0434\u0434\u0437\u044f\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0440\u0430\u0437\u0430\u0441\u043b\u0430\u045e \u043d\u0430\u0440\u043e\u0434, \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043a\u043e\u0436\u043d\u044b \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0437\u044f\u043c\u043b\u044e. \u041d\u0430\u0440\u043e\u0434 \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u043b\u0456 \u0436\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u0456 \u044f\u043a\u0456\u044f \u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0441\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u0443\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u0406\u043c \u0434\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u0441\u043b\u0443\u0433\u0430 \u041f\u0430\u043d\u0430 \u043f\u0430\u043c\u0451\u0440, \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u043e \u044f\u043c\u0443 \u0441\u0442\u043e \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0433\u0430\u0434\u043e\u045e. \u041f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u045e \u043c\u0435\u0436\u0430\u0445 \u043d\u0430\u0434\u0437\u0435\u043b\u0443 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u045e \u0426\u0456\u043c\u043d\u0430\u0442-\u0425\u0435\u0440\u044d\u0441, \u043d\u0430 \u0433\u0430\u0440\u044b \u042d\u0444\u0440\u0430\u0456\u043c\u0430, \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447 \u0430\u0434 \u0433\u0430\u0440\u044b \u0413\u0430\u0430\u0448. \u0406 \u043a\u0430\u043b\u0456 \u045e\u0441\u0451 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u0430\u0434\u044b\u0448\u043b\u043e \u0434\u0430 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u0441\u043b\u044f \u0456\u0445 \u0456\u043d\u0448\u0430\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0441\u043f\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0440\u0430\u0431\u0456\u043b\u0456 \u0437\u043b\u043e \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0411\u0430\u0430\u043b\u044f\u043c. \u042f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0456\u0445 \u0430\u0439\u0446\u043e\u045e, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0456\u0445 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0447\u0443\u0436\u044b\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u045e \u0441\u0443\u0441\u0435\u0434\u043d\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u042f\u043d\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0456\u043c \u0456 \u0433\u043d\u044f\u0432\u0456\u043b\u0456 \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u042f\u0433\u043e \u0456 \u0441\u043b\u0443\u0436\u0430\u0447\u044b \u0411\u0430\u0430\u043b\u044e \u0456 \u0410\u0448\u0442\u0430\u0440\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043f\u0430\u043b\u0430\u045e \u041f\u0430\u043d \u0433\u043d\u0435\u0432\u0430\u043c \u043d\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0456 \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u0443 \u0440\u0443\u043a\u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u044f\u043a\u0456\u044f \u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456 \u0456\u0445, \u0456 \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u0443 \u0440\u0443\u043a\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u0448\u0442\u043e \u0430\u043a\u0440\u0443\u0436\u0430\u043b\u0456 \u0456\u0445, \u0456 \u044f\u043d\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456. \u041a\u0443\u0434\u044b \u0431 \u044f\u043d\u044b \u043d\u0456 \u0445\u0430\u0446\u0435\u043b\u0456 \u043f\u0430\u0439\u0441\u0446\u0456, \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430, \u043d\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456\u0445\u043d\u044f\u0435, \u0443\u0441\u044e\u0434\u044b \u0431\u044b\u043b\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445, \u044f\u043a \u041f\u0430\u043d \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0456 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0456\u043c. \u0422\u0430\u043a \u044f\u043d\u044b \u0430\u043f\u044b\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u0446\u044f\u0436\u043a\u0456\u043c \u0443\u0446\u0456\u0441\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0456\u043c \u0441\u0443\u0434\u0434\u0437\u044f\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0456 \u0456\u0445 \u0430\u0434 \u0440\u0443\u043a \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u043e\u045e. \u0410\u043b\u0435 \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0456 \u0441\u0443\u0434\u0434\u0437\u044f\u045e, \u0431\u043e \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0447\u0430\u043b\u0456 \u0437 \u0447\u0443\u0436\u044b\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0456\u043c. \u042f\u043d\u044b \u0445\u0443\u0442\u043a\u0430 \u0437\u0431\u043e\u0447\u044b\u043b\u0456 \u0437 \u0434\u0430\u0440\u043e\u0433\u0456, \u044f\u043a\u043e\u044e \u0456\u0448\u043b\u0456 \u0430\u0439\u0446\u044b \u0456\u0445\u043d\u0456\u044f, \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u041f\u0430\u043d\u0430, \u0456 \u0441\u0442\u0430\u043b\u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u0451 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0456\u043c \u0441\u0443\u0434\u0434\u0437\u044f\u045e, \u0442\u043e \u041f\u0430\u043d \u0431\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0443\u0434\u0434\u0437\u0451\u044e \u0456 \u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0456\u0445 \u0430\u0434 \u0440\u0443\u043a\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u0436\u044b\u045e \u0441\u0443\u0434\u0434\u0437\u044f, \u0431\u043e \u041f\u0430\u043d \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0456\u0445, \u0447\u0443\u044e\u0447\u044b \u0456\u0445\u043d\u0456 \u0441\u0442\u043e\u0433\u043d \u043f\u0430\u0434 \u0443\u0446\u0456\u0441\u043a\u0430\u043c \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0430\u043c\u0456\u0440\u0430\u045e \u0441\u0443\u0434\u0434\u0437\u044f, \u044f\u043d\u044b \u0437\u043d\u043e\u045e \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u044f\u0448\u0447\u044d \u0433\u043e\u0440\u0448 \u0437\u0430 \u0441\u0432\u0430\u0456\u0445 \u0430\u0439\u0446\u043e\u045e, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0447\u0443\u0436\u044b\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456, \u0441\u043b\u0443\u0436\u0430\u0447\u044b \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0456\u043c. \u042f\u043d\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u043b\u0456 \u0441\u0432\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0456 \u045e\u043f\u0430\u0440\u0442\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u041f\u0430\u043d \u043d\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b \u043f\u0430\u0440\u0443\u0448\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u041c\u043e\u0439, \u044f\u043a\u0456 \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0431\u0430\u0446\u044c\u043a\u0430\u043c\u0456 \u0456\u0445\u043d\u0456\u043c\u0456, \u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e \u041c\u0430\u0439\u0433\u043e \u0433\u043e\u043b\u0430\u0441\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u042f \u043d\u0435 \u0431\u0443\u0434\u0443 \u045e\u0436\u043e \u0432\u044b\u0433\u0430\u043d\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0437 \u0442\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u0445 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d, \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u045e, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0456\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0434\u0430\u0440\u043e\u0433\u0456 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0456\u0441\u0446\u0456 \u043f\u0430 \u0451\u0439, \u044f\u043a \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u044f\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0456\u0445\u043d\u0456\u044f, \u0446\u0456 \u043d\u0435?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0456\u043d\u0443\u045e \u041f\u0430\u043d \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u043d\u0435 \u0432\u044b\u0433\u043d\u0430\u045e \u0456\u0445 \u0456 \u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u0443 \u0440\u0443\u043a\u0456 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0442\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u0445 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u041f\u0430\u043d, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0456\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0443\u0441\u0456\u0445 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u043b\u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u0432\u0430\u0439\u043d\u044b \u0437 \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430\u043c\u0456. \u0421\u0442\u0430\u043b\u0430\u0441\u044f \u0442\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0456\u0445, \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0440\u0430\u043d\u0435\u0439 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0432\u0430\u0439\u043d\u044b. \u0417\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043f\u044f\u0446\u044c \u0443\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u0445, \u0443\u0441\u0435 \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u044b, \u0441\u0456\u0434\u043e\u043d\u0446\u044b \u0456 \u0445\u0456\u0432\u0456\u0442\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u043b\u0456 \u043d\u0430 \u0433\u0430\u0440\u044b \u041b\u0456\u0431\u0430\u043d, \u0430\u0434 \u0433\u0430\u0440\u044b \u0411\u0430\u0430\u043b\u044c-\u0413\u0435\u0440\u043c\u043e\u043d \u0430\u0436 \u0434\u0430 \u041b\u0435\u0431\u043e-\u0425\u0430\u043c\u0430\u0442. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0446\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u044e\u0446\u0446\u0430 \u044f\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456\u044f \u0401\u043d \u0434\u0430\u045e \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u0456\u0445\u043d\u0456\u043c \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 106 (105), 40\u0430. 41\u0430. 44; \u0421\u0443\u0434 2, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u043d\u0435\u045e \u041f\u0430\u043d\u0430 \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u043d\u0430 \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434, \u0456 \u0401\u043d \u0432\u044b\u0434\u0430\u045e \u0456\u0445 \u0443 \u0440\u0443\u043a\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0456\u0445\u043d\u0456 \u045e\u0446\u0456\u0441\u043a, \u043f\u0430\u0447\u0443\u045e \u0456\u0445 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0456\u043c \u0441\u0443\u0434\u0434\u0437\u044f\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0456 \u0456\u0445 \u0430\u0434 \u0440\u0443\u043a \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0456\u0445\u043d\u0456 \u045e\u0446\u0456\u0441\u043a, \u043f\u0430\u0447\u0443\u045e \u0456\u0445 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"112","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e<span style=\"color: #ff0000;\">&nbsp;4, 1-24<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u044d\u0431\u043e\u0440\u0430 \u0456 \u0411\u0430\u0440\u0430\u043a<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0415\u0433\u0443\u0434\u0430 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437\u043d\u043e\u045e \u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u0432\u044b\u0434\u0430\u045e \u0456\u0445 \u041f\u0430\u043d \u0443 \u0440\u0443\u043a\u0456 \u042f\u0431\u0456\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u041a\u0430\u043d\u0430\u0430\u043d\u0430, \u044f\u043a\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0443 \u0425\u0430\u0446\u0430\u0440\u044b, \u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0432\u043e\u0439\u0441\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0431\u044b\u045e \u0421\u0456\u0441\u044d\u0440\u0430, \u044f\u043a\u0456 \u0436\u044b\u045e \u0443 \u0425\u0430\u0440\u0430\u0448\u044d\u0442-\u0425\u0430\u0433\u0430\u0456\u043c\u0435. \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u041f\u0430\u043d\u0430 \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443, \u0431\u043e \u0431\u044b\u043b\u043e \u045e \u0421\u0456\u0441\u044d\u0440\u044b \u0434\u0437\u0435\u0432\u044f\u0446\u044c\u0441\u043e\u0442 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u0445 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446, \u0456 \u0451\u043d \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0431\u044b\u043b\u0430 \u0441\u0443\u0434\u0434\u0437\u0451\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0414\u044d\u0431\u043e\u0440\u0430 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u0430, \u0436\u043e\u043d\u043a\u0430 \u041b\u0430\u043f\u0456\u0434\u043e\u0442\u0430. \u042f\u043d\u0430 \u0441\u0443\u0434\u0437\u0456\u043b\u0430 \u043f\u0430\u0434 \u041f\u0430\u043b\u044c\u043c\u0430\u044e \u0414\u044d\u0431\u043e\u0440\u044b, \u043f\u0430\u043c\u0456\u0436 \u0420\u0430\u043c\u0430\u044e \u0456 \u0411\u044d\u0442\u044d\u043b\u0435\u043c, \u043d\u0430 \u0433\u0430\u0440\u044b \u042d\u0444\u0440\u0430\u0456\u043c\u0430. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u044f\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430 \u0441\u0443\u0434. \u042f\u043d\u0430 \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0411\u0430\u0440\u0430\u043a\u0430, \u0441\u044b\u043d\u0430 \u0410\u0431\u0456\u043d\u0430\u0430\u043c\u0430, \u0437 \u041a\u0435\u0434\u044d\u0448-\u041d\u044d\u0444\u0442\u0430\u043b\u0456\u043c\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u0412\u043e\u0441\u044c \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0456\u0434\u0437\u0456 \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0432\u043e\u0439\u0441\u043a\u0430 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0422\u0430\u0431\u043e\u0440, \u0432\u0430\u0437\u044c\u043c\u0456 \u0437 \u0441\u0430\u0431\u043e\u044e \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u043c\u0443\u0436\u0447\u044b\u043d \u0437 \u0441\u044b\u043d\u043e\u045e \u041d\u044d\u0444\u0442\u0430\u043b\u0456\u043c\u0430 \u0456 \u0441\u044b\u043d\u043e\u045e \u0417\u0430\u0431\u0443\u043b\u043e\u043d\u0430. \u042f \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0434\u0430 \u043f\u0430\u0442\u043e\u043a\u0430 \u041a\u0456\u0448\u043e\u043d, \u0421\u0456\u0441\u044d\u0440\u0443, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u042f\u0431\u0456\u043d\u0430 \u0437 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u043c\u0456 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0456 \u0437 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c, \u0456 \u0430\u0434\u0434\u0430\u043c \u044f\u0433\u043e \u045e \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0435&raquo;. \u0411\u0430\u0440\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f \u043f\u0430\u0439\u0434\u0443, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f \u043d\u0435 \u043f\u0430\u0439\u0434\u0443&raquo;. \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041f\u0430\u0439\u0441\u0446\u0456 \u043f\u0430\u0439\u0434\u0443 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0442\u0430\u0431\u0435 \u045e\u0436\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0430\u0432\u0430 \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0442\u0432\u0430\u0456\u043c, \u044f\u043a\u0456\u043c \u0442\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u0448, \u0431\u043e \u045e \u0440\u0443\u043a\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0435 \u0432\u044b\u0434\u0430\u0441\u0446\u044c \u041f\u0430\u043d \u0421\u0456\u0441\u044d\u0440\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u045e\u0441\u0442\u0430\u043b\u0430 \u0414\u044d\u0431\u043e\u0440\u0430 \u0456 \u043f\u0430\u0439\u0448\u043b\u0430 \u0437 \u0411\u0430\u0440\u0430\u043a\u0430\u043c \u0443 \u041a\u0435\u0434\u044d\u0448. \u0410 \u0411\u0430\u0440\u0430\u043a \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0417\u0430\u0431\u0443\u043b\u043e\u043d\u0430 \u0456 \u041d\u044d\u0444\u0442\u0430\u043b\u0456\u043c\u0430 \u045e \u041a\u0435\u0434\u044d\u0448, \u0456 \u043f\u0430\u0439\u0448\u043b\u043e \u0437\u0430 \u0456\u043c \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u043c\u0443\u0436\u0447\u044b\u043d, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0439\u0448\u043b\u0430 \u0437 \u0456\u043c \u0414\u044d\u0431\u043e\u0440\u0430. \u0425\u0435\u0431\u044d\u0440 \u041a\u0435\u043d\u0456\u0442\u0430 \u0430\u0434\u0434\u0437\u044f\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u041a\u0435\u043d\u0456\u0442\u0430\u045e, \u0430\u0434 \u0441\u044b\u043d\u043e\u045e \u0425\u0430\u0431\u0430\u0431\u0430, \u0446\u0435\u0441\u0446\u044f \u041c\u0430\u0439\u0441\u0435\u044f, \u0456 \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u045e \u043d\u0430\u043c\u0451\u0442 \u0441\u0432\u043e\u0439 \u043a\u0430\u043b\u044f \u0434\u0443\u0431\u0430 \u045e \u0426\u0430\u0430\u043d\u0430\u0456\u043c\u0435 \u043f\u0430\u0431\u043b\u0456\u0437\u0443 \u041a\u0435\u0434\u044d\u0448\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043d\u0435\u0441\u043b\u0456 \u0421\u0456\u0441\u044d\u0440\u0443, \u0448\u0442\u043e \u0411\u0430\u0440\u0430\u043a, \u0441\u044b\u043d \u0410\u0431\u0456\u043d\u0430\u0430\u043c\u0430, \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u0422\u0430\u0431\u043e\u0440. \u0422\u0430\u0434\u044b \u0421\u0456\u0441\u044d\u0440\u0430 \u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u0441\u0435 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0435, \u0434\u0437\u0435\u0432\u044f\u0446\u044c\u0441\u043e\u0442 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u0445 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446, \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u044b\u045e \u0437 \u0456\u043c, \u0437 \u0425\u0430\u0440\u0430\u0448\u044d\u0442-\u0425\u0430\u0433\u0430\u0456\u043c\u0430 \u0434\u0430 \u043f\u0430\u0442\u043e\u043a\u0430 \u041a\u0456\u0448\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044d\u0431\u043e\u0440\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0411\u0430\u0440\u0430\u043a\u0443: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u0431\u043e \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u043d\u044c, \u0443 \u044f\u043a\u0456 \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0421\u0456\u0441\u044d\u0440\u0443 \u045e \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0435. \u0421\u0430\u043c \u041f\u0430\u043d \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e&raquo;. \u0421\u044b\u0448\u043e\u045e \u0411\u0430\u0440\u0430\u043a \u0437 \u0433\u0430\u0440\u044b \u0422\u0430\u0431\u043e\u0440, \u0430 \u0437\u0430 \u0456\u043c \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u043d\u0430\u0432\u0451\u045e \u0441\u0442\u0440\u0430\u0445 \u043d\u0430 \u0421\u0456\u0441\u044d\u0440\u0443, \u043d\u0430 \u045e\u0441\u0435 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u045e\u0441\u0451 \u0432\u043e\u0439\u0441\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0441\u0442\u0440\u044b\u0451\u043c \u043c\u044f\u0447\u0430 \u0411\u0430\u0440\u0430\u043a\u0430. \u0421\u044b\u0448\u043e\u045e \u0421\u0456\u0441\u044d\u0440\u0430 \u0437 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u045e\u0446\u0451\u043a \u043f\u0435\u0448\u0448\u0443. \u0411\u0430\u0440\u0430\u043a \u0433\u043d\u0430\u045e\u0441\u044f \u0437\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u043c\u0456 \u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0430\u0436 \u0434\u0430 \u0425\u0430\u0440\u0430\u0448\u044d\u0442-\u0425\u0430\u0433\u0430\u0456\u043c\u0430, \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u045e\u0441\u0451 \u0432\u043e\u0439\u0441\u043a\u0430 \u0421\u0456\u0441\u044d\u0440\u044b \u0430\u0434 \u0432\u0430\u0441\u0442\u0440\u044b\u044f \u043c\u044f\u0447\u0430, \u0442\u0430\u043a \u0448\u0442\u043e \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0456\u043a\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0421\u0456\u0441\u044d\u0440\u0430 \u045e\u0446\u0451\u043a \u043f\u0435\u0448\u0448\u0443 \u045e \u043d\u0430\u043c\u0451\u0442 \u042f\u044d\u043b\u0456, \u0436\u043e\u043d\u043a\u0456 \u0425\u0435\u0431\u044d\u0440\u0430 \u041a\u0435\u043d\u0456\u0442\u044b, \u0431\u043e \u043f\u0430\u043c\u0456\u0436 \u042f\u0431\u0456\u043d\u0430\u043c, \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0425\u0430\u0446\u0430\u0440\u0430, \u0456 \u043f\u0430\u043c\u0456\u0436 \u0434\u043e\u043c\u0430\u043c \u0425\u0435\u0431\u044d\u0440\u0430 \u041a\u0435\u043d\u0456\u0442\u044b \u0431\u044b\u045e \u043c\u0456\u0440. \u0412\u044b\u0439\u0448\u043b\u0430 \u042f\u044d\u043b\u044c \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0421\u0456\u0441\u044d\u0440\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u0417\u0430\u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u045e \u043c\u044f\u043d\u0435, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f&raquo;. \u0401\u043d \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u045e \u044f\u0435 \u045e \u043d\u0430\u043c\u0451\u0446\u0435, \u0430 \u044f\u043d\u0430 \u043d\u0430\u043a\u0440\u044b\u043b\u0430 \u044f\u0433\u043e \u043a\u0456\u043b\u0456\u043c\u0430\u043c. \u0422\u0430\u0434\u044b \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u0414\u0430\u0439 \u043c\u043d\u0435 \u043a\u0440\u044b\u0445\u0443 \u0432\u0430\u0434\u044b \u043d\u0430\u043f\u0456\u0446\u0446\u0430, \u0431\u043e \u044f \u0445\u0430\u0447\u0443 \u043f\u0456\u0446\u044c&raquo;. \u042f\u043d\u0430 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043b\u0430 \u043c\u0435\u0445 \u0437 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043d\u0430\u043f\u0430\u0456\u043b\u0430 \u044f\u0433\u043e, \u0430 \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u043a\u0440\u044b\u043b\u0430. \u0401\u043d \u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u0421\u0442\u0430\u043d\u044c \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u043d\u0430\u043c\u0451\u0442. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u0441\u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435: &laquo;\u0426\u0456 \u043d\u044f\u043c\u0430 \u0442\u0443\u0442 \u043a\u0430\u0433\u043e?&raquo;, \u0430\u0434\u043a\u0430\u0436\u044b: &laquo;\u041d\u044f\u043c\u0430&raquo;. \u0410\u043b\u0435 \u042f\u044d\u043b\u044c, \u0436\u043e\u043d\u043a\u0430 \u0425\u0435\u0431\u044d\u0440\u0430, \u0443\u0437\u044f\u043b\u0430 \u043a\u0430\u043b\u043e\u043a \u0430\u0434 \u043d\u0430\u043c\u0451\u0442\u0443, \u0441\u0445\u0430\u043f\u0456\u043b\u0430 \u043c\u043e\u043b\u0430\u0442 \u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u043f\u0430\u0434\u044b\u0448\u043b\u0430 \u0434\u0430 \u044f\u0433\u043e \u0446\u0456\u0445\u0435\u043d\u044c\u043a\u0430, \u0456 \u045e\u0431\u0456\u043b\u0430 \u043a\u0430\u043b\u043e\u043a \u0443 \u0441\u043a\u0440\u043e\u043d\u044e \u044f\u043c\u0443 \u0442\u0430\u043a, \u0448\u0442\u043e \u0451\u043d \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0437\u044f\u043c\u043b\u044e. \u0410 \u0451\u043d \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u045e, \u0431\u043e \u0431\u044b\u045e \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u044b, \u0456 \u043f\u0430\u043c\u0451\u0440. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0431\u044b\u045e \u0411\u0430\u0440\u0430\u043a, \u044f\u043a\u0456 \u0433\u043d\u0430\u045e\u0441\u044f \u0437\u0430 \u0421\u0456\u0441\u044d\u0440\u0430\u043c, \u0430 \u042f\u044d\u043b\u044c \u0432\u044b\u0439\u0448\u043b\u0430 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u044f\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0423\u0432\u0430\u0439\u0434\u0437\u0456, \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u0448\u0443\u043a\u0430\u0435\u0448&raquo;. \u0401\u043d \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0435, \u0430 \u0442\u0430\u043c \u043b\u044f\u0436\u0430\u045e \u043c\u0451\u0440\u0442\u0432\u044b \u0421\u0456\u0441\u044d\u0440\u0430 \u0437 \u043a\u0430\u043b\u043a\u043e\u043c \u0443 \u0441\u043a\u0440\u043e\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0411\u043e\u0433 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u042f\u0431\u0456\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u041a\u0430\u043d\u0430\u0430\u043d\u0430, \u043f\u0435\u0440\u0430\u0434 \u0441\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0420\u0443\u043a\u0430 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0443\u0446\u0456\u0441\u043a\u0430\u043b\u0430 \u042f\u0431\u0456\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u041a\u0430\u043d\u0430\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0456 \u044f\u043d\u044b \u042f\u0431\u0456\u043d\u0430, \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 27b. 29; 2 \u041a\u0430\u0440 12, 9\u0430; 1 \u041a\u0430\u0440 1, 28b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u0430\u0431\u043e\u0435 \u0441\u0432\u0435\u0442\u0443 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u0445, \u043a\u0430\u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430, \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0441\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"113","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">6, 1-6. 11-24<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0413\u0435\u0434\u044d\u043e\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0447\u044b\u043d\u0456\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u041f\u0430\u043d \u0443 \u0440\u0443\u043a\u0456 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e \u043d\u0430 \u0441\u0435\u043c \u0433\u0430\u0434\u043e\u045e. \u0423\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u0440\u0443\u043a\u0430 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u0430 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u0430\u0431\u0435, \u0440\u0430\u0442\u0443\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e, \u0448\u0447\u044b\u043b\u0456\u043d\u044b \u045e \u0433\u0430\u0440\u0430\u0445, \u043f\u044f\u0447\u043e\u0440\u044b \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0456. \u041a\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0437\u0430\u0441\u044f\u0432\u0430\u045e \u043f\u0430\u043b\u0456, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u044b \u0456 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0436\u044b\u0445\u0430\u0440\u044b \u045e\u0441\u0445\u043e\u0434\u0443 \u0456 \u043d\u0430\u043f\u0430\u0434\u0430\u043b\u0456 \u043d\u0430 \u0456\u0445. \u0420\u0430\u0437\u0431\u0456\u0432\u0430\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445 \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u0456 \u043f\u043b\u0451\u043d \u0437\u044f\u043c\u043b\u0456 \u0430\u0436 \u0434\u0430 \u0441\u0430\u043c\u0430\u0439 \u0413\u0430\u0437\u044b. \u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u043b\u0456 \u043d\u0430 \u0435\u0436\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044e \u043d\u0456 \u0430\u0432\u0435\u0447\u043a\u0456, \u043d\u0456 \u0432\u0430\u043b\u0430, \u043d\u0456 \u0430\u0441\u043b\u0430. \u0411\u043e \u044f\u043d\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0442\u0430\u0442\u043a\u0430\u043c\u0456 \u0456 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043d\u0430\u043c\u0451\u0442\u0430\u043c\u0456. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0456\u0445 \u0442\u0430\u043a \u0448\u043c\u0430\u0442, \u044f\u043a \u0441\u0430\u0440\u0430\u043d\u0447\u044b; \u0456\u043c \u0456 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u043c \u0456\u0445\u043d\u0456\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u043b\u0456\u043a\u0443. \u042f\u043d\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u044b\u0446\u044c \u044f\u0435. \u0412\u0435\u043b\u044c\u043c\u0456 \u0437\u0431\u044f\u0434\u043d\u0435\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0430\u0434 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e, \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0456 \u0441\u0435\u045e \u043f\u0430\u0434 \u0434\u0443\u0431\u0430\u043c, \u044f\u043a\u0456 \u045e \u041e\u0444\u0440\u044b, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0401\u0430\u0441\u0443 \u0437 \u0440\u043e\u0434\u0443 \u0410\u0431\u0456\u044f\u0437\u0430\u0440\u0430. \u042f\u0433\u043e\u043d\u044b \u0441\u044b\u043d \u0413\u0435\u0434\u044d\u043e\u043d \u043c\u0430\u043b\u0430\u0446\u0456\u045e \u043f\u0448\u0430\u043d\u0456\u0446\u0443 \u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b\u043c \u0434\u0430\u0432\u0456\u043b\u0435, \u0445\u0430\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e. \u0417&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u044f\u043c\u0443 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d \u0437 \u0442\u0430\u0431\u043e\u044e, \u043c\u0443\u0436\u043d\u044b \u0432\u043e\u0456\u043d!&raquo; \u0413\u0435\u0434\u044d\u043e\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0437 \u043d\u0430\u043c\u0456, \u0442\u043e \u0447\u0430\u043c\u0443 \u043d\u0430\u0441 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430? \u0414\u0437\u0435 \u045e\u0441\u0435 \u0442\u044b\u044f \u0446\u0443\u0434\u044b \u042f\u0433\u043e\u043d\u044b\u044f, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u0440\u0430\u0441\u043f\u0430\u0432\u044f\u0434\u0430\u043b\u0456 \u0430\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u0426\u044f\u043f\u0435\u0440 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441 \u041f\u0430\u043d \u0456 \u0430\u0434\u0434\u0430\u045e \u0443 \u0440\u0443\u043a\u0456 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e&raquo;. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u044f\u0433\u043e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0437 \u0433\u044d\u0442\u0430\u0439 \u0441\u0456\u043b\u0430\u044e \u0441\u0432\u0430\u0451\u044e \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0430\u0434 \u0440\u0443\u043a \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e. \u0412\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0446\u044f\u0431\u0435&raquo;. \u0413\u0435\u0434\u044d\u043e\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &laquo;\u041f\u0430\u043d\u0435, \u044f\u043a \u044f \u045e\u0440\u0430\u0442\u0443\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044c? \u041c\u043e\u0439 \u0440\u043e\u0434 \u043d\u0430\u0439\u0431\u044f\u0434\u043d\u0435\u0439\u0448\u044b \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430, \u0430 \u044f \u0441\u0430\u043c\u044b \u043c\u0430\u043b\u043e\u0434\u0448\u044b \u045e \u0434\u043e\u043c\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u043c\u0430\u0439\u0433\u043e&raquo;. \u0410 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u042f \u0431\u0443\u0434\u0443 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0456 \u0442\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u0448 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e, \u044f\u043a \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430&raquo;. \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &laquo;\u041a\u0430\u043b\u0456 \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043b\u0430\u0441\u043a\u0443 \u045e \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445, \u0434\u0430\u0439 \u043c\u043d\u0435 \u0437\u043d\u0430\u043a, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0422\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0448 \u0441\u0430 \u043c\u043d\u043e\u044e. \u041d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044c \u0430\u0434\u0441\u044e\u043b\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u044f \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0434\u0430 \u0426\u044f\u0431\u0435 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0432\u0430\u044e, \u0456 \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u0434\u0443 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e&raquo;. \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u0442\u044b \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0435\u0434\u044d\u043e\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u045e \u043a\u0430\u0437\u043b\u044f\u043d\u044f \u0456 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456 \u0437 \u044d\u0444\u044b \u043c\u0443\u043a\u0456. \u041c\u044f\u0441\u0430 \u043f\u0430\u043a\u043b\u0430\u045e \u0443 \u043a\u043e\u0448, \u0430 \u043f\u043e\u043b\u0456\u045e\u043a\u0443 \u043d\u0430\u043b\u0456\u045e \u0443 \u0433\u0430\u0440\u0448\u0447\u043e\u043a \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u042f\u043c\u0443 \u043f\u0430\u0434 \u0434\u0443\u0431 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u043c\u044f\u0441\u0430 \u0437 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0430\u043c\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0456 \u043d\u0430 \u0433\u044d\u0442\u0443\u044e \u0441\u043a\u0430\u043b\u0443, \u0430 \u0437\u0432\u0435\u0440\u0445\u0443 \u0432\u044b\u043b\u0456 \u043f\u043e\u043b\u0456\u045e\u043a\u0443&raquo;. \u041a\u0430\u043b\u0456 \u0451\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430, \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u043a\u0430\u043d\u0435\u0446 \u0436\u0430\u0437\u043b\u0430, \u0448\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0440\u0443\u043a\u0430\u0445, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043c\u044f\u0441\u0430 \u0456 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u043e\u045e, \u0456 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0430\u0433\u043e\u043d\u044c \u0441\u0430 \u0441\u043a\u0430\u043b\u044b, \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043c\u044f\u0441\u0430 \u0456 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456. \u041f\u0430\u0441\u043b\u044f \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0437\u043d\u0456\u043a \u0437 \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u0430\u0447\u044d\u0439. \u041f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0448\u044b\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u044b\u045e \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430, \u0413\u0435\u0434\u044d\u043e\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u043e\u0440\u0430 \u043c\u043d\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u0431\u043e \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0430\u043d\u0451\u043b\u0430 \u041f\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440!&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d: &laquo;\u0421\u043f\u0430\u043a\u043e\u0439 \u0442\u0430\u0431\u0435, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f, \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u0448!&raquo; \u0422\u0430\u0434\u044b \u0413\u0435\u0434\u044d\u043e\u043d \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0442\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u041f\u0430\u043d\u0443 \u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e &ldquo;\u041f\u0430\u043d \u0441\u043f\u0430\u043a\u043e\u044e&rdquo;. \u0410\u0436 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u0451\u043d \u0441\u0442\u0430\u0456\u0446\u044c \u044f\u0448\u0447\u044d \u045e \u041e\u0444\u0440\u044b \u0410\u0431\u0456\u044d\u0437\u044d\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 45, 3cd. 4ab; \u0421\u0443\u0434 6, 14b; \u043f\u0430\u0440. \u0406\u0441 45, 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u041f\u0430\u043d, \u044f\u043a\u0456 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u043a\u043b\u0456\u0447\u0430 \u0446\u044f\u0431\u0435, \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0433\u0456 \u043c\u0430\u0439\u0433\u043e \u042f\u043a\u0443\u0431\u0430 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u043c\u0430\u0439\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0406\u0434\u0437\u0456 \u0456 \u0437 \u0433\u044d\u0442\u0430\u0439 \u0441\u0456\u043b\u0430\u044e \u0441\u0432\u0430\u0451\u044e \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u0434\u0437\u0456 \u0456 \u0437 \u0433\u044d\u0442\u0430\u0439 \u0441\u0456\u043b\u0430\u044e \u0441\u0432\u0430\u0451\u044e \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"114","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">6, 33 &ndash; 7, 8. 16-22\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0413\u0435\u0434\u044d\u043e\u043d \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0437 \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0441\u0435 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u044b \u0456 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u044e\u0434\u0437\u0456 \u045e\u0441\u0445\u043e\u0434\u0443 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0456 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u0443 \u0434\u0430\u043b\u0456\u043d\u0435 \u0406\u0437\u0440\u044d\u044d\u043b\u044c. \u0410 \u0434\u0443\u0445 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0413\u0435\u0434\u044d\u043e\u043d\u0430. \u0401\u043d \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0443 \u0440\u043e\u0433 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0440\u043e\u0434 \u0410\u0431\u0456\u044d\u0437\u044d\u0440\u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0456\u043c. \u041f\u0430\u0441\u043b\u0430\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430, \u0456 \u044f\u043d\u043e \u0441\u0430\u0431\u0440\u0430\u043b\u0430\u0441\u044f \u0456\u0441\u0446\u0456 \u0437\u0430 \u0456\u043c. \u041f\u0430\u0441\u043b\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e \u0434\u0430 \u0410\u0441\u044d\u0440\u0430, \u0417\u0430\u0431\u0443\u043b\u043e\u043d\u0430 \u0456 \u041d\u044d\u0444\u0442\u0430\u043b\u0456\u043c\u0430, \u0456 \u044f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u044f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0413\u0435\u0434\u044d\u043e\u043d \u0411\u043e\u0433\u0443: &laquo;\u041a\u0430\u043b\u0456 \u0422\u044b \u0432\u044b\u0440\u0430\u0442\u0443\u0435\u0448 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043c\u0430\u0451\u0439 \u0440\u0443\u043a\u043e\u044e, \u044f\u043a \u043a\u0430\u0437\u0430\u045e, \u0442\u043e \u0434\u0430\u0437\u0432\u043e\u043b\u044c, \u044f \u043f\u0430\u0441\u0446\u044f\u043b\u044e \u043d\u0430 \u0433\u0443\u043c\u043d\u0435 \u0432\u043e\u045e\u043d\u0443. \u041a\u0430\u043b\u0456 \u0440\u0430\u0441\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u0432\u043e\u045e\u043d\u0435, \u0430 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0445\u0430, \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0443 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0422\u044b \u0432\u044b\u0440\u0430\u0442\u0443\u0435\u0448 \u043c\u0430\u0451\u0439 \u0440\u0443\u043a\u043e\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a \u043a\u0430\u0437\u0430\u045e&raquo;. \u0406 \u0442\u0430\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f. \u041a\u0430\u043b\u0456 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0434\u0437\u0435\u043d\u044c \u0451\u043d \u0443\u0441\u0442\u0430\u045e \u0440\u0430\u043d\u0430 \u0456 \u043f\u0430\u0447\u0430\u045e \u0432\u044b\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u0432\u043e\u045e\u043d\u0443, \u0442\u043e \u0432\u044b\u0446\u0456\u0441\u043d\u0443\u045e \u0437 \u044f\u0435 \u0446\u044d\u043b\u044b \u043a\u0435\u043b\u0456\u0445 \u0432\u0430\u0434\u044b. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0413\u0435\u0434\u044d\u043e\u043d \u0411\u043e\u0433\u0443: &laquo;\u041d\u0435 \u0433\u043d\u0435\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u0440\u0430\u0437 \u043f\u0430\u043f\u0440\u0430\u0448\u0443 \u0456 \u044f\u0448\u0447\u044d \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0443\u044e \u0432\u043e\u045e\u043d\u0430\u044e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0445\u043e\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u043e\u045e\u043d\u0430, \u0430 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0441\u0430&raquo;. \u0406 \u0442\u0430\u043a \u0411\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u045e \u0443 \u0442\u0443\u044e \u043d\u043e\u0447. \u0422\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u0432\u043e\u045e\u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u0443\u0445\u0430, \u0430 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u0431\u044b\u043b\u0430 \u0440\u0430\u0441\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0434\u043e\u0441\u0432\u0456\u0442\u043a\u0443 \u045e\u0441\u0442\u0430\u045e \u0415\u0440\u0443\u0431\u0430\u0430\u043b\u044c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0413\u0435\u0434\u044d\u043e\u043d, \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u044b\u045e \u0437 \u0456\u043c, \u0456 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043a\u0430\u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0425\u0430\u0440\u043e\u0434. \u041b\u0430\u0433\u0435\u0440 \u0436\u0430 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e \u0431\u044b\u045e \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447 \u0430\u0434 \u044f\u0433\u043e, \u0443 \u0434\u0430\u043b\u0456\u043d\u0435 \u043a\u0430\u043b\u044f \u045e\u0437\u0432\u044b\u0448\u0448\u0430 \u041c\u043e\u0440\u044d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0413\u0435\u0434\u044d\u043e\u043d\u0443: &laquo;\u0417\u0430\u0448\u043c\u0430\u0442 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0430\u0431 \u042f \u0430\u0434\u0434\u0430\u045e \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e \u0443 \u0456\u0445\u043d\u0456\u044f \u0440\u0443\u043a\u0456, \u0431\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043c\u043e\u0436\u0430 \u0437\u0430\u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e \u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &ldquo;\u041c\u0430\u044f \u0440\u0443\u043a\u0430 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u043c\u044f\u043d\u0435&rdquo;. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0430\u0431\u0432\u044f\u0441\u0446\u0456 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0425\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0456 \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u044b \u0456\u0434\u0437\u0435 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0413\u0456\u043b\u0435\u0430\u0434&raquo;. \u0422\u0430\u0434\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0434\u0437\u0432\u0435 \u0442\u044b\u0441\u044f\u0447\u044b \u0437 \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0413\u0435\u0434\u044d\u043e\u043d\u0443: &laquo;\u0423\u0441\u0451 \u044f\u0448\u0447\u044d \u0437\u0430\u0448\u043c\u0430\u0442 \u043d\u0430\u0440\u043e\u0434\u0443. \u0421\u044b\u0434\u0437\u0456 \u0437 \u0456\u043c\u0456 \u0434\u0430 \u0432\u0430\u0434\u044b, \u0430 \u042f \u0432\u044b\u043f\u0440\u0430\u0431\u0443\u044e \u0456\u0445 \u0442\u0430\u043c \u0434\u043b\u044f \u0446\u044f\u0431\u0435. \u041f\u0440\u0430 \u043a\u0430\u0433\u043e \u042f \u0441\u043a\u0430\u0436\u0443: &ldquo;\u0413\u044d\u0442\u044b \u043f\u043e\u0439\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e&rdquo;, \u0442\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430 \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435: &ldquo;\u0413\u044d\u0442\u044b \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e&rdquo;, \u0442\u043e\u0439 \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435&raquo;. \u041a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u0432\u0430\u0434\u044b, \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0413\u0435\u0434\u044d\u043e\u043d\u0443: &laquo;\u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0445\u043b\u044f\u0431\u0442\u0430\u0446\u044c \u0432\u0430\u0434\u0443 \u044f\u0437\u044b\u043a\u043e\u043c, \u044f\u043a \u0445\u043b\u0435\u0431\u0447\u0430 \u0441\u0430\u0431\u0430\u043a\u0430, \u0442\u0430\u0433\u043e \u0441\u0442\u0430\u043d\u0430\u0432\u0456 \u0430\u0441\u043e\u0431\u043d\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u0430\u0432\u0456 \u0430\u0441\u043e\u0431\u043d\u0430 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u0430\u0435 \u043a\u0430\u043b\u0435\u043d\u0456, \u043a\u0430\u0431 \u043d\u0430\u043f\u0456\u0446\u0446\u0430. \u0406 \u0431\u044b\u043b\u043e \u0442\u044b\u0445, \u0448\u0442\u043e \u0445\u043b\u044f\u0431\u0442\u0430\u043b\u0456 \u044f\u0437\u044b\u043a\u043e\u043c \u0441\u0432\u0430\u0456\u043c \u0437 \u0440\u0443\u043a\u0456 \u0442\u0440\u044b\u0441\u0442\u0430 \u043c\u0443\u0436\u0447\u044b\u043d, \u0430 \u045e\u0441\u044f \u0440\u044d\u0448\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043a\u043b\u0435\u043d\u0447\u044b\u043b\u0430, \u043a\u0430\u0431 \u043d\u0430\u043f\u0456\u0446\u0446\u0430 \u0432\u0430\u0434\u044b. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0413\u0435\u0434\u044d\u043e\u043d\u0443: &laquo;\u0422\u0440\u044b\u043c\u0430 \u0441\u043e\u0442\u043d\u044f\u043c\u0456 \u043c\u0443\u0436\u0447\u044b\u043d, \u0448\u0442\u043e \u0445\u043b\u044f\u0431\u0442\u0430\u043b\u0456 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456, \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u0432\u0430\u0441 \u0456 \u0430\u0434\u0434\u0430\u043c \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e \u0443 \u0442\u0432\u0430\u0435 \u0440\u0443\u043a\u0456. \u0410 \u0440\u044d\u0448\u0442\u0430 \u043c\u0443\u0436\u0447\u044b\u043d \u043d\u044f\u0445\u0430\u0439 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430&raquo;. \u0422\u0430\u0434\u044b \u045e\u0437\u044f\u045e \u043d\u0430\u0440\u043e\u0434 \u0437\u0430\u043f\u0430\u0441 \u0435\u0436\u044b \u0441\u0430\u0431\u0435 \u0456 \u0442\u0440\u0443\u0431\u044b \u0441\u0432\u0430\u0435 \u0437 \u0440\u0430\u0433\u043e\u045e, \u0430 \u0413\u0435\u0434\u044d\u043e\u043d \u0430\u0434\u0430\u0441\u043b\u0430\u045e \u0443\u0441\u0456\u0445 \u043c\u0443\u0436\u0447\u044b\u043d \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u0445 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u043c\u0451\u0442\u0443, \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u044d\u0442\u044b\u0445 \u043c\u043e\u0446\u043d\u044b\u0445 \u0442\u0440\u043e\u0445\u0441\u043e\u0442. \u041b\u0430\u0433\u0435\u0440 \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e \u0431\u044b\u045e \u0443 \u0434\u0430\u043b\u0456\u043d\u0435, \u043d\u0456\u0436\u044d\u0439 \u0432\u043e\u0439\u0441\u043a\u0430 \u0413\u0435\u0434\u044d\u043e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0433\u044d\u0442\u044b\u0445 \u0442\u0440\u044b\u0441\u0442\u0430 \u043c\u0443\u0436\u0447\u044b\u043d \u043d\u0430 \u0442\u0440\u044b \u0430\u0442\u0440\u0430\u0434\u044b \u0456 \u0434\u0430\u045e \u0456\u043c \u0443\u0441\u0456\u043c \u0443 \u0440\u0443\u043a\u0456 \u0440\u043e\u0433\u0456 \u0456 \u043f\u0443\u0441\u0442\u044b\u044f \u0437\u0431\u0430\u043d\u044b, \u0430 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u0437\u0431\u0430\u043d\u043e\u045e \u0431\u044b\u043b\u0456 \u043f\u0430\u0445\u043e\u0434\u043d\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u043c\u044f\u043d\u0435 \u0456 \u0440\u0430\u0431\u0456\u0446\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435. \u0426\u044f\u043f\u0435\u0440 \u044f \u043f\u0430\u0439\u0434\u0443 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u043b\u0430\u0433\u0435\u0440\u0430 \u0456 \u0448\u0442\u043e \u0431\u0443\u0434\u0443 \u0440\u0430\u0431\u0456\u0446\u044c, \u0442\u043e\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0456 \u0432\u044b. \u041a\u0430\u043b\u0456 \u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u044b\u043c\u0456, \u0448\u0442\u043e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0437\u0430\u0442\u0440\u0443\u0431\u043b\u044e \u0443 \u0440\u043e\u0433, \u0442\u0440\u0443\u0431\u0456\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b \u045e \u0440\u043e\u0433\u0456 \u0432\u0430\u043a\u043e\u043b \u0443\u0441\u044f\u0433\u043e \u043b\u0430\u0433\u0435\u0440\u0430 \u0456 \u043a\u0440\u044b\u0447\u044b\u0446\u0435: &ldquo;\u0417\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0413\u0435\u0434\u044d\u043e\u043d\u0430!&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u044b\u0448\u043e\u045e \u0413\u0435\u0434\u044d\u043e\u043d \u0456 \u0441\u0442\u043e \u043c\u0443\u0436\u0447\u044b\u043d, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c, \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u043b\u0430\u0433\u0435\u0440\u0430, \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u044f\u0440\u044d\u0434\u043d\u044f\u0439 \u0432\u0430\u0440\u0442\u044b, \u043f\u0430\u0441\u043b\u044f \u0437\u043c\u0435\u043d\u044b \u0432\u0430\u0440\u0442\u0430\u0432\u044b\u0445, \u0434\u044b \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0440\u043e\u0433\u0456 \u0456 \u043f\u0430\u0440\u0430\u0437\u0431\u0456\u0432\u0430\u043b\u0456 \u0437\u0431\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u045e \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445. \u0422\u0430\u0434\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u0440\u044b \u0430\u0442\u0440\u0430\u0434\u044b \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0440\u043e\u0433\u0456 \u0434\u044b \u043f\u0430\u0440\u0430\u0437\u0431\u0456\u0432\u0430\u043b\u0456 \u0437\u0431\u0430\u043d\u044b. \u0423 \u043b\u0435\u0432\u0430\u0439 \u0440\u0443\u0446\u044d \u0441\u0432\u0430\u0451\u0439 \u044f\u043d\u044b \u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u0445\u043e\u0434\u043d\u0456, \u0430 \u045e \u043f\u0440\u0430\u0432\u0430\u0439 &ndash; \u0440\u043e\u0433\u0456, \u043a\u0430\u0431 \u0442\u0440\u0443\u0431\u0456\u0446\u044c \u0443 \u0456\u0445. \u042f\u043d\u044b \u043a\u0440\u044b\u0447\u0430\u043b\u0456: &laquo;\u041c\u0435\u0447 \u0437\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0413\u0435\u0434\u044d\u043e\u043d\u0430!&raquo; \u041a\u043e\u0436\u043d\u044b \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043c\u0435\u0441\u0446\u044b \u0432\u0430\u043a\u043e\u043b \u043b\u0430\u0433\u0435\u0440\u0430. \u0410 \u0432\u0430 \u045e\u0441\u0456\u043c \u043b\u0430\u0433\u0435\u0440\u044b \u0437\u0430\u0431\u0435\u0433\u0430\u043b\u0456, \u043f\u0430\u0447\u0430\u043b\u0456 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0456 \u045e\u0446\u044f\u043a\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0430 \u0442\u0440\u044b\u0441\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443 \u0440\u043e\u0433\u0456, \u041f\u0430\u043d \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u043c\u0435\u0447 \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u043b\u0430\u0433\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 27b-29; \u041b\u043a 1, 52<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u0430\u0431\u043e\u0435 \u0441\u0432\u0435\u0442\u0443 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u0445; \u0456 \u0431\u044f\u0437\u0440\u043e\u0434\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u0430\u0435, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430, \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0441\u043d\u0430\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0441\u043a\u0456\u043d\u0443\u045e \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0437 \u0442\u0440\u043e\u043d\u0430 \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"115","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">8, 22-23. 30-32; 9, 1-15. 19-20&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u0445\u043e\u0447\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c: \u0421\u043a\u0430\u0437\u0430\u043b\u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u0413\u0435\u0434\u044d\u043e\u043d\u0443: &laquo;\u041f\u0430\u043d\u0443\u0439 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0442\u044b, \u0441\u044b\u043d \u0442\u0432\u043e\u0439 \u0456 \u0441\u044b\u043d \u0441\u044b\u043d\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u0442\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0437 \u0440\u0443\u043a \u043c\u0430\u0434\u044b\u044f\u043d\u0456\u0442\u0430\u045e&raquo;. \u0410\u043b\u0435 \u0413\u0435\u0434\u044d\u043e\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u041d\u0435 \u044f \u0431\u0443\u0434\u0443 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456, \u0456 \u043d\u0435 \u043c\u043e\u0439 \u0441\u044b\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456. \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0413\u0435\u0434\u044d\u043e\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u044b\u043d\u043e\u045e, \u044f\u043a\u0456\u044f \u0432\u044b\u0439\u0448\u043b\u0456 \u0441\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445, \u0431\u043e \u043c\u0435\u045e \u0448\u043c\u0430\u0442 \u0436\u043e\u043d\u0430\u043a. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0434\u0440\u0443\u0433\u0430\u0440\u0430\u0434\u043d\u0430\u044f \u0436\u043e\u043d\u043a\u0430 \u044f\u0433\u043e, \u044f\u043a\u0430\u044f \u0436\u044b\u043b\u0430 \u045e \u0421\u0456\u0445\u0435\u043c\u0435, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043c\u0443 \u0441\u044b\u043d\u0430, \u044f\u043a\u043e\u043c\u0443 \u0451\u043d \u0434\u0430\u045e \u0456\u043c\u044f \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0435\u0434\u044d\u043e\u043d, \u0441\u044b\u043d \u0401\u0430\u0441\u0430, \u043f\u0430\u043c\u0451\u0440 \u0443 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456, \u0456 \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u043c\u0430\u0433\u0456\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0456 \u0401\u0430\u0441\u0430, \u0443 \u041e\u0444\u0440\u044b \u0410\u0431\u0456\u044d\u0437\u044d\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445, \u0441\u044b\u043d \u0415\u0440\u0443\u0431\u0430\u0430\u043b\u044f-\u0413\u0435\u0434\u044d\u043e\u043d\u0430, \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0456\u0445\u0435\u043c \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0441\u044f\u043c&rsquo;\u0456 \u0431\u0430\u0446\u044c\u043a\u0456 \u0456 \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u0451\u0439: &laquo;\u041f\u0440\u0430\u0448\u0443, \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u0435 \u045e\u0441\u0456\u043c \u0437\u043d\u0430\u0442\u043d\u044b\u043c \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0421\u0456\u0445\u0435\u043c\u0430. \u0428\u0442\u043e \u043b\u0435\u043f\u0448\u0430\u0435 \u0434\u043b\u044f \u0432\u0430\u0441? \u041a\u0430\u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u044b\u043d\u043e\u045e \u0415\u0440\u0443\u0431\u0430\u0430\u043b\u044f, \u0446\u0456 \u043a\u0430\u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u045e \u043d\u0430\u0434 \u0432\u0430\u043c\u0456 \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a? \u041f\u043e\u043c\u043d\u0456\u0446\u0435, \u0448\u0442\u043e \u044f \u043a\u043e\u0441\u0442\u043a\u0430 \u0437 \u0432\u0430\u0448\u0430\u0439 \u043a\u043e\u0441\u0442\u043a\u0456 \u0456 \u0446\u0435\u043b\u0430 \u0437 \u0432\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430&raquo;. \u0411\u0440\u0430\u0442\u044b \u044f\u0433\u043e\u043d\u0430\u0439 \u043c\u0430\u0446\u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u045e\u0441\u0456\u043c \u0437\u043d\u0430\u0442\u043d\u044b\u043c \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0421\u0456\u0445\u0435\u043c\u0430. \u0422\u0430\u0434\u044b \u0441\u0445\u0456\u043b\u0456\u043b\u0430\u0441\u044f \u0441\u044d\u0440\u0446\u0430 \u0456\u0445\u043d\u044f\u0435 \u0434\u0430 \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445\u0430, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0401\u043d \u0431\u0440\u0430\u0442 \u043d\u0430\u0448&raquo;. \u042f\u043d\u044b \u0434\u0430\u043b\u0456 \u044f\u043c\u0443 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u0456\u043a\u043b\u044f\u045e \u0441\u0440\u044d\u0431\u0440\u0430 \u0437 \u0434\u043e\u043c\u0443 \u0411\u0430\u0430\u043b\u044c-\u0411\u044d\u0440\u044b\u0442\u0430. \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445 \u0436\u0430 \u043d\u0430\u043d\u044f\u045e \u043d\u0430 \u0456\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0456 \u0441\u0432\u0430\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0456\u043c. \u041a\u0430\u043b\u0456 \u0451\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0434\u043e\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0456 \u045e \u041e\u0444\u0440\u044b, \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445, \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u044b\u043d\u043e\u045e \u0415\u0440\u0443\u0431\u0430\u0430\u043b\u044f \u043d\u0430 \u0430\u0434\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0456. \u0423\u0440\u0430\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u0442\u0430\u043c, \u043c\u0430\u043b\u043e\u0434\u0448\u044b \u0441\u044b\u043d \u0415\u0440\u0443\u0431\u0430\u0430\u043b\u044f, \u0431\u043e \u0441\u0445\u0430\u0432\u0430\u045e\u0441\u044f. \u0421\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u045e\u0441\u0435 \u043c\u0443\u0436\u044b \u0441\u0456\u0445\u0435\u043c\u0441\u043a\u0456\u044f \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u041c\u0456\u043b\u043e, \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0434\u0443\u0431\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u0443 \u0421\u0456\u0445\u0435\u043c\u0435, \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456 \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445\u0430 \u043a\u0430\u0440\u0430\u043b\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0456 \u0401\u0442\u0430\u043c\u0443, \u0451\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0441\u0442\u0430\u045e \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b \u0413\u0430\u0440\u044b\u0437\u0456\u043c. \u0423\u0437\u043d\u044f\u045e\u0448\u044b \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0451\u043d \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e: &laquo;\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u043c\u0443\u0436\u044b \u0441\u0456\u0445\u0435\u043c\u0441\u043a\u0456\u044f, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u0432\u0430\u0441 \u0411\u043e\u0433! \u0421\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u044f\u043a \u0434\u0440\u044d\u0432\u044b, \u043a\u0430\u0431 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u043a\u0430\u0440\u0430\u043b\u044f, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0430\u043b\u0456\u0432\u0435: &ldquo;\u041f\u0430\u043d\u0443\u0439 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456&rdquo;. \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &ldquo;\u0425\u0456\u0431\u0430 \u043c\u0430\u0433\u0443 \u044f \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0442\u043b\u0443\u0448\u0447 \u0441\u0432\u043e\u0439, \u044f\u043a\u0456\u043c \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0431\u0430\u0433\u043e\u045e \u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u043f\u0430\u0439\u0441\u0446\u0456 \u0445\u0456\u0441\u0442\u0430\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0434\u0440\u044d\u0432\u0430\u043c\u0456&rdquo;. \u0422\u0430\u0434\u044b \u0434\u0440\u044d\u0432\u044b \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u044b: &ldquo;\u0406\u0434\u0437\u0456 \u0456 \u043f\u0430\u043d\u0443\u0439 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456&rdquo;. \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430 \u0456\u043c: &ldquo;\u0425\u0456\u0431\u0430 \u043c\u0430\u0433\u0443 \u044f \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0441\u043b\u043e\u0434\u044b\u0447 \u0441\u0432\u0430\u044e \u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u044f \u043f\u043b\u0430\u0434\u044b \u0441\u0432\u0430\u0435, \u043a\u0430\u0431 \u043f\u0430\u0439\u0441\u0446\u0456 \u0445\u0456\u0441\u0442\u0430\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0456\u043d\u0448\u044b\u043c\u0456 \u0434\u0440\u044d\u0432\u0430\u043c\u0456?&rdquo; \u0414\u0440\u044d\u0432\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u044b: &ldquo;\u0406\u0434\u0437\u0456 \u0456 \u043f\u0430\u043d\u0443\u0439 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456&rdquo;. \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &ldquo;\u0425\u0456\u0431\u0430 \u043c\u0430\u0433\u0443 \u044f \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451, \u044f\u043a\u043e\u0435 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0431\u0430\u0433\u043e\u045e \u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u043f\u0430\u0439\u0441\u0446\u0456 \u0445\u0456\u0441\u0442\u0430\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0456\u043d\u0448\u044b\u043c\u0456 \u0434\u0440\u044d\u0432\u0430\u043c\u0456?&rdquo; \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u045e\u0441\u0435 \u0434\u0440\u044d\u0432\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0446\u0451\u0440\u043d\u0443: &ldquo;\u0406\u0434\u0437\u0456 \u0456 \u043f\u0430\u043d\u0443\u0439 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456&rdquo;. \u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0446\u0451\u0440\u043d: &ldquo;\u041a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0445\u043e\u0447\u0430\u0446\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0445\u0430\u0434\u0437\u0456\u0446\u0435 \u0456 \u0441\u043f\u0430\u0447\u043d\u0456\u0446\u0435 \u045e \u0446\u0435\u043d\u0456 \u043c\u0430\u0456\u043c. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0430\u0433\u043e\u043d\u044c \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0446\u0435\u0440\u043d\u044f\u045e \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u043b\u0456\u0432\u0430\u043d\u0441\u043a\u0456\u044f \u043a\u0435\u0434\u0440\u044b!&rdquo; \u041a\u0430\u043b\u0456 \u0432\u044b \u0441\u0451\u043d\u043d\u044f \u0441\u043b\u0443\u0448\u043d\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u045e\u0447\u044b\u043d\u0456\u043b\u0456 \u0437 \u0415\u0440\u0443\u0431\u0430\u0430\u043b\u0435\u043c \u0456 \u044f\u0433\u043e\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c, \u0442\u043e \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445\u0443, \u0456 \u0451\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0439\u0434\u0437\u0435 \u0430\u0433\u043e\u043d\u044c \u0437 \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445\u0430 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0421\u0456\u0445\u0435\u043c\u0430 \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u041c\u0456\u043b\u043e. \u041d\u044f\u0445\u0430\u0439 \u0432\u044b\u0439\u0434\u0437\u0435 \u0430\u0433\u043e\u043d\u044c \u0441\u0430 \u0437\u043d\u0430\u0442\u043d\u044b\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0441\u0456\u0445\u0435\u043c\u0441\u043a\u0456\u0445 \u0456 \u0437 \u0434\u043e\u043c\u0443 \u041c\u0456\u043b\u043e \u0456 \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0410\u0431\u0456\u043c\u044d\u043b\u0435\u0445\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0443\u0434 8, 23; \u0410\u043f 5, 13b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u044f \u0431\u0443\u0434\u0443 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456, \u0456 \u043d\u0435 \u043c\u043e\u0439 \u0441\u044b\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443 &ndash; \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u0445\u0432\u0430\u043b\u0430, \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0432\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"116","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">13, 1-25&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0421\u0430\u043c\u0441\u043e\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u0432\u044b\u0434\u0430\u045e \u0456\u0445 \u041f\u0430\u043d \u0443 \u0440\u0443\u043a\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e \u043d\u0430 \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0434\u0437\u0456\u043d \u0437 \u0421\u0430\u0440\u044d\u0430, \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0414\u0430\u043d\u0430 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u043d\u043e\u0430\u0445. \u0416\u043e\u043d\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0431\u044b\u043b\u0430 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0456 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c. \u0417&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0436\u043e\u043d\u0446\u044b \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u0412\u043e\u0441\u044c \u0442\u044b \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0441\u044b\u043d\u0430. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0431\u0443\u0434\u0437\u044c \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u0430\u0439, \u043d\u0435 \u043f\u0456 \u0432\u0456\u043d\u0430 \u0456 \u0445\u043c\u044f\u043b\u044c\u043d\u043e\u0433\u0430 \u043d\u0430\u043f\u043e\u044e \u0456 \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430. \u0411\u043e \u0442\u044b \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0441\u044b\u043d\u0430, \u0456 \u0431\u0440\u044b\u0442\u0432\u0430 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u0430\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439, \u0431\u043e \u0445\u043b\u043e\u043f\u0435\u0446 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0437\u0456\u0440\u044d\u0435\u043c \u0430\u0434 \u0441\u0430\u043c\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f. \u0406 \u0451\u043d \u043f\u0430\u0447\u043d\u0435 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0437 \u0440\u0443\u043a \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0439\u0448\u043b\u0430 \u0436\u043e\u043d\u043a\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u0443\u0436\u0443 \u0441\u0432\u0430\u0439\u043c\u0443: &laquo;\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0434\u0430 \u043c\u044f\u043d\u0435, \u0456 \u0432\u044b\u0433\u043b\u044f\u0434 \u044f\u0433\u043e \u0431\u044b\u045e, \u044f\u043a \u0432\u044b\u0433\u043b\u044f\u0434 \u0411\u043e\u0436\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u043f\u043e\u045e\u043d\u044b \u0432\u0435\u043b\u0456\u0447\u044b. \u042f \u043d\u0435 \u0441\u043f\u044b\u0442\u0430\u043b\u0430 \u045e \u044f\u0433\u043e, \u0430\u0434\u043a\u0443\u043b\u044c \u0451\u043d, \u0456 \u0451\u043d \u043d\u0435 \u043d\u0430\u0437\u0432\u0430\u045e \u043c\u043d\u0435 \u0456\u043c\u0435\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u0412\u043e\u0441\u044c \u0442\u044b \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0441\u044b\u043d\u0430; \u0442\u0430\u043c\u0443 \u043d\u0435 \u043f\u0456 \u0432\u0456\u043d\u0430 \u0456 \u0445\u043c\u044f\u043b\u044c\u043d\u043e\u0433\u0430 \u043d\u0430\u043f\u043e\u044e, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430, \u0431\u043e \u0445\u043b\u043e\u043f\u0435\u0446 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0437\u0456\u0440\u044d\u0435\u043c \u0430\u0434 \u0441\u0430\u043c\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f \u0430\u0436 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043d\u043e\u0430\u0445 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u041f\u0430\u043d\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0430\u0437\u0432\u043e\u043b\u044c, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0411\u043e\u0436\u044b, \u044f\u043a\u043e\u0433\u0430 \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e, \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0441 \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e, \u0448\u0442\u043e \u043d\u0430\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u0445\u043b\u043e\u043f\u0446\u0430\u043c, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430&raquo;. \u0412\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u0411\u043e\u0433 \u041c\u0430\u043d\u043e\u0430\u0445\u0430, \u0456 \u0430\u043d\u0451\u043b \u0411\u043e\u0436\u044b \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0436\u043e\u043d\u043a\u0456, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u045e \u043f\u043e\u043b\u0456, \u0430 \u041c\u0430\u043d\u043e\u0430\u0445\u0430, \u043c\u0443\u0436\u0430 \u044f\u0435, \u043d\u0435 \u0431\u044b\u043b\u043e \u0437 \u0451\u044e. \u0416\u043e\u043d\u043a\u0430 \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0431\u0435\u0433\u043b\u0430 \u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u043c\u0443\u0436\u0443, \u043a\u0430\u0436\u0443\u0447\u044b \u044f\u043c\u0443: &laquo;\u0417\u043d\u043e\u045e \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043c\u043d\u0435 \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0434\u0430 \u043c\u044f\u043d\u0435&raquo;. \u041c\u0430\u043d\u043e\u0430\u0445 \u0443\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0441\u0432\u0430\u0451\u0439 \u0436\u043e\u043d\u043a\u0430\u044e. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0426\u0456 \u0442\u044b \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u0433\u044d\u0442\u0430\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u044e?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f&raquo;. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u043d\u043e\u0430\u0445: &laquo;\u0426\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a \u043d\u0430\u043c \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0445\u043b\u043e\u043f\u0446\u0430\u043c \u0456 \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u043b\u044f \u044f\u0433\u043e?&raquo; \u0410\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u043d\u043e\u0430\u0445\u0443: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u044f\u0433\u043e, \u043f\u0440\u0430 \u0448\u0442\u043e \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u0435. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f&rsquo;\u0435 \u0432\u0456\u043d\u0430 \u0456 \u0441\u0456\u0446\u044d\u0440\u044b \u0456 \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0451\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u043d\u043e\u0430\u0445 \u0430\u043d\u0451\u043b\u0443 \u041f\u0430\u043d\u0430: &laquo;\u0414\u0430\u0437\u0432\u043e\u043b\u044c \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0433\u0430\u0442\u0443\u0435\u043c \u0442\u0430\u0431\u0435 \u043a\u0430\u0437\u043b\u044f\u043d\u044f&raquo;. \u0410\u043b\u0435 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u043d\u043e\u0430\u0445\u0443: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u043c\u044f\u043d\u0435, \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0435\u0441\u0446\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0445\u043b\u0435\u0431\u0430. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0433\u0430\u0442\u0443\u0435\u0448 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f, \u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0456 \u044f\u0435 \u041f\u0430\u043d\u0443&raquo;. \u041c\u0430\u043d\u043e\u0430\u0445 \u0436\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u041c\u0430\u043d\u043e\u0430\u0445 \u0441\u043a\u0430\u0437\u0430\u045e \u0430\u043d\u0451\u043b\u0443 \u041f\u0430\u043d\u0430: &laquo;\u042f\u043a\u043e\u0435 \u0456\u043c\u044f \u0442\u0432\u0430\u0451? \u0411\u043e \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0443\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0442\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430&raquo;. \u0410\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0427\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u043f\u044b\u0442\u0430\u0435\u0448\u0441\u044f \u043f\u0440\u0430 \u043c\u0430\u0451 \u0456\u043c\u044f? \u042f\u043d\u043e \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435&raquo;. \u041c\u0430\u043d\u043e\u0430\u0445 \u0443\u0437\u044f\u045e \u043a\u0430\u0437\u043b\u044f\u043d\u044f \u0456 \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0432\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d\u0443 \u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u0456. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0446\u0443\u0434, \u044f\u043a\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u041c\u0430\u043d\u043e\u0430\u0445 \u0456 \u044f\u0433\u043e\u043d\u0430\u044f \u0436\u043e\u043d\u043a\u0430. \u041a\u0430\u043b\u0456 \u043f\u043e\u043b\u044b\u043c\u044f \u043f\u0430\u0447\u0430\u043b\u043e \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0434\u0430 \u043d\u0435\u0431\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u045e \u043f\u043e\u043b\u044b\u043c\u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430. \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u041c\u0430\u043d\u043e\u0430\u0445 \u0456 \u044f\u0433\u043e\u043d\u0430\u044f \u0436\u043e\u043d\u043a\u0430 \u045e\u043f\u0430\u043b\u0456 \u0442\u0432\u0430\u0440\u0430\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0411\u043e\u043b\u044c\u0448 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u045e\u0441\u044f \u041c\u0430\u043d\u043e\u0430\u0445\u0443 \u0456 \u044f\u0433\u043e\u043d\u0430\u0439 \u0436\u043e\u043d\u0446\u044b. \u0422\u0430\u043a \u041c\u0430\u043d\u043e\u0430\u0445 \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u044b\u045e \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430. \u041c\u0430\u043d\u043e\u0430\u0445 \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0451\u0439 \u0436\u043e\u043d\u0446\u044b: &laquo;\u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u043c\u044b \u043f\u0430\u043c\u0440\u043e\u043c, \u0431\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430&raquo;. \u0410\u043b\u0435 \u0436\u043e\u043d\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u041a\u0430\u043b\u0456 \u0431 \u041f\u0430\u043d \u0445\u0430\u0446\u0435\u045e \u043d\u0430\u0448\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u0431\u044b \u0437 \u043d\u0430\u0448\u044b\u0445 \u0440\u0443\u043a \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0432\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443, \u043d\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0431\u044b \u043d\u0430\u043c \u0443\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430, \u0456 \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0431\u044b \u043d\u0430\u043c \u0446\u044f\u043f\u0435\u0440 \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u0447\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0441\u044b\u043d\u0430, \u0456 \u0434\u0430\u043b\u0430 \u044f\u043c\u0443 \u0456\u043c\u044f \u0421\u0430\u043c\u0441\u043e\u043d. \u0420\u043e\u0441 \u0445\u043b\u043e\u043f\u0435\u0446 \u0442\u043e\u0439, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e \u044f\u0433\u043e \u041f\u0430\u043d. \u0410 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u043f\u0430\u0447\u0430\u045e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0456\u043c \u0443 \u043b\u0430\u0433\u0435\u0440\u044b \u0414\u0430\u043d, \u043f\u0430\u043c\u0456\u0436 \u0421\u0430\u0440\u044d\u0430 \u0456 \u042d\u0441\u0442\u0430\u043e\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 13b. 15b; \u0421\u0443\u0434 13, 3\u0430. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b \u0441\u043a\u0430\u0437\u0430\u045e \u0417\u0430\u0445\u0430\u0440\u044b\u0456: \u0416\u043e\u043d\u043a\u0430 \u0442\u0432\u0430\u044f \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u0441\u044b\u043d\u0430, \u0430 \u0442\u044b \u043d\u0430\u0437\u0430\u0432\u0435\u0448 \u044f\u0433\u043e \u0456\u043c\u0435\u043c \u042f\u043d. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0456\u0446\u044c \u043d\u0456 \u0432\u0456\u043d\u0430, \u043d\u0456 \u0441\u0456\u0446\u044d\u0440\u044b \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u044f\u0448\u0447\u044d \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u0451\u0439.<span style=\"color: #ff0000;\"> *<\/span> \u0411\u043e \u0445\u043b\u043e\u043f\u0435\u0446 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0437\u0456\u0440\u044d\u0435\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0436\u043e\u043d\u0446\u044b \u041c\u0430\u043d\u043e\u0430\u0445\u0430 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: \u0422\u044b \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0441\u044b\u043d\u0430, \u0456 \u0431\u0440\u044b\u0442\u0432\u0430 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u0430\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0445\u043b\u043e\u043f\u0435\u0446 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0437\u0456\u0440\u044d\u0435\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"117","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">16, 4-6. 16-31&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u043e\u0434\u0441\u0442\u0443\u043f \u0414\u0430\u043b\u0456\u043b\u044b \u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u0421\u0430\u043c\u0441\u043e\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043a\u0430\u0445\u0430\u045e \u0421\u0430\u043c\u0441\u043e\u043d \u0436\u0430\u043d\u0447\u044b\u043d\u0443 \u0437 \u0434\u0430\u043b\u0456\u043d\u044b \u0421\u0430\u0440\u044d\u043a. \u0417\u0432\u0430\u043b\u0456 \u044f\u0435 \u0414\u0430\u043b\u0456\u043b\u0430. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u044f\u0435 \u045e\u043b\u0430\u0434\u0430\u0440\u044b \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0451\u0439: &laquo;\u041f\u0430\u0434\u043c\u0430\u043d\u0456 \u044f\u0433\u043e \u0456 \u0432\u044b\u0432\u0435\u0434\u0430\u0439, \u0443 \u0447\u044b\u043c \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u0456\u043b\u0430, \u0456 \u044f\u043a \u043d\u0430\u043c \u0430\u0434\u043e\u043b\u0435\u0446\u044c \u044f\u0433\u043e, \u043a\u0430\u0431 \u0437\u0432\u044f\u0437\u0430\u0446\u044c \u044f\u0433\u043e \u0456 \u0437\u043d\u044f\u0441\u0456\u043b\u0456\u0446\u044c. \u0410 \u043c\u044b \u0434\u0430\u0434\u0437\u0456\u043c \u0442\u0430\u0431\u0435 \u043a\u043e\u0436\u043d\u044b \u043f\u0430 \u0441\u0442\u043e \u0441\u044f\u0440\u044d\u0431\u0440\u0430\u043d\u0456\u043a\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0414\u0430\u043b\u0456\u043b\u0430 \u0421\u0430\u043c\u0441\u043e\u043d\u0443: &laquo;\u041f\u0440\u0430\u0448\u0443, \u0441\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u0443 \u0447\u044b\u043c \u0442\u0432\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u0456\u043b\u0430, \u0456 \u0447\u044b\u043c \u0437\u0432\u044f\u0437\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0437\u043d\u044f\u0441\u0456\u043b\u0456\u0446\u044c?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0434\u0430\u043a\u0443\u0447\u0430\u043b\u0430 \u044f\u043c\u0443 \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u0432\u043e\u0440\u043a\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u0430\u0437\u0430\u043b\u044f\u043b\u0430 \u044f\u043c\u0443, \u0456 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u043c\u0443\u0447\u044b\u043b\u0430 \u044f\u0433\u043e, \u0451\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u0451\u0439 \u0443\u0441\u0451 \u0441\u044d\u0440\u0446\u0430 \u0441\u0432\u0430\u0451 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u0411\u0440\u044b\u0442\u0432\u0430 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0430\u0441\u044f \u0434\u0430 \u0433\u0430\u043b\u0430\u0432\u044b \u043c\u0430\u0451\u0439, \u0431\u043e \u044f \u0411\u043e\u0436\u044b \u043d\u0430\u0437\u0456\u0440\u044d\u0439 \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439. \u041a\u0430\u043b\u0456 \u0430\u0441\u0442\u0440\u044b\u0433\u0447\u044b \u043c\u044f\u043d\u0435, \u0442\u043e \u0441\u0456\u043b\u0430 \u043c\u0430\u044f \u043f\u0430\u043a\u0456\u043d\u0435 \u043c\u044f\u043d\u0435, \u0456 \u044f \u0441\u0442\u0430\u043d\u0443 \u0441\u043b\u0430\u0431\u044b, \u0431\u0443\u0434\u0443, \u044f\u043a \u0443\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u043b\u044e\u0434\u0437\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043b\u0456\u043b\u0430, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u0451\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u0451\u0439 \u0443\u0441\u0451 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0443\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u0445, \u0441\u043a\u0430\u0437\u0430\u045e\u0448\u044b: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u044f\u0448\u0447\u044d \u0440\u0430\u0437, \u0431\u043e \u0451\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u043c\u043d\u0435 \u045e\u0441\u0451 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430&raquo;. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u044f\u0435 \u045e\u043b\u0430\u0434\u0430\u0440\u044b \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u044f \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0440\u044d\u0431\u0440\u0430. \u041a\u0430\u043b\u0456 \u0414\u0430\u043b\u0456\u043b\u0430 \u045e\u0441\u044b\u043f\u0456\u043b\u0430 \u0421\u0430\u043c\u0441\u043e\u043d\u0430 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043a\u0430\u043b\u0435\u043d\u044f\u0445, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u044f\u043c\u0443 \u0430\u0431\u0441\u0442\u0440\u044b\u0433\u0447\u044b \u0441\u0435\u043c \u043a\u043e\u0441 \u0437 \u0433\u0430\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439. \u041a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u0447\u0430\u045e \u0441\u043b\u0430\u0431\u043d\u0443\u0446\u044c, \u0456 \u0441\u0456\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u044f\u0433\u043e, \u0442\u0430\u0434\u044b \u044f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0421\u0430\u043c\u0441\u043e\u043d\u0435, \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u043a\u0430\u043b\u044f \u0446\u044f\u0431\u0435!&raquo; \u0401\u043d \u043f\u0440\u0430\u0447\u043d\u0443\u045e\u0441\u044f \u0456 \u043f\u0430\u0434\u0443\u043c\u0430\u045e: &laquo;\u0412\u044b\u0439\u0434\u0443, \u044f\u043a \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044e\u0441\u044f&raquo;. \u041d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u041f\u0430\u043d \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u044f\u0433\u043e. \u0424\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u044f\u0433\u043e \u0456 \u0432\u044b\u043a\u0430\u043b\u0430\u043b\u0456 \u044f\u043c\u0443 \u0432\u043e\u0447\u044b. \u041f\u0440\u044b\u0432\u044f\u043b\u0456 \u044f\u0433\u043e \u045e \u0413\u0430\u0437\u0443 \u0456 \u0437\u0430\u043a\u0430\u0432\u0430\u043b\u0456 \u0434\u0432\u0443\u043c\u0430 \u043c\u0435\u0434\u043d\u044b\u043c\u0456 \u043b\u0430\u043d\u0446\u0443\u0433\u0430\u043c\u0456, \u043a\u0430\u0431 \u0451\u043d \u043c\u0430\u043b\u043e\u045e \u0443 \u0434\u043e\u043c\u0435 \u0432\u044f\u0437\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c \u0447\u0430\u0441\u0430\u043c \u0430\u0431\u0441\u0442\u0440\u044b\u0436\u0430\u043d\u044b\u044f \u0432\u0430\u043b\u0430\u0441\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0430\u0434\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u043d\u0430 \u044f\u0433\u043e \u0433\u0430\u043b\u0430\u0432\u0435. \u0423\u043b\u0430\u0434\u0430\u0440\u044b \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u044f \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0414\u0430\u0433\u043e\u043d\u0443, \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u043e\u0433\u0443, \u0456 \u043f\u0430\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430. \u042f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041d\u0430\u0448 \u0431\u043e\u0433 \u0430\u0434\u0434\u0430\u045e \u0421\u0430\u043c\u0441\u043e\u043d\u0430, \u0432\u043e\u0440\u0430\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0443 \u043d\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u043e\u0434 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u044f\u0433\u043e, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430\u0448 \u0431\u043e\u0433 \u0430\u0434\u0434\u0430\u045e \u0443 \u0440\u0443\u043a\u0456 \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0440\u0430\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u0448\u0430\u0439, \u044f\u043a\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0441\u044d\u0440\u0446\u0430 \u0456\u0445\u043d\u044f\u0435, \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041f\u0430\u043a\u043b\u0456\u0447\u0446\u0435 \u0421\u0430\u043c\u0441\u043e\u043d\u0430, \u043d\u044f\u0445\u0430\u0439 \u0451\u043d \u043f\u0430\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u043d\u0430\u0441&raquo;. \u0422\u0430\u0434\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0421\u0430\u043c\u0441\u043e\u043d\u0430 \u0437 \u0434\u043e\u043c\u0430 \u0432\u044f\u0437\u043d\u044f\u045e, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u043c\u0456\u0436 \u043a\u0430\u043b\u043e\u043d\u0430\u043c\u0456, \u0456 \u0451\u043d \u0441\u043c\u044f\u0448\u044b\u045e \u0456\u0445. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043c\u0441\u043e\u043d \u0445\u043b\u043e\u043f\u0446\u0443, \u044f\u043a\u0456 \u0442\u0440\u044b\u043c\u0430\u045e \u044f\u0433\u043e \u0437\u0430 \u0440\u0443\u043a\u0443: &laquo;\u041f\u0430\u0434\u0432\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u0434\u0430 \u043a\u0430\u043b\u043e\u043d, \u0448\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0430\u0431\u0430\u043f\u0435\u0440\u0446\u0456\u0441\u044f \u043d\u0430 \u0456\u0445&raquo;. \u0414\u043e\u043c \u0436\u0430 \u0433\u044d\u0442\u044b \u0431\u044b\u045e \u043f\u043e\u045e\u043d\u044b \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d. \u0411\u044b\u043b\u0456 \u0442\u0430\u043c \u0443\u0441\u0435 \u045e\u043b\u0430\u0434\u0430\u0440\u044b \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u044f. \u0406 \u043d\u0430 \u0434\u0430\u0445\u0443 \u0431\u044b\u043b\u043e \u043a\u0430\u043b\u044f \u0442\u0440\u043e\u0445 \u0442\u044b\u0441\u044f\u0447 \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u044f\u043a\u0456\u044f \u043d\u0430\u0437\u0456\u0440\u0430\u043b\u0456 \u0437\u0430 \u0432\u044b\u0441\u043c\u0435\u0439\u0432\u0430\u043d\u043d\u0435\u043c \u0421\u0430\u043c\u0441\u043e\u043d\u0430. \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0421\u0430\u043c\u0441\u043e\u043d \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0411\u043e\u0436\u0430, \u043c\u0430\u043b\u044e, \u0443\u0441\u043f\u043e\u043c\u043d\u0456 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435! \u041f\u0440\u0430\u0448\u0443, \u0432\u044f\u0440\u043d\u0456 \u043c\u043d\u0435 \u0441\u0456\u043b\u0443, \u0445\u043e\u0446\u044c \u0431\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043f\u0435\u0440, \u0411\u043e\u0436\u0430, \u043a\u0430\u0431 \u044f \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u043c \u0437\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b!&raquo; \u0410\u0431\u0445\u0430\u043f\u0456\u045e \u0421\u0430\u043c\u0441\u043e\u043d \u0434\u0437\u0432\u0435 \u0441\u044f\u0440\u044d\u0434\u043d\u0456\u044f \u043a\u0430\u043b\u043e\u043d\u044b, \u0448\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u0456 \u0430\u0431\u0430\u043f\u0451\u0440\u0441\u044f \u043d\u0430 \u0456\u0445 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0430\u0439 \u0456 \u0441\u0432\u0430\u0451\u0439 \u043b\u0435\u0432\u0430\u0439 \u0440\u0443\u043a\u043e\u044e, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0433\u0456\u043d\u0443 \u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u043c\u0456!&raquo; \u0406 \u045e\u043f\u0451\u0440\u0441\u044f \u0437 \u0443\u0441\u044f\u0435 \u0441\u0456\u043b\u044b, \u0430 \u0434\u043e\u043c \u0430\u0431\u0432\u0430\u043b\u0456\u045e\u0441\u044f \u043d\u0430 \u045e\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0456 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0456\u043c. \u0410 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u044b\u0445, \u044f\u043a\u0456\u0445 \u0437\u0430\u0431\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u043e\u044e \u0421\u0430\u043c\u0441\u043e\u043d, \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0451\u043d \u0437\u0430\u0431\u0456\u045e \u043f\u0440\u044b \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0431\u0430\u0446\u044c\u043a\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u0432\u044b\u043d\u0435\u0441\u043b\u0456 \u044f\u0433\u043e. \u0412\u044b\u0439\u0448\u0430\u045e\u0448\u044b, \u044f\u043d\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u043c\u0456\u0436 \u0421\u0430\u0440\u044d\u0430 \u0456 \u042d\u0441\u0442\u0430\u043e\u043b\u0430\u043c, \u0443 \u043c\u0430\u0433\u0456\u043b\u0435 \u041c\u0430\u043d\u043e\u0430\u0445\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430. \u0421\u0430\u043c\u0441\u043e\u043d \u0431\u044b\u045e \u0441\u0443\u0434\u0434\u0437\u0451\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 43 (42), 1\u0430; 31 (30), 4\u0430; \u043f\u0430\u0440. \u0421\u0443\u0434 16, 28b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0443\u0434\u0437\u0456 \u043c\u044f\u043d\u0435, \u0411\u043e\u0436\u0430, \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456 \u043c\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043d\u0435\u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0422\u044b \u043c\u0430\u044f \u0441\u043a\u0430\u043b\u0430 \u0456 \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u043f\u043e\u043c\u043d\u0456 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u0456 \u0432\u044f\u0440\u043d\u0456 \u043c\u043d\u0435 \u0441\u0456\u043b\u0443, \u0445\u043e\u0446\u044c \u0431\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043f\u0435\u0440.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0422\u044b \u0422\u044b \u043c\u0430\u044f \u0441\u043a\u0430\u043b\u0430 \u0456 \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"121","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">16, 1-13&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043c\u0443\u044d\u043b\u044e: &laquo;\u041a\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u043f\u0430 \u0421\u0430\u045e\u043b\u0443, \u044f\u043a\u043e\u0433\u0430 \u042f \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u044f\u043a \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f? \u041d\u0430\u043f\u043e\u045e\u043d\u0456 \u0440\u043e\u0433 \u0441\u0432\u043e\u0439 \u0430\u043b\u0435\u0435\u043c \u0456 \u0456\u0434\u0437\u0456. \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0446\u044f\u0431\u0435 \u0434\u0430 \u0415\u0441\u044d\u044f \u0437 \u0411\u044d\u0442\u043b\u0435\u0435\u043c\u0430, \u0431\u043e \u042f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0441\u0430\u0431\u0435 \u043a\u0430\u0440\u0430\u043b\u044f \u043c\u0456\u0436 \u0441\u044b\u043d\u0430\u043c\u0456 \u044f\u0433\u043e\u043d\u044b\u043c\u0456&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043c\u0443\u044d\u043b\u044c: &laquo;\u042f\u043a \u0436\u0430 \u043f\u0430\u0439\u0434\u0443 \u044f?&raquo; \u0421\u0430\u045e\u043b \u043f\u0430\u0447\u0443\u0435 \u0456 \u0437\u0430\u0431&rsquo;\u0435 \u043c\u044f\u043d\u0435. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u0446\u044f\u043b\u044f \u0441\u0430 \u0441\u0442\u0430\u0442\u043a\u0443 \u045e \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u0441\u043a\u0430\u0436\u044b: &ldquo;\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443&rdquo;. \u0406 \u0437\u0430\u043f\u0440\u0430\u0441\u0456 \u0415\u0441\u044d\u044f \u0434\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f, \u0430 \u042f \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u0446\u044c. \u0422\u044b \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0448 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0437\u0440\u0430\u0431\u0456\u045e, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d, \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0411\u044d\u0442\u043b\u0435\u0435\u043c. \u0410 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043d\u044b\u044f \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u0433\u043e\u0440\u0430\u0434\u0430 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0456 \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0426\u0456 \u0437 \u043c\u0456\u0440\u0430\u043c \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0442\u044b?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417 \u043c\u0456\u0440\u0430\u043c; \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443. \u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435\u0441\u044f \u0456 \u0456\u0434\u0437\u0456\u0446\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443&raquo;. \u0422\u0430\u0434\u044b \u0415\u0441\u044d\u0439 \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0441\u044f\u0431\u0435 \u0456 \u0441\u044b\u043d\u043e\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456\u0445 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u045e\u0432\u0430\u0439\u0448\u043b\u0456, \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u042d\u043b\u0456\u044f\u0432\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0433\u044d\u0442\u0430 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a \u042f\u0433\u043e\u043d\u044b!&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0421\u0430\u043c\u0443\u044d\u043b\u044e: &laquo;\u041d\u0435 \u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0456 \u043d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u044f\u0433\u043e, \u043d\u0456 \u043d\u0430 \u044f\u0433\u043e\u043d\u044b \u0432\u044b\u0441\u043e\u043a\u0456 \u0440\u043e\u0441\u0442, \u0431\u043e \u042f \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u044f\u0433\u043e. \u042f \u043d\u0435 \u0433\u043b\u044f\u0434\u0436\u0443, \u044f\u043a \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0432\u0456\u0434\u0430\u0432\u043e\u043a\u0443, \u0430 \u041f\u0430\u043d \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430&raquo;. \u0406 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0415\u0441\u044d\u0439 \u0410\u043c\u0456\u043d\u0430\u0434\u0430\u0431\u0430, \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u044f\u0433\u043e \u0434\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406 \u043d\u0435 \u044f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u041f\u0430\u043d&raquo;. \u0422\u0430\u0434\u044b \u0415\u0441\u044d\u0439 \u043f\u0440\u044b\u0432\u0451\u045e \u0421\u0430\u043c\u0430, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u044f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u041f\u0430\u043d&raquo;. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0415\u0441\u044d\u0439 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0441\u0435\u043c\u044f\u0440\u044b\u0445 \u0441\u044b\u043d\u043e\u045e, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0415\u0441\u044d\u044e: &laquo;\u041f\u0430\u043d \u043d\u0456\u043a\u043e\u0433\u0430 \u0437 \u0456\u0445 \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0415\u0441\u044d\u044e: &laquo;\u0426\u0456 \u0433\u044d\u0442\u0430 \u045e\u0441\u0435 \u0442\u0432\u0430\u0435 \u0441\u044b\u043d\u044b?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u044f\u0448\u0447\u044d \u043c\u0430\u043b\u043e\u0434\u0448\u044b, \u0451\u043d \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0415\u0441\u044d\u044e: &laquo;\u041f\u0430\u0448\u043b\u0456, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u044f\u0433\u043e, \u0431\u043e \u043d\u0435 \u0441\u044f\u0434\u0437\u0435\u043c \u0437\u0430 \u0441\u0442\u043e\u043b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435&raquo;. \u0422\u0430\u0434\u044b \u0415\u0441\u044d\u0439 \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u0456 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u044f\u0433\u043e. \u0401\u043d \u0431\u044b\u045e \u0440\u0443\u0434\u044b, \u043c\u0435\u045e \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f \u0432\u043e\u0447\u044b \u0456 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u044b \u0432\u044b\u0433\u043b\u044f\u0434. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456 \u044f\u0433\u043e, \u0431\u043e \u0433\u044d\u0442\u0430 \u0451\u043d&raquo;. \u0422\u0430\u0434\u044b \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u043f\u0440\u044b\u043d\u0451\u0441 \u0440\u043e\u0433 \u0437 \u0430\u043b\u0435\u0435\u043c \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u043c\u0456\u0436 \u0431\u0440\u0430\u0442\u043e\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u0406 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e \u0434\u043d\u044f. \u0410 \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0443\u0441\u0442\u0430\u045e \u0456 \u0430\u0434\u044b\u0448\u043e\u045e \u0443 \u0420\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 89 (88), 20bc. 22a. 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0434\u0430\u043f\u0430\u043c\u043e\u0433 \u0430\u0434\u0432\u0430\u0436\u043d\u0430\u043c\u0443, \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u0437 \u043d\u0430\u0440\u043e\u0434\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0420\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u043d\u0430\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434\u0430, \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u0433\u043e, \u042f \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u041c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0430\u043b\u0435\u0435\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"122","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">17, 1-10. 32. 38-51&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u0413\u0430\u043b\u0456\u044f\u0442\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0424\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0441\u0430\u0431\u0440\u0430\u043b\u0456 \u0432\u043e\u0439\u0441\u043a\u0456 \u0441\u0432\u0430\u0435 \u043d\u0430 \u0432\u0430\u0439\u043d\u0443 \u0456 \u0441\u044b\u0448\u043b\u0456\u0441\u044f \u045e \u0421\u0430\u043a\u043e, \u0448\u0442\u043e \u045e \u042e\u0434\u044d\u0456. \u0420\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043f\u0430\u043c\u0456\u0436 \u0421\u0430\u043a\u043e \u0456 \u0410\u0437\u044d\u043a\u0430\u043c \u0443 \u042d\u0444\u044d\u0441-\u0414\u0430\u043c\u0456\u043c\u0435. \u0410 \u0421\u0430\u045e\u043b \u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0456 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u0443 \u0434\u0430\u043b\u0456\u043d\u0435 \u0422\u044d\u0440\u044d\u0431\u0456\u043d\u0442\u0430, \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0432\u0430\u0439\u043d\u044b \u0437 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u043c\u0456. \u0424\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u043d\u0430 \u0433\u0430\u0440\u044b \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443, \u0430 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u043d\u0430 \u0433\u0430\u0440\u044b \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443, \u0430 \u043f\u0430\u043c\u0456\u0436 \u0456\u043c\u0456 \u0431\u044b\u043b\u0430 \u0434\u0430\u043b\u0456\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0432\u043e\u0439\u0441\u043a\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e \u0432\u044b\u0439\u0448\u0430\u045e \u043f\u044d\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0413\u0430\u0442\u0430 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0413\u0430\u043b\u0456\u044f\u0442. \u0420\u043e\u0441\u0442\u0430\u043c \u0451\u043d \u0431\u044b\u045e \u0448\u044d\u0441\u0446\u044c \u043b\u043e\u043a\u0446\u044f\u045e \u0437 \u043f\u044f\u0434\u0437\u044f\u044e. \u041d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u044f\u0433\u043e \u0431\u044b\u045e \u043c\u0435\u0434\u043d\u044b \u0448\u043b\u0435\u043c. \u0410\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u0451\u043d \u0431\u044b\u045e \u0443 \u043b\u0443\u0441\u043a\u0430\u0432\u044b\u044f \u043b\u0430\u0442\u044b, \u0430 \u0432\u0430\u0433\u0430 \u043b\u0430\u0442\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0431\u044b\u043b\u0430 \u043f\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0441\u0456\u043a\u043b\u044f\u045e \u043c\u0435\u0434\u0437\u0456. \u041d\u0430 \u043d\u0430\u0433\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445 \u0431\u044b\u043b\u0456 \u043c\u0435\u0434\u043d\u044b\u044f \u043d\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456\u043a\u0456, \u0430 \u0437\u0430 \u043f\u043b\u044f\u0447\u0430\u043c\u0456 \u043c\u0435\u045e \u043c\u0435\u0434\u043d\u0443\u044e \u0434\u0437\u0456\u0434\u0443. \u0414\u0440\u044d\u045e\u043a\u0430 \u0434\u0437\u0456\u0434\u044b \u044f\u0433\u043e\u043d\u0430\u0439, \u044f\u043a \u043d\u0430\u0432\u043e\u0439 \u0443 \u043a\u0440\u043e\u0441\u043d\u0430\u0445, \u0430 \u0441\u0430\u043c \u043d\u0430\u043a\u0430\u043d\u0435\u0447\u043d\u0456\u043a \u0434\u0437\u0456\u0434\u044b \u044f\u0433\u043e\u043d\u0430\u0439 \u0432\u0430\u0436\u044b\u045e \u0448\u044d\u0441\u0446\u044c\u0441\u043e\u0442 \u0441\u0456\u043a\u043b\u044f\u045e \u0436\u0430\u043b\u0435\u0437\u0430. \u041f\u0435\u0440\u0430\u0434 \u0456\u043c \u0456\u0448\u043e\u045e \u0437\u0431\u0440\u0430\u044f\u043d\u043e\u0441\u0435\u0446, \u044f\u043a\u0456 \u043d\u0451\u0441 \u0448\u0447\u044b\u0442. \u0413\u0430\u043b\u0456\u044f\u0442 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u0456 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e \u0434\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b \u0456\u043c: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u044b\u0439\u0448\u043b\u0456 \u0432\u044b \u0432\u0430\u044f\u0432\u0430\u0446\u044c? \u0426\u0456 \u0436 \u044f \u043d\u0435 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d, \u0430 \u0432\u044b \u0446\u0456 \u0436 \u043d\u0435 \u0441\u043b\u0443\u0433\u0456 \u0421\u0430\u045e\u043b\u0430? \u0412\u044b\u0431\u0435\u0440\u044b\u0446\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0451\u043d \u0432\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435. \u041a\u0430\u043b\u0456 \u0451\u043d \u0437\u043c\u043e\u0436\u0430 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u0430 \u043c\u043d\u043e\u044e \u0456 \u0437\u0430\u0431&rsquo;\u0435 \u043c\u044f\u043d\u0435, \u0442\u043e \u043c\u044b \u0441\u0442\u0430\u043d\u0435\u043c \u0432\u0430\u0448\u044b\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456. \u0410 \u043a\u0430\u043b\u0456 \u044f \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0443 \u0456 \u0437\u0430\u0431&rsquo;\u044e \u044f\u0433\u043e, \u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u043d\u0430\u0448\u044b\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u043d\u0430\u043c&raquo;. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d: &laquo;\u0421\u0451\u043d\u043d\u044f \u044f \u0437\u043d\u044f\u0432\u0430\u0436\u0443 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u0435: \u0434\u0430\u0439\u0446\u0435 \u043c\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043c\u044b \u043f\u0430\u0434\u0443\u0436\u0430\u0435\u043c\u0441\u044f \u0437 \u0456\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0434\u0430 \u0421\u0430\u045e\u043b\u0430 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0414\u0430\u0432\u0456\u0434\u0430, \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435 \u0430\u0434\u0432\u0430\u0433\u0456. \u042f, \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u043e\u0439, \u043f\u0430\u0439\u0434\u0443 \u0456 \u0431\u0443\u0434\u0443 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0433\u044d\u0442\u044b\u043c \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0421\u0430\u045e\u043b \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u045e \u0441\u0432\u0430\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u043d\u0430\u0434\u0437\u0435\u045e \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u044f\u0433\u043e\u043d\u0443\u044e \u043c\u0435\u0434\u043d\u044b \u0448\u043b\u0435\u043c, \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u043b\u0430\u0442\u044b. \u0410\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0441\u044f \u0414\u0430\u0432\u0456\u0434 \u0441\u0432\u0430\u0456\u043c \u043c\u044f\u0447\u043e\u043c \u043f\u0430\u0432\u0435\u0440\u0445 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0456 \u0456 \u043f\u0430\u0447\u0430\u045e \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u0431\u043e \u043d\u0435 \u0445\u0430\u0434\u0437\u0456\u045e \u0442\u0430\u043a \u0440\u0430\u043d\u0435\u0439. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0421\u0430\u045e\u043b\u0443: &laquo;\u042f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c, \u044f \u043d\u0435 \u043f\u0440\u044b\u0432\u044b\u043a&raquo;. \u0422\u0430\u043c\u0443 \u0437\u043d\u044f\u045e \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437 \u0441\u044f\u0431\u0435. \u0423\u0437\u044f\u045e \u043a\u0456\u0439 \u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u0430\u0431\u0435 \u043f\u044f\u0446\u044c \u0433\u043b\u0430\u0434\u043a\u0456\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0437 \u0440\u0443\u0447\u0430\u044f, \u0456 \u043f\u0430\u043a\u043b\u0430\u045e \u0456\u0445 \u0443 \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u0432\u0443 \u0442\u043e\u0440\u0431\u0443, \u044f\u043a\u0443\u044e \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u045e \u044f\u043a \u043c\u0435\u0445 \u0434\u043b\u044f \u043a\u0430\u043c\u044f\u043d\u0451\u045e. \u0423\u0437\u044f\u045e \u0443 \u0440\u0443\u043a\u0443 \u043f\u0440\u0430\u0448\u0447\u0443 \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430 \u0441\u0432\u0430\u0456\u043c \u0437\u0431\u0440\u0430\u044f\u043d\u043e\u0441\u0446\u0430\u043c \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d, \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u045e\u0441\u0451 \u0431\u043b\u0456\u0436\u044d\u0439. \u041a\u0430\u043b\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0435\u045e\u0441\u044f \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0414\u0430\u0432\u0456\u0434\u0430, \u0437\u0456\u0440\u043d\u0443\u045e \u043d\u0430 \u044f\u0433\u043e \u0437 \u043f\u0430\u0433\u0430\u0440\u0434\u0430\u044e, \u0431\u043e \u0442\u043e\u0439 \u0431\u044b\u045e \u043c\u0430\u043b\u0430\u0434\u044b, \u0440\u0443\u0434\u044b \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u044b \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0425\u0456\u0431\u0430 \u044f \u0441\u0430\u0431\u0430\u043a\u0430, \u0448\u0442\u043e \u0442\u044b \u0437 \u043a\u0456\u0435\u043c \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430 \u043c\u044f\u043d\u0435?&raquo; \u0406 \u043f\u0440\u0430\u043a\u043b\u044f\u043d\u0443\u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u045e\u0441\u0456\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456. \u0406 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u041f\u0430\u0434\u044b\u0434\u0437\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435, \u0456 \u044f \u043f\u0430\u043a\u0456\u043d\u0443 \u0442\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u043f\u0442\u0443\u0448\u043a\u0430\u043c \u0456 \u043f\u0430\u043b\u044f\u0432\u044b\u043c \u0437\u0432\u044f\u0440\u0430\u043c&raquo;. \u0421\u043a\u0430\u0437\u0430\u045e \u0456 \u0414\u0430\u0432\u0456\u0434 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0443: &laquo;\u0422\u044b \u0456\u0434\u0437\u0435\u0448 \u043d\u0430 \u043c\u044f\u043d\u0435 \u0437 \u0434\u0437\u0456\u0434\u0430\u044e, \u043c\u044f\u0447\u043e\u043c \u0456 \u043f\u0456\u043a\u0430\u0439, \u0430 \u044f \u0456\u0434\u0443 \u043d\u0430 \u0446\u044f\u0431\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433\u0430 \u0432\u043e\u0439\u0441\u043a \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u0442\u044b \u0433\u0430\u043d\u0456\u045e. \u0421\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0446\u044f\u0431\u0435 \u045e \u043c\u0430\u0435 \u0440\u0443\u043a\u0456, \u0456 \u044f \u045e\u0434\u0430\u0440\u0443 \u0446\u044f\u0431\u0435, \u0456 \u0430\u0434\u0441\u044f\u043a\u0443 \u0442\u0430\u0431\u0435 \u0433\u0430\u043b\u0430\u0432\u0443 \u0442\u0432\u0430\u044e. \u0410 \u0442\u0440\u0443\u043f \u0442\u0432\u043e\u0439 \u0456 \u0442\u0440\u0443\u043f\u044b \u0432\u043e\u0456\u043d\u0430\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u0445 \u044f \u0430\u0434\u0434\u0430\u043c \u0441\u0451\u043d\u043d\u044f \u043f\u0442\u0443\u0448\u043a\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0456 \u043f\u0430\u043b\u044f\u0432\u044b\u043c \u0437\u0432\u044f\u0440\u0430\u043c, \u043a\u0430\u0431 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0411\u043e\u0433 \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456, \u0456 \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0445\u043e\u0434, \u0448\u0442\u043e \u043d\u0435 \u043c\u044f\u0447\u043e\u043c \u0456 \u0434\u0437\u0456\u0434\u0430\u044e \u0440\u0430\u0442\u0443\u0435 \u041f\u0430\u043d. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u042f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0431\u0456\u0442\u0432\u0430, \u0401\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0441 \u0443 \u0440\u0443\u043a\u0456 \u043d\u0430\u0448\u044b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d \u0456, \u043f\u0430\u0434\u044b\u0448\u043e\u045e\u0448\u044b, \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u0442\u043e\u0439 \u0445\u0443\u0442\u043a\u0430 \u043f\u0430\u0431\u0435\u0433 \u043d\u0430 \u0431\u0456\u0442\u0432\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430. \u0406 \u0437\u0430\u0441\u0443\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u045e \u0442\u043e\u0440\u0431\u0443, \u0443\u0437\u044f\u045e \u0430\u0434\u0437\u0456\u043d \u043a\u0430\u043c\u0435\u043d\u044c \u0456 \u043a\u0456\u043d\u0443\u045e \u0437 \u043f\u0440\u0430\u0448\u0447\u044b. \u0406 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0443 \u045e \u043b\u043e\u0431, \u0430\u0436 \u043a\u0430\u043c\u0435\u043d\u044c \u0430\u0434\u0431\u0456\u045e\u0441\u044f \u043d\u0430 \u0447\u0430\u043b\u0435 \u044f\u0433\u043e\u043d\u044b\u043c; \u0456 \u045e\u043f\u0430\u045e \u0451\u043d \u0442\u0432\u0430\u0440\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0422\u0430\u043a \u0414\u0430\u0432\u0456\u0434 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u0435\u043c \u0456 \u043f\u0440\u0430\u0448\u0447\u0430\u044e \u0456, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430, \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e. \u0425\u043e\u0446\u044c \u0414\u0430\u0432\u0456\u0434 \u043d\u0435 \u043c\u0435\u045e \u0443 \u0440\u0443\u0446\u044d \u043c\u044f\u0447\u0430, \u043f\u0430\u0434\u0431\u0435\u0433 \u0456 \u0441\u0442\u0430\u045e \u043d\u0430\u0434 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430\u043c, \u0456 \u0441\u0445\u0430\u043f\u0456\u045e \u044f\u0433\u043e\u043d\u044b \u043c\u0435\u0447, \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0437 \u043d\u043e\u0436\u043d\u0430\u045e \u0456 \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e, \u0430\u0434\u0441\u0435\u043a\u0448\u044b \u0433\u0430\u043b\u0430\u0432\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u043d\u0430\u0439\u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b \u0437 \u0456\u0445, \u043a\u0456\u043d\u0443\u043b\u0456\u0441\u044f \u045e\u0446\u044f\u043a\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u0421\u0430\u043c 17, 37; \u043f\u0430\u0440. \u041f\u0441 57 (56), 4\u0441. 5\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d, \u044f\u043a\u0456 \u0432\u044b\u0440\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0437 \u043b\u0430\u043f\u0430\u045e \u0456\u043b\u044c\u0432\u043e\u045e \u0456 \u043c\u044f\u0434\u0437\u0432\u0435\u0434\u0437\u044f\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0440\u0443\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0448\u043b\u0435 \u0411\u043e\u0433 \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u045e\u0434\u0443 \u0441\u0432\u0430\u044e \u0456 \u045e\u0440\u0430\u0442\u0443\u0435 \u043c\u044f\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u043b\u044c\u0432\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0440\u0443\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"123","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">17, 57 &ndash; 18, 9. 20-30&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0430\u045e\u043b \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c \u0414\u0430\u0432\u0456\u0434\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430, \u0443\u0437\u044f\u045e \u044f\u0433\u043e \u0410\u0431\u043d\u044d\u0440 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0421\u0430\u045e\u043b\u0430. \u0410 \u0443 \u0440\u0443\u0446\u044d \u0414\u0430\u0432\u0456\u0434\u0430 \u0431\u044b\u043b\u0430 \u0433\u0430\u043b\u0430\u0432\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430. \u0421\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u044f\u0433\u043e \u0421\u0430\u045e\u043b: &laquo;\u0427\u044b\u0439 \u0442\u044b \u0441\u044b\u043d, \u0445\u043b\u043e\u043f\u0447\u0430?&raquo; \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0441\u044b\u043d \u0441\u043b\u0443\u0433\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0415\u0441\u044d\u044f \u0437 \u0411\u044d\u0442\u043b\u0435\u0435\u043c\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0440\u0430\u0437\u043c\u043e\u0432\u0443 \u0437 \u0421\u0430\u045e\u043b\u0430\u043c, \u0401\u043d\u0430\u0442\u0430\u043d \u0430\u0434\u0447\u0443\u045e \u0441\u0456\u043c\u043f\u0430\u0442\u044b\u044e \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0433\u043e, \u044f\u043a \u0441\u044f\u0431\u0435. \u0410 \u0421\u0430\u045e\u043b \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u044f\u043c\u0443 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0434\u043e\u043c \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0431\u0430\u0446\u044c\u043a\u0456. \u0410 \u0401\u043d\u0430\u0442\u0430\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0414\u0430\u0432\u0456\u0434\u0430\u043c \u0434\u0430\u043c\u043e\u0432\u0443, \u0431\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0433\u043e, \u044f\u043a \u0441\u044f\u0431\u0435. \u0401\u043d\u0430\u0442\u0430\u043d \u0437\u043d\u044f\u045e \u043f\u043b\u0430\u0448\u0447, \u044f\u043a\u0456 \u0431\u044b\u045e \u043d\u0430 \u0456\u043c, \u0456 \u0430\u0434\u0434\u0430\u045e \u044f\u0433\u043e \u0414\u0430\u0432\u0456\u0434\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u044e, \u043d\u0430\u0432\u0430\u0442 \u043c\u0435\u0447 \u0456 \u043b\u0443\u043a, \u0456 \u043f\u0430\u0441. \u0414\u0430\u0432\u0456\u0434 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u0430 \u045e\u0441\u0435 \u0432\u044b\u043f\u0440\u0430\u0432\u044b, \u043d\u0430 \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u044b\u043b\u0430\u045e \u044f\u0433\u043e \u0421\u0430\u045e\u043b, \u0442\u0430\u043c\u0443 \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0421\u0430\u045e\u043b \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u043d\u0430\u0434 \u0432\u0430\u044f\u0440\u0430\u043c\u0456. \u041f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u0451\u043d \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u043b\u0443\u0433\u0430\u043c \u0421\u0430\u045e\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0437\u0430\u0431\u0456\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430, \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0437 \u0443\u0441\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u043a\u0430\u0440\u0430\u043b\u044e \u0421\u0430\u045e\u043b\u0443 \u0441\u0430 \u0441\u043f\u0435\u0432\u0430\u043c\u0456 \u0456 \u0442\u0430\u043d\u0446\u0430\u043c\u0456, \u043f\u0430\u0434 \u0433\u0443\u043a\u0456 \u0431\u0443\u0431\u043d\u0430\u045e, \u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c\u0456 \u043f\u0435\u0441\u043d\u044f\u043c\u0456 \u0456 \u0437 \u0446\u044b\u043c\u0431\u0430\u043b\u0430\u043c\u0456. \u0413\u0440\u0430\u044e\u0447\u044b, \u044f\u043d\u044b \u0441\u043f\u044f\u0432\u0430\u043b\u0456: &laquo;\u0421\u0430\u045e\u043b \u0437\u0430\u0431\u0456\u045e \u0442\u044b\u0441\u044f\u0447\u0443, \u0430 \u0414\u0430\u0432\u0456\u0434 \u0437\u0430\u0431\u0456\u045e \u0434\u0437\u0435\u0441\u044f\u0442\u043a\u0456 \u0442\u044b\u0441\u044f\u0447&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0421\u0430\u045e\u043b \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f, \u0431\u043e \u0431\u044b\u043b\u0456 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0434\u043b\u044f \u044f\u0433\u043e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d: &laquo;\u0414\u0430\u0432\u0456\u0434\u0443 \u043f\u0440\u044b\u043f\u0456\u0441\u0430\u043b\u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0430 \u043c\u043d\u0435 \u043f\u0440\u044b\u043f\u0456\u0441\u0430\u043b\u0456 \u0442\u044b\u0441\u044f\u0447\u0443, \u044f\u043c\u0443 \u043d\u0435\u0441\u0442\u0430\u0435 \u044f\u0448\u0447\u044d \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430&raquo;. \u0410\u0434 \u0442\u0430\u0433\u043e \u0434\u043d\u044f \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0421\u0430\u045e\u043b \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u043a\u0440\u044b\u0432\u044b\u043c \u0432\u043e\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u043a\u0430\u0445\u0430\u043b\u0430 \u041c\u0456\u043a\u0430\u043b\u044c, \u0434\u0430\u0447\u043a\u0430 \u0421\u0430\u045e\u043b\u0430. \u0406 \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0421\u0430\u045e\u043b\u0443, \u0442\u043e \u045e \u044f\u0433\u043e \u0432\u0430\u0447\u0430\u0445 \u0432\u044b\u0434\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u044b\u043c. \u0406 \u043f\u0430\u0434\u0443\u043c\u0430\u045e \u0421\u0430\u045e\u043b: &laquo;\u0410\u0434\u0434\u0430\u043c \u044f\u0435 \u0437\u0430 \u044f\u0433\u043e, \u0456 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u044f\u043c\u0443 \u0441\u0456\u043b\u043e\u043c, \u0456 \u0440\u0443\u043a\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0456\u043c&raquo;. \u0422\u0430\u043a \u0443 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u045e\u043b \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0421\u0451\u043d\u043d\u044f \u043c\u043e\u0436\u0430\u0448 \u0441\u0442\u0430\u0446\u044c \u043c\u0430\u0456\u043c \u0437\u044f\u0446\u0435\u043c&raquo;. \u041f\u0430\u0441\u043b\u044f \u0421\u0430\u045e\u043b \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0441\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c: &laquo;\u0421\u043a\u0430\u0436\u044b\u0446\u0435 \u0414\u0430\u0432\u0456\u0434\u0443 \u043f\u0430 \u0441\u0430\u043a\u0440\u044d\u0442\u0443: &ldquo;\u0421\u043f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u0442\u044b \u043a\u0430\u0440\u0430\u043b\u044e, \u0456 \u045e\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u043b\u044e\u0431\u044f\u0446\u044c \u0446\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0441\u0442\u0430\u043d\u044c \u0437\u044f\u0446\u0435\u043c \u043a\u0430\u0440\u0430\u043b\u044f&rdquo;&raquo;. \u041f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u0441\u043b\u0443\u0433\u0456 \u0421\u0430\u045e\u043b\u0430 \u0414\u0430\u0432\u0456\u0434\u0443 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434: &laquo;\u0425\u0456\u0431\u0430 \u043b\u0451\u0433\u043a\u0430, \u044f\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u0432\u0430\u043c, \u0441\u0442\u0430\u0446\u044c \u0437\u044f\u0446\u0435\u043c \u043a\u0430\u0440\u0430\u043b\u044f? \u042f \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0435\u0434\u043d\u044b \u0456 \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u044b&raquo;. \u0406 \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u0421\u0430\u045e\u043b\u0443 \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434. \u0421\u0430\u045e\u043b \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u043a \u0441\u043a\u0430\u0436\u044b\u0446\u0435 \u0414\u0430\u0432\u0456\u0434\u0443: &ldquo;\u041d\u0435 \u0445\u043e\u0447\u0430 \u043a\u0430\u0440\u043e\u043b\u044c \u0432\u044b\u043a\u0443\u043f\u0443, \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u043e \u043a\u0440\u0430\u0439\u043d\u0456\u0445 \u043f\u043b\u043e\u0446\u044f\u045e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u0445, \u043a\u0430\u0431 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u044f&rdquo;&raquo;. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0421\u0430\u045e\u043b \u0434\u0443\u043c\u0430\u045e \u0437\u0430\u0433\u0443\u0431\u0456\u0446\u044c \u0414\u0430\u0432\u0456\u0434\u0430 \u0440\u0443\u043a\u0430\u043c\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0414\u0430\u0432\u0456\u0434\u0443 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0456 \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0430\u0441\u044f \u044f\u043c\u0443 \u0441\u0442\u0430\u0446\u044c \u0437\u044f\u0446\u0435\u043c \u043a\u0430\u0440\u0430\u043b\u044f. \u042f\u0448\u0447\u044d \u043d\u0435 \u043c\u0456\u043d\u0443\u043b\u0456 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0434\u043d\u0456, \u044f\u043a \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0456 \u0437\u0430\u0431\u0456\u045e \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u043c\u0443\u0436\u0447\u044b\u043d \u0441\u044f\u0440\u043e\u0434 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e. \u041f\u0440\u044b\u043d\u0451\u0441 \u0414\u0430\u0432\u0456\u0434 \u043a\u0440\u0430\u0439\u043d\u0456\u044f \u043f\u043b\u043e\u0446\u0456 \u0456\u0445\u043d\u0456\u044f \u0456 \u043f\u0430\u0434\u0430\u045e \u0456\u0445 \u0443 \u043f\u043e\u045e\u043d\u044b\u043c \u043b\u0456\u043a\u0443 \u043a\u0430\u0440\u0430\u043b\u044e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0437\u044f\u0446\u0435\u043c \u043a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0434\u0430\u045e \u0421\u0430\u045e\u043b \u0437\u0430 \u044f\u0433\u043e \u041c\u0456\u043a\u0430\u043b\u044c, \u0434\u0430\u0447\u043a\u0443 \u0441\u0432\u0430\u044e. \u0422\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0430\u045e\u043b \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u041f\u0430\u043d \u0437 \u0414\u0430\u0432\u0456\u0434\u0430\u043c, \u0456 \u0448\u0442\u043e \u041c\u0456\u043a\u0430\u043b\u044c, \u0434\u0430\u0447\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f, \u043b\u044e\u0431\u0456\u0446\u044c \u044f\u0433\u043e. \u0421\u0430\u045e\u043b \u043f\u0430\u0447\u0430\u045e \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u044f\u0446\u0446\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0441\u0442\u0430\u045e \u0451\u043d \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u043d\u0430 \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u0441\u043a\u0456\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043d\u0430 \u0432\u0430\u0439\u043d\u0443, \u0414\u0430\u0432\u0456\u0434\u0443 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u0431\u0456\u0442\u0432\u0435 \u0448\u0430\u043d\u0446\u0430\u0432\u0430\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0421\u0430\u045e\u043b\u0430. \u0422\u0430\u043c\u0443 \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0430\u0441\u044f \u0456\u043c\u044f \u044f\u0433\u043e\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 56 (55), 2. 4b. 14\u0430b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0411\u043e\u0436\u0430, \u0431\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u043c\u044f\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0446\u044d\u043b\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u043f\u0430\u0434\u0430\u0435 \u0456 \u045e\u0446\u0456\u0441\u043a\u0430\u0435 \u043c\u044f\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u042f \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u0431\u0430\u0432\u0456\u045e \u0434\u0443\u0448\u0443 \u043c\u0430\u044e \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043d\u043e\u0433\u0456 \u0430\u0434 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"124","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">19, 8-10; 20, 1-17&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0401\u043d\u0430\u0442\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0417\u043d\u043e\u045e \u043f\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u0432\u0430\u0439\u043d\u0430. \u0412\u044b\u0439\u0448\u0430\u045e \u0414\u0430\u0432\u0456\u0434, \u043a\u0430\u0431 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u043c\u0456, \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0456\u0445 \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0431\u0430\u0456, \u0442\u0430\u043a \u0448\u0442\u043e \u043f\u0430\u045e\u0446\u044f\u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0430\u0434 \u044f\u0433\u043e. \u0422\u0430\u0434\u044b \u0437\u043b\u044b \u0434\u0443\u0445, \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430\u0445\u0430\u043f\u0456\u045e \u0421\u0430\u045e\u043b\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u0441\u044f\u0434\u0437\u0435\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435, \u0430 \u0434\u0437\u0456\u0434\u0430 \u0431\u044b\u043b\u0430 \u045e \u044f\u0433\u043e \u0440\u0443\u0446\u044d. \u0414\u0430\u0432\u0456\u0434 \u0436\u0430 \u0456\u0433\u0440\u0430\u045e \u0440\u0443\u043a\u043e\u044e \u0441\u0432\u0430\u0451\u044e \u043d\u0430 \u0441\u0442\u0440\u0443\u043d\u0430\u0445. \u0425\u0430\u0446\u0435\u045e \u0421\u0430\u045e\u043b \u043f\u0440\u044b\u0431\u0456\u0446\u044c \u0414\u0430\u0432\u0456\u0434\u0430 \u0434\u0437\u0456\u0434\u0430\u044e \u0434\u0430 \u0441\u0446\u044f\u043d\u044b, \u0430\u043b\u0435 \u0451\u043d \u0443\u0445\u0456\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u0421\u0430\u045e\u043b\u0430, \u0442\u0430\u043c\u0443 \u0434\u0437\u0456\u0434\u0430 \u045e\u0434\u0430\u0440\u044b\u043b\u0430 \u045e \u0441\u0446\u044f\u043d\u0443. \u0414\u0430\u0432\u0456\u0434 \u0443 \u0442\u0443\u044e \u0436 \u043d\u043e\u0447 \u0443\u0446\u0451\u043a, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0443\u0446\u0451\u043a \u0437 \u041d\u0430\u0451\u0442\u0430, \u0448\u0442\u043e \u043a\u0430\u043b\u044f \u0420\u0430\u043c\u0430, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d\u0430\u0442\u0430\u043d\u0443: &laquo;\u0428\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u044f? \u0423 \u0447\u044b\u043c \u043c\u0430\u044f \u0432\u0456\u043d\u0430, \u0447\u044b\u043c \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u044f \u043f\u0435\u0440\u0430\u0434 \u0442\u0432\u0430\u0456\u043c \u0431\u0430\u0446\u044c\u043a\u0430\u043c, \u0448\u0442\u043e \u0451\u043d \u0448\u0443\u043a\u0430\u0435 \u043c\u0430\u0451\u0439 \u0437\u0433\u0443\u0431\u044b?&raquo; \u0401\u043d\u0430\u0442\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u041d\u0435, \u0442\u044b \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u0448. \u0411\u0430\u0446\u044c\u043a\u0430 \u043c\u043e\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c, \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e\u0448\u044b \u043c\u043d\u0435. \u0414\u044b \u0456 \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0431\u0430\u0446\u044c\u043a\u0443 \u043c\u0430\u0439\u043c\u0443 \u045e\u0442\u043e\u0439\u0432\u0430\u0446\u044c \u0430\u0434 \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443? \u0413\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435&raquo;. \u0414\u0430\u0432\u0456\u0434 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0432\u043e\u0439 \u0431\u0430\u0446\u044c\u043a\u0430 \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u0442\u0432\u0430\u0456\u0445, \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0401\u043d\u0430\u0442\u0430\u043d, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e\u0441\u044f&rdquo;, \u0430\u043b\u0435 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u044e \u041f\u0430\u043d\u0430\u043c \u0456 \u0442\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0448\u0442\u043e \u0430\u0434\u0437\u0456\u043d \u043a\u0440\u043e\u043a \u043f\u0430\u043c\u0456\u0436 \u043c\u043d\u043e\u044e \u0456 \u0441\u043c\u0435\u0440\u0446\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d\u0430\u0442\u0430\u043d \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0428\u0442\u043e \u0431 \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0442\u044b, \u0437\u0440\u0430\u0431\u043b\u044e \u0442\u0430\u0431\u0435&raquo;. \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d\u0430\u0442\u0430\u043d\u0443: &laquo;\u0417\u0430\u045e\u0442\u0440\u0430 \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a, \u0456 \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u0437 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0437\u0430 \u0441\u0442\u0430\u043b\u043e\u043c. \u0414\u0430\u0437\u0432\u043e\u043b\u044c \u0436\u0430 \u043c\u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u043f\u043e\u043b\u0456 \u0430\u0436 \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u0432\u0435\u0447\u0430\u0440\u0430. \u041a\u0430\u043b\u0456 \u0431\u0430\u0446\u044c\u043a\u0430 \u0442\u0432\u043e\u0439 \u0441\u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u0441\u043a\u0430\u0436\u044b: &ldquo;\u0414\u0430\u0432\u0456\u0434 \u043f\u0440\u0430\u0441\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u044f\u0433\u043e, \u043a\u0430\u0431 \u043c\u043e\u0433 \u0451\u043d \u0441\u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u043e\u0439 \u0433\u043e\u0440\u0430\u0434 \u0411\u044d\u0442\u043b\u0435\u0435\u043c, \u0431\u043e \u0442\u0430\u043c \u0443\u0441\u044f \u0441\u044f\u043c&rsquo;\u044f \u044f\u0433\u043e\u043d\u0430\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0448\u0442\u043e\u0433\u0430\u0434\u043e\u0432\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443&rdquo;. \u041a\u0430\u043b\u0456 \u0430\u0434\u043a\u0430\u0436\u0430: &ldquo;\u0414\u043e\u0431\u0440\u0430&rdquo;, \u0442\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u0441\u043b\u0443\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443, \u0430 \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u0435\u0446\u0446\u0430, \u0442\u043e \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u0451\u043d \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043b\u0456\u0445\u043e\u0435. \u0422\u044b \u0436 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0448 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0441\u043b\u0443\u0433\u0456 \u0442\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u043f\u0440\u0430\u0437 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u041f\u0430\u043d\u0430 \u043c\u044b \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u044f \u0437 \u0442\u0430\u0431\u043e\u044e. \u041a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u0430\u044f \u0432\u0456\u043d\u0430 \u043d\u0430 \u043c\u043d\u0435, \u0442\u043e \u0441\u0430\u043c \u0437\u0430\u0431\u0456 \u043c\u044f\u043d\u0435. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u0430\u0431\u0435 \u0432\u0435\u0441\u0446\u0456 \u043c\u044f\u043d\u0435 \u0434\u0430 \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0432\u0430\u0439\u0433\u043e?&raquo; \u0401\u043d\u0430\u0442\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0431\u043e, \u043a\u0430\u043b\u0456 \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0441\u044f, \u0448\u0442\u043e \u0431\u0430\u0446\u044c\u043a\u0430 \u043c\u043e\u0439 \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043b\u0456\u0445\u043e\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043d\u044f\u045e\u0436\u043e \u044f \u043d\u0435 \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430?&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0401\u043d\u0430\u0442\u0430\u043d\u0443: &laquo;\u0425\u0442\u043e \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u044c \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u0431\u0430\u0446\u044c\u043a\u0430 \u0442\u0432\u043e\u0439 \u0430\u0434\u043a\u0430\u0436\u0430 \u0441\u0443\u0440\u043e\u0432\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d\u0430\u0442\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0425\u0430\u0434\u0437\u0456, \u0432\u044b\u0439\u0434\u0437\u0435\u043c \u0443 \u043f\u043e\u043b\u0435&raquo;. \u0406 \u0432\u044b\u0439\u0448\u043b\u0456 \u0430\u0431\u043e\u0434\u0432\u0430 \u045e \u043f\u043e\u043b\u0435. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d\u0430\u0442\u0430\u043d \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f! \u0417\u0430\u045e\u0442\u0440\u0430 \u045e \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u0430\u0431\u043e \u043f\u0430\u0441\u043b\u044f\u0437\u0430\u045e\u0442\u0440\u0430 \u044f \u0432\u044b\u043f\u044b\u0442\u0430\u044e \u045e \u0431\u0430\u0446\u044c\u043a\u0456 \u043c\u0430\u0439\u0433\u043e; \u043a\u0430\u043b\u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u044b\u043c \u0434\u0430 \u0446\u044f\u0431\u0435, \u0442\u0430\u0434\u044b \u044f \u043d\u0435 \u043f\u0430\u0448\u043b\u044e \u0434\u0430 \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0435\u043c. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0440\u0430\u0435 \u0401\u043d\u0430\u0442\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u043c\u0435\u0434\u0430\u043c\u043b\u044e \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0431\u0430\u0446\u044c\u043a\u0430 \u043c\u043e\u0439 \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043b\u0456\u0445\u043e\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435. \u0422\u0430\u0434\u044b \u0430\u0434\u043f\u0443\u0448\u0447\u0443 \u0446\u044f\u0431\u0435, \u0456 \u0442\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456, \u0430 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u044f\u043a \u0431\u044b\u045e \u0437 \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u043c\u0430\u0456\u043c. \u041f\u0430\u0441\u043b\u044f, \u043a\u0430\u043b\u0456 \u044f \u044f\u0448\u0447\u044d \u0431\u0443\u0434\u0443 \u0436\u044b\u0432\u044b, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439 \u0441\u0430 \u043c\u043d\u043e\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0430. \u0410 \u043a\u0430\u043b\u0456 \u044f \u043f\u0430\u043c\u0440\u0443, \u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0434\u043e\u043c \u043c\u043e\u0439 \u043d\u0430\u0432\u0435\u043a\u0456, \u043d\u0430\u0432\u0430\u0442 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u0437 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u0456 \u0437\u044f\u043c\u043b\u0456&raquo;. \u0422\u0430\u043a \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0401\u043d\u0430\u0442\u0430\u043d \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0434\u043e\u043c\u0430\u043c \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0430\u0434 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0430. \u0406 \u0437\u043d\u043e\u045e \u0401\u043d\u0430\u0442\u0430\u043d \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e \u0414\u0430\u0432\u0456\u0434\u0443 \u0441\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u044f\u0433\u043e, \u0431\u043e \u043b\u044e\u0431\u0456\u045e \u044f\u0433\u043e, \u044f\u043a \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 17, 17; 1 \u042f\u043d 4, 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u044f\u0431\u0440\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441, <span style=\"color: #ff0000;\">*<\/span> \u0430 \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"125","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">21, 2-10; 22, 1-5&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0446\u0451\u043a\u0456 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434 \u0443 \u041d\u043e\u0431 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0410\u0445\u0456\u043c\u044d\u043b\u0435\u0445\u0430. \u0410\u0445\u0456\u043c\u044d\u043b\u0435\u0445 \u0436\u0430 \u0432\u044b\u0439\u0448\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u0430\u0434\u0437\u0456\u043d, \u0456 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u044f\u043c\u0430 \u0437 \u0442\u0430\u0431\u043e\u044e?&raquo; \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0443 \u0410\u0445\u0456\u043c\u044d\u043b\u0435\u0445\u0443: &laquo;\u041a\u0430\u0440\u043e\u043b\u044c \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043c\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u0443, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0439 \u044f \u043f\u0430\u0441\u043b\u0430\u045e \u0446\u044f\u0431\u0435 \u0456 \u044f\u043a\u0443\u044e \u044f \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0442\u0430\u0431\u0435&rdquo;, \u0442\u0430\u043c\u0443 \u044f \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u044e\u043d\u0430\u043a\u0430\u043c \u0441\u0443\u0441\u0442\u0440\u044d\u0447\u0443 \u045e \u043f\u044d\u045e\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u0410 \u0446\u044f\u043f\u0435\u0440, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u0446\u044f\u0431\u0435 \u043f\u0430\u0434 \u0440\u0443\u043a\u043e\u044e, \u0434\u0430\u0439 \u043c\u043d\u0435, \u0445\u043b\u044f\u0431\u043e\u045e \u043f\u044f\u0446\u044c, \u0430\u043b\u044c\u0431\u043e \u0448\u0442\u043e \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430&raquo;. \u0421\u0432\u044f\u0442\u0430\u0440 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u041d\u044f\u043c\u0430 \u043f\u0440\u043e\u0441\u0442\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430 \u043f\u0430\u0434 \u0440\u0443\u043a\u043e\u044e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0430\u043b\u0435 \u0451\u0441\u0446\u044c \u0445\u043b\u0435\u0431 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b. \u0410\u0434\u043d\u0430\u043a \u0446\u0456 \u045e\u0441\u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u0442\u0432\u0430\u0435 \u0445\u043b\u043e\u043f\u0446\u044b \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0443: &laquo;\u0422\u0430\u043a, \u0431\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0437 \u043d\u0430\u043c\u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u043d\u0456 \u045e\u0447\u043e\u0440\u0430, \u043d\u0456 \u043f\u0430\u0437\u0430\u045e\u0447\u043e\u0440\u0430 \u0437 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a \u0432\u044b\u0439\u0448\u0430\u045e \u044f \u045e \u043f\u0430\u0445\u043e\u0434, \u0442\u0430\u043c\u0443 \u0445\u043b\u043e\u043f\u0446\u044b \u0447\u044b\u0441\u0442\u044b\u044f, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f \u0432\u044b\u043f\u0440\u0430\u0432\u0430. \u0422\u0430\u043c\u0443 \u0441\u0451\u043d\u043d\u044f \u044f\u043d\u044b \u0447\u044b\u0441\u0442\u044b\u044f&raquo;. \u0422\u0430\u0434\u044b \u0434\u0430\u045e \u044f\u043c\u0443 \u0441\u0432\u044f\u0442\u0430\u0440 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0445\u043b\u0435\u0431, \u0431\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u044f\u0433\u043e \u0456\u043d\u0448\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0437\u0430\u0431\u0440\u0430\u043d\u044b \u0437 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0437\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u044f\u0433\u043e \u0441\u0432\u0435\u0436\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0431\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0430\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0421\u0430\u045e\u043b\u0430 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0414\u043e\u044d\u0433 \u0437 \u042d\u0434\u043e\u043c\u0430, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u0434\u043b\u044f \u0421\u0430\u045e\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u0445\u0456\u043c\u044d\u043b\u0435\u0445\u0443: &laquo;\u0426\u0456 \u043d\u044f\u043c\u0430 \u0442\u0443\u0442 \u0443 \u0446\u044f\u0431\u0435 \u043f\u0430\u0434 \u0440\u0443\u043a\u043e\u044e \u0434\u0437\u0456\u0434\u044b \u0446\u0456 \u043c\u0435\u0447\u0430? \u0411\u043e \u0441\u043f\u0440\u0430\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0431\u044b\u043b\u0430 \u0442\u044d\u0440\u043c\u0456\u043d\u043e\u0432\u0430\u0439, \u0456 \u044f \u043d\u0435 \u043f\u0430\u0441\u043f\u0435\u045e \u0443\u0437\u044f\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u043d\u0456 \u043c\u044f\u0447\u0430, \u043d\u0456 \u0456\u043d\u0448\u0430\u0439 \u0437\u0431\u0440\u043e\u0456&raquo;. \u0421\u0432\u044f\u0442\u0430\u0440 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0401\u0441\u0446\u044c \u043c\u0435\u0447 \u0413\u0430\u043b\u0456\u044f\u0442\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0456\u043d\u0430, \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u0437\u0430\u0431\u0456\u045e \u0443 \u0434\u0430\u043b\u0456\u043d\u0435 \u0422\u044d\u0440\u044d\u0431\u0456\u043d\u0442\u0430. \u0401\u043d \u0437\u0430\u0433\u043e\u0440\u043d\u0443\u0442\u044b \u045e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0456 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u044d\u0444\u043e\u0434\u0430\u043c. \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448, \u0432\u0430\u0437\u044c\u043c\u0456 \u044f\u0433\u043e, \u0431\u043e \u0456\u043d\u0448\u0430\u0433\u0430 \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u044f\u043c\u0430&raquo;. \u0422\u0430\u0434\u044b \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430. \u0422\u0430\u043c\u0443 \u0434\u0430\u0439 \u043c\u043d\u0435 \u044f\u0433\u043e&raquo;. \u041f\u0430\u0441\u043b\u044f \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0442\u0430\u045e \u0456 \u045e\u0446\u0451\u043a \u0443 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434 \u0421\u0430\u045e\u043b\u0430, \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0410\u043a\u0456\u0448\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0413\u0430\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c \u0414\u0430\u0432\u0456\u0434 \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434\u0442\u0443\u043b\u044c \u0456 \u045e\u0446\u0451\u043a \u0443 \u043f\u044f\u0447\u043e\u0440\u0443 \u0410\u0434\u0443\u043b\u0430\u043c. \u041f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0431\u0440\u0430\u0442\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0431\u0430\u0446\u044c\u043a\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0442\u0443\u0434\u044b \u0434\u0430 \u044f\u0433\u043e. \u0421\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u045e\u0441\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u044f \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043c\u0435\u045e \u0434\u043e\u045e\u0433, \u0456 \u045e\u0441\u0435 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f. \u0406 \u0441\u0442\u0430\u045e\u0441\u044f \u0451\u043d \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0456\u0445\u043d\u0456\u043c, \u0430 \u0431\u044b\u043b\u043e \u0437 \u0456\u043c \u043a\u0430\u043b\u044f \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u0441\u043e\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0442\u0443\u043b\u044c \u043f\u0430\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434 \u0443 \u041c\u0456\u0441\u043f\u0430 \u045e \u041c\u0430\u0430\u0431\u0435 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e \u041c\u0430\u0430\u0431\u0430: &laquo;\u0414\u0430\u0437\u0432\u043e\u043b\u044c \u0431\u0430\u0446\u044c\u043a\u0443 \u043c\u0430\u0439\u043c\u0443 \u0456 \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u044f \u043d\u0435 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0441\u044f, \u0448\u0442\u043e \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e \u0411\u043e\u0433&raquo;. \u0406 \u043f\u0440\u044b\u0432\u0451\u045e \u0456\u0445 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u041c\u0430\u0430\u0431\u0430, \u0456 \u0436\u044b\u043b\u0456 \u044f\u043d\u044b \u045e \u044f\u0433\u043e \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u0431\u044b\u045e \u0443 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0440\u0430\u0440\u043e\u043a \u0413\u0430\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u041d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u045e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0432\u044f\u0440\u0442\u0430\u0439\u0441\u044f \u045e \u0437\u044f\u043c\u043b\u044e \u042e\u0434\u044b&raquo;. \u0422\u0430\u043c\u0443 \u043f\u0430\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434 \u0456 \u0441\u0445\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u043b\u0435\u0441\u0435 \u0425\u0435\u0440\u044d\u0442.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 7, 6; \u041c\u043a 2, 25. 26<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u0434\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443, \u044f\u043a\u0456\u043c \u0431\u044b\u043b\u0456 \u0437\u0432\u044f\u0437\u0430\u043d\u044b, \u043c\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u044f\u0433\u043e, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443 \u043d\u043e\u0432\u044b\u043c \u0434\u0443\u0445\u0443, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0442\u0430\u0440\u043e\u0439 \u043b\u0456\u0442\u0430\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0447\u044b\u0442\u0430\u043b\u0456, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0414\u0430\u0432\u0456\u0434, \u043a\u0430\u043b\u0456 \u0437\u0433\u0430\u043b\u0430\u0434\u0430\u045e\u0441\u044f? \u042f\u043a \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0434\u043e\u043c \u0411\u043e\u0436\u044b \u0456 \u0435\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u044f \u0445\u043b\u044f\u0431\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443 \u043d\u043e\u0432\u044b\u043c \u0434\u0443\u0445\u0443, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0442\u0430\u0440\u043e\u0439 \u043b\u0456\u0442\u0430\u0440\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"126","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">25, 14-24. 28-39&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u0456 \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0410\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u041d\u0430\u0431\u0430\u043b\u044f \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u045e \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c, \u0436\u043e\u043d\u0446\u044b \u041d\u0430\u0431\u0430\u043b\u044f: &laquo;\u0414\u0430\u0432\u0456\u0434 \u043f\u0440\u044b\u0441\u044b\u043b\u0430\u045e \u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u0430\u043b\u0435 \u0451\u043d \u0434\u0440\u044d\u043d\u043d\u0430 \u0430\u0431\u044b\u0448\u043e\u045e\u0441\u044f \u0437 \u0456\u043c\u0456. \u0410 \u043b\u044e\u0434\u0437\u0456 \u0433\u044d\u0442\u044b\u044f \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u043e\u0431\u0440\u044b\u044f \u0434\u0430 \u043d\u0430\u0441, \u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u043b\u0456 \u043d\u0430\u0441, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u043b\u0430 \u045e \u043d\u0430\u0441 \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c\u0456 \u045e \u043f\u043e\u043b\u0456. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u044e \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u0441\u0442\u0430\u0442\u0430\u043a \u043f\u0430\u0431\u043b\u0456\u0437\u0443 \u0456\u0445. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0437\u0432\u0430\u0436, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u0446\u044c, \u0431\u043e \u0431\u044f\u0434\u0430 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0456 \u045e\u0441\u044f\u043c\u0443 \u0434\u043e\u043c\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443. \u0401\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b, \u043a\u0430\u0431 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0456\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c \u043f\u0430\u0441\u043f\u0435\u0448\u043b\u0456\u0432\u0430 \u045e\u0437\u044f\u043b\u0430 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u0445\u043b\u044f\u0431\u043e\u045e \u0456 \u0434\u0432\u0430 \u043c\u044f\u0445\u0456 \u0437 \u0432\u0456\u043d\u043e\u043c, \u043f\u044f\u0446\u044c \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u043f\u044f\u0446\u044c \u043c\u0435\u0440\u0430\u045e \u043f\u0440\u0430\u0436\u0430\u043d\u0430\u0433\u0430 \u0437\u0435\u0440\u043d\u044f, \u0441\u0442\u043e \u0432\u044f\u0437\u0430\u043d\u0430\u043a \u0440\u0430\u0437\u044b\u043d\u0430\u043a \u0456 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u043f\u043b\u044f\u0446\u043a\u0430\u045e \u0441\u0430 \u0441\u043c\u043e\u043a\u0432\u044b \u0456 \u043f\u0430\u043a\u043b\u0430\u043b\u0430 \u043d\u0430 \u0430\u0441\u043b\u043e\u045e. \u0421\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435 \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435, \u0430 \u044f \u043f\u0430\u0439\u0434\u0443 \u0437\u0430 \u0432\u0430\u043c\u0456&raquo;. \u0410\u0434\u043d\u0430\u043a \u043c\u0443\u0436\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u041d\u0430\u0431\u0430\u043b\u044e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0430. \u041a\u0430\u043b\u0456 \u0436 \u044f\u043d\u0430, \u0441\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0430\u0441\u043b\u0435, \u0441\u043f\u0443\u0441\u043a\u0430\u043b\u0430\u0441\u044f \u043f\u0430 \u0441\u0445\u0456\u043b\u0435, \u044f\u043a\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0430 \u0433\u0430\u0440\u0430, \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0451\u0439 \u0441\u043f\u0443\u0441\u043a\u0430\u045e\u0441\u044f \u0414\u0430\u0432\u0456\u0434 \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456. \u0422\u0430\u043a \u044f\u043d\u0430 \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0430\u0441\u044f \u0437 \u0456\u043c\u0456. \u0414\u0430\u0432\u0456\u0434 \u0434\u0443\u043c\u0430\u045e \u043f\u0440\u0430 \u0441\u044f\u0431\u0435: &laquo;\u0422\u0430\u043a, \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u044f \u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0433\u044d\u0442\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u043d\u0456\u0447\u043e\u0433\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u043b\u0430, \u0430 \u0451\u043d \u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043c\u043d\u0435 \u0437\u043b\u043e\u043c \u0437\u0430 \u0434\u0430\u0431\u0440\u043e. \u041d\u044f\u0445\u0430\u0439 \u0442\u0430\u043a \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0411\u043e\u0433 \u0437 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u044f\u0448\u0447\u044d \u0434\u0430\u0434\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0434\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u044f \u0437 \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u041d\u0430\u0431\u0430\u043b\u044e, \u044f \u043f\u0430\u043a\u0456\u043d\u0443 \u0445\u043e\u0446\u044c \u0431\u044b \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u0443\u0436\u0447\u044b\u043d\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c \u0443\u0431\u0430\u0447\u044b\u043b\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u0445\u0443\u0442\u043a\u0430 \u0441\u044b\u0448\u043b\u0430 \u0437 \u0430\u0441\u043b\u0430 \u0456 \u045e\u043f\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0414\u0430\u0432\u0456\u0434\u0430\u043c \u043d\u0430 \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439, \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u0434\u0430 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u0430 \u045e\u043f\u0430\u043b\u0430 \u0434\u0430 \u043d\u043e\u0433 \u044f\u0433\u043e\u043d\u044b\u0445 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041d\u0430 \u043c\u043d\u0435, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u0432\u0456\u043d\u0430. \u0414\u0430\u0437\u0432\u043e\u043b\u044c \u0441\u043b\u0443\u0437\u0435 \u0442\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u043b\u043e\u0432\u044b \u0441\u043b\u0443\u0433\u0456 \u0442\u0432\u0430\u0451\u0439. \u0414\u0430\u0440\u0443\u0439, \u043f\u0440\u0430\u0448\u0443, \u0432\u0456\u043d\u0443 \u0441\u043b\u0443\u0433\u0456 \u0442\u0432\u0430\u0451\u0439, \u0431\u043e \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u043e\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c, \u0431\u043e \u0432\u043e\u0439\u043d\u044b \u041f\u0430\u043d\u0430 \u0432\u044f\u0434\u0437\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043c\u043e\u0439, \u0456 \u043d\u044f\u043c\u0430 \u0437\u043b\u0430 \u045e \u0442\u0430\u0431\u0435 \u0437 \u043f\u0435\u0440\u0448\u044b\u0445 \u0434\u0437\u0451\u043d \u0442\u0432\u0430\u0456\u0445. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0437\u0430\u0431\u0456\u0446\u044c, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451 \u044f\u043a \u0441\u0432\u0430\u044e \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0443\u044e \u0440\u044d\u0447, \u0430 \u0436\u044b\u0446\u0446\u0451 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445 \u043d\u044f\u0445\u0430\u0439 \u043a\u0456\u043d\u0435 \u044f\u043a \u0437 \u043f\u0440\u0430\u0448\u0447\u044b. \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u0430\u0439\u043c\u0443 \u045e\u0441\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u045e, \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0436\u0430\u043b\u044e \u0456 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u044e \u0441\u044d\u0440\u0446\u0430 \u0434\u043b\u044f \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u0430\u043b\u0456\u045e \u043d\u044f\u0432\u0456\u043d\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u0456 \u0441\u0430\u043c \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e \u0437\u0430 \u0441\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u0430\u0439\u043c\u0443, \u0437\u0433\u0430\u0434\u0430\u0439 \u0442\u0430\u0434\u044b \u043f\u0440\u0430 \u0441\u043b\u0443\u0433\u0443 \u0442\u0432\u0430\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0446\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u043c\u043d\u0435. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u043e\u0437\u0443\u043c \u0442\u0432\u043e\u0439 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0442\u044b \u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043b\u0430 \u043c\u043d\u0435 \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u043a\u0440\u043e\u045e \u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0437\u0430 \u0441\u044f\u0431\u0435. \u0410\u043b\u0435, \u043d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u0441\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u043f\u0440\u044b\u0447\u044b\u043d\u0435\u043d\u043d\u044f \u0442\u0430\u0431\u0435 \u0437\u043b\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u043d\u0435 \u043f\u0430\u0441\u043f\u044f\u0448\u0430\u043b\u0430\u0441\u044f \u0456 \u043d\u0435 \u0432\u044b\u0439\u0448\u043b\u0430 \u043c\u043d\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447, \u0442\u043e \u0434\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u044f \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u0431 \u0443 \u041d\u0430\u0431\u0430\u043b\u044f \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u044b&raquo;. \u041f\u0440\u044b\u043d\u044f\u045e \u0414\u0430\u0432\u0456\u0434 \u0437 \u044f\u0435 \u0440\u0443\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u044f\u043c\u0443, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u0406\u0434\u0437\u0456 \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e. \u0411\u0430\u0447\u044b\u0448, \u044f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u0446\u044f\u0431\u0435 \u0456 \u043f\u0440\u044b\u043d\u044f\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u041d\u0430\u0431\u0430\u043b\u044f, \u0431\u044b\u043b\u0430 \u045e \u0434\u043e\u043c\u0435 \u044f\u0433\u043e\u043d\u044b\u043c \u0433\u0430\u0441\u0446\u0456\u043d\u0430, \u044f\u043a \u0443 \u043a\u0430\u0440\u0430\u043b\u044f. \u041d\u0430\u0431\u0430\u043b\u044c \u0431\u044b\u045e \u0432\u044f\u0441\u0451\u043b\u044b \u0456 \u043c\u043e\u0446\u043d\u0430 \u043f&rsquo;\u044f\u043d\u044b, \u0442\u0430\u043c\u0443 \u044f\u043d\u0430 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443 \u043d\u0456 \u0441\u043b\u043e\u0432\u0430 \u0430\u0436 \u0434\u0430 \u0440\u0430\u043d\u0456\u0446\u044b. \u0410 \u0440\u0430\u043d\u0456\u0446\u0430\u0439, \u043a\u0430\u043b\u0456 \u041d\u0430\u0431\u0430\u043b\u044c \u043f\u0440\u0430\u0446\u0432\u0435\u0440\u0430\u0437\u0435\u045e, \u0436\u043e\u043d\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e. \u0422\u0430\u0434\u044b \u0437\u0430\u043c\u0435\u0440\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0456 \u0441\u0442\u0430\u045e \u0451\u043d, \u044f\u043a \u043a\u0430\u043c\u0435\u043d\u044c. \u041a\u0430\u043b\u0456 \u043c\u0456\u043d\u0443\u043b\u0430 \u043a\u0430\u043b\u044f \u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0434\u0437\u0451\u043d, \u041f\u0430\u043d \u0443\u0434\u0430\u0440\u044b\u045e \u041d\u0430\u0431\u0430\u043b\u044f, \u0456 \u0451\u043d \u043f\u0430\u043c\u0451\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434, \u043f\u0430\u0447\u0443\u045e\u0448\u044b, \u0448\u0442\u043e \u041d\u0430\u0431\u0430\u043b\u044c \u043f\u0430\u043c\u0451\u0440, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u044f\u043a\u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e \u041d\u0430\u0431\u0430\u043b\u044e \u0437\u0430 \u043c\u0430\u044e \u0437\u043d\u044f\u0432\u0430\u0433\u0443 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434 \u043b\u0456\u0445\u0430, \u0430 \u0437\u043b\u043e \u041d\u0430\u0431\u0430\u043b\u044f \u0430\u0431\u044f\u0440\u043d\u0443\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e&raquo;. \u0406 \u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c, \u0448\u0442\u043e \u0451\u043d \u0431\u044f\u0440\u044d \u044f\u0435 \u0441\u0430\u0431\u0435 \u0437\u0430 \u0436\u043e\u043d\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0421\u0430\u043c 25, 32\u0430. 33b; \u041c\u0446 5, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0446\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u043c\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043b\u0430 \u043c\u043d\u0435 \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u043a\u0440\u043e\u045e \u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0437\u0430 \u0441\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043b\u0430 \u043c\u043d\u0435 \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u043a\u0440\u043e\u045e \u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0437\u0430 \u0441\u044f\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"127","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f<span style=\"color: #ff0000;\">&nbsp;26, 5-25&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0421\u0430\u045e\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u043c\u0435\u0441\u0446\u0430, \u043d\u0430 \u044f\u043a\u0456\u043c \u0440\u0430\u0437\u043c\u044f\u0448\u0447\u0430\u045e\u0441\u044f \u043b\u0430\u0433\u0435\u0440 \u0421\u0430\u045e\u043b\u0430. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u0414\u0430\u0432\u0456\u0434 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u0441\u043f\u0430\u045e \u0421\u0430\u045e\u043b \u0456 \u0410\u0431\u043d\u044d\u0440, \u0441\u044b\u043d \u041d\u044d\u0440\u0430, \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a \u044f\u0433\u043e\u043d\u044b. \u0421\u0430\u045e\u043b \u0441\u043f\u0430\u045e \u0443 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u043b\u0430\u0433\u0435\u0440\u0430, \u0430 \u043d\u0430\u0440\u043e\u0434 \u0440\u0430\u0437\u043c\u044f\u0441\u0446\u0456\u045e\u0441\u044f \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e. \u0414\u0430\u0432\u0456\u0434 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0410\u0445\u0456\u043c\u044d\u043b\u0435\u0445\u0430 \u0425\u0435\u0442\u044b\u0442\u044b \u0456 \u0434\u0430 \u0410\u0431\u0456\u0441\u0430\u044f, \u0441\u044b\u043d\u0430 \u0421\u0430\u0440\u0443\u044f, \u0431\u0440\u0430\u0442\u0430 \u0401\u0430\u0431\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u043f\u043e\u0439\u0434\u0437\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e \u0434\u0430 \u0421\u0430\u045e\u043b\u0430 \u045e \u043b\u0430\u0433\u0435\u0440?&raquo; \u0410\u0431\u0456\u0441\u0430\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043f\u0430\u0439\u0434\u0443 \u0437 \u0442\u0430\u0431\u043e\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c \u0447\u0430\u0441\u0430\u043c \u0443\u043d\u0430\u0447\u044b \u0414\u0430\u0432\u0456\u0434 \u0456 \u0410\u0431\u0456\u0441\u0430\u0439 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0421\u0430\u045e\u043b\u0430, \u044f\u043a\u0456 \u043b\u044f\u0436\u0430\u045e \u0456 \u0441\u043f\u0430\u045e \u0443 \u043b\u0430\u0433\u0435\u0440\u044b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u043c\u0451\u0442\u0430\u045e. \u042f\u0433\u043e \u0434\u0437\u0456\u0434\u0430 \u0431\u044b\u043b\u0430 \u045e\u0442\u043e\u0440\u043a\u043d\u0443\u0442\u0430\u044f \u045e \u0437\u044f\u043c\u043b\u044e \u043a\u0430\u043b\u044f \u0433\u0430\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439, \u0430 \u0410\u0431\u043d\u044d\u0440 \u0456 \u043b\u044e\u0434\u0437\u0456 \u0441\u043f\u0430\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e. \u0410\u0431\u0456\u0441\u0430\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0421\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u045e \u0432\u043e\u0440\u0430\u0433\u0430 \u045e \u0442\u0432\u0430\u0435 \u0440\u0443\u043a\u0456, \u0442\u0430\u043c\u0443 \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u043c\u043d\u0435 \u0430\u0434\u043d\u044b\u043c \u0443\u0434\u0430\u0440\u0430\u043c \u043f\u0440\u044b\u0431\u0456\u0446\u044c \u044f\u0433\u043e \u0434\u0437\u0456\u0434\u0430\u0439 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u045e\u0436\u043e \u043d\u0435 \u0441\u043f\u0430\u0442\u0440\u044d\u0431\u0456\u0446\u0446\u0430&raquo;. \u0410\u043b\u0435 \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u0431\u0456\u0441\u0430\u044e: &laquo;\u041d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0439 \u044f\u0433\u043e, \u0431\u043e \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u0435\u0441\u043f\u0430\u043a\u0430\u0440\u0430\u043d\u0430 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0440\u0443\u043a\u0443 \u043d\u0430 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430?&raquo; \u0406 \u0434\u0430\u0434\u0430\u045e \u0414\u0430\u0432\u0456\u0434: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430! \u0421\u0430\u043c \u041f\u0430\u043d \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u044f\u0433\u043e: \u0430\u0431\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0437\u0435\u043d\u044c \u044f\u0433\u043e\u043d\u044b, \u0456 \u0451\u043d \u043f\u0430\u043c\u0440\u044d, \u0430\u0431\u043e \u043f\u043e\u0439\u0434\u0437\u0435 \u043d\u0430 \u0432\u0430\u0439\u043d\u0443 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043c\u043d\u0435 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0440\u0443\u043a\u0443 \u043c\u0430\u044e \u043d\u0430 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430. \u041f\u0440\u0430\u0448\u0443, \u0432\u0430\u0437\u044c\u043c\u0456 \u0446\u044f\u043f\u0435\u0440 \u0434\u0437\u0456\u0434\u0443, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043a\u0430\u043b\u044f \u044f\u0433\u043e\u043d\u0430\u0439 \u0433\u0430\u043b\u0430\u0432\u044b, \u0456 \u0437\u0431\u0430\u043d \u0437 \u0432\u0430\u0434\u043e\u044e, \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u043d\u0430\u0437\u0430\u0434&raquo;. \u0422\u0430\u0434\u044b \u0414\u0430\u0432\u0456\u0434 \u0443\u0437\u044f\u045e \u0434\u0437\u0456\u0434\u0443 \u0456 \u0437\u0431\u0430\u043d \u0437 \u0432\u0430\u0434\u043e\u044e, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043a\u0430\u043b\u044f \u0433\u0430\u043b\u0430\u0432\u044b \u0421\u0430\u045e\u043b\u0430, \u0456 \u044f\u043d\u044b \u0430\u0434\u044b\u0448\u043b\u0456. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e, \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e \u0456 \u043d\u0435 \u043f\u0440\u0430\u0447\u043d\u0443\u045e\u0441\u044f, \u0430\u043b\u0435 \u045e\u0441\u0435 \u0441\u043f\u0430\u043b\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u043d \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0456\u0445 \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0441\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0414\u0430\u0432\u0456\u0434 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0431\u043e\u043a \u0456 \u0441\u0442\u0430\u045e \u043d\u0430 \u0432\u0435\u0440\u0441\u0435 \u0433\u0430\u0440\u044b, \u0442\u0430\u043a \u0448\u0442\u043e \u043f\u0430\u043c\u0456\u0436 \u0456\u043c \u0431\u044b\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u044c. \u0406 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0410\u0431\u043d\u044d\u0440\u0430, \u0441\u044b\u043d\u0430 \u041d\u044d\u0440\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u0431\u043d\u044d\u0440, \u0447\u0430\u043c\u0443 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435\u0448?&raquo; \u0422\u0430\u0434\u044b \u0410\u0431\u043d\u044d\u0440 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u0442\u044b, \u0448\u0442\u043e \u0442\u0443\u0440\u0431\u0443\u0435\u0448 \u043a\u0430\u0440\u0430\u043b\u044f?&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0410\u0431\u043d\u044d\u0440\u0443: &laquo;\u0426\u0456 \u043d\u0435 \u0442\u043e\u0439 \u0442\u044b \u043c\u0443\u0436\u0447\u044b\u043d\u0430, \u044f\u043a\u043e\u043c\u0443 \u043d\u044f\u043c\u0430 \u0440\u043e\u045e\u043d\u0430\u0433\u0430 \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456? \u0427\u0430\u043c\u0443 \u0436 \u0442\u044b \u043d\u0435 \u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0448 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f? \u0411\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0437\u0430\u0431\u0456\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044f, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430! \u041d\u044f\u0434\u043e\u0431\u0440\u0430 \u0442\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u0448 \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a. \u0412\u044b \u0432\u0430\u0440\u0442\u044b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430. \u0426\u044f\u043f\u0435\u0440 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0434\u0437\u0435 \u0434\u0437\u0456\u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u0437\u0431\u0430\u043d \u0437 \u0432\u0430\u0434\u043e\u044e, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u043a\u0430\u043b\u044f \u0433\u0430\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u045e \u0421\u0430\u045e\u043b \u0433\u043e\u043b\u0430\u0441 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u0456 \u0433\u044d\u0442\u0430 \u0442\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439 \u0414\u0430\u0432\u0456\u0434\u0437\u0435?&raquo; \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u043a\u0430\u0440\u043e\u043b\u044c, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439&raquo;. \u0406 \u0434\u0430\u0434\u0430\u045e: &laquo;\u0417\u0430 \u0448\u0442\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043c\u043e\u0439 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e? \u0428\u0442\u043e \u044f \u0437\u0440\u0430\u0431\u0456\u045e? \u042f\u043a\u043e\u0435 \u043b\u0456\u0445\u0430 \u045e \u0440\u0443\u0446\u044d \u043c\u0430\u0451\u0439? \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0448\u0443, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043c\u044f\u043d\u0435, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c, \u0441\u043b\u043e\u0432\u044b \u0441\u043b\u0443\u0433\u0456 \u0441\u0432\u0430\u0439\u0433\u043e. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u041f\u0430\u043d \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0446\u044f\u0431\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0443\u0437\u043d\u044f\u0441\u0435\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u0430 \u043a\u0430\u043b\u0456 \u0441\u044b\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b\u044f \u044f\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0432\u044b\u0433\u0430\u043d\u044f\u044e\u0446\u044c \u043c\u044f\u043d\u0435 \u0441\u0451\u043d\u043d\u044f, \u043a\u0430\u0431 \u044f \u043d\u0435 \u043c\u0435\u045e \u0443\u0434\u0437\u0435\u043b\u0443 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u041f\u0430\u043d\u0430, \u0456 \u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u0406\u0434\u0437\u0456, \u0441\u043b\u0443\u0436\u044b \u0447\u0443\u0436\u044b\u043c \u0431\u0430\u0433\u0430\u043c&rdquo;. \u0425\u0430\u0439 \u0436\u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u043f\u0440\u0430\u043b\u044c\u0435\u0446\u0446\u0430 \u043a\u0440\u043e\u045e \u043c\u0430\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u041f\u0430\u043d\u0430, \u0431\u043e \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0448\u0443\u043a\u0430\u0446\u044c \u0430\u0434\u043d\u0443 \u0431\u043b\u044b\u0445\u0443, \u0432\u044b\u0439\u0448\u0430\u045e \u0433\u0430\u043d\u044f\u0446\u0446\u0430 \u0437\u0430 \u043a\u0443\u0440\u0430\u043f\u0430\u0442\u043a\u0430\u044e \u043f\u0430 \u0433\u0430\u0440\u0430\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u045e\u043b \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u0433\u0440\u0430\u0448\u044b\u045e \u044f, \u0432\u044f\u0440\u043d\u0456\u0441\u044f, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439 \u0414\u0430\u0432\u0456\u0434\u0437\u0435, \u0431\u043e \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u0447\u044b\u043d\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u0437\u043b\u0430, \u0431\u043e \u0441\u0451\u043d\u043d\u044f \u0442\u044b \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451. \u042f \u0431\u044b\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0456 \u0448\u043c\u0430\u0442 \u0437\u0440\u0430\u0431\u0456\u045e \u043f\u0430\u043c\u044b\u043b\u0430\u043a&raquo;. \u0414\u0430\u0432\u0456\u0434 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e \u0421\u0430\u045e\u043b\u0443: &laquo;\u0412\u043e\u0441\u044c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u044f \u0434\u0437\u0456\u0434\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u0432\u043e\u0437\u044c\u043c\u0435 \u044f\u0435. \u0410 \u041f\u0430\u043d \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u044f\u0433\u043e\u043d\u0430\u0439. \u0411\u043e \u0441\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u045e \u0446\u044f\u0431\u0435 \u045e \u043c\u0430\u0435 \u0440\u0443\u043a\u0456, \u0430 \u044f \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043d\u0430 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430. \u042f\u043a\u0456\u043c \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0441\u0451\u043d\u043d\u044f \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451 \u045e \u043c\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445, \u0442\u0430\u043a\u0456\u043c \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430, \u043d\u044f\u0445\u0430\u0439 \u0401\u043d \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0421\u0430\u045e\u043b \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0442\u044b, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439 \u0414\u0430\u0432\u0456\u0434\u0437\u0435. \u0422\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u0448 \u0440\u0430\u0431\u0456\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430, \u0442\u044b \u045e\u0441\u0451 \u0437\u043c\u043e\u0436\u0430\u0448&raquo;. \u0406 \u043f\u0430\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u044e, \u0430 \u0421\u0430\u045e\u043b \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 54 (53), 5\u0430b. 3. 8a. 4a<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> C\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u044b, \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u044f \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f; \u0443\u0440\u0430\u0442\u0443\u0439 \u043c\u044f\u043d\u0435, \u0411\u043e\u0436\u0430, \u0441\u0432\u0430\u0456\u043c \u0456\u043c\u0435\u043c <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0441\u0443\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0451\u044e \u043c\u043e\u0446\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443; \u0411\u043e\u0436\u0430, \u043f\u0430\u0447\u0443\u0439 \u043c\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u0443\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0451\u044e \u043c\u043e\u0446\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"131","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">28, 3-25<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0430\u045e\u043b \u0443 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043a\u0456 \u045e \u042d\u043d-\u0414\u043e\u0440\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043c\u0451\u0440 \u0421\u0430\u043c\u0443\u044d\u043b\u044c, \u0456 \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u045e\u0441\u0435 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435. \u041f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u045e \u0420\u0430\u043c\u0435, \u0443 \u044f\u0433\u043e\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0430 \u0421\u0430\u045e\u043b \u043f\u0440\u0430\u0433\u043d\u0430\u045e \u0447\u0430\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043e\u045e \u0437 \u043a\u0440\u0430\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u0428\u0443\u043d\u0430\u043c, \u043a\u0430\u0431 \u0442\u0430\u043c \u0440\u0430\u0437\u0431\u0456\u0446\u044c \u043b\u0430\u0433\u0435\u0440. \u0421\u0430\u045e\u043b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0430\u0431\u0440\u0430\u045e \u0443\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u043b\u0430\u0433\u0435\u0440 \u0443 \u0413\u0456\u043b\u044c\u0431\u043e\u0430. \u041a\u0430\u043b\u0456 \u0421\u0430\u045e\u043b \u0443\u0431\u0430\u0447\u044b\u045e \u043b\u0430\u0433\u0435\u0440 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e, \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u0456 \u043c\u043e\u0446\u043d\u0430 \u045e\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u044d\u0440\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0435. \u0421\u0430\u045e\u043b \u043f\u044b\u0442\u0430\u045e\u0441\u044f \u0443 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u041f\u0430\u043d \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u044f\u043c\u0443 \u043d\u0456 \u045e \u0441\u043d\u0435, \u043d\u0456 \u043f\u0440\u0430\u0437 \u0443\u0440\u044b\u043c, \u043d\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0421\u0430\u045e\u043b \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c: &laquo;\u0417\u043d\u0430\u0439\u0434\u0437\u0456\u0446\u0435 \u043c\u043d\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u044f\u043a\u0430\u044f \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0434\u0443\u0445\u0430\u045e, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u043f\u0430\u0439\u0441\u0446\u0456 \u0456 \u0441\u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u045e \u044f\u0435&raquo;. \u0421\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043c\u0443: &laquo;\u0422\u0443\u0442 \u0443 \u042d\u043d-\u0414\u043e\u0440\u044b \u0451\u0441\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0434\u0443\u0445\u0430\u045e&raquo;. \u0421\u0430\u045e\u043b \u0437\u043d\u044f\u045e \u0437 \u0441\u044f\u0431\u0435 \u0441\u0432\u0430\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0456 \u0430\u0434\u0437\u0435\u045e \u0456\u043d\u0448\u0443\u044e, \u0434\u044b \u043f\u0430\u0439\u0448\u043e\u045e \u0443\u043d\u0430\u0447\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0432\u0443\u043c\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u0430\u043c\u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u044b. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u041f\u0440\u0430\u0448\u0443, \u043f\u0430\u0432\u0430\u0440\u0430\u0436\u044b \u043c\u043d\u0435 \u0456 \u0432\u044b\u043a\u043b\u0456\u0447\u044b \u043c\u043d\u0435 \u0442\u0430\u0433\u043e, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u044f \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435&raquo;. \u0410\u043b\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0421\u0430\u045e\u043b: \u0451\u043d \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0443 \u043a\u0440\u0430\u0456\u043d\u0435 \u0447\u0430\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043e\u045e; \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u0442\u044b \u0441\u0442\u0430\u0432\u0456\u0448 \u043f\u0430\u0441\u0442\u043a\u0443 \u043d\u0430 \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u0437\u0430\u0431\u0456\u0446\u044c \u043c\u044f\u043d\u0435?&raquo; \u0421\u0430\u045e\u043b \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e \u0451\u0439 \u041f\u0430\u043d\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430! \u0422\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u0430\u044f \u0437\u0430 \u0433\u044d\u0442\u0430&raquo;. \u0422\u0430\u0434\u044b \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0441\u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044f: &laquo;\u041a\u0430\u0433\u043e \u0436 \u0442\u0430\u0431\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0446\u044c?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u044b\u043a\u043b\u0456\u0447\u044b \u043c\u043d\u0435 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f, \u043c\u043e\u0446\u043d\u0430 \u045e\u0441\u043a\u0440\u044b\u043a\u043d\u0443\u043b\u0430 \u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u0421\u0430\u045e\u043b\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u044b \u0430\u0448\u0443\u043a\u0430\u045e \u043c\u044f\u043d\u0435? \u0422\u044b \u0436 &ndash; \u0421\u0430\u045e\u043b!&raquo; \u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0441\u044f. \u0428\u0442\u043e \u0442\u044b \u0431\u0430\u0447\u044b\u0448?&raquo; \u0416\u0430\u043d\u0447\u044b\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0411\u0430\u0447\u0443, \u044f\u043a \u043d\u0435\u0439\u043a\u0430\u044f \u0437\u0434\u0430\u043d\u044c \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0437\u044f\u043c\u043b\u0456&raquo;. \u0421\u0430\u045e\u043b \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u044f\u0435: &laquo;\u042f\u043a\u0456 \u0451\u043d \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443?&raquo; \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0412\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0435\u0439\u043a\u0456 \u0441\u0442\u0430\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u043f\u043b\u0430\u0448\u0447&raquo;. \u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u045e \u0421\u0430\u045e\u043b, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044c, \u0456 \u045e\u043f\u0430\u045e \u0442\u0432\u0430\u0440\u0430\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u045e\u043b\u0443: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u044b \u0442\u0440\u044b\u0432\u043e\u0436\u044b\u0448 \u043c\u044f\u043d\u0435 \u0456 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435\u0448?&raquo; \u0421\u0430\u045e\u043b \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0443\u0446\u0456\u0441\u043a\u0443. \u0424\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0432\u0430\u044e\u044e\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e, \u0430 \u0411\u043e\u0433 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u0430\u0434 \u043c\u044f\u043d\u0435 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043c\u043d\u0435 \u043d\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u043d\u0456 \u043f\u0440\u0430\u0437 \u0441\u043d\u044b, \u0442\u0430\u043c\u0443 \u044f \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u045e \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043c\u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c&raquo;. \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u044b\u0442\u0430\u0435\u0448\u0441\u044f \u045e \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c \u041f\u0430\u043d \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u0430\u0434 \u0446\u044f\u0431\u0435 \u0456 \u0441\u0442\u0430\u045e \u0442\u0432\u0430\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c? \u041f\u0430\u043d \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435: \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e \u0437 \u0442\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0456 \u0430\u0434\u0434\u0430\u045e \u044f\u0433\u043e \u0456\u043d\u0448\u0430\u043c\u0443, \u0414\u0430\u0432\u0456\u0434\u0443. \u0411\u043e \u0442\u044b \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u042f\u0433\u043e \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0410\u043c\u0430\u043b\u0435\u043a\u0430. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0433\u044d\u0442\u0430 \u0437 \u0442\u0430\u0431\u043e\u044e \u0441\u0451\u043d\u043d\u044f. \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u0430\u0431\u043e\u044e \u045e \u0440\u0443\u043a\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e, \u0430 \u0437\u0430\u045e\u0442\u0440\u0430 \u0442\u044b \u0456 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e. \u041b\u0430\u0433\u0435\u0440 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u041f\u0430\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0443 \u0440\u0443\u043a\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u045e\u043b \u0440\u0430\u043f\u0442\u0430\u043c \u0443\u043f\u0430\u045e \u0443\u0441\u0456\u043c \u0446\u0435\u043b\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0431\u043e \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u0441\u043b\u043e\u0432\u0430\u045e \u0421\u0430\u043c\u0443\u044d\u043b\u044f. \u0406 \u043d\u0435 \u043c\u0435\u045e \u0451\u043d \u0441\u0456\u043b\u044b, \u0431\u043e \u043d\u0435 \u0435\u045e \u0445\u043b\u0435\u0431\u0430 \u045e\u0432\u0435\u0441\u044c \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0456 \u0446\u044d\u043b\u0443\u044e \u043d\u043e\u0447. \u0416\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0430\u0434\u044b\u0448\u043b\u0430 \u0434\u0430 \u0421\u0430\u045e\u043b\u0430 \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u0451\u043d \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u0412\u043e\u0441\u044c, \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u0430\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0430\u0441\u044f \u0446\u044f\u0431\u0435, \u0437\u0430\u0440\u044b\u0437\u044b\u043a\u0430\u0432\u0430\u043b\u0430 \u0436\u044b\u0446\u0446\u0451\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0430 \u0437\u0430\u0433\u0430\u0434, \u044f\u043a\u0456 \u0442\u044b \u0434\u0430\u045e \u043c\u043d\u0435. \u0426\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0448\u0443, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0456 \u0442\u044b \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u044e. \u042f \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0442\u0430\u0431\u0435 \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0445\u043b\u0435\u0431\u0430. \u0417&rsquo;\u0435\u0448, \u0456 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435 \u043c\u043e\u0446, \u043a\u0430\u0431 \u0442\u044b \u043c\u043e\u0433 \u0432\u044b\u0440\u0443\u0448\u044b\u0446\u044c \u0443 \u0434\u0430\u0440\u043e\u0433\u0443&raquo;. \u0410\u043b\u0435 \u0451\u043d \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0435 \u0431\u0443\u0434\u0443 \u0435\u0441\u0446\u0456&raquo;. \u0410\u0434\u043d\u0430\u043a \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0430\u0447\u0430\u043b\u0456 \u045e\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u0446\u044c \u044f\u0433\u043e. \u0422\u0430\u0434\u044b \u0451\u043d \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0456\u0445, \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u0435\u045e \u043d\u0430 \u043b\u043e\u0436\u0430\u043a. \u0423 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0431\u044b\u043b\u043e \u0434\u043e\u043c\u0430 \u045e\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0430\u0435 \u0446\u044f\u043b\u044f, \u0442\u0430\u043c\u0443 \u044f\u043d\u0430 \u0445\u0443\u0442\u043a\u0430 \u0437\u0430\u0440\u044d\u0437\u0430\u043b\u0430 \u044f\u0433\u043e \u0456, \u0443\u0437\u044f\u045e\u0448\u044b \u043c\u0443\u043a\u0456, \u0437\u0430\u043c\u044f\u0441\u0456\u043b\u0430 \u0456 \u0441\u043f\u044f\u043a\u043b\u0430 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456. \u041f\u0430\u0434\u0430\u043b\u0430 \u0456\u0445 \u0421\u0430\u045e\u043b\u0443 \u0456 \u0441\u043b\u0443\u0433\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c. \u041f\u0430\u0435\u045e\u0448\u044b, \u044f\u043d\u044b \u045e\u0441\u0442\u0430\u043b\u0456 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u0442\u0443\u044e \u0436 \u043d\u043e\u0447.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041a\u0440 10, 13. 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430\u045e\u043b \u043f\u0430\u043c\u0451\u0440 \u0437-\u0437\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0440\u0430\u0445\u0443, \u0431\u043e \u043f\u0430\u0440\u0443\u0448\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u041f\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0433 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0414\u0430\u0432\u0456\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u043d\u0430\u0432\u0430\u0442 \u043f\u0430 \u043f\u0430\u0440\u0430\u0434\u0443 \u0434\u0430 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043a\u0456, \u0430 \u043d\u0435 \u0440\u0430\u0456\u045e\u0441\u044f \u0437 \u041f\u0430\u043d\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0414\u0430\u0432\u0456\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"132","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">1 \u0421\u0430\u043c 31, 1-4; 2 \u0421\u0430\u043c 1, 1-16&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043c\u0435\u0440\u0446\u044c \u0421\u0430\u045e\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0424\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0432\u0430\u044f\u0432\u0430\u043b\u0456 \u0437 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u043c\u0456, \u0456 \u043f\u0430\u0431\u0435\u0433\u043b\u0456 \u043c\u0443\u0436\u044b \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u044f \u0430\u0434 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e, \u0456 \u0431\u044b\u043b\u0456 \u0437\u0430\u0431\u0456\u0442\u044b\u044f \u043d\u0430 \u0433\u0430\u0440\u044b \u0413\u0456\u043b\u044c\u0431\u043e\u0430. \u0422\u0430\u0434\u044b \u0434\u0430\u0433\u043d\u0430\u043b\u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0421\u0430\u045e\u043b\u0430 \u0456 \u0441\u044b\u043d\u043e\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u0417\u0430\u0431\u0456\u043b\u0456 \u0401\u043d\u0430\u0442\u0430\u043d\u0430, \u0410\u0431\u0456\u043d\u0430\u0434\u0430\u0431\u0430 \u0456 \u041c\u0430\u043b\u043a\u0456\u0448\u0443\u0430, \u0441\u044b\u043d\u043e\u045e \u0421\u0430\u045e\u043b\u0430\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0440\u0430\u0437\u0433\u0430\u0440\u044d\u043b\u0430\u0441\u044f \u0431\u0456\u0442\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0421\u0430\u045e\u043b\u0430. \u041b\u0443\u0447\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0446\u0430\u043b\u044f\u043b\u0456 \u045e \u044f\u0433\u043e, \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u0440\u0430\u043d\u0456\u043b\u0456 \u0421\u0430\u045e\u043b\u0430. \u0422\u0430\u0434\u044b \u0421\u0430\u045e\u043b \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0439\u043c\u0443 \u0437\u0431\u0440\u0430\u044f\u043d\u043e\u0441\u0446\u0443: &laquo;\u0412\u044b\u0446\u044f\u0433\u043d\u0456 \u043c\u0435\u0447 \u0441\u0432\u043e\u0439 \u0456 \u0434\u0430\u0431\u0456 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u0434\u044b \u043d\u0435 \u0437\u0430\u0431\u0456\u043b\u0456 \u043c\u044f\u043d\u0435 \u0456 \u043d\u0435 \u043a\u043f\u0456\u043b\u0456 \u0437 \u043c\u044f\u043d\u0435&raquo;. \u0410\u043b\u0435 \u0437\u0431\u0440\u0430\u044f\u043d\u043e\u0441\u0435\u0446 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e, \u0431\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0431\u0430\u044f\u045e\u0441\u044f. \u0422\u0430\u0434\u044b \u0421\u0430\u045e\u043b \u0443\u0437\u044f\u045e \u043c\u0435\u0447 \u0456 \u045e\u043f\u0430\u045e \u043d\u0430 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0421\u0430\u045e\u043b\u0430 \u0414\u0430\u0432\u0456\u0434 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u0440\u0430\u0437\u0433\u0440\u0430\u043c\u0456\u045e\u0448\u044b \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u0430\u045e, \u0456 \u043f\u0440\u0430\u0431\u044b\u045e \u0443 \u0421\u0456\u043a\u043b\u0430\u0433\u0443 \u0434\u0432\u0430 \u0434\u043d\u0456. \u041d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u043b\u0430\u0433\u0435\u0440\u0430 \u0421\u0430\u045e\u043b\u0430, \u0443 \u043f\u0430\u0440\u0432\u0430\u043d\u0430\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u0446\u044b \u0456 \u0437 \u043f\u0430\u0441\u044b\u043f\u0430\u043d\u0430\u0439 \u043f\u044b\u043b\u0430\u043c \u0433\u0430\u043b\u0430\u0432\u043e\u044e. \u041f\u0430\u0434\u044b\u0448\u043e\u045e\u0448\u044b \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u0451\u043d \u0443\u043f\u0430\u045e \u043d\u0456\u0446\u043c\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f. \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0410\u0434\u043a\u0443\u043b\u044c \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0442\u044b?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u045e\u0446\u0451\u043a \u0437 \u043b\u0430\u0433\u0435\u0440\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0414\u0430\u0432\u0456\u0434: &laquo;\u0428\u0442\u043e \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f? \u0420\u0430\u0441\u043a\u0430\u0436\u044b \u043c\u043d\u0435&raquo;. \u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0442\u043e\u0439: &laquo;\u041d\u0430\u0440\u043e\u0434 \u0443\u0446\u0451\u043a \u0437 \u0431\u0456\u0442\u0432\u044b, \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0430\u043b\u0435\u0433\u043b\u0456 \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456, \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u0430\u045e\u043b \u0456 \u0401\u043d\u0430\u0442\u0430\u043d, \u0441\u044b\u043d \u044f\u0433\u043e\u043d\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0445\u043b\u043e\u043f\u0446\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u043c\u0443 \u043d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0410\u0434\u043a\u0443\u043b\u044c \u0442\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u0421\u0430\u045e\u043b \u0456 \u0441\u044b\u043d \u044f\u0433\u043e\u043d\u044b \u0401\u043d\u0430\u0442\u0430\u043d?&raquo; \u0422\u0430\u0434\u044b \u0445\u043b\u043e\u043f\u0435\u0446 \u0441\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &laquo;\u042f \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0433\u0430\u0440\u0443 \u0413\u0456\u043b\u044c\u0431\u043e\u0430 \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0430\u045e\u043b\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u043f\u0440\u0430\u0446\u044f\u0442\u044b \u0441\u0432\u0430\u0451\u0439 \u0434\u0437\u0456\u0434\u0430\u0439, \u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u0437\u0431\u043b\u0456\u0436\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0451\u043d, \u0430\u0437\u0456\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f, \u0443\u0431\u0430\u0447\u044b\u045e \u043c\u044f\u043d\u0435, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u044f\u043d\u0435, \u0430 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0412\u043e\u0441\u044c \u044f&rdquo;. \u0401\u043d \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u043c\u044f\u043d\u0435: &ldquo;\u0425\u0442\u043e \u0442\u044b?&rdquo; \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &ldquo;\u042f &ndash; \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442&rdquo;. \u0422\u0430\u0434\u044b \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u041f\u0430\u0434\u044b\u0434\u0437\u0456 \u0456 \u0434\u0430\u0431\u0456 \u043c\u044f\u043d\u0435, \u0431\u043e \u044f \u045e \u0430\u0433\u043e\u043d\u0456\u0456, \u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e\u0441\u0451 \u044f\u0448\u0447\u044d \u045e\u0432\u0430 \u043c\u043d\u0435&rdquo;. \u042f \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0456 \u0434\u0430\u0431\u0456\u045e \u044f\u0433\u043e, \u0431\u043e \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0451\u043d \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f. \u042f \u045e\u0437\u044f\u045e \u043a\u0430\u0440\u043e\u043d\u0443, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0430 \u044f\u0433\u043e\u043d\u0430\u0439 \u0433\u0430\u043b\u0430\u0432\u0435, \u0431\u0440\u0430\u043d\u0437\u0430\u043b\u0435\u0442, \u044f\u043a\u0456 \u0431\u044b\u045e \u043d\u0430 \u044f\u0433\u043e\u043d\u0430\u0439 \u0440\u0443\u0446\u044d, \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0456\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u0430\u0439\u043c\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u0445\u0430\u043f\u0456\u045e \u0414\u0430\u0432\u0456\u0434 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u044f\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0456. \u042f\u043d\u044b \u0433\u0430\u043b\u0430\u0441\u0456\u043b\u0456 \u0456 \u043f\u043b\u0430\u043a\u0430\u043b\u0456, \u0456 \u043f\u0430\u0441\u0446\u0456\u043b\u0456 \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430 \u043f\u0430 \u0421\u0430\u045e\u043b\u0435 \u0456 \u043f\u0430 \u0401\u043d\u0430\u0442\u0430\u043d\u0443, \u0441\u044b\u043d\u0435 \u044f\u0433\u043e\u043d\u044b\u043c, \u043f\u0430 \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430 \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0448\u0442\u043e \u043f\u0430\u043b\u0435\u0433\u043b\u0456 \u0430\u0434 \u043c\u044f\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0445\u043b\u043e\u043f\u0446\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u043c\u0443 \u043d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0410\u0434\u043a\u0443\u043b\u044c \u0442\u044b?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0441\u044b\u043d \u043f\u0440\u044b\u0445\u0430\u0434\u043d\u044f \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0446\u043a\u0430\u0433\u0430&raquo;. \u0422\u0430\u0434\u044b \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u042f\u043a \u043d\u0435 \u043f\u0430\u0431\u0430\u044f\u045e\u0441\u044f \u0442\u044b \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u043a\u0430\u0431 \u0437\u0430\u0431\u0456\u0446\u044c \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430?&raquo; \u0406 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u0445\u043b\u043e\u043f\u0446\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u041f\u0430\u0434\u044b\u0434\u0437\u0456 \u0456 \u0437\u0430\u0431\u0456 \u044f\u0433\u043e&raquo;. \u0406 \u0442\u043e\u0439 \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e, \u0456 \u0451\u043d \u043f\u0430\u043c\u0451\u0440. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0414\u0430\u0432\u0456\u0434: &laquo;\u041a\u0440\u043e\u045e \u0442\u0432\u0430\u044f \u043d\u0430 \u0442\u0430\u0431\u0435, \u0431\u043e \u0442\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0442\u044b \u043a\u0430\u0437\u0430\u045e: &ldquo;\u042f \u0437\u0430\u0431\u0456\u045e \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u0421\u0430\u043c 1, 21\u0430. 27\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u043e\u0440\u044b \u0413\u0456\u043b\u044c\u0431\u043e\u0430, \u043d\u0456 \u0440\u0430\u0441\u044b, \u043d\u0456 \u0434\u0430\u0436\u0434\u0436\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e \u0442\u0443\u0442 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0448\u0447\u044b\u0442 \u043c\u043e\u0446\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u0436\u0430 \u043f\u0430\u043b\u0435\u0433\u043b\u0456 \u043c\u043e\u0446\u043d\u044b\u044f \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0432\u0430\u0435\u043d\u043d\u0430\u044f \u0437\u0431\u0440\u043e\u044f?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0442\u0443\u0442 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0448\u0447\u044b\u0442 \u043c\u043e\u0446\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"133","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">2, 1-11; 3, 1-5<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u042e\u0434\u044d\u0456 \u045e \u0413\u0435\u0431\u0440\u043e\u043d\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u043b\u0456 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0414\u0430\u0432\u0456\u0434 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u041f\u0430\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0426\u0456 \u0456\u0441\u0446\u0456 \u043c\u043d\u0435 \u045e \u044f\u043a\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0433\u043e\u0440\u0430\u0434 \u042e\u0434\u044b?&raquo; \u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0406\u0434\u0437\u0456&raquo;. \u0414\u0430\u0432\u0456\u0434 \u043f\u044b\u0442\u0430\u045e\u0441\u044f \u0434\u0430\u043b\u0435\u0439: &laquo;\u041a\u0443\u0434\u044b \u043c\u043d\u0435 \u0456\u0441\u0446\u0456?&raquo; \u0406 \u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423 \u0413\u0435\u0431\u0440\u043e\u043d&raquo;. \u0422\u0430\u0434\u044b \u043f\u0430\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434 \u0442\u0443\u0434\u044b \u0456 \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0436\u043e\u043d\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0410\u0445\u0456\u043d\u0430\u0430\u043c \u0437 \u0406\u0437\u0440\u044d\u044d\u043b\u044f \u0456 \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c, \u0431\u044b\u043b\u0430\u044f \u0436\u043e\u043d\u043a\u0430 \u041d\u0430\u0431\u0430\u043b\u044f \u0437 \u041a\u0430\u0440\u043c\u044d\u043b\u044f. \u041f\u0440\u044b\u0432\u0451\u045e \u0414\u0430\u0432\u0456\u0434 \u0441\u0432\u0430\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c, \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0441\u044f\u043c&rsquo;\u0451\u0439 \u044f\u0433\u043e\u043d\u0430\u0439, \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0456\u0441\u044f \u044f\u043d\u044b \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0413\u0435\u0431\u0440\u043e\u043d\u0435. \u041f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043c\u0443\u0436\u044b \u0437 \u042e\u0434\u044d\u0456 \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u043b\u0456 \u0442\u0430\u043c \u0414\u0430\u0432\u0456\u0434\u0430 \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u0414\u0430\u0432\u0456\u0434\u0443, \u0448\u0442\u043e \u0436\u044b\u0445\u0430\u0440\u044b \u042f\u0431\u044d\u0448-\u0413\u0456\u043b\u0435\u0430\u0434\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0421\u0430\u045e\u043b\u0430. \u0422\u0430\u0434\u044b \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u045e \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456\u043a\u0430\u045e \u0434\u0430 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u042f\u0431\u044d\u0448-\u0413\u0456\u043b\u0435\u0430\u0434\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0432\u044b \u041f\u0430\u043d\u0430\u043c \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0431\u044b\u043b\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0430\u045e\u043b\u0430 \u0456 \u0448\u0442\u043e \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u0432\u0435\u0440\u043d\u044b \u0434\u043b\u044f \u0432\u0430\u0441. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0443 \u0434\u043e\u0431\u0440\u044b \u0434\u0430 \u0432\u0430\u0441 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0456. \u041d\u044f\u0445\u0430\u0439 \u0441\u0451\u043d\u043d\u044f \u045e\u043c\u0430\u0446\u0443\u044e\u0446\u0446\u0430 \u0440\u0443\u043a\u0456 \u0432\u0430\u0448\u044b\u044f, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043c\u043e\u0446\u043d\u044b\u043c\u0456, \u0431\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0432\u0430\u0448 \u0421\u0430\u045e\u043b \u043f\u0430\u043c\u0451\u0440, \u0430 \u043c\u044f\u043d\u0435 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0434\u043e\u043c \u042e\u0434\u044b \u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0410\u0431\u043d\u044d\u0440, \u0441\u044b\u043d \u041d\u044d\u0440\u0430, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0432\u043e\u0439\u0441\u043a\u0430 \u0421\u0430\u045e\u043b\u0430, \u0443\u0437\u044f\u045e \u0406\u0448\u0431\u0430\u0430\u043b\u044f, \u0441\u044b\u043d\u0430 \u0421\u0430\u045e\u043b\u0430, \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u044f\u0433\u043e \u045e \u041c\u0430\u0445\u0430\u043d\u0430\u0456\u043c. \u0401\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0413\u0456\u043b\u0435\u0430\u0434\u0430, \u0410\u0448\u0443\u0440\u0430 \u0456 \u0406\u0437\u0440\u044d\u044d\u043b\u044f, \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0456 \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0430, \u0456 \u045e\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406\u0448\u0431\u0430\u0430\u043b\u044c, \u0441\u044b\u043d \u0421\u0430\u045e\u043b\u0430, \u043c\u0435\u045e \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u044b\u043d\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0434\u0432\u0430 \u0433\u0430\u0434\u044b. \u0422\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u043c \u042e\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0437 \u0414\u0430\u0432\u0456\u0434\u0430\u043c. \u0423\u0441\u044f\u0433\u043e \u0414\u0430\u0432\u0456\u0434 \u0431\u044b\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0443 \u0413\u0435\u0431\u0440\u043e\u043d\u0435 \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u0441\u0435\u043c \u0433\u0430\u0434\u043e\u045e \u0456 \u0448\u044d\u0441\u0446\u044c \u043c\u0435\u0441\u044f\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u043b\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430\u044f \u0432\u0430\u0439\u043d\u0430 \u043f\u0430\u043c\u0456\u0436 \u0434\u043e\u043c\u0430\u043c \u0421\u0430\u045e\u043b\u0430 \u0456 \u0434\u043e\u043c\u0430\u043c \u0414\u0430\u0432\u0456\u0434\u0430. \u0410\u043b\u0435 \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043c\u0430\u0446\u043d\u044f\u045e\u0441\u044f, \u0430 \u0434\u043e\u043c \u0421\u0430\u045e\u043b\u0430 \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430\u043d\u0435\u043f\u0430\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0414\u0430\u0432\u0456\u0434\u0430 \u045e \u0413\u0435\u0431\u0440\u043e\u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0448\u044d\u0441\u0446\u044c \u0441\u044b\u043d\u043e\u045e. \u042f\u0433\u043e \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430\u043c \u0431\u044b\u045e \u0410\u043c\u043d\u043e\u043d \u0430\u0434 \u0410\u0445\u0456\u043d\u0430\u0430\u043c\u044b \u0437 \u0406\u0437\u0440\u044d\u044d\u043b\u044f. \u0414\u0440\u0443\u0433\u0456\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u044b\u043d\u0430\u043c \u0431\u044b\u045e \u041a\u0456\u043b\u0435\u0430\u0431 \u0430\u0434 \u0410\u0431\u0456\u0433\u0430\u0439\u043b\u044c, \u0431\u044b\u043b\u043e\u0439 \u0436\u043e\u043d\u043a\u0456 \u041d\u0430\u0431\u0430\u043b\u044f \u0437 \u041a\u0430\u0440\u043c\u044d\u043b\u044f; \u0442\u0440\u044d\u0446\u0456\u043c &ndash; \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u0441\u044b\u043d \u041c\u0430\u0430\u0445\u0456, \u0434\u0430\u0447\u043a\u0456 \u0422\u0430\u043b\u043c\u0430\u044f, \u043a\u0430\u0440\u0430\u043b\u044f \u0413\u0435\u0448\u0443\u0440\u0430; \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b\u043c &ndash; \u0410\u0434\u043e\u043d\u0456\u0439, \u0441\u044b\u043d \u0425\u0430\u0433\u0456\u0442\u044b; \u043f\u044f\u0442\u044b\u043c &ndash; \u0428\u044d\u0444\u0430\u0442, \u0441\u044b\u043d \u0410\u0431\u0456\u0442\u0430\u043b\u0456, \u0430 \u0448\u043e\u0441\u0442\u044b\u043c &ndash; \u0415\u0442\u0440\u044d\u0430\u043c \u0430\u0434 \u042d\u0433\u043b\u044b, \u0436\u043e\u043d\u043a\u0456 \u0414\u0430\u0432\u0456\u0434\u0430. \u0423\u0441\u0435 \u044f\u043d\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u045e \u0413\u0435\u0431\u0440\u043e\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0411\u044b\u0446 49, 10. 8\u0430\u0441<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043d\u044f\u0442\u0430 \u0436\u0430\u0437\u043b\u043e \u0430\u0434 \u042e\u0434\u044b \u0456 \u043a\u0456\u0439 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0430\u0434 \u043d\u043e\u0433 \u044f\u0433\u043e\u043d\u044b\u0445, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u044f\u043d\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0456 \u043a\u0430\u0433\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042e\u0434\u0430, \u0446\u044f\u0431\u0435 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0440\u0430\u0442\u044b \u0442\u0432\u0430\u0435, \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u0441\u044b\u043d\u044b \u0430\u0439\u0446\u0430 \u0442\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u044f\u043d\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0456 \u043a\u0430\u0433\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"134","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">4, 2 &ndash; 5, 7<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u0417\u0434\u0430\u0431\u044b\u0446\u0446\u0451 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423 \u0406\u0448\u0431\u0430\u0430\u043b\u044f, \u0441\u044b\u043d\u0430 \u0421\u0430\u045e\u043b\u0430, \u0431\u044b\u043b\u0456 \u0434\u0432\u0430 \u043c\u0443\u0436\u044b, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0432\u043e\u0439\u0441\u043a\u0430. \u0406\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e &ndash; \u0411\u0430\u0430\u043d\u0430, \u0430 \u0456\u043c\u044f \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u0420\u044d\u0445\u0430\u0431. \u0410\u0431\u043e\u0434\u0432\u0430 \u0431\u044b\u043b\u0456 \u0441\u044b\u043d\u0430\u043c\u0456 \u0420\u044d\u043c\u043e\u043d\u0430 \u0437 \u0411\u044d\u044d\u0440\u043e\u0442\u0430, \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u045e \u0411\u0435\u043d\u044c\u044f\u043c\u0456\u043d\u0430. \u0411\u044d\u044d\u0440\u043e\u0442 \u0436\u0430 \u043d\u0430\u043b\u0435\u0436\u0430\u045e \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0443. \u0416\u044b\u0445\u0430\u0440\u044b \u0411\u044d\u044d\u0440\u043e\u0442\u0430 \u045e\u0446\u044f\u043a\u043b\u0456 \u045e \u0413\u0456\u0442\u0430\u0456\u043c \u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043c \u043f\u0440\u044b\u0445\u0430\u0434\u043d\u044f\u043c\u0456 \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d\u0430\u0442\u0430\u043d, \u0441\u044b\u043d \u0421\u0430\u045e\u043b\u0430, \u043c\u0435\u045e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0433\u0430 \u0441\u044b\u043d\u0430. \u042f\u043c\u0443 \u0431\u044b\u043b\u043e \u043f\u044f\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0441\u0442\u043a\u0430 \u0437 \u0406\u0437\u0440\u044d\u044d\u043b\u044f \u043f\u0440\u0430 \u0421\u0430\u045e\u043b\u0430 \u0456 \u0401\u043d\u0430\u0442\u0430\u043d\u0430. \u0422\u0430\u0434\u044b \u045e\u0437\u044f\u045e\u043b\u0430 \u044f\u0433\u043e \u043d\u044f\u043d\u044c\u043a\u0430, \u043a\u0430\u0431 \u045e\u0446\u044f\u0447\u044b. \u0410 \u043a\u0430\u043b\u0456 \u044f\u043d\u0430, \u0443\u0446\u044f\u043a\u0430\u044e\u0447\u044b, \u0441\u043f\u044f\u0448\u0430\u043b\u0430\u0441\u044f, \u0451\u043d \u0432\u044b\u043f\u0430\u045e \u0456 \u0441\u0442\u0430\u045e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u043c. \u0406\u043c\u044f \u044f\u0433\u043e \u041c\u044d\u0444\u0456\u0431\u0430\u0448\u044d\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u044b \u0420\u044d\u043c\u043e\u043d\u0430 \u0437 \u0411\u044d\u044d\u0440\u043e\u0442\u0430, \u0420\u044d\u0445\u0430\u0431 \u0456 \u0411\u0430\u0430\u043d\u0430\u043d, \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u045e \u0434\u0437\u0451\u043d\u043d\u0443\u044e \u0441\u043f\u0451\u043a\u0443 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0406\u0448\u0431\u0430\u0430\u043b\u044f. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u0451\u043d \u043b\u044f\u0436\u0430\u045e \u0456 \u0434\u0440\u0430\u043c\u0430\u045e \u0430\u043f\u043e\u045e\u0434\u043d\u0456. \u0420\u044d\u0445\u0430\u0431 \u0456 \u0411\u0430\u0430\u043d\u0430\u043d, \u0431\u0440\u0430\u0442 \u044f\u0433\u043e\u043d\u044b, \u0443\u0432\u0430\u0439\u0448\u043b\u0456 \u0430\u0436 \u0443 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0434\u043e\u043c\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0437\u0431\u043e\u0436\u0436\u0430, \u0443\u0434\u0430\u0440\u044b\u043b\u0456 \u044f\u0433\u043e \u045e \u0436\u044b\u0432\u043e\u0442 \u0456 \u045e\u0446\u044f\u043a\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u044f\u043d\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u0434\u043e\u043c, \u0406\u0448\u0431\u0430\u0430\u043b\u044c \u043b\u044f\u0436\u0430\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043b\u043e\u0436\u043a\u0443 \u045e \u0441\u043f\u0430\u043b\u044c\u043d\u0456. \u0422\u0430\u043c \u044f\u043d\u044b \u045e\u0434\u0430\u0440\u044b\u043b\u0456 \u044f\u0433\u043e \u0456 \u0437\u0430\u0431\u0456\u043b\u0456. \u041f\u0430\u0441\u043b\u044f \u0430\u0434\u0441\u0435\u043a\u043b\u0456 \u044f\u0433\u043e\u043d\u0443\u044e \u0433\u0430\u043b\u0430\u0432\u0443 \u0456 \u045e\u0437\u044f\u043b\u0456 \u0437 \u0441\u0430\u0431\u043e\u044e. \u0423\u0441\u044e \u043d\u043e\u0447 \u044f\u043d\u044b \u0456\u0448\u043b\u0456 \u0434\u0430\u043b\u0456\u043d\u0430\u044e \u0410\u0440\u0430\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043d\u0451\u0441\u0448\u044b \u0433\u0430\u043b\u0430\u0432\u0443 \u0406\u0448\u0431\u0430\u0430\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0443 \u045e \u0413\u0435\u0431\u0440\u043e\u043d, \u044f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u0412\u043e\u0441\u044c \u0433\u0430\u043b\u0430\u0432\u0430 \u0406\u0448\u0431\u0430\u0430\u043b\u044f, \u0441\u044b\u043d\u0430 \u0421\u0430\u045e\u043b\u0430, \u0432\u043e\u0440\u0430\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u0445\u0430\u0446\u0435\u045e \u0446\u044f\u0431\u0435 \u0437\u0430\u0431\u0456\u0446\u044c. \u0421\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e \u0421\u0430\u045e\u043b\u0443 \u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u0437\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f&raquo;. \u0410\u043b\u0435 \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0420\u044d\u0445\u0430\u0431\u0443 \u0456 \u0411\u0430\u0430\u043d\u0443, \u0431\u0440\u0430\u0442\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443, \u0441\u044b\u043d\u0430\u043c \u0420\u044d\u043c\u043e\u043d\u0430 \u0437 \u0411\u044d\u044d\u0440\u043e\u0442\u0430: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443! \u041a\u0430\u043b\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u043c\u043d\u0435 \u0432\u0435\u0441\u0442\u043a\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0412\u043e\u0441\u044c, \u043f\u0430\u043c\u0451\u0440 \u0421\u0430\u045e\u043b \u0456 \u0401\u043d\u0430\u0442\u0430\u043d&rdquo;, \u0430 \u0451\u043d \u043b\u0456\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u0432\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u043d\u0430\u0432\u0456\u043d\u044b, \u044f \u0441\u0445\u0430\u043f\u0456\u045e \u0456 \u0437\u0430\u0431\u0456\u045e \u0443 \u0421\u0456\u043a\u043b\u0430\u0433\u0443, \u0437\u0430\u043c\u0435\u0441\u0442 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0442\u043e \u043d\u044f\u045e\u0436\u043e \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0437\u0430\u0431\u0456\u043b\u0456 \u043d\u0435\u0432\u0456\u043d\u0430\u0432\u0430\u0442\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0434\u043e\u043c\u0435 \u043d\u0430 \u043b\u043e\u0436\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c, \u044f \u043d\u0435 \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u043a\u0440\u044b\u0432\u0456 \u044f\u0433\u043e\u043d\u0430\u0439 \u0430\u0434 \u0440\u0443\u043a\u0456 \u0432\u0430\u0448\u0430\u0439 \u0456 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0443 \u0432\u0430\u0441 \u0437 \u0437\u044f\u043c\u043b\u0456?&raquo; \u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0441\u043b\u0443\u0433\u0430\u043c, \u043a\u0430\u0431 \u0442\u044b\u044f \u0437\u0430\u0431\u0456\u043b\u0456 \u0456\u0445, \u0430\u0434\u0441\u0435\u043a\u043b\u0456 \u0456\u043c \u0440\u0443\u043a\u0456 \u0456 \u043d\u043e\u0433\u0456, \u0456 \u043f\u0430\u0432\u0435\u0441\u0456\u043b\u0456 \u043d\u0430\u0434 \u0441\u0430\u0436\u0430\u043b\u043a\u0430\u0439 \u0443 \u0413\u0435\u0431\u0440\u043e\u043d\u0435. \u0410 \u0433\u0430\u043b\u0430\u0432\u0443 \u0406\u0448\u0431\u0430\u0430\u043b\u044f \u045e\u0437\u044f\u043b\u0456 \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u045e \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u044b \u0410\u0431\u043d\u044d\u0440\u0430 \u045e \u0413\u0435\u0431\u0440\u043e\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u045e \u0413\u0435\u0431\u0440\u043e\u043d \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0412\u043e\u0441\u044c \u043c\u044b, \u043a\u043e\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u0456 \u0446\u0435\u043b\u0430 \u0442\u0432\u0430\u0451. \u0406 \u045e\u0447\u043e\u0440\u0430, \u0456 \u044f\u0448\u0447\u044d \u0434\u0430\u045e\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u0421\u0430\u045e\u043b \u043f\u0430\u043d\u0430\u0432\u0430\u045e \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0442\u044b \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0442\u0430\u0431\u0435: &ldquo;\u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&rdquo;&raquo;. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0413\u0435\u0431\u0440\u043e\u043d \u0443\u0441\u0435 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0456\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0443 \u0413\u0435\u0431\u0440\u043e\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0422\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u0431\u044b\u043b\u043e \u0414\u0430\u0432\u0456\u0434\u0443, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u0447\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0451\u043d \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e. \u0423 \u0413\u0435\u0431\u0440\u043e\u043d\u0435 \u0451\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0434 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435\u043c \u042e\u0434\u044b \u0441\u0435\u043c \u0433\u0430\u0434\u043e\u045e \u0456 \u0448\u044d\u0441\u0446\u044c \u043c\u0435\u0441\u044f\u0446\u0430\u045e, \u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0442\u0440\u044b \u0433\u0430\u0434\u044b \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0456 \u043d\u0430\u0434 \u042e\u0434\u0430\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u043d\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044d\u0431\u0443\u0441\u0435\u044f\u045e, \u044f\u043a\u0456\u044f \u0436\u044b\u043b\u0456 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0422\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u044e\u0434\u044b, \u0431\u043e \u0430\u0434\u0433\u043e\u043d\u044f\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u043b\u044f\u043f\u044b\u044f \u0456 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u044f&raquo;. \u0410\u0437\u043d\u0430\u0447\u0430\u043b\u0430 \u0433\u044d\u0442\u0430: \u0414\u0430\u0432\u0456\u0434 \u0441\u044e\u0434\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435. \u0410\u043b\u0435 \u0414\u0430\u0432\u0456\u0434 \u0443\u0437\u044f\u045e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e \u0421\u0456\u0451\u043d, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0433\u043e\u0440\u0430\u0434 \u0414\u0430\u0432\u0456\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 2, 2. 6. 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u045e\u0441\u0442\u0430\u044e\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0456 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u043a\u043d\u044f\u0437\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u042f \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u041a\u0430\u0440\u0430\u043b\u044f \u041c\u0430\u0439\u0433\u043e \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u041c\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0427\u0430\u043c\u0443 \u0431\u0443\u043d\u0442\u0443\u044e\u0446\u0446\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u0456 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u0430\u0434\u0443\u043c\u0430\u043b\u0456 \u043c\u0430\u0440\u043d\u0430\u0435?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u041a\u0430\u0440\u0430\u043b\u044f \u041c\u0430\u0439\u0433\u043e \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u041c\u0430\u0451\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"135","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">6, 1-23<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u043a\u0430\u045e\u0447\u044d\u0433\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0414\u0430\u0432\u0456\u0434 \u0437\u043d\u043e\u045e \u0441\u0430\u0431\u0440\u0430\u045e \u0443\u0441\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447. \u0414\u0430\u0432\u0456\u0434 \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u044b\u045e \u0437 \u0456\u043c, \u0443\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0411\u0430\u0430\u043b\u044c \u042e\u0434\u044d\u0439\u0441\u043a\u0456, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0446\u0456 \u0430\u0434\u0442\u0443\u043b\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0411\u043e\u0436\u044b, \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0456\u043c\u0435\u043c \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u0445. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0411\u043e\u0436\u044b \u043d\u0430 \u043d\u043e\u0432\u0443\u044e \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443 \u0456 \u0432\u044b\u0432\u0435\u0437\u043b\u0456 \u0437 \u0434\u043e\u043c\u0430 \u0410\u0431\u0456\u043d\u0430\u0434\u0430\u0431\u0430, \u0448\u0442\u043e \u043d\u0430 \u043f\u0430\u0433\u043e\u0440\u043a\u0443. \u0410 \u0441\u044b\u043d\u044b \u0410\u0431\u0456\u043d\u0430\u0434\u0430\u0431\u0430, \u0423\u0437\u0430 \u0456 \u0410\u0445\u0456\u044f, \u0432\u044f\u043b\u0456 \u043d\u043e\u0432\u0443\u044e \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443, \u043d\u0430 \u044f\u043a\u043e\u0439 \u0432\u0435\u0437\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0411\u043e\u0436\u044b \u0437 \u0434\u043e\u043c\u0430 \u0410\u0431\u0456\u043d\u0430\u0434\u0430\u0431\u0430, \u0448\u0442\u043e \u043d\u0430 \u043f\u0430\u0433\u043e\u0440\u043a\u0443. \u0410\u0445\u0456\u044f \u0456\u0448\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c. \u0414\u0430\u0432\u0456\u0434 \u0436\u0430 \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456\u0433\u0440\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u0443\u0437\u044b\u0447\u043d\u044b\u0445 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0445 \u0437 \u043a\u0456\u043f\u0430\u0440\u044b\u0441\u0430\u0432\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430, \u0456 \u043d\u0430 \u0430\u0440\u0444\u0430\u0445, \u0456 \u043d\u0430 \u043f\u0441\u0430\u043b\u0442\u044b\u0440\u044b, \u0456 \u043d\u0430 \u0431\u0443\u0431\u043d\u0430\u0445, \u0456 \u043d\u0430 \u0431\u0440\u0430\u0437\u0433\u043e\u0442\u043a\u0430\u0445, \u0456 \u043d\u0430 \u0446\u044b\u043c\u0431\u0430\u043b\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0433\u0443\u043c\u043d\u0430 \u041d\u0430\u0445\u043e\u043d\u0430, \u0423\u0437\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043a\u0430\u045e\u0447\u044d\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0456 \u045e\u0437\u044f\u045e\u0441\u044f \u0437\u0430 \u044f\u0433\u043e, \u0431\u043e \u0432\u0430\u043b\u044b \u043d\u0430\u0445\u0456\u043b\u0456\u043b\u0456 \u044f\u0433\u043e. \u0410\u043b\u0435 \u041f\u0430\u043d \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0423\u0437\u0443, \u0456 \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0411\u043e\u0433 \u0442\u0430\u043c \u0436\u0430 \u0437\u0430 \u0434\u0437\u0451\u0440\u0437\u043a\u0430\u0441\u0446\u044c, \u0456 \u043f\u0430\u043c\u0451\u0440 \u0451\u043d \u0442\u0430\u043c \u043a\u0430\u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u043a\u0430\u045e\u0447\u044d\u0433\u0430. \u0417\u0430\u0441\u043c\u0443\u0446\u0456\u045e\u0441\u044f \u0414\u0430\u0432\u0456\u0434, \u0448\u0442\u043e \u041f\u0430\u043d \u0437\u0430\u0431\u0456\u045e \u0423\u0437\u0443. \u0422\u0430\u043c\u0443 \u043d\u0430\u0437\u0432\u0430\u045e \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u041f\u044d\u0440\u044d\u0441-\u0423\u0437\u0430. \u0406 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u044f\u043d\u043e \u0442\u0430\u043a \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c. \u0421\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u0414\u0430\u0432\u0456\u0434 \u041f\u0430\u043d\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f\u043a \u0436\u0430 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435 \u043a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430?&raquo; \u0406 \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0414\u0430\u0432\u0456\u0434 \u0432\u0435\u0437\u0446\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430 \u0434\u0430 \u0441\u044f\u0431\u0435, \u0443 \u0433\u043e\u0440\u0430\u0434 \u0414\u0430\u0432\u0456\u0434\u0430\u045e, \u0430 \u0437\u0430\u0432\u044f\u0440\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u0434\u043e\u043c \u0410\u0431\u044d\u0434-\u042d\u0434\u043e\u043c\u0430 \u0437 \u0413\u0430\u0442. \u0417\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430 \u045e \u0434\u043e\u043c\u0435 \u0410\u0431\u044d\u0434\u0430 \u0437 \u0413\u0430\u0442 \u0442\u0440\u044b \u043c\u0435\u0441\u044f\u0446\u044b, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u0410\u0431\u044d\u0434\u0430 \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u044f\u0433\u043e\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044e \u0414\u0430\u0432\u0456\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0434\u043e\u043c \u0410\u0431\u044d\u0434\u0430 \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u045e \u044f\u0433\u043e, \u0434\u0437\u0435\u043b\u044f \u043a\u0430\u045e\u0447\u044d\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430&raquo;, \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0435\u0440\u0430\u043d\u0451\u0441 \u0411\u043e\u0436\u044b \u043a\u0430\u045e\u0447\u044d\u0433 \u0437 \u0434\u043e\u043c\u0443 \u0410\u0431\u044d\u0434-\u042d\u0434\u043e\u043c\u0430 \u045e \u0433\u043e\u0440\u0430\u0434 \u0414\u0430\u0432\u0456\u0434\u0430. \u0406 \u043a\u0430\u043b\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0451\u0441 \u0411\u043e\u0436\u044b \u043a\u0430\u045e\u0447\u044d\u0433, \u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u0448\u044d\u0441\u0446\u044c \u043a\u0440\u043e\u043a\u0430\u045e, \u0451\u043d \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0431\u044b\u043a\u0430 \u0456 \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0430\u0435 \u0446\u044f\u043b\u044f. \u0406, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u044b \u044d\u0444\u043e\u0434, \u0414\u0430\u0432\u0456\u0434 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b \u0442\u0430\u043d\u0446\u0430\u0432\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u0422\u0430\u043a \u0414\u0430\u0432\u0456\u0434 \u0456 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0435\u0440\u0430\u043d\u043e\u0441\u0456\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c\u0456 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u043c\u0456 \u0456 \u0433\u0443\u043a\u0430\u043c\u0456 \u0442\u0440\u0443\u0431\u044b. \u041a\u0430\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0443 \u0433\u043e\u0440\u0430\u0434 \u0414\u0430\u0432\u0456\u0434\u0430\u045e, \u041c\u0456\u043a\u0430\u043b\u044c, \u0434\u0430\u0447\u043a\u0430 \u0421\u0430\u045e\u043b\u0430, \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u045e \u0430\u043a\u043d\u043e \u0456, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0446\u0430\u0440\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u043a\u0456 \u0441\u043a\u0430\u043a\u0430\u045e \u0456 \u0442\u0430\u043d\u0446\u0430\u0432\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0430 \u0456\u043c \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u045e\u0447\u044d\u0433 \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u043b\u0456 \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043d\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0435 \u0434\u043b\u044f \u044f\u0433\u043e \u043c\u0435\u0441\u0446\u0430 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u0448\u0430\u0442\u0440\u0430, \u044f\u043a\u0456 \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u045e \u0434\u043b\u044f \u044f\u0433\u043e \u0414\u0430\u0432\u0456\u0434. \u0406 \u043f\u0440\u044b\u043d\u0451\u0441 \u0451\u043d \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u043c\u0456\u0440\u044d\u043d\u043d\u044f, \u0430 \u043a\u0430\u043b\u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u045e \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0430\u0445\u0432\u044f\u0440 \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u043c\u0456\u0440\u044d\u043d\u043d\u044f, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u041f\u043e\u0442\u044b\u043c \u0440\u0430\u0437\u0434\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u0433\u043e \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a \u0436\u0430\u043d\u0447\u044b\u043d, \u0442\u0430\u043a \u0456 \u043c\u0443\u0436\u0447\u044b\u043d, \u043f\u0430 \u0430\u0434\u043d\u044b\u043c \u0431\u043e\u0445\u0430\u043d\u0435 \u0445\u043b\u0435\u0431\u0430, \u043f\u0430 \u0430\u0434\u043d\u044b\u043c \u043a\u0430\u0432\u0430\u043b\u043a\u0443 \u043c\u044f\u0441\u0430 \u0456 \u043f\u0430 \u0431\u0443\u043b\u0446\u044b \u0437 \u0440\u0430\u0437\u044b\u043d\u043a\u0430\u043c\u0456. \u0406 \u0440\u0430\u0437\u044b\u0448\u043b\u0456\u0441\u044f \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u043a\u043e\u0436\u043d\u044b \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u043a\u0430\u0431 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0434\u043e\u043c, \u0432\u044b\u0439\u0448\u043b\u0430 \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u041c\u0456\u043a\u0430\u043b\u044c, \u0434\u0430\u0447\u043a\u0430 \u0421\u0430\u045e\u043b\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u042f\u043a \u0436\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0441\u0451\u043d\u043d\u044f \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446, \u0441\u043b\u0443\u0433\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u0430\u0433\u0430\u043b\u0456\u045e \u0441\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f, \u044f\u043a \u0430\u0433\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b?&raquo; \u0410 \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0456\u043a\u0430\u043b\u044c: &laquo;\u041f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u044f\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0437\u0430\u043c\u0435\u0441\u0442 \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u045e\u0441\u044f\u0433\u043e \u0434\u043e\u043c\u0443 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0443 \u041f\u0430\u043d\u0430 &ndash; \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0431\u0443\u0434\u0443 \u0442\u0430\u043d\u0446\u0430\u0432\u0430\u0446\u044c, \u0456 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u043d\u0456\u0436\u0443 \u0441\u044f\u0431\u0435, \u0456 \u0441\u0442\u0430\u043d\u0443 \u043c\u0430\u043b\u044b\u043c \u0443 \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445. \u0410 \u043f\u0435\u0440\u0430\u0434 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u0430\u043c\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u0445 \u0442\u044b \u043a\u0430\u0436\u0430\u0448, \u044f \u0431\u0443\u0434\u0443 \u0441\u043b\u0430\u045e\u043d\u044b&raquo;. \u0423 \u041c\u0456\u043a\u0430\u043b\u044c \u0436\u0430, \u0434\u0430\u0447\u043a\u0456 \u0421\u0430\u045e\u043b\u0430, \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0437\u044f\u0446\u0435\u0439 \u0430\u0436 \u0434\u0430 \u0434\u043d\u044f \u044f\u0435 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 132 (131), 8. 9; \u041f\u0441 24 (23), 7. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f, \u041f\u0430\u043d\u0435, \u0434\u0430 \u043c\u0435\u0441\u0446\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u0422\u044b \u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0422\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0422\u0432\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u0432\u0435\u0440\u043d\u044b\u044f \u0422\u0432\u0430\u0435 \u043d\u044f\u0445\u0430\u0439 \u0443\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0432\u044f\u0440\u0445\u0456 \u0432\u0430\u0448\u044b\u044f, \u0431\u0440\u0430\u043c\u044b; \u0443\u0437\u043d\u0456\u043c\u0456\u0446\u0435\u0441\u044f, \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u044f \u0432\u0430\u0440\u043e\u0442\u044b, \u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0422\u0432\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u0432\u0435\u0440\u043d\u044b\u044f \u0422\u0432\u0430\u0435 \u043d\u044f\u0445\u0430\u0439 \u0443\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"136","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">7, 1-25<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0435\u0441\u0456\u044f\u043d\u0441\u043a\u0456\u044f \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u044b \u041d\u0430\u0442\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u045e \u0434\u043e\u043c\u0435 \u0441\u0432\u0430\u0456\u043c, \u0456 \u041f\u0430\u043d \u0434\u0430\u045e \u044f\u043c\u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u0443\u0441\u0456\u0445 \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0442\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u0430\u0440\u043e\u043a\u0443 \u041d\u0430\u0442\u0430\u043d\u0443: &laquo;\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u044f \u0436\u044b\u0432\u0443 \u045e \u043a\u0435\u0434\u0440\u0430\u0432\u044b\u043c \u0434\u043e\u043c\u0435, \u0430 \u0411\u043e\u0436\u044b \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0448\u0430\u0442\u0440\u044b&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041d\u0430\u0442\u0430\u043d \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u0406\u0434\u0437\u0456, \u0437\u0440\u0430\u0431\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c, \u0431\u043e \u041f\u0430\u043d \u0437 \u0442\u0430\u0431\u043e\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u0443\u044e \u043d\u043e\u0447, \u0431\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0434\u0430 \u041d\u0430\u0442\u0430\u043d\u0430: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0441\u043a\u0430\u0436\u044b \u0441\u043b\u0443\u0437\u0435 \u041c\u0430\u0439\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0443: \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0446\u0456 \u0442\u044b \u0437\u0431\u0443\u0434\u0443\u0435\u0448 \u041c\u043d\u0435 \u0434\u043e\u043c \u041c\u0430\u0439\u0433\u043e \u0436\u044b\u043b\u043b\u044f? \u0411\u043e \u042f \u043d\u0435 \u0436\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u0437 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0436 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0430\u043b\u0435 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u045e \u0443 \u0441\u043a\u0456\u043d\u0456\u0456 \u0456 \u0448\u0430\u0442\u0440\u044b. \u041f\u0430\u045e\u0441\u044e\u043b\u044c, \u0434\u0437\u0435 \u042f \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0446\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u042f \u0441\u043b\u043e\u0432\u0430 \u0445\u043e\u0446\u044c \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c: &ldquo;\u0427\u0430\u043c\u0443 \u043d\u0435 \u043f\u0430\u0431\u0443\u0434\u0443\u0435\u0446\u0435 \u043c\u043d\u0435 \u0434\u043e\u043c \u0437 \u043a\u0435\u0434\u0440\u0443?&rdquo; \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0442\u044b \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u043b\u0443\u0437\u0435 \u041c\u0430\u0439\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0443: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f \u0437\u0430\u0431\u0440\u0430\u045e \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u0448\u044b, \u043a\u0430\u043b\u0456 \u0445\u0430\u0434\u0437\u0456\u045e \u0442\u044b \u0437\u0430 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u0441\u0442\u0430\u045e \u0442\u044b \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u041c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0431\u044b\u045e \u0437 \u0442\u0430\u0431\u043e\u044e \u045e\u0441\u044e\u0434\u044b, \u043a\u0443\u0434\u044b \u0431 \u0442\u044b \u043d\u0435 \u0445\u0430\u0434\u0437\u0456\u045e, \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0443\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0456\u043c\u044f \u0442\u0432\u0430\u0451 \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u044f\u043a \u0456\u043c\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u042f \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0443 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u0433\u043e, \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043f\u0430\u0441\u044f\u043b\u044e \u044f\u0433\u043e, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0436\u044b\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043c\u0435\u0441\u0446\u044b, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0442\u0443\u0440\u0431\u0430\u0432\u0430\u0446\u0446\u0430, \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0443\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u044f\u0433\u043e, \u044f\u043a \u0440\u0430\u043d\u0435\u0439. \u0417 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u041c\u0430\u0456\u043c, \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u042f \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0436\u044b\u0446\u044c \u0443 \u0437\u0433\u043e\u0434\u0437\u0435 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0442\u0432\u0430\u0456\u043c\u0456. \u0406 \u041f\u0430\u043d \u0430\u0431\u044f\u0446\u0430\u045e, \u0448\u0442\u043e \u043f\u0430\u0431\u0443\u0434\u0443\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u043e\u043c. \u041a\u0430\u043b\u0456 \u0436 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0434\u043d\u0456 \u0456 \u0442\u044b \u0441\u043f\u0430\u0447\u043d\u0435\u0448 \u0437 \u0431\u0430\u0446\u044c\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0442\u0430\u0434\u044b \u044f \u0430\u0431\u0443\u0434\u0436\u0443 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435 \u043f\u0430\u0442\u043e\u043c\u043a\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u045e\u043c\u0430\u0446\u0443\u044e \u044f\u0433\u043e\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0401\u043d \u0437\u0431\u0443\u0434\u0443\u0435 \u0434\u043e\u043c \u041c\u0430\u0439\u043c\u0443 \u0456\u043c\u0435\u043d\u0456, \u0430 \u042f \u045e\u043c\u0430\u0446\u0443\u044e \u0442\u0440\u043e\u043d \u044f\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u0432\u0435\u043a\u0456. \u042f \u0431\u0443\u0434\u0443 \u044f\u043c\u0443 \u0410\u0439\u0446\u043e\u043c, \u0430 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0441\u044b\u043d\u0430\u043c. \u041a\u0430\u043b\u0456 \u0451\u043d \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u042f \u043f\u0430\u043a\u0430\u0440\u0430\u044e \u044f\u0433\u043e \u043b\u044e\u0434\u0441\u043a\u043e\u044e \u0440\u043e\u0437\u0433\u0430\u044e \u0456 \u045e\u0434\u0430\u0440\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0441\u044b\u043d\u043e\u045e. \u0410\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435 \u0430\u0434\u044b\u043c\u0443 \u045e \u044f\u0433\u043e, \u044f\u043a \u0430\u0434\u043d\u044f\u045e \u0443 \u0421\u0430\u045e\u043b\u0430, \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u043e\u0433\u0430 \u042f \u0430\u0434\u043a\u0456\u043d\u0443\u045e. \u0406 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c \u0434\u043e\u043c \u0442\u0432\u043e\u0439 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0451 \u043d\u0430\u0432\u0435\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041c\u0430\u0456\u043c, \u0456 \u0442\u0440\u043e\u043d \u0442\u0432\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0443\u0441\u0456\u043c \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c \u0433\u044d\u0442\u044b\u043c, \u0442\u0430\u043a \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u041d\u0430\u0442\u0430\u043d \u0414\u0430\u0432\u0456\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u041d\u0430\u0442\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u043f\u0430\u0439\u0448\u043e\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434, \u0441\u0435\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u044f, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u0456 \u044f\u043a\u0456 \u0434\u043e\u043c \u043c\u043e\u0439, \u0448\u0442\u043e \u0422\u044b \u043f\u0440\u044b\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u0430\u0436 \u0441\u044e\u0434\u044b? \u0406 \u0433\u044d\u0442\u0430 \u044f\u0448\u0447\u044d \u0437\u0434\u0430\u043b\u043e\u0441\u044f \u043c\u0430\u043b\u044b\u043c \u045e \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u0456 \u0422\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0434\u043e\u043c \u0441\u043b\u0443\u0433\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0435. \u0413\u044d\u0442\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430! \u0428\u0442\u043e \u044f\u0448\u0447\u044d \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0422\u0430\u0431\u0435 \u0414\u0430\u0432\u0456\u0434? \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448 \u0441\u043b\u0443\u0433\u0443 \u0422\u0432\u0430\u0439\u0433\u043e, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430. \u0414\u0437\u0435\u043b\u044f \u0441\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u043f\u0430 \u0441\u044d\u0440\u0446\u044b \u0422\u0432\u0430\u0456\u043c \u0422\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0448 \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0443 \u0422\u0432\u0430\u0439\u0433\u043e. \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u044f\u043a\u0456 \u0422\u044b \u0432\u0435\u043b\u0456\u0447\u043d\u044b, \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0422\u0430\u0431\u0435, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u044b\u0445 \u0431\u0430\u0433\u043e\u045e \u0430\u043f\u0440\u0430\u0447\u0430 \u0426\u044f\u0431\u0435, \u043f\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0447\u0443\u043b\u0456 \u043c\u044b \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u0443\u0448\u044b. \u0406 \u0445\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e, \u0406\u0437\u0440\u0430\u044d\u043b\u044f? \u0426\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u0456 \u043d\u0430\u0440\u043e\u0434 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0431\u044b \u0411\u043e\u0433, \u043a\u0430\u0431 \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u044f\u0433\u043e \u0456 \u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u0456\u043c\u044f, \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u043b\u044f \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b, \u0448\u0442\u043e \u0430\u0431\u0443\u0434\u0436\u0430\u044e\u0446\u044c \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u044f\u043a\u0456 \u0422\u044b, \u0411\u043e\u0436\u0430, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0432\u044b\u0433\u0430\u043d\u044f\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0447\u0443\u0436\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0434\u044b \u0456\u0445\u043d\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e? \u0422\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0441\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434 \u0422\u0432\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u0430\u0432\u0435\u043a\u0456, \u0456 \u0422\u044b, \u041f\u0430\u043d\u0435, \u0441\u0442\u0430\u045e \u044f\u0433\u043e \u0411\u043e\u0433\u0430\u043c. \u0406 \u0446\u044f\u043f\u0435\u0440, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u0443\u043c\u0430\u0446\u0443\u0439 \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0422\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u044f\u0433\u043e \u0434\u043e\u043c, \u0456 \u0437\u0440\u0430\u0431\u0456, \u044f\u043a \u0422\u044b \u043a\u0430\u0437\u0430\u045e!&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 30-33; \u041f\u0441 132 (131), 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0440\u044b\u0456 \u0430\u043d\u0451\u043b \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c: \u0412\u043e\u0441\u044c \u0437\u0430\u0447\u043d\u0435\u0448 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430, \u0456 \u0434\u0430\u0441\u0446\u044c \u042f\u043c\u0443 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0440\u043e\u043d \u0414\u0430\u0432\u0456\u0434\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042f\u043a\u0443\u0431\u0430 \u0432\u0435\u0447\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u041f\u0430\u043d \u0414\u0430\u0432\u0456\u0434\u0443 \u045e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0430\u0434 \u044f\u0435: \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u043f\u0430\u0441\u0430\u0434\u0436\u0443 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0442\u0432\u0430\u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042f\u043a\u0443\u0431\u0430 \u0432\u0435\u0447\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"137","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f<span style=\"color: #ff0000;\">&nbsp;11, 1-17. 26-27<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0413\u0440\u044d\u0445 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0433\u043e\u0434\u0430, \u043a\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043d\u0430 \u0432\u043e\u0439\u043d\u044b, \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0441\u043b\u0430\u045e \u0401\u0430\u0432\u0430, \u0430 \u0437 \u0456\u043c \u0441\u043b\u0443\u0433\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u045e\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u042f\u043d\u044b \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u044b\u043b\u0456 \u0437\u0435\u043c\u043b\u0456 \u0430\u043c\u0430\u043d\u0456\u0442\u0430\u045e \u0456 \u0430\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u0420\u0430\u0431\u0443. \u0410 \u0414\u0430\u0432\u0456\u0434 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e\u0439\u0447\u044b \u045e\u0432\u0435\u0447\u0430\u0440\u044b \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0442\u0430\u045e \u0437 \u043b\u043e\u0436\u043a\u0430 \u0456 \u043f\u0440\u0430\u0445\u043e\u0434\u0436\u0432\u0430\u045e\u0441\u044f \u043f\u0430 \u0442\u044d\u0440\u0430\u0441\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043b\u0430\u0446\u0443. \u0417 \u0442\u044d\u0440\u0430\u0441\u044b \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u044f\u043a\u0430\u044f \u043a\u0443\u043f\u0430\u043b\u0430\u0441\u044f. \u0410 \u0442\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f. \u0422\u0430\u0434\u044b \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u0445\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u0456 \u044f\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0411\u044d\u0442\u0448\u044d\u0431\u0430, \u0434\u0430\u0447\u043a\u0430 \u042d\u043b\u0456\u044f\u043c\u0430, \u0436\u043e\u043d\u043a\u0430 \u0423\u0440\u044b\u0456 \u0425\u0435\u0442\u044b\u0442\u0430. \u0422\u0430\u0434\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u044f\u0435. \u0410 \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0430, \u0451\u043d \u0441\u043f\u0430\u045e \u0437 \u0451\u044e. \u041f\u0430\u0441\u043b\u044f \u044f\u043d\u0430 \u0430\u0447\u044b\u0441\u0446\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0456 \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c. \u0406 \u0437\u0430\u0446\u044f\u0436\u0430\u0440\u044b\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0433\u044d\u0442\u0430, \u0442\u0430\u043c\u0443 \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u042f \u0446\u044f\u0436\u0430\u0440\u043d\u0430\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0401\u0430\u0432\u0443: &laquo;\u041f\u0440\u044b\u0448\u043b\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0423\u0440\u044b\u044f \u0425\u0435\u0442\u044b\u0442\u0430&raquo;. \u0406 \u043f\u0430\u0441\u043b\u0430\u045e \u0401\u0430\u045e \u0423\u0440\u044b\u044e \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0423\u0440\u044b\u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e, \u0414\u0430\u0432\u0456\u0434 \u0440\u0430\u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f, \u044f\u043a \u043c\u0430\u0435\u0446\u0446\u0430 \u0401\u0430\u045e, \u044f\u043a \u043c\u0430\u044e\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u0456 \u0456 \u044f\u043a \u0456\u0434\u0437\u0435 \u0432\u0430\u0439\u043d\u0430. \u0417\u0430\u0442\u044b\u043c \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0423\u0440\u044b\u0456: &laquo;\u0406\u0434\u0437\u0456 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443 \u0456 \u0430\u0431\u043c\u044b\u0439 \u0441\u0430\u0431\u0435 \u043d\u043e\u0433\u0456&raquo;. \u0423\u0440\u044b\u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043b\u0430\u0446\u0443, \u0430 \u0437\u0430 \u0456\u043c \u043f\u0430\u043d\u0435\u0441\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u0435\u0436\u0443. \u0410\u043b\u0435 \u0423\u0440\u044b\u044f \u043b\u0451\u0433 \u0441\u043f\u0430\u0446\u044c \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u043f\u0430\u043b\u0430\u0446 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0423\u0440\u044b\u044f \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443&raquo;. \u0422\u0430\u0434\u044b \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0423\u0440\u044b\u044e: &laquo;\u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u0434\u0430\u0440\u043e\u0433\u0456, \u0447\u0430\u043c\u0443 \u0436 \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0442\u044b \u045e \u0434\u043e\u043c \u0441\u0432\u043e\u0439?&raquo; \u0423\u0440\u044b\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u041a\u0430\u045e\u0447\u044d\u0433, \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0456 \u042e\u0434\u0430 \u045e \u043d\u0430\u043c\u0451\u0442\u0430\u0445, \u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043c\u043e\u0439 \u0401\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u0443\u0433\u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e \u045e \u043f\u043e\u043b\u0456. \u0426\u0456 \u0436 \u044f \u043c\u0430\u0433\u0443 \u043f\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443, \u043a\u0430\u0431 \u0435\u0441\u0446\u0456, \u043f\u0456\u0446\u044c \u0456 \u0441\u043f\u0430\u0446\u044c \u0437 \u0436\u043e\u043d\u043a\u0430\u044e? \u041f\u0440\u044b\u0441\u044f\u0433\u0430\u044e \u0442\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0436\u044b\u0446\u0446\u0451\u043c \u0434\u0443\u0448\u044b \u0442\u0432\u0430\u0451\u0439, \u044f \u043d\u0435 \u0437\u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430\u0433\u0430&raquo;. \u041d\u0430 \u0433\u044d\u0442\u0430 \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e \u0423\u0440\u044b\u0456: &laquo;\u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0442\u0443\u0442 \u0456 \u0441\u0451\u043d\u043d\u044f, \u0430 \u0437\u0430\u045e\u0442\u0440\u0430 \u044f \u0430\u0434\u043f\u0443\u0448\u0447\u0443 \u0446\u044f\u0431\u0435&raquo;. \u0423 \u0433\u044d\u0442\u044b \u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0423\u0440\u044b\u044f \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0422\u0430\u0434\u044b \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u044f\u0433\u043e \u0414\u0430\u0432\u0456\u0434, \u043a\u0430\u0431 \u0451\u043d \u0435\u045e \u0456 \u043f\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c. \u0406 \u043d\u0430\u043f\u0430\u0456\u045e \u044f\u0433\u043e. \u0410 \u045e\u0432\u0435\u0447\u0430\u0440\u044b \u043f\u0430\u0439\u0448\u043e\u045e \u0423\u0440\u044b\u044f \u0441\u043f\u0430\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u044e \u043f\u0430\u0441\u0446\u0435\u043b\u044c \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u0430\u043b\u0435 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u043d\u0456\u0446\u0430\u0439 \u0414\u0430\u0432\u0456\u0434 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u043b\u0456\u0441\u0442 \u0434\u0430 \u0401\u0430\u0432\u0430 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e \u043f\u0440\u0430\u0437 \u0423\u0440\u044b\u044e. \u0423 \u043b\u0456\u0441\u0446\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u045e: &laquo;\u041f\u0430\u0441\u0442\u0430\u045e\u0446\u0435 \u0423\u0440\u044b\u044e \u045e \u043f\u0435\u0440\u0448\u044b\u0445 \u0448\u044d\u0440\u0430\u0433\u0430\u0445, \u0434\u0437\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0430\u043c\u044b \u0433\u0430\u0440\u0430\u0447\u044b \u0431\u043e\u0439, \u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0435 \u0430\u0434 \u044f\u0433\u043e, \u043a\u0430\u0431 \u044f\u0433\u043e \u0437\u0430\u0431\u0456\u043b\u0456 \u0456 \u0451\u043d \u043f\u0430\u043c\u0451\u0440&raquo;. \u041f\u0430\u0434\u0447\u0430\u0441 \u0430\u0431\u043b\u043e\u0433\u0456 \u0433\u043e\u0440\u0430\u0434\u0430 \u0401\u0430\u045e \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0423\u0440\u044b\u044e \u045e \u0442\u0430\u043a\u0456\u043c \u043c\u0435\u0441\u0446\u044b, \u0434\u0437\u0435, \u044f\u043a \u0432\u0435\u0434\u0430\u045e, \u0431\u044b\u043b\u0456 \u043d\u0430\u0439\u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u044f \u0436\u0430\u045e\u043d\u0435\u0440\u044b \u0432\u043e\u0440\u0430\u0433\u0430. \u041b\u044e\u0434\u0437\u0456 \u0432\u044b\u0439\u0448\u043b\u0456 \u0437 \u0433\u043e\u0440\u0430\u0434\u0430 \u0456 \u0431\u0456\u043b\u0456\u0441\u044f \u0437 \u0401\u0430\u0432\u0430\u043c. \u0406 \u043f\u0430\u043b\u0435\u0433\u043b\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0430. \u0417\u0430\u0433\u0456\u043d\u0443\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0423\u0440\u044b\u044f \u0425\u0435\u0442\u044b\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u043b\u0430 \u0436\u043e\u043d\u043a\u0430 \u0423\u0440\u044b\u0456, \u0448\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0423\u0440\u044b\u044f, \u043c\u0443\u0436 \u044f\u0435, \u043f\u043b\u0430\u043a\u0430\u043b\u0430 \u043f\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u044b \u0441\u0432\u0430\u0456\u043c. \u0410 \u043a\u0430\u043b\u0456 \u043c\u0456\u043d\u0443\u045e \u0447\u0430\u0441 \u0436\u0430\u043b\u043e\u0431\u044b, \u0414\u0430\u0432\u0456\u0434 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u044f\u0435 \u045e \u0434\u043e\u043c \u0441\u0432\u043e\u0439, \u0456 \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u044e \u0436\u043e\u043d\u043a\u0430\u044e, \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043c\u0443 \u0441\u044b\u043d\u0430. \u0410\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0414\u0430\u0432\u0456\u0434, \u0431\u044b\u043b\u043e \u0434\u0440\u044d\u043d\u043d\u044b\u043c \u0443 \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0421\u0430\u043c 12, 9; \u0417\u044b\u0445 20, 2. 13. 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0440\u044b\u044f \u0425\u0435\u0442\u044b\u0442\u0430 \u0442\u044b \u0437\u0430\u0431\u0456\u045e \u043c\u044f\u0447\u043e\u043c \u0456 \u0436\u043e\u043d\u043a\u0443 \u044f\u0433\u043e\u043d\u0443\u044e \u045e\u0437\u044f\u045e \u0441\u0430\u0431\u0435 \u0437\u0430 \u0436\u043e\u043d\u043a\u0443.<span style=\"color: #ff0000;\"> *<\/span> \u0414\u044b\u043a \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0442\u044b \u0441\u043b\u043e\u0432\u0430\u043c \u041f\u0430\u043d\u0430, \u0437\u0440\u0430\u0431\u0456\u045e\u0448\u044b \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u042f\u0433\u043e\u043d\u044b\u043c\u0456?<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u041d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0439, \u043d\u0435 \u0447\u0443\u0436\u0430\u043b\u043e\u0436.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u044b\u043a \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0442\u044b \u0441\u043b\u043e\u0432\u0430\u043c \u041f\u0430\u043d\u0430, \u0437\u0440\u0430\u0431\u0456\u045e\u0448\u044b \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u042f\u0433\u043e\u043d\u044b\u043c\u0456?<\/p>\r\n"}, {"GCH_CH_1_ID":"141","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">12, 1-25&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u0443\u0442\u0430 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u041d\u0430\u0442\u0430\u043d\u0430 \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430. \u0422\u043e\u0439 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423 \u0430\u0434\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0431\u044b\u043b\u043e \u0434\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0456, \u0430\u0434\u0437\u0456\u043d \u0431\u0430\u0433\u0430\u0442\u044b, \u0430 \u0434\u0440\u0443\u0433\u0456 \u0431\u0435\u0434\u043d\u044b. \u0423 \u0431\u0430\u0433\u0430\u0442\u0430\u0433\u0430 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0432\u0430\u043b\u043e\u045e, \u0430 \u045e \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043f\u0440\u0430\u0447\u0430 \u0430\u0434\u043d\u043e\u0439 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u0439 \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043a\u0443\u044e \u0451\u043d \u043a\u0443\u043f\u0456\u045e \u0456 \u0433\u0430\u0434\u0430\u0432\u0430\u045e. \u042f\u043d\u0430 \u0440\u0430\u0441\u043b\u0430 \u045e \u044f\u0433\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456. \u0410\u0434 \u044f\u0433\u043e \u0445\u043b\u0435\u0431\u0430 \u044f\u043d\u0430 \u0435\u043b\u0430, \u0456 \u0437 \u044f\u0433\u043e \u043a\u0443\u0431\u043a\u0430 \u043f\u0456\u043b\u0430, \u0456 \u0441\u043f\u0430\u043b\u0430 \u043f\u0440\u044b \u044f\u0433\u043e \u0431\u0430\u043a\u0443, \u0456 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u044f\u0433\u043e, \u044f\u043a \u0434\u0430\u0447\u043a\u0430. \u041d\u0435\u044f\u043a \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0433\u043e\u0441\u0446\u044c \u0434\u0430 \u0431\u0430\u0433\u0430\u0442\u0430\u0433\u0430, \u0430\u043b\u0435 \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0448\u043a\u0430\u0434\u0430 \u045e\u0437\u044f\u0446\u044c \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0443\u043b\u0430\u0441\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0432\u0430\u043b\u043e\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0433\u043e\u0441\u0446\u044e, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e. \u0422\u0430\u0434\u044b \u0451\u043d \u0443\u0437\u044f\u045e \u0430\u0432\u0435\u0447\u043a\u0443 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0456 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u045e \u044f\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e&raquo;. \u0414\u0430\u0432\u0456\u0434 \u0432\u0435\u043b\u044c\u043c\u0456 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u041d\u0430\u0442\u0430\u043d\u0443: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430, \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u0456. \u0406 \u0437\u0430 \u0430\u0432\u0435\u0447\u043a\u0443 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0443 \u0447\u0430\u0442\u044b\u0440\u044b \u0440\u0430\u0437\u044b \u0431\u043e\u043b\u044c\u0448, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a \u0456 \u043d\u0435 \u043c\u0435\u045e \u0441\u043f\u0430\u0433\u0430\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041d\u0430\u0442\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0422\u044b &ndash; \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a! \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u042f \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u0430\u0434 \u0440\u0443\u043a\u0456 \u0421\u0430\u045e\u043b\u0430, \u0456 \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0434\u043e\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u0436\u043e\u043d\u0430\u043a \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u0435 \u0442\u0432\u0430\u0451, \u0456 \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042e\u0434\u044b, \u0456, \u043a\u0430\u043b\u0456 \u0431 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u044b\u043b\u043e \u043c\u0430\u043b\u0430, \u0434\u0430\u0434\u0430\u045e \u0431\u044b \u0442\u0430\u0431\u0435 \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448. \u0414\u044b\u043a \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0442\u044b \u0441\u043b\u043e\u0432\u0430\u043c \u041f\u0430\u043d\u0430, \u0437\u0440\u0430\u0431\u0456\u045e\u0448\u044b \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u042f\u0433\u043e\u043d\u044b\u043c\u0456? \u0423\u0440\u044b\u044e \u0425\u0435\u0442\u044b\u0442\u0430 \u0442\u044b \u0437\u0430\u0431\u0456\u045e \u043c\u044f\u0447\u043e\u043c \u0456 \u0436\u043e\u043d\u043a\u0443 \u044f\u0433\u043e\u043d\u0443\u044e \u045e\u0437\u044f\u045e \u0441\u0430\u0431\u0435 \u0437\u0430 \u0436\u043e\u043d\u043a\u0443, \u0430 \u044f\u0433\u043e \u0442\u044b \u0437\u0430\u0431\u0456\u045e \u043c\u044f\u0447\u043e\u043c \u0430\u043c\u0430\u043d\u0456\u0446\u044f\u043d\u0430\u045e. \u0412\u043e\u0441\u044c \u0442\u0430\u043c\u0443 \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u043c\u0435\u0447 \u0430\u0434 \u0434\u043e\u043c\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456, \u0431\u043e \u0442\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u041c\u043d\u043e\u044e \u0456 \u045e\u0437\u044f\u045e \u0436\u043e\u043d\u043a\u0443 \u0423\u0440\u044b\u044f \u0425\u0435\u0442\u044b\u0442\u044b, \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u0442\u0430\u0431\u0435 \u0436\u043e\u043d\u043a\u0430\u044e. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0412\u043e\u0441\u044c \u042f \u0437 \u0434\u043e\u043c\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u043f\u0430\u0448\u043b\u044e \u043d\u0430 \u0446\u044f\u0431\u0435 \u0437\u043b\u043e, \u0456 \u0432\u0430\u0437\u044c\u043c\u0443 \u0436\u043e\u043d\u0430\u043a \u0442\u0432\u0430\u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0442\u0432\u0430\u0456\u043c\u0456, \u0456 \u0430\u0434\u0434\u0430\u043c \u0456\u0445 \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443 \u0442\u0432\u0430\u0439\u043c\u0443, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0446\u044c \u0437 \u0442\u0432\u0430\u0456\u043c\u0456 \u0436\u043e\u043d\u043a\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043e\u043d\u0446\u0430. \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u043f\u0430\u0442\u0430\u0435\u043c\u043d\u0430, \u0430 \u044f \u0437\u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u041d\u0430\u0442\u0430\u043d\u0443: &laquo;\u0417\u0433\u0440\u0430\u0448\u044b\u045e \u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c&raquo;. \u041d\u0430\u0442\u0430\u043d \u0436\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u041f\u0430\u043d \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0442\u0430\u0431\u0435 \u0433\u0440\u044d\u0445 \u0442\u0432\u043e\u0439: \u0442\u044b \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u0448. \u0410\u043b\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0434\u0430\u045e \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0443 \u0434\u043b\u044f \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u041f\u0430\u043d\u0430, \u0441\u044b\u043d, \u044f\u043a\u0456 \u045e \u0446\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430, \u043f\u0430\u043c\u0440\u044d&raquo;. \u0406 \u041d\u0430\u0442\u0430\u043d \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443. \u041f\u0430\u043d \u043f\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u045e \u0434\u0437\u0456\u0446\u044f, \u044f\u043a\u043e\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0414\u0430\u0432\u0456\u0434\u0443 \u0436\u043e\u043d\u043a\u0430 \u0423\u0440\u044b\u0456, \u0456 \u044f\u043d\u043e \u0446\u044f\u0436\u043a\u0430 \u0437\u0430\u0445\u0432\u0430\u0440\u044d\u043b\u0430. \u0414\u0430\u0432\u0456\u0434 \u043c\u0430\u043b\u0456\u045e \u0411\u043e\u0433\u0430 \u0437\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u043b\u043e\u043f\u0447\u044b\u043a\u0430 \u0456 \u0441\u0443\u0440\u043e\u0432\u0430 \u043f\u0430\u0441\u0446\u0456\u045e, \u0430 \u043a\u0430\u043b\u0456 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u044f\u0431\u0435, \u0443\u0441\u044e \u043d\u043e\u0447 \u043b\u044f\u0436\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u0434\u043e\u043c\u0443 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0435\u045e \u0437 \u0456\u043c\u0456. \u041d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0434\u0437\u0456\u0446\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430. \u0410\u043b\u0435 \u0441\u043b\u0443\u0433\u0456 \u0414\u0430\u0432\u0456\u0434\u0430 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0434\u0430\u043d\u0435\u0441\u0446\u0456 \u044f\u043c\u0443, \u0448\u0442\u043e \u0434\u0437\u0456\u0446\u044f \u043d\u0435 \u0436\u044b\u0432\u0435, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041a\u0430\u043b\u0456 \u0434\u0437\u0456\u0446\u044f \u0431\u044b\u043b\u043e \u044f\u0448\u0447\u044d \u0436\u044b\u0432\u043e\u0435, \u0451\u043d \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u045e \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u044f\u043c\u0443. \u042f\u043a \u0436\u0430 \u043c\u043e\u0436\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u043c\u0443, \u0448\u0442\u043e \u0434\u0437\u0456\u0446\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430? \u0401\u043d \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435&raquo;. \u0414\u0430\u0432\u0456\u0434, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0448\u044d\u043f\u0447\u0443\u0446\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0434\u0437\u0456\u0446\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430. \u0422\u0430\u0434\u044b \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u0414\u0430\u0432\u0456\u0434 \u0443 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e: &laquo;\u0414\u0437\u0456\u0446\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430?&raquo; \u042f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043c\u0443: &laquo;\u041f\u0430\u043c\u0435\u0440\u043b\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u0437 \u0437\u044f\u043c\u043b\u0456, \u0430\u0431\u043c\u044b\u045e\u0441\u044f, \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0441\u044f\u0431\u0435, \u0437\u043c\u044f\u043d\u0456\u045e \u0441\u0432\u0430\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0434\u043e\u043c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u042f\u043c\u0443. \u041f\u0430\u0441\u043b\u044f, \u0432\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c, \u0451\u043d \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u0430\u043b\u0456 \u044f\u043c\u0443 \u0445\u043b\u0435\u0431\u0430, \u0456 \u0451\u043d \u043f\u0430\u0434\u0441\u0456\u043b\u043a\u0430\u0432\u0430\u045e\u0441\u044f. \u0421\u043b\u0443\u0433\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u044f\u0433\u043e: &laquo;\u042f\u043a \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u0432\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b? \u041a\u0430\u043b\u0456 \u0434\u0437\u0456\u0446\u044f \u0431\u044b\u043b\u043e \u044f\u0448\u0447\u044d \u0436\u044b\u0432\u043e\u0435, \u0442\u044b \u043f\u0430\u0441\u0446\u0456\u045e \u0456 \u043f\u043b\u0430\u043a\u0430\u045e, \u0430 \u043a\u0430\u043b\u0456 \u0434\u0437\u0456\u0446\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430, \u0442\u044b \u045e\u0441\u0442\u0430\u045e \u0456 \u044f\u0441\u0456 \u0445\u043b\u0435\u0431?&raquo; \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043a\u0443\u043b\u044c \u0434\u0437\u0456\u0446\u044f \u0436\u044b\u043b\u043e, \u044f \u043f\u0430\u0441\u0446\u0456\u045e \u0456 \u043f\u043b\u0430\u043a\u0430\u045e, \u0431\u043e \u0434\u0443\u043c\u0430\u045e: \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435, \u043c\u043e\u0436\u0430 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e \u041f\u0430\u043d, \u0456 \u0434\u0437\u0456\u0446\u044f \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u044c. \u0410 \u0446\u044f\u043f\u0435\u0440 \u044f\u043d\u043e \u043f\u0430\u043c\u0435\u0440\u043b\u0430. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043c\u043d\u0435 \u043f\u0430\u0441\u0446\u0456\u0446\u044c? \u0425\u0456\u0431\u0430 \u044f \u043c\u0430\u0433\u0443 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u044f\u0433\u043e? \u042f \u043f\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e, \u0430\u043b\u0435 \u044f\u043d\u043e \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0441\u0443\u0446\u044f\u0448\u0430\u045e \u0411\u044d\u0442\u0448\u044d\u0431\u0443, \u0436\u043e\u043d\u043a\u0443 \u0441\u0432\u0430\u044e. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0435 \u0456 \u0441\u043f\u0430\u045e \u0437 \u0451\u044e. \u0406 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043d\u0430 \u0441\u044b\u043d\u0430, \u044f\u043a\u043e\u043c\u0443 \u0434\u0430\u043b\u0430 \u0456\u043c\u044f \u0421\u0430\u043b\u0430\u043c\u043e\u043d. \u0410 \u041f\u0430\u043d \u043b\u044e\u0431\u0456\u045e \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041d\u0430\u0442\u0430\u043d\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0434\u0430\u045e \u044f\u043c\u0443 \u0456\u043c\u044f \u0415\u0434\u044b\u0434\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430 9, 10. 12; \u041f\u0441 51 (50), 5. 6\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0442\u0430\u043a \u0448\u043c\u0430\u0442, \u044f\u043a \u043f\u044f\u0441\u043a\u0443 \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u043c\u043e\u0440\u0430, \u044f \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0456\u0445 \u0431\u0435\u0437 \u043b\u0456\u043a\u0443. \u0417 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u0451\u0439 \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u044f \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u0422\u0432\u043e\u0439 \u0433\u043d\u0435\u045e. <span style=\"color: #ff0000;\">*<\/span> \u042f \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0432\u0435\u0434\u0430\u044e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043c\u0430\u0435, \u0456 \u0433\u0440\u044d\u0445 \u043c\u043e\u0439 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e. \u0422\u0430\u0431\u0435 \u0430\u0434\u043d\u0430\u043c\u0443 \u044f \u0437\u0433\u0440\u0430\u0448\u044b\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"142","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">15, 7-14. 24-30; 16, 5-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u0443\u043d\u0442 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430 \u0456 \u045e\u0446\u0451\u043a\u0456 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u0441\u043b\u044f \u0441\u0430\u0440\u0430\u043a\u0430 \u0433\u0430\u0434\u043e\u045e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0414\u0430\u0432\u0456\u0434\u0430, \u0410\u0431\u0441\u0430\u043b\u043e\u043c \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u0414\u0430\u0437\u0432\u043e\u043b\u044c, \u043a\u0430\u0431 \u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0441\u0432\u0430\u0451 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0434\u0430\u045e \u041f\u0430\u043d\u0443 \u045e \u0413\u0435\u0431\u0440\u043e\u043d\u0435. \u0411\u043e \u044f, \u0441\u043b\u0443\u0433\u0430 \u0442\u0432\u043e\u0439, \u043a\u0430\u043b\u0456 \u0436\u044b\u045e \u0443 \u0413\u0435\u0448\u0443\u0440\u044b \u045e \u0410\u0440\u0430\u043c\u0435, \u0434\u0430\u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043c\u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u044f \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443&rdquo;&raquo;. \u041a\u0430\u0440\u043e\u043b\u044c \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0406\u0434\u0437\u0456 \u045e \u0441\u0443\u043f\u0430\u043a\u043e\u0456&raquo;. \u0422\u043e\u0439 \u0443\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0413\u0435\u0431\u0440\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0442\u0443\u043b\u044c \u0440\u0430\u0437\u0430\u0441\u043b\u0430\u045e \u0410\u0431\u0441\u0430\u043b\u043e\u043c \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0432\u0430 \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0441\u043a\u0430\u0437\u0430\u045e\u0448\u044b: &laquo;\u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u0440\u043e\u0433\u0443, \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u0435: &ldquo;\u0410\u0431\u0441\u0430\u043b\u043e\u043c \u0441\u0442\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0443 \u0413\u0435\u0431\u0440\u043e\u043d\u0435&rdquo;&raquo;. \u041f\u0430\u0439\u0448\u043b\u043e \u0437 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430\u043c \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437\u0430\u043f\u0440\u043e\u0448\u0430\u043d\u044b \u0456\u043c. \u041f\u0430\u0439\u0448\u043b\u0456 \u043f\u0430 \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0441\u0432\u0430\u0451\u0439, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u045e\u0441\u044f\u0433\u043e. \u0410\u0431\u0441\u0430\u043b\u043e\u043c \u0436\u0430, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u0435\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0410\u0445\u0456\u0442\u0430\u0444\u044d\u043b\u044f, \u0434\u0430\u0440\u0430\u0434\u0446\u0443 \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u043a\u0456 \u0436\u044b\u045e \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0413\u0456\u043b\u043e. \u0422\u0430\u043a \u0437\u043c\u043e\u0432\u0430 \u043c\u0430\u0446\u043d\u0435\u043b\u0430, \u0456 \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437\u0431\u0456\u0440\u0430\u043b\u0430\u0441\u044f \u0432\u0430\u043a\u043e\u043b \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u0435\u0446 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0421\u044d\u0440\u0446\u044b \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e \u0441\u0445\u0456\u043b\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0456 \u045e\u0446\u044f\u043a\u0430\u0439\u043c\u0430, \u0431\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043c \u0440\u0430\u0442\u0443\u043d\u043a\u0443 \u0430\u0434 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430. \u0421\u043f\u044f\u0448\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0434\u044b\u0441\u0446\u0456, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u045e \u0456 \u043d\u0435 \u0434\u0430\u0433\u043d\u0430\u045e \u043d\u0430\u0441, \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u0451\u0441 \u043d\u0430\u043c \u0431\u044f\u0434\u044b, \u0456 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0433\u043e\u0440\u0430\u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0430\u0441\u0442\u0440\u044b\u0451\u043c \u043c\u044f\u0447\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0439\u0448\u043e\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0421\u0430\u0434\u043e\u043a, \u0456 \u045e\u0441\u0435 \u043b\u0435\u0432\u0456\u0442\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c, \u044f\u043a\u0456\u044f \u043d\u0430\u0441\u0456\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430 \u0411\u043e\u0433\u0430. \u042f\u043d\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0411\u043e\u0433\u0430, \u0410\u0431\u0456\u044f\u0442\u0430\u0440 \u0436\u0430, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b, \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0456 \u0430\u0436 \u0434\u0430\u0442\u0443\u043b\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0433\u043e\u0440\u0430\u0434\u0430. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u0434\u043e\u043a\u0443: &laquo;\u0410\u0434\u043d\u044f\u0441\u0456 \u043d\u0430\u0437\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433 \u0411\u043e\u0433\u0430 \u045e \u0433\u043e\u0440\u0430\u0434. \u041a\u0430\u043b\u0456 \u044f \u0437\u0434\u0430\u0431\u0443\u0434\u0443 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430, \u0442\u043e \u0401\u043d \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043c\u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0456 \u0437\u043d\u043e\u045e \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0456 \u043c\u0435\u0441\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u044f. \u0410 \u043a\u0430\u043b\u0456 \u0430\u0434\u043c\u043e\u0432\u0456\u0446\u044c \u043c\u043d\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0436, \u0432\u043e\u0441\u044c \u044f, \u043d\u044f\u0445\u0430\u0439 \u0401\u043d \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e, \u0448\u0442\u043e \u042f\u043c\u0443 \u0437\u0430\u045e\u0433\u043e\u0434\u043d\u0430&raquo;. \u041f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0443 \u0421\u0430\u0434\u043e\u043a\u0443: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456, \u0432\u044f\u0440\u043d\u0456\u0441\u044f \u045e \u0433\u043e\u0440\u0430\u0434 \u0437 \u043c\u0456\u0440\u0430\u043c, \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0445\u0456\u043c\u0430\u0430\u0441\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u0401\u043d\u0430\u0442\u0430\u043d\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u0410\u0431\u0456\u044f\u0442\u0430\u0440\u0430, \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u0431\u043e\u0434\u0432\u0443\u043c\u0430 \u0441\u044b\u043d\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456. \u042f \u0436 \u043f\u0430\u0447\u0430\u043a\u0430\u044e \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0434 \u0432\u0430\u0441 \u0432\u0435\u0441\u0442\u043a\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435&raquo;. \u0421\u0430\u0434\u043e\u043a \u0456 \u0410\u0431\u0456\u044f\u0442\u0430\u0440 \u0432\u044f\u0440\u043d\u0443\u043b\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0411\u043e\u0436\u044b \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u043d\u0430 \u0410\u043b\u0456\u045e\u043d\u0443\u044e \u0413\u0430\u0440\u0443, \u0451\u043d \u0456\u0448\u043e\u045e \u0456 \u043f\u043b\u0430\u043a\u0430\u045e. \u0413\u0430\u043b\u0430\u0432\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u0430\u043a\u0440\u044b\u0442\u0430\u044f. \u0401\u043d \u0456\u0448\u043e\u045e \u0431\u043e\u0441\u044b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u043f\u0430\u043a\u0440\u044b\u045e\u0448\u044b \u0433\u0430\u043b\u043e\u0432\u044b \u0441\u0432\u0430\u0435, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0456 \u043f\u043b\u0430\u043a\u0430\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0434\u0430 \u0411\u0430\u0445\u0443\u0440\u044b\u043c\u0430, \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434\u0442\u0443\u043b\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0441\u044f\u043c\u0435\u0439\u0441\u0442\u0432\u0430 \u0434\u043e\u043c\u0443 \u0421\u0430\u045e\u043b\u0430. \u0417\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0421\u044d\u043c\u044d\u0439, \u0441\u044b\u043d \u0413\u0435\u0440\u0430. \u0401\u043d \u0437\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043d\u0430\u043f\u0435\u0440\u0430\u0434 \u0456 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u045e, \u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043a\u0430\u043c\u044f\u043d\u0456 \u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0430, \u0445\u043e\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0456 \u045e\u0441\u0435 \u043c\u0443\u0436\u043d\u044b\u044f \u0432\u043e\u0456\u043d\u044b \u0431\u044b\u043b\u0456 \u0437\u043b\u0435\u0432\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u0430. \u0421\u044d\u043c\u044d\u0439, \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u044f\u0447\u044b, \u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a: &laquo;\u041f\u0440\u044d\u0447, \u043f\u0440\u044d\u0447, \u043a\u0440\u044b\u0432\u0430\u0432\u044b \u043c\u0443\u0436 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041f\u0430\u043d \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u045e \u0442\u0430\u0431\u0435 \u0437\u0430 \u045e\u0441\u044e \u043a\u0440\u043e\u045e \u0434\u043e\u043c\u0443 \u0421\u0430\u045e\u043b\u0430, \u0437\u0430\u043c\u0435\u0441\u0442 \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u043f\u0430\u043d\u0443\u0435\u0448. \u0406 \u0430\u0434\u0434\u0430\u045e \u041f\u0430\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u045e \u0440\u0443\u043a\u0456 \u0441\u044b\u043d\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430. \u0406 \u0432\u043e\u0441\u044c \u0442\u044b \u045e \u0431\u044f\u0434\u0437\u0435, \u0431\u043e \u0442\u044b \u043a\u0440\u044b\u0432\u0430\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a&raquo;. \u0422\u0430\u0434\u044b \u0410\u0431\u0456\u0441\u0430\u0439, \u0441\u044b\u043d \u0426\u044d\u0440\u0443\u044f, \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u0427\u0430\u043c\u0443 \u0433\u044d\u0442\u044b \u0437\u0434\u043e\u0445\u043b\u044b \u0441\u0430\u0431\u0430\u043a\u0430 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e \u0456 \u043a\u0430\u0440\u0430\u043b\u044f? \u041f\u0430\u0439\u0434\u0443 \u0456 \u0430\u0434\u0441\u044f\u043a\u0443 \u044f\u043c\u0443 \u0433\u0430\u043b\u0430\u0432\u0443&raquo;. \u0410\u043b\u0435 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0428\u0442\u043e \u043c\u043d\u0435 \u0456 \u0432\u0430\u043c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u0441\u044b\u043d\u044b \u0426\u044d\u0440\u0443\u044f? \u041a\u0430\u043b\u0456 \u0451\u043d \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u0456 \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u044f\u043c\u0443 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u0414\u0430\u0432\u0456\u0434\u0430, \u0445\u0442\u043e \u0442\u0430\u0434\u044b \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &ldquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u0440\u043e\u0431\u0456\u0448 \u0442\u0430\u043a?&rdquo;&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0410\u0431\u0456\u0441\u0430\u044e \u0456 \u045e\u0441\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c: &laquo;\u0412\u043e\u0441\u044c \u0441\u044b\u043d \u043c\u043e\u0439, \u044f\u043a\u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u043d\u0443\u0442\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u0448\u0443\u043a\u0430\u0435 \u0437\u0433\u0443\u0431\u044b \u043c\u0430\u0451\u0439, \u0430 \u0433\u044d\u0442\u044b \u0441\u044b\u043d \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0456\u0442\u0430 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448. \u041f\u0430\u043a\u0456\u043d\u044c\u0446\u0435 \u044f\u0433\u043e, \u043d\u044f\u0445\u0430\u0439 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c, \u0431\u043e \u0442\u0430\u043a \u044f\u043c\u0443 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d. \u041c\u043e\u0436\u0430 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u041f\u0430\u043d \u043d\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u043c\u0430\u0451 \u0456 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043c\u043d\u0435 \u0434\u0430\u0431\u0440\u043e\u043c \u0437\u0430 \u0433\u044d\u0442\u044b \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d&raquo;. \u0406 \u043f\u0430\u0439\u0448\u043e\u045e \u0414\u0430\u0432\u0456\u0434 \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0434\u0430\u043b\u0435\u0439 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u0430 \u0421\u044d\u043c\u044d\u0439 \u0456\u0448\u043e\u045e \u043f\u043e\u0431\u0430\u0447 \u0437 \u0456\u043c\u0456 \u043f\u0430 \u0441\u0445\u0456\u043b\u0435 \u0433\u0430\u0440\u044b. \u0406\u0434\u0443\u0447\u044b, \u043f\u0440\u0430\u043a\u043b\u0456\u043d\u0430\u045e, \u043a\u0456\u0434\u0430\u045e \u0443 \u0456\u0445\u043d\u0456 \u0431\u043e\u043a \u043a\u0430\u043c\u044f\u043d\u0456 \u0456 \u043f\u0430\u0434\u044b\u043c\u0430\u045e \u043f\u044b\u043b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 41 (40), 10; \u041c\u043a 14, 18b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0432\u0430\u0442 \u0441\u044f\u0431\u0440\u0430 \u043c\u043e\u0439, \u044f\u043a\u043e\u043c\u0443 \u044f \u0432\u0435\u0440\u044b\u045e, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u0435\u045e \u0445\u043b\u0435\u0431 \u043c\u043e\u0439, \u0443\u0437\u043d\u044f\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u043f\u044f\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u0437\u0456\u043d \u0437 \u0432\u0430\u0441, \u044f\u043a\u0456 \u0435\u0441\u0446\u044c \u0441\u0430 \u041c\u043d\u043e\u044e, \u0432\u044b\u0434\u0430\u0441\u0446\u044c \u041c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u0435\u045e \u0445\u043b\u0435\u0431 \u043c\u043e\u0439, \u0443\u0437\u043d\u044f\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u043f\u044f\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"143","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f&nbsp;<span style=\"color: #ff0000;\">18, 6-17. 24 &ndash; 19, 5&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043c\u0435\u0440\u0446\u044c \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430 \u0456 \u0436\u0430\u043b\u043e\u0431\u0430 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0412\u044b\u0439\u0448\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u045e \u043f\u043e\u043b\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u043c, \u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u0431\u0456\u0442\u0432\u0430 \u045e \u043b\u0435\u0441\u0435 \u042d\u0444\u0440\u0430\u0456\u043c\u0430. \u0412\u043e\u0439\u0441\u043a\u0430 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u043c \u0440\u0430\u0437\u0431\u0456\u0442\u0430 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0414\u0430\u0432\u0456\u0434\u0430. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0431\u044b\u043b\u0430 \u0442\u0430\u043c \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0431\u0456\u0442\u0432\u0430, \u0443 \u044f\u043a\u043e\u0439 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0412\u0430\u0439\u043d\u0430 \u0433\u044d\u0442\u0430\u044f \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u045e\u0441\u044e \u043a\u0440\u0430\u0456\u043d\u0443. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0443 \u043b\u0435\u0441\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0440\u043e\u0434\u0443, \u0447\u044b\u043c \u0430\u0434 \u043c\u044f\u0447\u0430 \u045e \u0431\u0456\u0442\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u044f\u043a\u0456 \u0435\u0445\u0430\u045e \u043d\u0430 \u043c\u0443\u043b\u0435, \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u0441\u0443\u0442\u044b\u043a\u043d\u0443\u045e\u0441\u044f \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0414\u0430\u0432\u0456\u0434\u0430. \u041a\u0430\u043b\u0456 \u043c\u0443\u043b \u0443\u0446\u0451\u043a \u043f\u0430\u0434 \u0433\u0430\u043b\u043b\u0451 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0433\u0443\u0441\u0442\u043e\u0433\u0430 \u0434\u0443\u0431\u0430, \u0410\u0431\u0441\u0430\u043b\u043e\u043c \u0437\u0430\u0447\u0430\u043f\u0456\u045e\u0441\u044f \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0437\u0430 \u0434\u0443\u0431 \u0456 \u043f\u0430\u0432\u0456\u0441 \u043f\u0430\u043c\u0456\u0436 \u043d\u0435\u0431\u0430\u043c \u0456 \u0437\u044f\u043c\u043b\u0451\u044e, \u0430 \u043c\u0443\u043b, \u043d\u0430 \u044f\u043a\u0456\u043c \u0441\u044f\u0434\u0437\u0435\u045e, \u043f\u0430\u0431\u0435\u0433 \u0434\u0430\u043b\u0435\u0439. \u0423\u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u0430 \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0430\u0431\u0443: &laquo;\u0411\u0430\u0447\u044b\u045e \u044f \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430, \u044f\u043a\u0456 \u0432\u0456\u0441\u0456\u0446\u044c \u043d\u0430 \u0434\u0443\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u043c\u0443 \u0433\u044d\u0442\u0443\u044e \u0432\u0435\u0441\u0442\u043a\u0443: &laquo;\u041a\u0430\u043b\u0456 \u0442\u044b \u0431\u0430\u0447\u044b\u045e, \u0442\u043e \u0447\u0430\u043c\u0443 \u043d\u0435 \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0442\u0430\u043c? \u042f \u0434\u0430\u045e \u0431\u044b \u0442\u0430\u0431\u0435 \u0437\u0430 \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u043d\u044b\u0445 \u043c\u0430\u043d\u0435\u0442 \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u043e\u044f\u0441&raquo;. \u0422\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0401\u0430\u0431\u0443: &laquo;\u041a\u0430\u043b\u0456 \u0431 \u043d\u0430\u0432\u0430\u0442 \u0434\u0430\u043b\u0456 \u043c\u043d\u0435 \u0442\u044b\u0441\u044f\u0447\u0443 \u0441\u0440\u044d\u0431\u0440\u043d\u044b\u0445 \u043c\u0430\u043d\u0435\u0442, \u0456 \u0442\u0430\u0434\u044b \u044f \u043d\u0435 \u043f\u0430\u0434\u043d\u044f\u045e \u0431\u044b \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u0441\u044b\u043d\u0430. \u041c\u044b \u0447\u0443\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u0443\u0448\u044b, \u044f\u043a \u043a\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0442\u0430\u0431\u0435, \u0410\u0431\u0456\u0448\u0430\u044e \u0456 \u0406\u0442\u0430\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043a\u0430\u0431 \u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0431\u0456\u045e \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430!&rdquo; \u041a\u0430\u043b\u0456 \u0431 \u044f \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0447\u0443\u045e, \u0442\u043e \u043a\u0430\u0440\u043e\u043b\u044c \u0432\u044b\u043a\u0440\u044b\u045e \u0431\u044b \u043c\u044f\u043d\u0435, \u0431\u043e \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u045e\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c. \u0410 \u0442\u044b \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u0431 \u0430\u0434 \u043c\u044f\u043d\u0435&raquo;. \u0401\u0430\u0431 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e&raquo;. \u0417\u0430\u0442\u044b\u043c \u0443\u0437\u044f\u045e \u0401\u0430\u0431 \u0443 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u0442\u0440\u044b \u0434\u0437\u0456\u0434\u044b \u0456 \u045e\u0441\u0430\u0434\u0437\u0456\u045e \u0456\u0445 \u0443 \u0441\u044d\u0440\u0446\u0430 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430, \u044f\u043a\u0456 \u0432\u0456\u0441\u0435\u045e \u0441\u044f\u0440\u043e\u0434 \u0433\u0430\u043b\u043b\u044f \u0434\u0443\u0431\u0443 \u0456 \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u0436\u044b\u0432\u044b. \u041f\u0430\u0441\u043b\u044f \u0430\u0431\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0445\u043b\u043e\u043f\u0446\u0430\u045e, \u0437\u0431\u0440\u0430\u044f\u043d\u043e\u0441\u0446\u0430\u045e \u0401\u0430\u0431\u0430, \u0456 \u0434\u0430\u0431\u0456\u043b\u0456 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0401\u0430\u0431 \u0443 \u0440\u043e\u0433, \u0456 \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0432\u043e\u0439\u0441\u043a\u0430 \u0437 \u043f\u0430\u0433\u043e\u043d\u0456 \u0437\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u0431\u043e \u0401\u0430\u045e \u0441\u043f\u044b\u043d\u0456\u045e \u044f\u0433\u043e. \u0417\u0430\u0442\u044b\u043c \u0443\u0437\u044f\u043b\u0456 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430 \u0456 \u045e\u043a\u0456\u043d\u0443\u043b\u0456 \u044f\u0433\u043e \u045e \u043b\u0435\u0441\u0435 \u045e \u0433\u043b\u044b\u0431\u043e\u043a\u0443\u044e \u044f\u043c\u0443. \u041d\u0430\u0441\u044b\u043f\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0456 \u043a\u0443\u0440\u0433\u0430\u043d \u0437 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0430 \u045e\u0441\u0435 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u0440\u0430\u0437\u0431\u0435\u0433\u043b\u0456\u0441\u044f, \u043a\u043e\u0436\u043d\u044b \u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u043c\u0451\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c \u0447\u0430\u0441\u0430\u043c \u0414\u0430\u0432\u0456\u0434 \u0441\u044f\u0434\u0437\u0435\u045e \u043f\u0430\u043c\u0456\u0436 \u0434\u0437\u0432\u044e\u043c\u0430 \u0431\u0440\u0430\u043c\u0430\u043c\u0456. \u0410 \u0441\u0442\u0440\u0430\u0436\u043d\u0456\u043a \u0445\u0430\u0434\u0437\u0456\u045e \u043f\u0430 \u0442\u044d\u0440\u0430\u0441\u0435 \u0431\u0440\u0430\u043c\u044b \u043d\u0430\u0434 \u043c\u0443\u0440\u0430\u043c. \u0423\u0437\u043d\u044f\u045e\u0448\u044b \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435, \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0431\u044f\u0436\u044b\u0446\u044c \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0421\u0442\u0440\u0430\u0436\u043d\u0456\u043a \u043a\u0440\u044b\u043a\u043d\u0443\u045e \u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u045e \u043a\u0430\u0440\u0430\u043b\u044e. \u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0451\u043d \u0430\u0434\u0437\u0456\u043d, \u0442\u043e \u043d\u044f\u0441\u0435 \u0434\u043e\u0431\u0440\u0443\u044e \u0432\u0435\u0441\u0442\u043a\u0443&raquo;. \u041a\u0430\u043b\u0456 \u0442\u043e\u0439 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u045e\u0441\u044f \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448, \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0443\u0431\u0430\u0447\u044b\u045e \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0431\u0435\u0433. \u0412\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u043a\u0440\u044b\u043a\u043d\u0443\u045e \u0431\u0440\u0430\u043c\u043d\u0456\u043a\u0443: &laquo;\u042f\u0448\u0447\u044d \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u044f\u0436\u044b\u0446\u044c&raquo;. \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406 \u0433\u044d\u0442\u044b \u043d\u044f\u0441\u0435 \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443&raquo;. \u0422\u0430\u0434\u044b \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0431\u0430\u0447\u0443 \u043f\u0430\u0445\u043e\u0434\u043a\u0443 \u043f\u0435\u0440\u0448\u0430\u0433\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0443\u044e \u043d\u0430 \u043f\u0430\u0445\u043e\u0434\u043a\u0443 \u0410\u0445\u0456\u043c\u0430\u0430\u0441\u0430, \u0441\u044b\u043d\u0430 \u0421\u0430\u0434\u043e\u043a\u0430&raquo;. \u041a\u0430\u0440\u043e\u043b\u044c \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0434\u043e\u0431\u0440\u044b, \u0442\u0430\u043c\u0443 \u0456\u0434\u0437\u0435 \u0437 \u0434\u043e\u0431\u0440\u0430\u044e \u0432\u0435\u0441\u0442\u043a\u0430\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445\u0456\u043c\u0430\u0430\u0441 \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u0421\u043f\u0430\u043a\u043e\u0439!&raquo; \u0417\u0430\u0442\u044b\u043c \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u043a\u0430\u0440\u0430\u043b\u044e \u0434\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043b\u044e\u0434\u0437\u0435\u0439, \u0448\u0442\u043e \u043f\u0430\u0434\u043d\u044f\u043b\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043d\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f!&raquo; \u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: &laquo;\u0426\u0456 \u0434\u043e\u0431\u0440\u0430 \u045e\u0441\u0451 \u0437 \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430\u043c?&raquo; \u0410\u0445\u0456\u043c\u0430\u0430\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0431\u0430\u0447\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u0401\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u043b\u0443\u0433\u0443 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043c\u044f\u043d\u0435, \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u044f\u0433\u043e \u043f\u0440\u044b\u0447\u044b\u043d\u044b&raquo;. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0410\u0434\u044b\u0434\u0437\u0456 \u043d\u0430 \u0431\u043e\u043a \u0456 \u0441\u0442\u0430\u043d\u044c \u0442\u0443\u0442&raquo;. \u0422\u043e\u0439 \u0430\u0434\u044b\u0448\u043e\u045e \u0456 \u0441\u0442\u0430\u045e. \u0422\u0430\u0434\u044b \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u041a\u0443\u0448\u044b\u0442\u0430 \u0456, \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u044b\u043d\u043e\u0448\u0443, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043c\u043e\u0439, \u0431\u043e \u0441\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u045e \u043d\u0430 \u0442\u0432\u0430\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0448\u044b \u0446\u044f\u0431\u0435 \u0430\u0434 \u0440\u0443\u043a \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u0432\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435&raquo;. \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u041a\u0443\u0448\u044b\u0442\u044b: &laquo;\u0426\u0456 \u0434\u043e\u0431\u0440\u0430 \u045e\u0441\u0451 \u0437 \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0430\u043c?&raquo; \u041a\u0443\u0448\u044b\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u045e \u0430\u0434\u043a\u0430\u0437: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0437 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e \u0456 \u043a\u0430\u0440\u0430\u043b\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u0431\u0443\u0434\u0437\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u0448\u0442\u043e \u0456 \u0437 \u044e\u043d\u0430\u043a\u043e\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u0442\u0440\u044b\u043c\u0446\u0435\u045e \u0456, \u043f\u0430\u0434\u043d\u044f\u045e\u0448\u044b\u0441\u044f \u045e \u043f\u0430\u043a\u043e\u0439 \u043d\u0430\u0434 \u0431\u0440\u0430\u043c\u0430\u0439, \u0437\u0430\u043f\u043b\u0430\u043a\u0430\u045e. \u0410 \u043a\u0430\u043b\u0456 \u0456\u0448\u043e\u045e, \u0442\u0430\u043a \u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u044b\u043d\u0435 \u043c\u043e\u0439, \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439, \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439. \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u044f \u043f\u0430\u043c\u0451\u0440 \u0437\u0430\u043c\u0435\u0441\u0442 \u0446\u044f\u0431\u0435. \u0421\u044b\u043d\u0435 \u043c\u043e\u0439, \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0401\u0430\u0431\u0443: &laquo;\u041a\u0430\u0440\u043e\u043b\u044c \u0433\u0430\u043b\u043e\u0441\u0456\u0446\u044c \u0456 \u043f\u043b\u0430\u0447\u0430 \u043f\u0430 \u0410\u0431\u0441\u0430\u043b\u043e\u043c\u0443&raquo;. \u0406 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u0430\u0431\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u0436\u0430\u043b\u043e\u0431\u0443 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. \u0411\u043e \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0447\u0443\u045e \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041a\u0430\u0440\u043e\u043b\u044c \u043f\u043b\u0430\u0447\u0430 \u043f\u0430 \u0441\u0432\u0430\u0456\u043c \u0441\u044b\u043d\u0435&raquo;. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0432\u043e\u0439\u0441\u043a\u0430 \u045e\u043f\u043e\u0442\u0430\u0439 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u045e \u0433\u043e\u0440\u0430\u0434, \u044f\u043a \u043a\u0440\u0430\u0434\u0437\u0435\u0446\u0446\u0430 \u043d\u0430\u0440\u043e\u0434, \u0448\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0433\u0430\u043d\u044c\u0431\u0443, \u0431\u043e \u045e\u0446\u0451\u043a \u0443 \u0447\u0430\u0441 \u0431\u0456\u0442\u0432\u044b. \u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u043a\u0440\u044b\u045e \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439 \u0456 \u0433\u043e\u043b\u0430\u0441\u043d\u0430 \u043a\u0440\u044b\u0447\u0430\u045e: &laquo;\u0421\u044b\u043d\u0435 \u043c\u043e\u0439 \u0410\u0431\u0441\u0430\u043b\u043e\u043c! \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439!&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 55 (54), 13\u0430. 14\u0430. 15\u0430; 2 \u0421\u0430\u043c 19, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0432\u043e\u0440\u0430\u0433 \u043c\u044f\u043d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435, \u044f \u0433\u044d\u0442\u0430 \u0431 \u0441\u0446\u044f\u0440\u043f\u0435\u045e, \u0430\u043b\u0435 \u0433\u044d\u0442\u0430 \u0442\u044b, \u0440\u043e\u045e\u043d\u044b \u043c\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, <span style=\"color: #ff0000;\">*<\/span> \u043c\u043e\u0439 \u0441\u044f\u0431\u0440\u0430 \u0456 \u043c\u043e\u0439 \u0431\u043b\u0456\u0437\u043a\u0456, \u0437 \u044f\u043a\u0456\u043c \u043c\u044b \u0432\u044f\u043b\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u044f \u0440\u0430\u0437\u043c\u043e\u0432\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u0442\u0440\u044b\u043c\u0446\u0435\u045e \u0456, \u043f\u0430\u0434\u043d\u044f\u045e\u0448\u044b\u0441\u044f \u045e \u043f\u0430\u043a\u043e\u0439 \u043d\u0430\u0434 \u0431\u0440\u0430\u043c\u0430\u0439, \u0437\u0430\u043f\u043b\u0430\u043a\u0430\u045e. \u0410 \u043a\u0430\u043b\u0456 \u0456\u0448\u043e\u045e, \u0442\u0430\u043a \u043a\u0430\u0437\u0430\u045e: \u0421\u044b\u043d\u0435 \u043c\u043e\u0439, \u0410\u0431\u0441\u0430\u043b\u043e\u043c, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439!<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u043e\u0439 \u0441\u044f\u0431\u0440\u0430 \u0456 \u043c\u043e\u0439 \u0431\u043b\u0456\u0437\u043a\u0456, \u0437 \u044f\u043a\u0456\u043c \u043c\u044b \u0432\u044f\u043b\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u044f \u0440\u0430\u0437\u043c\u043e\u0432\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"144","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0421\u0430\u043c\u0443\u044d\u043b\u044f<span style=\"color: #ff0000;\">&nbsp;24, 1-4. 10-18. 24b-25<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u043f\u0456\u0441 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0431\u0443\u0434\u043e\u0432\u0430 \u0430\u043b\u0442\u0430\u0440\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0417\u043d\u043e\u045e \u041f\u0430\u043d \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e. \u0401\u043d \u043d\u0430\u0441\u0442\u0440\u043e\u0456\u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u043f\u0430\u043b\u0456\u0447\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042e\u0434\u0443&raquo;. \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0430\u0431\u0443, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0443 \u0432\u043e\u0439\u0441\u043a\u0430, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0437 \u0456\u043c: &laquo;\u041f\u0440\u0430\u0439\u0434\u0437\u0456, \u043f\u0440\u0430\u0448\u0443, \u0443\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0434 \u0414\u0430\u043d\u0430 \u0434\u0430 \u0411\u044d\u044d\u0440 \u0428\u044d\u0431\u044b \u0456 \u043f\u0430\u043b\u0456\u0447\u044b \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u0446\u044c \u043c\u043d\u0435 \u044f\u0433\u043e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c&raquo;. \u0401\u0430\u0431 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e \u0451\u0441\u0446\u044c, \u0456 \u044f\u0448\u0447\u044d \u045e \u0441\u0442\u043e \u0440\u0430\u0437\u043e\u045e \u0431\u043e\u043b\u044c\u0448, \u0430 \u0432\u043e\u0447\u044b \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c. \u0410\u043b\u0435 \u0447\u0430\u043c\u0443 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0433\u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430?&raquo; \u0406 \u0441\u043b\u043e\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0436\u044b\u043b\u0430 \u0441\u043b\u043e\u0432\u0430 \u0401\u0430\u0431\u0430 \u0456 \u0432\u0430\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e. \u0422\u0430\u043c\u0443 \u0432\u044b\u0439\u0448\u0430\u045e \u0401\u0430\u0431 \u0437 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0432\u043e\u0439\u0441\u043a\u0430 \u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f, \u043a\u0430\u0431 \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u044d\u0440\u0446\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0451\u043d \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043d\u0430\u0440\u043e\u0434. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u041f\u0430\u043d\u0443: &laquo;\u0412\u0435\u043b\u044c\u043c\u0456 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u044f, \u043a\u0430\u043b\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440, \u041f\u0430\u043d\u0435, \u0434\u0430\u0440\u0443\u0439 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0456, \u0431\u043e \u044f \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430&raquo;. \u041d\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0440\u0430\u043d\u0456\u0446\u0430\u0439, \u043a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0442\u0430\u045e, \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0441\u043b\u043e\u0432\u0430 \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0413\u0430\u0434, \u043f\u0440\u0430\u0437\u043e\u0440\u0446\u044b \u0414\u0430\u0432\u0456\u0434\u0430: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0441\u043a\u0430\u0436\u044b \u0414\u0430\u0432\u0456\u0434\u0443, \u0448\u0442\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &ldquo;\u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0442\u0440\u044b \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456. \u0412\u044b\u0431\u0435\u0440\u044b \u0441\u0430\u0431\u0435 \u0430\u0434\u043d\u0443 \u0437 \u0456\u0445, \u0456 \u042f \u0442\u0430\u043a \u0443\u0447\u044b\u043d\u044e \u0442\u0430\u0431\u0435&rdquo;&raquo;. \u0413\u0430\u0434 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u044f\u043c\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u0431\u043e \u043d\u0430 \u0441\u0435\u043c \u0433\u0430\u0434\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0442\u0432\u0430\u044e \u0433\u043e\u043b\u0430\u0434, \u0430\u0431\u043e \u0442\u0440\u044b \u043c\u0435\u0441\u044f\u0446\u044b \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0443\u0446\u044f\u043a\u0430\u0446\u044c \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0430\u0431\u043e \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u0442\u0440\u044b \u0434\u043d\u0456 \u0431\u044b\u043b\u0430 \u043f\u043e\u0448\u0430\u0441\u0446\u044c \u043d\u0430 \u0442\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456? \u041f\u0430\u0434\u0443\u043c\u0430\u0439 \u0456 \u0432\u044b\u0440\u0430\u0448\u044b, \u0448\u0442\u043e \u043c\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435&raquo;. \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0413\u0430\u0434\u0443: &laquo;\u041c\u043d\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0446\u044f\u0436\u043a\u0430. \u0410\u043b\u0435 \u043b\u0435\u043f\u0448 \u043c\u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u0440\u0443\u043a\u0456 \u041f\u0430\u043d\u0430, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e, \u0447\u044b\u043c \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u0440\u0443\u043a\u0456 \u043b\u044e\u0434\u0437\u0435\u0439!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u043e\u0448\u0430\u0441\u0446\u044c \u043d\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0430\u0434 \u0440\u0430\u043d\u0456\u0446\u044b \u0434\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0433\u0430 \u0447\u0430\u0441\u0443. \u0406 \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0434 \u0414\u0430\u043d\u0430 \u0434\u0430 \u0411\u044d\u044d\u0440 \u0428\u044d\u0431\u044b \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0442\u044b\u0441\u044f\u0447 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041a\u0430\u043b\u0456 \u0430\u043d\u0451\u043b \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u043d\u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u044f\u0433\u043e, \u041f\u0430\u043d \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0431\u044f\u0434\u043e\u044e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0430\u043d\u0451\u043b\u0443, \u044f\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u045e \u043b\u044e\u0434\u0437\u0435\u0439: &laquo;\u0425\u043e\u043f\u0456\u0446\u044c, \u0441\u0442\u0440\u044b\u043c\u0430\u0439 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0431\u044b\u045e \u0442\u0430\u0434\u044b \u043a\u0430\u043b\u044f \u0433\u0443\u043c\u043d\u0430 \u0410\u0440\u0430\u045e\u043d\u0430 \u0415\u0431\u0443\u0441\u044d\u044f. \u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0443\u0431\u0430\u0447\u044b\u045e \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u045e \u043d\u0430\u0440\u043e\u0434, \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443: &laquo;\u0413\u044d\u0442\u0430 \u044f \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u044f \u045e\u0447\u044b\u043d\u0456\u045e \u0437\u043b\u043e, \u0430 \u0433\u044d\u0442\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456? \u041d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u044f \u0440\u0443\u043a\u0430 \u0437\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u043e\u043c\u0443 \u0430\u0439\u0446\u0430 \u043c\u0430\u0439\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0413\u0430\u0434 \u0434\u0430 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0406\u0434\u0437\u0456, \u043f\u0430\u0431\u0443\u0434\u0443\u0439 \u0430\u043b\u0442\u0430\u0440 \u041f\u0430\u043d\u0443 \u043d\u0430 \u0433\u0443\u043c\u043d\u0435 \u0410\u0440\u0430\u045e\u043d\u0430 \u0415\u0431\u0443\u0441\u044d\u044f.&nbsp;\u0414\u0430\u0432\u0456\u0434 \u043a\u0443\u043f\u0456\u045e \u0433\u0443\u043c\u043d\u043e \u0456 \u0432\u0430\u043b\u043e\u045e \u0437\u0430 \u043f\u044f\u0446\u044c\u0434\u0437\u044f\u0441\u044f\u0442 \u0441\u0456\u043a\u043b\u044f\u045e \u0441\u0440\u044d\u0431\u0440\u0430. \u0422\u0430\u043c \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0430\u043b\u0442\u0430\u0440 \u041f\u0430\u043d\u0443 \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u043c\u0456\u0440\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u043a\u0440\u0430\u0435\u043c \u0456 \u0441\u043f\u044b\u043d\u0456\u045e \u043f\u043e\u0448\u0430\u0441\u0446\u044c \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041a\u0440 21, 15; \u043f\u0430\u0440. 2 \u0421\u0430\u043c 24, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0441\u0432\u043e\u0439 \u0456 \u0441\u043a\u0430\u0436\u044b \u0430\u043d\u0451\u043b\u0443, \u044f\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0435: <span style=\"color: #ff0000;\">*<\/span> \u0421\u0442\u0440\u044b\u043c\u0430\u0439 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0437\u044f\u043c\u043b\u044f \u0437 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u044f \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u044f \u045e\u0447\u044b\u043d\u0456\u045e \u0437\u043b\u043e, \u0430 \u0433\u044d\u0442\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456? \u041d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u044f \u0440\u0443\u043a\u0430 \u0437\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u043e\u043c\u0443 \u0430\u0439\u0446\u0430 \u043c\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0442\u0440\u044b\u043c\u0430\u0439 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0437\u044f\u043c\u043b\u044f \u0437 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"145","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041a\u0440\u043e\u043d\u0456\u043a\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">22, 5-19<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u0431\u0443\u0434\u043e\u0432\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u043e\u0439 \u0441\u044b\u043d \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u043c\u0430\u043b\u0430\u0434\u044b \u0456 \u043d\u0435 \u043c\u0430\u0435 \u0434\u043e\u0441\u0432\u0435\u0434\u0443, \u0430 \u0434\u043e\u043c, \u044f\u043a\u0456 \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0432\u0435\u043b\u0456\u0447\u043d\u044b\u043c \u0456 \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u043a\u0440\u0430\u0456\u043d\u0430\u0445. \u0422\u0430\u043c\u0443 \u044f \u0431\u0443\u0434\u0443 \u0440\u0430\u0431\u0456\u0446\u044c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u043a\u0443 \u0434\u043b\u044f \u044f\u0433\u043e&raquo;. \u0406 \u0448\u043c\u0430\u0442 \u043d\u0430\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430, \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0434\u043e\u043c \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0414\u0430\u0432\u0456\u0434 \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0443, \u0441\u0432\u0430\u0439\u043c\u0443 \u0441\u044b\u043d\u0443: &laquo;\u0421\u044b\u043d\u0435 \u043c\u043e\u0439, \u0443 \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0431\u044b\u043b\u0430 \u0437\u0430\u0434\u0443\u043c\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0434\u043e\u043c \u0434\u043b\u044f \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u0422\u044b \u043f\u0440\u0430\u043b\u0456\u045e \u0448\u043c\u0430\u0442 \u043a\u0440\u044b\u0432\u0456 \u0456 \u0432\u0451\u045e \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0439\u043d\u044b, \u0442\u0430\u043c\u0443 \u043d\u0435 \u0442\u044b \u043f\u0430\u0431\u0443\u0434\u0443\u0435\u0448 \u0434\u043e\u043c \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u043c\u0443, \u0431\u043e \u0442\u044b \u043f\u0440\u0430\u043b\u0456\u045e \u0448\u043c\u0430\u0442 \u043a\u0440\u044b\u0432\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c. \u0423 \u0446\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u044b\u043d. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u044e, \u0442\u0430\u043c\u0443 \u042f \u0434\u0430\u043c \u044f\u043c\u0443 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u0430\u043a\u043e\u043b. \u0406\u043c\u044f \u044f\u043c\u0443 \u0431\u0443\u0434\u0437\u0435 \u0421\u0430\u043b\u0430\u043c\u043e\u043d. \u0421\u043f\u0430\u043a\u043e\u0439 \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u042f \u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044e \u045e \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f. \u0401\u043d \u043f\u0430\u0431\u0443\u0434\u0443\u0435 \u0434\u043e\u043c \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u043c\u0443, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0441\u044b\u043d\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u044f\u043c\u0443 \u0431\u0430\u0446\u044c\u043a\u0430\u043c. \u0422\u0440\u043e\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u044f\u0433\u043e \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u042f \u045e\u043c\u0430\u0446\u0443\u044e \u043d\u0430\u0432\u0435\u043a\u0456&rdquo;. \u0426\u044f\u043f\u0435\u0440, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439, \u043d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0430\u0431 \u0442\u0430\u0431\u0435 \u0448\u0447\u0430\u0441\u0446\u0456\u043b\u0430 \u0456 \u043a\u0430\u0431 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0442\u044b \u0434\u043e\u043c \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443, \u044f\u043a \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435. \u041d\u044f\u0445\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u041f\u0430\u043d \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u0440\u0430\u0437\u0432\u0430\u0433\u0430\u044e \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u043a\u0430\u0431 \u0442\u044b \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u045e \u0417\u0430\u043a\u043e\u043d \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u0422\u0430\u0434\u044b \u043f\u0430\u0448\u0447\u0430\u0441\u0446\u0456\u0446\u044c \u0442\u0430\u0431\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0456\u043b\u044c\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0434\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u041f\u0430\u043d \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f. \u0411\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0441\u044f. \u0412\u043e\u0441\u044c, \u044f \u045e \u0431\u044f\u0434\u0437\u0435 \u043c\u0430\u0451\u0439 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u0441\u0442\u043e \u0442\u044b\u0441\u044f\u0447 \u0442\u0430\u043b\u0430\u043d\u0442\u0430\u045e \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u043c\u0456\u043b\u044c\u0451\u043d \u0442\u0430\u043b\u0430\u043d\u0442\u0430\u045e \u0441\u0440\u044d\u0431\u0440\u0430, \u0430 \u043c\u0435\u0434\u0437\u0456 \u0456 \u0436\u0430\u043b\u0435\u0437\u0430 \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0432\u0430\u0436\u044b\u0446\u044c. \u041d\u0430\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u0440\u044d\u0432\u0430 \u0456 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0430 \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0434\u0430\u0434\u0430\u0446\u044c \u0434\u0430 \u0456\u0445. \u0423 \u0446\u044f\u0431\u0435 \u0451\u0441\u0446\u044c \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u043e\u045e: \u043a\u0430\u043c\u0435\u043d\u044f\u0447\u043e\u0441\u0430\u045e, \u0440\u0430\u0437\u044c\u0431\u044f\u0440\u043e\u045e \u0456 \u0446\u0435\u0441\u043b\u044f\u0440\u043e\u045e, \u0456 \u045e\u0441\u0456\u0445 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u0445 \u0434\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b. \u0417\u043e\u043b\u0430\u0442\u0443, \u0441\u0440\u044d\u0431\u0440\u0443, \u043c\u0435\u0434\u0437\u0456 \u0456 \u0436\u0430\u043b\u0435\u0437\u0443 \u043d\u044f\u043c\u0430 \u043b\u0456\u043a\u0443. \u0423\u0441\u0442\u0430\u043d\u044c \u0456 \u0440\u0430\u0431\u0456, \u0430 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0443\u0441\u0456\u043c \u043a\u043d\u044f\u0437\u044f\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0443, \u0441\u0432\u0430\u0439\u043c\u0443 \u0441\u044b\u043d\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0426\u0456 \u0436 \u043d\u0435 \u0437 \u0432\u0430\u043c\u0456 \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448, \u044f\u043a\u0456 \u0430\u0442\u0430\u0447\u044b\u045e \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0431\u043e \u0432\u044b\u0434\u0430\u045e \u0443 \u0440\u0443\u043a\u0456 \u043c\u0430\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0441\u043a\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c? \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0441\u0445\u0456\u043b\u0456\u0446\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0448\u0443\u043a\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430. \u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0456 \u043f\u0430\u0431\u0443\u0434\u0443\u0439\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0446\u0456 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0441\u0432\u044f\u0442\u044b \u043f\u043e\u0441\u0443\u0434 \u0411\u043e\u0436\u044b \u045e \u0434\u043e\u043c, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0440 22, 19; \u041f\u0441 132 (131), 7; \u0406\u0441 56, 7\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0434\u0430\u0439\u0446\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u045e\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u042f\u0433\u043e \u0436\u044b\u043b\u043b\u0451, \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u043c\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430\u043c \u043d\u043e\u0433 \u042f\u0433\u043e\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u0414\u043e\u043c \u041c\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0434\u043e\u043c\u0430\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u042f\u0433\u043e \u0436\u044b\u043b\u043b\u0451, \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u043c\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430\u043c \u043d\u043e\u0433 \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"146","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 11-35; 2, 10-12<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0435 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043f\u0435\u0440\u0430\u0435\u043c\u043d\u0456\u043a\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041d\u0430\u0442\u0430\u043d \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0411\u044d\u0442\u0448\u044d\u0431\u044b, \u043c\u0430\u0446\u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430: &laquo;\u0426\u0456 \u0447\u0443\u043b\u0430 \u0442\u044b, \u0448\u0442\u043e \u0410\u0434\u043e\u043d\u0456\u0439, \u0441\u044b\u043d \u0425\u0430\u0433\u0456\u0442\u044b, \u0441\u0442\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0430 \u043d\u0430\u0448 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0414\u0430\u0432\u0456\u0434 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430? \u0410 \u0446\u044f\u043f\u0435\u0440 \u0445\u0430\u0434\u0437\u0456, \u044f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u043f\u0430\u0440\u0430\u0434\u0443, \u043a\u0430\u0431 \u0442\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430. \u041f\u0430\u0439\u0434\u0437\u0456 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0441\u043a\u0430\u0436\u044b \u044f\u043c\u0443: \u0426\u0456 \u043d\u0435 \u0442\u044b, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c, \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u0441\u043b\u0443\u0437\u0435 \u0442\u0432\u0430\u0451\u0439, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0421\u044b\u043d \u0442\u0432\u043e\u0439 \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u043f\u0430\u0441\u043b\u044f \u043c\u044f\u043d\u0435, \u0451\u043d \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u043c\u0430\u0456\u043c? \u0427\u0430\u043c\u0443 \u0436 \u043f\u0430\u0447\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0410\u0434\u043e\u043d\u0456\u0439?&rdquo; \u041a\u0430\u043b\u0456 \u0442\u044b \u044f\u0448\u0447\u044d \u0431\u0443\u0434\u0437\u0435\u0448 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0443\u0432\u0430\u0439\u0434\u0443 \u0456 \u044f \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0442\u0430\u0431\u043e\u044e \u0456 \u0434\u0430\u043f\u043e\u045e\u043d\u044e \u0441\u043b\u043e\u0432\u044b \u0442\u0432\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044d\u0442\u0448\u044d\u0431\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u045e \u0441\u043f\u0430\u043b\u044c\u043d\u044e. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0431\u044b\u045e \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u0442\u0430\u0440\u044b, \u0410\u0431\u0456\u0448\u0430\u0433\u0430 \u0428\u0443\u043d\u044d\u043c\u0456\u0442\u043a\u0430 \u043f\u0440\u044b\u0441\u043b\u0443\u0436\u0432\u0430\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u044e. \u0411\u044d\u0442\u0448\u044d\u0431\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u043a\u0430\u0440\u0430\u043b\u044e \u0430\u0436 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456. \u041a\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u043f\u044b\u0442\u0430\u045e\u0441\u044f: &laquo;\u0428\u0442\u043e \u0445\u043e\u0447\u0430\u0448?&raquo; \u042f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443: &laquo;\u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u0442\u044b \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u0441\u043b\u0443\u0437\u0435 \u0442\u0432\u0430\u0451\u0439 \u041f\u0430\u043d\u0430\u043c \u0411\u043e\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c: &ldquo;\u0421\u044b\u043d \u0442\u0432\u043e\u0439 \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u043f\u0430\u0441\u043b\u044f \u043c\u044f\u043d\u0435, \u0451\u043d \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u043c\u0430\u0456\u043c&rdquo;. \u0410 \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0410\u0434\u043e\u043d\u0456\u0439, \u0456 \u0442\u044b, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c, \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0401\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u0430\u043b\u043e\u045e \u0456 \u0442\u043b\u0443\u0441\u0442\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0443\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0410\u0431\u0456\u044f\u0442\u0430\u0440\u0430 \u0456 \u0401\u0430\u0431\u0430, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u0432\u043e\u0439\u0441\u043a\u0430, \u0430 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430, \u0441\u043b\u0443\u0433\u0443 \u0442\u0432\u0430\u0439\u0433\u043e, \u043d\u0435 \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u045e. \u0426\u044f\u043f\u0435\u0440, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c, \u0432\u043e\u0447\u044b \u045e\u0441\u0456\u0445 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u043d\u0430 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0456\u043c, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c, \u0441\u043f\u0430\u0447\u043d\u0435 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u043e\u0434\u043a\u0430\u043c\u0456, \u0443\u043f\u0430\u0434\u0437\u0435 \u0432\u0456\u043d\u0430 \u043d\u0430 \u043c\u044f\u043d\u0435 \u0456 \u043d\u0430 \u0441\u044b\u043d\u0430 \u043c\u0430\u0439\u0433\u043e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u0430 \u044f\u0448\u0447\u044d \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430 \u0437 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u043a \u041d\u0430\u0442\u0430\u043d. \u0406 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044e: &laquo;\u0412\u043e\u0441\u044c, \u043f\u0440\u0430\u0440\u043e\u043a \u041d\u0430\u0442\u0430\u043d&raquo;. \u0422\u0430\u0434\u044b \u0451\u043d \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u044f\u043c\u0443 \u0442\u0432\u0430\u0440\u0430\u043c \u0434\u0430 \u0437\u044f\u043c\u043b\u0456. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u041d\u0430\u0442\u0430\u043d: &laquo;\u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u043a\u0430\u0440\u0430\u043b\u044e, \u043d\u044f\u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u044b: &ldquo;\u0410\u0434\u043e\u043d\u0456\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u043c\u044f\u043d\u0435, \u0451\u043d \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u043c\u0430\u0456\u043c&rdquo;? \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u0451\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0432\u0430\u043b\u043e\u045e \u0456 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0442\u043b\u0443\u0441\u0442\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0443\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0432\u043e\u0439\u0441\u043a\u0430 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0410\u0431\u0456\u044f\u0442\u0430\u0440\u0430. \u0426\u044f\u043f\u0435\u0440 \u044f\u043d\u044b \u044f\u0434\u0443\u0446\u044c \u0456 \u043f&rsquo;\u044e\u0446\u044c \u0443 \u044f\u0433\u043e \u0456 \u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u043a\u0430\u0440\u043e\u043b\u044c \u0410\u0434\u043e\u043d\u0456\u0439!&rdquo; \u041c\u044f\u043d\u0435 \u0436, \u0441\u043b\u0443\u0433\u0443 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0421\u0430\u0434\u043e\u043a\u0430, \u0456 \u0411\u044d\u043d\u0430\u044e, \u0441\u044b\u043d\u0430 \u0401\u044f\u0434\u0430, \u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430, \u0441\u043b\u0443\u0433\u0443 \u0442\u0432\u0430\u0439\u0433\u043e, \u043d\u0435 \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u045e. \u041c\u043e\u0436\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430 \u043f\u0430 \u0432\u043e\u043b\u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f, \u0430 \u0442\u044b \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u043b\u0443\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u043c\u0430\u0439\u0433\u043e, \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043a\u043b\u0456\u0447\u0446\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0411\u044d\u0442\u0448\u044d\u0431\u0443&raquo;. \u042f\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0456 \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u0451\u043c. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456! \u042f\u043a \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u044f \u0442\u0430\u0431\u0435 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0421\u044b\u043d \u0442\u0432\u043e\u0439 \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u043f\u0430\u0441\u043b\u044f \u043c\u044f\u043d\u0435, \u0451\u043d \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u043c\u0430\u0456\u043c \u0437\u0430\u043c\u0435\u0441\u0442 \u043c\u044f\u043d\u0435&rdquo;, \u0442\u0430\u043a \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0441\u0451\u043d\u043d\u044f&raquo;. \u0411\u044d\u0442\u0448\u044d\u0431\u0430 \u043d\u0456\u0437\u043a\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u043a\u0430\u0440\u0430\u043b\u044e \u0442\u0432\u0430\u0440\u0430\u043c \u0434\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043c\u043e\u0439, \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434, \u0432\u0435\u0447\u043d\u0430!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043a\u043b\u0456\u0447\u0446\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0421\u0430\u0434\u043e\u043a\u0430, \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041d\u0430\u0442\u0430\u043d\u0430 \u0456 \u0411\u044d\u043d\u0430\u044f, \u0441\u044b\u043d\u0430 \u0401\u044f\u0434\u0430&raquo;. \u0406 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f. \u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u043b\u0443\u0433 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0432\u0430\u0448\u0430\u0433\u0430 \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0446\u0435 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430, \u0441\u044b\u043d\u0430 \u043c\u0430\u0439\u0433\u043e, \u043d\u0430 \u043c\u0430\u0439\u0433\u043e \u043c\u0443\u043b\u0430 \u0456 \u0437\u0430\u0432\u044f\u0434\u0437\u0456\u0446\u0435 \u044f\u0433\u043e \u045e \u0413\u0456\u0445\u043e\u043d. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440 \u0421\u0430\u0434\u043e\u043a \u0456 \u043f\u0440\u0430\u0440\u043e\u043a \u041d\u0430\u0442\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u044f\u0446\u044c \u044f\u0433\u043e \u0442\u0430\u043c \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0417\u0430\u0442\u044b\u043c \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u0446\u0435 \u045e \u0440\u043e\u0433 \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u0435: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u043a\u0430\u0440\u043e\u043b\u044c \u0421\u0430\u043b\u0430\u043c\u043e\u043d!&rdquo; \u041f\u043e\u0442\u044b\u043c \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456\u0446\u0435 \u044f\u0433\u043e, \u043a\u0430\u0431 \u0451\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u0441\u0435\u045e \u043d\u0430 \u043c\u043e\u0439 \u0442\u0440\u043e\u043d. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0437\u0430\u043c\u0435\u0441\u0442 \u043c\u044f\u043d\u0435, \u0431\u043e \u044f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u044c \u044f\u0433\u043e \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042e\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043f\u0430\u0447\u044b\u045e \u0414\u0430\u0432\u0456\u0434 \u0437 \u0430\u0439\u0446\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0456 \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0414\u0430\u0432\u0456\u0434\u0430\u0432\u044b\u043c. \u0410 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0414\u0430\u0432\u0456\u0434 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e. \u0423 \u0413\u0435\u0431\u0440\u043e\u043d\u0435 \u0451\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0441\u0435\u043c \u0433\u0430\u0434\u043e\u045e, \u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0442\u0440\u044b \u0433\u0430\u0434\u044b. \u0406 \u0441\u0435\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u043d\u0430 \u0442\u0440\u043e\u043d \u0414\u0430\u0432\u0456\u0434\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e, \u0430 \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u043f 3, 11; \u041f\u0441 72 (71), 1\u0430. 2b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0434\u043e\u0447\u043a\u0456 \u0421\u0456\u0451\u043d\u0430, \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u045e \u043a\u0430\u0440\u043e\u043d\u0435, \u044f\u043a\u043e\u0439 \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u044f\u0433\u043e \u043c\u0430\u0446\u0456 \u044f\u0433\u043e\u043d\u0430\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0443 \u0434\u0437\u0435\u043d\u044c, \u0440\u0430\u0434\u0430\u0441\u043d\u044b \u0434\u043b\u044f \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0436\u0430, \u0434\u0430\u0439 \u0441\u0443\u0434 \u0422\u0432\u043e\u0439 \u043a\u0430\u0440\u0430\u043b\u044e; \u043d\u044f\u0445\u0430\u0439 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0422\u0432\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0434\u0437\u0435\u043d\u044c, \u0440\u0430\u0434\u0430\u0441\u043d\u044b \u0434\u043b\u044f \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"147","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">47, 12-25<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0413\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u0430\u0439\u0446\u043e\u045e: \u0430\u0434 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u0434\u0430 \u0415\u0440\u0430\u0431\u0430\u0430\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0430 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0441\u044b\u043d \u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0436\u044b\u045e \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430. \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0443 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b \u0447\u0430\u0441. \u0411\u043e\u0433 \u0430\u043a\u0440\u0443\u0436\u044b\u045e \u044f\u0433\u043e \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u043c\u0456\u0440\u0430\u043c, \u043a\u0430\u0431 \u0451\u043d \u0443\u0437\u043d\u0451\u0441 \u0434\u043e\u043c \u0456\u043c\u0435\u043d\u0456 \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456 \u0436 \u043c\u0443\u0434\u0440\u044b \u0442\u044b \u0431\u044b\u045e \u0443 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u0430\u043a\u0430, \u0440\u043e\u0437\u0443\u043c\u0430\u043c. \u0417\u044f\u043c\u043b\u044e \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0434\u0443\u0448\u0430 \u0442\u0432\u0430\u044f \u0456 \u0442\u044b \u0437\u0430\u0441\u044b\u043f\u0430\u045e \u044f\u0435 \u0437\u0430\u0433\u0430\u0434\u043a\u0430\u0432\u044b\u043c\u0456 \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u043c\u0456. \u0410\u0436 \u0434\u0430 \u0432\u044b\u0441\u043f\u0430\u045e \u0434\u0430\u0439\u0448\u043b\u043e \u0456\u043c\u044f \u0442\u0432\u0430\u0451, \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0446\u044f\u0431\u0435 \u0437\u0430 \u0442\u0432\u043e\u0439 \u0441\u043f\u0430\u043a\u043e\u0439. \u0414\u0437\u0435\u043b\u044f \u0433\u0456\u043c\u043d\u0430\u045e, \u0432\u044b\u0441\u043b\u043e\u045e\u044f\u045e \u0456 \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u043b\u0456\u0441\u044f \u0442\u0430\u0431\u043e\u044e \u0437\u0435\u043c\u043b\u0456. \u0423 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0442\u044b \u043d\u0430\u0437\u0431\u0456\u0440\u0430\u045e, \u044f\u043a \u043c\u0435\u0434\u0437\u0456, \u0437\u043e\u043b\u0430\u0442\u0430, \u0456 \u044f\u043a \u0432\u043e\u043b\u0430\u0432\u0430, \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0441\u0440\u044d\u0431\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0442\u044b \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0440\u044b \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u043d\u0447\u044b\u043d \u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u0442\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0430\u043c. \u0417\u0430\u043f\u043b\u044f\u043c\u0456\u045e \u0441\u043b\u0430\u0432\u0443 \u0441\u0432\u0430\u044e \u0456 \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u045e \u0441\u0432\u0430\u0451 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u0447\u044b\u043c \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0433\u043d\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u0456 \u044f\u043d\u044b \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0432\u0430\u0451\u0439 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u045e\u043b\u0430\u0434\u0430, \u0456 \u0437 \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u043f\u0430\u0447\u0430\u043b\u043e\u0441\u044f \u045e\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u041f\u0430\u043d \u043d\u0435 \u0430\u0434\u0432\u0435\u0440\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u0437\u0430\u0431\u044f\u0440\u044d \u043d\u0430\u0437\u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e, \u0456 \u043d\u0435 \u0441\u0430\u0442\u0440\u044d \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430, \u0456 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e. \u042f\u043a\u0443\u0431\u0443 \u0434\u0430\u045e \u0440\u044d\u0448\u0442\u0443 \u0456 \u0414\u0430\u0432\u0456\u0434\u0443 &ndash; \u0430\u0434 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043a\u043e\u0440\u0430\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0447\u044b\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u043e\u0434\u043a\u0430\u043c\u0456, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043f\u0430\u0441\u043b\u044f \u0441\u044f\u0431\u0435 \u043f\u0430\u0442\u043e\u043c\u043a\u0430, \u0441\u0430\u043c\u0430\u0433\u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0420\u0430\u0431\u0430\u0430\u043c\u0430, \u044f\u043a\u0456 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u043d\u0430\u0440\u043e\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0440\u0430\u0431\u0430\u0430\u043c, \u0441\u044b\u043d \u041d\u0430\u0431\u0430\u0442\u0430, \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0433\u0440\u0430\u0445\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u043f\u0430\u0432\u0451\u045e \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u0433\u0440\u0430\u0445\u0443. \u0412\u0435\u043b\u044c\u043c\u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0456\u0441\u044f \u0456\u0445\u043d\u0456\u044f \u0433\u0440\u0430\u0445\u0456, \u0442\u0430\u043c\u0443 \u0451\u043d \u0432\u044b\u0433\u043d\u0430\u045e \u0456\u0445 \u0437 \u0456\u0445\u043d\u044f\u0439 \u0437\u044f\u043c\u043b\u0456.<br \/>\u042f\u043d\u044b \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u043b\u0456\u0441\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u043d\u0430 \u0456\u0445 \u043f\u043e\u043c\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0437\u0445 37, 21\u0441. 22b. 23a. 24a; \u042f\u043d 10, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0432\u0430\u0437\u044c\u043c\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u044f\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0432\u0443\u043c\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456\u0434\u0430\u043b\u0430\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u0441\u0446\u044c \u0443 \u041c\u044f\u043d\u0435 \u0456 \u0456\u043d\u0448\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0432\u0430\u0440\u0430. \u0406 \u0433\u044d\u0442\u044b\u0445 \u041c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"151","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">16, 29 &ndash; 17, 16<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u043b\u043b\u0456 \u045e \u0447\u0430\u0441\u044b \u0410\u0445\u0430\u0431\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445\u0430\u0431, \u0441\u044b\u043d \u041e\u043c\u0440\u044b\u044f, \u0441\u0442\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0432\u043e\u0441\u044c\u043c\u044b \u0433\u043e\u0434 \u0410\u0441\u044b, \u043a\u0430\u0440\u0430\u043b\u044f \u042e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0410\u0445\u0430\u0431, \u0441\u044b\u043d \u041e\u043c\u0440\u044b\u044f, \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0443 \u0421\u0430\u043c\u0430\u0440\u044b\u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0434\u0432\u0430 \u0433\u0430\u0434\u044b. \u0420\u0430\u0431\u0456\u045e \u0410\u0445\u0430\u0431, \u0441\u044b\u043d \u041e\u043c\u0440\u044b\u044f, \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445. \u041c\u0430\u043b\u0430 \u0431\u044b\u043b\u043e \u044f\u043c\u0443 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u0440\u0430\u0445\u0430\u0445 \u0415\u0440\u0430\u0431\u0430\u0430\u043c\u0430, \u0441\u044b\u043d\u0430 \u041d\u044d\u0431\u0430\u0442\u0430, \u0434\u044b\u043a \u0451\u043d \u0443\u0437\u044f\u045e \u044f\u0448\u0447\u044d \u0441\u0430\u0431\u0435 \u0437\u0430 \u0436\u043e\u043d\u043a\u0443 \u0406\u0437\u044d\u0431\u044d\u043b\u044c, \u0434\u0430\u0447\u043a\u0443 \u042d\u0442\u0431\u0430\u0430\u043b\u044f, \u043a\u0430\u0440\u0430\u043b\u044f \u0421\u0456\u0434\u043e\u043d\u0430. \u041f\u0430\u0447\u0430\u045e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0411\u0430\u0430\u043b\u044e \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u044f\u043c\u0443. \u0423\u0437\u043d\u0451\u0441 \u0411\u0430\u0430\u043b\u044e \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0411\u0430\u0430\u043b\u044f, \u044f\u043a\u0443\u044e \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0443 \u0421\u0430\u043c\u0430\u0440\u044b\u0456. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u0445\u0430\u0431 \u0410\u0448\u044d\u0440\u0443, \u0456 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0434\u0430 \u044f\u0433\u043e, \u0410\u0445\u0430\u0431 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u045e \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041f\u0430\u0434\u0447\u0430\u0441 \u044f\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0456\u044d\u043b\u044c \u0437 \u0411\u044d\u0442\u044d\u043b\u044c \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0415\u0440\u044b\u0445\u043e\u043d. \u041f\u0430\u043a\u043b\u0430\u045e \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u044b \u044f\u0433\u043e \u043a\u043e\u0448\u0442\u0430\u043c \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0410\u0431\u0456\u0440\u0430\u043c\u0430, \u0430 \u0431\u0440\u0430\u043c\u044b \u044f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043a\u043e\u0448\u0442\u0430\u043c \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0430\u043b\u043e\u0434\u0448\u0430\u0433\u0430 \u0441\u044b\u043d\u0430 \u0421\u044d\u0433\u0456\u0431\u0430. \u0422\u0430\u043a \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0406\u043c \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430, \u0441\u044b\u043d\u0430 \u041d\u0443\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0437\u0430\u045e \u0406\u043b\u043b\u044f \u0422\u044d\u0441\u0431\u0456\u0442\u0430, \u0437 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u0456\u043b\u0435\u0430\u0434\u0441\u043a\u0456\u0445, \u0410\u0445\u0430\u0431\u0443: &laquo;\u042f\u043a \u0436\u044b\u0432\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c \u044f \u0441\u0442\u0430\u044e, \u0442\u0430\u043a \u0443 \u0433\u044d\u0442\u044b\u044f \u0433\u0430\u0434\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456 \u0440\u0430\u0441\u044b, \u043d\u0456 \u0434\u0430\u0436\u0434\u0436\u0443, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u043d\u0435 \u0441\u043a\u0430\u0436\u0443&raquo;. <br \/>\u0406 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0441\u043b\u043e\u0432\u0430 \u0434\u0430 \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0406\u0434\u0437\u0456 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0456 \u043f\u0430\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u043d\u0430 \u045e\u0441\u0445\u043e\u0434, \u0441\u0445\u0430\u0432\u0430\u0439\u0441\u044f \u043a\u0430\u043b\u044f \u043f\u0430\u0442\u043e\u043a\u0443 \u041a\u0435\u0440\u044b\u0442, \u0448\u0442\u043e \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0440\u0434\u0430\u043d\u0430. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0442\u043e\u043a\u0443 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0456\u0446\u044c, \u0430 \u043a\u0440\u0443\u043c\u043a\u0430\u0447\u0430\u043c \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u0430\u043c&raquo;. \u0422\u043e\u0439 \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430; \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043a\u0430\u043b\u044f \u043f\u0430\u0442\u043e\u043a\u0443 \u041a\u0435\u0440\u044b\u0442, \u0448\u0442\u043e \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0440\u0434\u0430\u043d\u0430. \u0410 \u043a\u0440\u0443\u043c\u043a\u0430\u0447\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u044f\u043c\u0443 \u0445\u043b\u0435\u0431 \u0456 \u043c\u044f\u0441\u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u0456 \u0445\u043b\u0435\u0431 \u0456 \u043c\u044f\u0441\u0430 \u045e\u0432\u0435\u0447\u0430\u0440\u044b, \u0430 \u0437 \u043f\u0430\u0442\u043e\u043a\u0443 \u0451\u043d \u043f\u0456\u045e. \u0410\u043b\u0435 \u043f\u0430\u0442\u043e\u043a, \u043a\u0430\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u0436\u044b\u045e \u0406\u043b\u043b\u044f, \u0432\u044b\u0441\u0430\u0445, \u0431\u043e \u0443 \u043a\u0440\u0430\u0456\u043d\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0436\u0434\u0436\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0441\u043b\u043e\u0432\u0430 \u0434\u0430 \u0406\u043b\u043b\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u0456\u0434\u0437\u0456 \u045e \u0421\u0430\u0440\u044d\u043f\u0442\u0443 \u0421\u0456\u0434\u043e\u043d\u0441\u043a\u0443\u044e \u0456 \u0442\u0430\u043c \u0437\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f, \u0431\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0430\u0434\u043d\u043e\u0439 \u0443\u0434\u0430\u0432\u0435, \u043a\u0430\u0431 \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u043c\u0456\u043b\u0430 \u0442\u0430\u043c&raquo;. \u0401\u043d \u0443\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0430\u0440\u044d\u043f\u0442\u0443. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0434\u0430 \u0431\u0440\u0430\u043c\u044b \u0433\u043e\u0440\u0430\u0434\u0430, \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0443\u0434\u0430\u0432\u0430, \u044f\u043a\u0430\u044f \u0437\u0431\u0456\u0440\u0430\u043b\u0430 \u0434\u0440\u043e\u0432\u044b. \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0440\u044b\u043d\u044f\u0441\u0456 \u043c\u043d\u0435 \u0442\u0440\u043e\u0445\u0456 \u0432\u0430\u0434\u044b \u045e \u0437\u0431\u0430\u043d\u0435 \u043d\u0430\u043f\u0456\u0446\u0446\u0430&raquo;. \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u043f\u0430\u0439\u0448\u043b\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0432\u0430\u0434\u044b, \u0451\u043d \u043a\u0440\u044b\u043a\u043d\u0443\u045e \u0443\u0441\u043b\u0435\u0434: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456, \u043f\u0440\u0430\u0448\u0443, \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0456 \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0445\u043b\u0435\u0431\u0430&raquo;. \u042f\u043d\u0430 \u0436 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u043d\u0435 \u043c\u0430\u044e \u043f\u0435\u0447\u044b\u0432\u0430, \u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u043c\u0435\u043d\u044e \u043c\u0443\u043a\u0456 \u045e \u043a\u0430\u0434\u0443\u0448\u0446\u044b \u0456 \u0442\u0440\u043e\u0445\u0456 \u0430\u043b\u0435\u044e \u045e \u0437\u0431\u0430\u043d\u0435. \u0412\u043e\u0441\u044c \u0437\u0431\u044f\u0440\u0443 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u043a\u0430\u0432\u0430\u043b\u043a\u0430\u045e \u0434\u0440\u044d\u0432\u0430 \u0456 \u043f\u0430\u0439\u0434\u0443, \u0437\u0433\u0430\u0442\u0443\u044e \u0441\u0430\u0431\u0435 \u0456 \u043c\u0430\u0439\u043c\u0443 \u0441\u044b\u043d\u0443. \u0417&rsquo;\u044f\u043c\u043e \u0433\u044d\u0442\u0430 \u0456 \u043f\u0430\u043c\u0440\u043e\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u043b\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0430\u043b\u0435 \u0456\u0434\u0437\u0456 \u0456 \u0437\u0440\u0430\u0431\u0456, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u043b\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0437\u0440\u0430\u0431\u0456 \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0440\u0430\u0441\u043d\u0430\u043a \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0456 \u043c\u043d\u0435. \u0421\u0430\u0431\u0435 \u0436 \u0456 \u0441\u044b\u043d\u0443 \u0437\u0440\u043e\u0431\u0456\u0448 \u043f\u043e\u0442\u044b\u043c. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &ldquo;\u041a\u0430\u0434\u0443\u0448\u043a\u0430 \u043c\u0443\u043a\u0456 \u043d\u0435 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u0446\u0430, \u0456 \u0437\u0431\u0430\u043d \u0430\u043b\u0435\u044e \u043d\u0435 \u0430\u043f\u0443\u0441\u0446\u0435\u0435 \u0430\u0436 \u0434\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0441\u043f\u0430\u0448\u043b\u0435 \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e&rdquo;&raquo;. \u042f\u043d\u0430 \u043f\u0430\u0439\u0448\u043b\u0430 \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0430, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u043b\u043b\u044f. \u0406 \u0448\u0442\u043e\u0434\u043d\u044f \u0435\u043b\u0456 \u0451\u043d, \u044f\u043d\u0430 \u0456 \u0434\u043e\u043c \u044f\u0435. \u0406 \u0442\u0430\u043a \u0431\u044b\u043b\u043e \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c. \u041a\u0430\u0434\u0443\u0448\u043a\u0430 \u043c\u0443\u043a\u0456 \u043d\u0435 \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0430\u0441\u044f, \u0456 \u0437\u0431\u0430\u043d \u0430\u043b\u0435\u044e \u043d\u0435 \u0430\u043f\u0443\u0441\u0446\u0435\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u041f\u0430\u043d \u0434\u0430\u045e \u043f\u0440\u0430\u0437 \u0406\u043b\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043a 5, 17. 18; \u0421\u0456\u0440 48, 1. 3\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u043b\u043b\u044f \u043f\u0430\u043c\u0430\u043b\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0436\u0434\u0436\u0443, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0436\u0434\u0436\u0443. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0437\u043d\u043e\u045e, \u0456 \u043d\u0435\u0431\u0430 \u0441\u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0434\u043e\u0436\u0434\u0436.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0406\u043b\u043b\u044f, \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a \u0430\u0433\u043e\u043d\u044c, \u0456 \u0441\u043b\u043e\u0432\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u043f\u0430\u043b\u0430\u043b\u0430, \u044f\u043a \u043f\u0430\u0445\u043e\u0434\u043d\u044f. \u0421\u043b\u043e\u0432\u0430\u043c \u041f\u0430\u043d\u0430 \u0451\u043d \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0437\u043d\u043e\u045e, \u0456 \u043d\u0435\u0431\u0430 \u0441\u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0434\u043e\u0436\u0434\u0436.<\/p>\r\n"}, {"GCH_CH_1_ID":"152","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">18, 16b-40&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u0406\u043b\u043b\u0456 \u043d\u0430\u0434 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0411\u0430\u0430\u043b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0410\u0445\u0430\u0431 \u043f\u0430\u0439\u0448\u043e\u045e \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0406\u043b\u043b\u044e. \u0410 \u043a\u0430\u043b\u0456 \u0410\u0445\u0430\u0431 \u0443\u0431\u0430\u0447\u044b\u045e \u0406\u043b\u043b\u044e, \u043a\u0440\u044b\u043a\u043d\u0443\u045e \u044f\u043c\u0443: &laquo;\u0413\u044d\u0442\u0430 \u0442\u044b \u0442\u0440\u044b\u0432\u043e\u0436\u044b\u0448 \u0406\u0437\u0440\u0430\u044d\u043b\u044c?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u043d\u0435 \u044f \u0442\u0440\u044b\u0432\u043e\u0436\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0430 \u0442\u044b \u0456 \u0434\u043e\u043c \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u0432\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0411\u0430\u0430\u043b\u044f\u043c\u0456. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0437\u0430\u0433\u0430\u0434\u0430\u0439 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u043a\u0430\u043b\u044f \u043c\u044f\u043d\u0435 \u045e\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043d\u0430 \u0433\u0430\u0440\u044b \u041a\u0430\u0440\u043c\u044d\u043b\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u0430\u0442\u044b\u0440\u044b\u0441\u0442\u0430 \u043f\u044f\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0411\u0430\u0430\u043b\u044f \u0456 \u0447\u0430\u0442\u044b\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0410\u0448\u044d\u0440\u044b, \u044f\u043a\u0456\u044f \u043a\u043e\u0440\u043c\u044f\u0446\u0446\u0430 \u0441\u0430 \u0441\u0442\u0430\u043b\u0430 \u0406\u0437\u044d\u0431\u044d\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0440\u043e\u043b\u044c \u0410\u0445\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430 \u045e\u0441\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u0430\u0431\u0440\u0430\u045e \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043d\u0430 \u0433\u0430\u0440\u044b \u041a\u0430\u0440\u043c\u044d\u043b\u044c. \u041f\u0430\u0434\u044b\u0448\u043e\u045e \u0406\u043b\u043b\u044f \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u0456 \u0434\u043e\u045e\u0433\u0430 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0456\u0441\u0442\u0430\u0446\u0446\u0430 \u045e \u0434\u0432\u0430 \u0431\u0430\u043a\u0456? \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0442\u043e \u0456\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u0406\u043c, \u0430 \u043a\u0430\u043b\u0456 \u0411\u0430\u0430\u043b\u044c, \u0442\u043e \u0456\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u0456\u043c&raquo;. \u0406 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434 \u043d\u0456 \u0441\u043b\u043e\u0432\u0430. \u0422\u0430\u0434\u044b \u0456\u0437\u043d\u043e\u045e \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u043b\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u042f \u0430\u0434\u0437\u0456\u043d \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043f\u0440\u0430\u0440\u043e\u043a \u041f\u0430\u043d\u0430, \u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0411\u0430\u0430\u043b\u044f \u0447\u0430\u0442\u044b\u0440\u044b\u0441\u0442\u0430 \u043f\u044f\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041d\u044f\u0445\u0430\u0439 \u0434\u0430\u0434\u0443\u0446\u044c \u043d\u0430\u043c \u0434\u0432\u0443\u0445 \u0446\u044f\u043b\u044f\u0442, \u0456 \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u0432\u044b\u0431\u0435\u0440\u0443\u0446\u044c \u0441\u0430\u0431\u0435 \u0430\u0434\u043d\u043e \u0446\u044f\u043b\u044f, \u0456 \u0440\u0430\u0441\u0441\u044f\u043a\u0443\u0446\u044c \u044f\u0433\u043e, \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0443\u0446\u044c \u043d\u0430 \u0434\u0440\u043e\u0432\u044b, \u0430\u043b\u0435 \u0430\u0433\u043d\u044e \u043d\u0435 \u043f\u0430\u0434\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c. \u042f \u0436 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u044e \u0434\u0440\u0443\u0433\u043e\u0435 \u0446\u044f\u043b\u044f \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0443 \u043d\u0430 \u0434\u0440\u043e\u0432\u044b, \u0430\u043b\u0435 \u0430\u0433\u043d\u044e \u043d\u0435 \u043f\u0430\u0434\u043a\u043b\u0430\u0434\u0443. \u0412\u044b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u0456\u043c\u044f \u0431\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0430 \u044f \u0431\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u0406 \u0442\u043e\u0439 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0434\u0430\u0441\u0446\u044c \u0430\u0434\u043a\u0430\u0437 \u043f\u0440\u0430\u0437 \u0430\u0433\u043e\u043d\u044c, \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c&raquo;. \u0423 \u0430\u0434\u043a\u0430\u0437 \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u043e\u0431\u0440\u0430\u044f \u043f\u0440\u0430\u043f\u0430\u043d\u043e\u0432\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u043b\u043b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0411\u0430\u0430\u043b\u044f: &laquo;\u0412\u044b\u0431\u0435\u0440\u044b\u0446\u0435 \u0441\u0430\u0431\u0435 \u0430\u0434\u043d\u043e \u0446\u044f\u043b\u044f \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u043f\u0435\u0440\u0448\u044b\u043c\u0456, \u0431\u043e \u0432\u0430\u0441 \u0448\u043c\u0430\u0442, \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u0456\u043c\u044f \u0431\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u0430\u0433\u043d\u044e \u043d\u0435 \u043f\u0430\u0434\u043a\u043b\u0430\u0434\u0430\u0439\u0446\u0435&raquo;. \u0423\u0437\u044f\u043b\u0456 \u044f\u043d\u044b \u0446\u044f\u043b\u044f, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0456\u043c, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456\u043c\u044f \u0411\u0430\u0430\u043b\u044f \u0437 \u0440\u0430\u043d\u0456\u0446\u044b \u0434\u0430 \u043f\u043e\u045e\u0434\u043d\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0411\u0430\u0430\u043b\u0435, \u043f\u0430\u0447\u0443\u0439 \u043d\u0430\u0441!&raquo; \u0410\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456 \u0433\u043e\u043b\u0430\u0441\u0443, \u043d\u0456 \u0430\u0434\u043a\u0430\u0437\u0443. \u0406 \u0441\u043a\u0430\u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0432\u0430\u043a\u043e\u043b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456. \u041a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c, \u0406\u043b\u043b\u044f \u043f\u0430\u0447\u0430\u045e \u0441\u043c\u044f\u044f\u0446\u0446\u0430 \u0437 \u0456\u0445, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0440\u044b\u0447\u044b\u0446\u0435 \u043c\u0430\u0446\u043d\u0435\u0439, \u0431\u043e \u0451\u043d \u0431\u043e\u0433; \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0451\u043d \u0437\u0430\u0434\u0443\u043c\u0430\u045e\u0441\u044f, \u0430\u0431\u043e \u0437\u0430\u043d\u044f\u0442\u044b \u0447\u044b\u043c-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u0430\u0431\u043e \u045e \u0434\u0430\u0440\u043e\u0437\u0435, \u0430, \u043c\u043e\u0436\u0430, \u0451\u043d \u0441\u043f\u0456\u0446\u044c, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0447\u043d\u0435\u0446\u0446\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0447\u0430\u043b\u0456 \u044f\u043d\u044b \u043c\u043e\u0446\u043d\u0430 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0456 \u043a\u0430\u043b\u043e\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0432\u044b\u0447\u0430\u044e \u043d\u0430\u0436\u0430\u043c\u0456 \u0456 \u0434\u0437\u0456\u0434\u0430\u043c\u0456, \u0442\u0430\u043a \u0448\u0442\u043e \u043a\u0440\u043e\u045e \u043b\u0456\u043b\u0430\u0441\u044f \u043f\u0430 \u0456\u0445. \u041c\u0456\u043d\u0443\u045e \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c, \u0430 \u044f\u043d\u044b \u045e\u0441\u0451 \u044f\u0448\u0447\u044d \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043b\u0456 \u0430\u0436 \u0434\u0430 \u0447\u0430\u0441\u0443 \u0432\u0435\u0447\u0430\u0440\u043e\u0432\u0430\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456 \u0433\u043e\u043b\u0430\u0441\u0443, \u043d\u0456 \u0430\u0434\u043a\u0430\u0437\u0443, \u043d\u0456 \u0437\u043d\u0430\u043a\u0443 \u045e\u0432\u0430\u0433\u0456. \u0422\u0430\u0434\u044b \u0406\u043b\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435&raquo;. \u0406 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e. \u0401\u043d \u0436\u0430 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u044b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u041f\u0430\u043d\u0430. \u0423\u0437\u044f\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u043f\u0430 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043a\u0430\u043b\u0435\u043d\u0430\u045e \u0441\u044b\u043d\u043e\u045e \u042f\u043a\u0443\u0431\u0430, \u044f\u043a\u043e\u043c\u0443 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0456\u043c\u044f \u0442\u0432\u0430\u0451&raquo;, \u0456 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0437 \u0433\u044d\u0442\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u0412\u044b\u043a\u0430\u043f\u0430\u045e \u0432\u0430\u043a\u043e\u043b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0440\u043e\u045e, \u0451\u043c\u0456\u0441\u0442\u0430\u0441\u0446\u044e \u0434\u0437\u0432\u044e\u0445 \u0441\u0430\u0442\u0430\u045e \u0437\u0435\u0440\u043d\u044f, \u043f\u0430\u043a\u043b\u0430\u045e \u0434\u0440\u043e\u0432\u044b, \u0440\u0430\u0441\u0441\u0435\u043a \u0446\u044f\u043b\u044f \u0456 \u043f\u0430\u043a\u043b\u0430\u045e \u044f\u0433\u043e \u043d\u0430 \u0434\u0440\u043e\u0432\u044b, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0435 \u0447\u0430\u0442\u044b\u0440\u044b \u0437\u0431\u0430\u043d\u044b \u0432\u0430\u0434\u043e\u044e \u0456 \u0432\u044b\u043b\u0435\u0439\u0446\u0435 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0430 \u0434\u0440\u043e\u0432\u044b&raquo;. \u041f\u043e\u0442\u044b\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u0440\u0430\u0431\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437&raquo;. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u0440\u0430\u0431\u0456\u0446\u0435 \u0442\u043e\u0435 \u0436 \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437&raquo;. \u0406 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437, \u0456 \u0432\u0430\u0434\u0430 \u043f\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0432\u0430\u043a\u043e\u043b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430, \u0430 \u0440\u043e\u045e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0432\u0430\u0434\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0447\u0430\u0441 \u0432\u0435\u0447\u0430\u0440\u043e\u0432\u0430\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u043a \u0406\u043b\u043b\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0406\u0441\u0430\u0430\u043a\u0430 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0443 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u0448\u0442\u043e \u0422\u044b \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456, \u0456 \u0448\u0442\u043e \u044f, \u0441\u043b\u0443\u0433\u0430 \u0422\u0432\u043e\u0439, \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0439\u0433\u043e. \u041f\u0430\u0447\u0443\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u043f\u0430\u0447\u0443\u0439 \u043c\u044f\u043d\u0435. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u0435 \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b, \u0448\u0442\u043e \u0422\u044b, \u041f\u0430\u043d\u0435, \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0456 \u0422\u044b \u043d\u0430\u0432\u0435\u0440\u043d\u0435\u0448 \u0441\u044d\u0440\u0446\u0430 \u0456\u0445\u043d\u044f\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0433\u043e\u043d\u044c \u041f\u0430\u043d\u0430 \u0441\u044b\u0448\u043e\u045e \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u0434\u0440\u043e\u0432\u044b, \u0456 \u043a\u0430\u043c\u044f\u043d\u0456, \u0456 \u043f\u044b\u043b, \u0456 \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u0432\u0430\u0434\u0443, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u045e \u0440\u043e\u0432\u0435. \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0443\u043f\u0430\u045e \u043d\u0456\u0446\u043c\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c!&raquo; \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0406\u043b\u043b\u044f: &laquo;\u0425\u0430\u043f\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0411\u0430\u0430\u043b\u044f, \u043a\u0430\u0431 \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0437 \u0456\u0445 \u043d\u0435 \u045e\u0446\u0451\u043a!&raquo; \u041a\u0430\u043b\u0456 \u0456\u0445 \u0441\u0445\u0430\u043f\u0456\u043b\u0456, \u0406\u043b\u043b\u044f \u0437\u0430\u0432\u0451\u045e \u0456\u0445 \u0434\u0430 \u043f\u0430\u0442\u043e\u043a\u0443 \u041a\u0456\u0448\u043e\u043d \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0456\u0445 \u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0412\u0430\u043b 18, 21\u0430b; \u041c\u0446 6, 24\u0430\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u044b\u0448\u043e\u045e \u0406\u043b\u043b\u044f \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u0426\u0456 \u0434\u043e\u045e\u0433\u0430 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0456\u0441\u0442\u0430\u0446\u0446\u0430 \u045e \u0434\u0432\u0430 \u0431\u0430\u043a\u0456? <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0442\u043e \u0456\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0434\u0432\u0443\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430\u043c. \u041d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u0456 \u043c\u0430\u043c\u043e\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0442\u043e \u0456\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u0406\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"153","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">19, 1-9\u0430. 11-21<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0406\u043b\u043b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0410\u0445\u0430\u0431 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u0406\u0437\u044d\u0431\u044d\u043b\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0406\u043b\u043b\u044f \u0456 \u0442\u043e\u0435, \u044f\u043a \u0451\u043d \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u043c\u044f\u0447\u043e\u043c \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e. \u0422\u0430\u0434\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0406\u0437\u044d\u0431\u044d\u043b\u044c \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u0430 \u0434\u0430 \u0406\u043b\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0431\u0430\u0433\u0456 \u0437\u0440\u043e\u0431\u044f\u0446\u044c \u043c\u043d\u0435 \u0442\u043e\u0435 \u0456 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448, \u043a\u0430\u043b\u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u0430\u0437\u0430\u045e\u0442\u0440\u0430 \u044f \u043d\u0435 \u0437\u0440\u0430\u0431\u043b\u044e \u0437 \u0442\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u044f\u043a \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0437 \u0436\u044b\u0446\u0446\u0451\u043c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0456\u0445&raquo;. \u0421\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0448\u044b\u0441\u044f, \u0406\u043b\u043b\u044f \u045e\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0411\u044d\u0440-\u0428\u044d\u0431\u0443 \u045e \u042e\u0434\u044d\u0456 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0442\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443. \u0417\u0430\u0442\u044b\u043c \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u043d\u0430 \u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0434\u043d\u044f \u0434\u0430\u0440\u043e\u0433\u0456 \u0456, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b, \u0441\u0435\u045e \u043f\u0430\u0434 \u0430\u0434\u043d\u044b\u043c \u0437 \u043a\u0443\u0441\u0442\u043e\u045e \u044f\u0434\u043b\u043e\u045e\u0446\u0443, \u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u0441\u043c\u0435\u0440\u0446\u0456 \u0441\u0430\u0431\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u043e\u043f\u0456\u0446\u044c \u0443\u0436\u043e, \u041f\u0430\u043d\u0435! \u0412\u0430\u0437\u044c\u043c\u0456 \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0431\u043e \u044f \u043d\u0435 \u043b\u0435\u043f\u0448\u044b \u0430\u0434 \u043c\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e!&raquo; \u041b\u0451\u0433 \u0456 \u0437\u0430\u0441\u043d\u0443\u045e. \u0406 \u0432\u043e\u0441\u044c, \u0430\u043d\u0451\u043b \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c \u0456 \u0435\u0448!&raquo; \u0406\u043b\u043b\u044f \u0433\u043b\u044f\u043d\u0443\u045e \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u043a\u0430\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u044b \u043f\u0435\u0447\u0430\u043d\u0443\u044e \u0430\u043b\u0430\u0434\u043a\u0443 \u0456 \u0437\u0431\u0430\u043d \u0432\u0430\u0434\u044b. \u0401\u043d \u0437&rsquo;\u0435\u045e \u0456 \u0432\u044b\u043f\u0456\u045e, \u0456 \u0437\u043d\u043e\u045e \u0437\u0430\u0441\u043d\u0443\u045e. \u0410\u043b\u0435 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c \u0456 \u0435\u0448, \u0431\u043e \u0434\u0430\u043b\u0451\u043a\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e!&raquo; \u0401\u043d \u0443\u0441\u0442\u0430\u045e, \u0437&rsquo;\u0435\u045e \u0456 \u0432\u044b\u043f\u0456\u045e. \u0406, \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0441\u0456\u043b\u043a\u0430\u043c, \u0451\u043d \u0456\u0448\u043e\u045e \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439 \u0434\u0430 \u0411\u043e\u0436\u0430\u0439 \u0433\u0430\u0440\u044b \u0413\u0430\u0440\u044d\u0431.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0406\u043b\u043b\u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0411\u043e\u0436\u0430\u0439 \u0433\u0430\u0440\u044b \u0413\u0430\u0440\u044d\u0431, \u0451\u043d \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u043f\u044f\u0447\u043e\u0440\u0443. \u0406 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0434\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u044b\u0439\u0434\u0437\u0456 \u0456 \u0441\u0442\u0430\u043d\u044c \u043d\u0430 \u0433\u0430\u0440\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430. \u0412\u043e\u0441\u044c \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u041f\u0430\u043d, \u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0432\u0435\u0446\u0435\u0440 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u043c\u043e\u0446\u043d\u044b, \u044f\u043a\u0456 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0435 \u0433\u043e\u0440\u044b \u0456 \u043a\u0440\u044b\u0448\u044b\u0446\u044c \u0441\u043a\u0430\u043b\u044b, \u0430\u043b\u0435 \u043d\u0435 \u045e \u0432\u0435\u0442\u0440\u044b \u041f\u0430\u043d. \u0410 \u043f\u0430\u0441\u043b\u044f \u0432\u0435\u0442\u0440\u0443 \u0431\u0443\u0434\u0437\u0435 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441, \u0430\u043b\u0435 \u043d\u0435 \u045e \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441\u0435 \u041f\u0430\u043d. \u041f\u0430\u0441\u043b\u044f \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441\u0443 \u0431\u0443\u0434\u0437\u0435 \u0430\u0433\u043e\u043d\u044c, \u0430\u043b\u0435 \u043d\u0435 \u045e \u0430\u0433\u043d\u0456 \u041f\u0430\u043d. \u041f\u0430\u0441\u043b\u044f \u0436 \u0430\u0433\u043d\u044e &ndash; \u0448\u0443\u043c \u0446\u0456\u0445\u0430\u0433\u0430 \u0432\u0435\u0442\u0440\u0443&raquo;. \u041f\u0430\u0447\u0443\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0406\u043b\u043b\u044f \u043f\u0440\u044b\u043a\u0440\u044b\u045e \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439 \u043f\u043b\u0430\u0448\u0447\u043e\u043c, \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u043f\u044f\u0447\u043e\u0440\u044b \u0456 \u0441\u0442\u0430\u045e \u043f\u0440\u044b \u044f\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435. \u0406 \u0432\u043e\u0441\u044c \u0433\u043e\u043b\u0430\u0441 \u043a\u0430\u0436\u0430 \u044f\u043c\u0443: &laquo;\u0428\u0442\u043e \u0442\u044b \u0440\u043e\u0431\u0456\u0448 \u0442\u0443\u0442, \u0406\u043b\u043b\u044f?&raquo; \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043f\u0430\u043b\u0430\u044e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0431\u043e \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0422\u0432\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u043b\u0456 \u0422\u0432\u0430\u0435 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0456 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0422\u0432\u0430\u0456\u0445 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u043c\u044f\u0447\u043e\u043c. \u0417\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u044f \u0430\u0434\u0437\u0456\u043d, \u0430\u043b\u0435 \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u044f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d: &laquo;\u0406\u0434\u0437\u0456, \u0432\u044f\u0440\u0442\u0430\u0439\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u043f\u0440\u0430\u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u045e \u0414\u0430\u043c\u0430\u0441\u043a. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448, \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0448 \u0413\u0430\u0437\u0430\u044d\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0421\u0456\u0440\u044b\u0456. \u0415\u0433\u0443, \u0441\u044b\u043d\u0430 \u041d\u0430\u043c\u0441\u0456, \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0448 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0415\u043b\u0456\u0441\u0435\u044f, \u0441\u044b\u043d\u0430 \u0421\u0430\u0444\u0430\u0442\u0430 \u0437 \u0410\u0431\u044d\u043b\u044c-\u041c\u044d\u0433\u0443\u043b\u044f, \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0448 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u044f\u0431\u0435. \u0422\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0446\u044f\u0447\u044d \u0430\u0434 \u043c\u044f\u0447\u0430 \u0413\u0430\u0437\u0430\u044d\u043b\u044f, \u0442\u0430\u0433\u043e \u0437\u0430\u0431&rsquo;\u0435 \u0415\u0433\u0443, \u0430 \u0445\u0442\u043e \u045e\u0440\u0430\u0442\u0443\u0435\u0446\u0446\u0430 \u0430\u0434 \u043c\u044f\u0447\u0430 \u0415\u0433\u0443, \u0442\u0430\u0433\u043e \u0437\u0430\u0431&rsquo;\u0435 \u0415\u043b\u0456\u0441\u0435\u0439. \u042f \u043f\u0430\u043a\u0456\u043d\u0443 \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u0441\u0435\u043c \u0442\u044b\u0441\u044f\u0447 \u0442\u044b\u0445, \u0447\u044b\u0435 \u043a\u0430\u043b\u0435\u043d\u0456 \u043d\u0435 \u0441\u0445\u0456\u043b\u0456\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u0430\u0430\u043b\u0435\u043c \u0456 \u0447\u044b\u0435 \u0432\u0443\u0441\u043d\u044b \u043d\u0435 \u0446\u0430\u043b\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0430\u0434\u0442\u0443\u043b\u044c \u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0415\u043b\u0456\u0441\u0435\u044f, \u0441\u044b\u043d\u0430 \u0421\u0430\u0444\u0430\u0442\u0430, \u043a\u0430\u043b\u0456 \u0442\u043e\u0439 \u0430\u0440\u0430\u045e, \u0456 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u0430\u0440 \u0432\u0430\u043b\u043e\u045e \u0431\u044b\u043b\u043e \u045e \u044f\u0433\u043e, \u0430 \u0441\u0430\u043c \u0451\u043d \u0431\u044b\u045e \u043a\u0430\u043b\u044f \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u0430\u0439. \u041f\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u0406\u043b\u043b\u044f \u043d\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430 \u044f\u0433\u043e \u0441\u0432\u043e\u0439 \u043f\u043b\u0430\u0448\u0447. \u0422\u043e\u0439 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0432\u0430\u043b\u043e\u045e \u0456 \u043f\u0430\u0431\u0435\u0433 \u0437\u0430 \u0406\u043b\u043b\u0451\u043c, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u0430\u0437\u0432\u043e\u043b\u044c \u043c\u043d\u0435 \u043f\u0430\u0446\u0430\u043b\u0430\u0432\u0430\u0446\u044c \u0431\u0430\u0446\u044c\u043a\u0443 \u043c\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u043c\u0430\u044e, \u0430 \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0439\u0434\u0443 \u0437\u0430 \u0442\u0430\u0431\u043e\u044e&raquo;. \u0406\u043b\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0432\u044f\u0440\u0442\u0430\u0439\u0441\u044f; \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u044f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439 \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u044f\u0433\u043e, \u0443\u0437\u044f\u045e \u043f\u0430\u0440\u0443 \u0432\u0430\u043b\u043e\u045e \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0456\u0445 \u0443 \u0430\u0445\u0432\u044f\u0440\u0443, \u0430 \u043d\u0430 \u044f\u0440\u043c\u0435 \u0432\u0430\u043b\u043e\u045e \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u045e \u043c\u044f\u0441\u0430 \u0456 \u0440\u0430\u0437\u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c, \u0456 \u044f\u043d\u044b \u0435\u043b\u0456. \u041f\u0430\u0441\u043b\u044f \u045e\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0406\u043b\u043b\u0451\u043c, \u0456 \u043f\u0430\u0447\u0430\u045e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0417\u044b\u0445 33, 22. 20b; \u042f\u043d 1, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: \u041a\u0430\u043b\u0456 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u043c\u0430\u044f \u0441\u043b\u0430\u0432\u0430, \u044f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435 \u045e \u0448\u0447\u044b\u043b\u0456\u043d\u0435 \u0441\u043a\u0430\u043b\u044b, \u0456 \u0434\u0430\u043b\u043e\u043d\u044c \u041c\u0430\u044f \u0437\u0430\u043a\u0440\u044b\u0435 \u0446\u044f\u0431\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"154","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">21, 1-21. 27-29<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0406\u043b\u043b\u044f \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u0431\u0435\u0434\u043d\u044b\u0445 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0443 \u041d\u0430\u0431\u043e\u0442\u0430 \u0456\u0437\u0440\u044d\u044d\u043b\u044f\u043d\u0456\u043d\u0430 \u0431\u044b\u045e \u0443 \u0406\u0437\u0440\u044d\u044d\u043b\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u043a\u0430\u043b\u044f \u043f\u0430\u043b\u0430\u0446\u0430 \u0410\u0445\u0430\u0431\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0441\u0430\u043c\u0430\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u0445\u0430\u0431 \u041d\u0430\u0431\u043e\u0442\u0443: &laquo;\u0410\u0434\u0434\u0430\u0439 \u043c\u043d\u0435 \u0441\u0432\u043e\u0439 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u0456 \u044f \u0437\u0440\u0430\u0431\u043b\u044e \u0437 \u044f\u0433\u043e \u0441\u0430\u0434 \u0437 \u0433\u0430\u0440\u043e\u0434\u043d\u0456\u043d\u0430\u0439, \u0431\u043e \u0451\u043d \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u043b\u0430\u0446\u0430. \u0410 \u0437\u0430\u043c\u0435\u0441\u0442 \u044f\u0433\u043e \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u043b\u0435\u043f\u0448\u044b \u0437\u0430 \u0433\u044d\u0442\u044b. \u0410\u0431\u043e, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448, \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0441\u0440\u044d\u0431\u0440\u0430 \u0437\u0430 \u044f\u0433\u043e, \u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u043a\u0430\u0436\u0430\u0448&raquo;. \u0410\u043b\u0435 \u041d\u0430\u0431\u043e\u0442 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u041f\u0430\u043d \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u043c\u043d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u043c\u0430\u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0410\u0445\u0430\u0431 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0442\u0440\u044b\u0432\u043e\u0436\u0430\u043d\u044b \u0456 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u043d\u044b \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041d\u0430\u0431\u043e\u0442 \u0456\u0437\u0440\u044d\u044d\u043b\u044f\u043d\u0456\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0435 \u0430\u0434\u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u043c\u0430\u0456\u0445&raquo;. \u0401\u043d \u043b\u0451\u0433 \u043d\u0430 \u0441\u0432\u043e\u0439 \u043b\u043e\u0436\u0430\u043a, \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0442\u0432\u0430\u0440\u0430\u043c \u0434\u0430 \u0441\u0446\u044f\u043d\u044b \u0456 \u043d\u0435 \u0435\u045e \u0445\u043b\u0435\u0431\u0430. \u041a\u0430\u043b\u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u044f\u0433\u043e \u0436\u043e\u043d\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0406\u0437\u044d\u0431\u044d\u043b\u044c, \u0441\u043f\u044b\u0442\u0430\u043b\u0430 \u045e \u044f\u0433\u043e: &laquo;\u0427\u0430\u043c\u0443 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u0430 \u0434\u0443\u0448\u0430 \u0442\u0432\u0430\u044f, \u0447\u0430\u043c\u0443 \u0442\u044b \u043d\u0435 \u044f\u0441\u0456 \u0445\u043b\u0435\u0431\u0430?&raquo; \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0451\u0439: &laquo;\u042f \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u041d\u0430\u0431\u043e\u0442\u0430\u043c \u0456\u0437\u0440\u044d\u044d\u043b\u044f\u043d\u0456\u043d\u0430\u043c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &ldquo;\u0410\u0434\u0434\u0430\u0439 \u043c\u043d\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0441\u0432\u043e\u0439 \u0437\u0430 \u0441\u0440\u044d\u0431\u0440\u0430, \u0430\u0431\u043e, \u043a\u0430\u043b\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u0435\u0448, \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0456\u043d\u0448\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0437\u0430\u043c\u0435\u0441\u0442 \u0433\u044d\u0442\u0430\u0433\u0430&rdquo;. \u0410\u043b\u0435 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u041d\u0435 \u0430\u0434\u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443 \u043c\u0430\u0439\u0433\u043e&rdquo;&raquo;. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u044f\u043c\u0443 \u0406\u0437\u044d\u0431\u044d\u043b\u044c, \u0436\u043e\u043d\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u044f: &laquo;\u0422\u044b \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u0423\u0441\u0442\u0430\u043d\u044c, \u0435\u0448 \u0445\u043b\u0435\u0431 \u0456 \u0431\u0443\u0434\u0437\u044c \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b: \u044f \u0437\u0434\u0430\u0431\u0443\u0434\u0443 \u0442\u0430\u0431\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u041d\u0430\u0431\u043e\u0442\u0430 \u0456\u0437\u0440\u044d\u044d\u043b\u044f\u043d\u0456\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0430\u043f\u0456\u0441\u0430\u043b\u0430 \u044f\u043d\u0430 \u0430\u0434 \u0456\u043c\u044f \u0410\u0445\u0430\u0431\u0430 \u043b\u0456\u0441\u0442\u044b, \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043b\u0430 \u0456\u0445 \u044f\u0433\u043e\u043d\u0430\u0439 \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u0439 \u0456 \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c \u0456 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0456 \u0436\u044b\u043b\u0456 \u0437 \u041d\u0430\u0431\u043e\u0442\u0430\u043c. \u0423 \u043b\u0456\u0441\u0442\u0430\u0445 \u044f\u043d\u0430 \u043f\u0456\u0441\u0430\u043b\u0430 \u0442\u0430\u043a: &laquo;\u0410\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u0435 \u043f\u043e\u0441\u0442 \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0446\u0435 \u041d\u0430\u0431\u043e\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0446\u0435 \u0434\u0432\u0443\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0431 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0422\u044b \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u045e \u0411\u043e\u0433\u0430 \u0456 \u043a\u0430\u0440\u0430\u043b\u044f&rdquo;. \u041f\u043e\u0442\u044b\u043c \u0432\u044b\u0432\u0435\u0434\u0437\u0456\u0446\u0435 \u044f\u0433\u043e \u0456 \u045e\u043a\u0430\u043c\u0435\u043d\u0443\u0439\u0446\u0435, \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u043c\u0451\u0440&raquo;. \u0406 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a \u043c\u0443\u0436\u044b \u0433\u043e\u0440\u0430\u0434\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u0456 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u043b\u0456 \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u044f\u0433\u043e\u043d\u044b\u043c, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u0456\u043c \u0406\u0437\u044d\u0431\u044d\u043b\u044c, \u0456 \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u045e \u043b\u0456\u0441\u0442\u0430\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0456\u043c. \u0410\u0431\u0432\u044f\u0441\u0446\u0456\u043b\u0456 \u043f\u043e\u0441\u0442 \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u043b\u0456 \u041d\u0430\u0431\u043e\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u041f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u0434\u0432\u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0456 \u0456 \u0441\u0435\u043b\u0456 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e. \u0413\u044d\u0442\u044b\u044f \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041d\u0430\u0431\u043e\u0442 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u045e \u0411\u043e\u0433\u0430 \u0456 \u043a\u0430\u0440\u0430\u043b\u044f&raquo;. \u0417\u0430\u0442\u044b\u043c \u0432\u044b\u0432\u0435\u043b\u0456 \u044f\u0433\u043e \u0437\u0430 \u0433\u043e\u0440\u0430\u0434 \u0456 \u043f\u0430\u0431\u0456\u043b\u0456 \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456, \u0456 \u0451\u043d \u043f\u0430\u043c\u0451\u0440. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0434\u0430 \u0406\u0437\u044d\u0431\u044d\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041d\u0430\u0431\u043e\u0442 \u0443\u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043d\u044b \u0456 \u043f\u0430\u043c\u0451\u0440&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0406\u0437\u044d\u0431\u044d\u043b\u044c \u043f\u0430\u0447\u0443\u043b\u0430, \u0448\u0442\u043e \u041d\u0430\u0431\u043e\u0442 \u0443\u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043d\u044b \u0456 \u043f\u0430\u043c\u0451\u0440, \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0410\u0445\u0430\u0431\u0443: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u0432\u0430\u0437\u044c\u043c\u0456 \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u041d\u0430\u0431\u043e\u0442\u0430 \u0456\u0437\u0440\u044d\u044d\u043b\u044f\u043d\u0456\u043d\u0430, \u044f\u043a\u0456 \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f \u0430\u0434\u0434\u0430\u0446\u044c \u044f\u0433\u043e \u0442\u0430\u0431\u0435 \u0437\u0430 \u0441\u0440\u044d\u0431\u0440\u0430, \u0431\u043e \u041d\u0430\u0431\u043e\u0442 \u043d\u0435 \u0436\u044b\u0432\u0435, \u0451\u043d \u043f\u0430\u043c\u0451\u0440&raquo;. \u041a\u0430\u043b\u0456 \u0410\u0445\u0430\u0431 \u043f\u0430\u0447\u0443\u045e, \u0448\u0442\u043e \u041d\u0430\u0431\u043e\u0442 \u043f\u0430\u043c\u0451\u0440, \u0443\u0441\u0442\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0439\u0441\u0446\u0456 \u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u041d\u0430\u0431\u043e\u0442\u0430 \u0456\u0437\u0440\u044d\u044d\u043b\u044f\u043d\u0456\u043d\u0430 \u0456 \u045e\u0437\u044f\u0446\u044c \u044f\u0433\u043e \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u043f\u0430\u043c\u0451\u0440 \u041d\u0430\u0431\u043e\u0442, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0441\u043b\u043e\u0432\u0430 \u0434\u0430 \u0406\u043b\u043b\u0456 \u0422\u044d\u0441\u0431\u0456\u0442\u0430: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u0456\u0434\u0437\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0410\u0445\u0430\u0431\u0443, \u043a\u0430\u0440\u0430\u043b\u044e \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u043c\u0443, \u044f\u043a\u0456 \u045e \u0421\u0430\u043c\u0430\u0440\u044b\u0456. \u0401\u043d \u0446\u044f\u043f\u0435\u0440 \u0443 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443 \u041d\u0430\u0431\u043e\u0442\u0430, \u0431\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0443\u0437\u044f\u0446\u044c \u044f\u0433\u043e \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435. \u0421\u043a\u0430\u0436\u044b \u044f\u043c\u0443: &ldquo;\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0442\u044b \u0437\u0430\u0431\u0456\u045e, \u0456 \u044f\u0448\u0447\u044d \u0437\u0430\u0431\u0456\u0440\u0430\u0435\u0448 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443?&rdquo; \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0436\u0430\u0448: &ldquo;\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u043d\u0430 \u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0434\u0437\u0435 \u0441\u0430\u0431\u0430\u043a\u0456 \u043b\u0456\u0437\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u041d\u0430\u0431\u043e\u0442\u0430, \u0441\u0430\u0431\u0430\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u0456\u0437\u0430\u0446\u044c \u0456 \u0442\u0432\u0430\u044e \u043a\u0440\u043e\u045e&rdquo;&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u0445\u0430\u0431 \u0406\u043b\u043b\u044e: &laquo;\u0417\u043d\u0430\u0439\u0448\u043e\u045e \u0442\u044b \u043c\u044f\u043d\u0435, \u0432\u043e\u0440\u0430\u0433 \u043c\u043e\u0439?&raquo; \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u043d\u0430\u0439\u0448\u043e\u045e, \u0431\u043e \u0442\u044b \u043f\u0440\u0430\u0434\u0430\u045e\u0441\u044f, \u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &ldquo;\u042f \u0441\u043f\u0430\u0448\u043b\u044e \u043d\u0430 \u0446\u044f\u0431\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u0432\u044b\u043f\u0430\u043b\u044e \u0437\u0430 \u0442\u0430\u0431\u043e\u044e, \u0456 \u0432\u044b\u043d\u0456\u0448\u0447\u0443 \u045e \u0434\u043e\u043c\u0435 \u0410\u0445\u0430\u0431\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u044e\u043d\u0430\u043a\u0430, \u0456 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u0430\u0433\u0430, \u0456 \u0432\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0410\u0445\u0430\u0431 \u043f\u0430\u0447\u0443\u045e \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u0448\u0430\u0442\u044b \u0441\u0432\u0430\u0435 \u0456 \u043d\u0430\u0434\u0437\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443. \u041f\u0430\u0441\u0446\u0456\u045e \u0456 \u0441\u043f\u0430\u045e \u0443 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0435, \u0456 \u0445\u0430\u0434\u0437\u0456\u045e \u0443 \u0441\u043c\u0443\u0442\u043a\u0443. \u0410 \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0441\u043b\u043e\u0432\u0430 \u0434\u0430 \u0406\u043b\u043b\u0456 \u0422\u044d\u0441\u0431\u0456\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0426\u0456 \u0431\u0430\u0447\u044b\u0448, \u044f\u043a \u0441\u043a\u0430\u0440\u044b\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e \u0410\u0445\u0430\u0431? \u0417\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0441\u043a\u0430\u0440\u044b\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e, \u044f \u043d\u0435 \u0441\u043f\u0430\u0448\u043b\u044e \u0437\u043b\u0430 \u045e \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0430\u043b\u0435 \u045e \u0434\u043d\u0456 \u0441\u044b\u043d\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u0448\u043b\u044e \u0437\u043b\u043e \u043d\u0430 \u0434\u043e\u043c \u044f\u0433\u043e\u043d\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043a 4, 8b. 9\u0430. 10\u0430; \u043f\u0430\u0440. 5, 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435 \u0440\u0443\u043a\u0456, \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456, \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u0441\u044d\u0440\u0446\u044b, \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0456\u043a\u0456.<span style=\"color: #ff0000;\"> *<\/span> \u0421\u043c\u0443\u0442\u043a\u0443\u0439\u0446\u0435, \u043f\u043b\u0430\u0447\u0446\u0435 \u0456 \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u0435. \u041f\u0440\u044b\u043d\u0456\u0437\u044c\u0446\u0435\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0430\u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u0456 \u0437\u0430\u0431\u0456\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430. \u0401\u043d \u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u045e\u0441\u044f \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043c\u0443\u0442\u043a\u0443\u0439\u0446\u0435, \u043f\u043b\u0430\u0447\u0446\u0435 \u0456 \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u0435. \u041f\u0440\u044b\u043d\u0456\u0437\u044c\u0446\u0435\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"155","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e<span style=\"color: #ff0000;\">&nbsp;22, 1-9. 15-23. 29. 34-38<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0431\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0422\u0440\u044b \u0433\u0430\u0434\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u0430\u0439\u043d\u044b \u043f\u0430\u043c\u0456\u0436 \u0410\u0440\u0430\u043c\u0430\u043c \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u0410 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0433\u043e\u0434 \u0401\u0437\u0430\u0444\u0430\u0442, \u043a\u0430\u0440\u043e\u043b\u044c \u042e\u0434\u044b, \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c: &laquo;\u0426\u0456 \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0420\u0430\u043c\u043e\u0442 \u0443 \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435 \u043d\u0430\u0448? \u0410 \u043c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u043e\u0431\u0456\u043c, \u043a\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u0440\u0443\u043a \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0440\u0430\u043c\u0430&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d \u0401\u0437\u0430\u0444\u0430\u0442\u0443: &laquo;\u0426\u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u0430 \u043c\u043d\u043e\u044e \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437\u0430 \u0420\u0430\u043c\u043e\u0442 \u0443 \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435?&raquo; \u0401\u0437\u0430\u0444\u0430\u0442 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u042f\u043a \u0442\u044b, \u0442\u0430\u043a \u0456 \u044f; \u044f\u043a \u0442\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0442\u0430\u043a \u0456 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434; \u044f\u043a \u0442\u0432\u0430\u0435 \u043a\u043e\u043d\u0456, \u0442\u0430\u043a \u0456 \u043c\u0430\u0435 \u043a\u043e\u043d\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0437\u0430\u0444\u0430\u0442 \u043a\u0430\u0440\u0430\u043b\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u041f\u0440\u0430\u0448\u0443, \u0441\u043f\u044b\u0442\u0430\u0439\u0441\u044f \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e \u041f\u0430\u043d\u0430&raquo;. \u0422\u0430\u0434\u044b \u0441\u0430\u0431\u0440\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043a\u0430\u043b\u044f \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u0441\u043e\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0426\u0456 \u0456\u0441\u0446\u0456 \u043c\u043d\u0435 \u0432\u0430\u0439\u043d\u043e\u044e \u043d\u0430 \u0420\u0430\u043c\u043e\u0442 \u0443 \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435, \u0446\u0456 \u043d\u0435?&raquo; \u042f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0406\u0434\u0437\u0456, \u0431\u043e \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u044f\u0433\u043e \u045e \u0440\u0443\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u044f&raquo;. \u0401\u0437\u0430\u0444\u0430\u0442 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: &laquo;\u0426\u0456 \u043d\u044f\u043c\u0430 \u0442\u0443\u0442 \u044f\u0448\u0447\u044d \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u043d\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0430\u0440\u0430\u0434\u0443 \u0430\u0434 \u044f\u0433\u043e?&raquo; \u0406 \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0437\u0430\u0444\u0430\u0442\u0443: &laquo;\u0401\u0441\u0446\u044c \u044f\u0448\u0447\u044d \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u043c\u043e\u0436\u043d\u0430 \u0441\u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u044f \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443 \u044f\u0433\u043e, \u0431\u043e \u0451\u043d \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u0434\u043e\u0431\u0440\u0430\u0435, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435. \u0413\u044d\u0442\u0430 \u041c\u0456\u0445\u0435\u0439, \u0441\u044b\u043d \u042d\u043c\u043b\u0456\u044f&raquo;. \u0422\u0430\u0434\u044b \u0401\u0437\u0430\u0444\u0430\u0442 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u0440\u043e\u043b\u044c, \u043d\u0435 \u043a\u0430\u0436\u044b \u0442\u0430\u043a&raquo;. \u0406 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0434\u0437\u0456 \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430 \u041c\u0456\u0445\u0435\u044f, \u0441\u044b\u043d\u0430 \u042d\u043c\u043b\u0456\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u043e\u0439 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u041c\u0456\u0445\u0435\u0439! \u0426\u0456 \u0456\u0441\u0446\u0456 \u043d\u0430\u043c \u0432\u0430\u0439\u043d\u043e\u044e \u043d\u0430 \u0420\u0430\u043c\u043e\u0442 \u0443 \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435, \u0446\u0456 \u043d\u0435?&raquo; \u041c\u0456\u0445\u0435\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0439, \u0431\u043e \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u044f\u0433\u043e \u045e \u0440\u0443\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u044f&raquo;. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u043a\u0430\u0440\u043e\u043b\u044c: &laquo;\u041a\u043e\u043b\u044c\u043a\u0456 \u0436 \u044f \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043f\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo;. \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0431\u0430\u0447\u044b\u045e \u0443\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u043f\u0430 \u0433\u0430\u0440\u0430\u0445, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u0445\u0430. \u0410 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u041d\u044f\u043c\u0430 \u045e \u0456\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u0437\u0430\u0444\u0430\u0442\u0443: &laquo;\u0426\u0456 \u043d\u0435 \u043a\u0430\u0437\u0430\u045e \u044f \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u043d \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u0434\u043e\u0431\u0440\u0430\u0435, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u041c\u0456\u0445\u0435\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u045e: &laquo;\u0422\u0430\u043c\u0443 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430: \u044f \u0431\u0430\u0447\u044b\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0442\u0440\u043e\u043d\u0435, \u0430 \u045e\u0441\u0451 \u0432\u043e\u0439\u0441\u043a\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0441\u0442\u0430\u044f\u043b\u0430 \u043f\u0440\u044b \u0406\u043c, \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0456 \u043b\u0435\u0432\u0430\u0440\u0443\u0447 \u0430\u0434 \u042f\u0433\u043e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &ldquo;\u0425\u0442\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0435 \u0410\u0445\u0430\u0431\u0430, \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u0443 \u0420\u0430\u043c\u043e\u0442, \u0448\u0442\u043e \u045e \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435?&rdquo; \u0406 \u0430\u0434\u0437\u0456\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a, \u0430 \u0434\u0440\u0443\u0433\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043d\u0430\u043a\u0448. \u0422\u0430\u0434\u044b \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u045e \u0434\u0443\u0445, \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u042f \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u044f\u0433\u043e&rdquo;. \u0410 \u041f\u0430\u043d \u0441\u043f\u044b\u0442\u0430\u045e \u044f\u0433\u043e: &ldquo;\u0427\u044b\u043c?&rdquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &ldquo;\u042f \u0432\u044b\u0439\u0434\u0443 \u0456 \u0441\u0442\u0430\u043d\u0443 \u0434\u0443\u0445\u0430\u043c \u043c\u0430\u043d\u044b \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445&rdquo;. \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u041f\u0430\u0434\u043c\u0430\u043d\u0456, \u0442\u044b \u0433\u044d\u0442\u0430 \u0437\u043c\u043e\u0436\u0430\u0448, \u0442\u0430\u043c\u0443 \u0456\u0434\u0437\u0456 \u0456 \u0437\u0440\u0430\u0431\u0456 \u0442\u0430\u043a&rdquo;. \u0410 \u0446\u044f\u043f\u0435\u0440 \u041f\u0430\u043d \u0443\u043a\u043b\u0430\u045e \u0434\u0443\u0445 \u043c\u0430\u043d\u044b \u045e \u0432\u0443\u0441\u043d\u044b \u0433\u044d\u0442\u044b\u0445 \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0442\u0432\u0430\u0456\u0445 \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0446\u044f\u0431\u0435 \u043d\u044f\u0434\u043e\u0431\u0440\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0401\u0437\u0430\u0444\u0430\u0442, \u043a\u0430\u0440\u043e\u043b\u044c \u042e\u0434\u044d\u0456, \u0443 \u0420\u0430\u043c\u043e\u0442 \u0443 \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043d\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u043b\u0443\u043a \u0456 \u043f\u0430\u0440\u0430\u043d\u0456\u045e \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0430\u043f\u0430\u045e\u0448\u044b \u043f\u0430\u043c\u0456\u0436 \u0441\u043f\u0430\u0439\u043a\u0430\u043c\u0456 \u0448\u0447\u044b\u0442\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u0432\u0430\u0439\u043c\u0443 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0447\u0430\u043c\u0443: &laquo;\u041f\u0430\u0432\u044f\u0440\u043d\u0456 \u043d\u0430\u0437\u0430\u0434 \u0456 \u0432\u044b\u0432\u0435\u0437\u0456 \u043c\u044f\u043d\u0435 \u0437 \u043f\u043e\u043b\u044f \u0431\u0456\u0442\u0432\u044b, \u0431\u043e \u044f \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0443\u0437\u043c\u0430\u0446\u043d\u0456\u043b\u0430\u0441\u044f \u0431\u0456\u0442\u0432\u0430, \u0430 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0410\u0440\u0430\u043c\u0430 \u0456 \u045e\u0432\u0435\u0447\u0430\u0440\u044b \u043f\u0430\u043c\u0451\u0440, \u0430 \u043a\u0440\u043e\u045e \u0437 \u0440\u0430\u043d\u044b \u0441\u0446\u044f\u043a\u0430\u043b\u0430 \u045e \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443. \u041d\u0430 \u0437\u0430\u0445\u0430\u0434\u0437\u0435 \u0441\u043e\u043d\u0446\u0430 \u045e\u0432\u0435\u0441\u044c \u043b\u0430\u0433\u0435\u0440 \u0430\u0431\u043b\u044f\u0446\u0435\u045e \u043a\u043b\u0456\u0447: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u043e\u0439 \u0433\u043e\u0440\u0430\u0434, \u043a\u043e\u0436\u043d\u044b \u045e \u0441\u0432\u0430\u044e \u0437\u044f\u043c\u043b\u044e! \u041a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u043c\u0451\u0440&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0431\u0440\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044f \u045e \u0421\u0430\u043c\u0430\u0440\u044b\u044e \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0442\u0430\u043c. \u041a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443 \u0432\u044b\u043c\u044b\u043b\u0456 \u045e \u0441\u0430\u0436\u0430\u043b\u0446\u044b \u045e \u0421\u0430\u043c\u0430\u0440\u044b\u0456, \u0434\u0437\u0435 \u043a\u0443\u043f\u0430\u043b\u0456\u0441\u044f \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u044b, \u0430 \u0441\u0430\u0431\u0430\u043a\u0456 \u043b\u0456\u0437\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u044f\u0433\u043e\u043d\u0443\u044e \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456\u044f \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0415\u0440 29, 8b. 9\u0430. 11\u0430; \u0414\u0440\u0433 18, 18\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0434\u0430\u0439\u0446\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0446\u044c \u0441\u044f\u0431\u0435 \u0432\u0430\u0448\u044b\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456; \u044f\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u0447\u0430\u0446\u044c \u043c\u0430\u043d\u0443 \u045e \u0456\u043c\u044f \u041c\u0430\u0451. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b, \u0448\u0442\u043e \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0456 \u045e\u043a\u043b\u0430\u0434\u0443 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0432\u0443\u0441\u043d\u044b \u044f\u0433\u043e\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b, \u0448\u0442\u043e \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n"}, {"GCH_CH_1_ID":"156","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041a\u0440\u043e\u043d\u0456\u043a\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">20, 1-9. 13-24<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0426\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0411\u043e\u0436\u0443\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0432\u0435\u0440\u043d\u0430\u043c\u0443 \u043a\u0430\u0440\u0430\u043b\u044e \u0401\u0437\u0430\u0444\u0430\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0412\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u0441\u044b\u043d\u044b \u041c\u0430\u0430\u0431\u0430 \u0456 \u0441\u044b\u043d\u044b \u0410\u043c\u043e\u043d\u0430, \u0430 \u0437 \u0456\u043c\u0456 \u043c\u0430\u0430\u043d\u0456\u0442\u044b \u043d\u0430 \u0432\u0430\u0439\u043d\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0401\u0437\u0430\u0444\u0430\u0442\u0430. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0401\u0437\u0430\u0444\u0430\u0442\u0430 \u0456 \u0434\u0430\u043d\u0435\u0441\u043b\u0456: &laquo;\u0406\u0434\u0437\u0435 \u043d\u0430 \u0446\u044f\u0431\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443 \u043c\u043e\u0440\u0430, \u0437 \u042d\u0434\u043e\u043c\u0430. \u042f\u043d\u044b \u045e\u0436\u043e \u045e \u0425\u0430\u0446\u0430\u0446\u043e\u043d-\u0422\u0430\u043c\u0430\u0440\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443 \u042d\u043d \u0413\u0435\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u0401\u0437\u0430\u0444\u0430\u0442, \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0448\u0443\u043a\u0430\u0446\u044c \u0443 \u042f\u0433\u043e \u043f\u0430\u0440\u0430\u0434\u044b, \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043f\u043e\u0441\u0442 \u0432\u0430 \u045e\u0441\u0451\u0439 \u042e\u0434\u044d\u0456. \u0416\u044b\u0445\u0430\u0440\u044b \u042e\u0434\u044d\u0456 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d\u0430. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u0437 \u0443\u0441\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u042e\u0434\u044b, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0437\u0430\u0444\u0430\u0442 \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0441\u0445\u043e\u0434\u0430\u043c \u042e\u0434\u044b \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u043e\u0432\u044b\u043c \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u0430\u043c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445! \u0426\u0456 \u0436 \u0422\u044b \u043d\u0435 \u0411\u043e\u0433 \u043d\u044f\u0431\u0451\u0441\u0430\u045e? \u0426\u0456 \u0436 \u043d\u0435 \u0422\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e? \u0423 \u0422\u0432\u0430\u0451\u0439 \u0440\u0443\u0446\u044d \u0441\u0456\u043b\u0430 \u0456 \u043c\u043e\u0446, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0441\u0442\u0430\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0426\u0456 \u0436 \u043d\u0435 \u0422\u044b, \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u0432\u044b\u0433\u043d\u0430\u045e \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0430\u0434\u0434\u0430\u045e \u044f\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0441\u044f\u0431\u0440\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456? \u042f\u043d\u044b \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u0451\u0439 \u0456 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u0442\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0434\u043b\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041a\u0430\u043b\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u043d\u0430\u0441 \u0437\u043b\u043e, \u043a\u0430\u0440\u0430\u044e\u0447\u044b \u043c\u0435\u0447, \u043f\u043e\u0448\u0430\u0441\u0446\u044c \u0446\u0456 \u0433\u043e\u043b\u0430\u0434, \u0442\u043e \u043c\u044b \u0441\u0442\u0430\u043d\u0435\u043c \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0434\u043e\u043c\u0430\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c, \u0431\u043e \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u045e \u0434\u043e\u043c\u0435 \u0433\u044d\u0442\u044b\u043c. \u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u043d\u0430\u0448\u044b\u043c, \u0456 \u0422\u044b \u043f\u0430\u0447\u0443\u0435\u0448 \u0456 \u0432\u044b\u0440\u0430\u0442\u0443\u0435\u0448&rdquo;&raquo;. \u0423\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u042e\u0434\u044d\u0456 \u0441\u0442\u0430\u044f\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u043d\u0430\u0432\u0430\u0442 \u0456\u0445\u043d\u0456\u044f \u043c\u0430\u043b\u044b\u044f \u0434\u0437\u0435\u0446\u0456, \u0436\u043e\u043d\u043a\u0456 \u0456\u0445\u043d\u0456\u044f \u0456 \u0441\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043d\u0430 \u042f\u0437\u0430\u0445\u0456\u044d\u043b\u044e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0441\u044b\u043d\u0430\u043c \u0417\u0430\u0445\u0430\u0440\u044b\u0456, \u0441\u044b\u043d\u0430 \u0411\u044d\u043d\u044f, \u0441\u044b\u043d\u0430 \u042f\u0456\u044d\u043b\u044f, \u0441\u044b\u043d\u0430 \u041c\u0430\u0442\u0430\u043d\u0456\u0456, \u043b\u0435\u0432\u0456\u0442\u044b \u0437 \u0441\u044b\u043d\u043e\u045e \u0410\u0441\u0430\u0444\u0430, \u0441\u044b\u0448\u043e\u045e \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u0441\u0445\u043e\u0434\u0443. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d: &laquo;\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0443\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u042e\u0434\u044d\u0456 \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0401\u0437\u0430\u0444\u0430\u0442! \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0432\u0430\u043c \u041f\u0430\u043d: \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c, \u0431\u043e \u043d\u0435 \u0432\u0430\u0448\u0430\u044f \u0433\u044d\u0442\u0430 \u0432\u0430\u0439\u043d\u0430, \u0430\u043b\u0435 \u0411\u043e\u0433\u0430. \u0417\u0430\u045e\u0442\u0440\u0430 \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445. \u042f\u043d\u044b \u045e\u0437\u044b\u0434\u0443\u0446\u044c \u043d\u0430 \u045e\u0437\u0432\u044b\u0448\u0448\u0430 \u0421\u0456\u0441, \u0456 \u0432\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0456\u0445 \u0443 \u043a\u0430\u043d\u0446\u044b \u0446\u044f\u0441\u043d\u0456\u043d\u044b, \u043f\u0435\u0440\u0430\u0434 \u043f\u0443\u0441\u0442\u044b\u043d\u044f\u0439 \u0415\u0440\u0443\u044d\u043b\u044c. \u0413\u044d\u0442\u0430 \u043d\u0435 \u0432\u0430\u0448\u0430 \u0432\u0430\u0439\u043d\u0430, \u0442\u0430\u043c\u0443 \u0437\u0430\u0439\u043c\u0456\u0446\u0435 \u043f\u0430\u0437\u0456\u0446\u044b\u044e, \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u042e\u0434\u0430 \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u044f\u043a \u041f\u0430\u043d \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0432\u0430\u043c. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456. \u0417\u0430\u045e\u0442\u0440\u0430 \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0456\u043c, \u0430 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456&raquo;. \u0421\u0445\u0456\u043b\u0456\u045e\u0441\u044f \u0401\u0437\u0430\u0444\u0430\u0442 \u0442\u0432\u0430\u0440\u0430\u043c \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u045e\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u042e\u0434\u044d\u0456 \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e\u043f\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u042f\u043c\u0443. \u041f\u043e\u0442\u044b\u043c \u0443\u0441\u0442\u0430\u043b\u0456 \u043b\u0435\u0432\u0456\u0442\u044b \u0437 \u0441\u044b\u043d\u043e\u045e \u041a\u0430\u0433\u0430\u0442\u0430 \u0456 \u0437 \u0441\u044b\u043d\u043e\u045e \u041a\u0430\u0440\u0430\u0445\u0430, \u043a\u0430\u0431 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u044f\u043d\u044b \u045e\u0441\u0442\u0430\u043b\u0456 \u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0422\u044d\u043a\u043e\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456, \u0443\u0441\u0442\u0430\u045e \u0401\u0437\u0430\u0444\u0430\u0442 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0436\u044b\u0445\u0430\u0440\u044b \u042e\u0434\u044d\u0456 \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430! \u0414\u0430\u0432\u0435\u0440\u0446\u0435\u0441\u044f \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u0430\u043c\u0443, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e \u0431\u044f\u0441\u043f\u0435\u0446\u044b; \u0432\u0435\u0440\u0446\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c \u0456 \u0432\u0430\u043c \u043f\u0430\u0448\u0447\u0430\u0441\u0446\u0456\u0446\u044c&raquo;. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0440\u0430\u0456\u045e\u0441\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0441\u043f\u0435\u0432\u0430\u043a\u043e\u045e \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u044b\u0445 \u0448\u0430\u0442\u0430\u0445 \u0456\u0448\u043b\u0456 \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456 \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0421\u043b\u0430\u045e\u0446\u0435 \u041f\u0430\u043d\u0430, \u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u043d\u044b \u0441\u043f\u0435\u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u041f\u0430\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0430\u0441\u0442\u043a\u0443 \u043d\u0430 \u0441\u044b\u043d\u043e\u045e \u0410\u043c\u043e\u043d\u0430, \u041c\u0430\u0430\u0431\u0430 \u0456 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u0430\u0440\u044b \u0421\u044d\u0456\u0440, \u044f\u043a\u0456\u044f \u043f\u0430\u0439\u0448\u043b\u0456 \u043d\u0430 \u042e\u0434\u0443, \u0456 \u0431\u044b\u043b\u0456 \u044f\u043d\u044b \u043f\u0430\u0431\u0456\u0442\u044b\u044f. \u0422\u0430\u0434\u044b \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0456 \u0441\u044b\u043d\u044b \u0410\u043c\u043e\u043d\u0430 \u0456 \u041c\u0430\u0430\u0431\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u0430\u0440\u044b \u0421\u044d\u0456\u0440, \u043a\u0430\u0431 \u0432\u044b\u0433\u043d\u0430\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0445. \u041a\u0430\u043b\u0456 \u0436 \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0456 \u0437 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456 \u0421\u044d\u0456\u0440\u0430, \u0442\u0430\u0434\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<br \/>\u042e\u0434\u044d\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u0430\u0434\u043a\u0443\u043b\u044c \u0431\u044b\u043b\u0430 \u0431\u0430\u0447\u043d\u0430\u044f \u043f\u0443\u0441\u0442\u044b\u043d\u044f, \u0443\u0431\u0430\u0447\u044b\u043b\u0456 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0437\u0430\u0431\u0456\u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043b\u044f\u0436\u0430\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0406 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0431 \u0430\u0446\u0430\u043b\u0435\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 6, 12. 14\u0430; 2 \u041a\u0440 20, 17\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0448\u0430\u044f \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430 \u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0440\u044b\u0432\u0456 \u0456 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u043b\u0430\u0434\u0430\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e \u0446\u0435\u043c\u0440\u044b \u0441\u0432\u0435\u0442\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0442\u0430\u043d\u044c\u0446\u0435 \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a \u041f\u0430\u043d \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"157","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 1-15<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0406\u043b\u043b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0443\u0437\u043d\u0435\u0441\u0446\u0456 \u0406\u043b\u043b\u044e \u045e \u0432\u0456\u0445\u0443\u0440\u044b \u043d\u0430 \u043d\u0435\u0431\u0430, \u0406\u043b\u043b\u044f \u0456 \u0415\u043b\u0456\u0441\u0435\u0439 \u0456\u0448\u043b\u0456 \u0437 \u0413\u0430\u043b\u044c\u0433\u0430\u043b\u044f. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u043b\u043b\u044f \u0415\u043b\u0456\u0441\u0435\u044e: &laquo;\u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0442\u0443\u0442, \u0431\u043e \u041f\u0430\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043c\u044f\u043d\u0435 \u0430\u0436 \u0443 \u0411\u044d\u0442\u044d\u043b\u044c&raquo;. \u0410\u043b\u0435 \u0415\u043b\u0456\u0441\u0435\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f\u043a \u0436\u044b\u0432\u044b \u041f\u0430\u043d, \u0456 \u0436\u044b\u0432\u0430\u044f \u0434\u0443\u0448\u0430 \u0442\u0432\u0430\u044f, \u0442\u0430\u043a \u044f \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443 \u0446\u044f\u0431\u0435&raquo;. \u0406 \u044f\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u0411\u044d\u0442\u044d\u043b\u044c. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0415\u043b\u0456\u0441\u0435\u044f \u0441\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0437 \u0411\u044d\u0442\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043c\u0443: &laquo;\u0426\u0456 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0437\u0430\u0431\u044f\u0440\u044d \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0434 \u0446\u044f\u0431\u0435 \u045e \u0432\u044b\u0448\u044b\u043d\u0456?&raquo; \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u043a, \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u044d\u0442\u0430 \u0432\u0435\u0434\u0430\u044e, \u0430\u043b\u0435 \u0432\u044b \u043c\u0430\u045e\u0447\u044b\u0446\u0435&raquo;. \u0406\u043b\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0415\u043b\u0456\u0441\u0435\u0439, \u0437\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0442\u0443\u0442, \u0431\u043e \u041f\u0430\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043c\u044f\u043d\u0435 \u045e \u0415\u0440\u044b\u0445\u043e\u043d&raquo;. \u0410\u043b\u0435 \u0442\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430 \u0456 \u043d\u0430 \u0442\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451! \u042f \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443 \u0446\u044f\u0431\u0435&raquo;. \u0406 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u045e \u0415\u0440\u044b\u0445\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u043e\u045e \u043f\u0430\u0434\u044b\u0448\u043b\u0456 \u0434\u0430 \u0415\u043b\u0456\u0441\u0435\u044f \u0441\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0415\u0440\u044b\u0445\u043e\u043d\u0435, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043c\u0443: &laquo;\u0426\u0456 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u041f\u0430\u043d \u0437\u0430\u0431\u044f\u0440\u044d \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0430\u0434 \u0446\u044f\u0431\u0435 \u045e \u0432\u044b\u0448\u044b\u043d\u0456?&raquo; \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u043a, \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u044d\u0442\u0430 \u0432\u0435\u0434\u0430\u044e, \u0430\u043b\u0435 \u0432\u044b \u043c\u0430\u045e\u0447\u044b\u0446\u0435&raquo;. \u0406\u043b\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u043b\u0456\u0441\u0435\u044e: &laquo;\u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0442\u0443\u0442, \u0431\u043e \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u042f\u0440\u0434\u0430\u043d\u0430&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d: &laquo;\u042f\u043a \u0436\u044b\u0432\u044b \u041f\u0430\u043d, \u0456 \u0436\u044b\u0432\u0430\u044f \u0434\u0443\u0448\u0430 \u0442\u0432\u0430\u044f, \u0442\u0430\u043a \u044f \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443 \u0446\u044f\u0431\u0435&raquo;. \u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u0440\u0430\u0437\u0430\u043c. \u041f\u044f\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0441\u044b\u043d\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043f\u0430\u0439\u0448\u043b\u0456 \u0456 \u0441\u0442\u0430\u043b\u0456 \u0437\u0434\u0430\u043b\u0451\u043a \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445, \u0430 \u044f\u043d\u044b \u0430\u0431\u043e\u0434\u0432\u0430 \u0441\u0442\u0430\u044f\u043b\u0456 \u043a\u0430\u043b\u044f \u042f\u0440\u0434\u0430\u043d\u0430. \u0422\u0430\u0434\u044b \u045e\u0437\u044f\u045e \u0406\u043b\u043b\u044f \u043f\u043b\u0430\u0448\u0447 \u0441\u0432\u043e\u0439, \u0441\u043a\u0440\u0443\u0446\u0456\u045e \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0456\u043c \u043f\u0430 \u0432\u0430\u0434\u0437\u0435, \u0456 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u044f\u043d\u0430 \u045e \u0430\u0431\u043e\u0434\u0432\u0430 \u0431\u0430\u043a\u0456, \u0456 \u044f\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0430 \u0441\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456, \u0406\u043b\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u043b\u0456\u0441\u0435\u044e: &laquo;\u041f\u0440\u0430\u0441\u0456, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u0431\u0435, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0431\u0443\u0434\u0443 \u045e\u0437\u044f\u0442\u044b \u0430\u0434 \u0446\u044f\u0431\u0435&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u043b\u0456\u0441\u0435\u0439: &laquo;\u041f\u0440\u0430\u0448\u0443, \u043d\u044f\u0445\u0430\u0439 \u0443\u0434\u0432\u0430\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e \u0434\u0443\u0445\u0430 \u0442\u0432\u0430\u0439\u0433\u043e&raquo;. \u0406\u043b\u043b\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u044f\u0436\u043a\u0430\u0433\u0430 \u0442\u044b \u043f\u0440\u043e\u0441\u0456\u0448; \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448, \u044f\u043a \u044f \u0431\u0443\u0434\u0443 \u045e\u0437\u044f\u0442\u044b \u0430\u0434 \u0446\u044f\u0431\u0435, \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0442\u0430\u0431\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0448, \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430&raquo;. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0456\u0448\u043b\u0456 \u0456 \u0433\u0443\u0442\u0430\u0440\u044b\u043b\u0456, \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u044f \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430 \u0456 \u043a\u043e\u043d\u0456 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b\u044f, \u0456 \u0440\u0430\u0437\u043b\u0443\u0447\u044b\u043b\u0456 \u0456\u0445 \u0430\u0431\u043e\u0434\u0432\u0443\u0445, \u0456 \u045e\u0437\u043d\u044f\u045e\u0441\u044f \u0406\u043b\u043b\u044f \u045e \u0432\u0456\u0445\u0443\u0440\u044b \u043d\u0430 \u043d\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0415\u043b\u0456\u0441\u0435\u0439 \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u041e\u0439\u0447\u0430 \u043c\u043e\u0439, \u043e\u0439\u0447\u0430 \u043c\u043e\u0439, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u043a\u043e\u043d\u043d\u0456\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u044f!&raquo; \u0406 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u044f\u0433\u043e \u0431\u043e\u043b\u044c\u0448. \u0422\u0430\u0434\u044b \u0441\u0445\u0430\u043f\u0456\u045e \u0451\u043d \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u044f\u0435 \u043d\u0430 \u0434\u0437\u0432\u0435 \u0447\u0430\u0441\u0442\u043a\u0456. \u041f\u0430\u0434\u043d\u044f\u045e \u043f\u043b\u0430\u0448\u0447 \u0406\u043b\u043b\u0456, \u0448\u0442\u043e \u045e\u043f\u0430\u045e \u0437 \u044f\u0433\u043e, \u0456, \u0432\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f, \u0441\u0442\u0430\u045e \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u042f\u0440\u0434\u0430\u043d\u0430. \u0423\u0437\u044f\u045e \u043f\u043b\u0430\u0448\u0447 \u0406\u043b\u043b\u0456, \u0448\u0442\u043e \u045e\u043f\u0430\u045e \u0437 \u044f\u0433\u043e, \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0456\u043c \u043f\u0430 \u0432\u0430\u0434\u0437\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0437\u0435 \u0436 \u0446\u044f\u043f\u0435\u0440 \u0411\u043e\u0433 \u0406\u043b\u043b\u0456?&raquo; \u0410 \u043a\u0430\u043b\u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u043f\u0430 \u0432\u0430\u0434\u0437\u0435, \u044f\u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u0443\u043f\u0456\u043b\u0430\u0441\u044f \u045e \u0430\u0431\u043e\u0434\u0432\u0430 \u0431\u0430\u043a\u0456, \u0456 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0415\u043b\u0456\u0441\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0431\u0430\u0447\u044b\u0448\u045e\u044b \u044f\u0433\u043e \u0437\u0434\u0430\u043b\u0451\u043a, \u0441\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0437 \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0414\u0443\u0445 \u0406\u043b\u043b\u0456 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0415\u043b\u0456\u0441\u0435\u0456&raquo;. \u041f\u0430\u0439\u0448\u043b\u0456 \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0430\u043b 3, 23-24\u0430; \u041b\u043a 1, 15\u0430. 17\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u044f \u043f\u0430\u0448\u043b\u044e \u0434\u0430 \u0432\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u043b\u043b\u044e, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0441\u0442\u0440\u0430\u0448\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0437\u0432\u0435\u0440\u043d\u0435 \u0441\u044d\u0440\u0446\u044b \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0434\u0430 \u0441\u044b\u043d\u043e\u045e, \u0456 \u0441\u044d\u0440\u0446\u044b \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0431\u0430\u0446\u044c\u043a\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430, \u0456 \u0441\u0430\u043c \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0443 \u0434\u0443\u0445\u0443 \u0456 \u043c\u043e\u0446\u044b \u0406\u043b\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0437\u0432\u0435\u0440\u043d\u0435 \u0441\u044d\u0440\u0446\u044b \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0434\u0430 \u0441\u044b\u043d\u043e\u045e, \u0456 \u0441\u044d\u0440\u0446\u044b \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0431\u0430\u0446\u044c\u043a\u043e\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"161","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 1-14<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0437\u044f\u043a\u0430 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u043b, \u0437 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0431\u0440\u0430\u0442 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 &ndash; \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0411\u043e\u0436\u0430\u043c\u0443 \u045e \u041a\u0430\u0440\u044b\u043d\u0446\u0435, \u0437 \u0443\u0441\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0432\u0430 \u045e\u0441\u0451\u0439 \u0410\u0445\u0430\u0456\u0456: \u043b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0410\u0439\u0446\u0435\u0446 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0411\u043e\u0433 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043d\u0430\u0441 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0441\u043c\u0443\u0442\u043a\u0443 \u043d\u0430\u0448\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0442\u044b\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c, \u044f\u043a\u0456\u043c \u0411\u043e\u0433 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445. \u0411\u043e, \u044f\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f, \u0442\u0430\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435. \u041a\u0430\u043b\u0456 \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c \u0443\u0446\u0456\u0441\u043a, \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041a\u0430\u043b\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435\u043c\u0441\u044f, \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043d\u043d\u0456 \u0442\u044b\u0445 \u0441\u0430\u043c\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0448\u0442\u043e \u0456 \u043c\u044b \u0446\u0435\u0440\u043f\u0456\u043c. \u0406 \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0430\u0448\u0430\u044f \u043d\u0430 \u0432\u0430\u0441 \u043c\u043e\u0446\u043d\u0430\u044f, \u0431\u043e \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0432\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0456 \u043d\u0430\u0448\u044b\u044f \u044f\u043a \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445, \u0442\u0430\u043a \u0456 \u045e \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043c\u044b \u043d\u0435 \u0445\u043e\u0447\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0430\u0431 \u043d\u0430\u0448\u044b\u043c \u0443\u0446\u0456\u0441\u043a\u0443, \u044f\u043a\u0456 \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u045e \u0410\u0437\u0456\u0456, \u0431\u043e \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430 \u0446\u044f\u0436\u043a\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u0456 \u043d\u0435 \u043f\u0430\u0434 \u0441\u0456\u043b\u0443, \u0430\u0436\u043d\u043e \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c\u0456. \u0410\u043b\u0435 \u0441\u0430\u043c\u0456 \u045e \u0441\u0430\u0431\u0435 \u043c\u044b \u0430\u0434\u0447\u0443\u043b\u0456 \u043f\u0430\u0433\u0440\u043e\u0437\u0443 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0435 \u043d\u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0401\u043d \u0432\u044b\u0431\u0430\u0432\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435, \u0456 \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0456 \u044f\u0448\u0447\u044d \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0446\u044c \u0431\u0443\u0434\u0437\u0435, \u0431\u043e \u0456 \u0432\u044b \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0435\u0441\u044f \u0437\u0430 \u043d\u0430\u0441 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445, \u043a\u0430\u0431 \u043c\u043d\u043e\u0433\u0456\u044f \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u043b\u0456 \u0437\u0430 \u043d\u0430\u0441 \u0456 \u0437\u0430 \u0434\u0430\u0440, \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c \u043f\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u043c\u043d\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430, \u0448\u0442\u043e \u043c\u044b \u045e \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0456 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u043d\u0435 \u045e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u045e \u043b\u0430\u0441\u0446\u044b \u0411\u043e\u0436\u0430\u0439 \u0436\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441. \u041c\u044b \u043d\u0435 \u043f\u0456\u0448\u0430\u043c \u0432\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0447\u044b\u0442\u0430\u0435\u0446\u0435 \u0446\u0456 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u044f\u043a \u0432\u044b \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u045e\u0436\u043e \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0448\u0442\u043e \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0445\u0432\u0430\u043b\u043e\u0439 \u0432\u0430\u0448\u0430\u0439, \u044f\u043a \u0456 \u0432\u044b \u043d\u0430\u0448\u0430\u0439, \u0443 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 94 (93), 18b-19; 2 \u041a\u0430\u0440 1, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u041f\u0430\u043d\u0435, \u043c\u044f\u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043b\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0442\u0440\u044b\u0432\u043e\u0433\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0422\u0432\u0430\u0451 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435 \u043c\u0430\u044e \u0434\u0443\u0448\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f, \u0442\u0430\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0442\u0440\u044b\u0432\u043e\u0433\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0422\u0432\u0430\u0451 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435 \u043c\u0430\u044e \u0434\u0443\u0448\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"162","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 15 &ndash; 2, 11&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0427\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0437\u043c\u044f\u043d\u0456\u045e \u043f\u043b\u0430\u043d \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0417 \u0433\u044d\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u044f \u0445\u0430\u0446\u0435\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u0440\u0430\u043d\u0435\u0439, \u043a\u0430\u0431 \u0432\u044b \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u043c\u0435\u043b\u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c: \u043f\u0435\u0440\u0448\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0432\u0430\u0441 \u0456\u0448\u043e\u045e \u0443 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u044e, \u0434\u0440\u0443\u0433\u0456, \u043a\u0430\u043b\u0456 \u0437 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456 \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0434\u0430 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u043f\u0440\u0430\u0432\u044f\u043b\u0456 \u043c\u044f\u043d\u0435 \u045e \u042e\u0434\u044d\u044e. \u0426\u0456 \u0436 \u044f \u0431\u044b\u045e \u043b\u0435\u0433\u043a\u0430\u0434\u0443\u043c\u043d\u044b, \u043c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0456 \u043d\u0430\u043c\u0435\u0440? \u0426\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u044e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u044e, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u045e \u043c\u044f\u043d\u0435 &laquo;\u0442\u0430\u043a, \u0442\u0430\u043a&raquo; \u0456 &laquo;\u043d\u0435, \u043d\u0435&raquo;? \u0411\u043e\u0433 &ndash; \u0432\u0435\u0440\u043d\u044b, \u0442\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u0430 \u043d\u0430\u0448\u0430\u0435 \u0434\u0430 \u0432\u0430\u0441 \u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u0442\u0430\u043a&raquo; \u0456 &laquo;\u043d\u0435&raquo;! \u0411\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u043e\u0433\u0430 \u044f \u0456 \u0421\u0456\u043b\u044c\u0432\u0430\u043d, \u0456 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 \u0432\u0430\u043c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043b\u0456, \u043d\u0435 \u0431\u044b\u045e &laquo;\u0442\u0430\u043a&raquo; \u0456 &laquo;\u043d\u0435&raquo;, \u0430\u043b\u0435 \u0431\u044b\u043b\u043e \u045e \u0406\u043c \u0442\u043e\u043b\u044c\u043a\u0456 &laquo;\u0442\u0430\u043a&raquo;. \u0423\u0441\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0411\u043e\u0436\u044b\u044f \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u0406\u043c &laquo;\u0442\u0430\u043a&raquo;. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043d\u0430\u0448\u0430\u0435 &laquo;\u0430\u043c\u044d\u043d&raquo; \u0451\u0441\u0446\u044c \u043d\u0430 \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0436\u0443\u044e. \u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441 \u0437 \u0432\u0430\u043c\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043d\u0430\u0441, \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u0456 \u0434\u0430\u045e \u0441\u044d\u0440\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0411\u043e\u0433\u0430 \u043a\u043b\u0456\u0447\u0443 \u045e \u0441\u0432\u0435\u0434\u043a\u0456 \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u044f \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u044f\u0448\u0447\u044d \u045e \u041a\u0430\u0440\u044b\u043d\u0442, \u0431\u043e \u0448\u043a\u0430\u0434\u0443\u044e \u0432\u0430\u0441. \u041d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u043d\u0443\u0435\u043c \u043d\u0430\u0434 \u0432\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u0430\u044e, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439, \u0431\u043e \u0432\u0435\u0440\u0430\u0439 \u0432\u044b \u0446\u0432\u0451\u0440\u0434\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0432\u0430\u0441 \u0456\u0437\u043d\u043e\u045e \u0443 \u0441\u043c\u0443\u0442\u043a\u0443. \u0411\u043e, \u043a\u0430\u043b\u0456 \u044f \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u044e \u0432\u0430\u0441, \u0442\u043e \u0445\u0442\u043e \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u043c\u044f\u043d\u0435, \u044f\u043a \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b \u043c\u043d\u043e\u044e? \u0422\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u044f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u043a\u0430\u0431, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b, \u043d\u0435 \u043c\u0435\u0446\u044c \u0441\u0443\u043c\u0443 \u0430\u0434 \u0442\u044b\u0445, \u0430\u0434 \u044f\u043a\u0456\u0445 \u043c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043c\u0435\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u043c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0430\u0431 \u0443\u0441\u0456\u0445 \u0432\u0430\u0441, \u0448\u0442\u043e \u043c\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0448\u0430\u044f. \u0411\u043e \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0443\u0446\u0456\u0441\u043a\u0443 \u0456 \u0442\u0443\u0437\u0435 \u0441\u044d\u0440\u0446\u0430 \u043f\u0456\u0441\u0430\u045e \u044f \u0432\u0430\u043c \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u0446\u044c \u0432\u0430\u0441, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043c\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e, \u0442\u043e \u043d\u0435 \u043c\u044f\u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e, \u0430\u043b\u0435 \u045e \u043d\u0435\u0439\u043a\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, &ndash; \u043a\u0430\u0431 \u043d\u0435 \u043f\u0435\u0440\u0430\u0431\u043e\u043b\u044c\u0448\u0432\u0430\u0446\u044c, &ndash; \u0456 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441. \u0414\u0430\u0432\u043e\u043b\u0456 \u0442\u0430\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u0445; \u0442\u0430\u043c\u0443 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442 \u043b\u0435\u043f\u0448 \u0434\u0430\u0440\u0443\u0439\u0446\u0435 \u044f\u043c\u0443 \u0456 \u0441\u0443\u0446\u0435\u0448\u0446\u0435 \u044f\u0433\u043e, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u045e \u0451\u043d \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0441\u0443\u043c\u0430\u043c \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u044b\u043c. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u043c\u0443 \u043b\u044e\u0431\u043e\u045e. \u0411\u043e \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u044f \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u045e, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0441, \u0446\u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f. \u0410 \u043a\u0430\u043c\u0443 \u0432\u044b \u0448\u0442\u043e \u0434\u0430\u0440\u0443\u0435\u0446\u0435, \u0442\u0430\u043c\u0443 \u0456 \u044f \u0434\u0430\u0440\u0443\u044e. \u0411\u043e \u0456 \u044f, \u043a\u0430\u043b\u0456 \u0448\u0442\u043e \u0434\u0430\u0440\u0430\u0432\u0430\u045e, \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u0431 \u043d\u0435 \u0442\u0440\u0430\u043f\u0456\u043b\u0456 \u043c\u044b \u045e \u043f\u0430\u0441\u0442\u043a\u0443 \u0441\u0430\u0442\u0430\u043d\u044b, \u0431\u043e \u043d\u0430\u043c \u0432\u044f\u0434\u043e\u043c\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0434\u0443\u043c\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 1, 21-22; \u043f\u0430\u0440. \u0414\u0440\u0433 5, 2. 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441 \u0437 \u0432\u0430\u043c\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043d\u0430\u0441, \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0434\u0430\u045e \u0441\u044d\u0440\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u043d\u0430\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u043d\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0430\u045e \u0441\u044d\u0440\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"163","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 12 &ndash; 3, 6<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0432\u0435\u043b &ndash; \u0441\u043b\u0443\u0433\u0430 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u0422\u0440\u0430\u0430\u0434\u0443 \u0434\u0437\u0435\u043b\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0445\u043e\u0446\u044c \u043c\u043d\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b \u0434\u0437\u0432\u0435\u0440\u044b \u045e \u041f\u0430\u043d\u0443, \u044f \u043d\u0435 \u043c\u0435\u045e \u0441\u043f\u0430\u043a\u043e\u044e \u0434\u0443\u0445\u0430, \u0431\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0442\u0430\u043c \u0431\u0440\u0430\u0442\u0430 \u043c\u0430\u0439\u0433\u043e \u0426\u0456\u0442\u0430. \u0422\u0430\u043c\u0443, \u0440\u0430\u0437\u0432\u0456\u0442\u0430\u045e\u0448\u044b\u0441\u044f \u0437 \u0456\u043c\u0456, \u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u044e. \u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u0448\u0442\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0435 \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u0432\u043e\u0434\u0430\u0440 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u042f\u0433\u043e \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441 \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u0411\u043e \u043c\u044b &ndash; \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0432\u043e\u0434\u0430\u0440 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435. \u0414\u043b\u044f \u0430\u0434\u043d\u044b\u0445 \u043c\u044b \u043f\u0430\u0445 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u0430 \u0434\u043b\u044f \u0434\u0440\u0443\u0433\u0456\u0445 &ndash; \u0432\u043e\u0434\u0430\u0440 \u0436\u044b\u0446\u0446\u044f \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f. \u0406 \u0445\u0442\u043e \u0432\u0430\u0440\u0442\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u0434\u0430\u043d\u043d\u044f? \u0411\u043e \u043c\u044b \u043d\u0435 \u0433\u0430\u043d\u0434\u043b\u044e\u0435\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u044f\u043a \u043c\u043d\u043e\u0433\u0456\u044f, \u0430\u043b\u0435 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u0435\u043c \u0448\u0447\u044b\u0440\u0430, \u044f\u043a \u0430\u0434 \u0411\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u045e\u0436\u043e \u043f\u0430\u0447\u044b\u043d\u0430\u0446\u044c \u043d\u0430\u043c \u0456\u0437\u043d\u043e\u045e \u0437\u043d\u0430\u0451\u043c\u0456\u0446\u0446\u0430? \u041d\u044f\u045e\u0436\u043e \u043d\u0430\u043c, \u044f\u043a \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u043c, \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0434\u0430\u0432\u0435\u0440\u0447\u044b\u044f \u043b\u0456\u0441\u0442\u044b \u0434\u0430 \u0432\u0430\u0441 \u0446\u0456 \u0430\u0434 \u0432\u0430\u0441? \u0412\u044b &ndash; \u043d\u0430\u0448 \u043b\u0456\u0441\u0442, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0456 \u0447\u044b\u0442\u0430\u044e\u0446\u044c \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456. \u0412\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0432\u044b &ndash; \u043b\u0456\u0441\u0442 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0448\u0430\u043c\u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e. \u041d\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u043d\u0435 \u0447\u0430\u0440\u043d\u0456\u043b\u0430\u043c\u0456, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430\u043c \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u043d\u0435 \u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445, \u0430\u043b\u0435 \u043d\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445 \u0441\u044d\u0440\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456 \u0434\u0430\u0432\u0435\u0440 \u043c\u044b \u043c\u0430\u0435\u043c \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430. \u041d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0434\u0443\u043c\u0430\u0446\u044c \u043d\u0435\u0448\u0442\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0430\u0434 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443: \u043d\u0435 \u043b\u0456\u0442\u0430\u0440\u044b, \u0430\u043b\u0435 \u0414\u0443\u0445\u0443, \u0431\u043e \u043b\u0456\u0442\u0430\u0440\u0430 \u0437\u0430\u0431\u0456\u0432\u0430\u0435, \u0430 \u0414\u0443\u0445 \u0430\u0436\u044b\u045e\u043b\u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 3, 4. 6. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a\u0456 \u0434\u0430\u0432\u0435\u0440 \u043c\u044b \u043c\u0430\u0435\u043c \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443: \u043d\u0435 \u043b\u0456\u0442\u0430\u0440\u044b, \u0430\u043b\u0435 \u0414\u0443\u0445\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0434\u0443\u043c\u0430\u0446\u044c \u043d\u0435\u0448\u0442\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0430\u0434 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443: \u043d\u0435 \u043b\u0456\u0442\u0430\u0440\u044b, \u0430\u043b\u0435 \u0414\u0443\u0445\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"164","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">3, 7 &ndash; 4, 4<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0432\u0430\u043b\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u0436 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456, \u0432\u044b\u0440\u0430\u0437\u0430\u043d\u0430\u0435 \u043b\u0456\u0442\u0430\u0440\u0430\u043c\u0456 \u043d\u0430 \u043a\u0430\u043c\u044f\u043d\u044f\u0445, \u043c\u0435\u043b\u0430 \u0442\u0430\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0443, \u0448\u0442\u043e \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0447\u0430\u0441\u043e\u0432\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u045e \u0441\u043b\u0430\u0432\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0434\u0443\u0445\u0430? \u041a\u0430\u043b\u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044e &ndash; \u0433\u044d\u0442\u0430 \u0441\u043b\u0430\u0432\u0430, \u0442\u043e \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043b\u0430\u0432\u0430\u044e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0411\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u043d\u0435 \u043c\u0430\u0435 \u0441\u043b\u0430\u0432\u044b \u045e \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0439 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u0441\u043b\u0430\u045e\u043d\u0430\u0435, \u0442\u043e \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0430\u0434\u0432\u0430\u0433\u0430\u044e. \u0410\u043b\u0435 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u045e \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439, \u043a\u0430\u0431 \u0441\u044b\u043d\u044b \u0456\u0437\u0440\u0430\u044d\u043b\u0435\u0432\u044b \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u0456\u043d\u0430\u0435. \u0410\u0434\u043d\u0430\u043a \u0437\u0430\u0446\u043c\u0456\u043b\u0456\u0441\u044f \u0440\u043e\u0437\u0443\u043c\u044b \u0456\u0445, \u0431\u043e \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f \u0442\u0430\u044f \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u044f\u0437\u043d\u044f\u0442\u0430\u0439 \u043f\u0440\u044b \u0447\u044b\u0442\u0430\u043d\u043d\u0456 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0431\u043e \u043c\u0456\u043d\u0430\u0435 \u044f\u043d\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0410\u0436\u043d\u043e \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0447\u044b\u0442\u0430\u044e\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f, \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u043b\u044f\u0436\u044b\u0446\u044c \u043d\u0430 \u0456\u0445 \u0441\u044d\u0440\u0446\u044b. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435\u0445\u0442\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u0437\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430. \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c, \u0430 \u0434\u0437\u0435 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0442\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0430. \u0410 \u043c\u044b \u045e\u0441\u0435 \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f, \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u0440\u0430, \u0443 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443, \u0442\u0430\u043a \u044f\u043a \u043f\u0440\u0430\u0437 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043c\u0430\u044e\u0447\u044b \u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439 \u0442\u0430\u043a\u043e\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u043c\u044b \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0456. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043c\u044b \u0430\u0434\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0430\u0434 \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u044b\u0445 \u0441\u043a\u0440\u044b\u0442\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043c \u0441\u044f\u0431\u0435 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430 \u0456 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430\u0435\u043c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0432\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u043c \u0441\u044f\u0431\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0456 \u0437\u0430\u043a\u0440\u044b\u0442\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043d\u0430\u0448\u0430\u0435, \u0442\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0434\u043b\u044f \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u044f\u043a\u0456\u043c \u0431\u043e\u0433 \u0432\u0435\u043a\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u0446\u044c\u043c\u0456\u045e \u0440\u043e\u0437\u0443\u043c, \u043a\u0430\u0431 \u0456\u043c \u043d\u0435 \u0437\u0437\u044f\u043b\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 3, 18; \u0424\u043b\u043f 3, 3b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u045e\u0441\u0435 \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f \u045e \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0441\u043b\u0443\u0436\u044b\u043c \u0443 \u0411\u043e\u0436\u044b\u043c \u0414\u0443\u0445\u0443 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"165","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 5-18<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0435\u043c\u0430\u0447 \u0456 \u043c\u043e\u0446 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044b \u043d\u0435 \u0441\u044f\u0431\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430, \u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 &ndash; \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0437 \u0446\u0435\u043c\u0440\u044b \u0437\u0430\u0437\u0437\u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u043e&raquo;, \u0437\u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0443 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0443 \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043c\u0430\u0435\u043c \u0441\u043a\u0430\u0440\u0431 \u0443 \u0433\u043b\u0456\u043d\u044f\u043d\u044b\u0445 \u043d\u0430\u0447\u044b\u043d\u043d\u044f\u0445, \u043a\u0430\u0431 \u0432\u0435\u043b\u0456\u0447 \u043c\u043e\u0446\u044b \u0431\u044b\u043b\u0430 \u0411\u043e\u0436\u0430\u044f, \u0430 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0430\u0434 \u043d\u0430\u0441. \u0423\u0441\u044f\u043b\u044f\u043a \u0443\u0446\u0456\u0441\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u044f. \u041c\u044b \u045e \u0440\u0430\u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0451\u043c\u0441\u044f \u0440\u043e\u0441\u043f\u0430\u0447\u044b. \u041d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f. \u0417\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u0433\u0456\u043d\u0435\u043c. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0441\u0456\u043c \u0443 \u0446\u0435\u043b\u0435 \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0441\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0435 \u043d\u0430\u0448\u044b\u043c. \u0411\u043e \u043c\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0451\u043c, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0434\u0437\u0451\u043c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0422\u0430\u043a \u0448\u0442\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u043d\u0430\u0441, \u0430 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0443 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0443\u0445 \u0432\u0435\u0440\u044b, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u042f \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e&raquo;, \u0456 \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0442\u0430\u043c\u0443 \u0456 \u043a\u0430\u0436\u0430\u043c, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0456 \u043d\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456. \u0411\u043e \u045e\u0441\u0451 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u043f\u0430\u043c\u043d\u0430\u0436\u044d\u043d\u043d\u0435 \u043b\u0430\u0441\u043a\u0456 \u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u043f\u0430\u0434\u0437\u044f\u043a\u0443 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0456, \u0431\u043e, \u0445\u043e\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u0456 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0442\u043b\u0435\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430. \u041d\u0430\u0448\u0430\u0435 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u043b\u0451\u0433\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0434\u0430\u0435 \u043d\u0430\u043c \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u041c\u044b \u043d\u0435 \u045e\u0437\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u045e \u0431\u0430\u0447\u043d\u0430\u0435, \u0430\u043b\u0435 \u045e \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0447\u0430\u0441\u043e\u0432\u0430\u0435, \u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0432\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 4, 6; \u0414\u0440\u0433 5, 24\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e: \u041d\u044f\u0445\u0430\u0439 \u0437 \u0446\u0435\u043c\u0440\u044b \u0437\u0430\u0437\u0437\u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, <span style=\"color: #ff0000;\">*<\/span> \u0437\u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0443 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0443 \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443 \u0456 \u0432\u0435\u043b\u0456\u0447. \u041c\u044b \u0447\u0443\u043b\u0456 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0443 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0443 \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"166","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">5, 1-21<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u043e\u043c. \u0421\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043f\u0440\u044b\u043c\u0456\u0440\u044d\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0437\u044f\u043c\u043d\u044b \u0434\u043e\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0442\u043e \u0430\u0434 \u0411\u043e\u0433\u0430 \u043c\u0430\u0435\u043c \u0436\u044b\u043b\u043b\u0451 &ndash; \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u044b \u0432\u0435\u0447\u043d\u044b \u0434\u043e\u043c \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u0422\u0430\u043c\u0443 \u043c\u044b \u045e\u0437\u0434\u044b\u0445\u0430\u0435\u043c, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u043e\u043c. \u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u043c, \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u044b\u043c\u0456. \u0411\u043e \u043c\u044b, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b\u0441\u044f \u045e \u0448\u0430\u0442\u0440\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u043b\u043b\u044f, \u0443\u0437\u0434\u044b\u0445\u0430\u0435\u043c \u043f\u0430\u0434 \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0431\u043e \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0440\u0430\u0441\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u0430\u043b\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u0431\u044b\u043b\u043e \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0442\u0430 \u0436\u044b\u0446\u0446\u0451\u043c. \u0410 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u0434\u0430\u045e \u043d\u0430\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0445\u0432\u0456\u043b\u0456\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0446\u0435\u043b\u0435, \u043c\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0431\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u044f. \u0410\u0434\u043d\u0430\u043a, \u043c\u0430\u044e\u0447\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c, \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0445\u043e\u0447\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443. \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u042f\u043c\u0443, \u0446\u0456 \u0442\u043e \u0431\u0443\u0434\u0443\u0447\u044b \u0437 \u0406\u043c, \u0446\u0456 \u0442\u043e \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u042f\u0433\u043e. \u0411\u043e \u045e\u0441\u0435 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u0440\u0430\u0431\u0456\u045e, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0446\u0435\u043b\u0435: \u0434\u043e\u0431\u0440\u0430\u0435 \u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430, \u043c\u044b \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043c\u044b \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u0456 \u0434\u043b\u044f \u0432\u0430\u0448\u044b\u0445 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f\u045e. \u041c\u044b \u043d\u0435 \u0456\u043c\u043a\u043d\u0435\u043c\u0441\u044f \u043d\u0430\u043d\u043e\u0432\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0434\u0430\u0435\u043c \u043d\u0430\u0433\u043e\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0432\u043e\u043d\u043a\u0443, \u0430 \u043d\u0435 \u045e \u0441\u044d\u0440\u0446\u044b. \u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u0433\u0443\u0431\u043b\u044f\u043b\u0456 \u0440\u043e\u0437\u0443\u043c, \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430; \u043a\u0430\u043b\u0456 \u0436 \u0431\u044b\u043b\u0456 \u043f\u0440\u044b \u0440\u043e\u0437\u0443\u043c\u0435, \u0434\u044b\u043a \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0434\u0443\u043c\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0410\u0434\u0437\u0456\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0442\u043e \u045e\u0441\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u0456. \u0401\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437\u0430 \u0456\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430. \u0422\u0430\u043c\u0443 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043c\u044b \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0456 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0442\u043e \u0441\u0451\u043d\u043d\u044f \u045e\u0436\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0451\u043c. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0442\u043e\u0439 \u043d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435; \u0434\u0430\u045e\u043d\u044f\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u043e\u0432\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0430\u0434 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u043d\u0430\u0441 \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u0435\u0442, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043b\u044e\u0434\u0437\u0435\u0439, \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043b\u043e\u0432\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0430\u0434 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u0430\u043c\u0456 \u044f\u043a \u0431\u044b \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441. \u0410\u0434 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u043e\u0441\u0456\u043c: \u043f\u0430\u044f\u0434\u043d\u0430\u0439\u0446\u0435\u0441\u044f \u0437 \u0411\u043e\u0433\u0430\u043c. \u0411\u043e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0433\u0440\u0430\u0445\u0443, \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0433\u0440\u0430\u0445\u043e\u043c \u0437\u0430\u043c\u0435\u0441\u0442 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u045e \u0406\u043c \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 5, 18b; \u0420\u044b\u043c 8, 32\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u0435\u0442 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043b\u043e\u0432\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433, \u044f\u043a\u0456 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043b\u043e\u0432\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"167","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">6, 1 &ndash; 7, 1<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u0443\u0442\u044b \u041f\u0430\u045e\u043b\u0430 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0442\u0430 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u042f\u043a \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0456, \u043c\u044b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0440\u044d\u043c\u043d\u0430. \u0411\u043e \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u0423 \u0447\u0430\u0441 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u042f \u043f\u0430\u0447\u0443\u045e \u0446\u044f\u0431\u0435 \u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433 \u0442\u0430\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0447\u0430\u0441 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b, \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041c\u044b \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0434\u0430\u0451\u043c \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u0446\u0446\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0437\u0430\u0433\u0430\u043d\u044b \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456, \u0430\u043b\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u043c \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0411\u043e\u0436\u044b\u0445: \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u0445, \u0443 \u043f\u0430\u0442\u0440\u044d\u0431\u0435, \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u043f\u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u043c\u0456, \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u0430\u0445, \u0443 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u044f\u0445, \u0443 \u043f\u0440\u0430\u0446\u044b, \u0443 \u0447\u0443\u0432\u0430\u043d\u043d\u0456, \u0443 \u043f\u043e\u0441\u0446\u0435, \u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0443 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456, \u0443 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456, \u0443 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456, \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0439, \u0443 \u0441\u043b\u043e\u0432\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u0443 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439, \u0441\u0430 \u0437\u0431\u0440\u043e\u044f\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e \u043f\u0440\u0430\u0432\u0430\u0439 \u0456 \u045e \u043b\u0435\u0432\u0430\u0439 \u0440\u0443\u0446\u044d, \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0432\u0443 \u0456 \u0431\u044f\u0441\u0441\u043b\u0430\u045e\u0435, \u043f\u0440\u0430\u0437 \u0433\u0430\u043d\u044c\u0431\u0443 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0435. \u041c\u044b \u043d\u0456\u0431\u044b \u0430\u0448\u0443\u043a\u0430\u043d\u0446\u044b, \u0430\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f; \u043d\u0456\u0431\u044b \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u044f, \u0430\u043b\u0435 \u043d\u0430\u0441 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c; \u043d\u0456\u0431\u044b \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u044f, \u0430\u043b\u0435 \u0432\u043e\u0441\u044c \u043c\u044b \u0436\u044b\u0432\u0451\u043c; \u043d\u0456\u0431\u044b \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u0431\u0456\u0442\u044b\u044f; \u043d\u0456\u0431\u044b \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u044f, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f; \u043d\u0456\u0431\u044b \u045e\u0431\u043e\u0433\u0456\u044f, \u0430\u043b\u0435 \u043c\u043d\u043e\u0433\u0456\u0445 \u0443\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435\u043c; \u043d\u0456\u0431\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u0435\u043c, \u0430\u043b\u0435 \u045e\u0441\u0456\u043c \u0432\u0430\u043b\u043e\u0434\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0443\u0441\u043d\u044b \u043d\u0430\u0448\u044b\u044f \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456, \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0435, \u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0448\u044b\u0440\u043e\u043a\u0456\u043c. \u0412\u0430\u043c \u043d\u0435 \u0446\u0435\u0441\u043d\u0430 \u045e \u043d\u0430\u0441, \u0430\u043b\u0435 \u0432\u0430\u0448\u0430\u0435 \u045e\u043b\u043e\u043d\u043d\u0435 \u0446\u0435\u0441\u043d\u0430\u0435. \u0410\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u0435 \u0442\u044b\u043c \u0436\u0430. \u041a\u0430\u0436\u0443, \u044f\u043a \u0434\u0437\u0435\u0446\u044f\u043c, \u0430\u0434\u043a\u0440\u044b\u0439\u0446\u0435\u0441\u044f \u0456 \u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u0435 \u043f\u0430\u0434 \u0447\u0443\u0436\u044b\u043c \u044f\u0440\u043c\u043e\u043c \u0437 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c\u0456! \u0411\u043e \u044f\u043a\u0430\u044f \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0437 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u043c? \u0428\u0442\u043e \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0430\u043c\u0456\u0436 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u044b \u0446\u0435\u043c\u0440\u0430\u044e? \u0428\u0442\u043e \u0437\u0430 \u0437\u0433\u043e\u0434\u0430 \u043f\u0430\u043c\u0456\u0436 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0411\u044d\u043b\u0456\u0430\u0440\u0430\u043c? \u0428\u0442\u043e \u044f\u0434\u043d\u0430\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u0430\u0433\u0430 \u0437 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c? \u0428\u0442\u043e \u043c\u0430\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0437 \u0456\u0434\u0430\u043b\u0430\u043c\u0456? \u041c\u044b &ndash; \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433: &laquo;\u041f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u045e \u0456\u0445 \u0456 \u0431\u0443\u0434\u0443 \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u0456 \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c, \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u0456\u0445 \u0456 \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u0435\u0441\u044f, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0456 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430, \u0456 \u042f \u043f\u0440\u044b\u043c\u0443 \u0432\u0430\u0441, \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u043c \u0410\u0439\u0446\u043e\u043c, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u043d\u0435 \u0441\u044b\u043d\u0430\u043c\u0456 \u0456 \u0434\u043e\u0447\u043a\u0430\u043c\u0456&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043c\u0430\u044e\u0447\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u0430\u0447\u044b\u0441\u0446\u0456\u043c \u0441\u044f\u0431\u0435 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443 \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0445\u0430, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u045e \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 14b. 16; 1 \u041a\u0430\u0440 3, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0430\u044f \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0437 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u043c? \u0428\u0442\u043e \u0437\u0430 \u0437\u0433\u043e\u0434\u0430 \u043f\u0430\u043c\u0456\u0436 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0411\u044d\u043b\u0456\u0430\u0440\u0430\u043c? <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b &ndash; \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0426\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0432\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0436\u0430\u044f \u0456 \u0448\u0442\u043e \u0411\u043e\u0436\u044b \u0414\u0443\u0445 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b &ndash; \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"171","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">7, 2-16<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0432\u0435\u043b \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044e \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u043d\u0430\u0441! \u041c\u044b \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u043b\u0456, \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0430\u0448\u0443\u043a\u0430\u043b\u0456, \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u043b\u0456. \u041d\u0435 \u0434\u043b\u044f \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f \u043a\u0430\u0436\u0443, \u0431\u043e \u044f \u0440\u0430\u043d\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0432\u044b \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0440\u0430\u0437\u0430\u043c \u0436\u044b\u0446\u044c. \u0412\u044f\u043b\u0456\u043a\u0430\u0435 \u045e \u043c\u044f\u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0432\u0430\u0441, \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u043d\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u0430 \u0437\u0430 \u0432\u0430\u0441. \u042f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c, \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0443\u0446\u0456\u0441\u043a\u0443 \u043d\u0430\u0448\u044b\u043c. \u0411\u043e, \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u044e, \u0446\u0435\u043b\u0430 \u043d\u0430\u0448\u0430\u0435 \u043d\u0435 \u043c\u0435\u043b\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0430\u043b\u0451\u0433\u043a\u0456, \u0430\u043b\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u043b\u0456: \u0437\u0432\u043e\u043d\u043a\u0443 &ndash; \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0443\u043d\u0443\u0442\u0440\u044b &ndash; \u0431\u043e\u044f\u0437\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u0445, \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u043d\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0426\u0456\u0442\u0430. I \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c, \u0430\u043b\u0435 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c, \u044f\u043a\u0456\u043c \u0451\u043d \u0446\u0435\u0448\u044b\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u0430\u0431 \u0432\u0430\u0448\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0432\u0430\u0448\u044b\u043c \u043f\u043b\u0430\u0447\u044b, \u0432\u0430\u0448\u044b\u043c \u043a\u043b\u043e\u043f\u0430\u0446\u0435 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u0442\u0430\u043c\u0443 \u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u0456 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e \u0432\u0430\u0441 \u0443 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456, \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e. \u041a\u0430\u043b\u0456 \u0456 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, &ndash; \u0431\u043e \u0431\u0430\u0447\u0443, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u043d\u0430 \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u0441 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0430 \u0432\u0430\u0441, &ndash; \u0446\u044f\u043f\u0435\u0440 \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u044b \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0448\u0442\u043e \u0432\u044b \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f \u0434\u043b\u044f \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f. \u0412\u044b \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u043a\u0430\u0431 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043c\u0435\u0446\u044c \u0430\u0434 \u043d\u0430\u0441 \u0448\u043a\u043e\u0434\u044b. \u0411\u043e \u0433\u044d\u0442\u044b \u0441\u043c\u0443\u0442\u0430\u043a \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u044f\u0433\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u0446\u044c, \u0431\u043e \u0451\u043d \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430 \u0441\u043c\u0443\u0442\u0430\u043a \u0441\u0432\u0435\u0442\u0443 \u043d\u044f\u0441\u0435 \u0441\u043c\u0435\u0440\u0446\u044c. \u0412\u043e\u0441\u044c \u0436\u0430 \u0441\u0430\u043c \u0441\u0443\u043c, \u044f\u043a\u0456 \u0437\u0433\u043e\u0434\u043d\u044b \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0432\u0430\u0441, \u0430\u0431\u0430\u0440\u043e\u043d\u0443, \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435, \u0431\u043e\u044f\u0437\u044c, \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u043b\u043e\u043f\u0430\u0442, \u0430\u0434\u043f\u043b\u0430\u0442\u0443! \u0412\u0430 \u045e\u0441\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u044f \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u0442\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u0435\u043b\u044f \u0456 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0436\u0430\u043d\u0430\u0433\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0430\u0431 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043c\u044b \u0441\u0443\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0426\u0456\u0442\u0430, \u0431\u043e \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u044f\u0433\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u043c \u0443\u0441\u0456\u043c. \u042f \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u045e \u0447\u044b\u043c \u0445\u0432\u0430\u043b\u0456\u045e\u0441\u044f \u0432\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c, \u0430\u043b\u0435, \u044f\u043a \u0443\u0441\u0451 \u043c\u044b \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0430\u043c, \u0442\u0430\u043a \u0456 \u043f\u0435\u0440\u0430\u0434 \u0426\u0456\u0442\u0430\u043c \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u044f \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439. \u0406 \u0441\u044d\u0440\u0446\u0430 \u044f\u0433\u043e \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0445\u0456\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441, \u043a\u0430\u043b\u0456 \u0451\u043d \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435 \u0430\u0431 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441, \u044f\u043a \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u0433\u043e \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c. \u042f \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0448\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0430\u0433\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u041a\u0430\u0440 7, 10. 9b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u044b \u0441\u043c\u0443\u0442\u0430\u043a \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u0451\u043d \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0430 \u0441\u043c\u0443\u0442\u0430\u043a \u0441\u0432\u0435\u0442\u0443 \u043d\u044f\u0441\u0435 \u0441\u043c\u0435\u0440\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u043a\u0430\u0431 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043c\u0435\u0446\u044c \u0430\u0434 \u043d\u0430\u0441 \u0448\u043a\u043e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0441\u043c\u0443\u0442\u0430\u043a \u0441\u0432\u0435\u0442\u0443 \u043d\u044f\u0441\u0435 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"172","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">8, 1-24<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0432\u0435\u043b \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0430\u0431 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0435 \u0434\u043b\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0435\u043c \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430 \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0436\u0443\u044e, \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456. \u0411\u043e \u045e \u0446\u044f\u0436\u043a\u0456\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u045e\u0446\u0456\u0441\u043a\u0430\u043c \u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u045e\u0431\u043e\u0441\u0442\u0432\u0430 \u0432\u044b\u043b\u0456\u043b\u0456\u0441\u044f \u045e \u0448\u0447\u043e\u0434\u0440\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456\u0445\u043d\u044f\u0439 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456. \u0421\u0432\u0435\u0434\u0447\u0443, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0456 \u043f\u0430-\u043d\u0430\u0434 \u0441\u0456\u043b\u044b \u0431\u044b\u043b\u0456 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u044b\u043c\u0456 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u045e \u043d\u0430\u0441 \u043b\u0430\u0441\u043a\u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u0445. \u0406 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u043d\u0430 \u0448\u0442\u043e \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0437 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0434\u0430\u0440\u0443\u0447\u044b\u043b\u0456 \u041f\u0430\u043d\u0443, \u0430 \u0437\u0430\u0442\u044b\u043c \u043d\u0430\u043c. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0426\u0456\u0442\u0430, \u043a\u0430\u0431 \u0451\u043d, \u044f\u043a \u043f\u0430\u0447\u0430\u045e, \u0442\u0430\u043a \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u045e \u0443 \u0432\u0430\u0441 \u0456 \u0433\u044d\u0442\u0443\u044e \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u045e\u0441\u0456\u043c: \u0432\u0435\u0440\u0430\u044e \u0456 \u0441\u043b\u043e\u0432\u0430\u043c, \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c, \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e, \u0456 \u043b\u044e\u0431\u043e\u045e\u044e \u0432\u0430\u0448\u0430\u044e \u0434\u0430 \u043d\u0430\u0441, \u0442\u043e \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439. \u041d\u0435 \u043a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u044f\u043a \u0437\u0430\u0433\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456\u043d\u0448\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0411\u043e \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u0432\u044b \u043b\u0430\u0441\u043a\u0443 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0448\u0442\u043e \u0401\u043d, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0431\u0430\u0433\u0430\u0442\u044b, \u0441\u0442\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u042f\u0433\u043e\u043d\u044b\u043c \u0443\u0431\u043e\u0441\u0442\u0432\u0430\u043c. \u042f \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e \u0441\u0432\u0430\u0451 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0432\u0430\u0441, \u044f\u043a\u0456\u044f \u0437 \u043c\u0456\u043d\u0443\u043b\u0430\u0433\u0430 \u0433\u043e\u0434\u0430 \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0456 \u0445\u0430\u0446\u0435\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0434\u0430\u0432\u044f\u0434\u0437\u0456\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u0443 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u043a\u0430\u0431 \u0430\u0445\u0432\u043e\u0447\u0430\u044f \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u043f\u0430 \u043c\u0435\u0440\u044b \u0432\u0430\u0448\u044b\u0445 \u0441\u0440\u043e\u0434\u043a\u0430\u045e. \u0411\u043e \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c, \u044f\u043d\u0430 \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0435\u0445\u0442\u0430 \u043c\u0430\u0435, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0435. \u0411\u043e \u043d\u0435 \u043f\u0440\u0430 \u0442\u043e\u0435 \u0433\u0430\u0432\u043e\u0440\u043a\u0430, \u043a\u0430\u0431 \u0432\u044b \u0440\u0430\u0431\u0456\u043b\u0456 \u043f\u0430\u043b\u0451\u0433\u043a\u0443 \u0456\u043d\u0448\u044b\u043c, \u0430 \u0441\u044f\u0431\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u043b\u0456 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044c. \u0426\u044f\u043f\u0435\u0440 \u0432\u0430\u0448 \u0434\u0430\u0441\u0442\u0430\u0442\u0430\u043a \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0456\u0445 \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u043a\u0430\u0431 \u0456\u0445\u043d\u0456 \u0434\u0430\u0441\u0442\u0430\u0442\u0430\u043a \u0434\u0430\u043f\u0430\u043c\u043e\u0433 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0448\u0430\u0439 \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044c, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0442\u043e \u0441\u0430\u0431\u0440\u0430\u045e \u0448\u043c\u0430\u0442, \u043d\u0435 \u043c\u0435\u045e \u043b\u0456\u0448\u043a\u0443; \u0456 \u0445\u0442\u043e &ndash; \u043c\u0430\u043b\u0430, \u043d\u0435 \u043c\u0435\u045e \u043d\u044f\u0441\u0442\u0430\u0447\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0441\u044d\u0440\u0446\u0430 \u0426\u0456\u0442\u0430 \u0442\u0430\u043a\u0456\u043c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c \u043f\u0440\u0430 \u0432\u0430\u0441, \u0431\u043e \u0451\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u0437\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u044f, \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0432\u0430\u0441. \u0417 \u0456\u043c \u043c\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u043e\u0433\u0430 \u0445\u0432\u0430\u043b\u044f\u0446\u044c \u0443\u0441\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u044b \u0437\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0451\u043d \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0440\u0443\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c\u0456, \u043a\u0430\u0431 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0446\u044c \u043d\u0430\u043c \u0443 \u0442\u043e\u0439 \u043b\u0430\u0441\u0446\u044b, \u044f\u043a\u043e\u0439 \u043c\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u043c \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u0441\u0430\u043c\u043e\u0433\u0430 \u041f\u0430\u043d\u0430, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u045e \u043d\u0430\u0441 \u0445\u0442\u043e \u0437\u0430 \u0442\u0430\u043a\u043e\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0434\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435. \u0411\u043e \u043c\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u043c\u0441\u044f \u0430\u0431 \u0434\u043e\u0431\u0440\u044b\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0430\u043b\u0435 \u0456 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u041c\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0437 \u0456\u043c\u0456 \u0431\u0440\u0430\u0442\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0448\u043c\u0430\u0442 \u0443 \u0447\u044b\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u044f\u0433\u043e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u044f, \u0431\u043e \u043c\u0430\u0435 \u043d\u0430 \u0432\u0430\u0441 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0434\u0430 \u0426\u0456\u0442\u0430, \u0442\u043e \u0433\u044d\u0442\u0430 \u043c\u043e\u0439 \u0442\u0430\u0432\u0430\u0440\u044b\u0448 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441. \u0410 \u0448\u0442\u043e \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u0442\u043e \u044f\u043d\u044b \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e, \u0441\u043b\u0430\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u0430\u0436\u044b\u0446\u0435 \u0456\u043c \u0432\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0456 \u0441\u043b\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0433\u043e\u043d\u0430\u0440\u0443 \u0437\u0430 \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 8, 9; \u0424\u043b\u043f 2, 7\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u043b\u0430\u0441\u043a\u0443 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0448\u0442\u043e \u0401\u043d, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0431\u0430\u0433\u0430\u0442\u044b, \u0441\u0442\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0432\u044b \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u042f\u0433\u043e\u043d\u044b\u043c \u0443\u0431\u043e\u0441\u0442\u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u044b \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u042f\u0433\u043e\u043d\u044b\u043c \u0443\u0431\u043e\u0441\u0442\u0432\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"173","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">9, 1-15<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0443\u0445\u043e\u045e\u043d\u044b \u043f\u043b\u0451\u043d \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436 \u043b\u0456\u0448\u043d\u0435 \u043f\u0456\u0441\u0430\u0446\u044c \u0434\u0430 \u0432\u0430\u0441 \u0430\u0431 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0441\u0432\u044f\u0442\u044b\u043c, \u0431\u043e \u044f \u0432\u0435\u0434\u0430\u044e \u0432\u0430\u0448\u0443\u044e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u0445\u0432\u0430\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u043c\u0430\u043a\u0435\u0434\u043e\u043d\u0446\u0430\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u0410\u0445\u0430\u044f \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u044f\u0448\u0447\u044d \u0437 \u043c\u0456\u043d\u0443\u043b\u0430\u0433\u0430 \u0433\u043e\u0434\u0443. \u0406 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u043b\u0430 \u043c\u043d\u043e\u0433\u0456\u0445. \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u0431\u0440\u0430\u0442\u043e\u045e, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u0435 \u0445\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0432\u0430\u043c\u0456 \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u0434\u0430\u0440\u044d\u043c\u043d\u044b\u043c \u0443 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b, \u044f\u043a \u043a\u0430\u0437\u0430\u045e \u044f, \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f. \u0406 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e \u043c\u0430\u043a\u0435\u0434\u043e\u043d\u0446\u044b \u0456 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0432\u0430\u0441 \u043d\u0435\u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u043c\u0456, \u043a\u0430\u0431 \u043c\u044b &ndash; \u043d\u0435 \u043a\u0430\u0436\u0443 \u0432\u044b &ndash; \u043d\u0435 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u043b\u0456\u0441\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0430\u043a\u043e\u0439 \u0443\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u043e\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0440\u0430\u043d\u0435\u0439 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0432\u0430\u0441 \u0456 \u0437\u0430\u0433\u0430\u0434\u0437\u044f \u043f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u044b \u0432\u0430\u043c \u0434\u0430\u0440, \u043a\u0430\u0431 \u0451\u043d \u0431\u044b\u045e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0442\u0430\u043a, \u044f\u043a \u0434\u0430\u0440, \u0430 \u043d\u0435 \u044f\u043a \u0432\u044b\u043c\u0430\u0433\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0441\u0435\u0435 \u0441\u043a\u0443\u043f\u0430, \u0442\u043e\u0439 \u0441\u043a\u0443\u043f\u0430 \u0456 \u043f\u0430\u0436\u043d\u0435, \u0430 \u0445\u0442\u043e \u0441\u0435\u0435 \u0448\u0447\u043e\u0434\u0440\u0430, \u0442\u043e\u0439 \u0448\u0447\u043e\u0434\u0440\u0430 \u0456 \u043f\u0430\u0436\u043d\u0435. \u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0434\u0430\u0435, \u044f\u043a \u0432\u044b\u0440\u0430\u0448\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c, \u0430 \u043d\u0435 \u0441\u0430 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0446\u0456 \u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443, \u0431\u043e \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0433\u0430 \u0434\u0430\u045e\u0446\u0443 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433. \u0411\u043e\u0433 \u043c\u0430\u0435 \u043c\u043e\u0446 \u0443\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043a\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u044e, \u043a\u0430\u0431 \u0432\u044b, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0430\u044e\u0447\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0434\u0430\u0441\u0442\u0430\u0442\u0430\u043a, \u0431\u044b\u043b\u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u044f \u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0434\u043e\u0431\u0440\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0420\u0430\u0441\u043a\u0456\u0434\u0430\u045e, \u0440\u0430\u0437\u0434\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u044f \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0435 \u0441\u0435\u0439\u0431\u0456\u0442\u0443 \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u0456 \u0445\u043b\u0435\u0431 \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u0434\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435, \u0456 \u045e\u0437\u0440\u0430\u0441\u0446\u0456\u0446\u044c \u043f\u043b\u0451\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439. \u041a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u044b \u0431\u044b\u043b\u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u043d\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441 \u0434\u0430 \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u043f\u0430\u0434\u0437\u044f\u043a\u0456 \u0411\u043e\u0433\u0443, &ndash; \u0431\u043e \u0433\u044d\u0442\u0430\u0435 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0442\u043e\u0435, \u0443 \u0447\u044b\u043c \u043c\u0430\u044e\u0446\u044c \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0441\u0432\u044f\u0442\u044b\u044f, \u0430\u043b\u0435 \u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0437\u0430 \u043c\u043d\u043e\u0433\u0430\u0435 \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443. \u0411\u043e \u043f\u0440\u0430\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u044f\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0411\u043e\u0433\u0430 \u0437\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0435 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0437\u0430 \u0448\u0447\u044b\u0440\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0437 \u0456\u043c\u0456 \u0456 \u0437 \u0443\u0441\u0456\u043c\u0456. \u042f\u043d\u044b \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u0437\u0430 \u0432\u0430\u0441, \u0431\u043e \u0445\u043e\u0447\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0432\u0430\u043c\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0443 \u0432\u0430\u0441. \u041f\u0430\u0434\u0437\u044f\u043a\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0433\u0443 \u0437\u0430 \u042f\u0433\u043e \u043d\u044f\u0432\u044b\u043c\u043e\u045e\u043d\u044b \u0434\u0430\u0440.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 6, 38; 2 \u041a\u0430\u0440 9, 7\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0432\u0430\u0439\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c: \u043c\u0435\u0440\u0443 \u0434\u043e\u0431\u0440\u0443\u044e, \u0443\u0446\u0456\u0441\u043d\u0443\u0442\u0443\u044e, \u0443\u0442\u0440\u044d\u0441\u0435\u043d\u0443\u044e \u0456 \u0437 \u0432\u0435\u0440\u0445\u0430\u043c \u0430\u0434\u0441\u044b\u043f\u043b\u044e\u0446\u044c \u0432\u0430\u043c \u0443 \u043f\u0430\u0434\u043e\u043b \u0432\u0430\u0448. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u044f\u043a\u043e\u0439 \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u0439 \u0456 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0434\u0430\u0435, \u044f\u043a \u0432\u044b\u0440\u0430\u0448\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c, \u0430 \u043d\u0435 \u0441\u0430 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0446\u0456 \u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u044f\u043a\u043e\u0439 \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u0439 \u0456 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"174","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">10, 1 &ndash; 11, 6<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u0430\u043b\u043e\u0433\u0456\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u042f, \u041f\u0430\u0432\u0435\u043b, \u044f\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0446\u0456\u0445\u0456, \u0430 \u043a\u0430\u043b\u0456 \u0434\u0430\u043b\u0451\u043a\u0430 &ndash; \u0441\u0443\u0440\u043e\u0432\u044b \u0434\u0430 \u0432\u0430\u0441, \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u041f\u0440\u0430\u0448\u0443, \u043a\u0430\u0431 \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043d\u0435 \u0431\u044b\u0446\u044c \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0441\u0443\u0440\u043e\u0432\u044b\u043c, \u044f\u043a \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u0448\u0442\u043e \u0430\u0434\u0432\u0430\u0436\u0432\u0430\u044e\u0441\u044f \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445, \u044f\u043a\u0456\u044f \u043b\u0456\u0447\u0430\u0446\u044c, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430. \u0416\u044b\u0432\u0443\u0447\u044b \u045e \u0446\u0435\u043b\u0435, \u043c\u044b \u0432\u0430\u044e\u0435\u043c \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0431\u043e \u0437\u0431\u0440\u043e\u044f \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f, \u0430\u043b\u0435 \u043c\u043e\u0446\u043d\u0430\u044f \u0411\u043e\u0433\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f\u045e. \u0401\u0439 \u043c\u044b \u0440\u0443\u0439\u043d\u0443\u0435\u043c \u0437\u0430\u0434\u0443\u043c\u044b \u0456 \u045e\u0441\u044f\u043a\u0430\u0435 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435, \u0448\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430, \u0456 \u0431\u044f\u0440\u043e\u043c \u0443 \u043f\u0430\u043b\u043e\u043d \u0443\u0441\u044f\u043a\u0443\u044e \u0434\u0443\u043c\u043a\u0443 \u0434\u043b\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0443. \u041c\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u0443\u044e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u0430\u0448\u0430\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u043f\u043e\u045e\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456. \u0425\u0442\u043e \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b \u045e \u0441\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u043d \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0442\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e, \u044f\u043a \u0451\u043d \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0442\u0430\u043a \u0456 \u043c\u044b. \u041a\u0430\u043b\u0456 \u0431 \u044f \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u045e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u0439, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0434\u0430\u045e \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435 \u0434\u043b\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0432\u0430\u0441, \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b. \u041d\u0435 \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u044f \u043f\u0430\u043b\u043e\u0445\u0430\u044e \u0432\u0430\u0441 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u043c\u0456. \u0411\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043a\u0430\u0436\u0430: &laquo;\u042f\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0446\u044f\u0436\u043a\u0456\u044f \u0456 \u0432\u043e\u0441\u0442\u0440\u044b\u044f, \u0430 \u043a\u0430\u043b\u0456 \u0441\u0430\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0442\u043e \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b \u0456 \u0441\u043b\u043e\u0432\u044b \u044f\u0433\u043e \u0441\u043b\u0430\u0431\u044b\u044f&raquo;. \u0422\u0430\u043a\u0456 \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e, \u044f\u043a\u0456\u044f \u043c\u044b \u045e \u0441\u043b\u043e\u0432\u0430\u0445 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437 \u0432\u0430\u043c\u0456, \u0442\u0430\u043a\u0456\u044f \u0456 \u045e \u0447\u044b\u043d\u0430\u0445, \u043a\u0430\u043b\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043c\u044b \u043d\u0435 \u0430\u0434\u0432\u0430\u0436\u0430\u0435\u043c\u0441\u044f \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u043e\u0431\u0430\u0447 \u0437 \u0442\u044b\u043c\u0456, \u044f\u043a\u0456\u044f \u0441\u0430\u043c\u0456 \u0441\u044f\u0431\u0435 \u0445\u0432\u0430\u043b\u044f\u0446\u044c, \u0446\u0456 \u0440\u0430\u045e\u043d\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456. \u0422\u044b\u044f, \u0448\u0442\u043e \u043c\u0435\u0440\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u0430\u0431\u043e\u044e \u0456 \u043f\u0430\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0437 \u0441\u0430\u0431\u043e\u044e, \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f. \u0410 \u043c\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0431\u0435\u0437 \u043c\u0435\u0440\u044b, \u0430\u043b\u0435 \u045e \u0442\u043e\u0439 \u043c\u0435\u0440\u044b, \u044f\u043a\u0443\u044e \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u043c \u0411\u043e\u0433, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0456 \u0432\u0430\u0441. \u0411\u043e \u043c\u044b \u043d\u0435 \u0432\u044b\u0441\u0456\u043b\u044c\u0432\u0430\u0435\u043c\u0441\u044f \u043f\u0440\u0430\u0437 \u043c\u0435\u0440\u0443, \u044f\u043a \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043d\u0435 \u0434\u0430\u0439\u0448\u043e\u045e\u0448\u044b \u0434\u0430 \u0432\u0430\u0441, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043c\u044b \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0432\u0430\u0441 \u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u041c\u044b \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u043c\u0441\u044f \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430 \u0447\u0443\u0436\u043e\u0439 \u043f\u0440\u0430\u0446\u0430\u0439, \u0430\u043b\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0437 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439 \u0456 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0446\u0451\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0448\u0430\u0439 \u043c\u0435\u0440\u044b \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0456\u043d\u0448\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443, \u0431\u043e \u043f\u0440\u0430\u0432\u0435\u0440\u0430\u043d\u044b \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u044c, \u0430\u043b\u0435 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0436\u0430 \u0432\u044b \u0445\u043e\u0446\u044c \u043a\u0440\u044b\u0445\u0443 \u0431\u044b\u043b\u0456 \u043f\u0430\u0431\u043b\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0434\u0430 \u043c\u0430\u0451\u0439 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0410\u043b\u0435 \u0432\u044b \u0456 \u0442\u0430\u043a \u043f\u0430\u0431\u043b\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0434\u0430 \u043c\u044f\u043d\u0435! \u0411\u043e \u044f \u0440\u0443\u043f\u043b\u044e\u0441\u044f \u0430\u0431 \u0432\u0430\u0441 \u0440\u0443\u043f\u043d\u0430\u0441\u0446\u044e \u0411\u043e\u0436\u0430\u044e, \u0431\u043e \u044f \u0437\u0430\u0440\u0443\u0447\u044b\u045e \u0432\u0430\u0441 \u0437 \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u043c\u0443\u0436\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a \u0447\u044b\u0441\u0442\u0443\u044e \u0434\u0437\u0435\u0432\u0443. \u0410\u0434\u043d\u0430\u043a \u0431\u0430\u044e\u0441\u044f, \u043a\u0430\u0431 \u0442\u0430\u043a, \u044f\u043a \u0437\u043c\u0435\u0439 \u0445\u0456\u0442\u0440\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u045e \u0415\u0432\u0443, \u043d\u0435 \u0431\u044b\u043b\u0456 \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u0430\u0434 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0411\u043e \u0432\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435 \u0432\u0430\u043c \u0456\u043d\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043b\u0456, \u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0456\u043d\u0448\u0430\u0433\u0430 \u0434\u0443\u0445\u0430, \u0430 \u043d\u0435 \u0442\u0430\u0433\u043e, \u044f\u043a\u043e\u0433\u0430 \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456, \u0446\u0456 \u0456\u043d\u0448\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430 \u043d\u0435 \u0442\u043e\u0435, \u044f\u043a\u043e\u0435 \u045e\u0436\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456. \u0410\u043b\u0435 \u0434\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u044f \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u043d\u0456\u0436\u044d\u0439\u0448\u044b \u0437\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u0425\u043e\u0446\u044c \u044f \u0456 \u043d\u0435\u0432\u0443\u043a \u0443 \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u0441\u0442\u0432\u0435, \u0430\u043b\u0435 \u043d\u0435 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456. \u0423\u0440\u044d\u0448\u0446\u0435, \u0443\u0441\u044f\u043b\u044f\u043a \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u044b \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 10, 3-4\u0430; \u042d\u0444 6, 16\u0430. 17b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0432\u0443\u0447\u044b \u045e \u0446\u0435\u043b\u0435, \u043c\u044b \u0432\u0430\u044e\u0435\u043c \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0437\u0431\u0440\u043e\u044f \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0448\u0447\u044b\u0442 \u0432\u0435\u0440\u044b \u0456 \u043c\u0435\u0447 \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0437\u0431\u0440\u043e\u044f \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"175","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">11, 7-29<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0426\u0456 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u044f \u0442\u044b\u043c, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u045e \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u0432\u0430\u0441, \u0431\u043e \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435? \u042f \u0430\u0434\u0431\u0456\u0440\u0430\u045e \u0443 \u0456\u043d\u0448\u044b\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043f\u043b\u0430\u0442\u0443, \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0432\u0430\u043c. \u0411\u0443\u0434\u0443\u0447\u044b \u045e \u0432\u0430\u0441 \u0434\u044b \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u043d\u044f\u0441\u0442\u0430\u0447\u0443, \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0435 \u0434\u0430\u043a\u0443\u0447\u0430\u045e, \u0431\u043e \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043c\u0430\u0435 \u043f\u0430\u043a\u0440\u044b\u043b\u0456 \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0437 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456. \u0414\u044b \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u044f \u0441\u0442\u0430\u0440\u0430\u045e\u0441\u044f \u0456 \u0441\u0442\u0430\u0440\u0430\u044e\u0441\u044f \u043d\u0435 \u0431\u044b\u0446\u044c \u0434\u043b\u044f \u0432\u0430\u0441 \u0446\u044f\u0436\u0430\u0440\u0430\u043c. \u042f\u043a \u0451\u0441\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u044f, \u0442\u0430\u043a \u0433\u044d\u0442\u0430\u044f \u043f\u0430\u0445\u0432\u0430\u043b\u0430 \u043c\u0430\u044f \u043d\u0435 \u0441\u0446\u0456\u0445\u043d\u0435 \u045e \u0437\u0435\u043c\u043b\u044f\u0445 \u0410\u0445\u0430\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443? \u0426\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u043b\u044e \u0432\u0430\u0441? \u0411\u043e\u0433 \u0432\u0435\u0434\u0430\u0435! \u0410\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u0430\u0431\u043b\u044e, \u0431\u0443\u0434\u0443 \u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u043b\u0435\u0439, \u043a\u0430\u0431 \u043d\u0435 \u0434\u0430\u0446\u044c \u0436\u0430\u0434\u0430\u044e\u0447\u044b\u043c \u043d\u0430\u0433\u043e\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0447\u044b\u043c \u0445\u0432\u0430\u043b\u0456\u043c\u0441\u044f \u043c\u044b. \u0411\u043e \u0442\u0430\u043a\u0456\u044f \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044b, &ndash; \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u044f \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u045e\u0434\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0437\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430. I \u043d\u0435 \u0434\u0437\u0456\u0432\u0430, \u0431\u043e \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c \u0441\u0430\u0442\u0430\u043d\u0430 \u045e\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u0437\u0430 \u0430\u043d\u0451\u043b\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0442\u043e \u0456 \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e \u045e\u0434\u0430\u044e\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041a\u0430\u043d\u0435\u0446 \u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0443, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043c\u044f\u043d\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0435, \u0442\u043e \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u043c\u044f\u043d\u0435 \u044f\u043a \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u0456 \u043c\u043d\u0435 \u043a\u0440\u044b\u0445\u0443 \u0447\u044b\u043c \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430. \u0428\u0442\u043e \u043a\u0430\u0436\u0443, \u0442\u043e\u0435 \u043a\u0430\u0436\u0443 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u044f\u043a \u0431\u044b \u045e \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0435, \u043c\u0430\u044e\u0447\u044b \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0443 \u0434\u043b\u044f \u043f\u0430\u0445\u0432\u0430\u043b\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u0445\u0432\u0430\u043b\u044f\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430. \u0411\u043e \u0432\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c\u0456, \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0446\u0435\u0440\u043f\u0456\u0446\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445. \u0426\u0435\u0440\u043f\u0456\u0446\u0435, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u0430\u0441 \u0437\u043d\u044f\u0432\u043e\u043b\u044c\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0431&rsquo;\u044f\u0434\u0430\u0435, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u045e\u0437\u0432\u044b\u0448\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431&rsquo;\u0435 \u0432\u0430\u0441 \u043f\u0430 \u0442\u0432\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443 \u0437 \u0441\u043e\u0440\u0430\u043c\u0430\u043c, \u0448\u0442\u043e \u043c\u044b \u044f\u043a \u0431\u044b\u0446\u0446\u0430\u043c \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u044b\u044f. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0430\u0434\u0432\u0430\u0436\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u0447\u044b\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0442\u043e, \u043a\u0430\u0436\u0443\u0447\u044b \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0430\u0434\u0432\u0430\u0436\u0443\u0441\u044f \u0456 \u044f. \u042f\u043d\u044b \u0433\u0430\u0431\u0440\u044d\u0456? \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430. \u042f\u043d\u044b \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435? \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430. \u042f\u043d\u044b \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430? \u0406 \u044f. \u042f\u043d\u044b \u0441\u043b\u0443\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u0430? \u041d\u0456\u0431\u044b \u0448\u0430\u043b\u0451\u043d\u044b \u043a\u0430\u0436\u0443, \u044f \u0431\u043e\u043b\u044c\u0448: \u0431\u043e\u043b\u044c\u0448 \u0443 \u043f\u0440\u0430\u0446\u044b, \u0431\u043e\u043b\u044c\u0448 \u0443 \u0446\u044f\u043c\u043d\u0456\u0446\u0430\u0445, \u0443 \u0440\u0430\u043d\u0430\u0445 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u044b\u0445 \u0456 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u043f\u0440\u044b \u0441\u043c\u0435\u0440\u0446\u0456. \u0410\u0434 \u044e\u0434\u044d\u044f\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u044f \u043f\u044f\u0446\u044c \u0440\u0430\u0437\u043e\u045e \u043f\u0430 \u0441\u043e\u0440\u0430\u043a \u0443\u0434\u0430\u0440\u0430\u045e \u0431\u0435\u0437 \u0430\u0434\u043d\u0430\u0433\u043e. \u0422\u0440\u043e\u0439\u0447\u044b \u043c\u044f\u043d\u0435 \u0431\u0456\u043b\u0456 \u043a\u0456\u044f\u043c\u0456, \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043b\u0456, \u0442\u0440\u043e\u0439\u0447\u044b \u044f \u0446\u044f\u0440\u043f\u0435\u045e \u043a\u0430\u0440\u0430\u0431\u043b\u0435\u043a\u0440\u0443\u0448\u044d\u043d\u043d\u0435, \u043d\u043e\u0447 \u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u0430\u0431\u044b\u045e \u044f \u045e \u043c\u0430\u0440\u0441\u043a\u043e\u0439 \u0433\u043b\u044b\u0431\u0456\u043d\u0456. \u0427\u0430\u0441\u0442\u0430 \u0431\u044b\u045e \u0443 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430\u0445, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u0440\u044d\u043a\u0430\u0445, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0430\u0434 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0456\u043a\u0430\u045e, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0430\u0434 \u0441\u0443\u0430\u0439\u0447\u044b\u043d\u043d\u0456\u043a\u0430\u045e, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0430\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u043c\u043e\u0440\u044b, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0441\u044f\u0440\u043e\u0434 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0443 \u043f\u0440\u0430\u0446\u044b \u0456 \u0437\u043d\u044f\u043c\u043e\u0437\u0435, \u0447\u0430\u0441\u0442\u0430 \u045e \u043d\u0435\u0434\u0430\u0441\u044b\u043f\u0430\u043d\u043d\u0456, \u0443 \u0433\u043e\u043b\u0430\u0434\u0437\u0435 \u0456 \u0441\u043c\u0430\u0437\u0435, \u0447\u0430\u0441\u0442\u0430 \u045e \u043f\u043e\u0441\u0446\u0435, \u0443 \u0445\u043e\u043b\u0430\u0434\u0437\u0435 \u0456 \u0433\u0430\u043b\u0435\u0447\u044b. \u0410\u043a\u0440\u0430\u043c\u044f \u0456\u043d\u0448\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u043d\u0430 \u043c\u043d\u0435 \u0448\u0442\u043e\u0434\u043d\u044f \u043b\u044f\u0436\u044b\u0446\u044c \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0443\u0441\u0456\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u0445. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435, \u0446\u0456 \u044f \u043d\u0435 \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u044e? \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u0430\u0437\u043d\u0430\u0435 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0446\u0456 \u044f \u043d\u0435 \u043f\u0430\u043a\u0443\u0442\u0443\u044e?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 1, 11b. 12; 2 \u041a\u0430\u0440 11, 10\u0430. 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e, \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u0441\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u044f, \u0431\u043e \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"176","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">11, 30 &ndash; 12, 13<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u0442\u0440\u044d\u0431\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0442\u043e \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044e. \u0411\u043e\u0433 \u0456 \u0410\u0446\u0435\u0446 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456, \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u044f \u043d\u0435 \u0445\u043b\u0443\u0448\u0443. \u0423 \u0414\u0430\u043c\u0430\u0441\u043a\u0443 \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0440\u044d\u0442\u044b \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u045e \u0433\u043e\u0440\u0430\u0434 \u0434\u0430\u043c\u0430\u0441\u043a\u0456\u0439\u0446\u0430\u045e, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0441\u0445\u0430\u043f\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u043c\u044f\u043d\u0435 \u0441\u043f\u0443\u0441\u0446\u0456\u043b\u0456 \u045e \u043a\u0430\u0448\u044b \u043f\u0440\u0430\u0437 \u0430\u0434\u0442\u0443\u043b\u0456\u043d\u0443 \u045e \u043c\u0443\u0440\u044b, \u0456 \u044f \u045e\u0446\u0451\u043a \u0430\u0434 \u0440\u0443\u043a \u044f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u0440\u044d\u0431\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u0456 \u043d\u0435\u043a\u0430\u0440\u044b\u0441\u043d\u0430, \u0442\u043e \u043f\u0435\u0440\u0430\u0439\u0434\u0443 \u0434\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u044f\u045e \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u045e \u041f\u0430\u043d\u0430. \u0412\u0435\u0434\u0430\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u044f\u043a\u0456 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u0442\u0430\u043c\u0443 (\u0446\u0456 \u045e \u0446\u0435\u043b\u0435, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0446\u0456 \u043f\u0430-\u0437\u0430 \u0446\u0435\u043b\u0430\u043c, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433) \u0431\u044b\u045e \u0437\u0430\u0431\u0440\u0430\u043d\u044b \u0430\u0436 \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u043d\u0435\u0431\u0430. \u0406 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a (\u0446\u0456 \u045e \u0446\u0435\u043b\u0435, \u0446\u0456 \u043f\u0430-\u0437\u0430 \u0446\u0435\u043b\u0430\u043c, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433) \u0431\u044b\u045e \u0437\u0430\u0431\u0440\u0430\u043d\u044b \u045e \u0440\u0430\u0439 \u0456 \u0447\u0443\u045e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c. \u0413\u044d\u0442\u044b\u043c \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0430 \u0441\u0430\u0431\u043e\u044e \u043d\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044e\u0441\u044f, \u0445\u0456\u0431\u0430 \u0448\u0442\u043e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044e \u043c\u0430\u0451\u0439. \u041a\u0430\u043b\u0456 \u0437\u0430\u0445\u0430\u0447\u0443 \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u0435 \u0431\u0443\u0434\u0443 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c, \u0431\u043e \u0441\u043a\u0430\u0436\u0443 \u043f\u0440\u0430\u045e\u0434\u0443. \u0410\u043b\u0435 \u044f \u045e\u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0441\u044f, \u043a\u0430\u0431 \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u0443\u043c\u0430\u045e \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u0431\u043e\u043b\u0435\u0439, \u0447\u044b\u043c \u0443\u0432\u0430 \u043c\u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0430\u0431\u043e \u0447\u0443\u0435 \u0430\u0434 \u043c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u045e. \u0414\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0434\u0436\u0430\u043b\u0430 \u045e \u0446\u0435\u043b\u0430, \u043f\u0430\u0441\u043b\u0430\u043d\u0435\u0446 \u0441\u0430\u0442\u0430\u043d\u044b, \u043a\u0430\u0431 \u0431\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u045e\u0441\u044f. \u0422\u0430\u043c\u0443 \u044f \u0442\u0440\u043e\u0439\u0447\u044b \u043c\u0430\u043b\u0456\u045e \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0430\u0434\u0432\u0451\u045e \u0433\u044d\u0442\u0430 \u0430\u0434 \u043c\u044f\u043d\u0435. \u0410\u043b\u0435 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0425\u043e\u043f\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u041c\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u0431\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456&raquo;. \u041d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044e, \u043a\u0430\u0431 \u0436\u044b\u043b\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u043c\u043e\u0446 \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u043f\u0430\u0433\u0430\u0440\u0434\u0443, \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u0433\u0430\u043d\u0435\u043d\u043d\u0456 \u0456 \u045e\u0446\u0456\u0441\u043a \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e, \u043a\u0430\u043b\u0456 \u044f \u0441\u043b\u0430\u0431\u044b, \u0442\u0430\u0434\u044b \u043c\u043e\u0446\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u0442\u0430\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c. \u0412\u044b \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u043c\u0443\u0441\u0456\u043b\u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430. \u0411\u043e \u0433\u044d\u0442\u0430 \u0432\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u043c\u044f\u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u044c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0456 \u045e \u0447\u044b\u043c \u044f \u043d\u0435 \u0433\u043e\u0440\u0448\u044b \u0437\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0445\u043e\u0446\u044c \u044f \u0456 \u043d\u0456\u0448\u0442\u043e. \u0412\u043e\u0441\u044c \u0437\u043d\u0430\u043a\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0446\u0443\u0434\u044b \u0456 \u043c\u043e\u0446\u044b. \u0411\u043e \u045e \u0447\u044b\u043c \u0432\u044b \u0433\u043e\u0440\u0448\u044b\u044f \u0437\u0430 \u0456\u043d\u0448\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b? \u0425\u0456\u0431\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0430\u043c \u044f \u043d\u0435 \u0431\u044b\u045e \u0432\u0430\u043c \u0446\u044f\u0436\u0430\u0440\u0430\u043c. \u0414\u0430\u0440\u0443\u0439\u0446\u0435 \u043c\u043d\u0435 \u0433\u044d\u0442\u0443\u044e \u043a\u0440\u044b\u045e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 12, 9b\u0430; 4, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044e, \u043a\u0430\u0431 \u0436\u044b\u043b\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u043c\u043e\u0446 \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u043c\u0430\u0435\u043c \u0441\u043a\u0430\u0440\u0431 \u0443 \u0433\u043b\u0456\u043d\u044f\u043d\u044b\u0445 \u043d\u0430\u0447\u044b\u043d\u043d\u044f\u0445, \u043a\u0430\u0431 \u0432\u0435\u043b\u0456\u0447 \u043c\u043e\u0446\u044b \u0431\u044b\u043b\u0430 \u0411\u043e\u0436\u0430\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"177","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">12, 14 &ndash; 13, 13&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043b\u0456\u0437\u043a\u0456 \u0432\u0456\u0437\u0456\u0442 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0412\u043e\u0441\u044c, \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437 \u044f \u0433\u0430\u0442\u043e\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u0456 \u043d\u0435 \u0431\u044b\u0446\u044c \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0434\u043b\u044f \u0432\u0430\u0441, \u0431\u043e \u0448\u0443\u043a\u0430\u044e \u043d\u0435 \u0432\u0430\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u0432\u0430\u0441. \u0411\u043e \u043d\u0435 \u0434\u0437\u0435\u0446\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0434\u043b\u044f \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0430\u043b\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0434\u043b\u044f \u0434\u0437\u044f\u0446\u0435\u0439. \u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u043d\u044f\u0441\u0443 \u0432\u044b\u0434\u0430\u0442\u043a\u0456 \u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0430\u0434\u0434\u0430\u043c \u0437\u0430 \u0434\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f. \u041a\u0430\u043b\u0456 \u044f \u0431\u0443\u0434\u0443 \u043b\u044e\u0431\u0456\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0445\u0456\u0431\u0430 \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e \u043c\u0435\u043d\u0448 \u043b\u044e\u0431\u043e\u0432\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a. \u042f \u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u044b\u045e \u0432\u0430\u0441. \u0410\u043b\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u0445\u0456\u0442\u0440\u044b\u043c, \u044f \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0430\u043c \u0437\u0434\u0430\u0431\u044b\u045e \u0432\u0430\u0441. \u0426\u0456 \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0437 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0430\u0441\u044b\u043b\u0430\u045e \u0434\u0430 \u0432\u0430\u0441, \u044f \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u045e \u0432\u0430\u0441? \u042f \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0426\u0456\u0442\u0430 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0437 \u0456\u043c \u0431\u0440\u0430\u0442\u0430. \u0426\u0456 \u0426\u0456\u0442 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u045e \u0432\u0430\u0441? \u0426\u0456 \u043d\u0435 \u045e \u0442\u044b\u043c \u0436\u0430 \u0434\u0443\u0445\u0443 \u043c\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456? \u0426\u0456 \u043d\u0435 \u0442\u044b\u043c\u0456 \u0436 \u0441\u043b\u044f\u0434\u0430\u043c\u0456 \u0445\u0430\u0434\u0437\u0456\u043b\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u0434\u043e\u045e\u0433\u0456 \u0447\u0430\u0441 \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043c\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u043c\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456? \u041c\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435: \u0443\u0441\u0451, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u0411\u043e \u0431\u0430\u044e\u0441\u044f, \u043a\u0430\u0431 \u0447\u0430\u0441\u0430\u043c, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b, \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0432\u0430\u0441 \u043d\u0435 \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0445\u0430\u0447\u0443. \u0414\u044b \u0456 \u0432\u044b \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u043c\u044f\u043d\u0435, \u044f\u043a\u0456\u043c \u043d\u0435 \u0445\u043e\u0447\u0430\u0446\u0435. \u041a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0432\u0430\u0441 \u0441\u043f\u0440\u044d\u0447\u043a\u0456, \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u0433\u043d\u0435\u0432\u0443, \u0441\u0432\u0430\u0440\u0430\u043a, \u043f\u0430\u043a\u043b\u0451\u043f\u0430\u045e, \u0430\u0431\u043c\u043e\u0432\u0430\u045e, \u043f\u044b\u0445\u0456, \u0431\u044f\u0437\u043b\u0430\u0434\u0434\u0437\u044f. \u0406 \u043a\u0430\u043b\u0456 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0443, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043d\u0456\u0437\u0456\u045e \u043c\u044f\u043d\u0435 \u0411\u043e\u0433 \u043c\u043e\u0439 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u045e \u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u0437 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0440\u0430\u043d\u0435\u0439 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0430\u044f\u043b\u0456\u0441\u044f \u045e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0443 \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435 \u0456 \u045e \u0440\u0430\u0437\u0431\u044d\u0448\u0447\u0430\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0443\u044e \u045e\u0447\u044b\u043d\u0456\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437 \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443 \u0434\u0430 \u0432\u0430\u0441: \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0434\u0432\u0443\u0445 \u0446\u0456 \u0442\u0440\u043e\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. \u042f \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0440\u0430\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0443 \u0432\u0430\u0441 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437, \u0456 \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u0434\u0430\u043b\u0451\u043a\u0430, \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u044e \u0442\u044b\u043c, \u044f\u043a\u0456\u044f \u0440\u0430\u043d\u0435\u0439 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u0456 \u045e\u0441\u0456\u043c \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0443, \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u044e. \u0412\u044b \u0448\u0443\u043a\u0430\u0435\u0446\u0435 \u0434\u043e\u043a\u0430\u0437\u0443, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043d\u0435 \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456, \u0430\u043b\u0435 \u043c\u043e\u0446\u043d\u044b \u045e \u0432\u0430\u0441. \u0425\u043e\u0446\u044c \u0401\u043d \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u043f\u0440\u0430\u0437 \u0431\u044f\u0441\u0441\u0456\u043b\u043b\u0435, \u0430\u043b\u0435 \u0436\u044b\u0432\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439. \u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b\u044f \u045e \u0406\u043c, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439 \u0443 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0441\u0430\u043c\u044b\u0445 \u0441\u044f\u0431\u0435, \u0446\u0456 \u0432\u044b \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u0432\u0435\u0440\u044b? \u0421\u0430\u043c\u044b\u0445 \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0432\u044f\u0440\u0430\u0439\u0446\u0435. \u0426\u0456 \u0432\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0432\u0430\u0441? \u0410 \u043c\u043e\u0436\u0430, \u0432\u044b \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f? \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0432\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u0433\u043e\u0434\u043d\u044b\u044f. \u041c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430. \u041d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0433\u043e\u0434\u043d\u044b\u043c\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b \u0440\u0430\u0431\u0456\u043b\u0456 \u0434\u0430\u0431\u0440\u043e, \u0430 \u043c\u044b \u0431\u044b\u043b\u0456 \u044f\u043a \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f. \u041c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u043f\u0440\u0430\u045e\u0434\u044b. \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f, \u043a\u0430\u043b\u0456 \u043c\u044b \u0441\u043b\u0430\u0431\u044b\u044f, \u0430 \u0432\u044b \u043c\u043e\u0446\u043d\u044b\u044f. \u0410\u0431 \u0433\u044d\u0442\u044b\u043c \u0456 \u043c\u043e\u043b\u0456\u043c\u0441\u044f, \u0430\u0431 \u0432\u0430\u0448\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f \u0456 \u043f\u0456\u0448\u0443 \u0433\u044d\u0442\u0430\u0435, \u043a\u0430\u0431, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0441\u0443\u0440\u043e\u0432\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0434\u044b, \u044f\u043a\u0443\u044e \u0434\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435 \u0434\u043b\u044f \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0440\u044d\u0448\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u0441\u0443\u0446\u044f\u0448\u0430\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0441\u043f\u0430\u043a\u043e\u0456, \u0456 \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456. \u041f\u0440\u044b\u0432\u0456\u0442\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u043c. \u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430, \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 13, 11; \u0424\u043b\u043f 4, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u043a\u043e\u0439 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0440\u043e\u0437\u0443\u043c, \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u0443\u043c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"181","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0410\u043c\u043e\u0441\u0430  1, 1 \u2013 2, 3<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0443\u0434 \u041f\u0430\u043d\u0430 \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430 \u0410\u043c\u043e\u0441\u0430, \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u045e \u0437 \u0422\u044d\u043a\u043e\u0430, \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u045e \u0451\u043d \u043f\u0440\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0443 \u0434\u043d\u0456 \u0423\u0437\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u044f \u042e\u0434\u044b, \u0456 \u045e \u0434\u043d\u0456 \u0415\u0440\u0430\u0431\u0430\u0430\u043c\u0430, \u0441\u044b\u043d\u0430 \u042f\u0430\u0441\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437\u0430 \u0434\u0432\u0430 \u0433\u0430\u0434\u044b \u0434\u0430 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441\u0443. \u0401\u043d \u0441\u0430\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043d \u0437\u0430\u0433\u0440\u044b\u043c\u0456\u0446\u044c \u0437 \u0421\u0456\u0451\u043d\u0430 \u0456 \u043f\u0430\u0434\u0430\u0441\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0411\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u044c \u043f\u0430\u0448\u044b \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u045e \u0456 \u0432\u044b\u0441\u0430\u0445\u043d\u0435 \u0432\u044f\u0440\u0448\u044b\u043d\u044f \u041a\u0430\u0440\u043c\u044d\u043b\u044e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0414\u0430\u043c\u0430\u0441\u043a\u0430 \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u044f\u043d\u044b \u0430\u0431\u043c\u0430\u043b\u0430\u0446\u0456\u043b\u0456 \u0413\u0456\u043b\u0435\u0430\u0434 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c\u0456 \u0441\u0430\u043d\u044f\u043c\u0456. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u0434\u043e\u043c \u0425\u0430\u0437\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043f\u0430\u043b\u0430\u0446\u044b \u0411\u044d\u043d-\u0425\u0430\u0434\u0430\u0434\u0430. \u0417\u043b\u0430\u043c\u0430\u044e \u0437\u0430\u0441\u043e\u0432\u044b \u0414\u0430\u043c\u0430\u0441\u043a\u0430 \u0456 \u0432\u044b\u043d\u0456\u0448\u0447\u0443 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0411\u0456\u043a\u0430\u0442-\u0410\u0432\u044d\u043d\u0430 \u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u045e \u0411\u044d\u0442-\u042d\u0434\u044d\u043d\u0435, \u0430 \u043d\u0430\u0440\u043e\u0434 \u0410\u0440\u0430\u043c\u0430 \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u045e \u041a\u0456\u0440\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0413\u0430\u0437\u044b \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0433\u043d\u0430\u043b\u0456 \u045e\u0441\u0456\u0445 \u0443 \u043f\u0430\u043b\u043e\u043d, \u043a\u0430\u0431 \u0432\u044b\u0434\u0430\u0446\u044c \u042d\u0434\u043e\u043c\u0443. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u043c\u0443\u0440\u044b \u0413\u0430\u0437\u044b, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u044f\u0435 \u043f\u0430\u043b\u0430\u0446\u044b. \u0412\u044b\u043d\u0456\u0448\u0447\u0443 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0410\u0448\u0434\u043e\u0434\u0430 \u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u045e \u0410\u0448\u043a\u0435\u043b\u043e\u043d\u0435. \u0421\u043a\u0456\u0440\u0443\u044e \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042d\u043a\u0440\u043e\u043d\u0430 \u2013 \u0456 \u0437\u0430\u0433\u0456\u043d\u0435 \u0440\u044d\u0448\u0442\u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0422\u044b\u0440\u0430 \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u044f\u043d\u044b \u0430\u0434\u0434\u0430\u043b\u0456 \u045e\u0441\u0456\u0445 \u042d\u0434\u043e\u043c\u0443 \u045e \u043f\u0430\u043b\u043e\u043d \u0456 \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u043f\u0440\u0430 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0456 \u0441\u0430\u044e\u0437. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u043c\u0443\u0440\u044b \u0422\u044b\u0440\u0430, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u044f\u0433\u043e \u043f\u0430\u043b\u0430\u0446\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u042d\u0434\u043e\u043c\u0430 \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u0451\u043d \u0433\u043d\u0430\u045e \u043c\u044f\u0447\u043e\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u0456 \u0437\u0430\u0433\u0443\u0431\u0456\u045e \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u041f\u0430\u043b\u0430\u045e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0433\u043d\u0435\u0432\u0435, \u0456 \u0437\u043b\u043e\u0441\u0446\u044c \u044f\u0433\u043e \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u0422\u044d\u043c\u0430\u043d, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043f\u0430\u043b\u0430\u0446\u044b \u0411\u043e\u0441\u0440\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0441\u044b\u043d\u043e\u045e \u0410\u043c\u043e\u043d\u0430 \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u044f\u043d\u044b \u0440\u0430\u0441\u043f\u043e\u0440\u0432\u0430\u043b\u0456 \u0446\u044f\u0436\u0430\u0440\u043d\u044b\u0445 \u0413\u0456\u043b\u0435\u0430\u0434\u0430, \u043a\u0430\u0431 \u043f\u0430\u0448\u044b\u0440\u044b\u0446\u044c \u0441\u0432\u0430\u0435 \u043c\u0435\u0436\u044b. \u0422\u0430\u043c\u0443 \u0440\u0430\u0441\u043f\u0430\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u043c\u0443\u0440\u0430\u0445 \u0420\u0430\u0431\u0431\u044b, \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u044f\u0435 \u043f\u0430\u043b\u0430\u0446\u044b \u0441\u044f\u0440\u043e\u0434 \u043a\u0440\u044b\u043a\u0443 \u045e \u0434\u0437\u0435\u043d\u044c \u0431\u0456\u0442\u0432\u044b, \u0441\u044f\u0440\u043e\u0434 \u0432\u0456\u0445\u0443\u0440\u044b \u045e \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0440\u044b. \u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0456\u0445\u043d\u0456 \u043f\u043e\u0439\u0434\u0437\u0435 \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u043d\u044f\u0437\u044f\u043c\u0456\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u041c\u0430\u0430\u0431\u0430 \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u0451\u043d \u0441\u043f\u0430\u043b\u0456\u045e \u043a\u043e\u0441\u0442\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u044f \u042d\u0434\u043e\u043c\u0430 \u043d\u0430 \u0432\u0430\u043f\u043d\u0443. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u041c\u0430\u0430\u0431, \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043f\u0430\u043b\u0430\u0446\u044b \u041a\u0435\u0440\u044b\u0451\u0442\u0430. \u041c\u0430\u0430\u0431 \u043f\u0430\u043c\u0440\u044d \u0441\u044f\u0440\u043e\u0434 \u0448\u0443\u043c\u0443, \u043a\u0440\u044b\u043a\u0443 \u0456 \u043f\u0430\u0434 \u0433\u0443\u043a\u0456 \u0440\u043e\u0433\u0443. \u0412\u044b\u043d\u0456\u0448\u0447\u0443 \u0441\u0443\u0434\u0434\u0437\u044e \u0437 \u044f\u0433\u043e \u0430\u0441\u044f\u0440\u043e\u0434\u0434\u0437\u044f \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u044e \u045e\u0441\u0456\u0445 \u044f\u0433\u043e \u043a\u043d\u044f\u0437\u0451\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 9, 8b. 9; \u0410\u043c 1, 2\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0430\u043d \u0442\u0440\u043e\u043d \u0441\u0432\u043e\u0439 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0437\u0430\u0433\u0440\u044b\u043c\u0456\u0446\u044c \u0437 \u0421\u0456\u0451\u043d\u0430 \u0456 \u043f\u0430\u0434\u0430\u0441\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u0441\u0443\u0434\u0437\u0456\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"182","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u043c\u043e\u0441\u0430  2, 4-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u043e\u0436\u044b \u0441\u0443\u0434 \u043d\u0430\u0434 \u042e\u0434\u0430\u0439 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u042e\u0434\u044b \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0417\u0432\u0451\u045e \u0456\u0445 \u043f\u0430\u0434\u043c\u0430\u043d, \u0437\u0430 \u044f\u043a\u0456\u043c \u043f\u0430\u0439\u0448\u043b\u0456 \u0456\u0445\u043d\u0456\u044f \u0430\u0439\u0446\u044b. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u042e\u0434\u0443, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043f\u0430\u043b\u0430\u0446\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430 \u0442\u0440\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0437\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043d\u0435 \u0430\u0434\u043c\u044f\u043d\u044e \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u044f\u043d\u044b \u043f\u0440\u0430\u0434\u0430\u044e\u0446\u044c \u0437\u0430 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u2013 \u0437\u0430 \u043f\u0430\u0440\u0443 \u0441\u0430\u043d\u0434\u0430\u043b\u044f\u045e. \u0421\u0446\u0456\u0440\u0430\u044e\u0446\u044c \u0443 \u043f\u044b\u043b \u0437\u044f\u043c\u043d\u044b \u0433\u0430\u043b\u043e\u0432\u044b \u0431\u0435\u0434\u043d\u044b\u0445 \u0456 \u0448\u043b\u044f\u0445 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445 \u0441\u043a\u0440\u044b\u045e\u043b\u044f\u044e\u0446\u044c. \u0411\u0430\u0446\u044c\u043a\u0430 \u0456 \u0441\u044b\u043d \u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u0430\u0434\u043d\u043e\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043a\u0430\u0431 \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041c\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f. \u041d\u0430 \u0432\u043e\u043f\u0440\u0430\u0442\u0446\u044b, \u0443\u0437\u044f\u0442\u0430\u0439 \u0443 \u0437\u0430\u043a\u043b\u0430\u0434, \u043b\u044f\u0436\u0430\u0446\u044c \u043a\u0430\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0456 \u043f\u2019\u044e\u0446\u044c \u0432\u0456\u043d\u043e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u0445 \u0443 \u0434\u043e\u043c\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0436 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u0445 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0410\u043c\u0430\u0440\u044d\u044f, \u044f\u043a\u0456 \u0431\u044b\u045e \u0432\u044b\u0441\u043e\u043a\u0456, \u044f\u043a \u043a\u0435\u0434\u0440, \u0456 \u043c\u043e\u0446\u043d\u044b, \u044f\u043a \u0434\u0443\u0431; \u042f \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043f\u043b\u043e\u0434 \u044f\u0433\u043e \u045e\u0432\u0435\u0440\u0441\u0435 \u0456 \u043a\u0430\u0440\u044d\u043d\u043d\u0435 \u044f\u0433\u043e \u045e\u043d\u0456\u0437\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430\u0441 \u0436\u0430 \u042f \u0432\u044b\u0432\u0435\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0456 \u0432\u0430\u0434\u0437\u0456\u045e \u0432\u0430\u0441 \u043f\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e, \u043a\u0430\u0431 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e \u0430\u043c\u0430\u0440\u044d\u044f\u045e. \u0417 \u0441\u044b\u043d\u043e\u045e \u0432\u0430\u0448\u044b\u0445 \u042f \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430 \u0437 \u0432\u0430\u0448\u044b\u0445 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u2013 \u043d\u0430\u0437\u0456\u0440\u044d\u044f\u045e. \u0426\u0456 \u0436 \u043d\u0435 \u0431\u044b\u043b\u043e \u0433\u044d\u0442\u0430\u0433\u0430, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u0410\u043b\u0435 \u0432\u044b \u043f\u0430\u0456\u043b\u0456 \u0432\u0456\u043d\u043e\u043c \u043d\u0430\u0437\u0456\u0440\u044d\u044f\u045e \u0456 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u041d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u0446\u0435\u201d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u042f \u043f\u0440\u044b\u0446\u0456\u0441\u043d\u0443 \u0432\u0430\u0441 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a \u0446\u0456\u0441\u043d\u0435 \u0432\u043e\u0437, \u043d\u0430\u0433\u0440\u0443\u0436\u0430\u043d\u044b \u0441\u043d\u0430\u043f\u0430\u043c\u0456. \u0406 \u0441\u043f\u0440\u044b\u0442\u043d\u044b \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u0435 \u045e\u0446\u044f\u0447\u044b, \u0456 \u043c\u043e\u0446\u043d\u044b \u043d\u0435 \u045e\u0437\u043c\u043e\u0446\u043d\u0456\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0441\u0456\u043b\u044b, \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u043d\u0435 \u0432\u044b\u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0456 \u043b\u0443\u0447\u043d\u0456\u043a, \u043d\u0456 \u0445\u0443\u0442\u043a\u0430\u043d\u043e\u0433\u0456 \u043d\u0435 \u045e\u0446\u044f\u0447\u044d, \u043d\u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f. \u0406 \u0441\u0430\u043c\u044b \u0430\u0434\u0432\u0430\u0436\u043d\u044b \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u044f\u0440\u043e\u0434 \u043c\u043e\u0446\u043d\u044b\u0445 \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0443\u0446\u044f\u0447\u044d \u0433\u043e\u043b\u044b\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 35.4pt; text-align: justify;\"><\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043c 2, 10\u0430. 11\u0430. 12b; \u041f\u0441 95 (94), 10b-11\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0430\u0441 \u0436\u0430 \u042f \u0432\u044b\u0432\u0435\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0456 \u0432\u0430\u0434\u0437\u0456\u045e \u0432\u0430\u0441 \u043f\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0406 \u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u0413\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u043b\u0443\u043a\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c, \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u041c\u0430\u0456\u0445 \u0434\u0430\u0440\u043e\u0433.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0417 \u0441\u044b\u043d\u043e\u045e \u0432\u0430\u0448\u044b\u0445 \u042f \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430\u043b\u0435 \u0432\u044b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u041d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u0446\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u042f \u0441\u043a\u0430\u0437\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"183","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u043c\u043e\u0441\u0430  7, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d \u0411\u043e\u0433: \u0432\u043e\u0441\u044c \u0440\u044b\u0445\u0442\u0443\u0435 \u0401\u043d \u0441\u0430\u0440\u0430\u043d\u0447\u0443 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0434\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u044f \u0430\u0442\u0430\u0432\u044b, \u0430\u0442\u0430\u0432\u0430 \u0436 \u0431\u044b\u043b\u0430 \u043f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u0441\u0435\u043d\u0430\u043a\u043e\u0441\u0443. \u0410 \u043a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0430 \u044f\u043d\u0430 \u043f\u0430\u0436\u044b\u0440\u0430\u0446\u044c \u0437\u0435\u043b\u044f\u043d\u0456\u043d\u0443 \u0437\u044f\u043c\u043b\u0456, \u044f \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u0434\u0430\u0440\u0443\u0439, \u043f\u0440\u0430\u0448\u0443! \u042f\u043a \u0432\u044b\u0441\u0442\u0430\u0456\u0446\u044c \u042f\u043a\u0443\u0431, \u0431\u043e \u0451\u043d \u0437\u0430\u043c\u0430\u043b\u044b?\u00bb \u041f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0430\u0431 \u0433\u044d\u0442\u044b\u043c: \u00ab\u041d\u0435 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u00bb,&nbsp; \u2013 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d \u0411\u043e\u0433: \u0432\u043e\u0441\u044c \u041f\u0430\u043d \u0411\u043e\u0433 \u043a\u043b\u0456\u0447\u0430 \u0430\u0433\u043e\u043d\u044c, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u0446\u0430, \u0456 \u0451\u043d \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043d\u0430\u0434\u0437\u0435\u043b. \u0406 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u043f\u0440\u0430\u0448\u0443, \u0441\u043f\u044b\u043d\u0456\u0441\u044f! \u042f\u043a \u0432\u044b\u0441\u0442\u0430\u0456\u0446\u044c \u042f\u043a\u0443\u0431, \u0431\u043e \u0451\u043d \u0437\u0430\u043c\u0430\u043b\u044b?\u00bb \u041f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0430\u0431 \u0433\u044d\u0442\u044b\u043c: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430\u00bb, \u2013 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u0432\u043e\u0441\u044c \u041f\u0430\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0441\u0442\u0440\u043e\u043c\u043a\u0456\u043c \u043c\u0443\u0440\u044b, \u0430 \u045e \u0440\u0443\u0446\u044d \u042f\u0433\u043e\u043d\u0430\u0439 \u0431\u044b\u045e \u0430\u0434\u0432\u0435\u0441. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: \u00ab\u0428\u0442\u043e \u0442\u044b \u0431\u0430\u0447\u044b\u0448, \u0410\u043c\u043e\u0441?\u00bb \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0410\u0434\u0432\u0435\u0441\u00bb. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u0412\u043e\u0441\u044c \u042f \u0441\u043f\u0443\u0441\u043a\u0430\u044e \u0430\u0434\u0432\u0435\u0441 \u0441\u044f\u0440\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u041c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u0443 \u044f\u043c\u0443. \u0411\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b \u043a\u0443\u043b\u044c\u0442\u0430\u0432\u044b\u044f \u045e\u0437\u0432\u044b\u0448\u0448\u044b \u0406\u0441\u0430\u0430\u043a\u0430 \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u045e\u0437\u043d\u0456\u043c\u0443\u0441\u044f \u0437 \u043c\u044f\u0447\u043e\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u043e\u043c\u0443 \u0415\u0440\u0430\u0431\u0430\u0430\u043c\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0410\u043c\u0430\u0441\u0456\u044f, \u0441\u0432\u044f\u0442\u0430\u0440 \u0437 \u0411\u044d\u0442\u044d\u043b\u044f, \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430 \u0415\u0440\u0430\u0431\u0430\u0430\u043c\u0430, \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0410\u043c\u043e\u0441 \u0443 \u0437\u043c\u043e\u0432\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u044f\u0440\u043e\u0434 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0417\u044f\u043c\u043b\u044f \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u043d\u0435\u0441\u0446\u0456 \u045e\u0441\u0456\u0445 \u044f\u0433\u043e\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0410\u043c\u043e\u0441: \u00ab\u0410\u0434 \u043c\u044f\u0447\u0430 \u043f\u0430\u043c\u0440\u044d \u0415\u0440\u0430\u0431\u0430\u0430\u043c, \u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456\u00bb. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u043c\u0430\u0441\u0456\u044f \u0410\u043c\u043e\u0441\u0443: \u00ab\u041f\u0440\u0430\u0437\u043e\u0440\u0446\u0430, \u0456\u0434\u0437\u0456, \u0443\u0446\u044f\u043a\u0430\u0439 \u0443 \u0437\u044f\u043c\u043b\u044e \u042e\u0434\u044b. \u0422\u0430\u043c \u0435\u0448 \u0445\u043b\u0435\u0431 \u0456 \u0442\u0430\u043c \u043f\u0440\u0430\u0440\u043e\u0447. \u0410 \u045e \u0411\u044d\u0442\u044d\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447, \u0431\u043e \u0451\u043d \u2013 \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0434\u043e\u043c\u00bb. \u0410\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0410\u043c\u043e\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u043c\u0430\u0441\u0456\u044e: \u00ab\u042f \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a \u0456 \u043d\u0435 \u0441\u044b\u043d \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u0431\u043e \u044f \u043f\u0430\u0441\u0442\u0443\u0445 \u0456 \u0437\u0431\u0456\u0440\u0430\u043b\u044c\u043d\u0456\u043a \u0441\u0456\u043a\u0430\u043c\u043e\u0440\u0430\u045e. \u0410\u043b\u0435 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u201c\u0406\u0434\u0437\u0456, \u043f\u0440\u0430\u0440\u043e\u0447 \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044e\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u044f\u043f\u0435\u0440 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430. \u0422\u044b \u043a\u0430\u0436\u0430\u0448: \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447 \u0434\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u043d\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439 \u0441\u043b\u043e\u045e \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0406\u0441\u0430\u0430\u043a\u0430. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u201c\u0416\u043e\u043d\u043a\u0430 \u0442\u0432\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u044f\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0441\u044b\u043d\u044b \u0456 \u0434\u043e\u0447\u043a\u0456 \u0442\u0432\u0430\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0434 \u043c\u044f\u0447\u0430, \u0437\u044f\u043c\u043b\u044f \u0442\u0432\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0448\u043d\u0443\u0440\u0430\u043c, \u0442\u044b \u043f\u0430\u043c\u0440\u044d\u0448 \u0443 \u0437\u044f\u043c\u043b\u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0439, \u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456\u201d\u00bb.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043c 3, 7. 8b; 7, 15<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d \u0411\u043e\u0433 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c, \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e\u0448\u044b \u0441\u0432\u0430\u0451\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0441\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e \u2013 \u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c?<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u0406\u0434\u0437\u0456, \u043f\u0440\u0430\u0440\u043e\u0447 \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u043c\u0443. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"184","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u043c\u043e\u0441\u0430 9, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0431\u0430\u0447\u044b\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043d\u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c \u0456 \u043a\u0430\u0437\u0430\u045e: \u00ab\u0423\u0434\u0430\u0440 \u043f\u0430 \u0432\u0435\u0440\u0445\u0430\u0432\u0456\u043d\u0435 \u043a\u0430\u043b\u043e\u043d\u044b, \u043a\u0430\u0431 \u0437\u0430\u0442\u0440\u044d\u0441\u043b\u0456\u0441\u044f \u0432\u0443\u0448\u0430\u043a\u0456 \u0456 \u045e\u043f\u0430\u043b\u0456 \u0456\u043c \u0443\u0441\u0456\u043c \u043d\u0430 \u0433\u0430\u043b\u043e\u0432\u044b. \u0410\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u042f \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u044e \u043c\u044f\u0447\u043e\u043c. \u041d\u0456\u0445\u0442\u043e \u0437 \u0456\u0445 \u043d\u0435 \u045e\u0446\u044f\u0447\u044d \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435\u0446\u0446\u0430. \u0425\u043e\u0446\u044c \u0431\u044b \u0441\u043f\u0443\u0441\u0446\u0456\u043b\u0456\u0441\u044f \u045e \u0448\u044d\u043e\u043b\u044c, \u041c\u0430\u044f \u0440\u0443\u043a\u0430 \u0432\u044b\u0446\u044f\u0433\u043d\u0435 \u0456\u0445 \u0430\u0434\u0442\u0443\u043b\u044c. \u0425\u043e\u0446\u044c \u0431\u044b \u045e\u0437\u044b\u0448\u043b\u0456 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u044b, \u043d\u0456\u0437\u0440\u044b\u043d\u0443 \u0456\u0445 \u0430\u0434\u0442\u0443\u043b\u044c. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0443\u043a\u0440\u044b\u044e\u0446\u0446\u0430 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u041a\u0430\u0440\u043c\u044d\u043b\u044e, \u0437\u043d\u0430\u0439\u0434\u0443 \u0456\u0445 \u0442\u0430\u043c \u0456 \u0441\u0445\u0430\u043f\u043b\u044e. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0445\u0430\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u041c\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439 \u043d\u0430 \u0434\u043d\u0435 \u043c\u043e\u0440\u0430, \u0456 \u0442\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u0437\u043c\u0435\u044e \u045e\u043a\u0443\u0441\u0456\u0446\u044c \u0456\u0445. \u0406 \u043a\u0430\u043b\u0456 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u043d\u0430\u0432\u0430\u0442 \u0442\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u043c\u044f\u0447\u0443, \u0456 \u0451\u043d \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0456\u0445. \u042f \u0441\u043a\u0456\u0440\u0443\u044e \u043d\u0430 \u0456\u0445 \u041c\u0430\u0435 \u0432\u043e\u0447\u044b \u0434\u0437\u0435\u043b\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f, \u0430 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d, \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u044f\u043d\u0430 \u0440\u0430\u0441\u0442\u0430\u0435, \u0430 \u045e\u0441\u0435 \u044f\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0433\u0430\u043b\u043e\u0441\u044f\u0446\u044c. \u042f\u043d\u0430 \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u044f \u044f\u043a \u041d\u0456\u043b, \u0456 \u0430\u043f\u0430\u0434\u0430\u0435 \u044f\u043a \u0440\u0430\u043a\u0430 \u0415\u0433\u0456\u043f\u0442\u0430. \u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u0443\u0434\u0443\u0435 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0441\u0432\u043e\u0439 \u0442\u0440\u043e\u043d \u0456 \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0445\u0442\u043e \u043f\u0440\u044b\u0437\u044b\u0432\u0430\u0435 \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u0456 \u0440\u0430\u0437\u043b\u0456\u0432\u0430\u0435 \u0456\u0445 \u043f\u0430 \u0437\u044f\u043c\u043b\u0456. \u041f\u0430\u043d \u2013 \u042f\u0433\u043e \u0456\u043c\u044f. \u00ab\u0426\u0456 \u0436 \u0432\u044b, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u043d\u0435 \u044f\u043a \u0441\u044b\u043d\u044b \u043a\u0443\u0448\u044b\u0442\u0430\u045e? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0426\u0456 \u0436 \u043d\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u044f \u0432\u044b\u0432\u0435\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e \u0437 \u041a\u0430\u0444\u0442\u043e\u0440\u0430 \u0456 \u0430\u0440\u0430\u043c\u0435\u0439\u0446\u0430\u045e \u0437 \u041a\u0456\u0440\u0430? \u0412\u043e\u0441\u044c \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0433\u0440\u044d\u0448\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u042f \u0441\u0430\u0442\u0440\u0443 \u044f\u0433\u043e \u0437 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u044f\u043c\u043b\u0456. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u0441\u0430\u0442\u0440\u0443 \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u043e\u043c \u042f\u043a\u0443\u0431\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0411\u043e \u0432\u043e\u0441\u044c \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u043f\u0440\u0430\u0441\u0435\u044f\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a \u043f\u0440\u0430\u0441\u0435\u0439\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u0437 \u0441\u0456\u0442\u0430, \u043a\u0430\u0431 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0435 \u0437\u044f\u0440\u043d\u044f\u0442\u043a\u0430 \u043d\u0435 \u045e\u043f\u0430\u043b\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0410\u0434 \u043c\u044f\u0447\u0430 \u043f\u0430\u043c\u0440\u0443\u0446\u044c \u0443\u0441\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u0437 \u041c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0442\u044b\u044f, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456: \u201c\u041d\u044f\u0448\u0447\u0430\u0441\u0446\u0435&nbsp; \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0456 \u043d\u0435 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u043d\u0430\u0441\u201d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043d\u0430\u045e\u043b\u044e \u0437\u0430\u043d\u044f\u043f\u0430\u043b\u044b \u0448\u0430\u0446\u0451\u0440 \u0414\u0430\u0432\u0456\u0434\u0430, \u043f\u0440\u0430\u043b\u043e\u043c\u044b \u044f\u0433\u043e \u0437\u0430\u0433\u0430\u0440\u0430\u0434\u0436\u0443 \u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u0430\u0435 \u0430\u0434\u043d\u0430\u045e\u043b\u044e, \u0456 \u0430\u0434\u0431\u0443\u0434\u0443\u044e \u044f\u0433\u043e, \u044f\u043a \u0443 \u0434\u0430\u045e\u043d\u0456\u044f \u0434\u043d\u0456,&nbsp; \u043a\u0430\u0431 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u043b\u0456 \u0440\u044d\u0448\u0442\u0430\u0439 \u042d\u0434\u043e\u043c\u0430 \u0456 \u045e\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u044f\u043a\u0456\u043c \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u041c\u0430\u0451 \u0456\u043c\u044f\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0433\u044d\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u043e\u0441\u044c \u043d\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0434\u043d\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043a\u0430\u043b\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0443\u0446\u0446\u0430 \u0430\u0440\u0430\u0442\u044b \u0441\u0430 \u0436\u043d\u044f\u0446\u043e\u043c, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0442\u043e\u043f\u0447\u0430 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u0437 \u0441\u0435\u0439\u0431\u0456\u0442\u0430\u043c. \u0413\u043e\u0440\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0456\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b\u043c \u0441\u043e\u043a\u0430\u043c, \u0456 \u045e\u0441\u0435 \u043f\u0430\u0433\u043e\u0440\u043a\u0456 \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c. \u042f \u0432\u044f\u0440\u043d\u0443 \u0437 \u043f\u0430\u043b\u043e\u043d\u0443 \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u042f\u043d\u044b \u0437\u0430\u0431\u0443\u0434\u0443\u044e\u0446\u044c \u0430\u043f\u0443\u0441\u0446\u0435\u043b\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b \u0456 \u043f\u0430\u0441\u0435\u043b\u044f\u0446\u0446\u0430 \u045e \u0456\u0445, \u043f\u0430\u0441\u0430\u0434\u0437\u044f\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0456 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0456\u0446\u044c \u0437 \u0456\u0445 \u0432\u0456\u043d\u043e. \u0420\u0430\u0437\u0432\u044f\u0434\u0443\u0446\u044c \u0441\u0430\u0434\u044b \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456 \u0456\u0445 \u043f\u043b\u0430\u0434\u044b. \u041f\u0430\u0441\u044f\u043b\u044e \u0456\u0445 \u043d\u0430 \u0456\u0445\u043d\u044f\u0439 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u044b\u0432\u0430\u0446\u044c \u0456\u0445 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456\u0445\u043d\u044f\u0439, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u045e \u0456\u043c\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0414\u0437 15, 16\u0430. 17\u0430. 14b. 15b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044f\u0440\u043d\u0443\u0441\u044f \u0456 \u0430\u0434\u0431\u0443\u0434\u0443\u044e \u0437\u0430\u043d\u044f\u043f\u0430\u043b\u044b \u0448\u0430\u0446\u0451\u0440 \u0414\u0430\u0432\u0456\u0434\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0430\u0431 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u043b\u044e\u0434\u0437\u0456 \u0448\u0443\u043a\u0430\u043b\u0456 \u041f\u0430\u043d\u0430, \u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0456\u043c\u044f \u041c\u0430\u0451.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0437 \u0456\u0445 \u043d\u0430\u0440\u043e\u0434 \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"185","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u0456  1, 1-9; 3, 1-5<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0440\u043e\u043a \u044f\u043a \u0437\u043d\u0430\u043a \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0433\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u0430 \u041e\u0441\u0456\u0456, \u0441\u044b\u043d\u0430 \u0411\u044d\u044d\u0440\u044b\u044f, \u0443 \u0434\u043d\u0456 \u0423\u0437\u0456\u0456, \u042f\u0442\u0430\u043c\u0430, \u0410\u0445\u0430\u0437\u0430, \u042d\u0437\u044d\u0445\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u042e\u0434\u044b, \u0456 \u045e \u0434\u043d\u0456 \u0415\u0440\u0430\u0431\u0430\u0430\u043c\u0430, \u0441\u044b\u043d\u0430 \u042f\u0430\u0441\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u043f\u0440\u0430\u0437 \u041e\u0441\u0456\u044e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041e\u0441\u0456\u0456: \u00ab\u0406\u0434\u0437\u0456, \u0432\u0430\u0437\u044c\u043c\u0456 \u0441\u0430\u0431\u0435 \u0436\u043e\u043d\u043a\u0443 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446\u0443 \u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b, \u0431\u043e \u0437\u044f\u043c\u043b\u044f \u043f\u0440\u0430\u0437 \u0441\u0442\u0440\u0430\u0448\u043d\u0443\u044e \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0430\u0434 \u041f\u0430\u043d\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u045e\u0437\u044f\u045e \u0413\u0430\u043c\u044d\u0440, \u0434\u0430\u0447\u043a\u0443 \u0414\u0437\u0456\u0431\u043b\u0430\u0456\u043c\u0430. \u042f\u043d\u0430 \u0437\u0430\u0447\u0430\u043b\u0430 \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043c\u0443 \u0441\u044b\u043d\u0430. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u041d\u0430\u0437\u0430\u0432\u0456 \u044f\u0433\u043e \u0456\u043c\u0435\u043c \u0406\u0437\u0440\u044d\u044d\u043b\u044c, \u0431\u043e \u044f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443 \u0456 \u042f \u043f\u0430\u043a\u0430\u0440\u0430\u044e \u0434\u043e\u043c \u0415\u0433\u0443 \u0437\u0430 \u043a\u0440\u043e\u045e \u0406\u0437\u0440\u044d\u044d\u043b\u044f, \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0443 \u043a\u0430\u043d\u0435\u0446 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044e \u0434\u043e\u043c\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u042f \u0437\u043b\u0430\u043c\u0430\u044e \u043b\u0443\u043a \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e \u0434\u0430\u043b\u0456\u043d\u0435 \u0406\u0437\u0440\u044d\u044d\u043b\u044c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u043e\u0442\u044b\u043c \u044f\u043d\u0430 \u0437\u043d\u043e\u045e \u0437\u0430\u0447\u0430\u043b\u0430 \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0434\u0430\u0447\u043a\u0443. \u0406 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u041d\u0430\u0437\u0430\u0432\u0456 \u044f\u0435 \u0456\u043c\u0435\u043c \u041b\u0451-\u0420\u0443\u0445\u0430\u043c\u0430, \u0431\u043e \u042f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u0443 \u0456\u043c. \u0410\u043b\u0435 \u0437\u043c\u0456\u043b\u0443\u044e\u0441\u044f \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u0456 \u045e\u0440\u0430\u0442\u0443\u044e \u0456\u0445 \u0443 \u041f\u0430\u043d\u0443, \u0456\u0445\u043d\u0456\u043c \u0411\u043e\u0433\u0443, \u0430\u0434\u043d\u0430\u043a \u0443\u0440\u0430\u0442\u0443\u044e \u0456\u0445 \u043d\u0456 \u043f\u0440\u0430\u0437 \u043b\u0443\u043a \u0446\u0456 \u043c\u0435\u0447, \u043d\u0456 \u043f\u0440\u0430\u0437 \u0432\u0430\u0439\u043d\u0443, \u043d\u0456 \u043f\u0440\u0430\u0437 \u043a\u043e\u043d\u0435\u0439 \u0434\u044b \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e\u00bb. \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0430\u0434\u043d\u044f\u043b\u0430 \u0430\u0434 \u0433\u0440\u0443\u0434\u0437\u0435\u0439 \u041b\u0451-\u0420\u0443\u0445\u0430\u043c\u0443, \u0437\u0430\u0447\u0430\u043b\u0430 \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0441\u044b\u043d\u0430. \u0406 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0430\u0437\u0430\u0432\u0456 \u044f\u0433\u043e \u0456\u043c\u0435\u043c \u041b\u0451-\u0410\u043c\u043c\u0456, \u0431\u043e \u0432\u044b \u043d\u0435 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0430 \u042f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: \u00ab\u0406\u0434\u0437\u0456, \u044f\u0448\u0447\u044d \u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u0445\u0430\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u043a\u0430\u0445\u0430\u043d\u0443\u044e \u0456\u043d\u0448\u044b\u043c \u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0443\u044e, \u044f\u043a \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u044f\u043d\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0456\u043d\u0448\u044b\u0445 \u0431\u0430\u0433\u043e\u045e \u0456 \u043b\u044e\u0431\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u043f\u0435\u0447\u043a\u0456 \u0437 \u0440\u0430\u0437\u044b\u043d\u043a\u0430\u043c\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043d\u0430\u0431\u044b\u045e \u044f\u0435 \u0441\u0430\u0431\u0435 \u0437\u0430 \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430\u043d\u0456\u043a\u0430\u045e, \u0437\u0430 \u0445\u0430\u043c\u044d\u0440 \u0456 \u0437\u0430 \u043b\u0435\u0442\u044d\u043a \u044f\u0447\u043c\u0435\u043d\u044e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: \u00ab\u041f\u0430\u0441\u044f\u043b\u0456\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u044e \u043d\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0434\u043d\u0456, \u043f\u0430\u043a\u0456\u043d\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0456 \u043d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0441\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u0435. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0441\u044f \u0434\u0430 \u0446\u044f\u0431\u0435\u00bb. \u0411\u043e \u0448\u043c\u0430\u0442 \u0434\u0437\u0451\u043d \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u0431\u0435\u0437 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u0431\u0435\u0437 \u043a\u043d\u044f\u0437\u044f, \u0431\u0435\u0437 \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u0431\u0435\u0437 \u043c\u0430\u0446\u044d\u0431\u044b, \u0431\u0435\u0437 \u044d\u0444\u043e\u0434\u0430 \u0456 \u0431\u0435\u0437 \u0442\u044d\u0440\u0430\u0444\u0456\u043c\u0430\u045e. \u041f\u0430\u0441\u043b\u044f \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u0414\u0430\u0432\u0456\u0434\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u044f. \u0410 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0437\u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0437 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u0434\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0434\u0430 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041f 2, 9\u0430. 10\u0430; \u0420\u044b\u043c 9, 26<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b \u0436 \u2013 \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0406 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u0434\u0437\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0456\u043c: \u0412\u044b \u043d\u0435 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0441\u044b\u043d\u0430\u043c\u0456 \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"186","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u0456  2, 4\u0430b. 8-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b \u041f\u0430\u043d\u0430 \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0421\u0443\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u0437 \u0432\u0430\u0448\u0430\u0439 \u043c\u0430\u0446\u0456, \u0441\u0443\u0434\u0437\u0456\u0446\u0435\u0441\u044f, \u0431\u043e \u044f\u043d\u0430 \u041c\u043d\u0435 \u043d\u0435 \u0436\u043e\u043d\u043a\u0430, \u0430 \u042f \u0451\u0439 \u043d\u0435 \u043c\u0443\u0436. \u041d\u044f\u0445\u0430\u0439 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b, \u0430 \u0441\u0432\u0430\u0435 \u0433\u0440\u0443\u0434\u0437\u0456 \u0430\u0434 \u0441\u043b\u044f\u0434\u043e\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0447\u0443\u0436\u0430\u043b\u043e\u0441\u0442\u0432\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u043e\u0441\u044c \u042f \u043f\u0435\u0440\u0430\u043a\u0440\u044b\u044e \u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0443 \u0446\u0435\u0440\u043d\u044f\u043c\u0456 \u0456 \u0430\u0431\u043d\u044f\u0441\u0443 \u044f\u0435 \u043c\u0443\u0440\u0430\u043c, \u0456 \u044f\u043d\u0430 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u0446\u0435\u0436\u0430\u043a. \u042f\u043d\u0430 \u043f\u0430\u0433\u043e\u043d\u0456\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0430\u0445\u0430\u043d\u043a\u0430\u043c\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0434\u0430\u0433\u043e\u043d\u0456\u0446\u044c \u0456\u0445. \u0411\u0443\u0434\u0437\u0435 \u0456\u0445 \u0448\u0443\u043a\u0430\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0436\u0430: \u201c\u041f\u0430\u0439\u0434\u0443, \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0434\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043c\u0443\u0436\u0430, \u0431\u043e \u0442\u0430\u0434\u044b \u043c\u043d\u0435 \u0431\u044b\u043b\u043e \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u0446\u044f\u043f\u0435\u0440\u201d. \u042f\u043d\u0430 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u042f \u0434\u0430\u0432\u0430\u045e \u0451\u0439 \u0437\u0431\u043e\u0436\u0436\u0430, \u043c\u0430\u043b\u0430\u0434\u043e\u0435 \u0432\u0456\u043d\u043e \u0456 \u0441\u0432\u0435\u0436\u044b \u0430\u043b\u0435\u0439, \u0430\u0431\u0441\u044b\u043f\u0430\u045e \u044f\u0435 \u0441\u0440\u044d\u0431\u0440\u0430\u043c \u0456 \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u044f\u043a\u043e\u0435 \u044f\u043d\u044b \u043f\u0443\u0441\u0446\u0456\u043b\u0456 \u043d\u0430 \u0411\u0430\u0430\u043b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0456 \u0437\u0430\u0431\u044f\u0440\u0443 \u0441\u0432\u0430\u0451 \u0437\u0431\u043e\u0436\u0436\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u044f\u0433\u043e \u043f\u0430\u0440\u0430, \u0456 \u0441\u0432\u0430\u0451 \u043c\u0430\u043b\u0430\u0434\u043e\u0435 \u0432\u0456\u043d\u043e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u044f\u0433\u043e \u0447\u0430\u0441. \u0410\u0434\u0431\u044f\u0440\u0443 \u0441\u0432\u0430\u044e \u0432\u043e\u045e\u043d\u0443 \u0456 \u0441\u0432\u043e\u0439 \u043b\u0451\u043d, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u044f\u0435 \u0433\u0430\u043b\u0456\u0437\u043d\u0443. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0430\u0433\u0430\u043b\u044e \u044f\u0435 \u0441\u043e\u0440\u0430\u043c \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u044f\u0435 \u043a\u0430\u0445\u0430\u043d\u043a\u0430\u045e \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0440\u0432\u0435 \u044f\u0435 \u0437 \u041c\u0430\u0451\u0439 \u0440\u0443\u043a\u0456. \u0421\u043a\u043e\u043d\u0447\u0443 \u0437 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u044f\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0437 \u044f\u0435 \u0441\u0432\u044f\u0442\u0430\u043c\u0456, \u0437 \u044f\u0435 \u0447\u0430\u0441\u0430\u043c \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a\u0430 \u0456 \u0437 \u0448\u0430\u0431\u0430\u0442\u0430\u043c, \u0456 \u0437 \u043a\u043e\u0436\u043d\u0430\u0439 \u044f\u0435 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044e. \u0417\u043d\u0456\u0448\u0447\u0443 \u044f\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0456 \u0456 \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u044b, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u044f\u043d\u0430 \u043a\u0430\u0437\u0430\u043b\u0430: \u201c\u0413\u044d\u0442\u0430 \u043c\u0430\u044f \u043f\u043b\u0430\u0442\u0430, \u044f\u043a\u0443\u044e \u043c\u043d\u0435 \u0434\u0430\u043b\u0456 \u043c\u0430\u0435 \u043a\u0430\u0445\u0430\u043d\u043a\u0456\u201d. \u042f \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0443 \u0456\u0445 \u0443 \u0437\u0430\u0440\u0430\u0441\u043d\u0456\u043a\u0456, \u0456 \u043f\u0430\u043b\u044f\u0432\u044b\u044f \u0437\u0432\u044f\u0440\u044b \u0437\u2019\u044f\u0434\u0443\u0446\u044c \u0456\u0445. \u041f\u0430\u043a\u0430\u0440\u0430\u044e \u044f\u0435 \u0437\u0430 \u0434\u043d\u0456 \u0411\u0430\u0430\u043b\u044f\u045e, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u043f\u0430\u043b\u0456\u043b\u0430 \u0434\u043b\u044f \u0456\u0445 \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043b\u0430 \u0441\u044f\u0431\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u0437\u0430\u0432\u0443\u0448\u043d\u0456\u0446\u0430\u043c\u0456 \u0456 \u043c\u0430\u043d\u0456\u0441\u0442\u0430\u043c\u0456 \u0456 \u0445\u0430\u0434\u0437\u0456\u043b\u0430 \u0437\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0430\u0445\u0430\u043d\u043a\u0430\u043c\u0456, \u0430 \u043f\u0440\u0430 \u041c\u044f\u043d\u0435 \u0437\u0430\u0431\u044b\u043b\u0430\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u043d\u044f\u0432\u0435\u0440\u043d\u0443\u044e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0456 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430 \u044f\u0435 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043c \u0430\u0434\u0434\u0430\u043c \u0451\u0439 \u044f\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0456, \u0430 \u0434\u0430\u043b\u0456\u043d\u0443 \u0410\u0445\u043e\u0440 \u0443\u0447\u044b\u043d\u044e \u0431\u0440\u0430\u043c\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u0422\u0430\u043c \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435 \u044f\u043d\u0430, \u044f\u043a \u0443 \u0434\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0456 \u045e \u0434\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u044b\u0439\u0441\u0446\u044f \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u201c\u043c\u0443\u0436 \u043c\u043e\u0439\u201d, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0437\u0430\u0446\u044c&nbsp; \u041c\u043d\u0435 \u201c\u043c\u043e\u0439 \u0411\u0430\u0430\u043b\u044c\u201d. \u042f \u0432\u044b\u043a\u0456\u043d\u0443 \u0437 \u044f\u0435 \u0432\u0443\u0441\u043d\u0430\u045e \u0456\u043c\u0451\u043d\u044b \u0411\u0430\u0430\u043b\u044f\u045e, \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u0446\u0430 \u0456\u0445 \u0456\u043c\u0451\u043d\u044b. \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0456\u043c\u0456, \u0437 \u0434\u0437\u0456\u043a\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456, \u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u043f\u0442\u0430\u0441\u0442\u0432\u0430\u043c \u0456 \u0437 \u043f\u0430\u045e\u0437\u0443\u043d\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456. \u0417\u043b\u0430\u043c\u0430\u044e \u043b\u0443\u043a \u0456 \u043c\u0435\u0447 \u0456 \u0441\u0430\u0442\u0440\u0443 \u0432\u0430\u0439\u043d\u0443 \u0437 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0434\u0430\u043c \u0456\u043c \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u042f \u0437\u0430\u0440\u0443\u0447\u0443\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u044e \u043d\u0430\u0432\u0435\u043a\u0456; \u0437\u0430\u0440\u0443\u0447\u0443\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u044e \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0456, \u0443 \u043c\u0456\u043b\u0430\u0441\u0446\u0456 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0417\u0430\u0440\u0443\u0447\u0443\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u044e \u045e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456, \u0456 \u0442\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u0448 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u042f \u0430\u0434\u043a\u0430\u0436\u0443, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0430\u0434\u043a\u0430\u0436\u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u043c, \u0430 \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0436\u0443\u0446\u044c \u0437\u044f\u043c\u043b\u0456. \u0417\u044f\u043c\u043b\u044f \u0430\u0434\u0433\u0443\u043a\u043d\u0435\u0446\u0446\u0430 \u0437\u0431\u043e\u0436\u0436\u0430\u043c, \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0432\u0456\u043d\u043e\u043c \u0456 \u0441\u0432\u0435\u0436\u044b\u043c \u0430\u043b\u0435\u0435\u043c, \u0430 \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0436\u0443\u0446\u044c \u0406\u0437\u0440\u044d\u044d\u043b\u044e. \u042f \u0437\u0430\u0441\u0435\u044e \u044f\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u043c\u0456\u043b\u0443\u044e\u0441\u044f \u043d\u0430\u0434 \u041b\u0451-\u0420\u0443\u0445\u0430\u043c\u0430\u0439, \u0456 \u0441\u043a\u0430\u0436\u0443 \u041b\u0451-\u0410\u043c\u043c\u0456: \u201c\u0422\u044b \u2013 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434\u201d, \u2013 \u0430 \u0451\u043d \u0430\u0434\u043a\u0430\u0436\u0430: \u201c\u041c\u043e\u0439 \u0411\u043e\u0433!\u201d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 19, 7b. 9a; \u041e\u0441 2, 22&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u044f\u0441\u0435\u043b\u043b\u0435 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0436\u043e\u043d\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u044f.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u043d\u0430 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0443\u044e \u0432\u044f\u0447\u044d\u0440\u0443 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0417\u0430\u0440\u0443\u0447\u0443\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u044e \u045e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456, \u0456 \u0442\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u0448 \u041f\u0430\u043d\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"187","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u0456 <\/span><span style=\"color: #ff0000;\">5, 14 \u2013 7, 2<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u044f\u0448\u0447\u044b\u0440\u0430\u0433\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u042f \u0434\u043b\u044f \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u044f\u043a \u043b\u0435\u045e \u0456 \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u042e\u0434\u044b \u044f\u043a \u0456\u043b\u044c\u0432\u044f\u043d\u044f. \u042f \u0441\u0430\u043c \u0440\u0430\u0437\u0430\u0440\u0432\u0443 \u0456 \u0430\u0434\u044b\u0434\u0443, \u043f\u0430\u043d\u044f\u0441\u0443, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435. \u041f\u0430\u0439\u0434\u0443, \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430, \u0430\u0436 \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u044b \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0432\u0456\u043d\u044b \u0456 \u043d\u0435 \u043f\u0430\u0447\u043d\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u043d\u044f\u0434\u043e\u043b\u0456. \u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430! \u0401\u043d \u043d\u0430\u0441 \u043f\u0430\u0440\u0430\u043d\u0456\u045e, \u0401\u043d \u0456 \u0437\u0430\u0433\u043e\u0456\u0446\u044c. \u0401\u043d \u0443\u0434\u0430\u0440\u044b\u045e, \u0401\u043d \u0456 \u043f\u0435\u0440\u0430\u0432\u044f\u0436\u0430 \u043d\u0430\u043c \u0440\u0430\u043d\u044b. \u041f\u0440\u0430\u0437 \u0434\u0432\u0430 \u0434\u043d\u0456 \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u043d\u0430\u0441, \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0441 \u043f\u0430\u0434\u044b\u043c\u0435, \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c. \u041f\u0430\u0437\u043d\u0430\u0439\u043c\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u041f\u0430\u043d\u0430. \u041f\u0440\u044b\u0439\u0441\u0446\u0435 \u042f\u0433\u043e \u043f\u044d\u045e\u043d\u0430\u0435, \u044f\u043a \u043d\u0430\u0434\u044b\u0445\u043e\u0434 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u044f. \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u043d\u0430\u0441, \u044f\u043a \u043b\u0456\u0432\u0435\u043d\u044c, \u044f\u043a \u0432\u0435\u0441\u043d\u0430\u0432\u044b \u0434\u043e\u0436\u0434\u0436, \u0448\u0442\u043e \u043f\u043e\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0436 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u043d\u0435 \u0442\u0430\u0431\u0435, \u042d\u0444\u0440\u0430\u0456\u043c, \u0448\u0442\u043e \u0436 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u043d\u0435 \u0442\u0430\u0431\u0435, \u042e\u0434\u0430? \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f, \u043d\u0456\u0431\u044b \u0440\u0430\u043d\u0456\u0448\u043d\u0456 \u0442\u0443\u043c\u0430\u043d \u0456 \u0440\u0430\u0441\u0430, \u0448\u0442\u043e \u0445\u0443\u0442\u043a\u0430 \u0437\u043d\u0456\u043a\u0430\u0435. \u0422\u0430\u043c\u0443 \u042f \u045e\u0434\u0430\u0440\u0430\u045e \u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e, \u0442\u0430\u043c\u0443 \u0441\u0443\u0434 \u041c\u043e\u0439 \u0437\u0430\u044f\u0441\u043d\u0435\u0435, \u044f\u043a \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0435. \u0411\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0430\u0447\u0443, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u042f\u043d\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0410\u0434\u0430\u043c\u0443 \u043f\u0430\u0440\u0443\u0448\u044b\u043b\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0442\u0430\u043c \u0437\u0434\u0440\u0430\u0434\u0436\u0432\u0430\u043b\u0456 \u041c\u043d\u0435. \u0413\u0456\u043b\u0435\u0430\u0434 \u2013 \u0433\u043e\u0440\u0430\u0434 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0437\u0430\u043b\u0456\u0442\u044b \u043a\u0440\u044b\u0432\u0451\u044e. \u042f\u043a \u043f\u0430\u0434\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0446\u044c \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u0456, \u0442\u0430\u043a \u0445\u0435\u045e\u0440\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e: \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u043d\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u0434\u0430 \u0421\u0456\u0445\u0435\u043c\u0430 \u0456 \u0447\u044b\u043d\u044f\u0446\u044c \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u0435. \u042f \u0431\u0430\u0447\u044b\u045e \u0436\u0430\u0445\u043b\u0456\u0432\u0443\u044e \u0440\u044d\u0447 \u0443 \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0442\u0430\u043c \u042d\u0444\u0440\u0430\u0456\u043c \u0447\u044b\u043d\u0456\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443. \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0441\u0442\u0430\u045e \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u042e\u0434\u0430, \u043f\u0430\u0447\u043d\u0435\u0446\u0446\u0430 \u0436\u043d\u0456\u0432\u043e. \u041a\u0430\u043b\u0456 \u042f \u0432\u044f\u0440\u043d\u0443 \u0437 \u043f\u0430\u043b\u043e\u043d\u0443 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u043b\u0456 \u0432\u044b\u043b\u0435\u0447\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0442\u0430\u0434\u044b \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u0433\u0440\u044d\u0445 \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0456 \u0437\u043b\u043e \u0421\u0430\u043c\u0430\u0440\u044b\u0456, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0456\u043b\u0436\u044b\u0432\u0430. \u0417\u043b\u043e\u0434\u0437\u0435\u0439 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0434\u043e\u043c, \u0430 \u0437\u0432\u043e\u043d\u043a\u0443 \u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0456\u043a\u0456. \u042f\u043d\u044b \u043d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u0448\u0442\u043e \u042f \u043f\u0430\u043c\u044f\u0442\u0430\u044e \u043f\u0440\u0430 \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b. \u0426\u044f\u043f\u0435\u0440 \u0456\u0445\u043d\u0456\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0430\u0442\u0430\u0447\u044b\u043b\u0456 \u0456\u0445, \u044f\u043d\u044b \u2013 \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 9, 13\u0430; \u041e\u0441 6, 6b. 4c<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0439\u0434\u0437\u0456\u0446\u0435, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c:<\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0430\u0447\u0443, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430, \u0430 \u043d\u0435 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f, \u043d\u0456\u0431\u044b \u0440\u0430\u043d\u0456\u0448\u043d\u0456 \u0442\u0443\u043c\u0430\u043d \u0456 \u0440\u0430\u0441\u0430, \u0448\u0442\u043e \u0445\u0443\u0442\u043a\u0430 \u0437\u043d\u0456\u043a\u0430\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"191","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u0456 <\/span><span style=\"color: #ff0000;\">11, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u044f \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c<\/span><\/p>\r\n\r\n\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u041a\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u044b\u045e \u0434\u0437\u0456\u0446\u0451\u043c, \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0433\u043e, \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0456\u0445 \u043a\u043b\u0456\u043a\u0430\u045e, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u043d\u044b \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0430\u0434 \u041c\u044f\u043d\u0435, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0411\u0430\u0430\u043b\u044f\u043c \u0456 \u043a\u0430\u0434\u0437\u0456\u043b\u0456 \u0456\u0434\u0430\u043b\u0430\u043c. \u042f \u0441\u0430\u043c \u0432\u0443\u0447\u044b\u045e \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u043d\u0430\u0441\u0456\u045e \u044f\u0433\u043e \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445, \u0430 \u0451\u043d \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u042f \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0456\u043c. \u042f \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u045e \u044f\u0433\u043e \u043f\u043e\u0432\u044f\u0437\u044f\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u043f\u043e\u0432\u044f\u0437\u044f\u043c\u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0456 \u0431\u044b\u045e \u0434\u043b\u044f \u044f\u0433\u043e \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0434\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0448\u0447\u0430\u043a\u0456. \u042f \u0441\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u043d\u0430\u0434 \u0456\u043c, \u043a\u0430\u0431 \u043d\u0430\u043a\u0430\u0440\u043c\u0456\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0401\u043d \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0430\u043b\u0435 \u0410\u0441\u0456\u0440\u044b\u044f \u0431\u0443\u0434\u0437\u0435 \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0431\u043e \u044f\u043d\u044b \u0430\u0434\u043c\u043e\u0432\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u043c\u0435\u0447 \u0437\u0430\u0432\u0456\u0440\u0443\u0435 \u045e \u044f\u0433\u043e \u0433\u0430\u0440\u0430\u0434\u0430\u0445, \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0437\u0430\u0441\u043e\u0432\u044b \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0456\u0445 \u0437\u0430 \u0456\u0445\u043d\u0456\u044f \u0437\u0430\u0434\u0443\u043c\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0443\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u041c\u044f\u043d\u0435. \u042f\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0411\u0430\u0430\u043b\u044f, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0456\u043c. \u0426\u0456 \u0436 \u0430\u0434\u0434\u0430\u043c \u0446\u044f\u0431\u0435, \u042d\u0444\u0440\u0430\u0456\u043c? \u0426\u0456 \u0436 \u0430\u0434\u0434\u0430\u043c \u0446\u044f\u0431\u0435, \u0406\u0437\u0440\u0430\u044d\u043b\u044c? \u0426\u0456 \u0436 \u0432\u044b\u0434\u0430\u043c \u0446\u044f\u0431\u0435 \u044f\u043a \u0410\u0434\u043c\u0443, \u0446\u0456 \u0437\u0440\u0443\u0439\u043d\u0443\u044e \u044f\u043a \u0421\u044d\u0431\u0430\u0456\u043c? \u0423\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u043b\u0430\u0441\u044f \u045e\u0432\u0430 \u041c\u043d\u0435 \u041c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u045e\u0441\u044f \u041c\u043e\u0439 \u0436\u0430\u043b\u044c. \u041d\u0435 \u045e\u0447\u044b\u043d\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u042d\u0444\u0440\u0430\u0456\u043c\u0430, \u0431\u043e \u042f \u2013 \u0411\u043e\u0433, \u0430 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0421\u0432\u044f\u0442\u044b \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435, \u0456 \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0443, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0433\u043d\u0435\u0432\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u042f\u043d\u044b \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0437\u0430 \u041f\u0430\u043d\u0430\u043c, \u0430 \u0401\u043d \u0437\u0430\u0440\u044b\u0447\u044b\u0446\u044c \u043d\u0456\u0431\u044b \u043b\u0435\u045e. \u0410 \u043a\u0430\u043b\u0456 \u0401\u043d \u0437\u0430\u0440\u044b\u0447\u044b\u0446\u044c, \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u0441\u044b\u043d\u044b \u0437 \u0437\u0430\u0445\u0430\u0434\u0443. \u0417\u0430\u0442\u0440\u0430\u043f\u0435\u0447\u0443\u0446\u044c, \u044f\u043a \u043f\u0442\u0443\u0448\u043a\u0430, \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u0456, \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u043a\u0430, \u0437 \u0437\u044f\u043c\u043b\u0456 \u0430\u0441\u0456\u0440\u044b\u0439\u0441\u043a\u0430\u0439. \u0423\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u0441\u0435\u043b\u044f\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u043c\u0430\u0445\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041e\u0441 11, 8\u0441. 9\u0430b; \u0415\u0440 31, 3b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u043b\u0430\u0441\u044f \u045e\u0432\u0430 \u041c\u043d\u0435 \u041c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u045e\u0441\u044f \u041c\u043e\u0439 \u0436\u0430\u043b\u044c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u0435 \u045e\u0447\u044b\u043d\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u041c\u0430\u0439\u0433\u043e, \u0431\u043e \u042f \u2013 \u0411\u043e\u0433, \u0430 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041b\u044e\u0431\u043e\u045e\u044e \u0432\u0435\u0447\u043d\u0430\u0439 \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0446\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u045e\u0447\u044b\u043d\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"192","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u0456<\/span><span style=\"color: #ff0000;\">14, 2-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u043a\u043b\u0456\u043a \u0434\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f. \u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0412\u044f\u0440\u043d\u0456\u0441\u044f, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0434\u0430 \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0431\u043e \u0442\u044b \u045e\u043f\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435. \u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u043b\u043e\u0432\u044b \u0456 \u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430. \u0421\u043a\u0430\u0436\u044b\u0446\u0435 \u042f\u043c\u0443: \u201c\u041f\u0440\u0430\u0431\u0430\u0447 \u0443\u0441\u0451 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0430 \u0434\u043e\u0431\u0440\u0430\u0435 \u043f\u0440\u044b\u043c\u0456, \u0456 \u043c\u044b \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u043d\u0430\u0448\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u045e. \u0410\u0441\u0456\u0440\u044b\u044f \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435 \u043d\u0430\u0441, \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0435\u0437\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043a\u043e\u043d\u044f\u0445, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0437\u0430\u0446\u044c \u2018\u043d\u0430\u0448\u044b \u0431\u0430\u0433\u0456\u2019 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0430\u0448\u044b\u0445 \u0440\u0443\u043a, \u0431\u043e \u045e \u0426\u044f\u0431\u0435 \u0441\u0456\u0440\u0430\u0442\u0430 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0441\u043f\u0430\u0433\u0430\u0434\u0443\u201d.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u042f \u0432\u044b\u043b\u0435\u0447\u0443 \u0456\u0445\u043d\u044e\u044e \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430 \u043f\u0430\u043b\u044e\u0431\u043b\u044e \u0456\u0445, \u0431\u043e \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u0456\u0445 \u041c\u043e\u0439 \u0433\u043d\u0435\u045e. \u042f \u0431\u0443\u0434\u0443 \u0434\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0456\u0431\u044b \u0440\u0430\u0441\u0430. \u0401\u043d \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u0435, \u044f\u043a \u043b\u0456\u043b\u0435\u044f, \u0456 \u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043a\u0430\u0440\u0430\u043d\u0456 \u0441\u0432\u0430\u0435, \u044f\u043a \u041b\u0456\u0431\u0430\u043d. \u0420\u0430\u0437\u0440\u0430\u0441\u0442\u0443\u0446\u0446\u0430 \u0433\u0430\u043b\u0456\u043d\u044b \u044f\u0433\u043e, \u0456 \u043a\u0440\u0430\u0441\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0443 \u0430\u043b\u0456\u0432\u044b, \u0430 \u043f\u0430\u0445 \u044f\u0433\u043e \u2013 \u043d\u0456\u0431\u044b \u0430\u0434 \u041b\u0456\u0431\u0430\u043d\u0430. \u0422\u0430\u0434\u044b \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u0443 \u044f\u0433\u043e\u043d\u044b\u043c \u0446\u0435\u043d\u0456; \u0430\u0436\u044b\u0432\u0443\u0446\u044c, \u044f\u043a \u0437\u0435\u0440\u043d\u0435; \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0446\u044c, \u044f\u043a \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0433\u0430\u0434\u0432\u0430\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e, \u044f\u043a \u043f\u0440\u0430 \u043b\u0456\u0431\u0430\u043d\u0441\u043a\u0430\u0435 \u0432\u0456\u043d\u043e. \u042d\u0444\u0440\u0430\u0456\u043c, \u044f\u043a\u0430\u044f \u043c\u043d\u0435 \u044f\u0448\u0447\u044d \u0441\u043f\u0440\u0430\u0432\u0430 \u0434\u0430 \u0456\u0434\u0430\u043b\u0430\u045e? \u042f \u043f\u0430\u0447\u0443\u044e \u0456 \u0434\u0430\u0433\u043b\u0435\u0434\u0436\u0443 \u044f\u0433\u043e. \u042f \u044f\u043a \u0437\u044f\u043b\u0451\u043d\u044b \u043a\u0456\u043f\u0430\u0440\u044b\u0441, \u0430\u0434 \u041c\u044f\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u043e\u0439 \u043f\u043b\u043e\u0434.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043c\u0443\u0434\u0440\u044b, \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0434\u0430\u0435 \u0433\u044d\u0442\u0430. \u0411\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u041f\u0430\u043d\u0430, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043f\u0430 \u0456\u0445, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u043d\u0430 \u0456\u0445 \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0443\u0446\u0446\u0430\u00bb.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041e\u0441 14, 5; \u0401\u044d\u043b 4, 21\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0432\u044b\u043b\u0435\u0447\u0443 \u0456\u0445\u043d\u044e\u044e \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430 \u043f\u0430\u043b\u044e\u0431\u043b\u044e \u0456\u0445, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u0456\u0445 \u041c\u043e\u0439 \u0433\u043d\u0435\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434\u043f\u043e\u043c\u0448\u0447\u0443 \u0437\u0430 \u043a\u0440\u043e\u045e \u0456\u0445\u043d\u044e\u044e, \u0437\u0430 \u044f\u043a\u0443\u044e \u044f\u0448\u0447\u044d \u043d\u0435 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e, \u0456 \u041f\u0430\u043d \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"193","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0456\u0445\u0435\u044f <\/span><span style=\"color: #ff0000;\">3, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0431\u0443\u0434\u0437\u0435 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e<\/span><\/p>\r\n\r\n\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041f\u0440\u0430\u0448\u0443, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u042f\u043a\u0443\u0431\u0430 \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0426\u0456 \u0436 \u043d\u0435 \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0434\u0430\u0446\u044c \u0437\u0430\u043a\u043e\u043d?\u00bb \u0412\u044b, \u044f\u043a\u0456\u044f \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u0435 \u0434\u0430\u0431\u0440\u043e \u0456 \u043b\u044e\u0431\u0456\u0446\u0435 \u0437\u043b\u043e, \u044f\u043a\u0456\u044f \u0437\u0434\u0437\u0456\u0440\u0430\u0435\u0446\u0435 \u0437 \u0456\u0445 \u0441\u043a\u0443\u0440\u0443 \u0456 \u0446\u0435\u043b\u0430 \u0456\u0445\u043d\u044f\u0435 \u0430\u0436 \u0434\u0430 \u043a\u043e\u0441\u0442\u0430\u043a. \u0412\u044b \u0437\u2019\u0435\u043b\u0456 \u0446\u0435\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0437\u0434\u0437\u0451\u0440\u043b\u0456 \u0437 \u0456\u0445 \u0441\u043a\u0443\u0440\u0443 \u0456\u0445\u043d\u044e\u044e, \u0430 \u043a\u043e\u0441\u0442\u043a\u0456 \u0456\u0445\u043d\u0456\u044f \u0437\u043b\u0430\u043c\u0430\u043b\u0456 \u0456 \u0440\u0430\u0441\u0441\u0435\u043a\u043b\u0456 \u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0456 \u043d\u0456\u0431\u044b \u045e \u0441\u0430\u0433\u0430\u043d, \u0456 \u044f\u043a \u043c\u044f\u0441\u0430 \u045e \u043a\u0430\u0446\u0451\u043b. \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u0430 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0401\u043d \u043d\u0435 \u0430\u0434\u043a\u0430\u0436\u0430 \u0456\u043c. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0401\u043d \u0437\u0430\u043a\u0440\u044b\u0435 \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456, \u0431\u043e \u044f\u043d\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456\u044f, \u043a\u0430\u043b\u0456 \u0433\u0440\u044b\u0437\u0443\u0446\u044c \u0441\u0432\u0430\u0456\u043c\u0456 \u0437\u0443\u0431\u0430\u043c\u0456, \u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439, \u0430 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0435 \u043a\u043b\u0430\u0434\u0437\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u045e \u0456\u0445\u043d\u0456\u044f \u0432\u0443\u0441\u043d\u044b, \u0442\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c \u0456 \u0432\u0430\u0439\u043d\u0443. \u0422\u0430\u043c\u0443 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u043d\u043e\u0447, \u0456 \u0432\u044b \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0446\u0435 \u0431\u0430\u0447\u044b\u0446\u044c. \u041d\u0430\u0434\u044b\u0434\u0437\u0435 \u0446\u0435\u043c\u0440\u0430, \u0456 \u0432\u044b \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0446\u0435 \u0432\u0430\u0440\u0430\u0436\u044b\u0446\u044c. \u0421\u043e\u043d\u0446\u0430 \u0437\u043e\u0439\u0434\u0437\u0435 \u043d\u0430\u0434 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0456 \u0434\u0437\u0435\u043d\u044c \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0456\u0445 \u0446\u0435\u043c\u0440\u0430\u0439. \u0417\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0446\u0446\u0430 \u043f\u0440\u0430\u0437\u043e\u0440\u0446\u044b, \u0430 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u044b \u0437\u043d\u044f\u0441\u043b\u0430\u0432\u044f\u0446\u0446\u0430. \u042f\u043d\u044b \u045e\u0441\u0435 \u0437\u0430\u043a\u0440\u044b\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b, \u0431\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043a\u0430\u0437\u0443 \u0411\u043e\u0433\u0430. \u0410\u0434\u043d\u0430\u043a \u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u043c\u043e\u0446\u0430\u044e \u0414\u0443\u0445\u0430 \u041f\u0430\u043d\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0430\u0434\u0432\u0430\u0433\u0430\u044e, \u043a\u0430\u0431 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u042f\u043a\u0443\u0431\u0443 \u044f\u0433\u043e \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430, \u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044e \u044f\u0433\u043e \u0433\u0440\u044d\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443, \u043f\u0430\u0447\u0443\u0439\u0446\u0435 \u0433\u044d\u0442\u0430, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430 \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u0447\u0443\u0435\u0446\u0435 \u0430\u0433\u0456\u0434\u0443 \u0434\u0430 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f \u0456 \u043f\u0435\u0440\u0430\u043a\u0440\u0443\u0447\u0432\u0430\u0435\u0446\u0435 \u045e\u0441\u044e \u043f\u0440\u0430\u045e\u0434\u0443. \u0412\u044b \u0431\u0443\u0434\u0443\u0435\u0446\u0435 \u0421\u0456\u0451\u043d \u043d\u0430 \u043a\u0440\u044b\u0432\u0456, \u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043d\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u042f\u0433\u043e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0432\u044f\u0434\u0443\u0446\u044c \u0441\u0443\u0434 \u0437\u0430 \u0445\u0430\u0431\u0430\u0440, \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0432\u0443\u0447\u0430\u0446\u044c \u0437\u0430 \u043f\u043b\u0430\u0442\u0443, \u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u044f\u0433\u043e \u0432\u0430\u0440\u043e\u0436\u0430\u0446\u044c \u0437\u0430 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u0426\u0456 \u0436 \u041f\u0430\u043d \u043d\u0435 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441? \u041d\u0435 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u043d\u0430\u0441 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435! \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0437 \u0432\u0430\u0441 \u0421\u0456\u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0430\u0440\u0430\u043d\u044b \u044f\u043a \u043f\u043e\u043b\u0435, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u0440\u0443\u0456\u043d\u044b, \u0430 \u0433\u0430\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u2013 \u0443 \u043b\u044f\u0441\u0456\u0441\u0442\u044b\u044f \u045e\u0437\u0432\u044b\u0448\u0448\u044b\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 79 (78), 1; \u0414\u0430\u043d 3, 42. 29\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0436\u0430, \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0422\u0432\u0430\u044e, \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u043b\u0456 \u0441\u0432\u044f\u0442\u0443\u044e \u0422\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0456 \u045e \u0440\u0443\u0456\u043d\u044b. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041d\u0435 \u0434\u0430\u0439 \u043d\u0430\u043c \u0437\u0432\u0435\u0434\u0430\u0446\u044c \u0441\u043e\u0440\u0430\u043c, \u0430\u043b\u0435 \u045e\u0447\u044b\u043d\u0456 \u0437 \u043d\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0456 \u045e\u0447\u044b\u043d\u0456\u043b\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0448\u044b\u0441\u044f \u0430\u0434 \u0426\u044f\u0431\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0434\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"194","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0456\u0445\u0435\u044f <\/span><span style=\"color: #ff0000;\">4, 1-7<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"margin: 0pt -2.85pt 0pt -2px; text-indent: 20.85pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0421\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456, \u0448\u0442\u043e \u0433\u0430\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u043e\u0440\u0430\u045e \u0456 \u045e\u0437\u043d\u044f\u0441\u0435\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0437\u0433\u043e\u0440\u043a\u0430\u043c\u0456, \u0456 \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0434\u0430 \u044f\u0435 \u043d\u0430\u0440\u043e\u0434\u044b. \u041c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u201c\u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u0443\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430 \u0456 \u045e \u0434\u043e\u043c \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u043f\u0430 \u042f\u0433\u043e\u043d\u044b\u0445 \u0441\u0446\u0435\u0436\u043a\u0430\u0445, \u0431\u043e \u0437 \u0421\u0456\u0451\u043d\u0430 \u0432\u044b\u0439\u0434\u0437\u0435 \u0417\u0430\u043a\u043e\u043d, \u0430 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u2013 \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"margin: 0pt -2.85pt 0pt -2px; text-indent: 20.85pt; text-align: justify;\"><span>\u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u044f \u043f\u043b\u044f\u043c\u0451\u043d\u044b, \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u044b\u044f \u0434\u0430\u043b\u0451\u043a\u0456\u044f. \u0422\u0430\u0434\u044b \u043f\u0435\u0440\u0430\u043a\u0443\u044e\u0446\u044c \u043c\u044f\u0447\u044b \u0441\u0432\u0430\u0435 \u043d\u0430 \u043f\u043b\u0443\u0433\u0456, \u0430 \u0434\u0437\u0456\u0434\u044b \u0441\u0432\u0430\u0435 \u043d\u0430 \u0441\u044f\u0440\u043f\u044b. \u0423\u0436\u043e \u043d\u0435 \u043f\u0430\u0434\u044b\u043c\u0435 \u043d\u0430\u0440\u043e\u0434 \u043d\u0430 \u043d\u0430\u0440\u043e\u0434 \u043c\u044f\u0447\u0430, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0432\u0430\u044f\u0432\u0430\u0446\u044c. \u041a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u043f\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u043c \u0456 \u043f\u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u0430\u0439, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0435\u0435 \u0441\u0442\u0440\u0430\u0445, \u0431\u043e \u0442\u0430\u043a \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u043b\u0456 \u0432\u0443\u0441\u043d\u044b \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e\u00bb.<\/span><\/p>\r\n<p style=\"margin: 0pt -2.85pt 0pt -2px; text-indent: 20.85pt; text-align: justify;\"><span>\u0425\u043e\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c, \u043a\u043e\u0436\u043d\u044b \u045e \u0456\u043c\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0430\u0434\u043d\u0430\u043a \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043d\u0430\u0432\u0435\u043a\u0456 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"margin: 0pt -2.85pt 0pt -2px; text-indent: 20.85pt; text-align: justify;\"><span>\u00ab\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0437\u0431\u044f\u0440\u0443 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u0445 \u0456 \u0437\u0431\u044f\u0440\u0443 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u0445, \u043d\u0430 \u043a\u0430\u0433\u043e \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043b\u0456\u0445\u0430. \u0406 \u045e\u0447\u044b\u043d\u044e \u0437 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u0445 \u0440\u044d\u0448\u0442\u0443, \u0430 \u0437 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u2013 \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u043d\u0430\u0440\u043e\u0434. \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456 \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0456 \u043d\u0430\u0432\u0435\u043a\u0456\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0456\u0445 4, 2b; \u042f\u043d 4, 25<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u0443\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430 \u0456 \u045e \u0434\u043e\u043c \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0448\u043b\u044f\u0445\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043a\u0430\u0431 \u043c\u044b \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u043f\u0430 \u042f\u0433\u043e\u043d\u044b\u0445 \u0441\u0446\u0435\u0436\u043a\u0430\u0445.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u041c\u0435\u0441\u0456\u044f, \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0430 \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0443\u0441\u0451.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"195","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0456\u0445\u0435\u044f <\/span><span style=\"color: #ff0000;\">4, 14 \u2013 5, 7&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0435\u0441\u0456\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u0435\u043c<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0426\u044f\u043f\u0435\u0440 \u0437\u0431\u044f\u0440\u044b\u0441\u044f \u045e \u0430\u0442\u0440\u0430\u0434\u044b, \u0434\u0430\u0447\u043a\u0430 \u0430\u0442\u0440\u0430\u0434\u0430\u045e. \u0410\u0431\u043b\u043e\u0433\u0430\u0439 \u0430\u0447\u0430\u043f\u0456\u043b\u0456 \u043d\u0430\u0441. \u0423\u0434\u0430\u0440\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u0433\u0430\u044e \u043f\u0430 \u0448\u0447\u0430\u0446\u044d \u0441\u0443\u0434\u0434\u0437\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0410 \u0442\u044b, \u0411\u044d\u0442\u043b\u0435\u0435\u043c-\u042d\u0444\u0440\u0430\u0442\u0430, \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b \u0442\u044b \u0441\u044f\u0440\u043e\u0434 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u042e\u0434\u044b. \u0417 \u0446\u044f\u0431\u0435 \u0432\u044b\u0439\u0434\u0437\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456, \u0456 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0430\u0434 \u0432\u0435\u0447\u043d\u044b\u0445 \u0434\u0437\u0451\u043d. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043f\u0430\u043a\u0456\u043d\u0435 \u0456\u0445 \u0434\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c. \u0422\u0430\u0434\u044b \u0440\u044d\u0448\u0442\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u045e\u0441\u0442\u0430\u043d\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043c\u043e\u0446\u0430\u044e \u041f\u0430\u043d\u0430, \u0443 \u0432\u0435\u043b\u0456\u0447\u044b \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0406 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u0431\u043e \u0442\u0430\u0434\u044b \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456. \u0406 \u0431\u0443\u0434\u0437\u0435 \u0401\u043d \u0441\u043f\u0430\u043a\u043e\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0410\u0441\u0456\u0440\u044b\u044f \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u043d\u0430\u0448\u0443\u044e \u0437\u044f\u043c\u043b\u044e \u0456 \u043a\u0430\u043b\u0456 \u0437\u043e\u0439\u043c\u0435 \u043d\u0430\u0448\u044b\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456, \u0442\u043e \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0435 \u0441\u0435\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0456 \u0432\u043e\u0441\u0435\u043c \u043a\u043d\u044f\u0437\u0451\u045e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439. \u042f\u043d\u044b \u043c\u044f\u0447\u043e\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0441\u0456\u0440\u044b\u0439\u0441\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0430 \u0437\u044f\u043c\u043b\u044e \u041d\u0456\u043c\u0440\u043e\u0434\u0430 \u043b\u044f \u044f\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0430\u045e. \u0401\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0410\u0441\u0456\u0440\u044b\u0456, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u043d\u0430\u0448\u044b\u044f \u0437\u0435\u043c\u043b\u0456 \u0456 \u043a\u0430\u043b\u0456 \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435 \u043d\u0430\u0448\u0443\u044e \u043c\u044f\u0436\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0440\u044d\u0448\u0442\u0430 \u042f\u043a\u0443\u0431\u0430 \u0441\u0442\u0430\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u044f\u043a \u0440\u0430\u0441\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u044f\u043a \u043b\u0456\u0432\u0435\u043d\u044c, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0435 \u043d\u0430 \u0442\u0440\u0430\u0432\u0443. \u042f\u043d\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0447\u0430\u043a\u0430\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445. \u0420\u044d\u0448\u0442\u0430 \u042f\u043a\u0443\u0431\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e, \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u044f\u043a \u043b\u0435\u045e \u0441\u044f\u0440\u043e\u0434 \u0437\u0432\u044f\u0440\u043e\u045e \u043b\u0435\u0441\u0443, \u044f\u043a \u0456\u043b\u044c\u0432\u044f\u043d\u044f \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0430\u0442\u043a\u0430\u045e \u0430\u0432\u0435\u0447\u0430\u043a, \u044f\u043a\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0442\u043e\u043f\u0447\u0430 \u0456 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0435, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u0446\u0430\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041c\u0456\u0445 5, 1. 3. 4; \u0417\u0430\u0445 9, 10bc<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u044d\u0442\u043b\u0435\u0435\u043c, \u0433\u043e\u0440\u0430\u0434 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0437 \u0446\u044f\u0431\u0435 \u0432\u044b\u0439\u0434\u0437\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456, \u0456 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0430\u0434 \u0432\u0435\u0447\u043d\u044b\u0445 \u0434\u0437\u0451\u043d. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0406 \u0431\u0443\u0434\u0437\u0435 \u0401\u043d \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u043d\u0430 \u043d\u0430\u0448\u0430\u0439 \u0437\u044f\u043c\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043c\u0456\u0440, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434 \u043c\u043e\u0440\u0430 \u0434\u0430 \u043c\u043e\u0440\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d.<\/span><span> \u0406 \u0431\u0443\u0434\u0437\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"196","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0456\u0445\u0435\u044f <\/span><span style=\"color: #ff0000;\">6, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043d \u0441\u0443\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0423\u0441\u0442\u0430\u043d\u044c, \u0441\u0443\u0434\u0437\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0433\u0430\u0440\u0430\u043c\u0456, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0433\u043e\u0440\u043a\u0456 \u0447\u0443\u044e\u0446\u044c \u0442\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441\u00bb. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0433\u043e\u0440\u044b, \u0441\u0443\u0434 \u041f\u0430\u043d\u0430, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044f, \u043c\u043e\u0446\u043d\u044b\u044f \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u044b \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u045e \u041f\u0430\u043d\u0430 \u0441\u043f\u0440\u044d\u0447\u043a\u0430 \u0437 \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0456 \u0401\u043d \u0441\u0443\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u041d\u0430\u0440\u043e\u0434\u0437\u0435 \u041c\u043e\u0439, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u0431\u0435, \u0447\u044b\u043c \u044f \u0441\u0442\u0430\u043c\u0456\u045e \u0446\u044f\u0431\u0435? \u0410\u0434\u043a\u0430\u0436\u044b \u041c\u043d\u0435. \u042f \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0446\u044f\u0431\u0435 \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u041c\u0430\u0439\u0441\u0435\u044f, \u0410\u0430\u0440\u043e\u043d\u0430 \u0456 \u041c\u0456\u0440\u044b\u044f\u043c. \u041d\u0430\u0440\u043e\u0434\u0437\u0435 \u041c\u043e\u0439, \u043f\u0440\u0430\u0448\u0443, \u0443\u0441\u043f\u043e\u043c\u043d\u0456, \u0448\u0442\u043e \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u045e \u0411\u0430\u043b\u044f\u043a, \u043a\u0430\u0440\u043e\u043b\u044c \u041c\u0430\u0430\u0431\u0430, \u0456 \u0448\u0442\u043e \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0411\u0430\u043b\u044f\u0430\u043c, \u0441\u044b\u043d \u0411\u044d\u043e\u0440\u0430. \u0410\u0434 \u0421\u0456\u0442\u044b\u043c\u0430 \u0434\u0430 \u0413\u0456\u043b\u044c\u0433\u0430\u043b\u044f \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u043a\u0430\u0431 \u0442\u044b \u043c\u043e\u0433 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u0417 \u0447\u044b\u043c \u044f \u0437\u2019\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c? \u0426\u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u042f\u043c\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u0430\u0434\u043d\u0430\u0433\u0430\u0434\u043e\u0432\u044b\u0445 \u0446\u044f\u043b\u044f\u0442? \u0426\u0456 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0446\u0446\u0430 \u041f\u0430\u043d\u0443 \u0442\u044b\u0441\u044f\u0447\u044b \u0431\u0430\u0440\u0430\u043d\u0430\u045e \u0456 \u0434\u0437\u0435\u0441\u044f\u0442\u043a\u0456 \u0442\u044b\u0441\u044f\u0447 \u043f\u0430\u0442\u043e\u043a\u0430\u045e \u0430\u043b\u0435\u044e? \u0426\u0456 \u043c\u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0437\u0430 \u043c\u0430\u044e \u043f\u0440\u0430\u0432\u0456\u043d\u0443 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u043c\u0430\u0439\u0433\u043e, \u043f\u043b\u043e\u0434 \u043c\u0430\u0439\u0433\u043e \u045e\u043b\u043e\u043d\u043d\u044f \u0437\u0430 \u0433\u0440\u044d\u0445 \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b?\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c, \u0456 \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d: \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0442\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043b\u044e\u0431\u0456\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0436\u044b\u045e \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0413\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0433\u043e\u0440\u0430\u0434, \u0456 \u0440\u043e\u0437\u0443\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f: \u00ab\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0440\u043e\u0437\u0433\u0443 \u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u044f\u0435 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e. \u0426\u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0434\u043e\u043c\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0441\u043a\u0430\u0440\u0431\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u0430\u044f \u043d\u044f\u043f\u043e\u045e\u043d\u0430\u044f \u044d\u0444\u0430? \u0426\u0456 \u0436 \u042f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u044e \u0448\u0430\u043b\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0442\u043e\u0440\u0431\u0443 \u0437 \u043f\u0430\u0434\u043c\u0430\u043d\u043d\u044b\u043c\u0456 \u0433\u0456\u0440\u043a\u0430\u043c\u0456? \u0411\u0430\u0433\u0430\u0446\u0435\u0456 \u0433\u043e\u0440\u0430\u0434\u0430 \u043d\u0430\u0441\u044b\u0447\u0430\u044e\u0446\u0446\u0430 \u043d\u0430\u0441\u0456\u043b\u043b\u0435\u043c, \u044f\u0433\u043e \u0436\u044b\u0445\u0430\u0440\u044b \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u0443, \u0430 \u045e \u0456\u0445\u043d\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445 \u2013 \u0445\u043b\u0443\u0441\u043b\u0456\u0432\u044b \u044f\u0437\u044b\u043a.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0447\u043d\u0443 \u045e\u0434\u0430\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u0446\u044c \u0437\u0430 \u0442\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456. \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0435\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u0441\u044b\u0446\u0456\u0448\u0441\u044f, \u0456 \u043f\u0443\u0441\u0442\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e \u043d\u0443\u0442\u0440\u044b \u0442\u0432\u0430\u0456\u043c. \u0411\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u0430\u043f\u0430\u0448\u0432\u0430\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435\u0448, \u0430 \u0448\u0442\u043e \u045e\u0440\u0430\u0442\u0443\u0435\u0448, \u042f \u0430\u0434\u0434\u0430\u043c \u043f\u0430\u0434 \u043c\u0435\u0447. \u0411\u0443\u0434\u0437\u0435\u0448 \u0441\u0435\u044f\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0431\u044f\u0440\u044d\u0448. \u0411\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u0430\u043b\u0456\u045e\u043a\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0448 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0446\u0446\u0430 \u0430\u043b\u0435\u0435\u043c. \u0411\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b \u0441\u043e\u043a, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0441\u043f\u0440\u0430\u0431\u0443\u0435\u0448 \u0432\u0456\u043d\u0430\u00bb.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0456\u0445 6, 8; \u041f\u0441 37 (36), 3<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c, \u0456 \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d: <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043b\u044e\u0431\u0456\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0436\u044b\u045e \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0447\u044b\u043d\u0456 \u0434\u0430\u0431\u0440\u043e; \u0436\u044b\u0432\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"197","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0456\u0445\u0435\u044f <\/span><span style=\"color: #ff0000;\">7, 7-20&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0413\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b \u0447\u0430\u043a\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u2013 \u0443 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0431\u0443\u0434\u0443 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0443 \u0447\u0430\u043a\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u043c\u0430\u0439\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f; \u043c\u043e\u0439 \u0411\u043e\u0433 \u043c\u044f\u043d\u0435 \u043f\u0430\u0447\u0443\u0435!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0439\u0441\u044f \u0437 \u043c\u044f\u043d\u0435, \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c\u043a\u0430 \u043c\u0430\u044f. \u0425\u043e\u0446\u044c \u044f \u045e\u043f\u0430\u045e, \u0430\u043b\u0435 \u045e\u0441\u0442\u0430\u043d\u0443; \u0445\u043e\u0446\u044c \u044f \u045e \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u041f\u0430\u043d \u2013 \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e! \u0413\u043d\u0435\u045e \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u043c\u043d\u0435, \u0430\u0436 \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043c\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u0439 \u0441\u0443\u0434, \u0431\u043e \u044f \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0433\u043e. \u0401\u043d \u0432\u044b\u0432\u0435\u0434\u0437\u0435 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u044f \u045e\u0431\u0430\u0447\u0443 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0417\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430 \u043c\u0430\u044f \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c\u043a\u0430, \u044f\u043a\u0430\u044f \u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u043d\u0435: \u00ab\u0414\u0437\u0435 \u0401\u043d, \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433?\u00bb \u041c\u0430\u0435 \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u044f\u0435, \u044f\u043d\u0430 \u0445\u0443\u0442\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0434\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u0430\u044f \u044f\u043a \u0432\u0443\u043b\u0456\u0447\u043d\u0430\u044f \u0433\u0440\u0430\u0437\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u0431\u0443\u0434\u043e\u0432\u044b \u0442\u0432\u0430\u0456\u0445 \u043c\u0443\u0440\u043e\u045e, \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u043c\u0435\u0436\u044b. \u0413\u044d\u0442\u0430 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435 \u0430\u0434\u0443\u0441\u044e\u043b\u044c: \u0430\u0434 \u0410\u0441\u0456\u0440\u044b\u0456 \u0434\u0430 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u0430\u0434 \u0415\u0433\u0456\u043f\u0442\u0430 \u0430\u0436 \u0434\u0430 \u0420\u0430\u043a\u0456, \u0456 \u0430\u0434 \u043c\u043e\u0440\u0430 \u0434\u0430 \u043c\u043e\u0440\u0430, \u0456 \u0430\u0434 \u0433\u0430\u0440\u044b \u0434\u0430 \u0433\u0430\u0440\u044b. \u0410 \u0437\u044f\u043c\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430 \u043f\u0430 \u0432\u0456\u043d\u0435 \u044f\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e, \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0456\u0445\u043d\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u0432\u0456 \u0422\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0456\u043c \u043a\u0456\u0435\u043c, \u0430\u0432\u0435\u0447\u0430\u043a \u0422\u0432\u0430\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u0430\u0434\u043d\u044b \u045e \u043b\u0435\u0441\u0435, \u0441\u044f\u0440\u043e\u0434 \u041a\u0430\u0440\u043c\u044d\u043b\u044e. \u041d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u043f\u0430\u0441\u0432\u044f\u0446\u0446\u0430 \u045e \u0411\u0430\u0448\u0430\u043d\u0435 \u0456 \u0413\u0456\u043b\u0435\u0430\u0434\u0437\u0435, \u044f\u043a \u0443 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u044f \u0447\u0430\u0441\u044b. \u042f\u043a \u0443 \u0434\u043d\u0456 \u0432\u044b\u0439\u0441\u0446\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u043f\u0430\u043a\u0430\u0436\u044b \u043d\u0430\u043c \u0446\u0443\u0434\u044b. \u0423\u0431\u0430\u0447\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0437\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0446\u0446\u0430, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u044e \u0441\u0432\u0430\u044e \u043c\u043e\u0446, \u043f\u0430\u043a\u043b\u0430\u0434\u0443\u0446\u044c \u0440\u0443\u043a\u0443 \u043d\u0430 \u0432\u0443\u0441\u043d\u044b, \u0456\u0445\u043d\u0456\u044f \u0432\u0443\u0448\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u0443\u0445\u0456\u044f. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u0456\u0437\u0430\u0446\u044c \u043f\u044b\u043b, \u044f\u043a \u0437\u043c\u0435\u0439, \u044f\u043a \u0437\u044f\u043c\u043d\u044b\u044f \u043f\u0430\u045e\u0437\u0443\u043d\u044b. \u0412\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0417\u0430\u0442\u0440\u0430\u043f\u0435\u0447\u0443\u0446\u044c \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u044f\u0446\u0446\u0430 \u0426\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0426\u044f\u0431\u0435, \u044f\u043a\u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u0456 \u0434\u0430\u0440\u0443\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0440\u044d\u0448\u0446\u0435 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b? \u0401\u043d \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u0435 \u0433\u043d\u0435\u045e \u0441\u0432\u043e\u0439 \u0432\u0435\u0447\u043d\u0430, \u0431\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0401\u043d \u0437\u043d\u043e\u045e \u0437\u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0441\u0430\u0442\u0440\u044d \u043d\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u0456 \u043a\u0456\u043d\u0435 \u045e \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456. \u0422\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u0448 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u043a\u0443\u0431\u0443, \u043f\u0440\u0430\u044f\u0432\u0456\u0448 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u044f\u043a \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0443 \u0434\u0430\u045e\u043d\u0456\u044f \u0447\u0430\u0441\u044b.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0413\u0431\u0440 10, 37b; \u041c\u0456\u0445 7, 19b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0417\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u0456 \u043d\u0435 \u0441\u043f\u043e\u0437\u043d\u0456\u0446\u0446\u0430; \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u044f\u0446\u0446\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0401\u043d \u2013 \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u0441\u0430\u0442\u0440\u044d \u043d\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u0456 \u043a\u0456\u043d\u0435 \u045e \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0401\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"201","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <\/span><span style=\"color: #ff0000;\">6, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0423 \u0433\u043e\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0430\u0440\u0430\u043b\u044f \u0423\u0437\u0456\u0456 \u044f \u0431\u0430\u0447\u044b\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u0456 \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u044b\u043c \u0442\u0440\u043e\u043d\u0435, \u0430 \u043a\u0430\u043d\u0446\u044b \u042f\u0433\u043e\u043d\u044b\u0445 \u0448\u0430\u0442\u0430\u045e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u0421\u0435\u0440\u0430\u0444\u0456\u043c\u044b \u0441\u0442\u0430\u044f\u043b\u0456 \u043d\u0430\u0434 \u0406\u043c. \u041a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u043c\u0435\u045e \u043f\u0430 \u0448\u044d\u0441\u0446\u044c \u043a\u0440\u044b\u043b\u0430\u045e: \u043a\u043e\u0436\u043d\u044b \u0434\u0432\u0443\u043c\u0430 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440, \u0434\u0432\u0443\u043c\u0430 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u045e \u0441\u0432\u0430\u0435 \u043d\u043e\u0433\u0456 \u0456 \u0434\u0432\u0443\u043c\u0430 \u043b\u044f\u0442\u0430\u045e. \u042f\u043d\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e: \u00ab\u0421\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0423\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0410\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u0437\u0430\u0445\u0456\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0432\u0443\u0448\u0430\u043a\u0456 \u0434\u0437\u0432\u044f\u0440\u044d\u0439, \u0430 \u0434\u043e\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0434\u044b\u043c\u0430\u043c. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f: \u00ab\u0413\u043e\u0440\u0430 \u043c\u043d\u0435, \u0431\u043e \u044f \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0456 \u0436\u044b\u0432\u0443 \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0430 \u0432\u043e\u0447\u044b \u043c\u0430\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e!\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043f\u0430\u0434\u043b\u044f\u0446\u0435\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0430\u0434\u0437\u0456\u043d \u0437 \u0441\u0435\u0440\u0430\u0444\u0456\u043c\u0430\u045e, \u0430 \u045e \u0440\u0443\u0446\u044d \u044f\u0433\u043e \u0431\u044b\u045e \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u044b \u0432\u0443\u0433\u0430\u043b\u044c, \u044f\u043a\u0456 \u0451\u043d \u0430\u0431\u0446\u0443\u0433\u0430\u043c\u0456 \u045e\u0437\u044f\u045e \u0437 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430. \u0401\u043d \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0456\u043c \u0434\u0430 \u043c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0412\u043e\u0441\u044c \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430 \u0434\u0430 \u0432\u0443\u0441\u043d\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u0456 \u043f\u0440\u044b\u0431\u0440\u0430\u043d\u0430 \u0442\u0432\u0430\u0451 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0430 \u0433\u0440\u044d\u0445 \u0442\u0432\u043e\u0439 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u044f \u043f\u0430\u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: \u00ab\u041a\u0430\u0433\u043e \u041c\u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u0446\u044c? \u0425\u0442\u043e \u043f\u043e\u0439\u0434\u0437\u0435 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441?\u00bb \u0406 \u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0412\u043e\u0441\u044c \u044f, \u043f\u0430\u0448\u043b\u0456 \u043c\u044f\u043d\u0435!\u00bb \u0410 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0406\u0434\u0437\u0456 \u0456 \u0441\u043a\u0430\u0436\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443: \u201c\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0439\u0446\u0435! \u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0439\u0446\u0435!\u201d \u0417\u0440\u0430\u0431\u0456 \u043d\u044f\u0447\u0443\u043b\u044b\u043c \u0441\u044d\u0440\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u0432\u0443\u0448\u044b \u044f\u0433\u043e \u0437\u0440\u0430\u0431\u0456 \u0433\u043b\u0443\u0445\u0456\u043c\u0456 \u0456 \u0437\u0430\u043a\u043b\u0435\u0439 \u044f\u043c\u0443 \u0432\u043e\u0447\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u0432\u0443\u0448\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u043d\u0435 \u0447\u0443\u045e, \u043a\u0430\u0431 \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0456 \u043d\u0435 \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u045e \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u042f \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u00ab\u0414\u0430\u043a\u0443\u043b\u044c, \u041f\u0430\u043d\u0435?\u00bb \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0410\u0436 \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0430\u043f\u0443\u0441\u0446\u0435\u044e\u0446\u044c \u0433\u0430\u0440\u0430\u0434\u044b, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u0436\u044b\u0445\u0430\u0440\u043e\u045e, \u0456 \u0434\u0430\u043c\u044b, \u0443 \u044f\u043a\u0456\u0445 \u043d\u044f\u043c\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0437\u044f\u043c\u043b\u044f \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u043f\u0443\u0441\u0442\u044d\u0447\u0430\u0439\u00bb. \u041f\u0430\u043d \u0432\u044b\u0434\u0430\u043b\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u0456 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043f\u0443\u0441\u0442\u043a\u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043a\u0440\u0430\u044e. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0443 \u0456\u043c \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u0441\u044f\u0442\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430, \u0442\u043e \u0456 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430, \u044f\u043a \u0442\u044d\u0440\u043f\u0435\u043d\u0442\u044b\u043d\u0430\u0432\u0430\u0435 \u0434\u0440\u044d\u0432\u0430 \u0456 \u044f\u043a \u0434\u0443\u0431, \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0441\u0435\u0447\u043a\u0456 \u044f\u043a\u0456\u0445 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u043d\u044c. \u0421\u0432\u044f\u0442\u044b\u043c \u043d\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0431\u0443\u0434\u0437\u0435 \u044f\u0435 \u043f\u0435\u043d\u044c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 4, 8\u0441; \u0406\u0441 6, 3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0421\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u044f\u043a\u0456 \u0431\u044b\u045e, \u0451\u0441\u0446\u044c \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u0435\u0440\u0430\u0444\u0456\u043c\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: \u0421\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"202","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <\/span><span style=\"color: #ff0000;\">3, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0456 \u043d\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u041f\u0430\u043d \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0430\u0434\u0431\u044f\u0440\u044d \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u045e \u042e\u0434\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0456 \u0430\u043f\u043e\u0440\u0443 \u2013 \u0437\u0430\u043f\u0430\u0441 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0430\u0434\u044b, \u0432\u043e\u043b\u0430\u0442\u0430 \u0456 \u0432\u0430\u044f\u0440\u0430, \u0441\u0443\u0434\u0434\u0437\u044e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u0432\u044f\u0448\u0447\u0443\u043d\u0430 \u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0443, \u043f\u044f\u0446\u0456\u0434\u0437\u044f\u0441\u044f\u0442\u043d\u0456\u043a\u0430 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u0433\u0430, \u0434\u0430\u0440\u0430\u0434\u0446\u0443 \u0456 \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u0437\u043d\u0430\u0445\u0430\u0440\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u043c\u0435\u043b\u0430\u0433\u0430 \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430. \u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u044e\u043d\u0430\u043a\u043e\u045e \u0456\u0445\u043d\u0456\u043c\u0456 \u043a\u043d\u044f\u0437\u044f\u043c\u0456, \u0441\u0432\u0430\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u044e\u0434\u0437\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f. \u042e\u043d\u0430\u043a \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0442\u0430\u0440\u0446\u0430, \u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u043e\u0441\u0442\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u043f\u0430\u0448\u0430\u043d\u044b. \u041a\u043e\u0436\u043d\u044b \u0441\u0445\u043e\u043f\u0456\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u045e \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0456\u043c \u0434\u043e\u043c\u0435 \u0456 \u0441\u043a\u0430\u0436\u0430: \u00ab\u0422\u044b \u043c\u0430\u0435\u0448 \u043f\u043b\u0430\u0448\u0447 \u2013 \u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0448\u044b\u043c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c, \u0456 \u0433\u044d\u0442\u0430\u044f \u0440\u0443\u0456\u043d\u0430 \u2013 \u0443 \u0442\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0451\u043d \u0443\u0441\u0442\u0430\u043d\u0435 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u042f \u043d\u0435 \u043b\u0435\u043a\u0430\u0440, \u0456 \u045e \u043c\u0430\u0456\u043c \u0434\u043e\u043c\u0435 \u043d\u044f\u043c\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u043d\u044f\u043c\u0430 \u043f\u043b\u0430\u0448\u0447\u0430. \u041d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0443!\u00bb \u0411\u043e \u0437\u0430\u0445\u0456\u0441\u0442\u0430\u045e\u0441\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0456 \u045e\u043f\u0430\u043b\u0430 \u042e\u0434\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0456\u0445\u043d\u0456 \u044f\u0437\u044b\u043a \u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u0456\u0445\u043d\u0456\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u044f\u043d\u044b \u0431\u0443\u043d\u0442\u0443\u044e\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b\u0440\u0430\u0437 \u0456\u0445\u043d\u044f\u0433\u0430 \u0442\u0432\u0430\u0440\u0443 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445, \u044f\u043d\u044b \u043d\u0435 \u0445\u0430\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u0440\u044d\u0445, \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e, \u044f\u043a \u0441\u0430\u0434\u0430\u043c\u0456\u0442\u044b. \u0413\u043e\u0440\u0430 \u0456\u043c, \u0431\u043e \u044f\u043d\u044b \u0440\u044b\u0445\u0442\u0443\u044e\u0446\u044c \u0441\u0430\u0431\u0435 \u043b\u0456\u0445\u0430. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0431\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u043f\u043b\u0451\u043d \u0441\u0432\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e. \u0413\u043e\u0440\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0443, \u0431\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0437\u043b\u043e, \u0441\u043f\u0440\u0430\u0432\u044b \u0440\u0443\u043a \u044f\u0433\u043e\u043d\u044b\u0445 \u0430\u0434\u043f\u043b\u043e\u0446\u044f\u0446\u044c \u044f\u043c\u0443. \u041d\u0430\u0440\u043e\u0434\u0437\u0435 \u041c\u043e\u0439! \u0414\u0437\u0435\u0446\u0456 \u045e\u0446\u0456\u0441\u043a\u0430\u044e\u0446\u044c \u044f\u0433\u043e, \u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u0456\u043c. \u041d\u0430\u0440\u043e\u0434\u0437\u0435 \u041c\u043e\u0439! \u0422\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0446\u044f\u0431\u0435 \u0456 \u0437\u0430\u0431\u043b\u044b\u0442\u0432\u0430\u044e\u0446\u044c \u0448\u043b\u044f\u0445 \u0442\u0432\u0430\u0456\u0445 \u0441\u0446\u0435\u0436\u0430\u043a. \u041f\u0430\u043d \u0443\u0441\u0442\u0430\u0435, \u043a\u0430\u0431 \u0432\u0435\u0441\u0446\u0456 \u0441\u043f\u0440\u044d\u0447\u043a\u0443, \u0456 \u0441\u0442\u0430\u0456\u0446\u044c, \u043a\u0430\u0431 \u0441\u0432\u0430\u0440\u044b\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u041f\u0430\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0437 \u044f\u0433\u043e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456: \u00ab\u0412\u044b \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u044b\u043b\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u0443 \u0432\u0430\u0448\u044b\u0445 \u0434\u0430\u043c\u0430\u0445 \u2013 \u043d\u0430\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u0430\u0435 \u045e \u0431\u0435\u0434\u043d\u0430\u0433\u0430. \u0427\u0430\u043c\u0443 \u0432\u044b \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435\u0446\u0435 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u045e\u0446\u0456\u0441\u043a\u0430\u0435\u0446\u0435 \u045e\u0431\u043e\u0433\u0456\u0445?\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 3, 10. 11. 13&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0431\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u043f\u043b\u0451\u043d \u0441\u0432\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0413\u043e\u0440\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0443, \u0431\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0437\u043b\u043e, \u0441\u043f\u0440\u0430\u0432\u044b \u0440\u0443\u043a \u044f\u0433\u043e\u043d\u044b\u0445 \u0430\u0434\u043f\u043b\u043e\u0446\u044f\u0446\u044c \u044f\u043c\u0443.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0443\u0441\u0442\u0430\u0435, \u043a\u0430\u0431 \u0432\u0435\u0441\u0446\u0456 \u0441\u043f\u0440\u044d\u0447\u043a\u0443, \u0456 \u0441\u0442\u0430\u0456\u0446\u044c, \u043a\u0430\u0431 \u0441\u0432\u0430\u0440\u044b\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u043e\u0440\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"203","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <\/span><span style=\"color: #ff0000;\">7, 1-17&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423 \u0441\u0442\u0440\u0430\u0445\u0443 \u0432\u0430\u0439\u043d\u044b \u2013 \u0437\u043d\u0430\u043a \u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0437\u0430, \u0441\u044b\u043d\u0430 \u0401\u0430\u0442\u0430\u043c\u0430, \u0441\u044b\u043d\u0430 \u0423\u0437\u0456\u0456, \u0441\u0456\u0440\u044b\u0439\u0441\u043a\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0420\u044d\u0446\u0456\u043d \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u041f\u0435\u043a\u0430\u0445\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u0420\u044d\u043c\u0430\u043b\u0456\u044f, \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043a\u0430\u0431 \u0437\u0430\u0432\u0430\u044f\u0432\u0430\u0446\u044c \u044f\u0433\u043e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u044f\u0433\u043e \u0437\u0434\u0430\u0431\u044b\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0406 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0434\u043e\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0430: \u00ab\u0410\u0440\u0430\u043c \u0440\u0430\u0437\u0431\u0456\u045e \u043b\u0430\u0433\u0435\u0440 \u0443 \u042d\u0444\u0440\u0430\u0456\u043c\u0435\u00bb. \u0406 \u0437\u0430\u0442\u0440\u044b\u043c\u0446\u0435\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0410\u0445\u0430\u0437\u0430 \u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a \u0434\u0440\u044d\u0432\u044b \u0445\u0456\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u043b\u0435\u0441\u0435 \u0430\u0434 \u0432\u0435\u0442\u0440\u0443. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u0441\u0430\u0456: \u00ab\u0412\u044b\u0439\u0434\u0437\u0456 \u0422\u044b \u0456 \u0442\u0432\u043e\u0439 \u0441\u044b\u043d \u0428\u044d\u0430\u0440-\u042f\u0448\u0443\u0431 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0410\u0445\u0430\u0437\u0443, \u0443 \u043a\u0430\u043d\u0435\u0446 \u043a\u0430\u043d\u0430\u043b\u0430 \u0432\u0435\u0440\u0445\u043d\u044f\u0439 \u0441\u0430\u0436\u0430\u043b\u043a\u0456, \u043d\u0430 \u0448\u043b\u044f\u0445 \u0434\u0430 \u043f\u043e\u043b\u044f \u0432\u0430\u043b\u044e\u0448\u043d\u0456\u043a\u0430\u045e. \u0406 \u0441\u043a\u0430\u0436\u044b \u044f\u043c\u0443:&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u201c\u0411\u0443\u0434\u0437\u044c \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u044b \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456 \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0439 \u0430\u0434\u0432\u0430\u0433\u0456 \u0437-\u0437\u0430 \u0442\u043b\u0435\u043d\u043d\u044f \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u043d\u0435\u0434\u0430\u043f\u0430\u043b\u0435\u043d\u044b\u0445 \u0433\u0430\u043b\u0430\u0432\u0435\u0448\u0430\u043a; \u0437-\u0437\u0430 \u043f\u0430\u043b\u044b\u043c\u044f\u043d\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u0420\u044d\u0446\u0456\u043d\u0430 \u0437 \u0410\u0440\u0430\u043c\u0430\u043c, \u0456 \u0441\u044b\u043d\u0430 \u0420\u044d\u043c\u0430\u043b\u0456\u044f; \u0437-\u0437\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0410\u0440\u0430\u043c, \u042d\u0444\u0440\u0430\u0456\u043c \u0456 \u0441\u044b\u043d \u0420\u044d\u043c\u0430\u043b\u0456\u044f \u0437\u0430\u0434\u0443\u043c\u0430\u043b\u0456 \u0437\u043b\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u2018\u041f\u043e\u0439\u0434\u0437\u0435\u043c \u043d\u0430 \u042e\u0434\u0443, \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435\u043c \u044f\u0435 \u0456 \u0437\u0430\u0445\u043e\u043f\u0456\u043c, \u0456 \u0437\u0440\u043e\u0431\u0456\u043c \u044f\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0441\u044b\u043d\u0430 \u0422\u0430\u0431\u044d\u044d\u043b\u044f\u2019!\u201d \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u201c\u041d\u0435 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435! \u0411\u043e \u0441\u0442\u0430\u043b\u0456\u0446\u0430 \u0421\u0456\u0440\u044b\u0456 \u2013 \u0414\u0430\u043c\u0430\u0441\u043a, \u0430 \u0433\u0430\u043b\u0430\u0432\u0430 \u0414\u0430\u043c\u0430\u0441\u043a\u0430 \u2013 \u0420\u044d\u0446\u0456\u043d. \u042f\u0448\u0447\u044d \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u043f\u044f\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u0456 \u042d\u0444\u0440\u0430\u0456\u043c \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u0431\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0421\u0442\u0430\u043b\u0456\u0446\u0430 \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u2013 \u0421\u0430\u043c\u0430\u0440\u044b\u044f, \u0430 \u0433\u0430\u043b\u0430\u0432\u0430 \u0421\u0430\u043c\u0430\u0440\u044b\u0456 \u2013 \u0441\u044b\u043d \u0420\u044d\u043c\u0430\u043b\u0456\u044f. \u041a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u0435, \u043d\u0435 \u045e\u0441\u0442\u0430\u0456\u0446\u0435\u201d\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0434\u0430 \u0410\u0445\u0430\u0437\u0430 \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0440\u0430\u0441\u0456 \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0437\u043d\u0430\u043a \u0446\u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u0446\u0456 \u0432\u044b\u0441\u043e\u043a\u0430 \u045e\u0433\u0430\u0440\u044b\u00bb. \u0410\u043b\u0435 \u0410\u0445\u0430\u0437 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u0441\u0430\u044f: \u00ab\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0436, \u0434\u043e\u043c \u0414\u0430\u0432\u0456\u0434\u0430\u045e: \u0446\u0456 \u043c\u0430\u043b\u0430 \u0432\u0430\u043c, \u0448\u0442\u043e \u0434\u0430\u043a\u0443\u0447\u0430\u0435\u0446\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0434\u044b\u043a \u0432\u044b \u044f\u0448\u0447\u044d \u0434\u0430\u043a\u0443\u0447\u0430\u0435\u0446\u0435 \u043c\u0430\u0439\u043c\u0443 \u0411\u043e\u0433\u0443? \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0441\u0430\u043c \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0437\u043d\u0430\u043a: \u0432\u043e\u0441\u044c \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u043d\u0435 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0421\u044b\u043d\u0430, \u0456 \u0434\u0430\u0441\u0446\u044c \u042f\u043c\u0443 \u0456\u043c\u044f \u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044c. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0432\u044f\u0440\u0448\u043a\u0456 \u0456 \u043c\u0451\u0434, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0430\u0434\u043a\u0456\u0434\u0430\u0446\u044c \u0437\u043b\u043e \u0456 \u0432\u044b\u0431\u0456\u0440\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e. \u0411\u043e \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0445\u043b\u043e\u043f\u0435\u0446 \u0430\u0434\u043a\u0456\u0434\u0430\u0446\u044c \u0437\u043b\u043e \u0456 \u0432\u044b\u0431\u0456\u0440\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b \u043a\u0440\u0430\u0439, \u0434\u0432\u0443\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f. \u041f\u0440\u0430\u0437 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0441\u0456\u0440\u044b\u0456 \u041f\u0430\u043d \u0441\u043f\u0430\u0448\u043b\u0435 \u043d\u0430 \u0446\u044f\u0431\u0435, \u043d\u0430 \u0442\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u043d\u0430 \u0434\u043e\u043c \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0434\u043d\u0456, \u044f\u043a\u0456\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e \u0437 \u0447\u0430\u0441\u043e\u045e \u0430\u0434\u043b\u0443\u0447\u044d\u043d\u043d\u044f \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0430\u0434 \u042e\u0434\u044b.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0406\u0441 7, 14b; 8, 10c; \u041b\u043a 1, 30\u0430. 31\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0412\u043e\u0441\u044c \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u043d\u0435 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0421\u044b\u043d\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0434\u0430\u0434\u0443\u0446\u044c \u042f\u043c\u0443 \u0456\u043c\u044f \u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0437 \u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u041c\u0430\u0440\u044b\u044f; \u0432\u043e\u0441\u044c \u0437\u0430\u0447\u043d\u0435\u0448 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u0434\u0430\u0434\u0443\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"204","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <\/span><span style=\"color: #ff0000;\">9, 7 \u2013 10, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0413\u043d\u0435\u045e \u0411\u043e\u0436\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u043b\u043e\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u043a\u0443\u0431\u0430 \u2013 \u0456 \u045e\u043f\u0430\u043b\u0430 \u044f\u043d\u043e \u043d\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u041f\u0430\u0437\u043d\u0430\u045e \u044f\u0433\u043e \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u042d\u0444\u0440\u0430\u0456\u043c \u0456 \u0436\u044b\u0445\u0430\u0440\u044b \u0421\u0430\u043c\u0430\u0440\u044b\u0456. \u0417 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u044b\u0445\u0456 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430 \u044f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0426\u044d\u0433\u043b\u0430 \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u043b\u0430\u0441\u044f, \u0434\u044b\u043a \u043f\u0430\u0431\u0443\u0434\u0443\u0435\u043c \u0437 \u0447\u0430\u0441\u0430\u043d\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e; \u0441\u0456\u043a\u0430\u043c\u043e\u0440\u044b \u043f\u0430\u0432\u044b\u0440\u0430\u0437\u0430\u043d\u044b\u044f, \u0434\u044b\u043a \u0437\u0430\u043c\u0435\u043d\u0456\u043c \u0456\u0445 \u043a\u0435\u0434\u0440\u0430\u043c\u0456!\u00bb \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0420\u044d\u0446\u0456\u043d\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0456 \u043f\u0430\u0434\u0431\u0443\u0445\u0442\u043e\u0440\u044b\u045e \u044f\u0433\u043e \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e. \u0410\u0440\u0430\u043c \u0437 \u0443\u0441\u0445\u043e\u0434\u0443 \u0456 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0435 \u0437 \u0437\u0430\u0445\u0430\u0434\u0443 \u043f\u0430\u0436\u044b\u0440\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u043e\u045e\u043d\u0430\u0439 \u043f\u0430\u0448\u0447\u0430\u0439. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0433\u043d\u0435\u045e \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u042f\u0433\u043e \u0440\u0443\u043a\u0430 \u045e\u0437\u043d\u044f\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0434\u0430\u0440\u0430\u045e \u044f\u0433\u043e, \u0456 \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0422\u0430\u043c\u0443 \u0430\u0434\u0441\u0435\u043a \u041f\u0430\u043d \u0433\u0430\u043b\u0430\u0432\u0443 \u0456 \u0445\u0432\u043e\u0441\u0442 \u0406\u0437\u0440\u0430\u044d\u043b\u044e, \u0441\u0446\u044f\u0431\u043b\u043e \u043f\u0430\u043b\u044c\u043c\u044b \u0456 \u0442\u0440\u044b\u0441\u043d\u044f\u0433\u0443 \u0437\u0430 \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c. \u0421\u0442\u0430\u0440\u0430\u0446 \u0456 \u043f\u0430\u0432\u0430\u0436\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u2013 \u0433\u044d\u0442\u0430 \u0433\u0430\u043b\u0430\u0432\u0430, \u0430 \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a\u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u0445\u043b\u0443\u0441\u043d\u0456, \u2013 \u0433\u044d\u0442\u0430 \u0445\u0432\u043e\u0441\u0442. \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u044f\u0433\u043e, \u0430 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0432\u044f\u0434\u0443\u0446\u044c, \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u044f. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u044f\u0433\u043e \u044e\u043d\u0430\u043a\u043e\u045e \u0456 \u043d\u0430\u0434 \u044f\u0433\u043e \u0441\u0456\u0440\u043e\u0442\u0430\u043c\u0456 \u0456 \u045e\u0434\u043e\u0432\u0430\u043c\u0456 \u043d\u0435 \u0437\u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430, \u0431\u043e \u045e\u0441\u0435 \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0430\u043c\u0456, \u0456 \u0432\u0443\u0441\u043d\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u044b. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0433\u043d\u0435\u045e \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u042f\u0433\u043e \u0440\u0443\u043a\u0430 \u045e\u0437\u043d\u044f\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0411\u043e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u043b\u0430\u043b\u0430 \u044f\u043a \u0430\u0433\u043e\u043d\u044c, \u0448\u0442\u043e \u043f\u0430\u0436\u044b\u0440\u0430\u0435 \u0446\u0435\u0440\u043d\u0456 \u0434\u044b \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435, \u0432\u044b\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0433\u0443\u0448\u0447\u0430\u0440\u044b \u043b\u0435\u0441\u0443, \u0430\u0436 \u0443\u0437\u0434\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u043a\u043b\u0443\u0431\u044b \u0434\u044b\u043c\u0443. \u0413\u043d\u0435\u0432\u0430\u043c \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u043b\u0435\u043d\u0430 \u0437\u044f\u043c\u043b\u044f, \u0430 \u043b\u044e\u0434\u0437\u0456 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u043d\u0456\u0431\u044b \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439 \u0434\u043b\u044f \u0430\u0433\u043d\u044e. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430. \u0410\u0434\u0440\u0430\u0437\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u0430, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c, \u0435\u0441\u0446\u044c \u0437\u043b\u0435\u0432\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430. \u041a\u043e\u0436\u043d\u044b \u043f\u0430\u0436\u044b\u0440\u0430\u0435 \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u043b\u044f\u0447\u0430: \u041c\u0430\u043d\u0430\u0441\u044d\u0441 \u042d\u0444\u0440\u0430\u0456\u043c\u0430, \u042d\u0444\u0440\u0430\u0456\u043c \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430, \u0430 \u0440\u0430\u0437\u0430\u043c \u044f\u043d\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042e\u0434\u044b. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0433\u043d\u0435\u045e \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u042f\u0433\u043e \u0440\u0443\u043a\u0430 \u045e\u0437\u043d\u044f\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0435 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0437\u0430\u043a\u043e\u043d\u044b \u0456 \u043f\u0456\u0448\u0430 \u043b\u0456\u0445\u0456\u044f \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u043a\u0430\u0431 \u0441\u043b\u0430\u0431\u044b\u0445 \u0430\u0434\u0432\u0435\u0441\u0446\u0456 \u0430\u0434 \u0441\u0443\u0434\u0430, \u0430 \u045e\u0431\u043e\u0433\u0456\u0445 \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u043a\u0430\u0431 \u0443\u0434\u043e\u0432\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439, \u043a\u0430\u0431 \u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0441\u0456\u0440\u043e\u0442\u0430\u045e. \u0410 \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u043e\u0431\u0456\u0446\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0437\u0434\u0430\u043b\u0451\u043a \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435? \u041a\u0430\u0433\u043e \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0446\u0435 \u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0456 \u0434\u0437\u0435 \u043f\u0430\u043a\u0456\u043d\u0435\u0446\u0435 \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456? \u0425\u0442\u043e \u043d\u0435 \u0441\u0445\u0456\u043b\u0456\u0446\u044c \u043a\u0430\u043b\u0435\u043d\u0456 \u044f\u043a \u043f\u0430\u043b\u043e\u043d\u043d\u044b, \u0442\u043e\u0439 \u0443\u043f\u0430\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0437\u0430\u0431\u0456\u0442\u044b\u0445. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0433\u043d\u0435\u045e \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u042f\u0433\u043e \u0440\u0443\u043a\u0430 \u045e\u0437\u043d\u044f\u0442\u0430.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u043b 2, 1&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041e, \u044f\u043a \u0430\u0445\u0456\u043d\u0443\u045e \u0433\u043d\u0435\u0432\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u043d \u0434\u0430\u0447\u043a\u0443 \u0421\u0456\u0451\u043d\u0430, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0441\u043a\u0456\u043d\u0443\u045e \u0437 \u043d\u0435\u0431\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0445\u0432\u0430\u043b\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u045e\u0441\u043f\u043e\u043c\u043d\u0456\u045e \u0443 \u0434\u0437\u0435\u043d\u044c \u0433\u043d\u0435\u0432\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u043d\u043e\u0433. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u043a\u0456\u043d\u0443\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"205","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <\/span><span style=\"color: #ff0000;\">11, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u043e\u0440\u0430\u043d\u044c \u0415\u0441\u044d\u044f. \u0412\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0440\u044d\u0448\u0442\u044b \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0412\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0437 \u043f\u043d\u044f \u0415\u0441\u044d\u0435\u0432\u0430\u0433\u0430, \u0456 \u0430\u0442\u043e\u0436\u044b\u043b\u0430\u043a \u0437 \u044f\u0433\u043e \u043a\u0430\u0440\u0430\u043d\u0451\u045e \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u043e\u0434; \u0456 \u0441\u043f\u0430\u0447\u043d\u0435 \u043d\u0430 \u0456\u043c \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u043e\u0437\u0443\u043c\u0443, \u0434\u0443\u0445 \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456, \u0434\u0443\u0445 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0456 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0431\u043e\u044f\u0437\u0437\u044e \u041f\u0430\u043d\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u0437 \u043f\u043e\u0433\u043b\u044f\u0434\u0443 \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439, \u0456 \u043d\u0435 \u0441\u0430 \u0441\u043b\u044b\u0445\u0443 \u0432\u0443\u0448\u044d\u0439 \u0441\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043f\u0440\u044b\u0441\u0443\u0434. \u0420\u043e\u0437\u0433\u0430\u0439 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u0456 \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0437\u0430\u0431\u2019\u0435 \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u044f\u0433\u043e \u0431\u0451\u0434\u0440\u0430\u0445, \u0430 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u2013 \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0432\u043e\u045e\u043a \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043d\u0451\u043c, \u0456 \u043b\u0435\u0430\u043f\u0430\u0440\u0434 \u0431\u0443\u0434\u0437\u0435 \u043b\u044f\u0436\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u043a\u0430\u0437\u043b\u044f\u043d\u0451\u043c. \u0426\u044f\u043b\u044f \u0456 \u043c\u0430\u043b\u0430\u0434\u044b \u043b\u0435\u045e, \u0456 \u0432\u043e\u043b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c, \u0430 \u043c\u0430\u043b\u044b \u0445\u043b\u043e\u043f\u0447\u044b\u043a \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0433\u0430\u043d\u044f\u0446\u044c \u0456\u0445. \u041a\u0430\u0440\u043e\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043c\u044f\u0434\u0437\u0432\u0435\u0434\u0437\u0456\u0446\u0430\u0439, \u0456 \u0434\u0437\u0435\u0446\u0456 \u0456\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u044f\u0436\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c. \u041b\u0435\u045e, \u044f\u043a \u0432\u043e\u043b, \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u0441\u0430\u043b\u043e\u043c\u0443. \u041d\u0435\u043c\u0430\u045e\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0433\u0443\u043b\u044f\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u044e \u0430\u0441\u043f\u0456\u0434\u0430, \u0456 \u0434\u0437\u0456\u0446\u044f \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u0433\u043d\u044f\u0437\u0434\u0430 \u0433\u0430\u0434\u0437\u044e\u043a\u0456. \u041d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u0430 \u0430\u043d\u0456 \u0448\u043a\u043e\u0434\u044b \u043d\u0430 \u045e\u0441\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u043c\u0430\u0451\u0439, \u0431\u043e \u0437\u044f\u043c\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u041f\u0430\u043d\u0430, \u044f\u043a \u0432\u043e\u0434\u0430\u043c\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u043c\u043e\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043a\u043e\u0440\u0430\u043d\u044c \u0415\u0441\u044d\u044f, \u044f\u043a\u0456 \u0441\u0442\u0430\u043d\u0435 \u0437\u043d\u0430\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456, \u0456 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0441\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0437\u043d\u043e\u045e \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443, \u043a\u0430\u0431 \u0432\u044b\u043a\u0443\u043f\u0456\u0446\u044c \u0440\u044d\u0448\u0442\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0430\u044f \u0430\u0446\u0430\u043b\u0435\u043b\u0430 \u0437 \u0410\u0441\u0456\u0440\u044b\u0456 \u0456 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0437 \u041f\u0430\u0442\u0440\u0430\u0441\u0430, \u0437 \u041a\u0443\u0448\u0430, \u0437 \u042d\u043b\u0430\u043c\u0430, \u0437 \u0421\u0456\u043d\u0430\u0430\u0440\u0430, \u0437 \u0425\u0430\u043c\u0430\u0442\u0430 \u0456 \u0437 \u043c\u0430\u0440\u0441\u043a\u0456\u0445 \u0430\u0441\u0442\u0440\u0430\u0432\u043e\u045e. \u0401\u043d \u0443\u0437\u043d\u044f\u0441\u0435 \u0437\u043d\u0430\u043a \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0437\u0431\u044f\u0440\u044d \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u0437 \u042e\u0434\u044b \u0437\u0431\u044f\u0440\u044d \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u043a\u0430\u043d\u0446\u043e\u045e \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u0434\u044b \u0441\u043f\u044b\u043d\u0456\u0446\u0446\u0430 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c \u042d\u0444\u0440\u0430\u0456\u043c\u0430, \u0456 \u0432\u043e\u0440\u0430\u0433\u0456 \u042e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b. \u042d\u0444\u0440\u0430\u0456\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c \u042e\u0434\u0437\u0435, \u0430 \u042e\u0434\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0440\u0430\u0433\u0430\u0432\u0430\u0446\u044c \u0437 \u042d\u0444\u0440\u0430\u0456\u043c\u0430\u043c. \u0406 \u0437\u0432\u0430\u043b\u044f\u0446\u0446\u0430 \u043d\u0430 \u0445\u0440\u044b\u0431\u0435\u0442 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e \u0443 \u0431\u043e\u043a \u043c\u043e\u0440\u0430, \u0440\u0430\u0437\u0430\u043c \u0430\u0431\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u0423\u0441\u0445\u043e\u0434\u0443. \u042d\u0434\u043e\u043c \u0456 \u041c\u0430\u0430\u0431 \u0442\u0440\u0430\u043f\u044f\u0446\u044c \u0443 \u0456\u0445 \u0440\u0443\u043a\u0456, \u0430 \u0441\u044b\u043d\u044b \u0410\u043c\u043e\u043d\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0456\u0445 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0430\u0441\u0443\u0448\u044b\u0446\u044c \u0437\u0430\u043b\u0456\u045e \u0415\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430 \u043c\u043e\u0440\u0430 \u0456 \u045e\u0437\u043c\u0430\u0445\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u043e\u044e \u043d\u0430\u0434 \u0420\u0430\u043a\u043e\u0439 \u0443 \u0441\u0456\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0442\u0445\u043d\u0435\u043d\u043d\u044f \u0456 \u0440\u0430\u0437\u0434\u0437\u0435\u043b\u0456\u0446\u044c \u044f\u0435 \u043d\u0430 \u0441\u0435\u043c \u043f\u0430\u0442\u043e\u043a\u0430\u045e, \u0442\u0430\u043a \u0448\u0442\u043e \u043c\u043e\u0436\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456 \u044f\u0435 \u045e \u0441\u0430\u043d\u0434\u0430\u043b\u044f\u0445. \u0422\u0430\u043a \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0448\u043b\u044f\u0445 \u0434\u043b\u044f \u0440\u044d\u0448\u0442\u044b \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0448\u0442\u043e \u0430\u0446\u0430\u043b\u0435\u043b\u0430 \u045e \u0410\u0441\u0456\u0440\u044b\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0442\u0430\u043c\u0443, \u044f\u043a\u0456 \u043c\u0435\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0443 \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0439\u0441\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 55, 12; 11, 16<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span>&nbsp;\u0412\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u043e\u0439\u0434\u0437\u0435\u0446\u0435, \u0456 \u045e \u0441\u0443\u043f\u0430\u043a\u043e\u0456 \u043f\u0430\u0432\u044f\u0434\u0443\u0446\u044c \u0432\u0430\u0441. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0413\u043e\u0440\u044b \u0456 \u045e\u0437\u0433\u043e\u0440\u043a\u0456 \u0432\u044b\u0431\u0443\u0445\u043d\u0443\u0446\u044c \u0441\u043f\u0435\u0432\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456, \u0430 \u045e\u0441\u0435 \u043f\u0430\u043b\u044f\u0432\u044b\u044f \u0434\u0440\u044d\u0432\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u043b\u044f\u0441\u043a\u0430\u0446\u044c \u0443 \u0434\u0430\u043b\u043e\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.&nbsp;<\/span><span>\u0422\u0430\u043a \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0448\u043b\u044f\u0445 \u0434\u043b\u044f \u0440\u044d\u0448\u0442\u044b \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0448\u0442\u043e \u0430\u0446\u0430\u043b\u0435\u043b\u0430 \u045e \u0410\u0441\u0456\u0440\u044b\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0442\u0430\u043c\u0443, \u044f\u043a\u0456 \u043c\u0435\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0443 \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0439\u0441\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u043e\u0440\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"206","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <\/span><span style=\"color: #ff0000;\">30, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u0441\u0430\u044e\u0437\u0430\u045e \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0413\u043e\u0440\u0430 \u045e\u043f\u0430\u0440\u0442\u044b\u043c \u0441\u044b\u043d\u0430\u043c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u042f\u043d\u044b \u0441\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u0437\u0430\u0434\u0443\u043c\u044b, \u0430\u043b\u0435 \u043d\u0435 \u041c\u0430\u0435, \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e\u0446\u044c \u0441\u0430\u044e\u0437\u044b, \u0430\u043b\u0435 \u043d\u0435 \u045e \u041c\u0430\u0456\u043c \u0434\u0443\u0445\u0443, \u0430 \u043a\u0430\u0431 \u0434\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u0433\u0440\u044d\u0445 \u0434\u0430 \u0433\u0440\u0430\u0445\u0443. \u042f\u043d\u044b \u043d\u0435 \u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u041c\u044f\u043d\u0435 \u0456 \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e \u0415\u0433\u0456\u043f\u0435\u0442, \u043a\u0430\u0431 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u045e \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0446\u044f\u043d\u0456 \u0415\u0433\u0456\u043f\u0442\u0430. \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0441\u043e\u0440\u0430\u043c\u0430\u043c, \u0430 \u043f\u0440\u044b\u0442\u0443\u043b\u0430\u043a \u0443 \u0446\u044f\u043d\u0456 \u0415\u0433\u0456\u043f\u0442\u0430 \u2013 \u0433\u0430\u043d\u044c\u0431\u0430\u044e. \u0411\u043e \u0445\u043e\u0446\u044c \u044f\u0433\u043e \u043a\u043d\u044f\u0437\u0456 \u045e \u0421\u0430\u043e\u043d\u0435 \u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456\u043a\u0456 \u044f\u0433\u043e \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0425\u0430\u043d\u0430\u0441\u0430, \u043a\u043e\u0436\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0433\u0430\u043d\u044c\u0431\u0443 \u0437-\u0437\u0430 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433 \u044f\u043c\u0443 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u043c\u0443 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430\u043b\u0435 \u0441\u043e\u0440\u0430\u043c, \u0456 \u043d\u0430\u0432\u0430\u0442 \u0433\u0430\u043d\u044c\u0431\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u0436\u044b\u0432\u0451\u043b\u0430\u045e \u041d\u044d\u0433\u0435\u0431\u0430. \u041f\u0440\u0430\u0437 \u0437\u044f\u043c\u043b\u044e \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443, \u0456\u043b\u044c\u0432\u0456\u0446\u044b \u0456 \u0440\u044b\u043a\u0430\u044e\u0447\u0430\u0433\u0430 \u0456\u043b\u044c\u0432\u0430, \u0437\u043c\u0435\u044f \u0456 \u043b\u044f\u0442\u0430\u044e\u0447\u0430\u0433\u0430 \u0446\u043c\u043e\u043a\u0430 \u0432\u044f\u0437\u0443\u0446\u044c \u043d\u0430 \u0445\u0440\u044b\u0431\u0446\u0435 \u0430\u0441\u043b\u043e\u045e \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u0456 \u043d\u0430 \u0433\u0430\u0440\u0431\u0435 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u045e \u0441\u0432\u0430\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u0434\u043b\u044f \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443. \u0414\u0430\u043f\u0430\u043c\u043e\u0433\u0430 \u0415\u0433\u0456\u043f\u0442\u0430 \u2013 \u043f\u0430\u0434\u043c\u0430\u043d \u0456 \u043f\u0443\u0441\u0442\u043a\u0430. \u0422\u0430\u043c\u0443 \u042f \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e: \u201c\u0420\u0430\u0445\u0430\u0431 \u0431\u044f\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u044f\u043f\u0435\u0440 \u0456\u0434\u0437\u0456, \u043d\u0430\u043f\u0456\u0448\u044b \u0433\u044d\u0442\u0430 \u043d\u0430 \u0434\u043e\u0448\u0446\u044b \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u0456 \u045e \u043a\u043d\u0456\u0437\u0435 \u0437\u0430\u043f\u0456\u0448\u044b \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0434\u043d\u0456, \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u0411\u043e \u044f\u043d\u044b \u043d\u0430\u0440\u043e\u0434 \u0443\u043f\u0430\u0440\u0442\u044b, \u0441\u044b\u043d\u044b \u043f\u0430\u0434\u043c\u0430\u043d\u0443, \u0441\u044b\u043d\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e \u041f\u0430\u043d\u0430. \u042f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0456\u0434\u0443\u0448\u0447\u044b\u043c: \u201c\u041d\u0435 \u043c\u0430\u0439\u0446\u0435 \u0432\u0456\u0437\u0456\u0439!\u201d \u0410 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c: \u201c\u041d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u0446\u0435 \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u0430\u045e\u0434\u044b! \u041a\u0430\u0436\u044b\u0446\u0435 \u043d\u0430\u043c \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435, \u043f\u0440\u0430\u0440\u043e\u0447\u0446\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u0430\u0435! \u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435 \u0437 \u0434\u0430\u0440\u043e\u0433\u0456, \u0441\u044b\u0434\u0437\u0456\u0446\u0435 \u0441\u0430 \u0441\u0446\u0435\u0436\u043a\u0456! \u0423\u0447\u044b\u043d\u0456\u0446\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u043f\u0440\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f!\u201d&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u201c\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0435\u0441\u044f \u043d\u0430 \u0433\u0432\u0430\u043b\u0442 \u0456 \u043f\u043e\u0434\u0441\u0442\u0443\u043f \u0456 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435\u0441\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u043e \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0433\u044d\u0442\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u0430 \u044f\u043a \u0440\u0430\u0441\u043a\u043e\u043b\u0456\u043d\u0430, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0440\u0443\u0456\u043d\u044b. \u041a\u0430\u043b\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u043c\u0443\u0440\u044b, \u0451\u043d \u0440\u0430\u043f\u0442\u0430\u043c, \u0443 \u0430\u0434\u043d\u0443 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0440\u0430\u0437\u0432\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430. \u0410 \u0437\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u044f\u0433\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0440\u0430\u0437\u0431\u0456\u0446\u0446\u044f \u0433\u043b\u0456\u043d\u044f\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u043d\u0430, \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430 \u0441\u043a\u0440\u044b\u0448\u0430\u043d\u0430\u0433\u0430, \u0456 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u044f\u0433\u043e \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u0432\u0430\u043b\u043a\u0430\u045e \u0447\u0430\u0440\u0430\u043f\u043a\u0430, \u043a\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0430\u0433\u043e\u043d\u044c \u0437 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430 \u0446\u0456 \u043a\u0430\u0431 \u0437\u0430\u0447\u044d\u0440\u043f\u043d\u0443\u0446\u044c \u0432\u0430\u0434\u044b \u0437 \u043a\u043e\u043f\u0430\u043d\u043a\u0456\u201d\u00bb. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u00ab\u0423 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0443 \u0446\u0456\u0448\u044b \u0456 \u0434\u0430\u0432\u0435\u0440\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u0430 \u0441\u0456\u043b\u0430. \u0410\u043b\u0435 \u0432\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456. \u0421\u043a\u0430\u0437\u0430\u043b\u0456: \u201c\u041d\u0435! \u0411\u043e \u043d\u0430 \u043a\u0430\u043d\u0456 \u043c\u044b \u045e\u0446\u044f\u0447\u044d\u043c\u201d. \u0414\u043e\u0431\u0440\u0430, \u0443\u0446\u044f\u0447\u044d\u0446\u0435! \u201c\u041d\u0430 \u0445\u0443\u0442\u043a\u0456\u0445 \u043f\u0430\u0441\u043a\u0430\u0447\u0430\u043c!\u201d \u0414\u043e\u0431\u0440\u0430, \u0430\u043b\u0435 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0443\u0442\u0447\u044d\u0439\u0448\u044b\u044f \u0437\u0430 \u0432\u0430\u0441. \u0410\u0434\u043d\u0430 \u0442\u044b\u0441\u044f\u0447\u0430 \u0437\u0430\u0434\u0440\u044b\u0436\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u044e \u0430\u0434\u043d\u0430\u0433\u043e, \u0430\u0434 \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u043f\u0435\u0446\u044f\u0440\u044b\u0445 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0446\u044f\u043a\u0430\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0437 \u0432\u0430\u0441 \u0440\u044d\u0448\u0442\u0430, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0436\u044d\u0440\u0434\u043a\u0430 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b, \u044f\u043a \u0448\u043e\u0441\u0442 \u043d\u0430 \u043f\u0430\u0433\u043e\u0440\u043a\u0443!\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>&nbsp;\u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0447\u0430\u043a\u0430\u0435, \u043a\u0430\u0431 \u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c \u043b\u0430\u0441\u043a\u0443, \u0442\u0430\u043c\u0443 \u045e\u0441\u0442\u0430\u043d\u0435, \u043a\u0430\u0431 \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456. \u0411\u043e \u041f\u0430\u043d \u2013 \u0411\u043e\u0433 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430!&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 30, 15b. 18\u0430d&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0423 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0443 \u0446\u0456\u0448\u044b \u0456 \u0434\u0430\u0432\u0435\u0440\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u0430 \u0441\u0456\u043b\u0430.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0447\u0430\u043a\u0430\u0435, \u043a\u0430\u0431 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0441; \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423 \u0446\u0456\u0448\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"207","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456<\/span><span style=\"color: #ff0000;\">37, 21-35<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0406\u0441\u0430\u044f \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0430\u0441\u0456\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0441\u0430\u044f, \u0441\u044b\u043d \u0410\u043c\u043e\u0441\u0430, \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430 \u042d\u0437\u044d\u0445\u0456\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0421\u0435\u043d\u0430\u0445\u0435\u0440\u044b\u0431\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0441\u0456\u0440\u044b\u0456, \u0432\u043e\u0441\u044c \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0433\u043e:&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0442\u0430\u0431\u043e\u044e, \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0435\u0446\u0446\u0430 \u0437 \u0446\u044f\u0431\u0435 \u0434\u0437\u0435\u0432\u0430, \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430. \u041a\u0456\u0432\u0430\u0435 \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u045e\u0441\u043b\u0435\u0434 \u0437\u0430 \u0442\u0430\u0431\u043e\u044e \u0434\u0430\u0447\u043a\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u041a\u0430\u0433\u043e \u0442\u044b \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u045e, \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u045e \u043a\u0430\u043c\u0443? \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0430\u0433\u043e \u045e\u0437\u043d\u0456\u043c\u0430\u045e \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u0437\u0432\u044b\u0441\u043e\u043a\u0443? \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f! \u041f\u0440\u0430\u0437 \u0441\u043b\u0443\u0433\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0442\u044b \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u045e \u041f\u0430\u043d\u0430 \u0456 \u043a\u0430\u0437\u0430\u045e: \u201c\u0417 \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446 \u043c\u0430\u0456\u0445 \u044f \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u044f \u0433\u043e\u0440\u044b, \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u041b\u0456\u0431\u0430\u043d\u0430 \u0456 \u0441\u0441\u0435\u043a \u044f\u0433\u043e \u0432\u044b\u0441\u043e\u043a\u0456\u044f \u043a\u0435\u0434\u0440\u044b, \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f \u043a\u0456\u043f\u0430\u0440\u044b\u0441\u044b. \u042f \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e \u043d\u0430\u0439\u0434\u0430\u043b\u0435\u0439\u0448\u044b\u0445 \u0432\u044f\u0440\u0448\u044b\u043d\u044c, \u0443 \u0433\u043b\u044b\u0431 \u044f\u0433\u043e \u0433\u0443\u0448\u0447\u0430\u0440\u0443. \u042f \u043a\u0430\u043f\u0430\u045e \u0441\u0442\u0443\u0434\u043d\u0456 \u0456 \u043f\u0456\u045e \u0432\u0430\u0434\u0443, \u0456 \u0432\u044b\u0441\u0443\u0448\u044b\u045e \u0441\u0442\u0443\u043f\u043d\u044f\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u043d\u043e\u0433 \u0443\u0441\u0435 \u043a\u0430\u043d\u0430\u043b\u044b \u0415\u0433\u0456\u043f\u0442\u0430\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0442\u044b \u043d\u0435 \u0447\u0443\u045e? \u0417\u0434\u0430\u045e\u043d\u0430 \u042f \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0433\u044d\u0442\u0430, \u0437 \u0434\u0430\u045e\u043d\u0456\u0445 \u0434\u0437\u0451\u043d \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0433\u044d\u0442\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c. \u0426\u044f\u043f\u0435\u0440 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e \u0433\u044d\u0442\u0430, \u0431\u043e \u0442\u044b \u0437\u043c\u043e\u0436\u0430\u0448 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0443 \u0433\u0440\u0443\u0434\u044b \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u043d\u0435\u043f\u0440\u044b\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b. \u0406\u0445\u043d\u0456\u044f \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b\u044f \u0436\u044b\u0445\u0430\u0440\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0436\u0430\u0445\u0430\u043c \u0456 \u0437\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0446\u0446\u0430, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u043f\u0430\u043b\u044f\u0432\u0430\u044f \u0440\u0430\u0441\u043b\u0456\u043d\u043d\u0430\u0441\u0446\u044c, \u044f\u043a \u043c\u0430\u043b\u0430\u0434\u0430\u044f \u0437\u0435\u043b\u044f\u043d\u0456\u043d\u0430, \u044f\u043a \u0442\u0440\u0430\u0432\u0430 \u043d\u0430 \u0434\u0430\u0445\u0430\u0445, \u044f\u043a\u0430\u044f \u0432\u044b\u0441\u044b\u0445\u0430\u0435 \u0430\u0434 \u0443\u0441\u0445\u043e\u0434\u043d\u044f\u0433\u0430 \u0432\u0435\u0442\u0440\u0443. \u042f \u0432\u0435\u0434\u0430\u044e, \u043a\u0430\u043b\u0456 \u0442\u044b \u0441\u044f\u0434\u0430\u0435\u0448, \u043a\u0430\u043b\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0448 \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0448, \u0456 \u043a\u0430\u043b\u0456 \u0430\u0431\u0443\u0440\u0430\u0435\u0448\u0441\u044f \u043d\u0430 \u041c\u044f\u043d\u0435. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0430\u0431\u0443\u0440\u0430\u0435\u0448\u0441\u044f \u043d\u0430 \u041c\u044f\u043d\u0435, \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u0434\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u041c\u0430\u0456\u0445 \u0432\u0443\u0448\u044d\u0439, \u042f \u0437\u0430\u0446\u044f\u0433\u043d\u0443 \u043a\u0430\u043b\u044c\u0446\u043e \u045e \u0442\u0432\u0430\u0435 \u043d\u043e\u0437\u0434\u0440\u044b \u0434\u044b \u0437\u0430\u0446\u0443\u0433\u043b\u044f\u044e \u0446\u044f\u0431\u0435 \u0456 \u0432\u044f\u0440\u043d\u0443 \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443, \u043f\u0430 \u044f\u043a\u043e\u0439 \u0442\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0437\u043d\u0430\u043a: \u0443 \u0433\u044d\u0442\u044b \u0433\u043e\u0434 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0441\u043b\u044f \u0436\u043d\u0456\u0432\u0430, \u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0433\u043e\u0434 \u2013 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0440\u0430\u0441\u0446\u0435 \u0441\u0430\u043c\u043e, \u0430 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0433\u043e\u0434 \u0441\u0435\u0439\u0446\u0435 \u0456 \u0436\u043d\u0456\u0446\u0435, \u0441\u0430\u0434\u0437\u0456\u0446\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0456 \u0456 \u0435\u0448\u0446\u0435 \u0456\u0445 \u043f\u043b\u0430\u0434\u044b. \u0422\u0430\u0434\u044b \u0430\u0446\u0430\u043b\u0435\u043b\u0430\u044f \u0440\u044d\u0448\u0442\u0430 \u0437 \u0434\u043e\u043c\u0443 \u042e\u0434\u044b \u0437\u043d\u043e\u045e \u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043a\u043e\u0440\u0430\u043d\u044c \u0443\u0433\u043b\u044b\u0431 \u0456 \u0434\u0430\u0441\u0446\u044c \u043f\u043b\u043e\u0434 \u0443\u0433\u0430\u0440\u044b. \u0411\u043e \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0432\u044b\u0439\u0434\u0437\u0435 \u0440\u044d\u0448\u0442\u0430 \u0456 \u0437 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0446\u0430\u043b\u0435\u043b\u0430. \u0420\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0433\u044d\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u043f\u0440\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0441\u0456\u0440\u044b\u0456: \u0401\u043d \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0456 \u043d\u0435 \u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0442\u0430\u043c \u0441\u0442\u0440\u0430\u043b\u044b, \u043d\u0435 \u043f\u0430\u0434\u044b\u0434\u0437\u0435 \u0434\u0430 \u044f\u0433\u043e \u0441\u0430 \u0448\u0447\u044b\u0442\u043e\u043c \u0456 \u043d\u0435 \u043d\u0430\u0441\u044b\u043f\u0435 \u0432\u0430\u043b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e. \u0412\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u044e, \u044f\u043a\u043e\u0439 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 52, 9b-10<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0421\u0443\u0446\u0435\u0448\u044b\u045e \u041f\u0430\u043d \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0443\u0441\u0435 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u0432\u044f\u0442\u043e\u0435 \u043f\u043b\u044f\u0447\u043e \u0441\u0432\u0430\u0451 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u045e\u0431\u0430\u0447\u0430\u0446\u044c.&nbsp;<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"211","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0421\u0430\u0444\u043e\u043d\u0456\u0456 <\/span><span style=\"color: #ff0000;\">1, 1-7. 14 \u2013 2, 3<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0443\u0434 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n\r\n\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u0430 \u0421\u0430\u0444\u043e\u043d\u0456\u0456, \u0441\u044b\u043d\u0430 \u041a\u0443\u0448\u0430, \u0441\u044b\u043d\u0430 \u0413\u0435\u0434\u0430\u043b\u0456\u0456, \u0441\u044b\u043d\u0430 \u0410\u043c\u0430\u0440\u044b\u0456, \u0441\u044b\u043d\u0430 \u042d\u0437\u044d\u0445\u0456\u0456 \u045e \u0434\u043d\u0456 \u0401\u0441\u0456\u0456, \u0441\u044b\u043d\u0430 \u0410\u043c\u043e\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u042e\u0434\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0414\u0430\u0448\u0447\u044d\u043d\u0442\u0443 \u0437\u043d\u0456\u0448\u0447\u0443 \u045e\u0441\u0451 \u0437 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0412\u044b\u043d\u0456\u0448\u0447\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0436\u044b\u0432\u0451\u043b\u0443, \u0432\u044b\u043d\u0456\u0448\u0447\u0443 \u043f\u0442\u0443\u0448\u043a\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0456 \u0440\u044b\u0431\u0443 \u043c\u0430\u0440\u0441\u043a\u0443\u044e, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0435\u0435 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445. \u0412\u044b\u043a\u0430\u0440\u0430\u043d\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u044f\u043c\u043b\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0446\u044f\u0433\u043d\u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043d\u0430\u0434 \u042e\u0434\u0430\u0439 \u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0456 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u044e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430 \u0441\u043b\u044f\u0434\u044b \u0411\u0430\u0430\u043b\u044f, \u0456\u043c\u044f \u0436\u0440\u0430\u0446\u043e\u045e \u0441\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430 \u0434\u0430\u0445\u0430\u0445 \u0430\u0434\u0431\u0456\u0432\u0430\u0435 \u043f\u0430\u043a\u043b\u043e\u043d\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u0432\u043e\u0439\u0441\u043a\u0443, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e, \u0431\u2019\u044e\u0447\u044b \u043f\u0430\u043a\u043b\u043e\u043d\u044b, \u043a\u043b\u044f\u043d\u0435\u0446\u0446\u0430 \u041f\u0430\u043d\u0430\u043c \u0456 \u043a\u043b\u044f\u043d\u0435\u0446\u0446\u0430 \u041c\u0456\u043b\u044c\u043a\u043e\u043c\u0430\u043c. \u0422\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u041f\u0430\u043d\u0430 \u0456 \u0445\u0442\u043e \u043d\u0435 \u0448\u0443\u043a\u0430\u0435 \u041f\u0430\u043d\u0430, \u0456 \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0430\u045e\u0447\u044b\u0446\u0435 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u0431\u043e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u0431\u043b\u0456\u0437\u043a\u0456, \u0431\u043e \u041f\u0430\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u0443, \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u043f\u0440\u043e\u0448\u0430\u043d\u044b\u0445. \u0411\u043b\u0456\u0437\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430. \u0411\u043b\u0456\u0437\u043a\u0456 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0445\u0443\u0442\u043a\u0456. \u0413\u043e\u043b\u0430\u0441 \u0434\u043d\u044f \u041f\u0430\u043d\u0430 \u0433\u043e\u0440\u043a\u0456. \u041d\u0430\u0432\u0430\u0442 \u043c\u0443\u0436\u043d\u044b \u0442\u0430\u0434\u044b \u0437\u0430\u0435\u043d\u0447\u044b\u0446\u044c. \u0414\u0437\u0435\u043d\u044c \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0434\u043d\u0451\u043c \u0433\u043d\u0435\u0432\u0443, \u0434\u043d\u0451\u043c \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443, \u0434\u043d\u0451\u043c \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0456 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u044f, \u0434\u043d\u0451\u043c \u0446\u0435\u043c\u0440\u044b \u0456 \u0437\u043c\u0440\u043e\u043a\u0443, \u0434\u043d\u0451\u043c \u0445\u043c\u0430\u0440\u044b \u0456 \u0433\u0443\u0441\u0442\u043e\u0433\u0430 \u0434\u044b\u043c\u0443, \u0434\u043d\u0451\u043c \u0433\u0443\u0447\u0430\u043d\u043d\u044f \u0442\u0440\u0443\u0431\u044b \u0456 \u0431\u0430\u044f\u0432\u043e\u0433\u0430 \u0432\u043e\u043a\u043b\u0456\u0447\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u044b\u0441\u043e\u043a\u0456\u0445 \u0432\u0435\u0436\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043d\u0430\u0434\u043e\u043b\u044e \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0456\u0431\u044b \u0441\u043b\u044f\u043f\u044b\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u041a\u0440\u043e\u045e \u0456\u0445\u043d\u044f\u044f \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0441\u043f\u044b\u0440\u0441\u043a\u0430\u043d\u0430\u044f \u043d\u0456\u0431\u044b \u043f\u044b\u043b, \u0430 \u0432\u0430\u043d\u0442\u0440\u043e\u0431\u044b \u0456\u0445\u043d\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0433\u043d\u043e\u0439. \u041d\u0456 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456\u0445\u043d\u044f\u0435, \u043d\u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0456\u0445 \u0443 \u0434\u0437\u0435\u043d\u044c \u0433\u043d\u0435\u0432\u0443 \u041f\u0430\u043d\u0430, \u0431\u043e \u0430\u0433\u043e\u043d\u044c \u042f\u0433\u043e \u0437\u043b\u043e\u0441\u0446\u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e, \u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u045e\u0441\u0456\u043c \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0431\u044f\u0440\u044b\u0446\u0435\u0441\u044f \u0456 \u0441\u044b\u0434\u0437\u0456\u0446\u0435\u0441\u044f, \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u044b \u043d\u0430\u0440\u043e\u0434\u0437\u0435! \u041f\u0430\u043a\u0443\u043b\u044c \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u043f\u0440\u044b\u0441\u0443\u0434, \u0434\u0437\u0435\u043d\u044c \u0440\u0430\u0437\u0432\u0435\u0435\u0446\u0446\u0430, \u044f\u043a \u043c\u044f\u043a\u0456\u043d\u0430; \u043f\u0430\u043a\u0443\u043b\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0430\u0441 \u0434\u0437\u0435\u043d\u044c \u0433\u043d\u0435\u0432\u0443 \u041f\u0430\u043d\u0430. \u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0430, \u0443\u0441\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u0446\u0435 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b. \u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0430\u043a\u043e\u0440\u044b; \u043c\u043e\u0436\u0430 \u0432\u0430\u043c \u0443\u0434\u0430\u0441\u0446\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0434\u0437\u0435\u043d\u044c \u0433\u043d\u0435\u0432\u0443 \u041f\u0430\u043d\u0430\u00bb.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0421\u0430\u0444 2, 3; \u041b\u043a 6, 20b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0430, \u0443\u0441\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u0446\u0435 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0430\u043a\u043e\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f, \u0431\u043e \u0432\u0430\u0448\u0430 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0428\u0443\u043a\u0430\u0439\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"212","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0421\u0430\u0444\u043e\u043d\u0456\u0456 <\/span><span style=\"color: #ff0000;\">3, 8-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0431\u043e\u0433\u0456\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0422\u0430\u043c\u0443 \u0447\u0430\u043a\u0430\u0439\u0446\u0435 \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0434\u0430 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u042f \u045e\u0441\u0442\u0430\u043d\u0443 \u0434\u0437\u0435\u043b\u044f \u0437\u0434\u0430\u0431\u044b\u0447\u044b, \u0431\u043e \u043d\u0430 \u0441\u0432\u043e\u0439 \u0441\u0443\u0434 \u042f \u0437\u0431\u044f\u0440\u0443 \u043d\u0430\u0440\u043e\u0434\u044b, \u0441\u043a\u043b\u0456\u0447\u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u044b, \u043a\u0430\u0431 \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u043d\u0430 \u0456\u0445 \u041c\u043e\u0439 \u043f\u0440\u0430\u043a\u043b\u0451\u043d, \u0443\u0432\u0435\u0441\u044c \u0436\u0430\u0440 \u041c\u0430\u0439\u0433\u043e \u0433\u043d\u0435\u0432\u0443, \u0431\u043e \u0430\u0433\u043e\u043d\u044c \u041c\u0430\u0451\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u0442\u0430\u0434\u044b \u042f \u0432\u044f\u0440\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0447\u044b\u0441\u0442\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u042f\u043c\u0443 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430. \u0417 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443 \u0440\u044d\u043a \u0437\u044f\u043c\u043b\u0456 \u041a\u0443\u0448 \u041c\u0430\u0435 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0456\u043a\u0456, \u041c\u043e\u0439 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u043d\u0430\u0440\u043e\u0434, \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u041c\u043d\u0435 \u0434\u0430\u0440.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0442\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u044f\u043a\u0456\u043c\u0456 \u0442\u044b \u0433\u0440\u0430\u0448\u044b\u043b\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435. \u0411\u043e \u0442\u0430\u0434\u044b \u042f \u0432\u044b\u0433\u0430\u043d\u044e \u0437 \u0442\u0432\u0430\u0439\u0433\u043e \u0430\u0441\u044f\u0440\u043e\u0434\u0434\u0437\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0442\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u0447\u0443, \u0456 \u0442\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0432\u044b\u0448\u0430\u0446\u0446\u0430 \u043d\u0430 \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b. \u042f \u043f\u0430\u043a\u0456\u043d\u0443 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0456 \u0431\u0435\u0434\u043d\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443 \u045e \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430. \u0420\u044d\u0448\u0442\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u0443, \u0456 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u045e \u0456\u0445\u043d\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b \u044f\u0437\u044b\u043a, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0420\u0430\u0434\u0443\u0439\u0441\u044f, \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430! \u0422\u0440\u044b\u0443\u043c\u0444\u0443\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c! \u0412\u0435\u0441\u044f\u043b\u0456\u0441\u044f \u0456 \u0440\u0430\u0434\u0443\u0439\u0441\u044f \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0434\u0430\u0447\u043a\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430! \u0410\u0434\u043c\u044f\u043d\u0456\u045e \u041f\u0430\u043d \u043f\u0440\u044b\u0441\u0443\u0434 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u043f\u0440\u0430\u0433\u043d\u0430\u045e \u0432\u043e\u0440\u0430\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e! \u041f\u0430\u043d, \u041a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435, \u0443\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0448 \u0437\u043b\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0443: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0421\u0456\u0451\u043d! \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0441\u043b\u0430\u0431\u043d\u0443\u0446\u044c \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0435! \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435, \u041c\u0430\u0433\u0443\u0442\u043d\u044b, \u0401\u043d \u0437\u0431\u0430\u0432\u0456\u0446\u044c! \u0411\u0443\u0434\u0437\u0435 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0442\u0430\u0431\u043e\u044e, \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u0437 \u043a\u0440\u044b\u043a\u0430\u043c \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u0456. \u042f \u0437\u0430\u0431\u044f\u0440\u0443 \u0430\u0434 \u0446\u044f\u0431\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0433\u0430\u043d\u044c\u0431\u044b. \u0412\u043e\u0441\u044c \u042f \u0437\u0430\u0439\u043c\u0443\u0441\u044f \u045e\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u045e \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441, \u0443\u0440\u0430\u0442\u0443\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043a\u0443\u043b\u044c\u0433\u0430\u0435, \u0430 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u0437\u0431\u044f\u0440\u0443. \u0410\u0434\u0430\u0440\u0443 \u0456\u0445 \u0445\u0432\u0430\u043b\u043e\u044e \u0456 \u0441\u043b\u0430\u0432\u0430\u044e \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0434\u0437\u0435 \u0456\u0445 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043b\u0456. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0432\u0430\u0441 \u0456 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441 \u0437\u0431\u044f\u0440\u0443 \u0432\u0430\u0441, \u0431\u043e \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u043b\u0430\u0432\u0443 \u0456 \u0445\u0432\u0430\u043b\u0443 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u043b\u0456 \u0437\u043c\u044f\u043d\u044e \u0432\u0430\u0448 \u043b\u0451\u0441 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0432\u0430\u0448\u044b\u0445\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0421\u0430\u0444 3, 12. 13\u0430. 9\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043a\u0456\u043d\u0443 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0456 \u0431\u0435\u0434\u043d\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0440\u044d\u0448\u0442\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443 \u045e \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u0430\u0434\u044b \u042f \u0432\u044f\u0440\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0447\u044b\u0441\u0442\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0440\u044d\u0448\u0442\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"213","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">1, 1-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u044b \u0415\u0440\u0430\u043c\u0456\u0456, \u0441\u044b\u043d\u0430 \u0425\u0456\u043b\u043a\u0456\u0456, \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0410\u043d\u0430\u0442\u043e\u0446\u0435, \u0443 \u0437\u044f\u043c\u043b\u0456 \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0430. \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u045e \u0434\u043d\u0456 \u0401\u0441\u0456\u0456, \u0441\u044b\u043d\u0430 \u0410\u043c\u043e\u043d\u0430, \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0443 \u0442\u0440\u044b\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0433\u043e\u0434 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f. \u0411\u044b\u043b\u043e \u0433\u044d\u0442\u0430 \u045e \u0434\u043d\u0456 \u0401\u044f\u043a\u0456\u043c\u0430, \u0441\u044b\u043d\u0430 \u0401\u0441\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u044f \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430, \u0430\u0436 \u0434\u0430 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0430\u0434\u0437\u0456\u043d\u0430\u0446\u0446\u0430\u0442\u0430\u0433\u0430 \u0433\u043e\u0434\u0443 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0421\u044d\u0434\u044d\u043a\u0456\u0456, \u0441\u044b\u043d\u0430 \u0401\u0441\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u044f \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430, \u0456 \u0430\u0436 \u0434\u0430 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u043d\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u043f\u044f\u0442\u044b \u043c\u0435\u0441\u044f\u0446.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>C\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u041f\u0430\u043d \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0420\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456, \u042f \u043f\u0430\u0437\u043d\u0430\u045e \u0446\u044f\u0431\u0435, \u0456 \u0440\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f, \u042f \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0446\u044f\u0431\u0435, \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e\u00bb. \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041e \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u044f \u043d\u0435 \u045e\u043c\u0435\u044e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0431\u043e \u044f \u043d\u0430\u0434\u0442\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u041d\u0435 \u043a\u0430\u0436\u044b: \u201c\u042f \u043d\u0430\u0434\u0442\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u201d, \u0431\u043e \u0434\u0430 \u045e\u0441\u0456\u0445, \u0434\u0430 \u043a\u0430\u0433\u043e \u042f \u043f\u0430\u0448\u043b\u044e \u0446\u044f\u0431\u0435, \u043f\u043e\u0439\u0434\u0437\u0435\u0448, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u0442\u0430\u0431\u0435, \u0441\u043a\u0430\u0436\u0430\u0448. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445, \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0430\u0431 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0446\u044f\u0431\u0435\u00bb, \u2013 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u041f\u0430\u043d \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: \u00ab\u0412\u043e\u0441\u044c \u042f \u045e\u043a\u043b\u0430\u045e \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0442\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b. \u0413\u043b\u044f\u0434\u0437\u0456, \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b\u0440\u044b\u0432\u0430\u0446\u044c \u0456 \u0431\u0443\u0440\u044b\u0446\u044c, \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u0456 \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u0446\u044c, \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0456 \u0441\u0430\u0434\u0437\u0456\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u043e\u0442\u044b\u043c \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0426\u0456 \u0442\u044b \u0431\u0430\u0447\u044b\u0448 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c?\u00bb \u0406 \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u0431\u0430\u0447\u0443 \u0433\u0430\u043b\u0456\u043d\u043a\u0443 \u043c\u0456\u043d\u0434\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430\u00bb. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: \u00ab\u0422\u044b \u0434\u043e\u0431\u0440\u0430 \u0431\u0430\u0447\u044b\u0448, \u0431\u043e \u044f \u0447\u0443\u0432\u0430\u044e \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u043a\u0430\u0431 \u044f\u043d\u043e \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0428\u0442\u043e \u0442\u044b \u0431\u0430\u0447\u044b\u0448?\u00bb \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u0431\u0430\u0447\u0443 \u043a\u0456\u043f\u044f\u0447\u044b \u043a\u0430\u0446\u0451\u043b, \u043f\u0430\u0445\u0456\u043b\u0435\u043d\u044b \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447\u00bb. \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0417 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0430 \u045e\u0441\u0456\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456. \u0411\u043e \u0432\u043e\u0441\u044c \u042f \u043f\u0430\u043a\u043b\u0456\u0447\u0443 \u045e\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0437 \u043f\u0430\u045e\u043d\u043e\u0447\u043d\u044b\u0445 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u042f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c, \u0456 \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0442\u0440\u043e\u043d \u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u0434\u0430 \u0431\u0440\u0430\u043c\u0430\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u043a\u0430\u043b\u044f \u045e\u0441\u0456\u0445 \u044f\u0435 \u043c\u0443\u0440\u043e\u045e \u0456 \u043a\u0430\u043b\u044f \u045e\u0441\u0456\u0445 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e. \u042f \u0432\u044b\u043d\u0435\u0441\u0443 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u0432\u043e\u0439 \u043f\u0440\u044b\u0441\u0443\u0434 \u0437\u0430 \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041c\u044f\u043d\u0435, \u043a\u0430\u0434\u0437\u0456\u043b\u0456 \u0456\u043d\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u043c \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0442\u0432\u043e\u0440\u0430\u043c \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u044b \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b \u0441\u0432\u0430\u0435 \u0431\u0451\u0434\u0440\u044b, \u0443\u0441\u0442\u0430\u043d\u044c \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u0442\u0430\u0431\u0435. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445, \u043a\u0430\u0431 \u042f \u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0446\u044f\u0431\u0435 \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456. \u0412\u043e\u0441\u044c \u042f \u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0430\u043c, \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u043e\u043c \u0456 \u043c\u0443\u0440\u0430\u043c\u0456 \u0437 \u0431\u0440\u043e\u043d\u0437\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445\u043d\u0456\u0445 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u0446\u044f\u0431\u0435, \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043a\u0430\u0431 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 1, 5\u0430b. 9b; \u0406\u0441 42, 6&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0420\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456, \u042f \u043f\u0430\u0437\u043d\u0430\u045e \u0446\u044f\u0431\u0435, \u0456 \u0440\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f, \u042f \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0446\u044f\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u042f \u045e\u043a\u043b\u0430\u045e \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0442\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f, \u041f\u0430\u043d, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0446\u044f\u0431\u0435 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0446\u044f\u0431\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f \u045e\u043a\u043b\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"214","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">2, 1-13. 20-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0406\u0434\u0437\u0456 \u0456 \u043a\u0440\u044b\u0447\u044b \u045e \u0432\u0443\u0448\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u042f \u043f\u0430\u043c\u044f\u0442\u0430\u044e \u043f\u0440\u0430 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u043f\u0440\u0430 \u0442\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e, \u043a\u0430\u043b\u0456 \u0442\u044b \u0431\u044b\u043b\u0430 \u043d\u044f\u0432\u0435\u0441\u0442\u0430\u044e, \u043a\u0430\u043b\u0456 \u0445\u0430\u0434\u0437\u0456\u043b\u0430 \u0437\u0430 \u041c\u043d\u043e\u044e \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u043f\u0430 \u043d\u0435\u0437\u0430\u0441\u0435\u044f\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u044b\u045e \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u044b \u041f\u0430\u043d\u0443, \u0431\u044b\u045e \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u042f\u0433\u043e \u045e\u0440\u0430\u0434\u0436\u0430\u044e. \u0423\u0441\u0435, \u0445\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u0436\u044b\u0440\u0430\u045e, \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c\u0456, \u0456\u0445 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043b\u0430 \u0437\u043b\u043e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u043e\u043c \u042f\u043a\u0443\u0431\u0430 \u0456 \u045e\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u042f\u043a\u043e\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u045e\u0432\u0430 \u041c\u043d\u0435 \u0432\u0430\u0448\u044b\u044f \u0430\u0439\u0446\u044b, \u0448\u0442\u043e \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u041c\u044f\u043d\u0435 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u044e \u0456 \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043b\u0456 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u044e. \u0406 \u043d\u0435 \u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f: \u201c\u0414\u0437\u0435 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0432\u0451\u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u043f\u0440\u0430\u0437 \u043a\u0440\u0430\u0439 \u0441\u0442\u044d\u043f\u0430\u045e \u0456 \u0446\u044f\u0441\u043d\u0456\u043d, \u043f\u0440\u0430\u0437 \u0437\u044f\u043c\u043b\u044e \u0441\u0443\u0445\u0443\u044e \u0456 \u0437\u043c\u0440\u043e\u0447\u043d\u0443\u044e, \u043f\u0440\u0430\u0437 \u0437\u044f\u043c\u043b\u044e, \u0434\u0437\u0435 \u043d\u0435 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u0434\u0437\u0435 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0436\u044b\u0432\u0435\u201d. \u042f \u043f\u0440\u044b\u0432\u0451\u045e \u0432\u0430\u0441 \u043d\u0430 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u0432\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u044f\u0435 \u043f\u043b\u0451\u043d \u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u0410 \u0432\u044b \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u0456 \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u043b\u0456 \u041c\u0430\u044e \u0437\u044f\u043c\u043b\u044e, \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0433\u0430\u043d\u044c\u0431\u0443 \u0437 \u041c\u0430\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b. \u0421\u0432\u044f\u0442\u0430\u0440\u044b \u043d\u0435 \u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f: \u201c\u0414\u0437\u0435 \u041f\u0430\u043d?\u201d \u0417\u043d\u0430\u045e\u0446\u044b \u0417\u0430\u043a\u043e\u043d\u0443 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u041c\u044f\u043d\u0435, \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043b\u0456 \u043f\u0440\u0430\u0437 \u0411\u0430\u0430\u043b\u044f \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0434\u0430\u043b\u0435\u0439 \u0431\u0443\u0434\u0443 \u0441\u043f\u0440\u0430\u0447\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0456 \u0437 \u0441\u044b\u043d\u0430\u043c\u0456 \u0441\u044b\u043d\u043e\u045e \u0432\u0430\u0448\u044b\u0445 \u0431\u0443\u0434\u0443 \u0441\u0432\u0430\u0440\u044b\u0446\u0446\u0430. \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u041a\u0456\u0446\u0456\u043c\u0430 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u0448\u043b\u0456\u0446\u0435 \u045e \u041a\u0435\u0434\u0430\u0440 \u0456 \u043f\u0440\u0430\u0432\u0435\u0440\u0446\u0435 \u0434\u043e\u0431\u0440\u0430, \u0443\u0431\u0430\u0447\u0446\u0435, \u0446\u0456 \u0431\u044b\u043b\u043e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435? \u0426\u0456 \u0437\u0430\u043c\u044f\u043d\u0456\u045e \u044f\u043a\u0456 \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u0430\u0456\u0445 \u0431\u0430\u0433\u043e\u045e, \u0445\u043e\u0446\u044c \u044f\u043d\u044b \u043d\u0435 \u0437\u02bc\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0431\u0430\u0433\u0430\u043c\u0456? \u0410 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0437\u0430\u043c\u044f\u043d\u0456\u045e \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443 \u043d\u0430 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u0443\u044e \u0440\u044d\u0447. \u0410\u0434\u0447\u0443\u0439\u0446\u0435 \u0436\u0430\u0445 \u0437-\u0437\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u043d\u044f\u0431\u0451\u0441\u044b, \u0437\u0430\u0434\u0440\u044b\u0436\u044b\u0446\u0435, \u0441\u043f\u0443\u0436\u0430\u0439\u0446\u0435\u0441\u044f \u043c\u043e\u0446\u043d\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0411\u043e \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0443\u0447\u044b\u043d\u0456\u045e \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0435 \u0437\u043b\u043e: \u044f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041c\u044f\u043d\u0435, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u0432\u044b\u0447\u0430\u0441\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0446\u044b\u0441\u0442\u044d\u0440\u043d\u044b, \u0446\u044b\u0441\u0442\u044d\u0440\u043d\u044b \u0434\u0437\u044e\u0440\u0430\u0432\u044b\u044f, \u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0430\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u0437\u0434\u0430\u045e\u043d\u0430 \u0437\u043b\u0430\u043c\u0430\u043b\u0430 \u0441\u0432\u0430\u0451 \u044f\u0440\u043c\u043e, \u043f\u0430\u0440\u0432\u0430\u043b\u0430 \u0441\u0432\u0430\u0435 \u043f\u0443\u0442\u044b \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u201c\u041d\u0435 \u0431\u0443\u0434\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c\u201d. \u041d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u043f\u0430\u0433\u043e\u0440\u043a\u0443 \u0456 \u043f\u0430\u0434 \u043a\u043e\u0436\u043d\u044b\u043c \u0437\u044f\u043b\u0451\u043d\u044b\u043c \u0434\u0440\u044d\u0432\u0430\u043c \u0442\u044b \u043a\u043b\u0430\u043b\u0430\u0441\u044f \u044f\u043a \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430. \u0410 \u042f \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u0446\u044f\u0431\u0435 \u044f\u043a \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u044f\u043a \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435. \u042f\u043a \u0436\u0430 \u0422\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u045e \u0447\u0443\u0436\u0443\u044e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0443\u044e \u043b\u0430\u0437\u0443? \u041d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0430\u0431\u043c\u044b\u0435\u0448\u0441\u044f \u043b\u0443\u0433\u0430\u043c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0448\u0447\u043e\u043b\u0430\u043a\u0443, \u0431\u0440\u0443\u0434 \u0442\u0432\u0430\u0439\u0433\u043e \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e\u201d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. \u042f\u043a \u043c\u043e\u0436\u0430\u0448 \u043a\u0430\u0437\u0430\u0446\u044c: \u201c\u042f \u043d\u0435 \u0437\u0430\u0431\u0440\u0443\u0434\u0437\u0456\u043b\u0430\u0441\u044f, \u044f \u043d\u0435 \u0445\u0430\u0434\u0437\u0456\u043b\u0430 \u0437\u0430 \u0411\u0430\u0430\u043b\u044f\u043c\u0456\u201d? \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0441\u0432\u0430\u044e \u0434\u0430\u0440\u043e\u0433\u0443 \u045e \u0434\u0430\u043b\u0456\u043d\u0435, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439, \u0448\u0442\u043e \u0442\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0430, \u0436\u0432\u0430\u0432\u0430\u044f \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0437\u0456\u0446\u0430, \u044f\u043a\u0430\u044f \u0437\u0430\u0431\u043b\u044b\u0442\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0456. \u0414\u0437\u0456\u043a\u0430\u044f \u0430\u0441\u043b\u0456\u0446\u0430, \u043f\u0440\u044b\u0432\u0443\u0447\u0430\u043d\u0430\u044f \u0434\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u044f\u043a\u0430\u044f \u045e \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0443\u0446\u044f\u0433\u0432\u0430\u0435 \u043f\u0430\u0432\u0435\u0442\u0440\u0430. \u0425\u0442\u043e \u0441\u0442\u0440\u044b\u043c\u0430\u0435 \u044f\u0435 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c? \u0423\u0441\u0435, \u0445\u0442\u043e \u044f\u0435 \u0448\u0443\u043a\u0430\u0435, \u0431\u0435\u0437 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u044f\u0435 \u045e \u044f\u0435 \u043c\u0435\u0441\u044f\u0446\u044b. \u0411\u0435\u0440\u0430\u0436\u044b \u0441\u0432\u0430\u044e \u043d\u0430\u0433\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0431\u043e\u0441\u0430\u0439, \u0430 \u0433\u043e\u0440\u043b\u0430 \u0441\u0432\u0430\u0451, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u043e\u0445\u043b\u0430. \u0410\u0434\u043d\u0430\u043a \u0422\u044b \u043a\u0430\u0436\u0430\u0448: \u201c\u041b\u0456\u0445\u0430 \u0437 \u0456\u043c! \u041d\u0435! \u0411\u043e \u044f \u043b\u044e\u0431\u043b\u044e \u0447\u0443\u0436\u044b\u0445 \u0456 \u043f\u0430\u0439\u0434\u0443 \u0437\u0430 \u0456\u043c\u0456\u201d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 2, 21; \u041c\u0446 21, 43; \u0406\u0441 5, 7b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410 \u042f \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u0446\u044f\u0431\u0435 \u044f\u043a \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u044f\u043a \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435. \u042f\u043a \u0436\u0430 \u0422\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u045e \u0447\u0443\u0436\u0443\u044e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0443\u044e \u043b\u0430\u0437\u0443?<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0422\u0430\u043c\u0443 \u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u0430\u0434\u044b \u044f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u0447\u0430\u043a\u0430\u045e \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f \u2013 \u0456 \u0432\u043e\u0441\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435; \u0447\u0430\u043a\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u2013 \u0456 \u0432\u043e\u0441\u044c \u043a\u0440\u044b\u043a.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"215","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">3, 1-5. 19 \u2013 4, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u043a\u043b\u0456\u043a \u0434\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041a\u0430\u043b\u0456 \u043c\u0443\u0436 \u0430\u0434\u0430\u0448\u043b\u0435 \u0441\u0432\u0430\u044e \u0436\u043e\u043d\u043a\u0443, \u0456 \u044f\u043d\u0430 \u0430\u0434\u044b\u0434\u0437\u0435 \u0430\u0434 \u044f\u0433\u043e \u0456 \u0441\u0442\u0430\u043d\u0435 \u0436\u043e\u043d\u043a\u0430\u0439 \u0456\u043d\u0448\u0430\u0433\u0430, \u0446\u0456 \u043c\u043e\u0436\u0430 \u0451\u043d \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u044f\u0435? \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0430 \u0446\u0430\u043b\u043a\u0430\u043c? \u0410 \u0442\u044b, \u0448\u0442\u043e \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u044b\u043b\u0430 \u0437 \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u043a\u0430\u0445\u0430\u043d\u043a\u0430\u043c\u0456, \u0445\u043e\u0447\u0430\u0448 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u044b\u043c\u0456 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043d\u0430 \u045e\u0437\u0433\u043e\u0440\u043a\u0456 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456. \u0414\u0437\u0435 \u0442\u044b \u043d\u0435 \u0431\u044b\u043b\u0430 \u0437\u0433\u0432\u0430\u043b\u0442\u0430\u0432\u0430\u043d\u0430\u044f? \u0422\u044b \u0441\u044f\u0434\u0430\u043b\u0430 \u0434\u0437\u0435\u043b\u044f \u0456\u0445 \u043b\u044f \u0434\u0430\u0440\u043e\u0433, \u044f\u043a \u0410\u0440\u0430\u0431 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0456 \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u043b\u0430 \u0437\u044f\u043c\u043b\u044e \u0441\u0432\u0430\u0456\u043c \u0447\u0443\u0436\u0430\u043b\u043e\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u0430\u0456\u043c \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043f\u044b\u043d\u0456\u043b\u0456\u0441\u044f \u043b\u0456\u045e\u043d\u0456 \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u0435\u0441\u043d\u0430\u0432\u043e\u0433\u0430 \u0434\u0430\u0436\u0434\u0436\u0443, \u0430\u043b\u0435 \u0442\u044b \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0430 \u0441\u043e\u0440\u0430\u043c\u0443, \u0445\u043e\u0446\u044c \u043c\u0435\u043b\u0430 \u0442\u044b \u0447\u0430\u043b\u043e \u0436\u0430\u043d\u0447\u044b\u043d\u044b-\u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u044b. \u0427\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0442\u044b \u043a\u043b\u0456\u0447\u0430\u0448 \u041c\u044f\u043d\u0435: \u201c\u041e\u0439\u0447\u0430 \u041c\u043e\u0439, \u0422\u044b \u0441\u044f\u0431\u0440\u0430 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439! \u0426\u0456 \u043c\u043e\u0436\u0430\u0448 \u0433\u043d\u0435\u0432\u0430\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u0430 \u0430\u0431\u043e \u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u0443 \u0437\u0430\u045e\u0441\u0451\u0434\u044b?\u201d \u0422\u0430\u043a \u043a\u0430\u0437\u0430\u043b\u0430 \u0442\u044b \u0456 \u0440\u0430\u0431\u0456\u043b\u0430 \u0437\u043b\u043e \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u0433\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u041e, \u044f\u043a \u0436\u0430 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0437\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u0436\u0430\u0434\u0430\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u043d\u0430\u0439\u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0435\u0439\u0448\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e! \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u042f: \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u201c\u041c\u043e\u0439 \u041e\u0439\u0447\u0430\u201d \u0456 \u043d\u0435 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0430\u0434 \u041c\u044f\u043d\u0435. \u0410\u043b\u0435 \u044f\u043a \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0437\u0434\u0440\u0430\u0434\u0436\u0432\u0430\u0435 \u0441\u0432\u0430\u0439\u043c\u0443 \u043a\u0430\u0445\u0430\u043d\u0430\u043c\u0443, \u0442\u0430\u043a \u0432\u044b \u0437\u0434\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u041c\u043d\u0435, \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u043b\u0430\u0441 \u0447\u0443\u0435\u0446\u0446\u0430 \u043d\u0430 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u0445, \u043f\u043b\u0430\u0447 \u0456 \u043c\u0430\u043b\u0435\u043d\u043d\u0435 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0431\u043e \u044f\u043d\u044b \u0441\u043a\u0440\u044b\u0432\u0456\u043b\u0456 \u0441\u0432\u0430\u0435 \u0448\u043b\u044f\u0445\u0456, \u0437\u0430\u0431\u044b\u043b\u0456 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u00ab\u0412\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f, \u0441\u044b\u043d\u044b-\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0456, \u042f \u0432\u044b\u043b\u0435\u0447\u0443 \u0432\u0430\u0448\u044b\u044f \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u043e\u0441\u044c \u043c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0426\u044f\u0431\u0435, \u0431\u043e \u0422\u044b \u2013 \u041f\u0430\u043d, \u043d\u0430\u0448 \u0411\u043e\u0433. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0434\u043b\u044f \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u0443\u0437\u0433\u043e\u0440\u043a\u0456 \u0456 \u0448\u0443\u043c \u043d\u0430 \u0433\u0430\u0440\u0430\u0445. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u2013 \u0443 \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u044b\u043c. \u0417 \u043d\u0430\u0448\u0430\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0433\u0430\u043d\u044c\u0431\u0430 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u043f\u0440\u0430\u0446\u0443 \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0436\u044b\u0432\u0451\u043b\u0443, \u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0447\u043e\u043a. \u041b\u044f\u0436\u0430\u043c \u0443 \u043d\u0430\u0448\u0430\u0439 \u0433\u0430\u043d\u044c\u0431\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0430\u043a\u0440\u044b\u0435 \u043d\u0430\u0441 \u0441\u043e\u0440\u0430\u043c, \u0431\u043e \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043c\u044b \u0456 \u043d\u0430\u0448\u044b\u044f \u0430\u0439\u0446\u044b, \u0437 \u043d\u0430\u0448\u0430\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0430\u0436 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0456 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u043c\u044b \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0456\u043d\u0435\u0448 \u0441\u0432\u0430\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0430\u0434 \u041c\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043b\u0443\u043a\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0446\u044c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: \u201e\u042f\u043a \u0436\u044b\u0432\u044b \u041f\u0430\u043d\u201d, \u0442\u0430\u0434\u044b \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0437\u0430\u0435\u043c\u043d\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0406\u043c \u0456 \u045e \u0406\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u042e\u0434\u044b \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430: \u0423\u0437\u0430\u0440\u044b\u0446\u0435 \u0441\u0430\u0431\u0435 \u043f\u0430\u043f\u0430\u0440 \u0456 \u043d\u0435 \u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u045e \u0446\u0435\u0440\u043d\u0456. \u0417\u0440\u0430\u0431\u0456\u0446\u0435 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043d\u0430, \u0430\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u043a\u0440\u0430\u0439\u043d\u044e\u044e \u043f\u043b\u043e\u0446\u044c \u0437 \u0441\u044d\u0440\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u043c\u0443\u0436\u044b \u042e\u0434\u044b \u0456 \u0436\u044b\u0445\u0430\u0440\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043a\u0430\u0431 \u043d\u0435 \u045e\u0437\u043d\u044f\u045e\u0441\u044f \u044f\u043a \u0430\u0433\u043e\u043d\u044c \u041c\u043e\u0439 \u0433\u043d\u0435\u045e \u0437-\u0437\u0430 \u0432\u0430\u0448\u044b\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0456 \u043d\u0435 \u043f\u0430\u043b\u0430\u045e, \u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043c\u043e\u0433 \u0431\u044b \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u044f\u0433\u043e\u00bb.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 14, 7; \u041f\u0441 130 (129), 3<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0439 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u0432\u0430\u0451 \u0456\u043c\u044f,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0431\u043e \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0422\u044b, \u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456, \u0445\u0442\u043e \u0436 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435, \u041f\u0430\u043d\u0435?<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0456\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"216","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">4, 5-8. 13-28&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0456\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u045e \u042e\u0434\u0437\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u043a\u0430\u0436\u044b\u0446\u0435 \u0456 \u0442\u0440\u0443\u0431\u0456\u0446\u0435 \u045e \u0440\u043e\u0433 \u0443 \u043a\u0440\u0430\u0456, \u043a\u043b\u0456\u0447\u0446\u0435 \u0456 \u043a\u0430\u0436\u044b\u0446\u0435: \u201e\u0417\u0431\u0456\u0440\u0430\u0439\u0446\u0435\u0441\u044f, \u0443\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0432\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b!\u201d. \u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0448\u0442\u0430\u043d\u0434\u0430\u0440 \u0443 \u0431\u043e\u043a \u0421\u0456\u0451\u043d\u0430. \u0423\u0446\u044f\u043a\u0430\u0439\u0446\u0435, \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0439\u0446\u0435\u0441\u044f, \u0431\u043e \u042f \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435. \u041b\u0435\u045e \u0432\u044b\u0439\u0448\u0430\u045e \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0443\u0448\u0447\u0430\u0440\u0443, \u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0456\u043a \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0412\u044b\u0439\u0448\u0430\u045e \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0442\u0432\u0430\u044e \u0437\u044f\u043c\u043b\u044e \u045e \u043f\u0443\u0441\u0442\u044d\u0447\u0443. \u0413\u0430\u0440\u0430\u0434\u044b \u0442\u0432\u0430\u0435 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0440\u0443\u0456\u043d\u0430\u043c\u0456 \u0431\u0435\u0437 \u0436\u044b\u0445\u0430\u0440\u043e\u045e. \u0422\u0430\u043c\u0443 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0430\u0439, \u043b\u044f\u043c\u0430\u043d\u0442\u0443\u0439\u0446\u0435 \u0456 \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u0435, \u0431\u043e \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c, \u044f\u043a \u0430\u0431\u043b\u043e\u043a\u0456, \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0432\u043e\u0440\u0430\u0433, \u0456 \u044f\u043a \u0432\u0456\u0445\u0443\u0440\u0430 \u044f\u0433\u043e \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b, \u0448\u043f\u0430\u0440\u0447\u044d\u0439\u0448\u044b\u044f \u0437\u0430 \u0430\u0440\u043b\u043e\u045e \u044f\u0433\u043e\u043d\u044b\u044f \u043a\u043e\u043d\u0456. \u0413\u043e\u0440\u0430 \u043d\u0430\u043c, \u0431\u043e \u043c\u044b \u043f\u0440\u0430\u043f\u0430\u043b\u0456! \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0430\u0431\u043c\u044b\u0439 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u043a\u0430\u0431 \u0437\u043c\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u0446\u0430. \u0414\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0437\u0435\u0448 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u043c\u0430\u0440\u043d\u044b\u0445 \u0437\u0430\u0434\u0443\u043c\u0430\u045e? \u0411\u043e \u0447\u0443\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441 \u0437 \u0414\u0430\u043d \u0456 \u0437 \u0433\u0430\u0440\u044b \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u0435 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0443: \u00ab\u0417 \u0434\u0430\u043b\u0451\u043a\u0430\u0439 \u043a\u0440\u0430\u0456\u043d\u044b \u043f\u0440\u044b\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u0456 \u043f\u0430\u0434\u044b\u043c\u0430\u044e\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u042e\u0434\u044b. \u042f\u043a \u0430\u0445\u043e\u045e\u043d\u0456\u043a\u0456 \u043f\u0430\u043b\u0451\u045e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043a\u043e\u043b \u044f\u0435, \u0431\u043e \u044f\u043d\u0430 \u045e\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u0422\u0432\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0446\u044f\u0431\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430. \u0417\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0451 \u0442\u0430\u043a\u043e\u0435 \u0433\u043e\u0440\u043a\u0430\u0435, \u0448\u0442\u043e \u0437\u0440\u0430\u043d\u0456\u043b\u0430 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u043c\u0430\u0451 \u043d\u0443\u0442\u0440\u043e, \u043c\u0430\u0451 \u043d\u0443\u0442\u0440\u043e! \u042f \u043a\u043e\u0440\u0447\u0443\u0441\u044f \u0430\u0434 \u0431\u043e\u043b\u044e! \u041e \u0441\u0446\u0435\u043d\u043a\u0456 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430! \u041c\u043e\u0446\u043d\u0430 \u0431\u2019\u0435\u0446\u0446\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430! \u042f \u043d\u0435 \u043c\u0430\u0433\u0443 \u043c\u0430\u045e\u0447\u0430\u0446\u044c, \u0431\u043e \u0447\u0443\u0435 \u043c\u0430\u044f \u0434\u0443\u0448\u0430 \u0433\u0443\u043a \u0440\u043e\u0433\u0443, \u0431\u0430\u044f\u0432\u044b\u044f \u0432\u043e\u043a\u043b\u0456\u0447\u044b. \u041f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435\u043c, \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f. \u0417\u043d\u044f\u043d\u0430\u0446\u043a\u0443 \u0431\u044b\u043b\u0456 \u0437\u0431\u0443\u0440\u0430\u043d\u044b \u043c\u0430\u0435 \u043d\u0430\u043c\u0451\u0442\u044b, \u0437\u0430 \u0430\u0434\u043d\u0443 \u0445\u0432\u043b\u0456\u043d\u0443 \u2013 \u043c\u0430\u0451 \u0436\u044b\u043b\u043b\u0451. \u0414\u0430\u043a\u0443\u043b\u044c \u044f \u0431\u0443\u0434\u0443 \u0431\u0430\u0447\u044b\u0446\u044c \u0448\u0442\u0430\u043d\u0434\u0430\u0440, \u0447\u0443\u0446\u044c \u0433\u0443\u043a \u0440\u043e\u0433\u0443? \u00ab\u041c\u043e\u0439 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u043d\u0430\u0440\u043e\u0434, \u044f\u043d\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435. \u0413\u044d\u0442\u0430 \u0431\u0435\u0437\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u044b\u044f \u0456 \u043d\u044f\u043a\u0435\u043c\u043b\u0456\u0432\u044b\u044f \u0441\u044b\u043d\u044b. \u042f\u043d\u044b \u043c\u0443\u0434\u0440\u044b\u044f, \u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u0430\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u043e\u0431\u0440\u0430 \u043d\u0435 \u045e\u043c\u0435\u044e\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u2013 \u0456 \u0432\u043e\u0441\u044c \u0431\u044f\u0437\u043b\u0430\u0434\u0434\u0437\u0435 \u0456 \u043f\u0443\u0441\u0442\u044d\u0447\u0430, \u0456 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u044b \u2013 \u0434\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u0456\u0445 \u0441\u0432\u044f\u0442\u043b\u0430. \u0417\u0456\u0440\u043d\u0443\u045e \u043d\u0430 \u0433\u043e\u0440\u044b \u2013 \u0430 \u044f\u043d\u044b \u0434\u0440\u044b\u0436\u0430\u0446\u044c, \u0456 \u045e\u0441\u0435 \u045e\u0437\u0433\u043e\u0440\u043a\u0456 \u0445\u0456\u0441\u0442\u0430\u044e\u0446\u0446\u0430. \u042f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u2013 \u0456 \u0432\u043e\u0441\u044c \u043d\u044f\u043c\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u045e\u0441\u0435 \u043f\u0442\u0443\u0448\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u043f\u0430\u045e\u0446\u044f\u043a\u0430\u043b\u0456. \u042f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u2013 \u0456 \u0432\u043e\u0441\u044c \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0441\u0442\u0430\u043b\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044f\u0439. \u0411\u044b\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u045e\u0441\u0435 \u044f\u0435 \u0433\u0430\u0440\u0430\u0434\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u043f\u0430\u043b\u0430\u044e\u0447\u044b\u043c \u0433\u043d\u0435\u0432\u0430\u043c. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0423\u0441\u044f \u0433\u044d\u0442\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430, \u0430\u043b\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u044f\u0435 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0443. \u0422\u0430\u043c\u0443 \u0437\u0430\u043f\u043b\u0430\u0447\u0430 \u0437\u044f\u043c\u043b\u044f, \u0456 \u045e\u0433\u0430\u0440\u044b \u043f\u0430\u0446\u044f\u043c\u043d\u0435\u044e\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b, \u0431\u043e \u042f \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u044e \u0434\u044b \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u043b\u044e\u0441\u044f \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0415\u0440 4, 24. 26. 27; \u041f\u0441 85 (84), 5<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0436\u0430, \u0430\u0434 \u0433\u043d\u0435\u0432\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f, \u0430\u043b\u0435 \u0422\u044b, \u041f\u0430\u043d\u0435, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0439 \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434\u043d\u0430\u0432\u0456 \u043d\u0430\u0441, \u0411\u043e\u0436\u0430, \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u0456 \u0441\u043f\u044b\u043d\u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u0441\u0432\u0430\u0451 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"217","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">7, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0434\u0430 \u0415\u0440\u0430\u043c\u0456\u0456: \u00ab\u0421\u0442\u0430\u043d\u044c \u0443 \u0431\u0440\u0430\u043c\u0435 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439 \u0442\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u0443\u0441\u0435 \u044e\u0434\u044d\u0456, \u044f\u043a\u0456\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u044f \u0431\u0440\u0430\u043c\u044b, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041f\u0430\u043f\u0440\u0430\u045e\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0456 \u045e\u0447\u044b\u043d\u043a\u0456, \u0456 \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0432\u0430\u043c \u0436\u044b\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u041d\u0435 \u0432\u0435\u0440\u0446\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u0421\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430, \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430, \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430\u201d. \u0411\u043e \u043a\u0430\u043b\u0456 \u0432\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u043f\u0440\u0430\u0432\u0456\u0446\u0435 \u0448\u043b\u044f\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0456 \u045e\u0447\u044b\u043d\u043a\u0456; \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430; \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e, \u0441\u0456\u0440\u043e\u0442 \u0456 \u045e\u0434\u043e\u0432\u0430\u045e; \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0446\u044c \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0456 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u0447\u0443\u0436\u044b\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456 \u0441\u0430\u0431\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0442\u0430\u0434\u044b \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0432\u0430\u043c \u0436\u044b\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u2013 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u0434\u0430\u045e \u0430\u0439\u0446\u0430\u043c \u0432\u0430\u0448\u044b\u043c \u0430\u0434\u0432\u0435\u043a\u0443 \u0456 \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0432\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0435\u0441\u044f \u043d\u0430 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0432\u0430\u043c \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443\u0446\u044c. \u041b\u044e\u0431\u0456\u0446\u0435 \u043a\u0440\u0430\u0441\u0446\u0456, \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c, \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u044b\u0446\u044c, \u043a\u043b\u044f\u0441\u0446\u0456\u0441\u044f \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430, \u043a\u0430\u0434\u0437\u0456\u0446\u044c \u0411\u0430\u0430\u043b\u044e, \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u0447\u0443\u0436\u044b\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0432\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0430 \u043f\u043e\u0442\u044b\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u0439 \u0443 \u0433\u044d\u0442\u044b\u043c \u0434\u043e\u043c\u0435, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u041c\u0430\u0451 \u0456\u043c\u044f, \u0456 \u043a\u0430\u0437\u0430\u0446\u044c: \u201c\u041c\u044b \u045e \u0431\u044f\u0441\u043f\u0435\u0446\u044b\u201d, \u043a\u0430\u0431 \u0434\u0430\u043b\u0435\u0439 \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u044e \u0433\u044d\u0442\u0443\u044e \u0430\u0433\u0456\u0434\u0443. \u0426\u0456 \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u044f\u043a\u0456 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u041c\u0430\u0456\u043c \u0456\u043c\u0435\u043d\u0435\u043c, \u0441\u0442\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445 \u043f\u044f\u0447\u043e\u0440\u0430\u044e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e? \u042f \u0433\u044d\u0442\u0430 \u0431\u0430\u0447\u0443, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0434\u0437\u0456\u0446\u0435 \u0436 \u0443 \u041c\u0430\u0451 \u043c\u0435\u0441\u0446\u0430, \u0448\u0442\u043e \u045e \u0428\u044b\u043b\u0451, \u0434\u0437\u0435 \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u041c\u0430\u0439\u0433\u043e \u0456\u043c\u044f, \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u0456\u043c \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u041c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0410 \u0446\u044f\u043f\u0435\u0440, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0445\u043e\u0446\u044c \u042f \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u0432\u0430\u0441, \u0430\u0434\u043d\u0430\u043a \u0432\u044b \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456, \u0456 \u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441, \u0430\u0434\u043d\u0430\u043a \u0432\u044b \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456, \u042f \u045e\u0447\u044b\u043d\u044e \u0437 \u0434\u043e\u043c\u0430\u043c, \u044f\u043a\u0456 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u041c\u0430\u0456\u043c \u0456\u043c\u0435\u043d\u0435\u043c \u0456 \u043d\u0430 \u044f\u043a\u0456 \u0432\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0435\u0441\u044f, \u0456 \u0437 \u043c\u0435\u0441\u0446\u0430\u043c, \u044f\u043a\u043e\u0435 \u0434\u0430\u045e \u042f \u0434\u043b\u044f \u0432\u0430\u0441 \u0456 \u0434\u043b\u044f \u0432\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u0428\u0456\u043b\u0451. \u042f \u0430\u0434\u043a\u0456\u043d\u0443 \u0432\u0430\u0441 \u0430\u0434 \u0441\u044f\u0431\u0435, \u044f\u043a \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u0443\u0441\u0456\u0445 \u0432\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0443\u0441\u0451 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u042d\u0444\u0440\u0430\u0456\u043c\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0442\u044b \u043d\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0441\u044f \u0437\u0430 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434, \u043d\u0435 \u045e\u0437\u043d\u043e\u0441\u044c \u0437\u0430 \u044f\u0433\u043e \u0432\u043e\u043a\u043b\u0456\u0447\u044b \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043d\u0435 \u045e\u043f\u0440\u043e\u0448\u0432\u0430\u0439 \u041c\u044f\u043d\u0435, \u0431\u043e \u042f \u043d\u0435 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u044e \u0446\u044f\u0431\u0435! \u0426\u0456 \u0442\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u044f\u043d\u044b \u0440\u043e\u0431\u044f\u0446\u044c \u0443 \u0433\u0430\u0440\u0430\u0434\u0430\u0445 \u042e\u0434\u044b \u0456 \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u0430\u0445 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430? \u0421\u044b\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0434\u0440\u043e\u0432\u044b, \u0430\u0439\u0446\u044b \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u044e\u0446\u044c \u0430\u0433\u043e\u043d\u044c, \u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u043c\u0435\u0441\u044f\u0446\u044c \u0446\u0435\u0441\u0442\u0430, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u044f \u0445\u043b\u044f\u0431\u044b \u0434\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u044b \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0456 \u043a\u0430\u0431 \u0432\u044b\u043b\u0456\u0432\u0430\u0446\u044c \u0432\u0430\u0434\u043a\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0434\u043b\u044f \u0447\u0443\u0436\u044b\u0445 \u0431\u0430\u0433\u043e\u045e \u0456 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0446\u044c \u041c\u044f\u043d\u0435. \u0426\u0456 \u044f\u043d\u044b \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u044f\u0431\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0441\u043e\u0440\u0430\u043c\u0443? \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0412\u043e\u0441\u044c \u0433\u043d\u0435\u045e \u041c\u043e\u0439 \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u041c\u0430\u0451 \u043f\u0440\u0430\u043b\u044c\u044e\u0446\u0446\u0430 \u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043d\u0430 \u0436\u044b\u0432\u0451\u043b\u0443, \u043d\u0430 \u043f\u0430\u043b\u044f\u0432\u044b\u044f \u0434\u0440\u044d\u0432\u044b \u0456 \u043d\u0430 \u043f\u043b\u0430\u0434\u044b \u0437\u044f\u043c\u043b\u0456; \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043b\u0430\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u0433\u0430\u0441\u043d\u0435\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 7, 11; \u0406\u0441 56, 7\u0441; \u042f\u043d 2, 16b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0426\u0456 \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u044f\u043a\u0456\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u041c\u0430\u0456\u043c \u0456\u043c\u0435\u043d\u0435\u043c, \u0441\u0442\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445 \u043f\u044f\u0447\u043e\u0440\u0430\u044e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e? <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0414\u043e\u043c \u041c\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0434\u043e\u043c\u0430\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0434\u043e\u043c \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0430\u043c \u0433\u0430\u043d\u0434\u043b\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0414\u043e\u043c \u041c\u043e\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"221","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 11, 18-20; 12, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u043b\u0430\u0447 \u0434\u0443\u0448\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043c\u043d\u0435, \u0456 \u044f \u0432\u0435\u0434\u0430\u044e. \u0422\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0434\u044b \u043c\u043d\u0435 \u0456\u0445\u043d\u0456\u044f \u045e\u0447\u044b\u043d\u043a\u0456. \u0410\u043b\u0435 \u044f \u0431\u044b\u045e, \u044f\u043a \u043f\u0440\u044b\u0440\u0443\u0447\u0430\u043d\u0430\u0435 \u044f\u0433\u043d\u044f, \u044f\u043a\u043e\u0435 \u0432\u044f\u0434\u0443\u0446\u044c \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u0456 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0430\u0434\u0443\u043c\u0430\u043b\u0456 \u0437\u043c\u043e\u0432\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435: \u00ab\u0417\u043d\u0456\u0448\u0447\u044b\u043c \u0434\u0440\u044d\u0432\u0430 \u045e \u043f\u043e\u045e\u043d\u0430\u0439 \u0441\u0456\u043b\u0435, \u0432\u044b\u0440\u0432\u0435\u043c \u044f\u0433\u043e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0436\u044b\u0432\u044b\u0445, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u0456\u043c\u044f \u044f\u0433\u043e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0422\u044b, \u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u044f\u043a\u0456 \u0441\u0443\u0434\u0437\u0456\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u044f\u043a\u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0448 \u043d\u044b\u0440\u043a\u0456 \u0456 \u0441\u044d\u0440\u0446\u0430, \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u043c\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u044e \u043f\u043e\u043c\u0441\u0442\u0443 \u043d\u0430\u0434 \u0456\u043c\u0456, \u0431\u043e \u0422\u0430\u0431\u0435 \u044f \u0434\u0430\u0432\u0435\u0440\u044b\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b, \u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u043a\u0430\u043b\u0456 \u044f \u0431\u0443\u0434\u0443 \u0441\u043f\u0440\u0430\u0447\u0430\u0446\u0446\u0430 \u0437 \u0422\u0430\u0431\u043e\u044e. \u0410\u0434\u043d\u0430\u043a \u0431\u0443\u0434\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0422\u0430\u0431\u0435 \u0430\u0431 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0456. \u0427\u0430\u043c\u0443 \u0434\u0430\u0440\u043e\u0433\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u043c\u0430\u0435 \u043f\u043e\u0441\u043f\u0435\u0445, \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0432\u0435\u0440\u0430\u043b\u043e\u043c\u043d\u0430, \u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c? \u0422\u044b \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u0456\u0445,&nbsp; \u044f\u043d\u044b \u043d\u0430\u0432\u0430\u0442 \u043f\u0443\u0441\u0446\u0456\u043b\u0456 \u043a\u0430\u0440\u0430\u043d\u0456, \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u043f\u043b\u0430\u0434\u044b. \u0422\u044b \u0431\u043b\u0456\u0437\u043a\u0456 \u0434\u0430 \u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e, \u0430\u043b\u0435 \u0434\u0430\u043b\u0451\u043a\u0456 \u0430\u0434 \u0456\u0445 \u043d\u044b\u0440\u0430\u043a. \u0410 \u043c\u044f\u043d\u0435 \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u041f\u0430\u043d\u0435, \u0431\u0430\u0447\u044b\u0448 \u043c\u044f\u043d\u0435 \u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0448 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u2013 \u044f\u043d\u043e \u0437 \u0422\u0430\u0431\u043e\u044e. \u0410\u0434\u0434\u0437\u044f\u043b\u0456 \u0456\u0445 \u044f\u043a \u0430\u0432\u0435\u0447\u0430\u043a \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u043f\u0440\u044b\u0437\u043d\u0430\u0447 \u0456\u0445 \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u0431\u043e\u044e. \u0414\u0430\u043a\u0443\u043b\u044c \u0437\u044f\u043c\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u043b\u0430\u043a\u0430\u0446\u044c, \u0456 \u0442\u0440\u0430\u0432\u0430 \u0432\u044b\u0441\u044b\u0445\u0430\u0446\u044c \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043f\u043e\u043b\u0456? \u0410\u0434 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u044f\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u043d\u0456\u043a\u043b\u0456 \u0436\u044b\u0432\u0451\u043b\u0430 \u0456 \u043f\u0442\u0443\u0448\u043a\u0456, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043d\u044b: \u00ab\u0401\u043d \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u0448\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0422\u0430\u043a, \u043a\u0430\u043b\u0456 \u0442\u044b \u0431\u0435\u0433 \u0437 \u043f\u0435\u0448\u044b\u043c\u0456 \u0456 \u044f\u043d\u044b \u0441\u0442\u0430\u043c\u0456\u043b\u0456 \u0446\u044f\u0431\u0435, \u0442\u043e \u044f\u043a \u0431\u0443\u0434\u0437\u0435\u0448 \u0446\u044f\u0433\u0430\u0446\u0446\u0430 \u0437 \u043a\u043e\u043d\u044c\u043c\u0456? \u0406 \u043a\u0430\u043b\u0456 \u045e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0439 \u043a\u0440\u0430\u0456\u043d\u0435 \u0442\u044b \u043d\u0430\u0441\u0446\u044f\u0440\u043e\u0436\u0430\u043d\u044b, \u0442\u043e \u0448\u0442\u043e \u0437\u0440\u043e\u0431\u0456\u0448 \u0443 \u0445\u043c\u044b\u0437\u043d\u044f\u043a\u0443 \u042f\u0440\u0434\u0430\u043d\u0430? \u0411\u043e \u043d\u0430\u0432\u0430\u0442 \u0442\u0432\u0430\u0435 \u0431\u0440\u0430\u0442\u044b \u0456 \u0434\u043e\u043c \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0434\u0440\u0430\u0434\u0436\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u0431\u0435. \u041d\u0430\u0432\u0430\u0442 \u044f\u043d\u044b \u043c\u043e\u0446\u043d\u0430 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u045e\u0441\u043b\u0435\u0434. \u041d\u0435 \u0432\u0435\u0440 \u0456\u043c, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u0439 \u043f\u0440\u044b\u044f\u0437\u043d\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u042f \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c, \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0443\u044e \u0440\u044d\u0447 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u042f \u0432\u044b\u0434\u0430\u045e \u0443 \u0440\u0443\u043a\u0456 \u044f\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u045e. \u041c\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u044f\u043a \u043b\u0435\u045e \u0443 \u0433\u0443\u0448\u0447\u0430\u0440\u044b. \u042f\u043d\u0430 \u045e\u0437\u043d\u044f\u043b\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0442\u0430\u043c\u0443 \u042f \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u044f\u0435. \u041c\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0441\u0442\u0440\u0430\u043a\u0430\u0442\u0430\u0439 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u0430\u0439 \u043f\u0442\u0443\u0448\u043a\u0430\u0439, \u0430\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u044f\u0435 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u044f \u043f\u0442\u0443\u0448\u043a\u0456. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435, \u0437\u0431\u0456\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u045e\u0441\u0435 \u0437\u0432\u044f\u0440\u044b \u043f\u0430\u043b\u044f\u0432\u044b\u044f, \u043f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u043a\u0430\u0431 \u043f\u0430\u0436\u044b\u0432\u0456\u0446\u0446\u0430. \u0428\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0456 \u041c\u043e\u0439 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u0441\u0442\u0430\u043f\u0442\u0430\u043b\u0456 \u043c\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u043b. \u041f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0456 \u041c\u043e\u0439 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u043d\u0430\u0434\u0437\u0435\u043b \u0443 \u0433\u043e\u043b\u0443\u044e \u043f\u0443\u0441\u0442\u044b\u043d\u044e. \u0417\u0440\u0430\u0431\u0456\u043b\u0456 \u044f\u0433\u043e \u043f\u0443\u0441\u0442\u044d\u0447\u0430\u0439. \u0423\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435 \u043b\u044f\u043c\u0430\u043d\u0442 \u043f\u0443\u0441\u0442\u044d\u0447\u0430. \u0421\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b \u045e\u0432\u0435\u0441\u044c \u0433\u044d\u0442\u044b \u043a\u0440\u0430\u0439, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u044f\u0440\u044d \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430 \u0441\u044d\u0440\u0446\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430 \u045e\u0441\u0435 \u043f\u0443\u0441\u0442\u044b\u043d\u043d\u044b\u044f \u043f\u0430\u0433\u043e\u0440\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u0456, \u0431\u043e \u043c\u0435\u0447 \u041f\u0430\u043d\u0430 \u043f\u0430\u0436\u044b\u0440\u0430\u0435 \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u043c\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. \u041f\u0430\u0441\u0435\u044f\u043b\u0456 \u043f\u0448\u0430\u043d\u0456\u0446\u0443, \u0430 \u0441\u0430\u0431\u0440\u0430\u043b\u0456 \u0446\u0435\u0440\u043d\u0456. \u041d\u0430\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0431\u0435\u0437 \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0440\u0430\u0434\u0436\u0430\u044e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u043d\u0435\u0432\u0443 \u041f\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 12, 27-28; \u041f\u0441 42 (41), 6\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0426\u044f\u043f\u0435\u0440 \u0443\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u0430 \u0434\u0443\u0448\u0430 \u041c\u0430\u044f; \u0456 \u0448\u0442\u043e \u041c\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u0446\u044c? \u041e\u0439\u0447\u0430, \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u041c\u044f\u043d\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b. \u0410\u043b\u0435 \u0436 \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u042f \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041e\u0439\u0447\u0430, \u0443\u0441\u043b\u0430\u045e \u0456\u043c\u044f \u0441\u0432\u0430\u0451.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0427\u0430\u043c\u0443, \u0434\u0443\u0448\u0430 \u043c\u0430\u044f, \u0442\u044b \u0441\u0443\u043c\u0443\u0435\u0448, \u0447\u0430\u0433\u043e \u0442\u044b \u045e\u0432\u0430 \u043c\u043d\u0435 \u0441\u0442\u043e\u0433\u043d\u0435\u0448? <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041e\u0439\u0447\u0430, \u0443\u0441\u043b\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"222","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">19, 1-5. 10 \u2013 20, 6<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u0430\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435: \u0440\u0430\u0437\u0431\u0456\u0442\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0406\u0434\u0437\u0456 \u0456 \u043a\u0443\u043f\u0456 \u045e \u0433\u0430\u043d\u0447\u0430\u0440\u0430 \u0433\u043b\u0456\u043d\u044f\u043d\u044b \u0437\u0431\u0430\u043d. \u041f\u0430\u0441\u043b\u044f \u0432\u0430\u0437\u044c\u043c\u0456 \u0437 \u0441\u0430\u0431\u043e\u044e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u0432\u044b\u0439\u0434\u0437\u0456 \u045e \u0434\u0430\u043b\u0456\u043d\u0443 \u0411\u044d\u043d-\u0413\u0456\u043d\u043e\u043c, \u0448\u0442\u043e \u043b\u044f \u0431\u0440\u0430\u043c\u044b \u0425\u0430\u0440\u0441\u0456\u0442, \u0456 \u0442\u0430\u043c \u0430\u0431\u0432\u044f\u0441\u0446\u0456 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435. \u0421\u043a\u0430\u0436\u044b: \u201e\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u0456 \u042e\u0434\u044b \u0456 \u0436\u044b\u0445\u0430\u0440\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430! \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0412\u043e\u0441\u044c \u042f \u0441\u043f\u0430\u0448\u043b\u044e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u0456 \u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u0435 \u0433\u044d\u0442\u0430, \u0437\u0430\u0437\u0432\u0456\u043d\u0456\u0446\u044c \u0443 \u0432\u0443\u0448\u0430\u0445. \u0411\u043e \u044f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041c\u044f\u043d\u0435 \u0456 \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u043b\u0456 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0456 \u043d\u0430 \u0456\u043c \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0434\u043b\u044f \u0447\u0443\u0436\u044b\u0445 \u0431\u0430\u0433\u043e\u045e, \u044f\u043a\u0456\u0445 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u043d\u0456 \u044f\u043d\u044b, \u043d\u0456 \u0430\u0439\u0446\u044b \u0456\u0445\u043d\u0456\u044f, \u043d\u0456 \u043a\u0430\u0440\u0430\u043b\u0456 \u042e\u0434\u044b. \u042f\u043d\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u043a\u0440\u044b\u0432\u0451\u044e \u043d\u044f\u0432\u0456\u043d\u043d\u044b\u0445. \u041f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u045e\u0437\u0432\u044b\u0448\u0448\u044b \u0411\u0430\u0430\u043b\u044e, \u043a\u0430\u0431 \u0443 \u0430\u0433\u043d\u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u0411\u0430\u0430\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0447\u0430\u0433\u043e \u042f \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u045e, \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u045e, \u0456 \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u041c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u041f\u0430\u0441\u043b\u044f \u0440\u0430\u0437\u0431\u0456 \u0433\u044d\u0442\u044b \u0437\u0431\u0430\u043d \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e. \u0421\u043a\u0430\u0436\u044b \u0456\u043c: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0413\u044d\u0442\u0430\u043a \u042f \u0440\u0430\u0437\u0430\u0431\u2019\u044e \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0456 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u044f\u043a \u0440\u0430\u0437\u0431\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u0430\u043d\u0447\u0430\u0440\u043d\u044b \u043f\u043e\u0441\u0443\u0434, \u044f\u043a\u0456 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0437\u043d\u043e\u045e \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c, \u0430 \u045e \u0422\u0430\u0444\u044d\u0446\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0431\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f. \u0422\u0430\u043a \u042f \u043f\u0430\u0441\u0442\u0443\u043f\u043b\u044e \u0437 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u0430\u043c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0456 \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0422\u0430\u0444\u044d\u0442\u0430. \u0410 \u0434\u0430\u043c\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0434\u0430\u043c\u044b \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u042e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f, \u044f\u043a \u043c\u0435\u0441\u0446\u0430 \u0422\u0430\u0444\u044d\u0442, \u2013 \u0443\u0441\u0435 \u0434\u0430\u043c\u044b, \u043d\u0430 \u0434\u0430\u0445\u0430\u0445 \u044f\u043a\u0456\u0445 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0430\u0441\u044f \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0456 \u0432\u044b\u043b\u0456\u0432\u0430\u043b\u0456\u0441\u044f \u0432\u0430\u0434\u043a\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0434\u043b\u044f \u0447\u0443\u0436\u044b\u0445 \u0431\u0430\u0433\u043e\u045e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0410 \u043a\u0430\u043b\u0456 \u0415\u0440\u0430\u043c\u0456\u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u0422\u0430\u0444\u044d\u0442\u0430, \u043a\u0443\u0434\u044b \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c, \u0451\u043d \u0441\u0442\u0430\u045e \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0412\u043e\u0441\u044c \u042f \u0441\u043f\u0430\u0448\u043b\u044e \u043d\u0430 \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0456 \u043d\u0430 \u045e\u0441\u0435 \u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b \u045e\u0441\u0451 \u0442\u043e\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0434\u043b\u044f \u0456\u0445, \u0431\u043e \u044f\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u0441\u0432\u043e\u0439 \u043a\u0430\u0440\u0430\u043a, \u0456 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u041c\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0421\u0432\u044f\u0442\u0430\u0440 \u041f\u0430\u0448\u0445\u0443\u0440, \u0441\u044b\u043d \u0406\u043c\u044d\u0440\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u045e\u043d\u044b\u043c \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0430\u043c \u0443 \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430, \u043f\u0430\u0447\u0443\u045e \u0415\u0440\u0430\u043c\u0456\u044e, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b. \u0422\u0430\u043c\u0443 \u041f\u0430\u0448\u0445\u0443\u0440 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0437\u0431\u0456\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u044e \u0456 \u0437\u0430\u043a\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u045e \u043a\u0430\u043b\u043e\u0434\u043a\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0412\u0435\u0440\u0445\u043d\u044f\u0439 \u0431\u0440\u0430\u043c\u0435 \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0430 \u043b\u044f \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430. \u041d\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u041f\u0430\u0448\u0445\u0443\u0440 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0415\u0440\u0430\u043c\u0456\u044e \u0437 \u043a\u0430\u043b\u043e\u0434\u0430\u043a, \u0442\u043e\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u041f\u0430\u043d \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0456\u043c\u044f \u043d\u0435 \u041f\u0430\u0448\u0445\u0443\u0440, \u0430\u043b\u0435 \u041c\u0430\u0433\u043e\u0440 \u041c\u0456\u0441\u0430\u0431\u0456\u0431. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0412\u043e\u0441\u044c \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0436\u0430\u0445\u0430\u043c \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0456 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u0441\u044f\u0431\u0440\u043e\u045e. \u042f\u043d\u044b \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0434 \u043c\u044f\u0447\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u0430 \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u0430. \u0423\u0441\u044e \u042e\u0434\u0443 \u0432\u044b\u0434\u0430\u043c \u0443 \u0440\u0443\u043a\u0456 \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0456 \u0451\u043d \u043f\u0430\u0432\u044f\u0434\u0437\u0435 \u0456\u0445 \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u045e \u0411\u0430\u0431\u0456\u043b\u0451\u043d, \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0456\u0445 \u043c\u044f\u0447\u043e\u043c. \u042f \u0430\u0434\u0434\u0430\u043c \u0443\u0441\u0451 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430, \u0443\u0432\u0435\u0441\u044c \u044f\u0433\u043e \u0437\u0434\u0430\u0431\u044b\u0442\u0430\u043a, \u0443\u0441\u0435 \u044f\u0433\u043e \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0443 \u0440\u0443\u043a\u0456 \u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e. \u042f\u043d\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0456\u0445, \u0437\u0430\u0445\u043e\u043f\u044f\u0446\u044c \u0456 \u043f\u0430\u043d\u044f\u0441\u0443\u0446\u044c \u0456\u0445 \u0443 \u0411\u0430\u0431\u0456\u043b\u0451\u043d. \u0410 \u0442\u044b, \u041f\u0430\u0448\u0445\u0443\u0440, \u0456 \u045e\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443 \u043f\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u043f\u0430\u043b\u043e\u043d. \u0422\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0443 \u0411\u0430\u0431\u0456\u043b\u0451\u043d \u0456 \u0442\u0430\u043c \u043f\u0430\u043c\u0440\u044d\u0448, \u0456 \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u0442\u044b \u0456 \u045e\u0441\u0435 \u0442\u0432\u0430\u0435 \u0441\u044f\u0431\u0440\u044b, \u044f\u043a\u0456\u043c \u0442\u044b \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041c\u0446 23, 37; \u043f\u0430\u0440. \u0415\u0440 19, 15&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0442\u044b \u0437\u0430\u0431\u0456\u0432\u0430\u0435\u0448 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u043a\u0430\u043c\u044f\u043d\u0443\u0435\u0448 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u0445 \u0434\u0430 \u0446\u044f\u0431\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e \u042f \u0445\u0430\u0446\u0435\u045e \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0442\u0432\u0430\u0456\u0445, \u044f\u043a \u043f\u0442\u0443\u0448\u043a\u0430 \u0437\u0431\u0456\u0440\u0430\u0435 \u043f\u0430\u0434 \u043a\u0440\u044b\u043b\u0430\u043c\u0456 \u043f\u0442\u0443\u0448\u0430\u043d\u044f\u0442 \u0441\u0432\u0430\u0456\u0445, \u0430\u043b\u0435 \u0432\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u0441\u0432\u043e\u0439 \u043a\u0430\u0440\u0430\u043a \u0456 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u041c\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u043e\u043b\u044c\u043a\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"223","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">20, 7-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u0440\u044b\u0432\u043e\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u0432\u0430\u0431\u0456\u045e \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0456 \u044f \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0441\u044f\u0431\u0435 \u0437\u0432\u0430\u0431\u0456\u0446\u044c; \u0422\u044b \u043c\u043e\u0446\u043d\u0430 \u0441\u0445\u0430\u043f\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433. \u042f \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043c\u0435\u0448\u044b\u0448\u0447\u0430\u043c \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0456 \u045e\u0441\u0435 \u043a\u043f\u044f\u0446\u044c \u0437 \u043c\u044f\u043d\u0435. \u0411\u043e \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0447\u044b\u043d\u0430\u044e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u043a\u0440\u044b\u0447\u0443 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e: \u00ab\u0413\u0432\u0430\u043b\u0442 \u0456 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435!\u00bb \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u0445 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u045e \u0456 \u043d\u0430\u0441\u043c\u0435\u0448\u0430\u043a. \u0406 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0443 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u042f\u0433\u043e \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u042f\u0433\u043e\u043d\u0430\u0435 \u0456\u043c\u044f\u00bb. \u0410\u043b\u0435 \u045e \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0456\u0431\u044b \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0430\u0433\u043e\u043d\u044c, \u0448\u0442\u043e \u0431\u044b\u045e \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b \u045e \u043c\u0430\u0456\u0445 \u043a\u043e\u0441\u0442\u043a\u0430\u0445. \u042f \u0441\u0442\u0430\u043c\u0456\u045e\u0441\u044f \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u044f\u0433\u043e, \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043c\u0430\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0447\u0443\u045e \u043f\u0430\u0433\u0430\u043b\u043e\u0441\u043a\u0456 \u043c\u043d\u043e\u0433\u0456\u0445: \u00ab\u0416\u0430\u0445 \u043d\u0430\u0432\u043e\u043a\u0430\u043b! \u0412\u044b\u043a\u0440\u044b\u0439\u0446\u0435, \u0456 \u043c\u044b \u0432\u044b\u043a\u0440\u044b\u0435\u043c \u044f\u0433\u043e!\u00bb \u0423\u0441\u0435 \u0441\u044f\u0431\u0440\u044b \u043c\u0430\u0435 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f: \u00ab\u041c\u043e\u0436\u0430, \u0443\u0434\u0430\u0441\u0446\u0430, \u2013 \u044f\u043d\u044b \u043a\u0430\u0436\u0443\u0446\u044c, \u2013 \u0430\u0448\u0443\u043a\u0430\u0446\u044c \u044f\u0433\u043e, \u0442\u0430\u0434\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043c \u044f\u0433\u043e \u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u043c \u044f\u043c\u0443\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u041f\u0430\u043d \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f\u043a \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0432\u043e\u043b\u0430\u0442, \u0442\u0430\u043c\u0443 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0456 \u043c\u0430\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0443\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c. \u041c\u043e\u0446\u043d\u0430 \u0430\u0441\u0430\u0440\u043e\u043c\u044f\u0446\u0446\u0430, \u0431\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430. \u0411\u0443\u0434\u0437\u0435 \u0456\u043c \u0432\u0435\u0447\u043d\u0430\u044f \u0456 \u043d\u0435\u0437\u0430\u0431\u044b\u045e\u043d\u0430\u044f \u0433\u0430\u043d\u044c\u0431\u0430. \u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0422\u044b \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0411\u0430\u0447\u044b\u0448 \u043d\u044b\u0440\u043a\u0456 \u0456 \u0441\u044d\u0440\u0446\u0430. \u0414\u0430\u0439 \u043c\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u044e \u043f\u043e\u043c\u0441\u0442\u0443 \u043d\u0430\u0434 \u0456\u043c\u0456, \u0431\u043e \u044f \u0430\u0434\u043a\u0440\u044b\u045e \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u041f\u0430\u043d\u0430, \u0431\u043e \u041f\u0430\u043d \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0430\u0434 \u0440\u0443\u043a\u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u044f \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b. \u0414\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u043c\u0430\u044f \u043c\u0430\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c. \u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0432\u0435\u0441\u0442\u043a\u0443 \u043c\u0430\u0439\u043c\u0443 \u0430\u0439\u0446\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0423 \u0446\u044f\u0431\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0434\u0437\u0456\u0446\u044f \u2013 \u0445\u043b\u043e\u043f\u0435\u0446\u00bb, \u0447\u044b\u043c \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e \u044f\u0433\u043e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u044f\u043a \u0433\u0430\u0440\u0430\u0434\u044b, \u044f\u043a\u0456\u044f \u0431\u0435\u0437 \u0436\u0430\u043b\u044e \u0437\u0431\u0443\u0440\u044b\u045e \u041f\u0430\u043d. \u041d\u044f\u0445\u0430\u0439 \u0447\u0443\u0435 \u043a\u0440\u044b\u043a \u0437\u0440\u0430\u043d\u043a\u0443 \u0456 \u0431\u0430\u044f\u0432\u044b\u044f \u043a\u043b\u0456\u0447\u044b \u0430\u043f\u043e\u045e\u0434\u043d\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0435 \u0437\u0430\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456. \u0422\u0430\u0434\u044b \u045e\u043b\u043e\u043d\u043d\u0435 \u043c\u0430\u0451\u0439 \u043c\u0430\u0446\u0456 \u0441\u0442\u0430\u043b\u0430 \u0431 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043c\u0430\u0451\u0439 \u043c\u0430\u0433\u0456\u043b\u0430\u0439, \u0430 \u045e\u043b\u043e\u043d\u043d\u0435 \u2013 \u0446\u044f\u0436\u0430\u0440\u043d\u044b\u043c \u043d\u0430\u0432\u0435\u043a\u0456. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f? \u041a\u0430\u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0446\u044f\u0436\u0430\u0440 \u0456 \u043f\u0430\u043a\u0443\u0442\u044b \u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0435 \u0434\u043d\u0456 \u045e \u0441\u043e\u0440\u0430\u043c\u0435?<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0415\u0440 20, 10-11\u0430; \u041f\u0441 31 (30), 14<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u0435 \u0441\u044f\u0431\u0440\u044b \u043c\u0430\u0435 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f: \u041c\u043e\u0436\u0430, \u0443\u0434\u0430\u0441\u0446\u0430 \u0430\u0448\u0443\u043a\u0430\u0446\u044c \u044f\u0433\u043e, \u0442\u0430\u0434\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043c \u044f\u0433\u043e \u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u043c \u044f\u043c\u0443.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0410\u043b\u0435 \u041f\u0430\u043d \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f\u043a \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0432\u043e\u043b\u0430\u0442.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0427\u0443\u044e \u043f\u0430\u0433\u0430\u043b\u043e\u0441\u043a\u0456 \u043c\u043d\u043e\u0433\u0456\u0445: \u0416\u0430\u0445 \u043d\u0430\u0432\u043e\u043a\u0430\u043b. \u042f\u043d\u044b \u0437\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"224","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">26, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0415\u0440\u0430\u043c\u0456\u044f \u045e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0401\u0430\u043a\u0456\u043c\u0430, \u0441\u044b\u043d\u0430 \u0401\u0441\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u044f \u042e\u0434\u044d\u0456, \u0431\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0434\u0430 \u0415\u0440\u0430\u043c\u0456\u0456: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0421\u0442\u0430\u043d\u044c \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u0434\u043e\u043c\u0430 \u041f\u0430\u043d\u0430 \u0456 \u045e\u0441\u0456\u043c \u0433\u0430\u0440\u0430\u0434\u0430\u043c \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u043c, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u0434\u043e\u043c \u041f\u0430\u043d\u0430, \u0441\u043a\u0430\u0436\u044b \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u0442\u0430\u0431\u0435, \u0456 \u043d\u0435 \u0430\u0434\u044b\u043c\u0430\u0439 \u043d\u0456 \u0441\u043b\u043e\u0432\u0430. \u041c\u043e\u0436\u0430, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0456 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443, \u0456 \u042f \u0441\u0442\u0440\u044b\u043c\u0430\u044e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0456\u043c \u0437\u0430 \u0456\u0445 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043a\u0430\u0436\u044b \u0456\u043c: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u041a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0435 \u041c\u044f\u043d\u0435 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0439\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0443, \u044f\u043a\u0456 \u042f \u0434\u0430\u045e \u0432\u0430\u043c, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u041c\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u0445 \u042f \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u043c, \u0445\u043e\u0446\u044c \u0432\u044b \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0435, \u2013 \u0442\u0430\u0434\u044b \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0437 \u0433\u044d\u0442\u044b\u043c \u0434\u043e\u043c\u0430\u043c \u044f\u043a \u0437 \u0428\u044b\u043b\u0451, \u0430 \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0437\u0440\u0430\u0431\u043b\u044e \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0437\u044f\u043c\u043b\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u0430\u0440\u044b, \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0447\u0443\u043b\u0456, \u044f\u043a \u0415\u0440\u0430\u043c\u0456\u044f \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0415\u0440\u0430\u043c\u0456\u044f \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u044f\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0422\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u0435\u0440\u0446\u0456! \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e \u0442\u044b, \u043a\u0430\u0436\u0443\u0447\u044b \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430: \u201c\u042f\u043a \u0428\u044b\u043b\u0451 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u0430 \u0433\u043e\u0440\u0430\u0434 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0436\u044b\u0445\u0430\u0440\u043e\u045e\u201d?\u00bb \u0422\u0430\u0434\u044b \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u0430\u0431\u0440\u0430\u045e\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0430\u043c\u0456\u0456 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430. \u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u043b\u0456 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u044f \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043b\u0430\u0446\u0443 \u045e \u0434\u043e\u043c \u041f\u0430\u043d\u0430 \u0456 \u0441\u0435\u043b\u0456 \u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u041d\u043e\u0432\u0443\u044e \u0431\u0440\u0430\u043c\u0443 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430. \u0421\u0432\u044f\u0442\u0430\u0440\u044b \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0456 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0413\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0441\u0443\u0434\u0443, \u0431\u043e \u0451\u043d \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430, \u044f\u043a \u0432\u044b \u0447\u0443\u043b\u0456 \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u0443\u0448\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0415\u0440\u0430\u043c\u0456\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u0456\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0456 \u045e\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443: \u00ab\u041f\u0430\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043e\u043c\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u045e\u0441\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u0447\u0443\u043b\u0456. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u0435 \u0441\u0432\u0430\u0435 \u0448\u043b\u044f\u0445\u0456 \u0456 \u0441\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0434\u044b \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0433\u043e\u043b\u0430\u0441 \u0432\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u0456 \u0442\u0430\u0434\u044b \u041f\u0430\u043d \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u0456 \u043d\u0435 \u0441\u043f\u0430\u0448\u043b\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u0432\u0430\u043c \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e. \u0410 \u044f \u2013 \u0443 \u0432\u0430\u0448\u044b\u0445 \u0440\u0443\u043a\u0430\u0445. \u0420\u0430\u0431\u0456\u0446\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0443 \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445. \u0410\u0434\u043d\u0430\u043a \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0432\u044b \u0437\u0430\u0431\u2019\u0435\u0446\u0435 \u043c\u044f\u043d\u0435, \u0437\u0430\u043f\u043b\u044f\u043c\u0456\u0446\u0435 \u0441\u044f\u0431\u0435 \u0456 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u0431\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 26, 15\u0430; \u041c\u0446 27, 24b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0432\u044b \u0437\u0430\u0431\u2019\u0435\u0446\u0435 \u043c\u044f\u043d\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0437\u0430\u043f\u043b\u044f\u043c\u0456\u0446\u0435 \u0441\u044f\u0431\u0435 \u0456 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0456\u043b\u0430\u0442 \u0430\u0431\u043c\u044b\u045e \u0440\u0443\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0442\u043e\u045e\u043f\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u041d\u0435\u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b \u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u0432\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0430\u043f\u043b\u044f\u043c\u0456\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"225","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">29, 1-14<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041b\u0456\u0441\u0442 \u0415\u0440\u0430\u043c\u0456\u0456 \u0434\u0430 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u0445 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u044b \u043b\u0456\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0440\u043e\u043a \u0415\u0440\u0430\u043c\u0456\u044f \u0432\u044b\u0441\u043b\u0430\u045e \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0434\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456, \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u043f\u0430\u0432\u0451\u045e \u0443 \u043f\u0430\u043b\u043e\u043d \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u0411\u0430\u0431\u0456\u043b\u0451\u043d. \u0411\u044b\u043b\u043e \u0433\u044d\u0442\u0430 \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0439\u0441\u0446\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0415\u0445\u043e\u043d\u0456\u0456, \u043c\u0430\u0446\u0456 \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0440\u044b\u0434\u0432\u043e\u0440\u043d\u044b\u0445 \u0443\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u045e, \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u0456 \u0435\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430\u045e \u0456 \u043a\u0430\u0432\u0430\u043b\u0451\u045e \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u041b\u0456\u0441\u0442 \u0431\u044b\u045e \u0432\u044b\u0441\u043b\u0430\u043d\u044b \u043f\u0440\u0430\u0437 \u042d\u043b\u0430\u0441\u0430, \u0441\u044b\u043d\u0430 \u0428\u0430\u0444\u0430\u043d\u0430, \u0456 \u043f\u0440\u0430\u0437 \u0413\u0430\u043c\u0430\u0440\u044b\u044f, \u0441\u044b\u043d\u0430 \u0425\u0456\u043b\u043a\u0456\u044f, \u044f\u043a\u0456\u0445 \u0421\u044d\u0434\u044d\u043a\u0456\u044f, \u044e\u0434\u044d\u0439\u0441\u043a\u0456 \u043a\u0430\u0440\u043e\u043b\u044c, \u043f\u0430\u0441\u043b\u0430\u045e \u0434\u0430 \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440\u0430 \u045e \u0411\u0430\u0431\u0456\u043b\u0451\u043d. \u0423 \u0456\u043c \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f:&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e\u0441\u0456\u043c \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u043c, \u044f\u043a\u0456\u0445 \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0432\u044b\u0433\u043d\u0430\u0446\u044c \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u0411\u0430\u0431\u0456\u043b\u0451\u043d. \u0411\u0443\u0434\u0443\u0439\u0446\u0435 \u0434\u0430\u043c\u044b \u0456 \u0437\u0430\u0441\u044f\u043b\u044f\u0439\u0446\u0435\u0441\u044f, \u0441\u0430\u0434\u0437\u0456\u0446\u0435 \u0441\u0430\u0434\u044b \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439\u0446\u0435 \u0456\u0445 \u043f\u043b\u0430\u0434\u044b. \u0411\u044f\u0440\u044b\u0446\u0435 \u0436\u043e\u043d\u0430\u043a \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0439\u0446\u0435 \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0447\u043e\u043a. \u0412\u044b\u0431\u0456\u0440\u0430\u0439\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0436\u043e\u043d\u0430\u043a \u0434\u043b\u044f \u0432\u0430\u0448\u044b\u0445 \u0441\u044b\u043d\u043e\u045e, \u0430 \u0434\u0430\u0447\u043e\u043a \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0437\u0430\u043c\u0443\u0436, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u043b\u0456 \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0447\u043e\u043a. \u0420\u0430\u0437\u043c\u043d\u0430\u0436\u0430\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u043c, \u043a\u0430\u0431 \u0432\u0430\u0441 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u043c\u0435\u043d\u0448. \u0414\u0431\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u0433\u043e\u0440\u0430\u0434\u0430, \u0443 \u044f\u043a\u0456 \u042f \u0432\u044b\u0433\u043d\u0430\u045e \u0432\u0430\u0441, \u0456 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u044f\u0433\u043e \u0434\u0430 \u041f\u0430\u043d\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u044b\u043c \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442\u0430\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u0441 \u0432\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043d\u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u044b \u0432\u0430\u0448\u044b\u044f, \u0456 \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0439\u0446\u0435 \u045e\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0441\u043d\u044b, \u044f\u043a\u0456\u044f \u0432\u044b \u0441\u043d\u0456\u0446\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430 \u043f\u0440\u0430\u0440\u043e\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0430\u0434 \u041c\u0430\u0439\u0433\u043e \u0456\u043c\u044f. \u042f \u043d\u0435 \u043f\u0430\u0441\u044b\u043b\u0430\u045e \u0456\u0445, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u041a\u0430\u043b\u0456 \u043c\u0456\u043d\u0435 \u0434\u043b\u044f \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0433\u0430\u0434\u043e\u045e, \u042f \u043d\u0430\u0432\u0435\u0434\u0430\u044e \u0432\u0430\u0441 \u0456 \u0441\u043f\u043e\u045e\u043d\u044e \u0434\u043b\u044f \u0432\u0430\u0441 \u041c\u0430\u0451 \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0432\u044f\u0440\u043d\u0443 \u0432\u0430\u0441 \u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u042f \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b, \u044f\u043a\u0456\u044f \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043d\u0430\u043c\u0435\u0440\u044b \u043c\u0456\u0440\u0443, \u0430 \u043d\u0435 \u045e\u0446\u0456\u0441\u043a\u0443, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0432\u0430\u043c \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e \u0456 \u043d\u0430\u0434\u0437\u0435\u044e. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435, \u042f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u044e \u0432\u0430\u0441. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u2013 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u045e\u0441\u0456\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0432\u0430\u043c \u0441\u044f\u0431\u0435 \u0437\u043d\u0430\u0439\u0441\u0446\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u042f \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044e \u0432\u0430\u0448 \u043b\u0451\u0441 \u0456 \u0437\u0431\u044f\u0440\u0443 \u0432\u0430\u0441 \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0437 \u0443\u0441\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u045e, \u043a\u0443\u0434\u044b \u042f \u0432\u044b\u0433\u043d\u0430\u045e \u0432\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u042f \u0432\u044f\u0440\u043d\u0443 \u0432\u0430\u0441 \u0443 \u0442\u043e\u0435 \u043c\u0435\u0441\u0446\u0430, \u0430\u0434\u043a\u0443\u043b\u044c \u043f\u0430\u0432\u0451\u045e \u0432\u0430\u0441 \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 105 (104), 1\u0430. 4; \u043f\u0430\u0440. \u0421\u0456\u0440 2, 11b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u043b\u0430\u045e\u0446\u0435 \u041f\u0430\u043d\u0430, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u0456\u043c\u044f \u042f\u0433\u043e.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0430 \u0456 \u042f\u0433\u043e \u043c\u043e\u0446\u044b, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u045e \u0441\u043e\u0440\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u045e \u0443 \u041f\u0430\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0428\u0443\u043a\u0430\u0439\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"226","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">30, 18 \u2013 31, 9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0430\u0434\u043d\u043e\u0432\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0412\u043e\u0441\u044c \u042f \u0430\u0434\u043d\u0430\u045e\u043b\u044e \u0441\u0442\u0430\u043d \u0448\u0430\u0442\u0440\u043e\u045e \u042f\u043a\u0443\u0431\u0430 \u0456 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u044e \u044f\u0433\u043e\u043d\u0430\u0435 \u0436\u044b\u043b\u043b\u0451. \u0411\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0433\u043e\u0440\u0430\u0434 \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0443\u0437\u0433\u043e\u0440\u043a\u0443, \u0430 \u043f\u0430\u043b\u0430\u0446 \u0441\u0442\u0430\u043d\u0435 \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u0406 \u045e\u0437\u043d\u044f\u0441\u0435\u0446\u0446\u0430 \u0437 \u0456\u0445 \u043f\u0430\u0434\u0437\u044f\u043a\u0430 \u0456 \u0433\u043e\u043b\u0430\u0441 \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043d\u044b\u0445. \u042f \u043f\u0430\u043c\u043d\u043e\u0436\u0443 \u0456\u0445, \u0456 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u0456\u0445 \u043c\u0435\u043d\u0448. \u042f \u045e\u0441\u043b\u0430\u045e\u043b\u044e \u0456\u0445, \u0456 \u044f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u044f. \u042f\u0433\u043e \u0441\u044b\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0430 \u0441\u0445\u043e\u0434 \u044f\u0433\u043e\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e. \u042f \u043d\u0430\u0432\u0435\u0434\u0430\u044e \u045e\u0441\u0456\u0445 \u044f\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e. \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u044f\u0433\u043e\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u044f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440 \u044f\u0433\u043e\u043d\u044b \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u044f\u0433\u043e \u0430\u0441\u044f\u0440\u043e\u0434\u0434\u0437\u044f. \u0406 \u042f \u043d\u0430\u0431\u043b\u0456\u0436\u0443 \u044f\u0433\u043e, \u0456 \u0451\u043d \u043f\u0430\u0434\u044b\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435, \u0431\u043e \u0445\u0442\u043e \u044f\u0448\u0447\u044d \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0434\u0430 \u041c\u044f\u043d\u0435? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c. \u0412\u043e\u0441\u044c \u0443\u0437\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0431\u0443\u0440\u0430 \u0433\u043d\u0435\u0432\u0443 \u041f\u0430\u043d\u0430, \u0433\u0440\u043e\u0437\u043d\u044b \u045e\u0440\u0430\u0433\u0430\u043d \u0437 \u0433\u0440\u044b\u043c\u043e\u0442\u0430\u043c\u0456, \u0451\u043d \u043a\u0440\u0443\u0436\u044b\u0446\u044c \u043d\u0430\u0434 \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445. \u041d\u0435 \u0441\u043f\u044b\u043d\u0456\u0446\u0446\u0430 \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0456 \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043d\u0430\u043c\u0435\u0440\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u041d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0434\u0437\u0451\u043d \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0435 \u0433\u044d\u0442\u0430. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u042f \u0431\u0443\u0434\u0443 \u0411\u043e\u0433\u0430\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u041d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u045e\u0446\u0430\u043b\u0435\u045e \u0430\u0434 \u043c\u044f\u0447\u0430, \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456; \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0456\u0434\u0437\u0435 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a\u00bb. \u0417\u0434\u0430\u043b\u0451\u043a \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043c\u043d\u0435 \u041f\u0430\u043d: \u00ab\u041b\u044e\u0431\u043e\u045e\u044e \u0432\u0435\u0447\u043d\u0430\u0439 \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0446\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u042f \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. \u042f \u0437\u043d\u043e\u045e \u0430\u0434\u0431\u0443\u0434\u0443\u044e \u0446\u044f\u0431\u0435, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0430, \u0434\u0437\u0435\u0432\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f! \u0422\u044b \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0437\u0435\u0448 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0442\u044b\u043c\u043f\u0430\u043d\u0430\u043c\u0456 \u0456 \u0432\u044b\u0439\u0434\u0437\u0435\u0448 \u0443 \u0442\u0430\u043d\u0446\u044b \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430. \u0422\u044b \u0437\u043d\u043e\u045e \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0448 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0456 \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0421\u0430\u043c\u0430\u0440\u044b\u0456. \u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0440\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0430\u043c\u0456 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445 \u0456 \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0437 \u0456\u0445 \u043f\u043b\u0451\u043d. \u0411\u043e \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u044b \u042d\u0444\u0440\u0430\u0456\u043c\u0430: \u201c\u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u043d\u0430 \u0421\u0456\u0451\u043d, \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430!\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0420\u0430\u0434\u0430\u0441\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0434\u043b\u044f \u042f\u043a\u0443\u0431\u0430, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u043f\u0435\u0440\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u0435: \u201c\u0417\u0431\u0430\u045e, \u041f\u0430\u043d\u0435, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0440\u044d\u0448\u0442\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f!\u201d \u0412\u043e\u0441\u044c \u044f \u0432\u044b\u0432\u0435\u0434\u0443 \u0456\u0445 \u0437 \u043f\u0430\u045e\u043d\u043e\u0447\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0437 \u0443\u0441\u0456\u0445 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043d\u044b\u0445. \u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u2013 \u0441\u043b\u044f\u043f\u044b \u0456 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b, \u0446\u044f\u0436\u0430\u0440\u043d\u0430\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0430\u0440\u0430\u0434\u0437\u0456\u0445\u0430\u0439; \u044f\u043d\u044b \u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u0441\u044e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0433\u0440\u0430\u043c\u0430\u0434\u043e\u0439. \u041f\u0430\u0439\u0448\u043b\u0456 \u0437 \u043f\u043b\u0430\u0447\u0430\u043c, \u0430\u043b\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u042f \u043f\u0430\u0432\u044f\u0434\u0443 \u0456\u0445 \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0434\u0430 \u043f\u0430\u0442\u043e\u043a\u0430\u045e \u0432\u0430\u0434\u044b \u0440\u043e\u045e\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u0451\u0439, \u0431\u043e \u042f \u0441\u0442\u0430\u045e \u0410\u0439\u0446\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u042d\u0444\u0440\u0430\u0456\u043c \u2013 \u041c\u043e\u0439 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u044b\u043d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 31, 6; \u0406\u0441 2, 5<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0430\u0441\u0442\u0430\u043d\u0435 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u0446\u044c: <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u0443\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u0421\u0456\u0451\u043d, \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0414\u043e\u043c\u0435 \u042f\u043a\u0443\u0431\u0430! \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u041f\u0430\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"227","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">31, 15-22. 27-34<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u041a\u0440\u044b\u043a \u0447\u0443\u0442\u043d\u044b \u045e \u0420\u0430\u043c\u0435, \u043b\u044f\u043c\u0430\u043d\u0442 \u0456 \u0433\u043e\u0440\u043a\u0456 \u043f\u043b\u0430\u0447. \u0420\u0430\u0445\u044d\u043b\u044f \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u043d\u0435 \u0445\u043e\u0447\u0430 \u0431\u044b\u0446\u044c \u0441\u0443\u0446\u0435\u0448\u0430\u043d\u0430\u0439 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0431\u043e \u0456\u0445 \u043d\u044f\u043c\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0421\u0442\u0440\u044b\u043c\u0430\u0439 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0430\u0434 \u043f\u043b\u0430\u0447\u0443 \u0456 \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435 \u0430\u0434 \u0441\u043b\u0451\u0437, \u0431\u043e \u0451\u0441\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0437\u0430 \u0442\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u0443, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u042f\u043d\u044b \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u0432\u043e\u0440\u0430\u0433\u0430. \u0406 \u0451\u0441\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u0442\u0432\u0430\u044e \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0421\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043c\u0435\u0436\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0434\u043e\u0431\u0440\u0430 \u0447\u0443\u045e \u0441\u043a\u0430\u0440\u0433\u0443 \u042d\u0444\u0440\u0430\u0456\u043c\u0430: \u201e\u0422\u044b \u043f\u0430\u043a\u0430\u0440\u0430\u045e \u043c\u044f\u043d\u0435, \u0456 \u044f \u0431\u044b\u045e \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b \u044f\u043a \u043d\u0435\u043f\u0440\u044b\u0432\u0443\u0447\u0430\u043d\u0430\u0435 \u0446\u044f\u043b\u044f. \u0417\u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u044f \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u2013 \u0456 \u044f \u0432\u044f\u0440\u043d\u0443\u0441\u044f, \u0431\u043e \u0422\u044b, \u041f\u0430\u043d\u0435, \u043c\u043e\u0439 \u0411\u043e\u0433. \u041f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u044f \u0440\u0430\u0441\u043a\u0430\u044f\u045e\u0441\u044f, \u0430 \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0434\u0430\u0440\u044b\u045e \u0441\u044f\u0431\u0435 \u045e \u0433\u0440\u0443\u0434\u0437\u0456. \u042f \u0447\u044b\u0440\u0432\u0430\u043d\u0435\u044e \u0430\u0434 \u0441\u043e\u0440\u0430\u043c\u0443, \u0431\u043e \u043d\u0430\u0448\u0443 \u0433\u0430\u043d\u044c\u0431\u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0436 \u042d\u0444\u0440\u0430\u0456\u043c \u043d\u0435 \u041c\u043e\u0439 \u0434\u0430\u0440\u0430\u0433\u0456 \u0441\u044b\u043d, \u0446\u0456 \u043d\u0435 \u043b\u044e\u0431\u0430\u0435 \u0434\u0437\u0456\u0446\u044f? \u041a\u043e\u043b\u044c\u043a\u0456 \u0431 \u042f \u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u042f \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043f\u0430\u043c\u044f\u0442\u0430\u044e \u043f\u0440\u0430 \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0435 \u044f\u043c\u0443 \u041c\u0430\u0451 \u043d\u0443\u0442\u0440\u043e, \u042f \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0437\u043c\u0456\u043b\u0443\u044e\u0441\u044f \u043d\u0430\u0434 \u0456\u043c\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456, \u043f\u0430\u0441\u0442\u0430\u045e \u0430\u0440\u044b\u0435\u043d\u0446\u0456\u0440\u044b, \u0441\u043a\u0456\u0440\u0443\u0439 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430 \u0432\u044b\u0442\u0430\u043f\u0442\u0430\u043d\u044b \u0433\u0430\u0441\u0446\u0456\u043d\u0435\u0446, \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443, \u044f\u043a\u043e\u0439 \u0442\u044b \u0445\u0430\u0434\u0437\u0456\u043b\u0430. \u0412\u044f\u0440\u043d\u0456\u0441\u044f, \u0434\u0437\u0435\u0432\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u0433\u044d\u0442\u044b\u0445 \u0441\u0432\u0430\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e. \u0414\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043b\u0443\u043a\u0430\u0446\u044c, \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u044f \u0434\u0430\u0447\u043a\u0430? \u0411\u043e \u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0448\u0442\u0430 \u043d\u043e\u0432\u0430\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456: \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0446\u044c \u043c\u0443\u0436\u0447\u044b\u043d\u0443\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u043d\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043a\u0430\u043b\u0456 \u042f \u0437\u0430\u0441\u0435\u044e \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0434\u043e\u043c \u042e\u0434\u044b \u0441\u0435\u043c\u0435\u043d\u0435\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0441\u0435\u043c\u0435\u043d\u0435\u043c \u0436\u044b\u0432\u0451\u043b\u044b. \u0406 \u044f\u043a \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u045e \u0456\u0445, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u044f\u0446\u044c \u0456 \u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u0431\u0443\u0440\u044b\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u0434\u044b \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u0442\u0430\u043a \u0431\u0443\u0434\u0443 \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u0446\u044c \u0456\u0445, \u043a\u0430\u0431 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0456 \u0441\u0430\u0434\u0437\u0456\u0446\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u044f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0437\u0430\u0446\u044c: \u201e\u0410\u0439\u0446\u044b \u0435\u043b\u0456 \u043a\u0456\u0441\u043b\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u0430 \u043d\u0430 \u0437\u0443\u0431\u0430\u0445 \u0441\u044b\u043d\u043e\u045e \u2013 \u0430\u0441\u043a\u043e\u043c\u0456\u043d\u0430\u201d. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u043c\u0440\u044d \u0437\u0430 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0432\u0456\u043d\u0443. \u041a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u043a\u0456\u0441\u043b\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u043d\u0430\u0431\u2019\u0435 \u0430\u0441\u043a\u043e\u043c\u0456\u043d\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u043d\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043a\u0430\u043b\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0437 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u041d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0437 \u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u043c\u0456 \u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u045e\u0437\u044f\u045e \u0456\u0445 \u0437\u0430 \u0440\u0443\u043a\u0443, \u043a\u0430\u0431 \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u0422\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u041c\u043e\u0439 \u044f\u043d\u044b \u043f\u0430\u0440\u0443\u0448\u044b\u043b\u0456, \u0445\u043e\u0446\u044c \u042f \u0431\u044b\u045e \u0456\u0445 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u043c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0410\u043b\u0435 \u0432\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0451\u043d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0423\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d \u041c\u043e\u0439 \u0443 \u043d\u0443\u0442\u0440\u043e \u0456\u0445\u043d\u044f\u0435 \u0456 \u043d\u0430\u043f\u0456\u0448\u0443 \u044f\u0433\u043e \u043d\u0430 \u0456\u0445\u043d\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445. \u0411\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0406 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0446\u0456 \u0431\u0440\u0430\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u041f\u0430\u0437\u043d\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0430!\u201d \u0411\u043e \u045e\u0441\u0435 \u044f\u043d\u044b, \u0430\u0434 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430\u0433\u0430 \u0434\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u0437 \u0456\u0445, \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u042f \u0434\u0430\u0440\u0443\u044e \u0456\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u0456\u0445\u043d\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 51 (50), 12. 11<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0427\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0441\u0442\u0432\u0430\u0440\u044b \u045e\u0432\u0430 \u043c\u043d\u0435, \u0411\u043e\u0436\u0430,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0456 \u0430\u0434\u043d\u0430\u0432\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u044b \u0434\u0443\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434\u0432\u044f\u0440\u043d\u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0451 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e \u043c\u0430\u0456\u0445 \u0456 \u0437\u043d\u0456\u0448\u0447\u044b \u045e\u0441\u0435 \u043c\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0430\u0434\u043d\u0430\u0432\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"231","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">37, 21; 38, 14-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0415\u0440\u0430\u043c\u0456\u044f \u045e\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u0435 \u0421\u044d\u0434\u044d\u043a\u0456\u044e \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u0446\u044c \u043c\u0456\u0440<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u043f\u0430 \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u044f \u0421\u044d\u0434\u044d\u043a\u0456\u0456 \u0415\u0440\u0430\u043c\u0456\u044e \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u043b\u0456 \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446 \u0432\u0430\u0440\u0442\u044b \u0456 \u0434\u0430\u0432\u0430\u043b\u0456 \u044f\u043c\u0443 \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0431\u043e\u0445\u0430\u043d \u0445\u043b\u0435\u0431\u0430 \u0437 \u0432\u0443\u043b\u0456\u0446\u044b \u043f\u0435\u043a\u0430\u0440\u0430\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u043a\u043e\u043d\u0447\u044b\u045e\u0441\u044f \u045e\u0432\u0435\u0441\u044c \u0445\u043b\u0435\u0431 \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435. \u0406 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0415\u0440\u0430\u043c\u0456\u044f \u0434\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u0432\u0430\u0440\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u043e\u043b\u044c \u0421\u044d\u0434\u044d\u043a\u0456\u044f \u043f\u0430\u0441\u043b\u0430\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u044e \u0434\u0430 \u044f\u0433\u043e, \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0443, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0440\u0430\u043c\u0456\u0456: \u00ab\u0421\u043f\u044b\u0442\u0430\u044e\u0441\u044f \u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430 \u0430\u0434\u043d\u0443 \u0440\u044d\u0447, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u045e\u0442\u043e\u0439\u0432\u0430\u0439 \u0430\u0434 \u043c\u044f\u043d\u0435\u00bb. \u0415\u0440\u0430\u043c\u0456\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0421\u044d\u0434\u044d\u043a\u0456\u0456: \u00ab\u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u0446\u0456 \u0442\u044b \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0432\u044b\u0434\u0430\u0441\u0456 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c? \u0410 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0440\u0430\u0456\u0446\u044c \u0442\u0430\u0431\u0435, \u0442\u044b \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0448 \u043c\u044f\u043d\u0435\u00bb. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0421\u044d\u0434\u044d\u043a\u0456\u044f \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e \u0415\u0440\u0430\u043c\u0456\u0456 \u045e\u043f\u043e\u0442\u0430\u0439, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u042f\u043a \u0436\u044b\u0432\u044b \u041f\u0430\u043d, \u044f\u043a\u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043d\u0435 \u0432\u044b\u0434\u0430\u043c \u0446\u044f\u0431\u0435 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u043d\u0435 \u0430\u0434\u0434\u0430\u043c \u0446\u044f\u0431\u0435 \u045e \u0440\u0443\u043a\u0456 \u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043f\u0430\u043b\u044e\u044e\u0446\u044c \u043d\u0430 \u0442\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0415\u0440\u0430\u043c\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u044d\u0434\u044d\u043a\u0456\u0456: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041a\u0430\u043b\u0456 \u0442\u044b \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u044f\u0447\u044b \u0432\u044b\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0443\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0456 \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u043d\u0435 \u0437\u0433\u0430\u0440\u044b\u0446\u044c \u0443 \u0430\u0433\u043d\u0456, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0436\u044b\u0446\u044c \u0442\u044b \u0456 \u0434\u043e\u043c \u0442\u0432\u043e\u0439. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0432\u044b\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043a\u0430\u045e \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0442\u043e \u0433\u043e\u0440\u0430\u0434 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u045e \u0440\u0443\u043a\u0456 \u0445\u0430\u043b\u0434\u044d\u044f\u045e. \u042f\u043d\u044b \u0441\u043f\u0430\u043b\u044f\u0446\u044c \u044f\u0433\u043e \u0430\u0433\u043d\u0451\u043c, \u0430 \u0442\u044b \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435\u0448\u0441\u044f \u0430\u0434 \u0456\u0445 \u0440\u0443\u043a\u0456\u00bb. \u041a\u0430\u0440\u043e\u043b\u044c \u0421\u044d\u0434\u044d\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0440\u0430\u043c\u0456\u0456: \u00ab\u042f \u0431\u0430\u044e\u0441\u044f \u044e\u0434\u044d\u044f\u045e, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u043d\u0430 \u0431\u043e\u043a \u0445\u0430\u043b\u0434\u044d\u044f\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u0432\u044b\u0434\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u045e \u0456\u0445 \u0440\u0443\u043a\u0456, \u0430 \u0442\u044b\u044f \u043d\u0435 \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u043b\u0456 \u043c\u044f\u043d\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0415\u0440\u0430\u043c\u0456\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435 \u0432\u044b\u0434\u0430\u0434\u0443\u0446\u044c. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f, \u043f\u0440\u0430\u0448\u0443, \u0441\u043b\u043e\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456\u044f \u044f \u043f\u0435\u0440\u0430\u0434\u0430\u044e \u0442\u0430\u0431\u0435, \u0456 \u043f\u0430\u0448\u0447\u0430\u0441\u0446\u0456\u0446\u044c \u0442\u0430\u0431\u0435, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0436\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0442\u044b \u0430\u0434\u043c\u043e\u0432\u0456\u0448\u0441\u044f \u0432\u044b\u0439\u0441\u0446\u0456, \u0442\u043e \u0432\u043e\u0441\u044c \u0448\u0442\u043e \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: \u0412\u043e\u0441\u044c \u0443\u0441\u0456\u0445 \u0436\u0430\u043d\u0447\u044b\u043d, \u044f\u043a\u0456\u044f \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u0434\u043e\u043c\u0435 \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0432\u044b\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0430 \u044f\u043d\u044b \u043a\u0430\u0436\u0443\u0446\u044c: \u201e\u041f\u0430\u0434\u043c\u0430\u043d\u0443\u043b\u0456 \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u0446\u044f\u0431\u0435 \u0441\u044f\u0431\u0440\u044b \u0442\u0432\u0430\u0435, \u0430 \u043a\u0430\u043b\u0456 \u0437\u0430\u0433\u0440\u0430\u0437\u043b\u0456 \u045e \u0431\u0430\u043b\u043e\u0446\u0435 \u0442\u0432\u0430\u0435 \u043d\u043e\u0433\u0456, \u044f\u043d\u044b \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u043d\u0430\u0437\u0430\u0434\u201d. \u0423\u0441\u0435 \u0442\u0432\u0430\u0435 \u0436\u043e\u043d\u043a\u0456 \u0456 \u0434\u0437\u0435\u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u0433\u043d\u0430\u043d\u044b\u044f \u0434\u0430 \u0445\u0430\u043b\u0434\u044d\u044f\u045e, \u0430 \u0442\u044b \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435\u0448\u0441\u044f \u0430\u0434 \u0456\u0445 \u0440\u0443\u043a\u0456, \u0431\u043e \u0441\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0430 \u0433\u043e\u0440\u0430\u0434 \u0433\u044d\u0442\u044b \u0437\u0433\u0430\u0440\u044b\u0446\u044c \u0443 \u0430\u0433\u043d\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0421\u044d\u0434\u044d\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0440\u0430\u043c\u0456\u0456: \u00ab\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0456 \u0442\u044b \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u0448. \u0410 \u043a\u0430\u043b\u0456 \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0456 \u043f\u0430\u0447\u0443\u044e\u0446\u044c, \u0448\u0442\u043e \u044f \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u0442\u0430\u0431\u043e\u044e, \u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435 \u0434\u044b \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u201e\u041d\u0443 \u0441\u043a\u0430\u0436\u044b \u043d\u0430\u043c, \u0448\u0442\u043e \u0442\u044b \u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e? \u041d\u0435 \u045e\u0442\u043e\u0439\u0432\u0430\u0439 \u0430\u0434 \u043d\u0430\u0441, \u0456 \u043c\u044b \u043d\u0435 \u0437\u0430\u0431\u2019\u0451\u043c \u0446\u044f\u0431\u0435. \u0406 \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435 \u043a\u0430\u0440\u043e\u043b\u044c?\u201d \u0422\u0430\u0434\u044b \u0430\u0434\u043a\u0430\u0436\u0430\u0448 \u0456\u043c: \u201e\u042f \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u045e \u043a\u0430\u0440\u0430\u043b\u044e \u0441\u0432\u0430\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0430\u0434\u0441\u044b\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0434\u043e\u043c\u0443 \u042f\u043d\u0430\u0442\u0430\u043d\u0430, \u043a\u0430\u0431 \u0442\u0430\u043c \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456\u201d\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 \u045e\u0441\u0435 \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0456 \u0456 \u0441\u043f\u044b\u0442\u0430\u043b\u0456 \u044f\u0433\u043e, \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c. \u0422\u0430\u043c\u0443 \u044f\u043d\u044b \u043c\u043e\u045e\u0447\u043a\u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u044f\u0433\u043e, \u0431\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0447\u0443\u045e \u0440\u0430\u0437\u043c\u043e\u0432\u044b. \u0410 \u0415\u0440\u0430\u043c\u0456\u044f \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u0432\u0430\u0440\u0442\u044b \u0430\u0436 \u0434\u0430 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0437\u0434\u0430\u0431\u044b\u0442\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u0406 \u0431\u044b\u045e \u0442\u0430\u043c, \u043a\u0430\u043b\u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0431\u044b\u045e \u0437\u0434\u0430\u0431\u044b\u0442\u044b.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 4-5\u0430; \u043f\u0430\u0440. \u042e\u0434 8, 27&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u044b \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u043c \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0411\u043e\u0436\u044b\u0445 \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u0445, <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff0000; font-weight: bold;\"><span style=\"font-size: 0.6em; vertical-align: super;\"> <\/span><\/span><span>\u0443 \u043f\u0430\u0442\u0440\u044d\u0431\u0435, \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u043f\u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u043c\u0456, \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443, \u043c\u0443\u0436\u043d\u0430 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u043c\u043d\u043e\u0433\u0456\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423 \u043f\u0430\u0442\u0440\u044d\u0431\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"232","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 <\/span><span style=\"color: #ff0000;\">42, 1-16; 43, 4-7<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0415\u0440\u0430\u043c\u0456\u044f \u0456 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u0445\u043e\u043f\u0443 \u0433\u043e\u0440\u0430\u0434\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0441\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0401\u0445\u0430\u043d\u0430\u043d\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u041a\u0430\u0440\u044d\u044f, \u0456 \u0415\u0437\u0430\u043d\u0456\u0435\u043c, \u0441\u044b\u043d\u0430\u043c \u0410\u0448\u0430\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0430\u0434 \u043c\u0430\u043b\u043e\u0433\u0430 \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u044b \u0434\u0430 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u043c\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430 \u0437\u0430 \u043d\u0430\u0441, \u0437\u0430 \u045e\u0441\u044e \u0433\u044d\u0442\u0443\u044e \u0440\u044d\u0448\u0442\u0443, \u0431\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0430\u0441 \u043d\u044f\u0448\u043c\u0430\u0442 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456, \u044f\u043a \u0431\u0430\u0447\u044b\u0448 \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u043f\u0430\u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u0441\u0446\u0456, \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u0446\u044c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0440\u043e\u043a \u0415\u0440\u0430\u043c\u0456\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c: \u00ab\u0414\u043e\u0431\u0440\u0430, \u044f \u043f\u0430\u043c\u0430\u043b\u044e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0432\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0432\u0430\u0448\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u0423\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u044f \u043f\u0435\u0440\u0430\u0434\u0430\u043c \u0432\u0430\u043c. \u041d\u0435 \u045e\u0442\u0430\u044e \u0430\u0434 \u0432\u0430\u0441 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430\u00bb. \u042f\u043d\u044b \u0436 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u0415\u0440\u0430\u043c\u0456\u0456: \u00ab\u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u043c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043f\u0440\u0430\u0437 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u0434\u043b\u044f \u043d\u0430\u0441. \u0426\u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u043e\u0431\u0440\u044b\u043c, \u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c, \u043c\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043f\u0430\u0441\u044b\u043b\u0430\u0435\u043c \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0448\u0447\u0430\u0441\u0446\u0456\u043b\u0430 \u043d\u0430\u043c. \u041c\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043c\u0456\u043d\u0443\u043b\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0434\u0437\u0451\u043d, \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0441\u043b\u043e\u0432\u0430 \u0434\u0430 \u0415\u0440\u0430\u043c\u0456\u0456. \u0422\u0430\u0434\u044b \u0451\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0401\u0445\u0430\u043d\u0430\u043d\u0430, \u0441\u044b\u043d\u0430 \u041a\u0430\u0440\u044d\u044f, \u0456 \u045e\u0441\u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0432\u043e\u0439\u0441\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c, \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u0430\u0434 \u043c\u0430\u043b\u043e\u0433\u0430 \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0448\u0443\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443: \u041a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0435\u0441\u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u042f \u0430\u0434\u0431\u0443\u0434\u0443\u044e \u0432\u0430\u0441, \u0430 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0443; \u0437\u0430\u0441\u0430\u0434\u0436\u0443 \u0432\u0430\u0441, \u0430 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u044e, \u0431\u043e \u0448\u043a\u0430\u0434\u0443\u044e \u0437\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0432\u0430\u0441. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c \u0432\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u0446\u0435 \u0441\u0442\u0440\u0430\u0445. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u044f\u0433\u043e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0431\u043e \u042f \u0437 \u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u0430\u0441 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0456 \u0432\u044b\u0440\u0432\u0430\u0446\u044c \u0437 \u044f\u0433\u043e \u0440\u0443\u043a\u0456. \u042f \u0430\u043a\u0430\u0436\u0443 \u0432\u0430\u043c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0456 \u0451\u043d \u0437\u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456 \u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u0430\u043c \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0432\u0430\u0448\u0443\u044e \u0437\u044f\u043c\u043b\u044e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u043a\u0430\u043b\u0456 \u0432\u044b \u0441\u043a\u0430\u0436\u0430\u0446\u0435: \u201e\u041d\u0435 \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u045e \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e\u201d \u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0435 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0456 \u0441\u043a\u0430\u0436\u0430\u0446\u0435: \u201e\u041d\u0435, \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0434\u0437\u0435 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0439\u043d\u044b \u0456 \u043d\u0435 \u043f\u0430\u0447\u0443\u0435\u043c \u0433\u043e\u043b\u0430\u0441\u0443 \u0440\u043e\u0433\u0443, \u0434\u0437\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0445\u043b\u0435\u0431\u0430, \u0456 \u0442\u0430\u043c \u043f\u0430\u0441\u0435\u043b\u0456\u043c\u0441\u044f\u201d. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430, \u0440\u044d\u0448\u0442\u0430 \u042e\u0434\u044b! \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041a\u0430\u043b\u0456 \u0432\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044b\u0440\u0430\u0448\u044b\u0446\u0435 \u0456\u0441\u0446\u0456 \u045e \u0415\u0433\u0456\u043f\u0435\u0442, \u043a\u0430\u0431 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0442\u0430\u043c, \u0442\u043e \u043c\u0435\u0447, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0431\u0430\u0456\u0446\u0435\u0441\u044f, \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0435 \u0432\u0430\u0441 \u0442\u0430\u043c, \u0443 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u0406 \u0433\u043e\u043b\u0430\u0434, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0431\u0430\u0456\u0446\u0435\u0441\u044f, \u043f\u043e\u0439\u0434\u0437\u0435 \u0437\u0430 \u0432\u0430\u043c\u0456 \u0442\u0443\u0434\u044b, \u0443 \u0415\u0433\u0456\u043f\u0435\u0442, \u0456 \u0442\u0430\u043c \u0432\u044b \u043f\u0430\u043c\u0440\u044d\u0446\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0401\u0445\u0430\u043d\u0430\u043d, \u0441\u044b\u043d \u041a\u0430\u0440\u044d\u044f, \u0456 \u045e\u0441\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u045e \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043c\u0443 \u0437\u0430\u0431\u0440\u0430\u045e \u0401\u0445\u0430\u043d\u0430\u043d, \u0441\u044b\u043d \u041a\u0430\u0440\u044d\u044f, \u0456 \u045e\u0441\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u0443\u0441\u044e \u0440\u044d\u0448\u0442\u0443 \u042e\u0434\u044b, \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0430\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u0431\u044b\u043b\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u044f, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u0441\u044f\u043b\u0456\u0446\u044c \u0456\u0445 \u0443 \u0437\u044f\u043c\u043b\u044e \u044e\u0434\u044d\u0439\u0441\u043a\u0443\u044e: \u043c\u0443\u0436\u0447\u044b\u043d, \u0436\u0430\u043d\u0447\u044b\u043d, \u0434\u0437\u044f\u0446\u0435\u0439 \u0456 \u0434\u0430\u0447\u043e\u043a \u043a\u0430\u0440\u0430\u043b\u044f \u2013 \u0443\u0441\u0456\u0445, \u043a\u0430\u0433\u043e \u041d\u0430\u0431\u0443\u0437\u0430\u0440\u0434\u0430\u043d, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0446\u0435\u043b\u0430\u0430\u0445\u043e\u045e\u043d\u0456\u043a\u0430\u045e, \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0437 \u0413\u0430\u0434\u043e\u043b\u0456\u0435\u043c, \u0441\u044b\u043d\u0430\u043c \u0410\u0445\u0456\u043a\u0430\u043c\u0430, \u0441\u044b\u043d\u0430\u043c \u0428\u0430\u0444\u0430\u043d\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u044e \u0456 \u0411\u0430\u0440\u0443\u0445\u0430, \u0441\u044b\u043d\u0430 \u041d\u044d\u0440\u044b\u0456. \u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u045e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0431\u043e \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0422\u0430\u0445\u043f\u0430\u043d\u0445\u0435\u0441.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 42, 2b; \u041f\u043b 5, 3<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u043d\u0430\u0441 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0437\u0430 \u045e\u0441\u044e \u0433\u044d\u0442\u0443\u044e \u0440\u044d\u0448\u0442\u0443, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0430\u0441 \u043d\u044f\u0448\u043c\u0430\u0442 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u2013 \u0441\u0456\u0440\u043e\u0442\u044b \u0431\u0435\u0437 \u0430\u0439\u0446\u0430, \u0430 \u043c\u0430\u0446\u0456 \u043d\u0430\u0448\u044b\u044f \u2013 \u0443\u0434\u043e\u0432\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"233","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0431\u0430\u043a\u0443\u043a\u0430 <\/span><span style=\"color: #ff0000;\">1, 1 \u2013 2, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u045e \u0437\u0430\u043f\u0443\u0441\u0446\u0435\u043d\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u045e\u0431\u0430\u0447\u044b\u045e \u043f\u0440\u0430\u0440\u043e\u043a \u0410\u0431\u0430\u043a\u0443\u043a. \u00ab\u0414\u0430\u043a\u0443\u043b\u044c, \u041f\u0430\u043d\u0435, \u044f \u0431\u0443\u0434\u0443 \u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u0430 \u0422\u044b \u043d\u0435 \u0447\u0443\u0435\u0448? \u041a\u0440\u044b\u0447\u0443 \u0422\u0430\u0431\u0435: \u201c\u0413\u0432\u0430\u043b\u0442!\u201d, \u0430 \u0422\u044b \u043d\u0435 \u0440\u0430\u0442\u0443\u0435\u0448.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043c\u043d\u0435 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0437\u043c\u0443\u0448\u0430\u0435\u0448 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u045e\u0446\u0456\u0441\u043a? \u0420\u0430\u0431\u0443\u043d\u0430\u043a \u0456 \u0433\u0432\u0430\u043b\u0442 \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0443\u0437\u043d\u0456\u043a\u0430\u0435 \u0441\u043f\u0440\u044d\u0447\u043a\u0430 \u0456 \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0440\u0430\u0437\u043b\u0430\u0434. \u0417\u0430\u043a\u043e\u043d \u0437\u0430\u043c\u043e\u045e\u043a, \u0456 \u0441\u0443\u0434 \u043d\u0435 \u043c\u0430\u0435 \u043c\u043e\u0446\u044b, \u0431\u043e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u043f\u0440\u044b\u0441\u0443\u0434 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u0430\u0441\u043b\u0443\u043f\u044f\u043d\u0435\u0439\u0446\u0435 \u0430\u0434 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f. \u0411\u043e \u045e \u0432\u0430\u0448\u044b\u044f \u0434\u043d\u0456 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u0435, \u043a\u0430\u043b\u0456 \u0440\u0430\u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0432\u0430\u043c. \u0412\u043e\u0441\u044c \u0436\u0430 \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u044e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043d\u044f\u043b\u0456\u0441\u044f \u0445\u0430\u043b\u0434\u044d\u0456, \u043d\u0430\u0440\u043e\u0434 \u0434\u0437\u0456\u043a\u0456 \u0456 \u043d\u044f\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b, \u044f\u043a\u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u0446\u044c \u0434\u0430 \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u0437\u044f\u043c\u0435\u043b\u044c, \u043a\u0430\u0431 \u0437\u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u043d\u0435 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u043b\u043b\u0451\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0441\u0442\u0440\u0430\u0448\u043d\u044b \u0456 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0436\u0430\u0445, \u0430\u0434 \u044f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0443\u0434 \u0456 \u044f\u0433\u043e \u0432\u0435\u043b\u0456\u0447. \u042f\u0433\u043e \u043a\u043e\u043d\u0456 \u2013 \u0448\u043f\u0430\u0440\u0447\u044d\u0439 \u0437\u0430 \u043b\u0435\u0430\u043f\u0430\u0440\u0434\u0430\u045e, \u0456 \u0431\u043e\u043b\u044c\u0448 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u044f \u0437\u0430 \u0432\u0430\u045e\u043a\u043e\u045e \u0432\u0435\u0447\u0430\u0440\u0430\u043c. \u0421\u043a\u0430\u0447\u0443\u0446\u044c \u044f\u0433\u043e \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456, \u0456\u043c\u0447\u0430\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a \u044f\u0433\u043e \u043a\u043e\u043d\u043d\u0456\u043a\u0456, \u043b\u044f\u0446\u044f\u0446\u044c \u044f\u043a \u0430\u0440\u043e\u043b, \u044f\u043a\u0456 \u043a\u0456\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0447\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0433\u0430\u0442\u043e\u0432\u044b \u0434\u0430 \u0433\u0432\u0430\u043b\u0442\u0443, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0437\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0437\u0430\u0434, \u044f\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445, \u044f\u043a \u043f\u044f\u0441\u043e\u043a. \u0401\u043d \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0435\u0446\u0446\u0430 \u0437 \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0430 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b \u0434\u043b\u044f \u044f\u0433\u043e \u2013 \u043f\u0430\u0441\u043c\u0435\u0448\u044b\u0448\u0447\u0430, \u0451\u043d \u043a\u043f\u0456\u0446\u044c \u0437 \u043a\u043e\u0436\u043d\u0430\u0439 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456 \u2013 \u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0430\u0441\u044b\u043f \u0456 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435 \u044f\u0435. \u041f\u0430\u0441\u043b\u044f \u0437\u043c\u044f\u043d\u044f\u0435\u0446\u0446\u0430, \u044f\u043a \u0432\u0435\u0446\u0435\u0440, \u0434\u044b \u0456\u0434\u0437\u0435 \u0434\u0430\u043b\u0435\u0439, \u0430\u043b\u0435 \u043f\u0430\u043d\u044f\u0441\u0435 \u043a\u0430\u0440\u0443 \u0442\u043e\u0439, \u0447\u044b\u044f \u0441\u0456\u043b\u0430 \u0431\u044b\u043b\u0430 \u044f\u0433\u043e \u0431\u043e\u0433\u0430\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0436 \u043d\u0435 \u0422\u044b, \u041f\u0430\u043d\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u043c\u043e\u0439 \u0421\u0432\u044f\u0442\u044b, \u0456\u0441\u043d\u0443\u0435\u0448 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443? \u041c\u044b \u043d\u0435 \u043f\u0430\u043c\u0440\u043e\u043c! \u041f\u0430\u043d\u0435, \u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u0434\u043b\u044f \u0441\u0443\u0434\u0430. \u0421\u043a\u0430\u043b\u0430, \u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u044f\u0433\u043e \u0434\u043b\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f. \u0422\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0447\u044b\u0441\u0442\u044b\u044f, \u043a\u0430\u0431 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0437\u043b\u043e, \u0422\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u043d\u0430\u0437\u0456\u0440\u0430\u0446\u044c \u0437\u0430 \u043a\u0440\u044b\u045e\u0434\u0430\u0439. \u0427\u0430\u043c\u0443 \u043c\u0430\u045e\u0447\u044b\u0448, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u0448 \u0432\u0435\u0440\u0430\u043b\u043e\u043c\u043d\u044b\u0445, \u043a\u0430\u043b\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u0437\u2019\u044f\u0434\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0435\u0439\u0448\u0430\u0433\u0430 \u0437\u0430 \u044f\u0433\u043e? \u0427\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0448 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u044f\u043a \u0437 \u043c\u0430\u0440\u0441\u043a\u043e\u0439 \u0440\u044b\u0431\u0430\u0439, \u044f\u043a \u0437 \u043f\u0430\u045e\u0437\u0443\u043d\u0430\u043c\u0456, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u0439 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430? \u0411\u043e \u0451\u043d \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043b\u043e\u0432\u0456\u0446\u044c \u043d\u0430 \u0432\u0443\u0434\u0443, \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u0456\u0445 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0435\u0442\u043a\u0430\u043c\u0456 \u0456 \u0437\u0431\u0456\u0440\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u043d\u0435\u0440\u0430\u0446\u0435, \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0432\u0430\u0451\u0439 \u0441\u0435\u0442\u0446\u044b \u0456 \u0430\u043a\u0430\u0434\u0436\u0432\u0430\u0435 \u0441\u0432\u043e\u0439 \u043d\u0435\u0440\u0430\u0442, \u0431\u043e \u043f\u0440\u0430\u0437 \u0456\u0445 \u043c\u0430\u0435 \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u0441\u044b\u0442\u0443\u044e \u0435\u0436\u0443. \u0426\u0456 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0451\u043d \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0430\u043f\u0430\u0440\u0430\u0436\u043d\u044f\u0435 \u0441\u0432\u0430\u044e \u0441\u0435\u0442\u043a\u0443, \u043a\u0430\u0431 \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0441\u0442\u0430\u043d\u0443 \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0430\u0440\u0446\u0435, \u0456 \u043f\u0430\u0434\u044b\u043c\u0443\u0441\u044f \u043d\u0430 \u0432\u0435\u0436\u0443, \u0456 \u0431\u0443\u0434\u0443 \u043f\u0456\u043b\u044c\u043d\u0430 \u0441\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u0441\u043a\u0430\u0436\u0430 \u043c\u043d\u0435 \u0456 \u0448\u0442\u043e \u0430\u0434\u043a\u0430\u0436\u0430 \u043d\u0430 \u043c\u0430\u044e \u0441\u043a\u0430\u0440\u0433\u0443\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0417\u0430\u043f\u0456\u0448\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0448, \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0437\u0430\u043d\u0430\u0442\u0443\u0439 \u043d\u0430 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0447\u044b\u0442\u0430\u0435, \u043c\u043e\u0433 \u043b\u0451\u0433\u043a\u0430 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0446\u044c. \u0411\u043e \u0433\u044d\u0442\u0430\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u044f\u0448\u0447\u044d \u0447\u0430\u043a\u0430\u0435 \u043d\u0430 \u043f\u044d\u045e\u043d\u044b \u0447\u0430\u0441 \u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430, \u0431\u043e \u043d\u0435 \u0430\u0448\u0443\u043a\u0432\u0430\u0435. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c, \u0447\u0430\u043a\u0430\u0439, \u0431\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430, \u043d\u0435 \u0441\u043f\u043e\u0437\u043d\u0456\u0446\u0446\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u044b\u0445\u043b\u0456\u0432\u044b, \u0443 \u044f\u043a\u0456\u043c \u043d\u044f\u043c\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u0434\u0443\u0448\u044b, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0431\u0440 10, 37-38\u0430. 39<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443, \u0456 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u0456 \u043d\u0435 \u0441\u043f\u043e\u0437\u043d\u0456\u0446\u0446\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410 \u043c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u043b\u0435 \u043c\u044b \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0430\u043b\u0435 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410 \u043c\u043e\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"234","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0431\u0430\u043a\u0443\u043a\u0430 <\/span><span style=\"color: #ff0000;\">2, 5-20<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000; font-style: italic;\">\u0417\u043b\u0430\u0441\u043b\u043e\u045e\u0435 \u043d\u0430 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e<\/span><span style=\"color: #ff0000; font-style: italic;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0432\u0456\u043d\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435 \u043f\u044b\u0445\u043b\u0456\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u043a \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u043c\u044d\u0442\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u0430\u0432\u0456\u0442\u044b, \u044f\u043a \u0428\u044d\u043e\u043b\u044c, \u0456 \u043d\u0435\u043d\u0430\u0441\u044b\u0442\u043d\u044b, \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c, \u0445\u0442\u043e \u0437\u0431\u0456\u0440\u0430\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b. \u0410\u0434\u043d\u0430\u043a \u0446\u0456 \u044f\u043d\u044b \u045e\u0441\u0435 \u043d\u0435 \u0441\u043a\u043b\u0430\u0434\u0443\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u045e\u043a\u0456 \u0456 \u043d\u0430\u0441\u043c\u0435\u0448\u043b\u0456\u0432\u044b\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u0456? \u0426\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0443\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0435 \u044f\u0433\u043e\u043d\u0430\u0435, \u0456 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0434\u0430\u045e\u0433\u0430\u043c\u0456!\u00bb \u0426\u0456 \u043d\u0435 \u0437\u2019\u044f\u0432\u044f\u0446\u0446\u0430 \u0440\u0430\u043f\u0442\u0430\u043c \u0442\u0432\u0430\u0435 \u043b\u0456\u0445\u0432\u044f\u0440\u044b, \u0446\u0456 \u043d\u0435 \u0430\u0431\u0443\u0434\u0437\u044f\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043c\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435, \u0430 \u0442\u044b \u0441\u0442\u0430\u043d\u0435\u0448 \u0456\u0445 \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439? \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043c\u043d\u043e\u0433\u0456\u044f \u043f\u043b\u044f\u043c\u0451\u043d\u044b, \u0446\u044f\u0431\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0443\u0441\u0435 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u0430 \u043a\u0440\u043e\u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0433\u0432\u0430\u043b\u0442 \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u0439, \u043d\u0430\u0434 \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u0456 \u045e\u0441\u0456\u043c\u0456 \u044f\u0433\u043e \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0446\u044f\u0433\u0432\u0430\u0435 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043f\u0440\u044b\u0431\u044b\u0442\u0430\u043a \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443, \u043a\u0430\u0431 \u0432\u044b\u0441\u043e\u043a\u0430 \u0437\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u0451 \u0433\u043d\u044f\u0437\u0434\u043e \u0456 \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u043b\u0456\u0445\u043e\u0439 \u0440\u0443\u043a\u0456. \u0414\u0437\u0435\u043b\u044f \u0433\u0430\u043d\u044c\u0431\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443 \u0442\u044b \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u0447\u044b\u043c \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b. \u0422\u0430\u043c\u0443 \u043a\u0430\u043c\u0435\u043d\u044c \u0437\u0430\u043a\u0440\u044b\u0447\u044b\u0446\u044c \u0441\u0430 \u0441\u0446\u044f\u043d\u044b, \u0430 \u0434\u0440\u0430\u045e\u043b\u044f\u043d\u0430\u044f \u0431\u044d\u043b\u044c\u043a\u0430 \u0430\u0434\u043a\u0430\u0436\u0430 \u044f\u043c\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0431\u0443\u0434\u0443\u0435 \u0433\u043e\u0440\u0430\u0434 \u043d\u0430 \u043a\u0440\u044b\u0432\u0456 \u0456 \u043d\u0430 \u0431\u044f\u0441\u043f\u0440\u0430\u045e\u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e. \u0426\u0456 \u043d\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0433\u043e\u043d\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435 \u043f\u0440\u0430\u0446\u0443 \u043b\u044e\u0434\u0437\u0435\u0439, \u0456 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430? \u0411\u043e \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0445\u0432\u0430\u043b\u044b \u041f\u0430\u043d\u0430, \u044f\u043a \u043c\u043e\u0440\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0432\u0430\u0434\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u043e\u0456\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0434\u0430\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u044f\u043c\u0443 \u0441\u0432\u043e\u0439 \u0433\u043d\u0435\u045e, \u043a\u0430\u0431, \u043d\u0430\u043f\u0430\u0456\u045e\u0448\u044b, \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u044f\u0433\u043e \u043d\u0430\u0433\u0430\u0442\u0443. \u0422\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u045e\u0441\u044f \u0433\u0430\u043d\u044c\u0431\u0430\u044e \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u043b\u0430\u0432\u044b. \u041d\u0430\u043f\u0456\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b \u0456 \u043f\u0430\u043a\u0430\u0436\u044b \u0441\u0432\u0430\u0451 \u043d\u0435\u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435! \u041f\u0430\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435 \u043a\u0435\u043b\u0456\u0445 \u0437 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u041f\u0430\u043d\u0430, \u0456 \u0433\u0430\u043d\u044c\u0431\u0430 \u0437\u0430\u043a\u0440\u044b\u0435 \u0442\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443. \u0413\u0432\u0430\u043b\u0442, \u044f\u043a\u0456 \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0434 \u041b\u0456\u0431\u0430\u043d\u0430\u043c, \u0430\u0431\u0440\u044b\u043d\u0435\u0446\u0446\u0430 \u043d\u0430 \u0446\u044f\u0431\u0435, \u0456 \u0432\u044b\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0436\u044b\u0432\u0451\u043b\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0437\u0430 \u043a\u0440\u043e\u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0437\u0430 \u0433\u0432\u0430\u043b\u0442 \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u0439, \u043d\u0430\u0434 \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u0456 \u045e\u0441\u0456\u043c\u0456 \u044f\u0433\u043e \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0437 \u0456\u0434\u0430\u043b\u0430, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u0440\u0430\u0437\u0430\u045e \u044f\u0433\u043e \u0440\u0430\u0437\u044c\u0431\u044f\u0440, \u0437 \u0432\u044b\u043b\u0456\u0442\u0430\u0433\u0430 \u0431\u0430\u043b\u0432\u0430\u043d\u0430 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u043c\u0430\u043d\u044b? \u0427\u0430\u0433\u043e \u0447\u0430\u043a\u0430\u0435 \u0442\u0432\u043e\u0440\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0442\u0432\u043e\u0440\u0430, \u0430\u0434 \u043d\u044f\u043c\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e, \u044f\u043a\u0456\u0445 \u0437\u0440\u0430\u0431\u0456\u045e. \u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u0434\u0440\u044d\u0432\u0443: \u00ab\u0410\u0431\u0443\u0434\u0437\u0456\u0441\u044f!\u00bb \u0456 \u043d\u044f\u043c\u043e\u043c\u0443 \u043a\u0430\u043c\u0435\u043d\u044e: \u00ab\u0423\u0441\u0442\u0430\u043d\u044c!\u00bb \u0426\u0456 \u0451\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c? \u0401\u043d \u043f\u0430\u043a\u0440\u044b\u0442\u044b \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0456 \u0441\u0440\u044d\u0431\u0440\u0430\u043c, \u0430\u043b\u0435 \u045e \u0456\u043c \u043d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0430\u043d \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u043c\u043e\u045e\u043a\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f!&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 2, 12; 3, 23; 11, 32<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b\u044f, \u0448\u0442\u043e, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u0417\u0430\u043a\u043e\u043d\u0443, \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u0431\u0435\u0437 \u0417\u0430\u043a\u043e\u043d\u0443 \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c, \u0430 \u0442\u044b\u044f, \u0448\u0442\u043e \u045e \u0417\u0430\u043a\u043e\u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u0441\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u0443\u0441\u0456\u0445 \u0443 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0443\u0441\u0456\u0445 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0441\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"235","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u041f\u043b\u0430\u0447\u0443 <\/span><span style=\"color: #ff0000;\">1, 1-12. 18-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u0443\u0441\u0446\u0435\u043b\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e, \u044f\u043a \u0441\u0430\u043c\u043e\u0442\u043d\u0430 \u0441\u0442\u0430\u0456\u0446\u044c \u0448\u043c\u0430\u0442\u043b\u044e\u0434\u043d\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0433\u043e\u0440\u0430\u0434! \u0401\u043d \u0431\u044b\u0446\u0446\u0430\u043c \u0443\u0434\u0430\u0432\u0430, \u0430 \u0431\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e! \u041a\u043d\u044f\u0437\u0451\u045e\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439 \u0441\u0442\u0430\u043b\u0430 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u0430\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u043a\u0430 \u043f\u043b\u0430\u0447\u0430 \u045e\u043d\u0430\u0447\u044b, \u043d\u0430 \u044f\u0435 \u0448\u0447\u0430\u0446\u044d \u0441\u043b\u044f\u0437\u0430. \u041d\u044f\u043c\u0430 \u0451\u0439 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u0430\u0434 \u0443\u0441\u0456\u0445 \u044f\u0435 \u043a\u0430\u0445\u0430\u043d\u043a\u0430\u045e, \u0437\u0434\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u0451\u0439 \u0443\u0441\u0435 \u044f\u0435 \u0441\u044f\u0431\u0440\u044b, \u0441\u0442\u0430\u043b\u0456 \u044f\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042e\u0434\u0430 \u043f\u0430\u0439\u0448\u043e\u045e \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435, \u0432\u0430 \u045e\u0446\u0456\u0441\u043a \u0456 \u0446\u044f\u0436\u043a\u043e\u0435 \u0440\u0430\u0431\u0441\u0442\u0432\u0430. \u041f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043d\u0435 \u043c\u0430\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0423\u0441\u0435 \u044f\u0433\u043e \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0456 \u0434\u0430\u0433\u043d\u0430\u043b\u0456 \u044f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u0443\u0446\u0456\u0441\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u0440\u043e\u0433\u0456 \u0421\u0456\u0451\u043d\u0430 \u045e \u0436\u0430\u043b\u043e\u0431\u0435, \u0431\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0456\u0434\u0437\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u0430. \u0423\u0441\u0435 \u044f\u0433\u043e \u0431\u0440\u0430\u043c\u044b \u0430\u043f\u0443\u0441\u0446\u0435\u043b\u0456, \u0435\u043d\u0447\u0443\u0446\u044c \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u043f\u0430\u043a\u0443\u0442\u0443\u044e\u0446\u044c \u044f\u0433\u043e \u0434\u0437\u044f\u045e\u0447\u0430\u0442\u044b, \u0430 \u0451\u043d \u043f\u043e\u045e\u043d\u044b \u0433\u043e\u0440\u044b\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0441\u0430\u0431\u0435, \u0432\u043e\u0440\u0430\u0433\u0456 \u044f\u0433\u043e \u0436\u044b\u0432\u0443\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u0431\u043e \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e, \u0448\u0442\u043e \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0430 \u044f\u0433\u043e \u043a\u0430\u0440\u0430 \u0437\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u044f\u0433\u043e \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b, \u044f\u0433\u043e \u0434\u0437\u0435\u0446\u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u043d\u044f\u0432\u043e\u043b\u044e \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u0434\u0430\u0447\u043a\u0443 \u0421\u0456\u0451\u043d\u0430 \u045e\u0441\u044f \u044f\u0435 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c. \u042f\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0441\u0442\u0430\u043b\u0456 \u044f\u043a \u0430\u043b\u0435\u043d\u0456, \u0448\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u043f\u0430\u0448\u044b \u0456 \u043f\u0430\u0439\u0448\u043b\u0456, \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u044b\u044f, \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0434\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043b\u0456\u0445\u0430 \u0456 \u0431\u043b\u0443\u043a\u0430\u043d\u043d\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435 \u043f\u0440\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u0431\u044b\u043b\u044b\u0445 \u0434\u0437\u0451\u043d. \u041a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u044f\u0433\u043e \u045e\u043f\u0430\u045e \u0430\u0434 \u0440\u0443\u043a\u0456 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u044f\u043c\u0443 \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443. \u0413\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u044f\u0433\u043e \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0456 \u0456 \u0441\u043c\u044f\u044f\u043b\u0456\u0441\u044f \u043d\u0430\u0434 \u044f\u0433\u043e \u0440\u0443\u0456\u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u044f\u0436\u043a\u0430 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0442\u0430\u043c\u0443 \u0441\u0442\u0430\u045e \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c. \u041f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0456\u043c \u0443\u0441\u0435, \u0445\u0442\u043e \u0448\u0430\u043d\u0430\u0432\u0430\u045e \u044f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u0433\u043e \u043d\u0430\u0433\u0430\u0442\u0443. \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u0434\u044b\u0445\u0430\u0435 \u0456 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u043b\u044f\u0447\u044b\u043c\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u0433\u043e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u2013 \u043d\u0430 \u043f\u0430\u0434\u043e\u043b\u0435 \u044f\u0433\u043e\u043d\u0430\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0456, \u0451\u043d \u043d\u0435 \u0434\u0443\u043c\u0430\u045e \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u043a\u0430\u043d\u0435\u0446, \u0442\u0430\u043c\u0443 \u0442\u0430\u043a \u043d\u0456\u0437\u043a\u0430 \u045e\u043f\u0430\u045e, \u0456 \u043d\u044f\u043c\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431 \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u044f\u0433\u043e. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u041f\u0430\u043d\u0435, \u043d\u0430 \u043c\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e, \u0431\u043e \u0441\u0442\u0430\u045e \u043c\u043e\u0446\u043d\u044b\u043c \u043c\u043e\u0439 \u0432\u043e\u0440\u0430\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0434\u0430 \u045e\u0441\u0456\u0445 \u044f\u0433\u043e \u0441\u043a\u0430\u0440\u0431\u0430\u045e. \u0411\u0430\u0447\u044b\u045e \u0451\u043d \u044f\u043a \u0443\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u043c \u0422\u044b \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u043e\u0439 \u0441\u0445\u043e\u0434.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u044f\u0433\u043e \u0441\u0442\u043e\u0433\u043d\u0435, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u0445\u043b\u0435\u0431\u0430. \u0410\u0434\u0434\u0430\u0435 \u0441\u0432\u0430\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u0437\u0430 \u0435\u0436\u0443, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u041f\u0430\u043d\u0435, \u0456 \u045e\u0431\u0430\u0447, \u044f\u043a \u044f \u0437\u043d\u044f\u0432\u0430\u0436\u0430\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u043a\u0440\u0430\u043d\u0430\u0435 \u0432\u0430\u0441 \u0433\u044d\u0442\u0430? \u0423\u0441\u0435, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0434\u0430\u0440\u043e\u0433\u0430\u044e, \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u044c\u0446\u0435\u0441\u044f \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u0446\u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u0431\u043e\u043b\u044c \u044f\u043a \u043c\u043e\u0439, \u044f\u043a\u0456 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u045e \u043c\u044f\u043d\u0435, \u044f\u043a\u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d \u0443 \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u2013 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430 \u044f \u045e\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430. \u041f\u0440\u0430\u0448\u0443, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u045e\u0431\u0430\u0447\u0446\u0435 \u043c\u043e\u0439 \u0431\u043e\u043b\u044c, \u043c\u0430\u0435 \u0434\u0437\u044f\u045e\u0447\u0430\u0442\u044b \u0456 \u0445\u043b\u043e\u043f\u0446\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u043f\u0430\u043b\u043e\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043a\u043b\u0456\u043a\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u044f\u043d\u044b \u0437\u0434\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u043c\u043d\u0435, \u043c\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0431\u043e \u0448\u0443\u043a\u0430\u043b\u0456 \u0441\u0430\u0431\u0435 \u0435\u0436\u0443, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u041f\u0430\u043d\u0435, \u0431\u043e \u0446\u044f\u0436\u043a\u0430 \u043c\u043d\u0435! \u041c\u0430\u0451 \u043d\u0443\u0442\u0440\u043e \u045e\u0441\u0442\u0440\u044b\u0432\u043e\u0436\u0430\u043d\u0430, \u043f\u0435\u0440\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u045e\u0432\u0430 \u043c\u043d\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0431\u043e \u044f \u0431\u044b\u045e \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b. \u0417\u0432\u043e\u043d\u043a\u0443 \u043c\u0435\u0447 \u0433\u0443\u0431\u0456\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439, \u0443 \u0434\u043e\u043c\u0435 \u2013 \u043c\u043e\u0440.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0401\u045e 16, 16; \u043f\u0430\u0440. \u041f\u043b 1, 16\u0430. 18b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u043f\u043b\u0430\u0447\u0443, \u0456 \u0432\u043e\u0447\u044b \u043c\u0430\u0435 \u0437\u0430\u0446\u043c\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u0441\u043b\u0451\u0437, \u0431\u043e \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043c\u044f\u043d\u0435 \u043c\u043e\u0439 \u0441\u0443\u0446\u044f\u0448\u0430\u043b\u044c\u043d\u0456\u043a.<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u041f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u044c\u0446\u0435\u0441\u044f, \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0446\u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u0431\u043e\u043b\u044c \u044f\u043a \u043c\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0441\u0435, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0434\u0430\u0440\u043e\u0433\u0430\u044e, \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u044c\u0446\u0435\u0441\u044f \u0456 \u045e\u0431\u0430\u0447\u0446\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0426\u0456 \u0451\u0441\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"236","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041f\u043b\u0430\u0447\u0443 <\/span><span style=\"color: #ff0000;\">3, 1-33<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043a\u0430\u0440\u0433\u0430 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0431\u0430\u0447\u044b\u045e \u043d\u044f\u0434\u043e\u043b\u044e \u043f\u0430\u0434 \u043a\u0456\u0435\u043c \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443. \u0401\u043d \u0433\u043d\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u0441\u0446\u0456 \u045e \u0446\u0435\u043c\u0440\u044b, \u0430 \u043d\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0401\u043d \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0456 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u045e \u043c\u0430\u0451 \u0446\u0435\u043b\u0430 \u0456 \u043c\u0430\u044e \u0441\u043a\u0443\u0440\u0443, \u0441\u0442\u0440\u0443\u0448\u0447\u044b\u045e \u043c\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456. \u0417\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0442\u0430\u0447\u044b\u045e \u0430\u0442\u0440\u0443\u0442\u0430\u044e \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c. \u041f\u0430\u0441\u044f\u043b\u0456\u045e \u043c\u044f\u043d\u0435 \u045e \u0446\u0435\u043c\u0440\u044b, \u044f\u043a \u0434\u0430\u045e\u043d\u043e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0431\u043d\u0451\u0441 \u043c\u044f\u043d\u0435 \u043c\u0443\u0440\u0430\u043c, \u043a\u0430\u0431 \u044f \u043d\u0435 \u0432\u044b\u0439\u0448\u0430\u045e, \u0437\u0440\u0430\u0431\u0456\u045e \u0446\u044f\u0436\u043a\u0456\u043c\u0456 \u043c\u0430\u0435 \u043c\u0435\u0434\u043d\u044b\u044f \u043a\u0430\u0439\u0434\u0430\u043d\u044b. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u044f \u043a\u0440\u044b\u0447\u0443 \u0456 \u043c\u0430\u043b\u044e, \u0401\u043d \u0437\u0430\u0433\u043b\u0443\u0448\u0430\u0435 \u043c\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443. \u041f\u0435\u0440\u0430\u0433\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043c\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0456 \u0447\u0430\u0441\u0430\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u043d\u0435\u043c, \u043f\u0430\u0431\u043b\u044b\u0442\u0430\u045e \u043c\u0430\u0435 \u0441\u0446\u0435\u0436\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u044f\u043a \u043c\u044f\u0434\u0437\u044c\u0432\u0435\u0434\u0437\u044c, \u0448\u0442\u043e \u043f\u0430\u0434\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0435, \u044f\u043a \u043b\u0435\u045e \u0443 \u0441\u0445\u043e\u0432\u0430\u043d\u0446\u044b. \u041f\u0430\u0431\u043b\u044b\u0442\u0430\u045e \u043c\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0456, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b\u043c. \u041d\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0441\u0432\u043e\u0439 \u043b\u0443\u043a \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0446\u044d\u043b\u0430\u043c \u0434\u043b\u044f \u0441\u0442\u0440\u0430\u043b\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0443\u0441\u0446\u0456\u045e \u0443 \u043c\u0430\u0435 \u043d\u044b\u0440\u043a\u0456 \u0441\u0442\u0440\u044d\u043b\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u043b\u0447\u0430\u043d\u0430. \u042f \u0441\u0442\u0430\u045e \u043d\u0430\u0441\u043c\u0435\u0448\u043a\u0430\u044e \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0456\u0445 \u0437\u0434\u0437\u0435\u043a\u043b\u0456\u0432\u044b\u043c \u0441\u043f\u0435\u0432\u0430\u043c \u043d\u0430 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c. \u0401\u043d \u043d\u0430\u0441\u044b\u0446\u0456\u045e \u043c\u044f\u043d\u0435 \u0433\u043e\u0440\u044b\u0447\u0447\u0443, \u043d\u0430\u043f\u0430\u0456\u045e \u043c\u044f\u043d\u0435 \u043f\u0430\u043b\u044b\u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0446\u0451\u0440 \u043c\u0430\u0435 \u0437\u0443\u0431\u044b \u0436\u0432\u0456\u0440\u0430\u043c, \u043a\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u045e \u043f\u043e\u043f\u0435\u043b. \u041f\u0430\u0437\u0431\u0430\u0432\u0456\u045e \u0434\u0443\u0448\u0443 \u043c\u0430\u044e \u0441\u043f\u0430\u043a\u043e\u044e, \u044f \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u0448\u0447\u0430\u0441\u0446\u0435. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u044f: \u00ab\u0417\u043d\u0456\u043a\u043b\u0430 \u043c\u0430\u044f \u0441\u0456\u043b\u0430 \u0456 \u043c\u0430\u0451 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u041f\u0430\u043d\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u043f\u043e\u043c\u043d\u0456 \u043f\u0440\u0430 \u043c\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e \u0456 \u0431\u043b\u0443\u043a\u0430\u043d\u043d\u0435 \u2013 \u0433\u044d\u0442\u0430 \u043f\u0430\u043b\u044b\u043d \u0456 \u0430\u0442\u0440\u0443\u0442\u0430. \u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430 \u0456 \u0437\u0430\u043c\u0456\u0440\u0430\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435. \u042f \u0437\u0433\u0430\u0434\u0432\u0430\u044e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0442\u0430\u043c\u0443 \u043c\u0430\u044e \u043d\u0430\u0434\u0437\u0435\u044e. \u0413\u044d\u0442\u0430 \u043b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456, \u0431\u043e \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u044f \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0410\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0440\u0430\u043d\u0456\u0446\u0443 \u0422\u0432\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c. \u00ab\u041f\u0430\u043d \u2013 \u043c\u043e\u0439 \u043b\u0451\u0441\u00bb, \u2013 \u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430. \u0422\u0430\u043c\u0443 \u044f \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u043d\u0430 \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0434\u043e\u0431\u0440\u044b \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u0447\u0430\u043a\u0430\u0435, \u0434\u0430 \u0434\u0443\u0448\u044b, \u044f\u043a\u0430\u044f \u0448\u0443\u043a\u0430\u0435 \u042f\u0433\u043e. \u0414\u043e\u0431\u0440\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u0443 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0456 \u0440\u0430\u0442\u0443\u043d\u043a\u0443 \u0430\u0434 \u041f\u0430\u043d\u0430. \u0414\u043e\u0431\u0440\u0430, \u043a\u0430\u043b\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u0430 \u043d\u043e\u0441\u0456\u0446\u044c \u044f\u0440\u043c\u043e \u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0442\u043d\u044b \u0456 \u043c\u0430\u045e\u0447\u044b\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0430 \u044f\u0433\u043e \u041f\u0430\u043d \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u0435 \u044f\u0440\u043c\u043e. \u041d\u044f\u0445\u0430\u0439 \u0443\u043a\u043b\u0430\u0434\u0437\u0435 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u045e \u043f\u044b\u043b, \u043c\u043e\u0436\u0430 \u0451\u0441\u0446\u044c \u044f\u0448\u0447\u044d \u043d\u0430\u0434\u0437\u0435\u044f? \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0448\u0447\u0430\u043a\u0443 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0431\u2019\u0435 \u044f\u0433\u043e, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u043d \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435 \u0431\u043e\u043b\u044c, \u0442\u043e \u0456 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456. \u0411\u043e \u043d\u0435 \u0437 \u0432\u043e\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0401\u043d \u0443\u0446\u0456\u0441\u043a\u0430\u0435 \u0456 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0435 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u043b 3, 52. 54b. 56a. 57b. 58; \u0414\u0437 21, 13b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0440\u0430\u0433\u0456 \u043c\u0430\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043b\u0430\u0432\u0456\u043b\u0456 \u043c\u044f\u043d\u0435, \u044f\u043a \u043f\u0442\u0443\u0448\u043a\u0443, \u0431\u0435\u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f: \u0417\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u044f. \u0422\u044b, \u041f\u0430\u043d\u0435, \u043f\u0430\u0447\u0443\u045e \u043c\u043e\u0439 \u043a\u0440\u044b\u043a. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0406 \u0441\u043a\u0430\u0437\u0430\u045e: \u041d\u0435 \u0431\u043e\u0439\u0441\u044f. \u0422\u044b \u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u043c\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u044f \u0433\u0430\u0442\u043e\u0432\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u0446\u044c \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u043c, \u0430\u043b\u0435 \u0456 \u043f\u0430\u043c\u0435\u0440\u0446\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0441\u043a\u0430\u0437\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"237","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041f\u043b\u0430\u0447\u0443 <\/span><span style=\"color: #ff0000;\">5, 1-22<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0430\u0431 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u043f\u043e\u043c\u043d\u0456, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0437 \u043d\u0430\u043c\u0456. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u0456 \u045e\u0431\u0430\u0447 \u043d\u0430\u0448\u0443\u044e \u0433\u0430\u043d\u044c\u0431\u0443. \u041d\u0430\u0448\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0434\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0447\u0443\u0436\u044b\u043c, \u0434\u0430\u043c\u044b \u043d\u0430\u0448\u044b\u044f \u2013 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u043c. \u041c\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0456\u0440\u043e\u0442\u0430\u043c\u0456 \u0431\u0435\u0437 \u0430\u0439\u0446\u0430, \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u0446\u0456 \u2013 \u044f\u043a \u0443\u0434\u043e\u0432\u044b. \u041c\u044b \u043f\u2019\u0435\u043c \u043d\u0430\u0448\u0443\u044e \u0432\u0430\u0434\u0443 \u0437\u0430 \u0441\u0440\u044d\u0431\u0440\u0430, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0437\u0430 \u043f\u043b\u0430\u0442\u0443 \u043d\u0430\u0448\u0443\u044e \u0434\u0440\u0430\u045e\u043d\u0456\u043d\u0443. \u0417 \u044f\u0440\u043c\u043e\u043c \u043d\u0430 \u0448\u044b\u0456 \u043d\u0430\u0441 \u0433\u043d\u0430\u043b\u0456, \u043c\u044b \u0446\u044f\u0436\u043a\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u041c\u044b \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u043b\u0456 \u0440\u0443\u043a\u0443 \u0434\u0430 \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u0410\u0441\u0456\u0440\u044b\u0456, \u043a\u0430\u0431 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u0445\u043b\u0435\u0431\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u0431\u0430\u0446\u044c\u043a\u0456 \u2013 \u0456 \u043d\u044f\u043c\u0430 \u0456\u0445, \u0430 \u043c\u044b \u043d\u044f\u0441\u0451\u043c \u0456\u0445\u043d\u0456\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b. \u0421\u043b\u0443\u0433\u0456 \u043f\u0430\u043d\u0443\u044e\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u043d\u044f\u043c\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0431\u044b \u043d\u0430\u0441 \u0437 \u0456\u0445\u043d\u044f\u0439 \u0440\u0443\u043a\u0456. \u0420\u044b\u0437\u044b\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u043c\u044b \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0445\u043b\u0435\u0431 \u043f\u0435\u0440\u0430\u0434 \u043c\u044f\u0447\u043e\u043c \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u041d\u0430\u0448\u0430\u044f \u0441\u043a\u0443\u0440\u0430 \u0441\u0442\u0430\u043b\u0430 \u0433\u0430\u0440\u0430\u0447\u0430\u0439, \u043d\u0456\u0431\u044b \u043f\u0435\u0447, \u0430\u0434 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0433\u043e\u043b\u0430\u0434\u0443. \u041d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0433\u0432\u0430\u043b\u0442\u0443\u044e\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d, \u0434\u0437\u044f\u045e\u0447\u0430\u0442 \u2013 \u0443 \u0433\u0430\u0440\u0430\u0434\u0430\u0445 \u042e\u0434\u044b. \u041a\u043d\u044f\u0437\u0456 \u0431\u044b\u043b\u0456 \u043f\u0430\u0432\u0435\u0448\u0430\u043d\u044b\u044f \u0456\u0445 \u0440\u0443\u043a\u043e\u044e, \u0434\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0448\u0430\u043d\u044b. \u042e\u043d\u0430\u043a\u0456 \u043d\u0430\u0441\u0456\u043b\u0456 \u0436\u043e\u0440\u043d\u044b, \u0430 \u0445\u043b\u043e\u043f\u0446\u044b \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u0434 \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0434\u0440\u0430\u045e\u043d\u0456\u043d\u044b. \u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0431\u0440\u0430\u043c\u044b, \u0430 \u044e\u043d\u0430\u043a\u0456 \u2013 \u0441\u0432\u0430\u0435 \u0441\u043f\u0435\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043d\u0430\u0448 \u0442\u0430\u043d\u0435\u0446 \u0430\u0431\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0436\u0430\u043b\u043e\u0431\u0443. \u0423\u043f\u0430\u043b\u0430 \u0437 \u043d\u0430\u0448\u0430\u0439 \u0433\u0430\u043b\u0430\u0432\u044b \u043a\u0430\u0440\u043e\u043d\u0430. \u0413\u043e\u0440\u0430 \u043d\u0430\u043c, \u0431\u043e \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456! \u0422\u0430\u043c\u0443 \u0430\u0441\u043b\u0430\u0431\u043b\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0437\u0430\u0446\u043c\u0456\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b, \u0431\u043e \u0433\u0430\u0440\u0430 \u0421\u0456\u0451\u043d \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430, \u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0430 \u0451\u0439 \u0448\u0430\u043a\u0430\u043b\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b, \u041f\u0430\u043d\u0435, \u0442\u0440\u044b\u0432\u0430\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456, \u0441\u044f\u0434\u0437\u0456\u0448 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0441\u0432\u0430\u0456\u043c \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435. \u0427\u0430\u043c\u0443 \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u043d\u0430\u0441 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441 \u043d\u0430 \u0434\u043e\u045e\u0433\u0456\u044f \u0434\u043d\u0456? \u0412\u044f\u0440\u043d\u0456 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0434\u0430 \u0441\u044f\u0431\u0435, \u0456 \u043c\u044b \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f! \u0410\u0434\u043d\u0430\u0432\u0456 \u0434\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u044f\u043a \u0434\u0430\u045e\u043d\u0435\u0439. \u041d\u044f\u045e\u0436\u043e \u0422\u044b \u0437\u0443\u0441\u0456\u043c \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441 \u0456 \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u043d\u0430\u0441?<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u043b 5, 19\u0430. 20\u0430. 21\u0430; \u041c\u0446 8, 25b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b, \u041f\u0430\u043d\u0435, \u0442\u0440\u044b\u0432\u0430\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456. \u0427\u0430\u043c\u0443 \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u043d\u0430\u0441 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b? <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u044f\u0440\u043d\u0456 \u043d\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435, \u0456 \u043c\u044b \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0435, \u0440\u0430\u0442\u0443\u0439, \u043c\u044b \u0433\u0456\u043d\u0435\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044f\u0440\u043d\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"241","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">1, 3-14. 22-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0445\u0432\u0430\u043b\u044b \u041f\u0430\u043d\u0430 \u045e \u0437\u044f\u043c\u043b\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0434\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f, \u0441\u044b\u043d\u0430 \u0411\u0443\u0437\u0456\u0456, \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0443 \u0437\u044f\u043c\u043b\u0456 \u0445\u0430\u043b\u0434\u044d\u0439\u0441\u043a\u0430\u0439, \u043d\u0430\u0434 \u0440\u0430\u043a\u043e\u044e \u041a\u0435\u0431\u0430\u0440, \u0456 \u0431\u044b\u043b\u0430 \u0442\u0430\u043c \u043d\u0430\u0434 \u0456\u043c \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u045e\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0456\u043c\u043a\u043b\u0456\u0432\u044b \u0432\u0435\u0446\u0435\u0440 \u043d\u0430\u043b\u044f\u0446\u0435\u045e \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b, \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0456 \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0430\u0433\u043e\u043d\u044c, \u0430 \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e \u0437\u0437\u044f\u043d\u043d\u0435, \u0456 \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u0430\u0433\u043d\u044e \u043d\u0456\u0431\u044b\u0442\u0430 \u0437\u0437\u044f\u043d\u043d\u0435 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u0433\u0430 \u043c\u0435\u0442\u0430\u043b\u0430. \u0423 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u044f\u0433\u043e \u2013 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u0448\u0442\u043e \u0441\u0432\u0430\u0456\u043c \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043c \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u041a\u043e\u0436\u043d\u0430\u044f \u0437 \u0456\u0445 \u043c\u0435\u043b\u0430 \u043f\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u0442\u0432\u0430\u0440\u044b, \u0456 \u043a\u043e\u0436\u043d\u0430\u044f \u043c\u0435\u043b\u0430 \u043f\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043a\u0440\u044b\u043b\u044b. \u041d\u043e\u0433\u0456 \u0456\u0445\u043d\u0456\u044f \u0431\u044b\u043b\u0456 \u043f\u0440\u0430\u043c\u044b\u044f, \u0430 \u0441\u0442\u0443\u043f\u043d\u0456 \u0456\u0445\u043d\u0456\u0445 \u043d\u043e\u0433 \u0431\u044b\u043b\u0456 \u044f\u043a \u0443 \u0446\u044f\u043b\u044c\u0446\u0430, \u0456 \u0437\u0437\u044f\u043b\u0456 \u044f\u043d\u044b, \u044f\u043a \u0430\u0434\u043f\u0430\u043b\u0456\u0440\u0430\u0432\u0430\u043d\u0430\u044f \u043c\u0435\u0434\u0437\u044c. \u0410 \u043f\u0430\u0434 \u0456\u0445\u043d\u0456\u043c\u0456 \u043a\u0440\u044b\u043b\u0430\u043c\u0456 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0431\u0430\u043a\u043e\u045e \u0431\u044b\u043b\u0456 \u045e \u0456\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0440\u0443\u043a\u0456. \u0412\u0430 \u045e\u0441\u0456\u0445 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0431\u044b\u043b\u0456 \u0441\u0432\u0430\u0435 \u0442\u0432\u0430\u0440\u044b \u0456 \u0441\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u044b. \u041a\u043e\u0436\u043d\u0430\u0435 \u0437 \u0456\u0445 \u043a\u0440\u044b\u043b\u0430\u045e \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0430\u0441\u044f \u0430\u0434\u043d\u043e \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e. \u041a\u0430\u043b\u0456 \u0456\u0448\u043b\u0456, \u043d\u0435 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u043b\u0456\u0441\u044f, \u043a\u043e\u0436\u043d\u0430\u044f \u0456\u0448\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e.<\/span><span style=\"text-decoration: underline;\"><\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430 \u045e\u0441\u0456\u0445 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u0434\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0434\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043b\u044c\u0432\u0430, \u0437\u043b\u0435\u0432\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u2013 \u0434\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0432\u0430\u043b\u0430 \u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0430\u0440\u043b\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0447\u0430\u0442\u044b\u0440\u043e\u0445. \u0406\u0445 \u0442\u0432\u0430\u0440\u044b \u0456 \u043a\u0440\u044b\u043b\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043d\u044f\u0442\u044b\u044f \u045e\u0433\u0430\u0440\u0443. \u0414\u0432\u0430 \u043a\u0440\u044b\u043b\u044b \u043a\u043e\u0436\u043d\u0430\u0439 \u0437 \u0456\u0445 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u0430\u0434\u043d\u043e \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u0456 \u0434\u0432\u0430 \u0456\u043d\u0448\u044b\u044f \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u0456\u0445 \u0446\u0435\u043b\u044b. \u041a\u043e\u0436\u043d\u0430\u044f \u0456\u0448\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e. \u0406\u0448\u043b\u0430 \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u0456\u0448\u043e\u045e \u0434\u0443\u0445. \u0406 \u043d\u0435 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u043b\u0456 \u0456\u0448\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b\u0433\u043b\u044f\u0434 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442\u0430\u045e \u0431\u044b\u045e \u043d\u0456\u0431\u044b \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0435 \u045e \u0430\u0433\u043d\u0456 \u0432\u0443\u0433\u043e\u043b\u043b\u0435, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043f\u0430\u0445\u043e\u0434\u043d\u044f\u045e. \u0413\u044d\u0442\u044b \u0430\u0433\u043e\u043d\u044c \u0440\u0443\u0445\u0430\u045e\u0441\u044f \u043f\u0430\u043c\u0456\u0436 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442\u0430\u045e, \u0451\u043d \u043c\u0435\u045e \u0443 \u0441\u0430\u0431\u0435 \u0431\u043b\u044f\u0441\u043a, \u0456 \u043c\u0430\u043b\u0430\u043d\u043a\u0430 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u044f\u0433\u043e. \u0410 \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u0431\u0435\u0433\u0430\u043b\u0456 \u0456 \u0432\u044f\u0440\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u043c\u0430\u043b\u0430\u043d\u0446\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0434 \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442\u0430\u045e \u0431\u044b\u043b\u043e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u044f \u043d\u0435\u0431\u0430, \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u044f\u043a \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c, \u0448\u0442\u043e \u043d\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0436\u0430\u0445, \u0456 \u0431\u044b\u043b\u043e \u044f\u043d\u043e \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u0442\u0430 \u045e\u0433\u0430\u0440\u044b \u043d\u0430\u0434 \u0456\u0445 \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456. \u041f\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u0435\u043c \u0431\u044b\u043b\u0456 \u0456\u0445 \u0432\u044b\u043f\u0440\u0430\u0441\u0442\u0430\u043d\u044b\u044f \u043a\u0440\u044b\u043b\u044b, \u043a\u043e\u0436\u043d\u0430\u0435 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0440\u0443\u0433\u043e\u0433\u0430. \u041a\u043e\u0436\u043d\u0430\u044f \u0437 \u0456\u0445 \u0434\u0432\u0443\u043c\u0430 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0430 \u0441\u044f\u0431\u0435, \u0456 \u043a\u043e\u0436\u043d\u0430\u044f \u0437 \u0456\u0445 \u0434\u0432\u0443\u043c\u0430 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0430 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0447\u0443\u045e \u0448\u0443\u043c \u0456\u0445 \u043a\u0440\u044b\u043b\u0430\u045e, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0456\u0448\u043b\u0456. \u0401\u043d \u0431\u044b\u045e \u043d\u0456\u0431\u044b \u0448\u0443\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0432\u043e\u0434\u0430\u045e, \u043d\u0456\u0431\u044b \u0433\u043e\u043b\u0430\u0441 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u044f\u043a \u0448\u0443\u043c \u043d\u0430\u0442\u043e\u045e\u043f\u0443, \u044f\u043a \u0433\u0443\u043b \u0432\u0430\u0435\u043d\u043d\u0430\u0433\u0430 \u043b\u0430\u0433\u0435\u0440\u0430. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u043f\u044b\u043d\u044f\u043b\u0456\u0441\u044f, \u0430\u043f\u0443\u0441\u043a\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u044b. \u0406 \u0447\u0443\u045e\u0441\u044f \u0433\u043e\u043b\u0430\u0441 \u0437-\u043d\u0430\u0434 \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u044f, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u0434 \u0456\u0445\u043d\u0456\u043c\u0456 \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u043f\u044b\u043d\u044f\u043b\u0456\u0441\u044f, \u0430\u043f\u0443\u0441\u043a\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0434 \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u0435\u043c, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u0434 \u0456\u0445 \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456, \u0441\u0442\u0430\u044f\u043b\u0430 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0442\u0440\u043e\u043d\u0430 \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u043a\u0430\u043c\u0435\u043d\u044f \u0441\u0430\u043f\u0444\u0456\u0440\u0443. \u0410 \u045e\u0432\u0435\u0440\u0441\u0435 \u043d\u0430\u0434 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0442\u0440\u043e\u043d\u0430 \u0431\u044b\u043b\u043e \u044f\u043a \u0431\u044b \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u043d\u0435\u0448\u0442\u0430 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u0433\u0430 \u043c\u0435\u0442\u0430\u043b\u0430, \u0448\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043b\u0430 \u044f\u043a \u0430\u0433\u043e\u043d\u044c \u0443\u043d\u0443\u0442\u0440\u044b \u0456 \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e. \u0423\u0432\u0435\u0440\u0441\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0456 \u045e\u043d\u0456\u0437\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445, \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u044f\u043a \u0430\u0433\u043e\u043d\u044c, \u0430 \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u043e. \u042f\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0432\u044f\u0441\u0451\u043b\u043a\u0430, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u043f\u0430\u0434\u0447\u0430\u0441 \u0434\u0430\u0436\u0434\u0436\u0443, \u0442\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043b\u0430 \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e \u0437\u0437\u044f\u043d\u043d\u0435. \u0412\u044b\u0433\u043b\u044f\u0434 \u044f\u0433\u043e \u0431\u044b\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0437\u0445 1, 26; 3, 12b; \u0410\u043f 5, 13b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0442\u0440\u043e\u043d\u0430, \u0430 \u045e\u0432\u0435\u0440\u0441\u0435 \u044f\u043a \u0431\u044b \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u043f\u0430\u0447\u0443\u045e \u044f \u0430\u0434\u0433\u0430\u043b\u043e\u0441\u043a\u0456 \u043d\u0456\u0431\u044b \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0433\u0440\u044b\u043c\u043e\u0442\u0430\u045e: <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443 \u2013 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u0445\u0432\u0430\u043b\u0430, \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"242","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">2, 8 \u2013 3, 11. 16-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0410 \u0442\u044b, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u042f \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u0431\u0443\u043d\u0442\u0430\u0440\u043e\u043c, \u044f\u043a \u0433\u044d\u0442\u044b \u0434\u043e\u043c \u0431\u0443\u043d\u0442\u0443. \u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0456 \u0437\u2019\u0435\u0448, \u0448\u0442\u043e \u042f \u0434\u0430\u044e \u0442\u0430\u0431\u0435\u00bb. \u042f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e, \u0456 \u0432\u043e\u0441\u044c \u0440\u0443\u043a\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u0442\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435, \u0430 \u045e \u0451\u0439 \u2013 \u0441\u043a\u0440\u0443\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456. \u0401\u043d \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u045e \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e. \u0410 \u0441\u043a\u0440\u0443\u0442\u0430\u043a \u0431\u044b\u045e \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b <\/span><span style=\"text-decoration: line-through;\">\u0437 <\/span><span>\u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443 \u0456 \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443. \u0423 \u0456\u043c \u0431\u044b\u043b\u0456 \u0441\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u0433\u0456, \u0436\u0430\u043b\u044c \u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0437\u2019\u0435\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. \u0417\u2019\u0435\u0448 \u0433\u044d\u0442\u044b \u0441\u043a\u0440\u0443\u0442\u0430\u043a \u0434\u044b \u0456\u0434\u0437\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb. \u041a\u0430\u043b\u0456 \u044f \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b, \u0401\u043d \u0434\u0430\u045e \u043c\u043d\u0435 \u0437\u2019\u0435\u0441\u0446\u0456 \u0433\u044d\u0442\u044b \u0441\u043a\u0440\u0443\u0442\u0430\u043a. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043d\u0430\u043a\u0430\u0440\u043c\u0456 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u0441\u0432\u0430\u0451 \u043d\u0443\u0442\u0440\u043e \u0433\u044d\u0442\u044b\u043c \u0441\u043a\u0440\u0443\u0442\u043a\u0430\u043c, \u044f\u043a\u0456 \u042f \u0434\u0430\u044e \u0442\u0430\u0431\u0435\u00bb. \u0406 \u044f \u0437\u2019\u0435\u045e, \u0430 \u0451\u043d \u0431\u044b\u045e \u0441\u0430\u043b\u043e\u0434\u043a\u0456, \u044f\u043a \u043c\u0451\u0434, \u0443 \u043c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445. \u0410 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0456\u0434\u0437\u0456, \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u0439\u0441\u044f \u0434\u0430 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456 \u0456\u043c \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b. \u0411\u043e \u0442\u044b \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u043d\u0435 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u043d\u0435\u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430\u0439 \u043c\u043e\u0432\u0430\u0439 \u0456 \u0446\u044f\u0436\u043a\u0456\u043c \u044f\u0437\u044b\u043a\u043e\u043c, \u0430\u043b\u0435 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041d\u0435 \u0434\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0437 \u043d\u0435\u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430\u0439 \u043c\u043e\u0432\u0430\u0439 \u0456 \u0446\u044f\u0436\u043a\u0456\u043c \u044f\u0437\u044b\u043a\u043e\u043c, \u0447\u044b\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0442\u044b \u043d\u0435 \u0447\u0443\u045e. \u041a\u0430\u043b\u0456 \u0431 \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u0446\u044f\u0431\u0435 \u0434\u0430 \u0456\u0445, \u044f\u043d\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u0431 \u0446\u044f\u0431\u0435! \u0410\u043b\u0435 \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0435 \u0437\u0430\u0445\u043e\u0447\u0430 \u0446\u044f\u0431\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u044c, \u0431\u043e \u044f\u043d\u044b \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0446\u0432\u0435\u0440\u0434\u0430\u043b\u043e\u0431\u044b, \u044f\u043d\u044b \u043c\u0430\u044e\u0446\u044c \u0441\u043a\u0430\u043c\u044f\u043d\u0435\u043b\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043c\u0443 \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0432\u043e\u0439 \u0442\u0432\u0430\u0440 \u0442\u0430\u043a\u0456\u043c \u0436\u0430 \u0446\u0432\u0451\u0440\u0434\u044b\u043c, \u044f\u043a \u0456\u0445\u043d\u0456\u044f \u0442\u0432\u0430\u0440\u044b, \u0456 \u0442\u0432\u043e\u0439 \u043b\u043e\u0431 \u0446\u0432\u0451\u0440\u0434\u044b\u043c, \u044f\u043a \u0456\u0445\u043d\u0456\u044f \u0456\u043b\u0431\u044b. \u042f\u043a \u0434\u044b\u044f\u043c\u0435\u043d\u0442, \u0446\u0432\u044f\u0440\u0434\u0437\u0435\u0439\u0448\u044b\u043c \u0437\u0430 \u043a\u0440\u044d\u043c\u0435\u043d\u044c \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0432\u0430\u0451 \u0447\u0430\u043b\u043e. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445 \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0441\u044f \u0456\u0445\u043d\u044f\u0433\u0430 \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u0431\u043e \u044f\u043d\u044b \u2013 \u0434\u043e\u043c \u0431\u0443\u043d\u0442\u0443\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0443\u0441\u0435 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u042f \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u043f\u0440\u044b\u043c\u0456 \u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0443\u0448\u0430\u043c\u0456. \u0406\u0434\u0437\u0456, \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u0439\u0441\u044f \u0434\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u045e, \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439 \u0434\u0430 \u0456\u0445 \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u201c\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433\u201d, \u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043d\u044b \u0441\u043b\u0443\u0445\u0430\u0446\u044c, \u0446\u0456 \u0430\u0434\u043c\u043e\u0432\u044f\u0446\u0446\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043c\u0456\u043d\u0443\u043b\u0430 \u0441\u0435\u043c \u0434\u0437\u0451\u043d, \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435\u0448 \u0441\u043b\u043e\u0432\u0430 \u0437 \u041c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e, \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0456\u0445 \u0430\u0434 \u041c\u0430\u0439\u0433\u043e \u0456\u043c\u044f. \u041a\u0430\u043b\u0456 \u042f \u0441\u043a\u0430\u0436\u0443 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u043c\u0443: \u201c\u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0430\u043c\u0440\u044d\u0448\u201d, \u0430 \u0442\u044b \u043d\u0435 \u0430\u0441\u0446\u0435\u0440\u0430\u0436\u044d\u0448 \u044f\u0433\u043e \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430\u0448, \u043a\u0430\u0431 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u0430\u0434 \u044f\u0433\u043e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e, \u043a\u0430\u0431 \u0451\u043d \u0436\u044b\u045e, \u0442\u043e \u0433\u044d\u0442\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a \u043f\u0430\u043c\u0440\u044d \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u0456\u043d\u044b, \u0430\u043b\u0435 \u0437\u0430 \u044f\u0433\u043e\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u042f \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u0437 \u0446\u044f\u0431\u0435. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0442\u044b \u0430\u0441\u0446\u0435\u0440\u0430\u0436\u044d\u0448 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430, \u0430 \u0451\u043d \u043d\u0435 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e, \u0451\u043d \u043f\u0430\u043c\u0440\u044d \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u0456\u043d\u044b, \u0430\u043b\u0435 \u0442\u044b \u045e\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u0442\u043e \u042f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0443, \u0456 \u0451\u043d \u043f\u0430\u043c\u0440\u044d, \u0431\u043e \u0442\u044b \u043d\u0435 \u0430\u0441\u0446\u044f\u0440\u043e\u0433 \u044f\u0433\u043e \u0430\u0434 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443. \u0401\u043d \u043f\u0430\u043c\u0440\u044d, \u0456 \u044f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u0440\u0430\u0431\u0456\u045e, \u0437\u0430\u0431\u0443\u0434\u0443\u0446\u0446\u0430, \u0430 \u0437\u0430 \u044f\u0433\u043e\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u042f \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u0437 \u0446\u044f\u0431\u0435. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0442\u044b \u0430\u0441\u0446\u0435\u0440\u0430\u0436\u044d\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u045e, \u0456 \u0451\u043d \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0442\u043e \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c, \u0431\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0441\u0446\u044f\u0440\u043e\u0433\u0456, \u0430 \u0442\u044b \u045e\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 3, 17; \u043f\u0430\u0440. 2, 6\u0430; 3, 8<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435\u0448 \u0441\u043b\u043e\u0432\u0430 \u0437 \u041c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e, \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0456\u0445 \u0430\u0434 \u041c\u0430\u0439\u0433\u043e \u0456\u043c\u044f. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445 \u0456 \u0441\u043b\u043e\u0432\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043d\u0435 \u0431\u043e\u0439\u0441\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0432\u043e\u0439 \u0442\u0432\u0430\u0440 \u0442\u0430\u043a\u0456\u043c \u0436\u0430 \u0446\u0432\u0451\u0440\u0434\u044b\u043c, \u044f\u043a \u0456\u0445\u043d\u0456\u044f \u0442\u0432\u0430\u0440\u044b, \u0456 \u0442\u0432\u043e\u0439 \u043b\u043e\u0431 \u0446\u0432\u0451\u0440\u0434\u044b\u043c, \u044f\u043a \u0456\u0445\u043d\u0456\u044f \u0456\u043b\u0431\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0435 \u0431\u043e\u0439\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"243","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">8, 1-6. 16 \u2013 9, 11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0443\u0434 \u043d\u0430\u0434 \u0433\u0440\u044d\u0448\u043d\u044b\u043c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0448\u043e\u0441\u0442\u044b\u043c \u0433\u043e\u0434\u0437\u0435, \u0443 \u043f\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0448\u043e\u0441\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u044f \u0441\u044f\u0434\u0437\u0435\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435, \u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u042e\u0434\u044b \u0441\u044f\u0434\u0437\u0435\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e. \u0406 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u0442\u0430\u043c \u0434\u0430 \u043c\u044f\u043d\u0435 \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0430\u0433\u043d\u044f. \u0423\u043d\u0456\u0437\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043b\u0430 \u044f\u043a \u044f\u0433\u043e \u0441\u0446\u0451\u0433\u043d\u044b, \u0431\u044b\u045e \u0430\u0433\u043e\u043d\u044c, \u0430 \u045e\u0432\u0435\u0440\u0441\u0435 \u0430\u0434 \u044f\u0433\u043e \u0441\u0446\u0451\u0433\u043d\u0430\u045e \u0431\u044b\u043b\u043e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0437\u0437\u044f\u043d\u043d\u044f \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u0433\u0430 \u043c\u0435\u0442\u0430\u043b\u0443. \u0401\u043d \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0440\u0443\u043a\u0456 \u0456 \u0441\u0445\u0430\u043f\u0456\u045e \u043c\u044f\u043d\u0435 \u0437\u0430 \u0432\u0430\u043b\u0430\u0441\u044b \u043d\u0430 \u043c\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u0435. \u0414\u0443\u0445 \u0443\u0437\u043d\u044f\u045e \u043c\u044f\u043d\u0435 \u043f\u0430\u043c\u0456\u0436 \u0437\u044f\u043c\u043b\u0451\u0439 \u0456 \u043d\u044f\u0431\u0451\u0441\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u045e \u0411\u043e\u0436\u044b\u0445 \u0432\u0456\u0437\u0456\u044f\u0445 \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0434\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0439 \u0431\u0440\u0430\u043c\u044b, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0443\u044e \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447, \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0431\u044b\u043b\u043e \u043c\u0435\u0441\u0446\u0430 \u0456\u0434\u0430\u043b\u0430 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0430\u0431\u0443\u0434\u0436\u0430\u045e \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0431\u044b\u043b\u0430 \u0442\u0430\u043c \u0441\u043b\u0430\u0432\u0430 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u0442\u043e\u0439, \u044f\u043a\u0443\u044e \u044f \u0431\u0430\u0447\u044b\u045e \u0443 \u0434\u0430\u043b\u0456\u043d\u0435. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0440\u0430\u0448\u0443, \u043f\u0430\u0434\u044b\u043c\u0456 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u045e \u043a\u0456\u0440\u0443\u043d\u043a\u0443 \u043f\u043e\u045e\u043d\u0430\u0447\u044b!\u00bb \u0410 \u043a\u0430\u043b\u0456 \u044f \u043f\u0430\u0434\u043d\u044f\u045e \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u045e \u043a\u0456\u0440\u0443\u043d\u043a\u0443 \u043f\u043e\u045e\u043d\u0430\u0447\u044b, \u0442\u043e \u0432\u043e\u0441\u044c \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u0430\u0434 \u0431\u0440\u0430\u043c\u044b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0441\u0442\u0430\u044f\u045e \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u0433\u044d\u0442\u044b \u0456\u0434\u0430\u043b \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0411\u043e\u0433: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0446\u0456 \u0431\u0430\u0447\u044b\u0448 \u0442\u044b, \u0448\u0442\u043e \u044f\u043d\u044b \u0440\u043e\u0431\u044f\u0446\u044c? \u0412\u044f\u043b\u0456\u043a\u0443\u044e \u0431\u0440\u044b\u0434\u043e\u0442\u0443, \u044f\u043a\u0443\u044e \u0442\u0443\u0442 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456? \u0410\u043b\u0435 \u0442\u044b \u0437\u043d\u043e\u045e \u0443\u0431\u0430\u0447\u044b\u0448 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0431\u0440\u044b\u0434\u043e\u0442\u0443\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043f\u0440\u044b\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430. \u0410 \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d\u0430, \u043f\u0430\u043c\u0456\u0436 \u0431\u0430\u0431\u0456\u043d\u0446\u0430\u043c \u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c, \u0431\u044b\u043b\u043e \u043a\u0430\u043b\u044f \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u044f\u0446\u0456 \u043c\u0443\u0436\u043e\u045e. \u042f\u043d\u044b \u0441\u0442\u0430\u044f\u043b\u0456 \u043f\u043b\u044f\u0447\u044b\u043c\u0430 \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430, \u0430 \u0442\u0432\u0430\u0440\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u2013 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434, \u0456 \u043d\u0456\u0437\u043a\u0430 \u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u043d\u0430 \u045e\u0441\u0445\u043e\u0434, \u0441\u043e\u043d\u0446\u0443. \u0406 \u0441\u043f\u044b\u0442\u0430\u045e \u0401\u043d \u043c\u044f\u043d\u0435: \u00ab\u0428\u0442\u043e \u0442\u044b \u0431\u0430\u0447\u044b\u0448, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b? \u0426\u0456 \u043d\u0435 \u0445\u043e\u043f\u0456\u0446\u044c \u0434\u043e\u043c\u0443 \u042e\u0434\u044b \u0440\u0430\u0431\u0456\u0446\u044c \u0431\u0440\u044b\u0434\u043e\u0442\u0443, \u044f\u043a\u0443\u044e \u0442\u0443\u0442 \u0440\u043e\u0431\u044f\u0446\u044c? \u0411\u043e \u044f\u043d\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u0437\u044f\u043c\u043b\u044e \u0433\u0432\u0430\u043b\u0442\u0430\u043c \u0456 \u0437\u043d\u043e\u045e \u0434\u0440\u0430\u0436\u043d\u044f\u0446\u044c \u041c\u044f\u043d\u0435, \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u044e\u0447\u044b \u0433\u0430\u043b\u0456\u043d\u043a\u0443 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u0441\u043e\u045e. \u0422\u0430\u043c\u0443 \u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u045e \u0433\u043d\u0435\u0432\u0435. \u041d\u0435 \u0437\u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u041c\u0430\u0451 \u0432\u043e\u043a\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u043e\u0446\u043d\u0430 \u0433\u0443\u043a\u0430\u0446\u044c \u0443 \u041c\u0430\u0435 \u0432\u0443\u0448\u044b, \u0430\u043b\u0435 \u042f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0456\u0445 \u0441\u043b\u0443\u0445\u0430\u0446\u044c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0406 \u0401\u043d \u0433\u043e\u043b\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043d\u0443\u045e \u0434\u0430 \u043c\u0430\u0456\u0445 \u0432\u0443\u0448\u044d\u0439, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041d\u0430\u0431\u043b\u0456\u0437\u044c\u0446\u0435\u0441\u044f, \u043a\u0430\u0440\u043d\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434\u0430, \u043a\u043e\u0436\u043d\u044b \u0441\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0439 \u0437\u0431\u0440\u043e\u044f\u0439 \u0443 \u0440\u0443\u043a\u0430\u0445\u00bb. \u0406 \u0432\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0448\u044d\u0441\u0446\u044c \u043c\u0443\u0436\u043e\u045e \u0437 \u0434\u0430\u0440\u043e\u0433\u0456 \u0434\u0430 \u0412\u0435\u0440\u0445\u043d\u044f\u0439 \u0431\u0440\u0430\u043c\u044b, \u0448\u0442\u043e \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0430 \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447, \u0456 \u043a\u043e\u0436\u043d\u044b \u043c\u0435\u045e \u0443 \u0440\u0443\u0446\u044d \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u0437\u0431\u0440\u043e\u044e. \u0411\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0430\u0434\u0437\u0456\u043d \u043c\u0443\u0436, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u043e\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0437 \u0440\u0430\u0436\u043a\u043e\u043c \u043f\u0456\u0441\u0430\u0440\u0430 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u0446\u0451\u0433\u043d\u0430\u0445. \u042f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0456 \u0441\u043f\u044b\u043d\u0456\u043b\u0456\u0441\u044f \u043a\u0430\u043b\u044f \u043c\u0435\u0434\u043d\u0430\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430, \u0430 \u0445\u0432\u0430\u043b\u0430 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u043b\u0430\u0441\u044f \u0437-\u043d\u0430\u0434 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0431\u044b\u043b\u0430, \u0434\u0430 \u043f\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u0433\u0430 \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u043e\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u044f\u043a\u0456 \u043c\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u0440\u0430\u0436\u043e\u043a \u043f\u0456\u0441\u0430\u0440\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u041f\u0440\u0430\u0439\u0434\u0437\u0456 \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0433\u043e\u0440\u0430\u0434\u0430, \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u043f\u0430\u0441\u0442\u0430\u045e \u0437\u043d\u0430\u043a \u201c\u0442\u0430\u045e\u201d \u043d\u0430 \u0447\u043e\u043b\u0430\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u045e\u0437\u0434\u044b\u0445\u0430\u044e\u0446\u044c, \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u0430\u0439, \u0448\u0442\u043e \u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u0456\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u042f \u0447\u0443\u045e, \u044f\u043a \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043d\u0448\u044b\u043c: \u00ab\u0406\u0434\u0437\u0456\u0446\u0435 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0456\u043c \u043f\u0430 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u0439\u0446\u0435, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043b\u0456\u0442\u0430\u0441\u0446\u0456 \u045e \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445. \u041d\u0435 \u0448\u043a\u0430\u0434\u0443\u0439\u0446\u0435. \u0412\u044b\u043d\u0456\u0448\u0447\u0430\u0439\u0446\u0435 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u0430\u0433\u0430, \u044e\u043d\u0430\u043a\u0430 \u0456 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0443, \u043c\u0430\u043b\u043e\u0435 \u0434\u0437\u0456\u0446\u044f \u0456 \u0436\u0430\u043d\u0447\u044b\u043d. \u0410\u0434\u043d\u0430\u043a \u0434\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0437\u043d\u0430\u043a \u201c\u0442\u0430\u045e\u201d, \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0439\u0446\u0435\u0441\u044f. \u041f\u0430\u0447\u043d\u0456\u0446\u0435 \u0437 \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0406 \u044f\u043d\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: \u00ab\u0410\u043f\u0430\u0433\u0430\u043d\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0435 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u0437\u0430\u0431\u0456\u0442\u044b\u043c\u0456. \u0412\u044b\u0439\u0434\u0437\u0456\u0446\u0435!\u00bb \u042f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0456\u0445 \u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456, \u044f \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0441\u0430\u043c, \u0443\u043f\u0430\u045e \u043d\u0430 \u0442\u0432\u0430\u0440 \u0456 \u043a\u0440\u044b\u0447\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041e \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430! \u041d\u044f\u045e\u0436\u043e \u0422\u044b \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0448 \u0443\u0441\u044e \u0440\u044d\u0448\u0442\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0432\u044b\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u043e\u0439 \u0433\u043d\u0435\u045e \u043d\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c?\u00bb \u0410 \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0413\u0440\u044d\u0445 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042e\u0434\u044b \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0456. \u0417\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u043a\u0440\u044b\u0432\u0451\u044e, \u0430 \u0433\u043e\u0440\u0430\u0434 \u043f\u043e\u045e\u043d\u044b \u043a\u0440\u044b\u045e\u0434\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043a\u0430\u0436\u0443\u0446\u044c: \u201c\u041f\u0430\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u041f\u0430\u043d \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c!\u201d \u0422\u0430\u043c\u0443 \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u043b\u0456\u0442\u0430\u0441\u0446\u0456 \u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445, \u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u044e. \u0406\u0445\u043d\u0456\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u042f \u045e\u0441\u043a\u043b\u0430\u0434\u0443 \u0456\u043c \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0432\u043e\u0441\u044c \u043c\u0443\u0436, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u043e\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u044f\u043a\u0456 \u043c\u0435\u045e \u0440\u0430\u0436\u043e\u043a \u043f\u0456\u0441\u0430\u0440\u0430 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u0446\u0451\u0433\u043d\u0430\u0445, \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451 \u0442\u0430\u043a, \u044f\u043a \u0422\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 24, 15. 21\u0430. 22; \u0410\u043f 7, 3<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u0443\u0431\u0430\u0447\u044b\u0446\u0435 \u0430\u0433\u0456\u0434\u0443 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u043d\u0443\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0443\u0433\u0430, \u0456 \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0441\u043a\u0430\u0440\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u0442\u044b\u044f \u0434\u043d\u0456, \u043d\u0435 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0410\u043b\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0441\u043a\u0430\u0440\u043e\u0446\u044f\u0446\u0446\u0430 \u0434\u043d\u0456 \u0433\u044d\u0442\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0447\u044b\u043d\u0456\u0446\u0435 \u0437\u043b\u043e \u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u043d\u0456 \u043c\u043e\u0440\u0443, \u043d\u0456 \u0434\u0440\u044d\u0432\u0430\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u043d\u0435 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043c \u043f\u044f\u0447\u0430\u0442\u043a\u0456 \u0441\u043b\u0443\u0433\u0430\u043c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430 \u0456\u0445\u043d\u0456\u0445 \u0447\u043e\u043b\u0430\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"244","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">10, 18-22; 11, 14-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u0433\u043e\u0440\u0430\u0434<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0425\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0430\u0434\u044b\u0448\u043b\u0430 \u0430\u0434 \u043f\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u0434 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u043c\u0456. \u0410 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u044b, \u0443\u0437\u043d\u044f\u045e\u0448\u044b \u0441\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u044b, \u043f\u0430\u0434\u043d\u044f\u043b\u0456\u0441\u044f \u0437 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430 \u043c\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445. \u041a\u0430\u043b\u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456\u0448\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456. \u041f\u0430\u0441\u043b\u044f \u044f\u043d\u044b \u0441\u043f\u044b\u043d\u0456\u043b\u0456\u0441\u044f \u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u0432\u0430 \u045e\u0441\u0445\u043e\u0434\u043d\u044e\u044e \u0431\u0440\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430, \u0456 \u0445\u0432\u0430\u043b\u0430 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u044b\u043b\u0430 \u045e\u0433\u0430\u0440\u044b \u043d\u0430\u0434 \u0456\u043c\u0456. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u0430 \u0442\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430, \u044f\u043a\u0443\u044e \u044f \u0431\u0430\u0447\u044b\u045e \u043f\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430\u0434 \u0440\u0430\u043a\u043e\u044e \u041a\u0435\u0431\u0430\u0440, \u0456 \u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u2013 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u044b. \u0423 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0431\u044b\u043b\u043e \u043f\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u0442\u0432\u0430\u0440\u044b, \u043a\u043e\u0436\u043d\u044b \u043c\u0435\u045e \u043f\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043a\u0440\u044b\u043b\u044b \u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0440\u0443\u043a \u0431\u044b\u043b\u043e \u043f\u0430\u0434 \u0456\u0445\u043d\u0456\u043c\u0456 \u043a\u0440\u044b\u043b\u0430\u043c\u0456. \u0410 \u0432\u044b\u0433\u043b\u044f\u0434 \u0456\u0445\u043d\u0456\u0445 \u0442\u0432\u0430\u0440\u0430\u045e \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u045e \u0442\u044b\u044f, \u0448\u0442\u043e \u044f \u0431\u0430\u0447\u044b\u045e \u043d\u0430\u0434 \u0440\u0430\u043a\u043e\u044e \u041a\u0435\u0431\u0430\u0440. \u041a\u043e\u0436\u043d\u044b \u0456\u0448\u043e\u045e \u043f\u0440\u043e\u0441\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u041f\u0430\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0431\u0440\u0430\u0442\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0442\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u0442\u0432\u0430\u0456\u043c \u0440\u043e\u0434\u043d\u044b\u043c \u0456 \u045e\u0441\u044f\u043c\u0443 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0443\u0441\u0456\u0445 \u0456\u043c \u0436\u044b\u0445\u0430\u0440\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u043a\u0430\u0436\u0443\u0446\u044c: \u201c\u0410\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430. \u0417\u044f\u043c\u043b\u044f \u0433\u044d\u0442\u0430\u044f \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c\u201d. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b: \u201c\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0425\u043e\u0446\u044c \u042f \u0432\u044b\u0433\u043d\u0430\u045e \u0456\u0445 \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u043f\u0430 \u0437\u0435\u043c\u043b\u044f\u0445, \u0430\u0434\u043d\u0430\u043a \u0431\u0443\u0434\u0443 \u043d\u0430 \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u0441 \u0434\u043b\u044f \u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0443 \u0442\u044b\u0445 \u0437\u0435\u043c\u043b\u044f\u0445, \u043a\u0443\u0434\u044b \u044f\u043d\u044b \u045e\u0432\u0430\u0439\u0448\u043b\u0456. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b: \u2018\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u041f\u0430\u0437\u0431\u0456\u0440\u0430\u044e \u0432\u0430\u0441 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0437\u0430\u0431\u044f\u0440\u0443 \u0432\u0430\u0441 \u0437 \u0437\u0435\u043c\u043b\u044f\u045e, \u043f\u0430 \u044f\u043a\u0456\u0445 \u0432\u044b \u0431\u044b\u043b\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b, \u0456 \u0434\u0430\u043c \u0432\u0430\u043c \u0437\u044f\u043c\u043b\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f\u043d\u044b \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0442\u0443\u0434\u044b \u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u0446\u044c \u0443\u0441\u0456\u0445 \u044f\u0435 \u0456\u0434\u0430\u043b\u0430\u045e \u0456 \u045e\u0441\u044e \u044f\u0435 \u0431\u0440\u044b\u0434\u043e\u0442\u0443. \u042f \u0434\u0430\u043c \u0456\u043c \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u043e\u0432\u044b \u0434\u0443\u0445 \u0443\u043a\u043b\u0430\u0434\u0443 \u045e \u0456\u0445 \u043d\u0443\u0442\u0440\u043e. \u0412\u044b\u043c\u0443 \u0441\u044d\u0440\u0446\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0435 \u0437 \u0456\u0445 \u0446\u0435\u043b\u0430, \u0430 \u0434\u0430\u043c \u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043c\u0430\u0456\u043c\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043c\u0456, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u043c\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0456\u0445. \u0422\u0430\u043a \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043d\u044b \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c. \u0410 \u0448\u0442\u043e \u0434\u0430 \u0442\u044b\u0445, \u0447\u044b\u0451 \u0441\u044d\u0440\u0446\u0430 \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u0456\u0434\u0430\u043b\u0430\u045e \u0456 \u0431\u0440\u044b\u0434\u043e\u0442\u044b, \u0442\u043e \u0456\u0445 \u045e\u0447\u044b\u043d\u043a\u0456 \u042f \u045e\u0441\u043a\u043b\u0430\u0434\u0443 \u0456\u043c \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0435\u0440\u0443\u0431\u0456\u043c\u044b \u045e\u0437\u043d\u044f\u043b\u0456 \u0441\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u044b, \u0430 \u043a\u043e\u043b\u044b \u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456, \u0445\u0432\u0430\u043b\u0430 \u0436 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u044b\u043b\u0430 \u045e\u0433\u0430\u0440\u044b \u043d\u0430\u0434 \u0456\u043c\u0456. \u0406 \u0430\u0434\u044b\u0448\u043b\u0430 \u0445\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u0433\u043e\u0440\u0430\u0434\u0430 \u0456 \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u044b, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434\u0437\u0435 \u0433\u043e\u0440\u0430\u0434\u0430. \u0422\u0430\u0434\u044b \u0434\u0443\u0445 \u043f\u0430\u0434\u043d\u044f\u045e \u043c\u044f\u043d\u0435 \u0456 \u043f\u0435\u0440\u0430\u043d\u0451\u0441 \u0443 \u0431\u0430\u0447\u0430\u043d\u043d\u0456, \u0443 \u0411\u043e\u0436\u044b\u043c \u0434\u0443\u0445\u0443, \u0443 \u0425\u0430\u043b\u0434\u044d\u044e, \u0434\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u045e. \u041f\u0430\u0441\u043b\u044f \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0437\u043d\u0456\u043a\u043b\u0430. \u042f \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u043c \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u044f\u043a\u0456\u044f \u0401\u043d \u043c\u043d\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u045e.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 10, 4. 18\u0430; \u041c\u0446 23, 37b. 38<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0430\u0434\u044b\u0448\u043b\u0430 \u0430\u0434 \u043f\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u0445\u0432\u0430\u043b\u044b \u041f\u0430\u043d\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u0434\u044b\u0448\u043b\u0430 \u0445\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0430\u0434 \u043f\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e \u042f \u0445\u0430\u0446\u0435\u045e \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0442\u0432\u0430\u0456\u0445, \u0430\u043b\u0435 \u0432\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456! \u0412\u043e\u0441\u044c, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0432\u0430\u043c \u0434\u043e\u043c \u0432\u0430\u0448 \u043f\u0443\u0441\u0442\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u044b\u0448\u043b\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"245","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">12, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u044b \u0447\u044b\u043d \u2013 \u0437\u043d\u0430\u043a \u043f\u0435\u0440\u0430\u0441\u044f\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0443&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0442\u044b \u0436\u044b\u0432\u0435\u0448 \u0441\u044f\u0440\u043e\u0434 \u0443\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0434\u043e\u043c\u0443. \u042f\u043d\u044b \u043c\u0430\u044e\u0446\u044c \u0432\u043e\u0447\u044b, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0431\u0430\u0447\u0430\u0446\u044c; \u043c\u0430\u044e\u0446\u044c \u0432\u0443\u0448\u044b, \u043a\u0430\u0431 \u0447\u0443\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0447\u0443\u044e\u0446\u044c, \u0431\u043e \u044f\u043d\u044b \u2013 \u0434\u043e\u043c \u0431\u0443\u043d\u0442\u0443. \u0422\u0430\u043c\u0443 \u0442\u044b, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0441\u0430\u0431\u0435 \u043a\u043b\u0443\u043d\u043a\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430 \u0456 \u0434\u043d\u0451\u043c \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u0439\u0441\u044f \u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435 \u045e \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445. \u041f\u0435\u0440\u0430\u0439\u0434\u0437\u0456 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430 \u045e \u0456\u043d\u0448\u0430\u0435 \u045e \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445. \u041c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u2013 \u0443\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043d\u044b \u0434\u043e\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b\u043d\u0435\u0441\u0456 \u0441\u0432\u0430\u0435 \u043a\u043b\u0443\u043d\u043a\u0456 \u0434\u043d\u0451\u043c \u0443 \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445, \u043d\u0456\u0431\u044b \u043a\u043b\u0443\u043d\u043a\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430, \u0430 \u0441\u0430\u043c \u0432\u044b\u0439\u0434\u0437\u0456 \u045e\u0432\u0435\u0447\u0430\u0440\u044b \u045e \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445, \u044f\u043a \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0456. \u0423 \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0437\u0440\u0430\u0431\u0456 \u043f\u0440\u0430\u043b\u043e\u043c \u0443 \u0441\u0446\u044f\u043d\u0435 \u0456 \u0432\u044b\u0439\u0434\u0437\u0456 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e. \u0423 \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0432\u0430\u0437\u044c\u043c\u0456 \u043d\u0430 \u043f\u043b\u0435\u0447\u044b \u043a\u043b\u0443\u043d\u043a\u0456 \u0456 \u0432\u044b\u0439\u0434\u0437\u0456 \u044f\u043a \u0441\u0446\u044f\u043c\u043d\u0435\u0435. \u0417\u0430\u0441\u043b\u0430\u043d\u0456 \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440, \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u042f \u045e\u0447\u044b\u043d\u0456\u045e \u0446\u044f\u0431\u0435 \u0437\u043d\u0430\u043a\u0430\u043c \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u044f \u0437\u0440\u0430\u0431\u0456\u045e, \u044f\u043a \u0431\u044b\u043b\u043e \u043c\u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u043d\u0430: \u0443\u0434\u0437\u0435\u043d\u044c \u0432\u044b\u043d\u0435\u0441 \u0441\u0432\u0430\u0435 \u043a\u043b\u0443\u043d\u043a\u0456, \u043d\u0456\u0431\u044b \u043a\u043b\u0443\u043d\u043a\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430, \u0430 \u045e\u0432\u0435\u0447\u0430\u0440\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0430\u0431\u0435 \u0440\u0443\u043a\u043e\u044e \u043f\u0440\u0430\u043b\u043e\u043c \u0443 \u0441\u0446\u044f\u043d\u0435 \u0456 \u044f\u043a \u0441\u0446\u044f\u043c\u043d\u0435\u043b\u0430 \u0432\u044b\u0439\u0448\u0430\u045e \u0443 \u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445, \u043f\u0430\u043a\u043b\u0430\u045e\u0448\u044b \u043d\u0430 \u043f\u043b\u0435\u0447\u044b \u0441\u0432\u0430\u0435 \u043a\u043b\u0443\u043d\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0420\u0430\u043d\u0456\u0446\u0430\u0439 \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0446\u0456 \u043d\u0435 \u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0446\u044f\u0431\u0435 \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0443\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043d\u044b \u0434\u043e\u043c: \u201c\u0428\u0442\u043e \u0442\u044b \u0440\u043e\u0431\u0456\u0448?\u201d \u0410\u0434\u043a\u0430\u0436\u044b \u0456\u043c: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0413\u044d\u0442\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0456 \u045e\u0441\u044f\u0433\u043e \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0456\u043c. \u0421\u043a\u0430\u0436\u044b: \u042f \u2013 \u0437\u043d\u0430\u043a \u0434\u043b\u044f \u0432\u0430\u0441. \u042f\u043a \u0440\u0430\u0431\u0456\u045e \u044f, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u0456 \u0437 \u0456\u043c\u0456: \u044f\u043d\u044b \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435, \u0443 \u043f\u0430\u043b\u043e\u043d. \u0410 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440, \u044f\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u044f\u043a \u0441\u0446\u044f\u043c\u043d\u0435\u0435 \u0432\u043e\u0437\u044c\u043c\u0435 \u043d\u0430 \u043f\u043b\u0435\u0447\u044b \u043a\u043b\u0443\u043d\u043a\u0456 \u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u0441\u0446\u044f\u043d\u0443, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u0431\u2019\u044e\u0446\u044c, \u043a\u0430\u0431 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0432\u044b\u0439\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u044f\u0435. \u0401\u043d \u0437\u0430\u0441\u043b\u043e\u043d\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440, \u0442\u0430\u043c\u0443 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443 \u043d\u0430\u0434 \u0456\u043c \u0441\u0432\u0430\u044e \u0441\u0435\u0442\u043a\u0443, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u045e \u041c\u0430\u044e \u043f\u0430\u0441\u0442\u043a\u0443. \u0406 \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u043f\u0430\u0432\u044f\u0434\u0443\u0446\u044c \u044f\u0433\u043e \u045e \u0411\u0430\u0431\u0456\u043b\u0451\u043d, \u0443 \u0437\u044f\u043c\u043b\u044e \u0445\u0430\u043b\u0434\u044d\u044f\u045e, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0435, \u0456 \u0442\u0430\u043c \u043f\u0430\u043c\u0440\u044d. \u0423\u0441\u0456\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e: \u044f\u0433\u043e \u043f\u0440\u044b\u0441\u043b\u0443\u0433\u0443 \u0456 \u045e\u0441\u0451 \u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430, \u042f \u0440\u0430\u0437\u0432\u0435\u044e \u043f\u0430 \u045e\u0441\u0456\u0445 \u0432\u044f\u0442\u0440\u0430\u0445 \u0456 \u043f\u0430\u0433\u0430\u043d\u044e \u0456\u0445 \u043c\u044f\u0447\u043e\u043c. \u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u044f\u043d\u044b, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u042f \u0440\u0430\u0441\u0441\u0435\u044e \u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u044e \u0456\u0445 \u043f\u0430 \u0437\u0435\u043c\u043b\u044f\u0445. \u0406 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0437 \u0456\u0445 \u0437\u0430\u0445\u0430\u0432\u0430\u044e \u0430\u0434 \u043c\u044f\u0447\u0430, \u0433\u043e\u043b\u0430\u0434\u0443 \u0456 \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u043a\u0430\u0431 \u044f\u043d\u044b \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u045e\u0441\u044e \u0441\u0432\u0430\u044e \u0431\u0440\u044b\u0434\u043e\u0442\u0443 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0442\u0443\u0434\u044b, \u0456 \u044f\u043d\u044b \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 12, 15; \u041f\u0441 89 (88), 31. 33\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u042f \u0440\u0430\u0441\u0441\u0435\u044e \u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u044e \u0456\u0445 \u043f\u0430 \u0437\u0435\u043c\u043b\u044f\u0445, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u0434\u044b \u044f\u043d\u044b \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u041c\u043e\u0439 \u0437\u0430\u043a\u043e\u043d \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0456\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e, \u043f\u0430\u043a\u0430\u0440\u0430\u044e \u043a\u0456\u0435\u043c \u0456\u0445\u043d\u044f\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"246","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">16, 3. 5b-7\u0430. 8-15. 35. 37\u0430. 40-43. 59-63<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u2013 \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u044f \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0443 \u041f\u0430\u043d \u0411\u043e\u0433: \u00ab\u0422\u0432\u0430\u0451 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u0456 \u0442\u0432\u0430\u0435 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u2013 \u0437 \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0431\u0430\u0446\u044c\u043a\u0430 \u0442\u0432\u043e\u0439 \u2013 \u0430\u043c\u0430\u0440\u044d\u0439, \u0430 \u043c\u0430\u0446\u0456 \u2013 \u0445\u0435\u0442\u044d\u0439\u043a\u0430. \u0417 \u043f\u0430\u0433\u0430\u0440\u0434\u0430\u044e \u0434\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0432\u044b\u043a\u0456\u043d\u0443\u043b\u0456 \u0446\u044f\u0431\u0435 \u045e \u0447\u044b\u0441\u0442\u044b\u043c \u043f\u043e\u043b\u0456 \u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0442\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043c\u0456\u043c\u0430, \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0446\u044f\u0431\u0435, \u044f\u043a \u0442\u044b \u043a\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456: \u201c\u0416\u044b\u0432\u0456!\u201d \u0422\u0430\u043a, \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456: \u201c\u0416\u044b\u0432\u0456!\u201d \u042f \u0440\u0430\u0441\u0446\u0456\u045e \u0446\u044f\u0431\u0435 \u044f\u043a \u043f\u0430\u043b\u044f\u0432\u0443\u044e \u0440\u0430\u0441\u043b\u0456\u043d\u0443. \u0422\u044b \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0456 \u0441\u0442\u0430\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439, \u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043c\u0456\u043c\u0430, \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0446\u044f\u0431\u0435. \u0413\u044d\u0442\u0430 \u0431\u044b\u045e \u0442\u0432\u043e\u0439 \u0447\u0430\u0441, \u0447\u0430\u0441 \u043a\u0430\u0445\u0430\u043d\u043d\u044f. \u042f \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440 \u043a\u0440\u044b\u0441\u043e \u0441\u0432\u0430\u0451 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0456 \u043f\u0440\u044b\u043a\u0440\u044b\u045e \u0442\u0432\u0430\u044e \u0433\u0430\u043b\u0435\u0447\u0443. \u042f \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0442\u0430\u0431\u0435 \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0442\u0430\u0431\u043e\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, \u2013 \u0456 \u0442\u044b \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0451\u044e. \u042f \u0430\u0431\u043c\u044b\u045e \u0446\u044f\u0431\u0435 \u0432\u0430\u0434\u043e\u044e, \u0430\u0431\u0446\u0451\u0440 \u0437 \u0446\u044f\u0431\u0435 \u043a\u0440\u043e\u045e \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0446\u044f\u0431\u0435 \u0430\u043b\u0435\u0435\u043c. \u042f \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0446\u044f\u0431\u0435 \u045e \u0432\u044b\u0448\u044b\u0432\u0430\u043d\u044b\u044f \u0448\u0430\u0442\u044b, \u0430\u0431\u0443\u045e \u0446\u044f\u0431\u0435 \u045e \u0441\u0430\u0444\u2019\u044f\u043d\u0430\u0432\u044b\u044f \u0447\u0430\u0440\u0430\u0432\u0456\u043a\u0456, \u0431\u0456\u0441\u0435\u0440\u0430\u043c \u0430\u043f\u0435\u0440\u0430\u0437\u0430\u045e \u0446\u044f\u0431\u0435 \u0456 \u043d\u0430\u043a\u0440\u044b\u045e \u0448\u043e\u045e\u043a\u0430\u043c. \u0423\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0446\u044f\u0431\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u043d\u0430\u0434\u0437\u0435\u045e \u0431\u0440\u0430\u043d\u0437\u0430\u043b\u0435\u0442\u044b \u043d\u0430 \u0442\u0432\u0430\u0435 \u0440\u0443\u043a\u0456, \u0430 \u043f\u0430\u0446\u0435\u0440\u043a\u0456 \u043d\u0430 \u0442\u0432\u0430\u044e \u0448\u044b\u044e. \u042f \u0434\u0430\u045e \u043a\u0430\u043b\u044c\u0446\u043e \u0442\u0430\u0431\u0435 \u045e \u043d\u043e\u0441 \u0456 \u0437\u0430\u0432\u0443\u0448\u043d\u0456\u0446\u044b \u0434\u043b\u044f \u0442\u0432\u0430\u0456\u0445 \u0432\u0443\u0448\u044d\u0439, \u0430 \u043d\u0430 \u0442\u0432\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443 \u045e\u0441\u043a\u043b\u0430\u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u0434\u044b\u044f\u0434\u044d\u043c\u0443. \u0422\u044b \u043f\u0440\u044b\u0431\u0440\u0430\u043b\u0430\u0441\u044f \u045e \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u0431\u0456\u0441\u0435\u0440 \u0456 \u0448\u043e\u045e\u043a, \u0443 \u0432\u044b\u0448\u044b\u0432\u0430\u043d\u044b\u044f \u0442\u043a\u0430\u043d\u0456\u043d\u044b. \u0422\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0430 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0443\u044e \u043c\u0443\u043a\u0443, \u043c\u0451\u0434 \u0456 \u0430\u043b\u0435\u0439. \u0421\u0442\u0430\u043b\u0430 \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439 \u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b. \u0422\u0432\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u0440\u0430\u0437\u044b\u0448\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0432\u0430\u0451\u0439 \u043a\u0440\u0430\u0441\u044b, \u0431\u043e \u0442\u044b \u0431\u044b\u043b\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044e \u045e \u041c\u0430\u0451\u0439 \u0430\u0437\u0434\u043e\u0431\u0435, \u044f\u043a\u043e\u0439 \u042f \u0446\u044f\u0431\u0435 \u0430\u0434\u0430\u0440\u044b\u045e\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0410\u043b\u0435 \u0442\u044b \u045e\u0441\u043a\u043b\u0430\u043b\u0430 \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0441\u0442\u0430\u043b\u0430 \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u044b\u0446\u044c. \u0422\u044b \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u043b\u0430 \u0441\u0432\u0430\u044e \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443, \u0430\u0434\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043c\u0456\u043c\u0430 \u0446\u044f\u0431\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430, \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430: \u042f \u0437\u0431\u044f\u0440\u0443 \u045e\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u043a\u0430\u0445\u0430\u043d\u043a\u0430\u045e. \u042f\u043d\u044b \u0441\u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u0445\u043e\u0434, \u0437\u0430\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u0435\u043c \u0456 \u043f\u0430\u0441\u044f\u043a\u0443\u0446\u044c \u0441\u0432\u0430\u0456\u043c\u0456 \u043c\u044f\u0447\u0430\u043c\u0456. \u0410\u0433\u043d\u0451\u043c \u0441\u043f\u0430\u043b\u044f\u0446\u044c \u0442\u0432\u0430\u0435 \u0434\u0430\u043c\u044b \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043c\u043d\u043e\u0433\u0456\u0445 \u0436\u0430\u043d\u0447\u044b\u043d. \u042f \u043f\u0430\u043a\u043b\u0430\u0434\u0443 \u043a\u0430\u043d\u0435\u0446 \u0442\u0432\u0430\u0451\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435, \u0456 \u0442\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0434\u0430\u0441\u0456 \u043f\u043b\u0430\u0442\u044b. \u042f \u0441\u0443\u0446\u0456\u0448\u0443 \u041c\u043e\u0439 \u0433\u043d\u0435\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u0430\u0434\u044b\u0434\u0437\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041c\u0430\u044f \u043b\u044e\u0442\u0430\u0441\u0446\u044c. \u042f \u0441\u0443\u043f\u0430\u043a\u043e\u044e\u0441\u044f \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u0437\u043b\u0430\u0432\u0430\u0446\u0446\u0430. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0430 \u043f\u0440\u0430 \u0434\u043d\u0456 \u0442\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0430\u043b\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u043d\u044f\u043b\u0430 \u043c\u044f\u043d\u0435 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c, \u0442\u043e \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u043a\u043b\u0430\u0434\u0443 \u0442\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0442\u0430\u0431\u0435 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. \u2013 \u0422\u0430\u043c\u0443 \u0442\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043e\u043b\u044c\u0448 \u0447\u044b\u043d\u0456\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u043f\u0430\u0441\u043b\u044f \u045e\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0442\u0430\u0431\u0435 \u0442\u0430\u043a, \u044f\u043a \u0442\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0430 \u043a\u043b\u044f\u0442\u0432\u0430\u044e, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0410\u0434\u043d\u0430\u043a \u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0448\u0442\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0422\u0430\u0431\u043e\u044e \u045e \u0434\u043d\u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0442\u0430\u0431\u043e\u044e \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0422\u044b \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435\u0448 \u0441\u0432\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0437\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0448\u0441\u044f, \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u043d\u0435\u0448 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0441\u044f\u0441\u0446\u0451\u0440, \u0430\u0434 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0434\u0430 \u043c\u0430\u043b\u043e\u0434\u0448\u044b\u0445 \u0437\u0430 \u0441\u044f\u0431\u0435. \u042f \u0434\u0430\u043c \u0456\u0445 \u0442\u0430\u0431\u0435 \u044f\u043a \u0434\u0430\u0447\u043e\u043a, \u0430\u043b\u0435 \u043d\u0435 \u0437 \u0442\u0432\u0430\u0439\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0442\u0430\u0431\u043e\u044e \u0441\u0432\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u043a\u0430\u0431 \u0442\u044b \u0432\u0435\u0434\u0430\u043b\u0430, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u043a\u0430\u0431 \u0442\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0430 \u0456 \u0441\u0430\u0440\u043e\u043c\u0435\u043b\u0430\u0441\u044f \u0456 \u043a\u0430\u0431 \u0430\u0434 \u0441\u043e\u0440\u0430\u043c\u0443 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u042f \u0434\u0430\u0440\u0443\u044e \u0442\u0430\u0431\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u0442\u044b \u0440\u0430\u0431\u0456\u043b\u0430\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0406\u0441 54, 6. 8; \u042d\u0437\u0445 16, 60&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043a \u0434\u0430 \u0436\u043e\u043d\u043a\u0456, \u0430\u0434\u0440\u044b\u043d\u0443\u0442\u0430\u0439 \u0443 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f \u0434\u0430 \u0446\u044f\u0431\u0435, \u0443 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0435 \u0433\u043d\u0435\u0432\u0443 \u042f \u0441\u0445\u0430\u0432\u0430\u045e \u0430\u0434 \u0446\u044f\u0431\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0451, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0430\u043b\u0435 \u045e \u0432\u0435\u0447\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0437\u043b\u0456\u0442\u0443\u044e\u0441\u044f \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u2013<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u0442\u0432\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0448\u0442\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0422\u0430\u0431\u043e\u044e \u045e \u0434\u043d\u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0442\u0430\u0431\u043e\u044e \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435 \u045e \u0432\u0435\u0447\u043d\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"247","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">18, 1-13. 20-32<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0441\u0432\u0430\u0435 \u0447\u044b\u043d\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u044b \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0435\u0446\u0435 \u0433\u044d\u0442\u0443\u044e \u043f\u0440\u044b\u043c\u0430\u045e\u043a\u0443 \u043f\u0440\u0430 \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u0410\u0439\u0446\u044b \u0435\u043b\u0456 \u043a\u0456\u0441\u043b\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u0430 \u043d\u0430 \u0437\u0443\u0431\u0430\u0445 \u0441\u044b\u043d\u043e\u045e \u2013 \u0430\u0441\u043a\u043e\u043c\u0456\u043d\u0430\u201d?&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u042f \u0436\u044b\u0432\u044b, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, \u2013 \u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u043c\u0430\u045e\u043a\u0456 \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456. \u0412\u043e\u0441\u044c, \u0443\u0441\u0435 \u0434\u0443\u0448\u044b \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u041c\u043d\u0435: \u044f\u043a \u0434\u0443\u0448\u0430 \u0431\u0430\u0446\u044c\u043a\u0456, \u0442\u0430\u043a \u0456 \u0434\u0443\u0448\u0430 \u0441\u044b\u043d\u0430. \u0414\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u043f\u0430\u043c\u0440\u044d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u043b\u0456 \u0451\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u0435 \u0435\u0441\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u045e, \u043d\u0435 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439 \u0434\u0430 \u0456\u0434\u0430\u043b\u0430\u045e \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043d\u0435 \u0433\u0430\u043d\u044c\u0431\u0456\u0446\u044c \u0436\u043e\u043d\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u045e \u0447\u0430\u0441 \u044f\u0435 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u043d\u0435 \u045e\u0446\u0456\u0441\u043a\u0430\u0435 \u043d\u0456\u043a\u043e\u0433\u0430, \u0432\u044f\u0440\u0442\u0430\u0435 \u0434\u0430\u045e\u0436\u043d\u0456\u043a\u0443 \u044f\u0433\u043e\u043d\u044b \u0437\u0430\u043a\u043b\u0430\u0434, \u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0440\u0430\u0431\u0443\u043d\u043a\u0443, \u0434\u0430\u0435 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443 \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431 \u0456 \u043f\u0440\u044b\u043a\u0440\u044b\u0432\u0430\u0435 \u0433\u043e\u043b\u0430\u0433\u0430 \u0430\u0434\u0437\u0435\u0436\u0430\u0439, \u043d\u0435 \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0446\u0430 \u043b\u0456\u0445\u0432\u044f\u0440\u0441\u0442\u0432\u0430\u043c, \u0430\u0434\u0445\u0456\u043b\u044f\u0435 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0430\u0434 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0441\u0443\u0434 \u043f\u0430\u043c\u0456\u0436 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u041c\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443, \u0442\u043e \u0451\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433.&nbsp;&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431 \u0443 \u044f\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0441\u044b\u043d \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435 \u043a\u0440\u043e\u045e \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0445\u0430\u0446\u044f \u0431 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u043d\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430, \u0445\u043e\u0446\u044c \u0441\u0430\u043c \u0451\u043d \u0443\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u045e, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430: \u0435\u0441\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0456, \u0433\u0430\u043d\u044c\u0431\u0456\u0446\u044c \u0436\u043e\u043d\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0443\u0446\u0456\u0441\u043a\u0430\u0435 \u045e\u0431\u043e\u0433\u0430\u0433\u0430 \u0456 \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u0440\u0430\u0431\u0443\u0435, \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0435 \u0437\u0430\u043a\u043b\u0430\u0434, \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0434\u0430 \u0456\u0434\u0430\u043b\u0430\u045e, \u0447\u044b\u043d\u0456\u0446\u044c \u0431\u0440\u044b\u0434\u043e\u0442\u0443, \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0446\u0430 \u043b\u0456\u0445\u0432\u044f\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0431\u044f\u0440\u044d \u0430\u0434\u0441\u043e\u0442\u043a\u0456, \u0442\u043e \u0442\u0430\u043a\u0456 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u0451\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0441\u044e \u0433\u044d\u0442\u0443\u044e \u0431\u0440\u044b\u0434\u043e\u0442\u0443, \u0442\u043e \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0430\u043c\u0440\u044d, \u0456 \u043a\u0440\u043e\u045e \u044f\u0433\u043e\u043d\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0456\u043c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041f\u0430\u043c\u0440\u044d \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0433\u0440\u0430\u0448\u044b\u0446\u044c. \u0421\u044b\u043d \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0437\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0431\u0430\u0446\u044c\u043a\u0456, \u0456 \u0431\u0430\u0446\u044c\u043a\u0430 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0437\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0441\u044b\u043d\u0430. \u041f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443, \u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u044f\u043a\u0456\u044f \u045e\u0447\u044b\u043d\u0456\u045e, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u045e\u0441\u0435 \u041c\u0430\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e \u0451\u043d \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0456 \u043d\u0435 \u043f\u0430\u043c\u0440\u044d. \u041d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u044f\u0433\u043e\u043d\u044b \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u0430\u043a, \u044f\u043a\u0456 \u0451\u043d \u0443\u0447\u044b\u043d\u0456\u045e, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u043d\u044b \u044f\u043c\u0443. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0443\u044e \u0447\u044b\u043d\u0456\u045e, \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c. \u0426\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u042f \u043f\u0440\u0430\u0433\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, \u2013 \u0430 \u043d\u0435 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0451\u043d \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u0448\u043b\u044f\u0445\u043e\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u0436\u044b\u045e?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u044e \u0431\u0440\u044b\u0434\u043e\u0442\u0443, \u044f\u043a\u0443\u044e \u0440\u0430\u0431\u0456\u045e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b, \u0446\u0456 \u0436 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c? \u041f\u0440\u0430 \u045e\u0441\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e, \u044f\u043a\u0443\u044e \u0447\u044b\u043d\u0456\u045e, \u043d\u0435 \u045e\u0441\u043f\u043e\u043c\u043d\u044f\u0446\u044c; \u0437\u0430 \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u044f\u0432\u0456\u045e, \u0456 \u0437\u0430 \u0433\u0440\u044d\u0445, \u044f\u043a\u0456\u043c \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u2013 \u0437-\u0437\u0430 \u0456\u0445 \u0451\u043d \u043f\u0430\u043c\u0440\u044d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b \u043a\u0430\u0436\u0430\u0446\u0435: \u201e \u0428\u043b\u044f\u0445 \u041f\u0430\u043d\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u201d. \u0414\u044b\u043a \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u041c\u043e\u0439 \u0448\u043b\u044f\u0445 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0446\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0445\u0443\u0442\u0447\u044d\u0439 \u0432\u0430\u0448\u044b\u044f \u0448\u043b\u044f\u0445\u0456? \u041a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0456 \u043f\u0430\u043c\u0440\u044d, \u0442\u043e \u0437\u0430 \u0433\u044d\u0442\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0447\u044b\u043d\u0456\u045e, \u043f\u0430\u043c\u0440\u044d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0443\u044e \u0447\u044b\u043d\u0456\u045e, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0436\u044b\u0432\u043e\u0439 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443. \u0401\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0456 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u0443\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0447\u044b\u043d\u0456\u045e, \u0442\u0430\u043c\u0443 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u043c\u0440\u044d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043a\u0430\u0436\u0430: \u00ab\u0428\u043b\u044f\u0445\u0456 \u041f\u0430\u043d\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f\u00bb. \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u041c\u0430\u0435 \u0448\u043b\u044f\u0445\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0446\u0456 \u0445\u0443\u0442\u0447\u044d\u0439 \u0432\u0430\u0448\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u042f \u0431\u0443\u0434\u0443 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0433\u043e\u043d\u044b\u0445 \u0448\u043b\u044f\u0445\u043e\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. \u2013 \u041f\u0430\u043a\u0430\u0439\u0446\u0435\u0441\u044f \u0456 \u0430\u0434\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0430\u0434 \u0443\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u043b\u044f \u0432\u0430\u0441 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0443\u043f\u0430\u0434\u043a\u0443. \u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u045e\u0441\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b, \u044f\u043a\u0456\u044f \u0432\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u0435 \u045e \u0441\u0430\u0431\u0435 \u043d\u043e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u043e\u0432\u044b \u0434\u0443\u0445. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0432\u0430\u043c, \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f? \u0411\u043e \u042f \u043d\u0435 \u043c\u0430\u044e \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u044f \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. \u2013 \u0422\u0430\u043c\u0443 \u043d\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0456 \u0436\u044b\u0432\u0456\u0446\u0435.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 31, 29; \u042d\u0437\u0445 18, 20\u0430. 30\u0430. 20b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0437\u0430\u0446\u044c: \u0410\u0439\u0446\u044b \u0435\u043b\u0456 \u043a\u0456\u0441\u043b\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u0430 \u043d\u0430 \u0437\u0443\u0431\u0430\u0445 \u0441\u044b\u043d\u043e\u045e \u2013 \u0430\u0441\u043a\u043e\u043c\u0456\u043d\u0430.<\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041f\u0430\u043c\u0440\u044d \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0433\u0440\u0430\u0448\u044b\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0431\u0443\u0434\u0443 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0448\u043b\u044f\u0445\u043e\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u0421\u044b\u043d \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0437\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0430\u0439\u0446\u0430, \u0456 \u0430\u0439\u0446\u0435\u0446 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0437\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0441\u044b\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u043c\u0440\u044d.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"251","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">24, 15-27<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0416\u044b\u0446\u0446\u0451 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u2013 \u0437\u043d\u0430\u043a \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0432\u043e\u0441\u044c \u042f \u0437\u0430\u0431\u044f\u0440\u0443 \u045e \u0446\u044f\u0431\u0435 \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u043f\u0430\u0446\u0435\u0445\u0443 \u0442\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439. \u0410\u043b\u0435 \u0442\u044b \u043d\u0435 \u0441\u043c\u0443\u0442\u043a\u0443\u0439 \u0456 \u043d\u0435 \u043f\u043b\u0430\u0447, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043b\u0456\u044e\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0441\u043b\u0451\u0437\u044b. \u0423\u0437\u0434\u044b\u0445\u0430\u0439 \u043c\u043e\u045e\u0447\u043a\u0456, \u043d\u0435 \u0433\u0430\u043b\u0430\u0441\u0456 \u043f\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0417\u0430\u0432\u044f\u0436\u044b \u043d\u0430 \u0441\u0430\u0431\u0435 \u0441\u0432\u043e\u0439 \u0442\u0443\u0440\u0431\u0430\u043d, \u043d\u0430\u0434\u0437\u0435\u043d\u044c \u043d\u0430 \u0441\u0432\u0430\u0435 \u043d\u043e\u0433\u0456 \u0441\u0432\u043e\u0439 \u0430\u0431\u0443\u0442\u0430\u043a, \u043d\u0435 \u0437\u0430\u0441\u043b\u0430\u043d\u044f\u0439 \u0441\u0430\u0431\u0435 \u0431\u0430\u0440\u0430\u0434\u044b \u0456 \u043d\u0435 \u0435\u0448 \u0445\u043b\u0435\u0431\u0430 \u0436\u0430\u043b\u043e\u0431\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0440\u0430\u043d\u043a\u0443 \u044f \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u045e\u0432\u0435\u0447\u0430\u0440\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u043c\u0430\u044f \u0436\u043e\u043d\u043a\u0430. \u0406 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0434\u0437\u0435\u043d\u044c \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u044f \u0437\u0440\u0430\u0431\u0456\u045e, \u044f\u043a \u043c\u043d\u0435 \u0431\u044b\u043b\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0437\u0430\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u043c\u044f\u043d\u0435 \u043d\u0430\u0440\u043e\u0434: \u00ab\u0426\u0456 \u043d\u0435 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0448 \u043d\u0430\u043c, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0442\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456?\u00bb \u0406 \u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c: \u00ab\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u0421\u043a\u0430\u0436\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0412\u043e\u0441\u044c \u042f \u0430\u0434\u0434\u0430\u043c \u043d\u0430 \u0433\u0430\u043d\u044c\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u041c\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0433\u043e\u043d\u0430\u0440 \u0432\u0430\u0448\u0430\u0439 \u0441\u0456\u043b\u044b, \u0443\u0446\u0435\u0445\u0443 \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u044d\u0439 \u0456 \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0432\u0430\u0448\u044b\u0445 \u0434\u0443\u0448\u0430\u045e. \u0410 \u0441\u044b\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u043e\u0447\u043a\u0456, \u044f\u043a\u0456\u0445 \u0432\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456, \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0434 \u043c\u044f\u0447\u0430. \u0422\u0430\u0434\u044b \u0432\u044b \u0437\u0440\u043e\u0431\u0456\u0446\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u044f: \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0430\u0441\u043b\u0430\u043d\u044f\u0446\u044c \u0431\u0430\u0440\u0430\u0434\u044b \u0456 \u0435\u0441\u0446\u0456 \u0445\u043b\u0435\u0431\u0430 \u0436\u0430\u043b\u043e\u0431\u044b. \u0412\u0430\u0448\u044b\u044f \u0442\u0443\u0440\u0431\u0430\u043d\u044b \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u0432\u0430\u0448\u044b\u0445 \u0433\u0430\u043b\u043e\u0432\u0430\u0445 \u0456 \u0430\u0431\u0443\u0442\u0430\u043a \u043d\u0430 \u0432\u0430\u0448\u044b\u0445 \u043d\u0430\u0433\u0430\u0445. \u0412\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0456 \u043f\u043b\u0430\u043a\u0430\u0446\u044c, \u0430\u043b\u0435 \u0441\u043f\u0430\u0440\u0430\u0445\u043d\u0435\u0435\u0446\u0435 \u045e \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0437\u0434\u044b\u0445\u0430\u0446\u044c, \u043a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c. \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0437\u043d\u0430\u043a\u0430\u043c. \u0422\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0440\u0430\u0431\u0456\u045e, \u0456 \u0432\u044b \u0437\u0440\u043e\u0431\u0456\u0446\u0435. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430, \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0442\u044b, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0443 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u042f \u0437\u0430\u0431\u044f\u0440\u0443 \u045e \u0456\u0445 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u0456\u0445\u043d\u044f\u0435, \u0443\u0446\u0435\u0445\u0443 \u0456\u0445 \u0432\u0430\u0447\u044d\u0439 \u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435 \u0456\u0445 \u0434\u0443\u0448\u044b, \u0456\u0445\u043d\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0447\u043e\u043a \u0456\u0445\u043d\u0456\u0445, \u0446\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0434\u0430 \u0446\u044f\u0431\u0435 \u045e\u0446\u044f\u043a\u0430\u0447, \u043a\u0430\u0431 \u0434\u0430\u043d\u0435\u0441\u0446\u0456 \u0442\u0430\u0431\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430? \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043a\u0440\u044b\u044e\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0443\u0446\u0435\u043a\u0430\u0447\u043e\u043c, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043e\u043b\u044c\u0448 \u043d\u044f\u043c\u044b\u043c. \u0422\u044b \u0441\u0442\u0430\u043d\u0435\u0448 \u0434\u043b\u044f \u0456\u0445 \u0437\u043d\u0430\u043a\u0430\u043c, \u0456 \u044f\u043d\u044b \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 24, 24; \u0401\u044d\u043b 2, 13\u0430<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0437\u043d\u0430\u043a\u0430\u043c: \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0440\u0430\u0431\u0456\u045e, \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> *<\/span><span> \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430, \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d \u0411\u043e\u0433.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0420\u0430\u0437\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f, \u0430 \u043d\u0435 \u0432\u0430\u0448\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435; \u043d\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"252","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">34, 1-6. 11-16. 23-31<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0406\u0437\u0440\u0430\u044d\u043b\u044c \u2013 \u0441\u0442\u0430\u0442\u0430\u043a \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0440\u0430\u0440\u043e\u0447 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0440\u0430\u0440\u043e\u0447 \u0456 \u0441\u043a\u0430\u0436\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0413\u043e\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435! \u0425\u0456\u0431\u0430 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a? \u0412\u044b \u044f\u0441\u0446\u0435 \u0442\u0443\u043a, \u0430\u043f\u0440\u0430\u043d\u0430\u0435\u0446\u0435\u0441\u044f \u045e \u0432\u043e\u045e\u043d\u0443 \u0456 \u0437\u0430\u0440\u0430\u0437\u0430\u0435\u0446\u0435 \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u044b\u0445, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0435 \u0441\u0442\u0430\u0442\u0430\u043a. \u0412\u044b \u043d\u0435 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456 \u0441\u043b\u0430\u0431\u0443\u044e \u0456 \u043d\u0435 \u043b\u044f\u0447\u044b\u043b\u0456 \u0445\u0432\u043e\u0440\u0443\u044e, \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0443\u044e \u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u043b\u0456 \u0442\u0443\u044e, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0430, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0432\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456, \u0430\u043b\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u044e \u0456 \u0433\u0432\u0430\u043b\u0442\u0430\u043c. \u0422\u0430\u043a, \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u041c\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0456\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0441\u0442\u0430\u043b\u0456 \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u044e \u045e\u0441\u0456\u0445 \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e \u0456 \u0440\u0430\u0437\u0431\u0435\u0433\u043b\u0456\u0441\u044f. \u0411\u043b\u0443\u043a\u0430\u044e\u0446\u044c \u041c\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456 \u043f\u0430 \u045e\u0441\u0456\u0445 \u0433\u0430\u0440\u0430\u0445 \u0456 \u043f\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u043f\u0430\u0433\u043e\u0440\u043a\u0443, \u0456 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u041c\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456. \u041d\u0456\u0445\u0442\u043e \u0456\u0445 \u043d\u0435 \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u045e, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0448\u0443\u043a\u0430\u045e \u0456\u0445\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u00ab\u0412\u043e\u0441\u044c \u042f \u0441\u0430\u043c \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u043f\u0435\u0440\u0430\u0433\u043b\u0435\u0434\u0436\u0443 \u0456\u0445. \u042f\u043a \u043f\u0430\u0441\u0442\u0443\u0445 \u043f\u0435\u0440\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a \u0443 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0430\u043f\u044b\u043d\u0435\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0442\u0430\u043a \u0456 \u042f \u043f\u0435\u0440\u0430\u0433\u043b\u0435\u0434\u0436\u0443 \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0456\u0445 \u0437 \u0443\u0441\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u045e, \u043f\u0430 \u044f\u043a\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u044f\u043d\u044b \u045e \u043f\u0430\u0445\u043c\u0443\u0440\u043d\u044b \u0456 \u0437\u043c\u0440\u043e\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c. \u042f \u0432\u044b\u0432\u0435\u0434\u0443 \u0456\u0445 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0437 \u043a\u0440\u0430\u0456\u043d\u0430\u045e, \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u045e \u0456\u0445\u043d\u044e\u044e \u0437\u044f\u043c\u043b\u044e \u0456 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0456 \u043f\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0441\u044f\u043b\u0435\u043d\u043d\u044f\u0445 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0411\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0430 \u0434\u043e\u0431\u0440\u0430\u0439 \u043f\u0430\u0448\u044b, \u0456 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0456\u0445\u043d\u0456 \u0437\u0430\u0433\u043e\u043d. \u0422\u0430\u043c \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u0443 \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u0430\u0433\u043e\u043d\u0435 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u0441\u044b\u0442\u043d\u0430\u0439 \u043f\u0430\u0448\u044b, \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u0441\u0430\u043c \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u041c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 c\u0430\u043c \u0431\u0443\u0434\u0443 \u045e\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. \u2013 \u0417\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0430\u0434\u0448\u0443\u043a\u0430\u044e, \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u0443\u044e \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u043d\u0430\u0437\u0430\u0434, \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u0432\u044f\u0436\u0443 \u0456 \u0430\u0441\u043b\u0430\u0431\u043b\u0443\u044e \u043f\u0430\u0434\u043c\u0430\u0446\u0443\u044e, \u0430 \u0442\u043b\u0443\u0441\u0442\u0443\u044e \u0456 \u043c\u043e\u0446\u043d\u0443\u044e \u0437\u043d\u0456\u0448\u0447\u0443. \u0411\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u044f\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u043d\u0430\u0434 \u0456\u043c\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043f\u0430\u0441\u0432\u0456\u0446\u044c, \u2013 \u043c\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u0414\u0430\u0432\u0456\u0434\u0430. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043f\u0430\u0441\u0432\u0456\u0446\u044c, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c. A \u042f, \u041f\u0430\u043d, \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c, \u0430 \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439 \u0414\u0430\u0432\u0456\u0434 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445. \u042f, \u041f\u0430\u043d, \u0441\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437 \u0456\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u043f\u0440\u044b\u0431\u044f\u0440\u0443 \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e \u0437 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u043c\u0430\u0433\u043b\u0456 \u0436\u044b\u0446\u044c \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0456 \u0441\u043f\u0430\u0446\u044c \u0443 \u043b\u044f\u0441\u0430\u0445. \u042f \u0434\u0430\u043c \u0456\u043c \u0456 \u0432\u0430\u043a\u043e\u043b\u0456\u0446\u0430\u043c \u041c\u0430\u0439\u0433\u043e \u045e\u0437\u0432\u044b\u0448\u0448\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u043f\u0430\u0448\u043b\u044e \u0434\u043e\u0436\u0434\u0436 \u0443 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441. \u0413\u044d\u0442\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0430\u0436\u0434\u0436\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041b\u044f\u0441\u043d\u043e\u0435 \u0434\u0440\u044d\u0432\u0430 \u0434\u0430\u0441\u0446\u044c \u0441\u0432\u043e\u0439 \u043f\u043b\u043e\u0434, \u0430 \u0437\u044f\u043c\u043b\u044f \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0441\u0432\u043e\u0439 \u0443\u0440\u0430\u0434\u0436\u0430\u0439. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u0406 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u0437\u043b\u0430\u043c\u0430\u044e \u0430\u0448\u044b\u0439\u043d\u0456\u043a \u0456\u0445\u043d\u044f\u0433\u0430 \u044f\u0440\u043c\u0430 \u0456 \u045e\u0440\u0430\u0442\u0443\u044e \u0456\u0445 \u0430\u0434 \u0440\u0443\u043a\u0456 \u0456\u0445\u043d\u0456\u0445 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e. \u042f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439 \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0456 \u0437\u0432\u044f\u0440\u044b \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0436\u044b\u0440\u0430\u0446\u044c \u0456\u0445. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u043d\u0456\u0445\u0442\u043e \u0456\u0445 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0437\u0433\u0430\u0434\u0443\u044e \u0434\u043b\u044f \u0456\u0445 \u0441\u043b\u0430\u045e\u043d\u044b \u045e\u0440\u0430\u0434\u0436\u0430\u0439, \u0442\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0434 \u0433\u043e\u043b\u0430\u0434\u0443 \u045e \u043a\u0440\u0430\u0456 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0430\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u042f, \u041f\u0430\u043d, \u0456\u0445 \u0411\u043e\u0433, \u2013 \u0437 \u0456\u043c\u0456, \u0456 \u0448\u0442\u043e \u044f\u043d\u044b, \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u2013 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u2013 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>A \u0432\u044b \u2013 \u043c\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456, \u0430\u0432\u0435\u0447\u043a\u0456 \u043c\u0430\u0451\u0439 \u043f\u0430\u0448\u044b. \u0412\u044b \u2013 \u043b\u044e\u0434\u0437\u0456, \u0430 \u042f \u2013 \u0432\u0430\u0448 \u0411\u043e\u0433\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 34, 12b. 13b. 14\u0430; \u042f\u043d 10, 10b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0437 \u0443\u0441\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u045e, \u043f\u0430 \u044f\u043a\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u044f\u043d\u044b \u045e \u043f\u0430\u0445\u043c\u0443\u0440\u043d\u044b \u0456 \u0437\u043c\u0440\u043e\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u045e \u0456\u0445\u043d\u044e\u044e \u0437\u044f\u043c\u043b\u044e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0430 \u0434\u043e\u0431\u0440\u0430\u0439 \u043f\u0430\u0448\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0432\u044b \u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043c\u0435\u043b\u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u0443\u0434\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"253","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">36, 16-36<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0443\u0447\u0430\u0435 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0446\u0435\u043b\u0430\u043c, \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0445\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u043b\u0456 \u0436\u044b\u045e \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u045e \u044f\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456. \u042f\u043a \u043c\u0435\u0441\u044f\u0447\u043d\u0430\u044f \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0431\u044b\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e. \u0422\u0430\u043c\u0443 \u042f \u0432\u044b\u043b\u0456\u045e \u043d\u0430 \u0456\u0445 \u0441\u0432\u043e\u0439 \u0433\u043d\u0435\u045e \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u044f\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456\u0434\u0430\u043b\u0430\u043c\u0456. \u042f \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u045e \u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u044f\u043d\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u043f\u0430 \u0437\u0435\u043c\u043b\u044f\u0445. \u042f \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u045e. \u042f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u0442\u0430\u043c, \u043a\u0443\u0434\u044b \u043f\u0430\u0439\u0448\u043b\u0456, \u0433\u0430\u043d\u044c\u0431\u0456\u043b\u0456 \u041c\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u0456\u0445: \u201c\u0413\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434 \u041f\u0430\u043d\u0430, \u044f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0437 \u042f\u0433\u043e\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0456\u201d. \u0422\u0430\u0434\u044b \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u042f \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f \u0441\u0432\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u043d\u044f\u0441\u043b\u0430\u0432\u0456\u045e \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u0439\u0448\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u201c\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u041d\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430, \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u0434\u0437\u0435\u043b\u044f \u041c\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0456\u043c\u044f, \u044f\u043a\u043e\u0435 \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u043b\u0456 \u0432\u044b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u0439\u0448\u043b\u0456. \u042f \u0430\u0441\u0432\u044f\u0447\u0443 \u041c\u0430\u0451 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f, \u0437\u043d\u044f\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0431\u043e \u0432\u044b \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u043b\u0456 \u044f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445. \u0422\u0430\u0434\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u044b, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, \u2013 \u043a\u0430\u043b\u0456 \u041c\u0430\u044f \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0456\u0445\u043d\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430. \u042f \u0432\u0430\u0437\u044c\u043c\u0443 \u0432\u0430\u0441 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0437\u0431\u044f\u0440\u0443 \u0437 \u0443\u0441\u0456\u0445 \u0437\u0435\u043c\u043b\u044f\u045e, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0432\u0430\u0441 \u0443 \u0432\u0430\u0448\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0410\u043a\u0440\u0430\u043f\u043b\u044e \u0432\u0430\u0441 \u0447\u044b\u0441\u0442\u0430\u044e \u0432\u0430\u0434\u043e\u044e, \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u0430\u0434 \u045e\u0441\u044f\u0433\u043e \u0431\u0440\u0443\u0434\u0443 \u0432\u0430\u0448\u0430\u0433\u0430, \u0456 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u042f \u0430\u0447\u044b\u0448\u0447\u0443 \u0432\u0430\u0441. \u0414\u0430\u043c \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0434\u0443\u0445 \u043d\u043e\u0432\u044b \u045e \u043d\u0443\u0442\u0440\u043e \u0432\u0430\u0448\u0430\u0435. \u0417\u0430\u0431\u044f\u0440\u0443 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0437 \u0432\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0456 \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430 \u0437 \u043f\u043b\u043e\u0446\u0456. \u0423\u0434\u044b\u0445\u043d\u0443 \u0434\u0443\u0445 \u041c\u043e\u0439 \u0443 \u043d\u0443\u0442\u0440\u043e \u0432\u0430\u0448\u0430\u0435 \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0442\u0430\u043a, \u0448\u0442\u043e \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0456\u0445 \u0437\u0430\u043a\u043e\u043d\u0430\u045e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u041c\u0430\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445. \u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u045e \u0430\u0439\u0446\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0432\u0430\u0441 \u0430\u0434 \u0443\u0441\u0451\u0439 \u0432\u0430\u0448\u0430\u0439 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u043f\u0430\u043a\u043b\u0456\u0447\u0443 \u0437\u0431\u043e\u0436\u0436\u0430 \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u0443 \u044f\u0433\u043e, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0448\u043b\u044e \u043d\u0430 \u0432\u0430\u0441 \u0433\u043e\u043b\u0430\u0434. \u041f\u0430\u043c\u043d\u043e\u0436\u0443 \u043f\u043b\u043e\u0434 \u0434\u0440\u044d\u0432\u0430 \u0456 \u045e\u0440\u0430\u0434\u0436\u0430\u0439 \u043f\u043e\u043b\u044f, \u043a\u0430\u0431 \u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u0433\u0430\u043d\u044c\u0431\u0443 \u0433\u043e\u043b\u0430\u0434\u0443 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0432\u0430\u0448\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456. \u0410\u0434\u0447\u0443\u0435\u0446\u0435 \u0430\u0433\u0456\u0434\u0443 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0432\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0432\u0430\u0448\u0430\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u044b. \u041d\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u042f \u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. \u2013 \u0425\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0432\u044f\u0434\u043e\u043c\u0430 \u0433\u044d\u0442\u0430. \u0421\u0430\u0440\u043e\u043c\u0446\u0435\u0441\u044f \u0456 \u0447\u044b\u0440\u0432\u0430\u043d\u0435\u0439\u0446\u0435 \u0437-\u0437\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e, \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f!&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u00ab\u0423 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0430\u0447\u044b\u0448\u0447\u0443 \u0432\u0430\u0441 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0432\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u0437\u0430\u0441\u044f\u043b\u044e \u0433\u0430\u0440\u0430\u0434\u044b, \u0430 \u0440\u0443\u0456\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u044f. \u0417\u0430\u043c\u0435\u0441\u0442 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043f\u0443\u0441\u0442\u044d\u0447\u0430\u044e \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u0456\u0445 \u043c\u0456\u043d\u0430\u043a\u043e\u045e, \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u0446\u0430. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u201c\u0413\u044d\u0442\u0430\u044f \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0441\u0442\u0430\u043b\u0430 \u044f\u043a \u0441\u0430\u0434 \u042d\u0434\u044d\u043d, \u0430 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u044b\u044f, \u0430\u043f\u0443\u0441\u0446\u0435\u043b\u044b\u044f \u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b \u2013 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0437\u0430\u0441\u0435\u043b\u0435\u043d\u044b\u044f\u201d. \u0406 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0432\u0430\u043a\u043e\u043b \u0432\u0430\u0441, \u0448\u0442\u043e \u042f, \u041f\u0430\u043d, \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0437\u0431\u0443\u0440\u0430\u043d\u0430\u0435 \u0456 \u0437\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430\u0435. \u042f, \u041f\u0430\u043d, \u0441\u043a\u0430\u0437\u0430\u045e \u0456 \u0437\u0440\u0430\u0431\u043b\u044e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 11, 19b-20. 19\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b\u043c\u0443 \u0441\u044d\u0440\u0446\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0435 \u0437 \u0456\u0445 \u0446\u0435\u043b\u0430, \u0430 \u0434\u0430\u043c \u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043c\u0430\u0456\u043c\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043c\u0456. \u0406 \u0442\u0430\u043a \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043d\u044b \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u0430\u043c \u0456\u043c \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0434\u0443\u0445 \u043d\u043e\u0432\u044b \u045e \u043d\u0443\u0442\u0440\u043e \u0456\u0445\u043d\u044f\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u0447\u044b\u043d\u0456\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"254","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">37, 1-14<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0411\u044b\u043b\u0430 \u043d\u0430 \u043c\u043d\u0435 \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430. \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u043c\u044f\u043d\u0435 \u045e \u0434\u0443\u0445\u0443 \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0441\u044f\u0440\u043e\u0434 \u0434\u0430\u043b\u0456\u043d\u044b, \u043f\u043e\u045e\u043d\u0430\u0439 \u043a\u0430\u0441\u0446\u0435\u0439. \u0410\u0431\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u0432\u0430\u043a\u043e\u043b \u0456\u0445, \u0430 \u0431\u044b\u043b\u043e \u0456\u0445 \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442 \u0456\u0445 \u043b\u044f\u0436\u0430\u043b\u0430 \u043d\u0430 \u0430\u0431\u0448\u0430\u0440\u044b \u0434\u0430\u043b\u0456\u043d\u044b, \u0456 \u0431\u044b\u043b\u0456 \u044f\u043d\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u0443\u0445\u0456\u044f. \u0406 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u0401\u043d \u0443 \u043c\u044f\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0446\u0456 \u0430\u0436\u044b\u0432\u0443\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u043a\u043e\u0441\u0446\u0456?\u00bb \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430\u00bb. \u0410 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u041f\u0440\u0430\u0440\u043e\u0447 \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c\u0456 \u043a\u0430\u0441\u0446\u044f\u043c\u0456 \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u041a\u043e\u0441\u0446\u0456 \u0441\u0443\u0445\u0456\u044f, \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0433\u044d\u0442\u044b\u043c \u043a\u0430\u0441\u0446\u044f\u043c: \u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0448\u043b\u044e \u0432\u0430\u043c \u0434\u0443\u0445\u0430, \u0456 \u0430\u0436\u044b\u0432\u044f\u0446\u0435. \u0406 \u0434\u0430\u043c \u0432\u0430\u043c \u0436\u044b\u043b\u044b, \u0456 \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u0432\u044b\u0440\u0430\u0441\u0446\u0435 \u043d\u0430 \u0432\u0430\u0441 \u0446\u0435\u043b\u0430, \u0456 \u0430\u0431\u0446\u044f\u0433\u043d\u0443 \u0432\u0430\u0441 \u0441\u043a\u0443\u0440\u0430\u044e, \u0456 \u043f\u0430\u0448\u043b\u044e \u0432\u0430\u043c \u0434\u0443\u0445\u0430, \u0456 \u0430\u0436\u044b\u0432\u044f\u0446\u0435, \u0456 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u042f \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u044f\u043a \u0431\u044b\u043b\u043e \u043c\u043d\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0430. \u0410 \u043a\u0430\u043b\u0456 \u044f \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e, \u0443\u0437\u043d\u044f\u045e\u0441\u044f \u0448\u0443\u043c \u0456 \u0442\u0440\u044d\u0441\u043a, \u0456 \u043a\u043e\u0441\u0446\u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0437\u0431\u043b\u0456\u0436\u0430\u0446\u0446\u0430, \u043a\u043e\u0441\u0446\u044c \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043a\u043e\u0441\u0446\u0456. \u0406 \u0431\u0430\u0447\u044b\u045e \u044f, \u044f\u043a \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u0456\u0445 \u0436\u044b\u043b\u044b \u0456 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0446\u0435\u043b\u0430, \u0430 \u0441\u043a\u0443\u0440\u0430 \u043f\u0430\u043a\u0440\u044b\u043b\u0430 \u0456\u0445 \u0437\u0432\u0435\u0440\u0445\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0456\u0445 \u0434\u0443\u0445\u0430. \u0422\u0430\u0434\u044b \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u041f\u0440\u0430\u0440\u043e\u0447 \u0434\u0430 \u0434\u0443\u0445\u0430, \u043f\u0440\u0430\u0440\u043e\u0447, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0456 \u0441\u043a\u0430\u0436\u044b \u0434\u0443\u0445\u0443: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0410\u0434 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0432\u044f\u0442\u0440\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0456, \u0434\u0443\u0445, \u0456 \u0434\u044b\u0445\u043d\u0456 \u043d\u0430 \u0433\u044d\u0442\u044b\u0445 \u0437\u0430\u0431\u0456\u0442\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0436\u044b\u043b\u0456\u00bb. \u042f \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e, \u044f\u043a \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435. \u0410 \u0434\u0443\u0445 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0456\u0445, \u0456 \u044f\u043d\u044b \u0430\u0436\u044b\u043b\u0456, \u0456 \u0441\u0442\u0430\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u043d\u043e\u0433\u0456 \u2013 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0433\u044d\u0442\u044b\u044f \u043a\u043e\u0441\u0446\u0456 \u2013 \u0433\u044d\u0442\u0430 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0412\u043e\u0441\u044c \u044f\u043d\u044b \u043a\u0430\u0436\u0443\u0446\u044c: \u201c\u0412\u044b\u0441\u0430\u0445\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u043a\u043e\u0441\u0446\u0456, \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u043d\u0430\u043c \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c\u201d. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0440\u043e\u0447 \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0412\u043e\u0441\u044c \u042f \u0430\u0434\u043a\u0440\u044b\u044e \u0432\u0430\u0448\u044b\u044f \u043c\u0430\u0433\u0456\u043b\u044b, \u0456 \u0432\u044b\u0432\u0435\u0434\u0443 \u0432\u0430\u0441, \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0437 \u043c\u0430\u0433\u0456\u043b\u0430\u045e \u0432\u0430\u0448\u044b\u0445, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0432\u0430\u0441 \u0443 \u0437\u044f\u043c\u043b\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u044e \u0432\u0430\u0448\u044b\u044f \u043c\u0430\u0433\u0456\u043b\u044b \u0456 \u0432\u044b\u0432\u0435\u0434\u0443 \u0432\u0430\u0441, \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u041c\u043e\u0439, \u0437 \u043c\u0430\u0433\u0456\u043b\u0430\u045e \u0432\u0430\u0448\u044b\u0445. \u0406 \u045e\u0434\u044b\u0445\u043d\u0443 \u045e \u0432\u0430\u0441 \u041c\u043e\u0439 \u0434\u0443\u0445, \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0436\u044b\u0446\u044c \u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0432\u0430\u0448\u0430\u0439, \u0456 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f, \u041f\u0430\u043d, \u0441\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430 \u0456 \u0437\u0440\u0430\u0431\u043b\u044e\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 37, 12b. 13a; \u042f\u043d 11, 25<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u042f \u0430\u0434\u043a\u0440\u044b\u044e \u0432\u0430\u0448\u044b\u044f \u043c\u0430\u0433\u0456\u043b\u044b, \u0456 \u0432\u044b\u0432\u0435\u0434\u0443 \u0432\u0430\u0441, \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0437 \u043c\u0430\u0433\u0456\u043b\u0430\u045e \u0432\u0430\u0448\u044b\u0445. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0406 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u2013 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451. \u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u043f\u0430\u043c\u0440\u044d, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"255","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">37, 15-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042e\u0434\u044b<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0410 \u0442\u044b, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0432\u0430\u0437\u044c\u043c\u0456 \u0441\u0430\u0431\u0435 \u0430\u0434\u0437\u0456\u043d \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0434\u0440\u044d\u0432\u0430 \u0456 \u043d\u0430\u043f\u0456\u0448\u044b \u043d\u0430 \u0456\u043c: \u201c\u0414\u043b\u044f \u042e\u0434\u044b \u0456 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u0433\u043e\u043d\u044b\u0445 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e\u201d. \u0412\u0430\u0437\u044c\u043c\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0434\u0440\u044d\u0432\u0430 \u0456 \u043d\u0430\u043f\u0456\u0448\u044b \u043d\u0430 \u0456\u043c: \u201c\u0414\u043b\u044f \u042e\u0437\u0430\u0444\u0430, \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0434\u0440\u044d\u0432\u0430 \u042d\u0444\u0440\u0430\u0456\u043c\u0430, \u0456 \u045e\u0441\u044f\u0433\u043e \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u044f\u0433\u043e\u043d\u044b\u0445 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e\u201d. \u041f\u0430\u0441\u043b\u044f \u0437\u043b\u0443\u0447\u044b \u0456\u0445 \u0430\u0434\u043d\u043e \u0437 \u0434\u0440\u0443\u0433\u0456\u043c \u0443 \u0430\u0434\u0437\u0456\u043d \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0434\u0440\u044d\u0432\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u044b\u043c \u0443 \u0442\u0432\u0430\u0451\u0439 \u0440\u0443\u0446\u044d. \u0410 \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0442\u0430\u0431\u0435 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443: \u201c\u0426\u0456 \u043d\u0435 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0448 \u043d\u0430\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435?\u201d, \u0430\u0434\u043a\u0430\u0436\u044b \u0456\u043c: \u201c\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0412\u043e\u0441\u044c \u042f \u0432\u0430\u0437\u044c\u043c\u0443 \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0434\u0440\u044d\u0432\u0430 \u042e\u0437\u0430\u0444\u0430, \u044f\u043a\u043e\u0435 \u045e \u0440\u0443\u0446\u044d \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u0433\u043e\u043d\u044b\u0445 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u0456 \u043f\u0440\u044b\u043c\u0430\u0446\u0443\u044e \u0434\u0430 \u0434\u0440\u044d\u0432\u0430 \u042e\u0434\u044b, \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0437 \u0456\u0445 \u0430\u0434\u0437\u0456\u043d \u043a\u0430\u0432\u0430\u043b\u043a\u0430\u043c \u0434\u0440\u044d\u0432\u0430, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043d\u044b \u0430\u0434\u043d\u044b\u043c \u0443 \u041c\u0430\u0451\u0439 \u0440\u0443\u0446\u044d\u201d. \u041a\u0430\u0432\u0430\u043b\u043a\u0456 \u0434\u0440\u044d\u0432\u0430, \u043d\u0430 \u044f\u043a\u0456\u0445 \u043d\u0430\u043f\u0456\u0448\u0430\u0448, \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0442\u0432\u0430\u0451\u0439 \u0440\u0443\u0446\u044d \u043f\u0435\u0440\u0430\u0434 \u0456\u0445\u043d\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u0442\u044b \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u201c\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0412\u043e\u0441\u044c \u042f \u0432\u0430\u0437\u044c\u043c\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0443\u0434\u044b \u044f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456, \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u045e \u0456\u0445\u043d\u044e\u044e \u0437\u044f\u043c\u043b\u044e. \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0456\u0445 \u0430\u0434\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0430\u0434\u0437\u0456\u043d \u043a\u0430\u0440\u043e\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0456\u0445 \u0443\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0456 \u044f\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0432\u0443\u043c\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u044b\u044f \u043d\u0430 \u0434\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0406 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456\u0434\u0430\u043b\u0430\u043c\u0456, \u043d\u0456 \u0431\u0440\u044b\u0434\u043e\u0442\u0430\u0439 \u0441\u0432\u0430\u0451\u0439, \u043d\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c\u0456 \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456. \u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0456\u0445 \u0437 \u0443\u0441\u0456\u0445 \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430\u045e, \u0434\u0437\u0435 \u044f\u043d\u044b \u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u0456 \u0430\u0447\u044b\u0448\u0447\u0443 \u0456\u0445. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u0414\u0430\u0432\u0456\u0434, \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0456\u0445 \u0443\u0441\u0456\u0445. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0456\u0445 \u0437\u0430\u043a\u043e\u043d\u0430\u045e, \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u041c\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445. \u0411\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u045e \u0441\u043b\u0443\u0437\u0435 \u041c\u0430\u0439\u043c\u0443 \u042f\u043a\u0443\u0431\u0443, \u043d\u0430 \u044f\u043a\u043e\u0439 \u0436\u044b\u043b\u0456 \u0456\u0445\u043d\u0456\u044f \u0431\u0430\u0446\u044c\u043a\u0456. \u0411\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u043d\u0430 \u0451\u0439 \u044f\u043d\u044b \u0456 \u0441\u044b\u043d\u044b \u0456\u0445\u043d\u0456\u044f, \u0456 \u0441\u044b\u043d\u044b \u0441\u044b\u043d\u043e\u045e \u0456\u0445 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410 \u0414\u0430\u0432\u0456\u0434, \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437 \u0456\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0441\u043f\u0430\u043a\u043e\u044e: \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0456\u043c\u0456. \u042f \u045e\u043c\u0430\u0446\u0443\u044e \u0456\u0445 \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u0443, \u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u041c\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043d\u0430\u0432\u0435\u043a\u0456. \u0416\u044b\u043b\u043b\u0451 \u041c\u0430\u0451 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u042f \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0406 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u043a\u0430\u043b\u0456 \u041c\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0448\u0442\u043e \u042f, \u041f\u0430\u043d, \u044f\u043a\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044c\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 37, 21. 22\u0430; \u042f\u043d 10, 16b. 11b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u042f \u0432\u0430\u0437\u044c\u043c\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0430\u0434\u0443\u0441\u044e\u043b\u044c, \u0456 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0456\u0445 \u0430\u0434\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0430\u0434\u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>I \u0431\u0443\u0434\u0437\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"256","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">40, 1-4; 43, 1-12; 44, 6-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0430\u0434\u0431\u0443\u0434\u043e\u0432\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u044f\u0442\u044b \u0433\u043e\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u044f, \u0443 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0433\u043e\u0434\u0430, \u0443 \u0434\u0437\u0435\u0441\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430, \u0443 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0433\u043e\u0434 \u043f\u0430\u0441\u043b\u044f \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u043e\u0440\u0430\u0434\u0430, \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u044b\u043b\u0430 \u043d\u0430 \u043c\u043d\u0435 \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u044b\u0432\u044f\u043b\u0430 \u043c\u044f\u043d\u0435 \u0442\u0443\u0434\u044b. \u0423 \u0411\u043e\u0436\u044b\u0445 \u0432\u0456\u0437\u0456\u044f\u0445 \u0401\u043d \u043f\u0435\u0440\u0430\u043d\u0451\u0441 \u043c\u044f\u043d\u0435 \u045e \u0437\u044f\u043c\u043b\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044b\u0441\u043e\u043a\u0430\u0439 \u0433\u0430\u0440\u044b. \u0410 \u043d\u0430 \u0451\u0439 \u0437 \u043f\u043e\u045e\u0434\u043d\u044f \u0431\u044b\u043b\u0456 \u044f\u043a \u0431\u044b \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0456\u044f \u043f\u0430\u0431\u0443\u0434\u043e\u0432\u044b. \u0401\u043d \u0443\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u0442\u0443\u0434\u044b. \u0406 \u0432\u043e\u0441\u044c \u0431\u044b\u045e \u0442\u0430\u043c \u043c\u0443\u0436, \u044f\u043a\u0456 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0431\u044b\u045e \u043d\u0456\u0431\u044b \u0437 \u043c\u0435\u0434\u0437\u0456. \u0423 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u0446\u044d \u0451\u043d \u0442\u0440\u044b\u043c\u0430\u045e \u0456\u043b\u044c\u043d\u044f\u043d\u044b \u0448\u043d\u0443\u0440 \u0456 \u043c\u0435\u0440\u043d\u044b \u043a\u0456\u0439, \u0430 \u0441\u0442\u0430\u044f\u045e \u0451\u043d \u0443 \u0431\u0440\u0430\u043c\u0435. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0442\u043e\u0439 \u043c\u0443\u0436: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0443\u0448\u0430\u043c\u0456, \u0437\u0432\u0430\u0436\u0430\u0439 \u0434\u0430\u043a\u043b\u0430\u0434\u0430\u043d\u0430 \u043d\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u042f \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435, \u0431\u043e \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0442\u044b \u0431\u044b\u045e \u043f\u0440\u044b\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u0441\u044e\u0434\u044b. \u0420\u0430\u0441\u043a\u0430\u0436\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u0448\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0431\u0440\u0430\u043c\u044b, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0430 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434. \u0406 \u0432\u043e\u0441\u044c \u0441\u043b\u0430\u0432\u0430 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456\u0448\u043b\u0430 \u0437 \u0443\u0441\u0445\u043e\u0434\u0443, \u0430 \u0448\u0443\u043c \u044f\u0435 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u045e \u0448\u0443\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0432\u043e\u0434\u0430\u045e, \u0456 \u0437\u044f\u043c\u043b\u044f \u0437\u0437\u044f\u043b\u0430 \u0430\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u0413\u044d\u0442\u0430 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043b\u0430 \u044f\u043a \u0432\u0456\u0437\u0456\u044f, \u044f\u043a\u0443\u044e \u0431\u0430\u0447\u044b\u045e \u044f, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0433\u043e\u0440\u0430\u0434, \u0456 \u044f\u043a \u0432\u0456\u0437\u0456\u044f, \u044f\u043a\u0443\u044e \u044f \u0431\u0430\u0447\u044b\u045e \u043d\u0430\u0434 \u0440\u0430\u043a\u043e\u044e \u041a\u0435\u0431\u0430\u0440. \u0406 \u044f \u045e\u043f\u0430\u045e \u043d\u0430 \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043f\u0440\u0430\u0437 \u0443\u0441\u0445\u043e\u0434\u043d\u044e\u044e \u0431\u0440\u0430\u043c\u0443, \u0442\u0430\u0434\u044b \u0434\u0443\u0445 \u043f\u0430\u0434\u043d\u044f\u045e \u043c\u044f\u043d\u0435 \u0456 \u045e\u0432\u0451\u045e \u0432\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446. \u0422\u0430\u0434\u044b \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u0406 \u044f \u043f\u0430\u0447\u0443\u045e, \u044f\u043a \u043d\u0435\u0445\u0442\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0430 \u0442\u043e\u0439 \u043c\u0443\u0436 \u0441\u0442\u0430\u044f\u045e \u043a\u0430\u043b\u044f \u043c\u044f\u043d\u0435. \u0406 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0433\u044d\u0442\u0430 \u043c\u0435\u0441\u0446\u0430 \u041c\u0430\u0439\u0433\u043e \u0442\u0440\u043e\u043d\u0430 \u0456 \u043c\u0435\u0441\u0446\u0430 \u0441\u0442\u0443\u043f\u043d\u0435\u0439 \u041c\u0430\u0456\u0445 \u043d\u043e\u0433, \u0434\u0437\u0435 \u042f \u043f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0414\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u2013 \u043d\u0456 \u044f\u043d\u044b, \u043d\u0456 \u043a\u0430\u0440\u0430\u043b\u0456 \u0456\u0445\u043d\u0456\u044f \u2013 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u044f\u0446\u044c \u041c\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0456\u043c\u044f \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0430\u0439 \u0456 \u0442\u0440\u0443\u043f\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0437\u0432\u044b\u0448\u0448\u0430\u043c\u0456, \u0431\u043e \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u0441\u0432\u043e\u0439 \u043f\u0430\u0440\u043e\u0433 \u043f\u043e\u0431\u0430\u0447 \u0437 \u041c\u0430\u0456\u043c \u043f\u0430\u0440\u043e\u0433\u0430\u043c \u0456 \u0441\u0432\u0430\u0435 \u0432\u0443\u0448\u0430\u043a\u0456 \u043f\u043e\u0431\u0430\u0447 \u0437 \u041c\u0430\u0456\u043c\u0456 \u0432\u0443\u0448\u0430\u043a\u0430\u043c\u0456, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0446\u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u043c\u0456\u0436 \u041c\u043d\u043e\u044e \u0434\u044b \u0456\u043c\u0456. \u042f\u043d\u044b \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u043b\u0456 \u041c\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f \u0441\u0432\u0430\u0451\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u0430\u0439, \u044f\u043a\u0443\u044e \u0447\u044b\u043d\u0456\u043b\u0456, \u0442\u0430\u043c\u0443 \u042f \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0456\u0445 \u0443 \u0441\u0432\u0430\u0456\u043c \u0433\u043d\u0435\u0432\u0435. \u0426\u044f\u043f\u0435\u0440 \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041c\u044f\u043d\u0435 \u0441\u0432\u0430\u044e \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0456 \u0442\u0440\u0443\u043f\u044b \u0441\u0432\u0430\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u2013 \u0456 \u042f \u043f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043d\u0430\u0432\u0435\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u044b, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0430\u043a\u0430\u0436\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0433\u044d\u0442\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u041d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u043f\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0456 \u0432\u044b\u043c\u0435\u0440\u0430\u044e\u0446\u044c \u044f\u0435 \u043f\u043b\u0430\u043d. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0446\u0446\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u0434\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456\u043c \u043f\u043b\u0430\u043d \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u044f\u0435 \u043f\u0430\u043c\u0435\u0440\u044b, \u044f\u0435 \u0432\u044b\u0445\u0430\u0434\u044b \u0456 \u045e\u0432\u0430\u0445\u043e\u0434\u044b, \u0443\u0432\u0435\u0441\u044c \u044f\u0435 \u043f\u043b\u0430\u043d \u0456 \u045e\u0441\u0435 \u044f\u0435 \u0437\u0432\u044b\u0447\u0430\u0456, \u0443\u0441\u0435 \u044f\u0435 \u043f\u043b\u0430\u043d\u044b \u0456 \u045e\u0441\u0435 \u044f\u0435 \u0437\u0430\u043a\u043e\u043d\u044b, \u0456 \u0432\u044b\u043f\u0456\u0448\u044b \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u0456\u0445\u043d\u0456\u0445 \u0432\u0430\u0447\u044d\u0439. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u043f\u043b\u0430\u043d \u044f\u0435 \u0456 \u045e\u0441\u0435 \u0437\u0432\u044b\u0447\u0430\u0456 \u044f\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0456\u0445. \u0413\u044d\u0442\u0430 \u0437\u0430\u043a\u043e\u043d \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u041d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b \u045e\u0432\u0435\u0441\u044c \u0430\u0431\u0448\u0430\u0440 \u0432\u0430\u043a\u043e\u043b \u044f\u0435 \u2013 \u0441\u0432\u044f\u0442\u044b. \u0412\u043e\u0441\u044c \u0433\u044d\u0442\u0430 \u0437\u0430\u043a\u043e\u043d \u0441\u0432\u044f\u0442\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043a\u0430\u0436\u044b \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u043c\u0443 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u0425\u043e\u043f\u0456\u0446\u044c \u0443\u0436\u043e \u045e\u0441\u0451\u0439 \u0432\u0430\u0448\u0430\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u044b, \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f! \u041a\u0430\u043b\u0456 \u0432\u044b \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u0435 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e, \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 \u0446\u0435\u043b\u0430\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u043b\u0456 \u044f\u0435, \u041c\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u0430\u0448\u0430\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u041c\u0430\u0439\u0433\u043e \u0445\u043b\u0435\u0431\u0430, \u0442\u043b\u0443\u0448\u0447\u0443 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0432\u044b \u0437\u043b\u0430\u043c\u0430\u043b\u0456 \u041c\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u0441\u0451\u0439 \u0432\u0430\u0448\u0430\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u044b. \u0412\u044b \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u041c\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456 \u0456\u0445 \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u041c\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u045e \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u041d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0435\u0446 \u0437 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u043c \u0446\u0435\u043b\u0430\u043c \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u041c\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0435\u0446, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 43, 4. 5; \u043f\u0430\u0440. \u041b\u043a 2, 22<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043f\u0440\u0430\u0437 \u0443\u0441\u0445\u043e\u0434\u043d\u044e\u044e \u0431\u0440\u0430\u043c\u0443. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0406 \u0432\u043e\u0441\u044c \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0441\u043b\u0430\u0432\u0430\u044e \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u0430\u0446\u044c\u043a\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0414\u0437\u0456\u0446\u044f\u0442\u043a\u0430 \u0415\u0437\u0443\u0441\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0432\u043e\u0441\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"257","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">47, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0448\u0442\u043e \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0410\u043d\u0451\u043b \u0432\u044f\u0440\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u0406 \u0432\u043e\u0441\u044c \u0437-\u043f\u0430\u0434 \u043f\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0432\u044b\u0446\u044f\u043a\u0430\u043b\u0430 \u0432\u0430\u0434\u0430 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434, \u0431\u043e \u0442\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0431\u044b\u043b\u0430 \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0430 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434. \u0412\u0430\u0434\u0430 \u0432\u044b\u0446\u044f\u043a\u0430\u043b\u0430 \u0437-\u043f\u0430\u0434 \u043f\u0440\u0430\u0432\u0430\u0439 \u0441\u0446\u044f\u043d\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0437 \u043f\u0430\u045e\u0434\u043d\u0451\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0430\u043b\u0442\u0430\u0440\u0430. \u0417\u0430\u0442\u044b\u043c \u0451\u043d \u0432\u044b\u0432\u0435\u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u045e\u043d\u043e\u0447\u043d\u0443\u044e \u0431\u0440\u0430\u043c\u0443 \u0456 \u043f\u0430\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u0432\u0430\u043a\u043e\u043b \u0437\u0432\u043e\u043d\u043a\u0443 \u0434\u0430 \u0437\u043d\u0435\u0448\u043d\u044f\u0439 \u0431\u0440\u0430\u043c\u044b, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430\u0439 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434. \u0406 \u0432\u043e\u0441\u044c \u0432\u0430\u0434\u0430 \u0431\u0440\u0443\u0456\u043b\u0430\u0441\u044f \u0437 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0430 \u0448\u043d\u0443\u0440\u0430\u043c \u0443 \u0440\u0443\u0446\u044d \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430 \u045e\u0441\u0445\u043e\u0434. \u0401\u043d \u0430\u0434\u043c\u0435\u0440\u0430\u045e \u0442\u044b\u0441\u044f\u0447\u0443 \u043b\u043e\u043a\u0446\u044f\u045e \u0456 \u043f\u0440\u0430\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443. \u0412\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430 \u0448\u0447\u044b\u043a\u0430\u043b\u0430\u0442\u043a\u0456. \u0417\u0430\u0442\u044b\u043c \u0430\u0434\u043c\u0435\u0440\u0430\u045e \u044f\u0448\u0447\u044d \u0442\u044b\u0441\u044f\u0447\u0443 <\/span><span style=\"font-style: italic;\">\u043b\u043e\u043a\u0446\u044f\u045e<\/span><span> \u0456 \u043f\u0440\u0430\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443. \u0412\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430 \u043a\u0430\u043b\u0435\u043d\u0456. \u0417\u0430\u0442\u044b\u043c \u0430\u0434\u043c\u0435\u0440\u0430\u045e \u044f\u0448\u0447\u044d \u0442\u044b\u0441\u044f\u0447\u0443 \u0456 \u043f\u0440\u0430\u0432\u0451\u045e \u043c\u044f\u043d\u0435. \u0412\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430 \u0441\u0446\u0451\u0433\u043d\u044b. \u0417\u0430\u0442\u044b\u043c \u0430\u0434\u043c\u0435\u0440\u0430\u045e \u044f\u0448\u0447\u044d \u0442\u044b\u0441\u044f\u0447\u0443, \u0456 \u0431\u044b\u045e \u043f\u0430\u0442\u043e\u043a, \u044f\u043a\u043e\u0433\u0430 \u044f \u043d\u0435 \u043c\u043e\u0433 \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456, \u0431\u043e \u0432\u0430\u0434\u0430 \u043f\u0430\u0434\u043d\u044f\u043b\u0430\u0441\u044f, \u0442\u0430\u043a \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043f\u043b\u044b\u0441\u0446\u0456, \u043f\u0430\u0442\u043e\u043a, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456. \u0406 \u0451\u043d \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u043c\u044f\u043d\u0435: \u00ab\u0426\u0456 \u0431\u0430\u0447\u044b\u045e \u0442\u044b \u0433\u044d\u0442\u0430, \u0441\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b?\u00bb \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u043d\u0430\u0437\u0430\u0434 \u0434\u0430 \u0431\u0435\u0440\u0430\u0433\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0442\u043e\u043a\u0443. \u041a\u0430\u043b\u0456 \u044f \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u043d\u0430 \u0430\u0434\u043d\u044b\u043c \u0456 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u0431\u0435\u0440\u0430\u0437\u0435 \u043f\u0430\u0442\u043e\u043a\u0443 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442 \u0434\u0440\u044d\u0432\u0430\u045e. \u0406 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0413\u044d\u0442\u044b\u044f \u0432\u043e\u0434\u044b \u043f\u043b\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u045e\u0441\u0445\u043e\u0434\u043d\u0456 \u0430\u0431\u0448\u0430\u0440, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u0410\u0440\u0430\u0431\u044b \u0456 \u045e\u043f\u0430\u0434\u0430\u044e\u0446\u044c \u0443 \u043c\u043e\u0440\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0442\u0440\u0430\u043f\u043b\u044f\u044e\u0446\u044c \u0443 \u043c\u043e\u0440\u0430, \u044f\u0433\u043e \u0432\u043e\u0434\u044b \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u044e\u0446\u0446\u0430. \u0406 \u043a\u043e\u0436\u043d\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430, \u044f\u043a\u0430\u044f \u043a\u0456\u0448\u044b\u0446\u044c \u0442\u0430\u043c, \u043a\u0443\u0434\u044b \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u043f\u0430\u0442\u043e\u043a, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c. \u0406 \u0440\u044b\u0431\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442, \u0431\u043e \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0442\u0443\u0434\u044b \u0433\u044d\u0442\u044b\u044f \u0432\u043e\u0434\u044b \u0456 \u045e\u0441\u0451 \u0431\u0443\u0434\u0437\u0435 \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u0430. \u0406 \u0442\u0430\u043c, \u043a\u0443\u0434\u044b \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u0433\u044d\u0442\u044b \u043f\u0430\u0442\u043e\u043a, \u0443\u0441\u0451 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0443\u0446\u044c \u0441\u0442\u0430\u044f\u0446\u044c \u043a\u0430\u043b\u044f \u044f\u0433\u043e \u0440\u044b\u0431\u0430\u043a\u0456, \u0430\u0434 \u042d\u043d-\u0413\u044d\u0434\u0437\u0456 \u0430\u0436 \u0434\u0430 \u042d\u043d-\u042d\u0433\u043b\u044f\u0456\u043c\u0430, \u0456 \u0440\u0430\u0441\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0441\u0435\u0442\u043a\u0456. \u0411\u0443\u0434\u0437\u0435 \u0442\u0430\u043c \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442 \u0440\u043e\u0437\u043d\u044b\u0445 \u0433\u0430\u0442\u0443\u043d\u043a\u0430\u045e \u0440\u044b\u0431, \u044f\u043a \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043c\u043e\u0440\u044b. \u0410\u0434\u043d\u0430\u043a \u044f\u0433\u043e \u0434\u0440\u044b\u0433\u0432\u0430 \u0456 \u0440\u0430\u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u044b\u044f. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u0441\u043e\u043b\u0456. \u0410 \u043d\u0430\u0434 \u043f\u0430\u0442\u043e\u043a\u0430\u043c, \u043d\u0430 \u0430\u0434\u043d\u044b\u043c \u0456 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u044f\u0433\u043e \u0431\u0435\u0440\u0430\u0437\u0435, \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0441\u0446\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043f\u043b\u0430\u0434\u043e\u0432\u0430\u0435 \u0434\u0440\u044d\u0432\u0430. \u041b\u0456\u0441\u0446\u0435 \u044f\u0433\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043d\u0443\u0446\u044c, \u0430 \u043f\u043b\u0430\u0434\u044b \u044f\u0433\u043e \u043d\u0435 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u0446\u0430. \u041a\u043e\u0436\u043d\u044b \u043c\u0435\u0441\u044f\u0446 \u044f\u043d\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0430\u0434\u044b, \u0431\u043e \u0432\u043e\u0434\u044b \u043f\u0430\u0442\u043e\u043a\u0443 \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u044e\u0446\u044c \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u041f\u043b\u043e\u0434 \u044f\u0433\u043e \u0431\u0443\u0434\u0437\u0435 \u0435\u0436\u0430\u044e, \u0430 \u043b\u0456\u0441\u0446\u0435 \u2013 \u043b\u0435\u043a\u0430\u043c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0437\u0445 47, 1. 9; \u043f\u0430\u0440. \u042f\u043d 4, 14<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0432\u0430\u0434\u0443, \u044f\u043a\u0430\u044f \u0432\u044b\u0446\u044f\u043a\u0430\u043b\u0430 \u0437-\u043f\u0430\u0434 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u043e\u0436\u043d\u044b, \u043a\u0430\u0433\u043e \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0433\u044d\u0442\u044b \u043f\u0430\u0442\u043e\u043a, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u044f\u043c\u0443, \u0441\u0442\u0430\u043d\u0435 \u045e \u0456\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u043e\u0436\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"261","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">1, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435. \u041f\u0430\u0434\u0437\u044f\u043a\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0432\u0435\u043b \u0456 \u0426\u0456\u043c\u0430\u0444\u0435\u0439, \u0441\u043b\u0443\u0433\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u0441\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0424\u0456\u043b\u0456\u043f\u0430\u0445, \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456 \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456: \u043b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u044f\u043a\u0443\u044e \u043c\u0430\u0439\u043c\u0443 \u0411\u043e\u0433\u0443 \u043f\u0440\u044b \u043a\u043e\u0436\u043d\u0430\u0439 \u0437\u0433\u0430\u0434\u0446\u044b \u043f\u0440\u0430 \u0432\u0430\u0441. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u0432\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441 \u044f \u045e\u0437\u043d\u043e\u0448\u0443 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0437\u0430 \u0432\u0430\u0448 \u0443\u0434\u0437\u0435\u043b \u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0437 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u043d\u044f \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c. \u0423\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0447\u0430\u045e \u0443 \u0432\u0430\u0441 \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u044f\u0435 \u0434\u0430 \u0434\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0406 \u0433\u044d\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0446\u044c \u043f\u0440\u0430 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441, \u0431\u043e \u0432\u044b \u2013 \u0443 \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0456 \u045e\u0441\u0435 \u0432\u044b \u043c\u0430\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u045e \u043c\u0430\u0451\u0439 \u043b\u0430\u0441\u0446\u044b, \u0443 \u043c\u0430\u0456\u0445 \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445, \u0443 \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u0456 \u0432\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0411\u043e\u0433 \u2013 \u043c\u043e\u0439 \u0441\u0432\u0435\u0434\u043a\u0430, \u0448\u0442\u043e \u044f \u043b\u044e\u0431\u043b\u044e \u045e\u0441\u0456\u0445 \u0432\u0430\u0441 \u043b\u044e\u0431\u043e\u045e\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u043c\u0430\u043b\u044e\u0441\u044f, \u043a\u0430\u0431 \u0432\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0456 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u043b\u0435\u043f\u0448\u0430\u0435, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u043f\u043b\u0430\u0434\u0430\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0456 \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0436\u0430\u0439.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0424\u043b\u043f 1, 9. 10\u0430. 6<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0456 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0456,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u043b\u0435\u043f\u0448\u0430\u0435, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0447\u0430\u045e \u0443 \u0432\u0430\u0441 \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u044f\u0435 \u0434\u0430 \u0434\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u0432\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"262","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">1, 12-26<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0432\u0435\u043b \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u043c<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0425\u0430\u0447\u0443, \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u043c\u0430\u0451 \u0433\u0430\u043d\u0435\u043d\u043d\u0435 \u043f\u0430\u0441\u043f\u0440\u044b\u044f\u043b\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u043c\u0443 \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0422\u0430\u043a \u0448\u0442\u043e \u043c\u0430\u0435 \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0431\u0430\u0447\u043d\u044b\u043c\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0440\u044d\u0442\u043e\u0440\u044b\u0456 \u0456 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u0431\u0440\u0430\u0442\u043e\u045e \u0443 \u041f\u0430\u043d\u0443, \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f \u043c\u0430\u0456\u043c\u0456 \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u043c\u0456, \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0432\u0430\u0436\u044b\u043b\u0456\u0441\u044f \u0431\u044f\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f, \u043f\u0440\u0430\u045e\u0434\u0430, \u0430\u0434 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0456\u043d\u0448\u044b\u044f \u0436 \u2013 \u0437 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456. \u0413\u044d\u0442\u044b\u044f \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u0440\u043e\u0431\u044f\u0446\u044c \u0433\u044d\u0442\u0430 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u044f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0422\u044b\u044f \u0436 \u0434\u0437\u0435\u043b\u044f \u0437\u0432\u0430\u0434\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u044f\u0448\u0447\u044b\u0440\u0430, \u0437 \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u0430\u0435 \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u044f\u0448\u0447\u044d \u0446\u044f\u0436\u044d\u0439\u0448\u044b\u043c\u0456. \u0414\u044b\u043a \u0448\u0442\u043e? \u0423\u0441\u044f\u043b\u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0446\u0456 \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u0446\u0456 \u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0406 \u044f \u0433\u044d\u0442\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0456 \u0431\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430. \u0411\u043e \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u043c\u044f\u043d\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0432\u0430\u0448\u0443\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0414\u0443\u0445\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0447\u0430\u043a\u0430\u043d\u043d\u044f \u0456 \u043c\u0430\u0451\u0439 \u043d\u0430\u0434\u0437\u0435\u0456, \u0448\u0442\u043e \u044f \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b. \u0410\u043b\u0435 \u0437 \u043f\u043e\u045e\u043d\u0430\u0439 \u0430\u0434\u0432\u0430\u0433\u0430\u0439, \u044f\u043a \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0442\u0430\u043a \u0456 \u0441\u0451\u043d\u043d\u044f, \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c \u0446\u0456 \u043f\u0440\u0430\u0437 \u0436\u044b\u0446\u0446\u0451, \u0446\u0456 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u045e \u0446\u0435\u043b\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043f\u043b\u0451\u043d \u043f\u0440\u0430\u0446\u044b, \u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u044b\u0431\u0440\u0430\u0446\u044c. \u0412\u0430\u0431\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0456 \u0442\u043e\u0435, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435: \u043c\u0430\u044e \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0431\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u043d\u0430 \u043b\u0435\u043f\u0448; \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0434\u043b\u044f \u0432\u0430\u0441. \u041f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b \u045e \u0433\u044d\u0442\u044b\u043c, \u044f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0441\u044f \u0456 \u0431\u0443\u0434\u0443 \u0437 \u0432\u0430\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u045e \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u0445\u0432\u0430\u043b\u0430 \u0432\u0430\u0448\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0432\u0430\u0441.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 1, 19. 20. 21&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d<\/span><span> \u0412\u0435\u0434\u0430\u044e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0447\u0430\u043a\u0430\u043d\u043d\u044f \u0456 \u043c\u0430\u0451\u0439 \u043d\u0430\u0434\u0437\u0435\u0456, \u0448\u0442\u043e \u044f \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b. \u0410\u043b\u0435 \u0437 \u043f\u043e\u045e\u043d\u0430\u0439 \u0430\u0434\u0432\u0430\u0433\u0430\u0439, \u044f\u043a \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0442\u0430\u043a \u0456 \u0441\u0451\u043d\u043d\u044f, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c \u0446\u0456 \u043f\u0440\u0430\u0437 \u0436\u044b\u0446\u0446\u0451, \u0446\u0456 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"263","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e  1, 27 \u2013 2, 11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u0430\u0445\u0432\u043e\u0442\u0430 \u0434\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u0434\u0437\u0456\u0446\u0435 \u0436\u044b\u0446\u0446\u0451, \u0433\u043e\u0434\u043d\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043a\u0430\u0431 \u044f, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0431\u0443\u0434\u0443 \u0456 \u045e\u0431\u0430\u0447\u0443 \u0432\u0430\u0441 \u0446\u0456 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0434\u0430\u043b\u0451\u043a\u0430, \u043f\u0430\u0447\u0443\u045e \u043f\u0440\u0430 \u0432\u0430\u0441, \u0448\u0442\u043e \u0432\u044b \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u0430\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u0443. \u0410\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0456 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e. \u0413\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0456\u0445 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0437\u0433\u0443\u0431\u044b, \u0430 \u0434\u043b\u044f \u0432\u0430\u0441 \u2013 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0456 \u0433\u044d\u0442\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430. \u0412\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u042f\u0433\u043e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0432\u044f\u0434\u0437\u0435\u0446\u0435 \u0442\u0443\u044e \u0436 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443, \u044f\u043a\u0443\u044e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0456 \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0446\u044f\u043f\u0435\u0440 \u0447\u0443\u0435\u0446\u0435 \u0430\u0434 \u043c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u043e\u0435 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u0430\u044f \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0414\u0443\u0445\u0430, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u043e\u0435 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0435 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435, \u0442\u043e \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0435 \u043c\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0432\u044b \u0434\u0443\u043c\u0430\u043b\u0456 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u043c\u0435\u043b\u0456 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u044b\u043c\u0456 \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456. \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0434\u0437\u0435\u043b\u044f \u0440\u0430\u0437\u043b\u0430\u0434\u0443 \u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u043f\u0443\u0441\u0442\u043e\u0439 \u043f\u0430\u0445\u0432\u0430\u043b\u044c\u0431\u044b, \u0430\u043b\u0435 \u045e \u043f\u0430\u043a\u043e\u0440\u044b \u043b\u0456\u0447\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0441\u044f\u0431\u0435. \u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u0401\u043d, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0437 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430\u043b\u0435 \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0406 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0441\u0442\u0430\u045e\u0448\u044b \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439. \u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u042f\u0433\u043e \u0456 \u0434\u0430\u045e \u042f\u043c\u0443 \u0456\u043c\u044f \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0456\u043c\u044f, \u043a\u0430\u0431 \u043d\u0430 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0441\u0445\u0456\u043b\u0456\u043b\u0430\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u043a\u0430\u043b\u0435\u043d\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445, \u0437\u044f\u043c\u043d\u044b\u0445 \u0456 \u043f\u0430\u0434\u0437\u0435\u043c\u043d\u044b\u0445, \u0456 \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u044f\u0437\u044b\u043a \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u045e, \u0448\u0442\u043e \u041f\u0430\u043d\u0430\u043c \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041f 2, 24ab; \u0413\u0431\u0440 2, 14b; \u043f\u0430\u0440. 12, 2<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0436\u044b\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0456\u0437\u0440\u044b\u043d\u0443\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0434\u2019\u044f\u0431\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a \u0432\u0435\u0440\u044b \u043d\u0430\u0448\u0430\u0439 \u0437\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043a\u0440\u044b\u0436.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"264","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">2, 12-30<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u0430\u0435, \u044f\u043a \u0432\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043c\u0430\u0451\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0446\u044f\u043f\u0435\u0440, \u0443 \u0447\u0430\u0441 \u043c\u0430\u0451\u0439 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0439\u0446\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0411\u043e \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f. \u0423\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u0431\u0435\u0437 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f\u045e \u0456 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456, \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u043b\u0436\u044b\u0432\u0430\u0433\u0430 \u0456 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f, \u0443 \u044f\u043a\u0456\u043c \u0432\u044b \u0437\u0437\u044f\u0435\u0446\u0435, \u044f\u043a \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u045e \u0441\u0432\u0435\u0446\u0435. \u0422\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u043d\u0430 \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u043c\u043d\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0448\u0442\u043e \u044f \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u0431\u0435\u0433 \u0456 \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u043f\u0440\u0430\u043b\u044c\u044e\u0441\u044f \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0430 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b, \u0442\u043e \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0456 \u0446\u0435\u0448\u0443\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0446\u0435\u0448\u0446\u0435\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u0430\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u045e \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435, \u0448\u0442\u043e \u045e \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435 \u043f\u0440\u044b\u0448\u043b\u044e \u0434\u0430 \u0432\u0430\u0441 \u0426\u0456\u043c\u0430\u0444\u0435\u044f, \u043a\u0430\u0431 \u044f \u0441\u0443\u043f\u0430\u043a\u043e\u0456\u045e\u0441\u044f, \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0448\u044b\u0441\u044f \u043f\u0440\u0430 \u0432\u0430\u0441. \u0411\u043e \u044f \u043d\u0435 \u043c\u0430\u044e \u0456\u043d\u0448\u0430\u0433\u0430 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430, \u044f\u043a\u0456 \u0431 \u0442\u0430\u043a \u0448\u0447\u044b\u0440\u0430 \u0440\u0443\u043f\u0456\u045e\u0441\u044f \u043f\u0440\u0430 \u0432\u0430\u0441. \u0423\u0441\u0435 \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e, \u0430 \u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0412\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u044f\u0433\u043e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u0451\u043d, \u044f\u043a \u0431\u0430\u0446\u044c\u043a\u0430\u045e \u0441\u044b\u043d, \u0441\u043b\u0443\u0436\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u044f \u043f\u0430\u0448\u043b\u044e \u044f\u0433\u043e \u0434\u0430 \u0432\u0430\u0441 \u0430\u0434\u0440\u0430\u0437\u0443, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0440\u0430\u0448\u0443 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b. \u041c\u0430\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u045e \u041f\u0430\u043d\u0443, \u0448\u0442\u043e \u0456 \u0441\u0430\u043c \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u043f\u0440\u044b\u0431\u0443\u0434\u0443 \u0434\u0430 \u0432\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u043c \u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0434\u0430 \u0432\u0430\u0441 \u042d\u043f\u0430\u0444\u0440\u0430\u0434\u044b\u0442\u0430, \u0431\u0440\u0430\u0442\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430 \u045e \u043f\u0440\u0430\u0446\u044b \u0456 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u0430 \u0456 \u0441\u043b\u0443\u0433\u0443 \u045e \u043c\u0430\u0451\u0439 \u043f\u0430\u0442\u0440\u044d\u0431\u0435, \u0431\u043e \u0451\u043d \u0432\u0435\u043b\u044c\u043c\u0456 \u0442\u0443\u0436\u044b\u045e \u043f\u0430 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u045e\u0441\u044f \u0437-\u0437\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u044f\u0433\u043e \u0445\u0432\u0430\u0440\u043e\u0431\u0443. \u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0451\u043d \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430 \u0437\u0430\u0445\u0432\u0430\u0440\u044d\u045e. \u0410\u043b\u0435 \u0411\u043e\u0433 \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0456\u043c, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0434 \u0456\u043c, \u0430\u043b\u0435 \u0456 \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0431 \u044f \u043d\u0435 \u043c\u0435\u045e \u0434\u0430\u0434\u0430\u0442\u043a\u043e\u0432\u0430\u0433\u0430 \u0441\u043c\u0443\u0442\u043a\u0443. \u0422\u0430\u043c\u0443 \u044f \u0442\u044b\u043c \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e, \u043a\u0430\u0431 \u0432\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u0433\u043e \u0456 \u045e\u0437\u0440\u0430\u0434\u0432\u0430\u043b\u0456\u0441\u044f \u0437\u043d\u043e\u045e, \u0456 \u043a\u0430\u0431 \u044f \u043d\u0435 \u043c\u0435\u045e \u0441\u043c\u0443\u0442\u043a\u0443. \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u044f\u0433\u043e \u045e \u041f\u0430\u043d\u0443 \u0437 \u043f\u043e\u045e\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u043c\u0430\u0439\u0446\u0435 \u045e \u043f\u0430\u0448\u0430\u043d\u0435 \u0442\u0430\u043a\u0456\u0445, \u0431\u043e \u0451\u043d \u0431\u044b\u045e \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0440\u044b\u0437\u044b\u043a\u0430\u0432\u0430\u045e \u0436\u044b\u0446\u0446\u0451\u043c, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0443 \u0447\u044b\u043c \u0432\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u043c\u043d\u0435.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u041f 1, 10\u0430. 11; \u042d\u0444 5, 8b. 11\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0456 \u0432\u044b\u0431\u0430\u0440. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u0430\u0434\u044b \u0448\u044b\u0440\u043e\u043a\u0430 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u045e\u0432\u0430\u0445\u043e\u0434 \u0443 \u0432\u0435\u0447\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430; \u043d\u0435 \u0431\u044f\u0440\u044b\u0446\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u0431\u044f\u0441\u043f\u043b\u0451\u043d\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0446\u0435\u043c\u0440\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u0434\u044b.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"265","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">3, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u043a\u043b\u0430\u0434 \u041f\u0430\u045e\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443. \u041f\u0456\u0441\u0430\u0446\u044c \u0432\u0430\u043c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u043c\u043d\u0435 \u043d\u0435 \u0446\u044f\u0436\u043a\u0430, \u0434\u043b\u044f \u0432\u0430\u0441 \u0436\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u0430. \u0410\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u0430\u0431\u0430\u043a, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u043b\u0456\u0445\u0456\u0445 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f! \u041c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u0441\u043b\u0443\u0436\u044b\u043c \u0443 \u0411\u043e\u0436\u044b\u043c \u0414\u0443\u0445\u0443 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u0430 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0446\u0435\u043b\u0430. \u0425\u043e\u0446\u044c \u044f \u043c\u0430\u0433\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u0456 \u043d\u0430 \u0446\u0435\u043b\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0456\u043d\u0448\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0446\u0435\u043b\u0430, \u0442\u043e \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f, \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b \u043d\u0430 \u0432\u043e\u0441\u044c\u043c\u044b \u0434\u0437\u0435\u043d\u044c, \u0437 \u0440\u043e\u0434\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0430, \u0433\u0430\u0431\u0440\u044d\u0439 \u0430\u0434 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u2013 \u0444\u0430\u0440\u044b\u0441\u0435\u0439, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u2013 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0417\u0430\u043a\u043e\u043d\u0443 \u2013 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0410\u043b\u0435 \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0430\u0431\u044b\u0442\u043a\u0430\u043c, \u0442\u043e\u0435 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0441\u0442\u0440\u0430\u0442\u0430\u0439. \u0414\u044b \u0456 \u045e\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0414\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u044f \u045e\u0441\u0451 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0456 \u043b\u0456\u0447\u0443 \u0441\u043c\u0435\u0446\u0446\u0435\u043c, \u043a\u0430\u0431 \u043d\u0430\u0431\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u045e \u0406\u043c \u043d\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0417\u0430\u043a\u043e\u043d\u0443, \u0430\u043b\u0435 \u0437 \u0442\u043e\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0435\u0440\u044b \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u043d\u0430 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u043d\u0435\u0439\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f. \u041d\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u044f \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430 \u0456 \u045e\u0436\u043e \u0441\u0442\u0430\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0430\u043b\u0435 \u044f \u0456\u043c\u043a\u043d\u0443\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u043e\u0435, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u043c\u044f\u043d\u0435 \u0437\u0434\u0430\u0431\u044b\u045e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0411\u0440\u0430\u0442\u044b, \u044f \u043d\u0435 \u043b\u0456\u0447\u0443, \u0448\u0442\u043e \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0431\u044b\u0432\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0441\u044f\u0433\u0430\u044e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044d\u0442\u044b \u0456\u043c\u043a\u043d\u0443\u0441\u044f \u0434\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0432\u044b\u0441\u043e\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0411\u0443\u0434\u0443\u0447\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0446\u044c, \u0430 \u043a\u0430\u043b\u0456 \u0456\u043d\u0430\u043a\u0448 \u0434\u0443\u043c\u0430\u0435\u0446\u0435, \u0442\u043e \u0411\u043e\u0433 \u0432\u0430\u043c \u0430\u0434\u043a\u0440\u044b\u0435. \u0410\u0434\u043d\u0430\u043a, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043c\u044b \u045e\u0436\u043e \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 3, 8b. 10\u0430; \u0420\u044b\u043c 6, 8<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0442\u043e \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0456 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0406\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"266","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">3, 17 \u2013 4, 9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u041f\u0430\u043d\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0431\u0440\u0430\u0442\u044b, \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0437\u043e\u0440\u0443, \u044f\u043a\u0456 \u043c\u0430\u0435\u0446\u0435 \u045e \u043d\u0430\u0441. \u0411\u043e \u043c\u043d\u043e\u0433\u0456\u044f, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0447\u0430\u0441\u0442\u0430 \u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0432\u0430\u0442 \u0437 \u043f\u043b\u0430\u0447\u0430\u043c \u043a\u0430\u0436\u0443, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c, \u044f\u043a \u0432\u043e\u0440\u0430\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430. \u0406\u0445\u043d\u0456 \u043a\u0430\u043d\u0435\u0446 \u2013 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c, \u0456\u0445\u043d\u0456 \u0431\u043e\u0433 \u2013 \u0447\u044d\u0440\u0430\u0432\u0430, \u0456 \u0441\u043b\u0430\u0432\u0430 \u0456\u0445 \u2013 \u0443 \u0441\u043e\u0440\u0430\u043c\u0435 \u0456\u0445\u043d\u0456\u043c; \u044f\u043d\u044b \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435. \u0410 \u043d\u0430\u0448\u0430 \u0430\u0439\u0447\u044b\u043d\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0430\u0434\u043a\u0443\u043b\u044c \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0417\u0431\u0430\u045e\u0446\u0443, \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u043f\u0440\u0430\u0437 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043c\u043e\u0446\u044b, \u044f\u043a\u043e\u0439 \u0401\u043d \u043c\u043e\u0436\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u045e\u0441\u0451.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043c\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043f\u0430 \u044f\u043a\u0456\u0445 \u0441\u0443\u043c\u0443\u044e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043d\u0435\u0446 \u043c\u043e\u0439, \u0442\u0430\u043a \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u041f\u0430\u043d\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u042d\u0432\u043e\u0434\u0437\u0456\u044e \u0456 \u0421\u044b\u043d\u0442\u044b\u0445\u0435\u044e \u0431\u044b\u0446\u044c \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456 \u045e \u041f\u0430\u043d\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0448\u0443, \u0431\u043b\u0456\u0437\u043a\u0456 \u0441\u044f\u0431\u0440\u0430, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0456\u043c, \u0431\u043e \u044f\u043d\u044b \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u041a\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c \u0434\u044b \u0456\u043d\u0448\u044b\u043c\u0456 \u043c\u0430\u0456\u043c\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u0456\u043c\u0451\u043d\u044b \u044f\u043a\u0456\u0445 \u0443\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u043a\u043d\u0456\u0433\u0443 \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u041f\u0430\u043d\u0443. \u042f\u0448\u0447\u044d \u0440\u0430\u0437 \u043a\u0430\u0436\u0443: \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f! \u041b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0434\u043e\u043c\u0430\u044f \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c. \u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430. \u041d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f, \u0430\u043b\u0435 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u0406 \u0441\u043f\u0430\u043a\u043e\u0439 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0440\u043e\u0437\u0443\u043c, \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u0443\u043c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0433\u043e\u0434\u043d\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435, \u0448\u0442\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0435, \u0448\u0442\u043e \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043d\u0435\u0439\u043a\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0430\u0431\u043e \u043d\u0435\u0448\u0442\u0430 \u0433\u043e\u0434\u043d\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b \u2013 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u0443\u043c\u0430\u0439\u0446\u0435. \u0427\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u0456 \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u0456 \u043f\u0430\u0447\u0443\u043b\u0456, \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435, \u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435, \u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0444 4, 17; 1 \u0422\u044d\u0441 5, 15b-18<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0456 \u0441\u0432\u0435\u0434\u0447\u0443 \u045e \u041f\u0430\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u044b\u043b\u0456, \u044f\u043a \u0436\u044b\u0432\u0443\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u0430\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0431\u0440\u043e \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u045e\u0441\u0456\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0442\u0430\u043a\u0430\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0432\u0430\u0441 \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f, \u0437\u0430 \u045e\u0441\u0451 \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0442\u0430\u043a\u0430\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"267","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">4, 10-23<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0444\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u041f\u0430\u045e\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0448\u0442\u043e \u0432\u044b \u0437\u043d\u043e\u045e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u043c\u044f\u043d\u0435. \u0412\u044b \u0456 \u0440\u0430\u043d\u0435\u0439 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0432\u0430\u043c \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u043b\u0430 \u043d\u0430\u0433\u043e\u0434\u044b. \u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u0430\u044e \u043f\u0430\u0442\u0440\u044d\u0431\u0443, \u0431\u043e \u044f \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u0431\u044b\u0446\u044c \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b\u043c \u0442\u044b\u043c, \u0448\u0442\u043e \u045e \u043c\u044f\u043d\u0435 \u0451\u0441\u0446\u044c. \u042f \u045e\u043c\u0435\u044e \u0431\u044b\u0446\u044c \u0456 \u045e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0456, \u0443\u043c\u0435\u044e \u0431\u044b\u0446\u044c \u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443; \u044f \u043f\u0440\u044b\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u0434\u0430 \u045e\u0441\u044f\u0433\u043e: \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430, \u0456 \u0433\u0430\u043b\u0430\u0434\u0430\u0446\u044c, \u0456 \u0431\u044b\u0446\u044c \u0443 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443, \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u0443. \u0423\u0441\u0451 \u043c\u0430\u0433\u0443 \u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u045e\u0437\u043c\u0430\u0446\u043d\u044f\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0432\u044b \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u045e\u0448\u044b \u0441\u0430 \u043c\u043d\u043e\u044e \u043c\u0430\u0451 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435. \u0412\u0435\u0434\u0430\u0435\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b, \u0444\u0456\u043b\u0456\u043f\u044f\u043d\u0435, \u0448\u0442\u043e \u045e \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043a\u0430\u043b\u0456 \u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u0456, \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u0430\u043f\u0440\u043e\u0447 \u0432\u0430\u0441 \u0430\u0434\u043d\u044b\u0445, \u043d\u0435 \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0434\u0430 \u043c\u044f\u043d\u0435 \u045e \u0441\u043f\u0440\u0430\u0432\u0435 \u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f. \u0412\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e \u0434\u0430\u0441\u044b\u043b\u0430\u043b\u0456 \u043c\u043d\u0435 \u045e \u0422\u044d\u0441\u0430\u043b\u043e\u043d\u0456\u043a\u0443, \u043a\u0430\u043b\u0456 \u044f \u0431\u044b\u045e \u0443 \u043f\u0430\u0442\u0440\u044d\u0431\u0435. \u041a\u0430\u0436\u0443 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0448\u0443\u043a\u0430\u044e \u0434\u0430\u0440\u0443, \u0430\u043b\u0435 \u0448\u0443\u043a\u0430\u044e \u043f\u043b\u0451\u043d\u0443, \u044f\u043a\u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u0430\u0448\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c. \u042f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u0451 \u0456 \u043c\u0430\u044e \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430. \u042f \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0430\u043d\u044b \u045e\u0441\u0456\u043c, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0430\u0434 \u042d\u043f\u0430\u0444\u0440\u0430\u0434\u044b\u0442\u0430 \u0434\u0430\u0441\u043b\u0430\u043d\u0430\u0435 \u0432\u0430\u043c\u0456 \u2013 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0432\u043e\u0434\u0430\u0440, \u0430\u0445\u0432\u044f\u0440\u0443 \u043f\u0440\u044b\u0435\u043c\u043d\u0443\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443. \u0410 \u043c\u043e\u0439 \u0411\u043e\u0433 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0432\u0430\u0448\u0443\u044e \u043f\u0430\u0442\u0440\u044d\u0431\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u045e \u0445\u0432\u0430\u043b\u0435 \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u0411\u043e\u0433\u0443 \u0436 \u0456 \u0410\u0439\u0446\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u0439\u0446\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0435 \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u0442\u0443\u0442 \u0441\u0430 \u043c\u043d\u043e\u044e. \u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f, \u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0442\u044b\u044f, \u0448\u0442\u043e \u0437 \u0434\u043e\u043c\u0443 \u0446\u044d\u0437\u0430\u0440\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u0434\u0443\u0445\u0430\u043c \u0432\u0430\u0448\u044b\u043c. \u0410\u043c\u044d\u043d.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 4, 12-13; 2 \u041a\u0430\u0440 12, 10\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u043c\u0435\u044e \u0431\u044b\u0446\u044c \u0456 \u045e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0456, \u0443\u043c\u0435\u044e \u0431\u044b\u0446\u044c \u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443; \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430, \u0456 \u0433\u0430\u043b\u0430\u0434\u0430\u0446\u044c, \u0456 \u0431\u044b\u0446\u044c \u0443 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443, \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u0443. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u0441\u0451 \u043c\u0430\u0433\u0443 \u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u045e\u0437\u043c\u0430\u0446\u043d\u044f\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0456 \u045e\u0446\u0456\u0441\u043a \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0441\u0451.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"271","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">1, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0456\u0441\u0456\u044f \u0426\u0456\u043c\u0430\u0444\u0435\u044f. \u041f\u0430\u0432\u0435\u043b \u2013 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0432\u0435\u043b, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u0433\u0430\u0434\u0443 \u0411\u043e\u0433\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456, \u2013 \u0426\u0456\u043c\u0430\u0444\u0435\u044e, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u045e \u0432\u0435\u0440\u044b: \u043b\u0430\u0441\u043a\u0430, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0434\u0443\u0447\u044b \u045e \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0456\u044e, \u044f \u043f\u0440\u0430\u0441\u0456\u045e \u0446\u044f\u0431\u0435 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u045e \u042d\u0444\u0435\u0441\u0435, \u043a\u0430\u0431 \u0442\u044b \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u043c \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0456\u043d\u0448\u0430\u043c\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0439\u043c\u0430\u0446\u0446\u0430 \u0431\u0430\u0439\u043a\u0430\u043c\u0456 \u0456 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c\u0456 \u0440\u0430\u0434\u0430\u0432\u043e\u0434\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0441\u043f\u0440\u044d\u0447\u0430\u043a, \u0447\u044b\u043c \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u043c\u0443 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044e \u045e \u0432\u0435\u0440\u044b. \u041c\u044d\u0442\u0430 \u0436 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u2013 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u044b. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u043f\u0443\u0441\u0442\u0430\u0441\u043b\u043e\u045e\u044f, \u0445\u043e\u0447\u0443\u0447\u044b \u0431\u044b\u0446\u044c \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0417\u0430\u043a\u043e\u043d\u0443, \u0445\u043e\u0446\u044c \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c, \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u0456 \u0448\u0442\u043e \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0417\u0430\u043a\u043e\u043d \u0434\u043e\u0431\u0440\u044b, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0456\u043c \u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0417\u0430\u043a\u043e\u043d \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0435 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445, \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0440\u0430\u0437\u0431\u044d\u0448\u0447\u0430\u043d\u044b\u0445 \u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0446\u0430\u045e, \u0431\u0430\u0446\u044c\u043a\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u0430\u045e, \u043c\u0430\u0446\u0456\u0437\u0430\u0431\u043e\u0439\u0446\u0430\u045e \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u0430\u045e, \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u043a\u0430\u045e, \u043c\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u043a\u0430\u045e, \u0434\u043b\u044f \u0433\u0430\u043d\u0434\u043b\u044f\u0440\u043e\u045e \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043f\u0430\u0434\u043c\u0430\u043d\u0448\u0447\u044b\u043a\u0430\u045e, \u0456\u043b\u0436\u044d\u0441\u0432\u0435\u0434\u043a\u0430\u045e \u0456 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u043c\u0443 \u0432\u0443\u0447\u044d\u043d\u043d\u044e, \u0437\u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435\u043c, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u0445\u0432\u0430\u043b\u043e\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u044f\u043a\u043e\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u043c\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0434\u0437\u044f\u043a\u0443\u044e \u043d\u0430\u0448\u0430\u043c\u0443 \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043c\u044f\u043d\u0435 \u0432\u0430\u0440\u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0440\u0443, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e\u0448\u044b \u0441\u0430\u0431\u0435 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u0445\u043e\u0446\u044c \u044f \u0440\u0430\u043d\u0435\u0439 \u0431\u044b\u045e \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0446\u0430\u043c, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c \u0456 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u0435\u043b\u0435\u043c. \u0410\u043b\u0435 \u044f \u0431\u044b\u045e \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u045e \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0456 \u0456 \u0431\u044f\u0437\u0432\u0435\u0440\u2019\u0456. \u041b\u0430\u0441\u043a\u0430 \u0436 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0434\u043d\u0430\u0435 \u0432\u0435\u0440\u044b \u0441\u043b\u043e\u0432\u0430 \u0456 \u0432\u0430\u0440\u0442\u0430\u0435 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u044f \u043f\u0435\u0440\u0448\u044b. \u0410\u043b\u0435 \u044f \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0443\u0432\u0430 \u043c\u043d\u0435 \u043f\u0435\u0440\u0448\u044b\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u044e \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0442\u044b\u043c, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u0432\u044f\u043a\u043e\u045e, \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u043c\u0443, \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u043c\u0443 \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443 \u2013 \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u0441\u043b\u0430\u0432\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u043d\u0430\u043a\u0430\u0437 \u0434\u0430\u044e \u0442\u0430\u0431\u0435, \u0441\u044b\u043d\u0435 \u0426\u0456\u043c\u0430\u0444\u0435\u044e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u045e, \u043a\u0430\u0431 \u0442\u044b \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0456\u043c\u0456 \u044f\u043a \u0434\u043e\u0431\u0440\u044b \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0456\u0442, \u043c\u0430\u044e\u0447\u044b \u0432\u0435\u0440\u0443 \u0456 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u0456 \u0437\u0433\u0443\u0431\u0456\u043b\u0456 \u0432\u0435\u0440\u0443. \u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u0413\u0456\u043c\u0435\u043d\u044d\u0439 \u0456 \u0410\u043b\u044f\u043a\u0441\u0430\u043d\u0434\u0440, \u044f\u043a\u0456\u0445 \u044f \u0430\u0434\u0434\u0430\u045e \u0441\u0430\u0442\u0430\u043d\u0435, \u043a\u0430\u0431 \u0430\u0434\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0426\u0456\u043c 1, 14. 15b; \u0420\u044b\u043c 3, 23&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041b\u0430\u0441\u043a\u0430 \u0436 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e \u045e\u0441\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0437\u0443\u0441.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"272","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">2, 1-15&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u043a\u043b\u0456\u043a \u0434\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e, \u043a\u0430\u0431 \u043f\u0440\u0430\u0448\u044d\u043d\u043d\u0456, \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0430\u0431 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0435 \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u043b\u0456\u0441\u044f \u0437\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439: \u0437\u0430 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0432\u0435\u0441\u0446\u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u0456 \u0446\u0456\u0445\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. \u0413\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u045e \u0432\u0430\u0447\u0430\u0445 \u0411\u043e\u0433\u0430, \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b. \u0411\u043e \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u2013 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u043d\u0430 \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u045e\u0441\u0456\u0445 \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0443\u044e \u043f\u0430\u0440\u0443, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u044f \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c. \u041a\u0430\u0436\u0443 \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u043d\u0435 \u0445\u043b\u0443\u0448\u0443. \u042f \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0443 \u0432\u0435\u0440\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0436\u0430\u0434\u0430\u044e, \u043a\u0430\u0431 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0443\u0437\u043d\u043e\u0441\u044f\u0447\u044b \u0447\u044b\u0441\u0442\u044b\u044f \u0440\u0443\u043a\u0456 \u0431\u0435\u0437 \u0433\u043d\u0435\u0432\u0443 \u0456 \u0441\u043f\u0440\u044d\u0447\u0430\u043a. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u0430\u043f\u0440\u0430\u043d\u0430\u044e\u0446\u0446\u0430 \u0437 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0439 \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044e, \u0441\u0446\u0456\u043f\u043b\u0430 \u0456 \u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430, \u0430\u0437\u0434\u0430\u0431\u043b\u044f\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u043d\u0435 \u043f\u043b\u044f\u0446\u0435\u043d\u043d\u0435\u043c \u0432\u0430\u043b\u0430\u0441\u043e\u045e \u0446\u0456 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0430\u0431\u043e \u043f\u044d\u0440\u043b\u0430\u043c\u0456 \u0446\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c\u0456 \u0441\u0442\u0440\u043e\u044f\u043c\u0456, \u0430\u043b\u0435 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c, \u0448\u0442\u043e \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0416\u0430\u043d\u0447\u044b\u043d\u0430 \u043d\u044f\u0445\u0430\u0439 \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u045e \u0446\u0456\u0445\u0430\u0441\u0446\u0456 \u0456 \u045e \u043f\u043e\u045e\u043d\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0435 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043c\u0443\u0436\u0430\u043c, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u0456\u0445\u0430\u0441\u0446\u0456. \u0411\u043e \u043f\u0435\u0440\u0448\u044b\u043c \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0410\u0434\u0430\u043c, \u0430 \u043f\u043e\u0442\u044b\u043c \u0415\u0432\u0430. \u0406 \u043d\u0435 \u0410\u0434\u0430\u043c \u0431\u044b\u045e \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b, \u0430\u043b\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u0430\u044f \u0456 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0430. \u042f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0434\u0437\u044f\u0446\u0435\u0439, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0437 \u0440\u0430\u0437\u0432\u0430\u0433\u0430\u044e.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0426\u0456\u043c 2, 5-6; \u0413\u0431\u0440 2, 17\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u2013 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u043d\u0430 \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u045e\u0441\u0456\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u0430\u043c\u0443 \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"273","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">3, 1-16&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0413\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u0430 \u0433\u043e\u0434\u043d\u0430\u0435 \u0432\u0435\u0440\u044b: \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u0442\u0432\u0430, \u0451\u043d \u0436\u0430\u0434\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b. \u0422\u0430\u043c\u0443 \u0431\u0456\u0441\u043a\u0443\u043f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c, \u043c\u0443\u0436\u0430\u043c \u0430\u0434\u043d\u043e\u0439 \u0436\u043e\u043d\u043a\u0456, \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c, \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c, \u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u044b\u043c, \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u044b\u043c, \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c, \u043d\u0435 \u0441\u0445\u0456\u043b\u044c\u043d\u044b\u043c \u0434\u0430 \u043f\u2019\u044f\u043d\u0441\u0442\u0432\u0430, \u043d\u0435 \u0441\u0432\u0430\u0440\u043b\u0456\u0432\u044b\u043c, \u0430\u043b\u0435 \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u044b\u043c, \u043c\u0456\u0440\u0430\u043b\u044e\u0431\u043d\u044b\u043c \u0456 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u044b\u043c \u0434\u0430 \u0433\u0440\u043e\u0448\u0430\u0439. \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u043e\u0431\u0440\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c \u0456 \u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u044e. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u045e\u043c\u0435\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c, \u044f\u043a \u0436\u0430 \u0437\u043c\u043e\u0436\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0411\u043e\u0436\u044b\u043c? \u0401\u043d \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u043d\u0435\u0430\u0444\u0456\u0442\u0430\u043c, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0433\u0430\u043d\u0430\u0440\u044b\u045e\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u045e \u043f\u0430\u0434 \u0434\u2019\u044f\u0431\u0430\u043b\u044c\u0441\u043a\u0430\u0435 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435. \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0435\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0432\u043e\u043d\u043a\u0443, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u043f\u0430\u0433\u0430\u0440\u0434\u0443 \u0456 \u043f\u0430\u0441\u0442\u043a\u0443 \u0434\u2019\u044f\u0431\u043b\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u043c\u0456, \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u043c\u0456, \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u043b\u043e\u045e\u0436\u044b\u0432\u0430\u0446\u044c \u0432\u0456\u043d\u043e\u043c \u0456 \u0431\u044b\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u044b\u043c\u0456. \u041f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0432\u0435\u0440\u044b \u045e \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0456. \u0406 \u0442\u0430\u043a\u0456\u0445 \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c, \u0430 \u043f\u043e\u0442\u044b\u043c \u043d\u044f\u0445\u0430\u0439 \u0441\u043b\u0443\u0436\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456. \u0416\u0430\u043d\u0447\u044b\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u043c\u0456, \u043d\u0435 \u043f\u043b\u044f\u0442\u043a\u0430\u0440\u043a\u0430\u043c\u0456, \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c\u0456, \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0432\u0430 \u045e\u0441\u0456\u043c. \u041d\u044f\u0445\u0430\u0439 \u0434\u044b\u044f\u043a\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u0443\u0436\u0430\u043c \u0430\u0434\u043d\u043e\u0439 \u0436\u043e\u043d\u043a\u0456, \u043d\u044f\u0445\u0430\u0439 \u0434\u043e\u0431\u0440\u0430 \u043a\u0456\u0440\u0443\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0456 \u045e\u043b\u0430\u0441\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c. \u0411\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0434\u043e\u0431\u0440\u0430 \u0441\u043b\u0443\u0436\u044b\u045e \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c, \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u0441\u0430\u0431\u0435 \u0433\u043e\u0434\u043d\u0430\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0447\u0430 \u0456 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0430\u0434\u0432\u0430\u0433\u0443 \u045e \u0432\u0435\u0440\u044b \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0456\u0448\u0443 \u0442\u0430\u0431\u0435 \u0433\u044d\u0442\u0430, \u043c\u0430\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u043f\u0440\u044b\u0431\u044b\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0441\u043f\u0430\u0437\u043d\u044f\u0446\u0446\u0430, \u0442\u043e \u0432\u0435\u0434\u0430\u0439, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0434\u043e\u043c\u0435 \u0411\u043e\u0436\u044b\u043c, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0436\u044b\u0432\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u0441\u0442\u0430\u045e\u043f\u043e\u043c \u0456 \u0430\u043f\u0456\u0440\u044b\u0448\u0447\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b. \u0406 \u043c\u044b \u0437\u0433\u043e\u0434\u043d\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0451\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456: \u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0446\u0435\u043b\u0435, \u0431\u044b\u045e \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b \u045e \u0414\u0443\u0445\u0443, \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u0430\u043d\u0451\u043b\u0430\u043c, \u0431\u044b\u045e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c, \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0432\u0435\u0440\u0443 \u045e \u0441\u0432\u0435\u0446\u0435 \u0456 \u0431\u044b\u045e \u0443\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u045e \u0441\u043b\u0430\u0432\u0435.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0437 20, 28; 1 \u041a\u0430\u0440 4, 2<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0401\u043d \u043f\u0440\u044b\u0434\u0431\u0430\u045e \u043a\u0440\u044b\u0432\u0451\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0436\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0432\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"274","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">4, 1 \u2013 5, 2<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0456 \u043f\u0440\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445<\/span><\/p>\r\n<p style=\"text-indent: 9pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0414\u0443\u0445 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0447\u0430\u0441\u043e\u045e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u0441\u0442\u0443\u043f\u044f\u0446\u0446\u0430 \u0430\u0434 \u0432\u0435\u0440\u044b \u0456 \u0437\u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0434\u0443\u0445\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c, \u0456 \u0434\u0430 \u043d\u0430\u0432\u0443\u043a \u0434\u044d\u043c\u0430\u043d\u0430\u045e \u043f\u0440\u0430\u0437 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u0445 \u043f\u0430\u0434\u043c\u0430\u043d\u0448\u0447\u044b\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u0430\u043f\u043b\u044f\u043c\u0456\u043b\u0456 \u0441\u0432\u0430\u0451 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435. \u042f\u043d\u044b \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0446\u044c \u0436\u0430\u043d\u0456\u0446\u0446\u0430, \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0441\u0442\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u044f \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0434\u043b\u044f \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u0456 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0443. \u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0411\u043e\u0433, \u0434\u043e\u0431\u0440\u0430\u0435, \u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0434\u043a\u0456\u0434\u0430\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430. \u042f\u043d\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0448 \u0431\u0440\u0430\u0442\u0430\u043c, \u0441\u0442\u0430\u043d\u0435\u0448 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043b\u0443\u0433\u043e\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0456\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0432\u0435\u0440\u044b \u0456 \u0434\u043e\u0431\u0440\u0430\u0439 \u043d\u0430\u0432\u0443\u043a\u0456, \u044f\u043a\u043e\u0439 \u0442\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f. \u0410\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0441\u044f \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0456 \u043d\u0435\u0434\u0430\u0440\u044d\u0447\u043d\u044b\u0445 \u0431\u0430\u0435\u043a.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u044f\u0431\u0435 \u0436 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0439 \u0443 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0430\u043b\u0430 \u045e \u0447\u044b\u043c \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435, \u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u0430\u044f, \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0433\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0432\u0430\u0440\u0442\u0430\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0443\u0432\u0430\u0433\u0456. \u0411\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u043f\u0440\u0430\u0446\u0443\u0435\u043c \u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0417\u0431\u0430\u045e\u0446\u0443 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u0417\u0430\u0433\u0430\u0434\u0432\u0430\u0439 \u0433\u044d\u0442\u0430 \u0456 \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0442\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u044e, \u0430\u043b\u0435 \u0441\u0442\u0430\u043d\u044c \u0434\u043b\u044f \u0432\u0435\u0440\u043d\u044b\u0445 \u0443\u0437\u043e\u0440\u0430\u043c \u0443 \u0441\u043b\u043e\u0432\u0435, \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445, \u043b\u044e\u0431\u043e\u0432\u0456, \u0432\u0435\u0440\u044b \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u043a\u0443\u043b\u044c \u043f\u0440\u044b\u0439\u0434\u0443, \u0437\u0430\u0439\u043c\u0456\u0441\u044f \u0447\u044b\u0442\u0430\u043d\u043d\u0435\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435\u043c \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435\u043c. \u041d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0439 \u0434\u0430\u0440, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u0442\u0430\u0431\u0435 \u0456 \u044f\u043a\u0456 \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0442\u0430\u0431\u0435 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0456 \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0440\u0443\u043a \u043a\u0430\u043b\u0435\u0433\u0456\u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e. \u0410\u0431 \u0433\u044d\u0442\u044b\u043c \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f, \u0443 \u0433\u044d\u0442\u044b\u043c \u0442\u0440\u044b\u0432\u0430\u0439, \u043a\u0430\u0431 \u0442\u0432\u043e\u0439 \u043f\u043e\u0441\u0442\u0443\u043f \u0431\u044b\u045e \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445. \u0417\u0432\u0430\u0436\u0430\u0439 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0430 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435. \u0417\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c. \u0420\u043e\u0431\u044f\u0447\u044b \u0442\u0430\u043a, \u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0431\u0430\u0432\u0456\u0448, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u0446\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0442\u0430\u0440\u044d\u0439\u0448\u0430\u0433\u0430 \u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0439, \u0430\u043b\u0435 \u045e\u043f\u0440\u043e\u0448\u0432\u0430\u0439, \u044f\u043a \u0431\u0430\u0446\u044c\u043a\u0443; \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u2013 \u044f\u043a \u0431\u0440\u0430\u0442\u043e\u045e; \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d \u2013 \u044f\u043a \u043c\u0430\u0446\u0456, \u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u2013 \u044f\u043a \u0441\u044f\u0441\u0446\u0451\u0440, \u0437 \u0443\u0441\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\">&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0426\u0456\u043c 4, 8b. 10\u0430; 2 \u041a\u0430\u0440 4, 9<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u0430\u044f, \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0411\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u043f\u0440\u0430\u0446\u0443\u0435\u043c \u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f. \u0417\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u0433\u0456\u043d\u0435\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443 \u0448\u0442\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"275","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">5, 3-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u045e\u0434\u043e\u0432\u0430\u045e \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b: \u0423\u0434\u043e\u0432\u0430\u045e \u0448\u0430\u043d\u0443\u0439, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0434\u043e\u0432\u044b. \u041a\u0430\u043b\u0456 \u0436 \u044f\u043a\u0430\u044f \u045e\u0434\u0430\u0432\u0430 \u043c\u0430\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0430\u0431\u043e \u045e\u043d\u0443\u043a\u0430\u045e, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u043f\u0435\u0440\u0448 \u0432\u0443\u0447\u0430\u0446\u0446\u0430 \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u0441\u044f\u043c\u2019\u044e \u0434\u044b \u0431\u044b\u0446\u044c \u0443\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456 \u0431\u0430\u0446\u044c\u043a\u0430\u043c, \u0431\u043e \u0433\u044d\u0442\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u045e\u0434\u0430\u0432\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d\u043e\u043a\u0430\u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0433\u0430 \u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u042f\u0433\u043e \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443. \u0422\u0430\u044f \u0436, \u0448\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0430\u0441\u0430\u043b\u043e\u0434\u044b, \u043c\u0451\u0440\u0442\u0432\u0430\u044f \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439 \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u043d\u0435 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0445\u0430\u0442\u043d\u0456\u043c\u0456, \u0442\u043e\u0439 \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u0432\u0435\u0440\u0443 \u0456 \u0433\u043e\u0440\u0448\u044b \u0437\u0430 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u0430\u0433\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0434\u0430\u0432\u043e\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u0442\u0430\u044f, \u044f\u043a\u043e\u0439 \u043d\u0435 \u043c\u0435\u043d\u0448 \u0448\u0430\u0441\u044c\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0433\u0430\u0434\u043e\u045e, \u044f\u043a\u0430\u044f \u043c\u0435\u043b\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0443\u0436\u0430. \u042f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u044b\u043c \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u0437\u044f\u0446\u0435\u0439, \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430\u0441\u0446\u044e \u0456 \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0431\u043c\u044b\u0432\u0430\u043b\u0430 \u043d\u043e\u0433\u0456 \u0441\u0432\u044f\u0442\u044b\u043c, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0430 \u0433\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u0456 \u0440\u0443\u043f\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u0430 \u0434\u043e\u0431\u0440\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0410 \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0443\u0434\u043e\u0432\u0430\u045e \u0430\u0431\u043c\u0456\u043d\u0430\u0439, \u0431\u043e \u044f\u043d\u044b, \u043a\u0456\u0440\u0443\u044e\u0447\u044b\u0441\u044f \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0432\u044b\u0439\u0441\u0446\u0456 \u0437\u0430\u043c\u0443\u0436. \u042f\u043d\u044b \u0433\u043e\u0434\u043d\u044b\u044f \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f, \u0431\u043e \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0443\u044e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c. \u0425\u043e\u0434\u0437\u044f\u0447\u044b \u043f\u0430 \u0445\u0430\u0442\u0430\u0445, \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0443\u0447\u0430\u0446\u0446\u0430 \u0433\u0443\u043b\u044c\u0442\u0430\u0439\u0441\u0442\u0432\u0443. \u042f\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0443\u043b\u044c\u0442\u0430\u0439\u043a\u0456, \u0430\u043b\u0435 \u043f\u043b\u044f\u0442\u043a\u0430\u0440\u043a\u0456 \u0456 \u0446\u0456\u043a\u0430\u045e\u043d\u044b\u044f, \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430. \u0422\u0430\u043c\u0443 \u043b\u0456\u0447\u0443, \u0448\u0442\u043e \u043b\u0435\u043f\u0448, \u043a\u0430\u0431 \u043c\u0430\u043b\u0430\u0434\u044b\u044f \u045e\u0434\u043e\u0432\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437\u0430\u043c\u0443\u0436, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u043b\u0456 \u0434\u0437\u044f\u0446\u0435\u0439, \u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0456 \u0434\u043e\u043c\u0430\u043c \u0456 \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0443 \u043d\u0456\u044f\u043a\u0456\u0445 \u043f\u0430\u0434\u0441\u0442\u0430\u045e \u0434\u0430 \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041d\u0430 \u0436\u0430\u043b\u044c, \u0443\u0436\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0441\u0430\u0442\u0430\u043d\u043e\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436 \u044f\u043a\u0430\u044f \u0432\u0435\u0440\u043d\u0456\u0446\u0430 \u043c\u0430\u0435 \u045e\u0434\u043e\u0432\u0430\u045e, \u0434\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0456\u043c\u0456 \u0456 \u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u0451\u043d \u043c\u043e\u0433 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0443\u0434\u043e\u0432\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u0434\u043e\u0431\u0440\u0430 \u043a\u0456\u0440\u0443\u044e\u0446\u044c, \u0430\u043a\u0440\u0443\u0436\u0430\u0439\u0446\u0435 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u0439, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u0436\u043a\u0430 \u043f\u0440\u0430\u0446\u0443\u0435, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e\u0447\u044b \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u041d\u0435 \u0437\u0430\u0432\u044f\u0437\u0432\u0430\u0439 \u043f\u044b\u0441\u044b \u0432\u0430\u043b\u0443, \u044f\u043a\u0456 \u043c\u0430\u043b\u043e\u0446\u0456\u0446\u044c\u00bb \u0456: \u00ab\u041f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a \u0432\u0430\u0440\u0442\u044b \u043f\u043b\u0430\u0442\u044b \u0441\u0432\u0430\u0451\u0439\u00bb. \u041d\u0435 \u043f\u0440\u044b\u043c\u0430\u0439 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0430\u043d\u043d\u044f\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430, \u0445\u0456\u0431\u0430 \u0448\u0442\u043e \u0437-\u0437\u0430 \u0434\u0432\u0443\u0445 \u0446\u0456 \u0442\u0440\u043e\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e. \u0410 \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0434\u0430\u043a\u0430\u0440\u0430\u0439 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u043a\u0430\u0431 \u0456\u043d\u0448\u044b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0435\u043b\u0456 \u0441\u0442\u0440\u0430\u0445. \u0417\u0430\u043a\u043b\u0456\u043d\u0430\u044e \u0446\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0415\u0437\u0443\u0441\u0430\u043c, \u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u043a\u0430\u0431 \u0442\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0433\u044d\u0442\u0430 \u0431\u0435\u0437 \u043f\u0440\u044b\u043b\u0456\u043a\u0443 \u0456 \u043d\u0435 \u0440\u0430\u0431\u0456\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u043f\u0440\u0430\u0434\u0443\u0437\u044f\u0442\u0430. \u041d\u0435 \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u0439 \u043f\u0430\u0441\u043f\u0435\u0448\u043b\u0456\u0432\u0430 \u0440\u0443\u043a \u043d\u0456 \u043d\u0430 \u043a\u043e\u0433\u0430, \u0456 \u043d\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0439 \u0443 \u0433\u0440\u0430\u0445\u0430\u0445 \u0456\u043d\u0448\u044b\u0445, \u0430 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043f\u0456 \u0432\u0430\u0434\u044b, \u0430\u043b\u0435 \u043f\u0430\u0442\u0440\u043e\u0445\u0443 \u045e\u0436\u044b\u0432\u0430\u0439 \u0432\u0456\u043d\u0430 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u0442\u0440\u0430\u045e\u043d\u0456\u043a \u0456 \u0442\u0432\u0430\u0435 \u0447\u0430\u0441\u0442\u044b\u044f \u043d\u0435\u043c\u0430\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u0440\u0430\u0445\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u044f \u044f\u0448\u0447\u044d \u0434\u0430 \u0441\u0443\u0434\u0430, \u0430 \u0437\u0430 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u043c\u0456 \u0456\u0434\u0443\u0446\u044c \u0441\u043b\u0435\u0434\u0430\u043c. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0456 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u044f, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435, \u0442\u043e \u045e\u0441\u0451 \u0440\u043e\u045e\u043d\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 1, 27\u0430\u0441; 2, 4. 5<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044f\u0434\u0437\u0456\u0446\u0435 \u0436\u044b\u0446\u0446\u0451, \u0433\u043e\u0434\u043d\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"276","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">6, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u0441\u043b\u0443\u0433\u0430\u045e. \u041f\u0440\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b: \u041d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0434 \u044f\u0440\u043c\u043e\u043c, \u043d\u044f\u0445\u0430\u0439 \u043b\u0456\u0447\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u045e\u0441\u044f\u043a\u0430\u0439 \u043f\u0430\u0432\u0430\u0433\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u043b\u0430\u0441\u044f \u0456\u043c\u044f \u0411\u043e\u0436\u0430\u0435 \u0456 \u043d\u0430\u0432\u0443\u043a\u0430. \u0422\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0456\u043c\u0456, \u0448\u0442\u043e \u044f\u043d\u044b \u0431\u0440\u0430\u0442\u044b, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0456\u043c, \u0431\u043e \u044f\u043d\u044b \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u044f \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443. \u0413\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u0439 \u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0456\u043d\u0430\u043a\u0448 \u0456 \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0437 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u0442\u043e\u0439 \u0437\u0430\u0433\u0430\u043d\u0430\u0440\u044b\u045e\u0441\u044f, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0430\u043b\u0435 \u043c\u0430\u0435 \u0445\u0432\u0430\u0440\u0430\u0432\u0456\u0442\u0443\u044e \u0441\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u043f\u044b\u0442\u0430\u043d\u043d\u044f\u045e \u0456 \u0441\u043b\u043e\u045e\u043d\u044b\u0445 \u0441\u043f\u0440\u044d\u0447\u0430\u043a. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c, \u0433\u043d\u0435\u045e, \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u044b, \u0437\u043b\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043f\u0430\u0434\u0430\u0437\u0440\u044d\u043d\u043d\u0456, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b\u044f \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u0445 \u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u044b\u043c \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435\u043c, \u044f\u043a\u0456\u044f \u043b\u0456\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0431\u044b\u0442\u0430\u043a.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435\u043c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c. \u0411\u043e \u043c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u043d\u0435\u0441\u0446\u0456. \u0410\u043b\u0435, \u043c\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u0447\u044b\u043c \u043f\u0440\u044b\u043a\u0440\u044b\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b\u044f \u0433\u044d\u0442\u044b\u043c. \u0410 \u0442\u044b\u044f, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u0446\u0446\u0430, \u0442\u0440\u0430\u043f\u043b\u044f\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u0443 \u0456 \u043f\u0430\u0441\u0442\u043a\u0443, \u0443 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0456 \u0448\u043a\u043e\u0434\u043d\u044b\u044f \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0442\u0430\u043f\u043b\u044f\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0437\u0433\u0443\u0431\u0435 \u0456 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u0456. \u0411\u043e \u043a\u043e\u0440\u0430\u043d\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430 \u2013 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0433\u0440\u043e\u0448\u0430\u0439, \u0443 \u043f\u0430\u0433\u043e\u043d\u0456 \u0437\u0430 \u044f\u043a\u0456\u043c\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u0432\u0435\u0440\u044b \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u043f\u0430\u043a\u0443\u0442\u0430\u043c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 6, 25; 1 \u0426\u0456\u043c 6, 8&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f \u0430\u0431 \u0436\u044b\u0446\u0446\u0456 \u0432\u0430\u0448\u044b\u043c, \u0448\u0442\u043e \u0435\u0441\u0446\u0456 \u0456 \u0448\u0442\u043e \u043f\u0456\u0446\u044c, \u043d\u0456 \u0430\u0431 \u0446\u0435\u043b\u0435 \u0432\u0430\u0448\u044b\u043c, \u0443 \u0448\u0442\u043e \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0426\u0456 \u0436 \u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u0435\u0436\u0443, \u0430 \u0446\u0435\u043b\u0430 \u2013 \u0437\u0430 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443?<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u0447\u044b\u043c \u043f\u0440\u044b\u043a\u0440\u044b\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b\u044f \u0433\u044d\u0442\u044b\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0426\u0456 \u0436.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"277","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f <\/span><span style=\"color: #ff0000;\">6, 11-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u043e\u0448\u043d\u044f\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u0436, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430 \u0411\u043e\u0436\u044b, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0439 \u0433\u044d\u0442\u0430\u0433\u0430, \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. \u0417\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b, \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0456 \u043f\u0440\u0430 \u044f\u043a\u043e\u0435 \u0442\u044b \u0434\u0430\u045e \u0434\u043e\u0431\u0440\u0430\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u044f\u043c\u0443, \u0456 \u043f\u0435\u0440\u0430\u0434 \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a\u0456 \u0434\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u041f\u043e\u043d\u0446\u0456\u0435\u043c \u041f\u0456\u043b\u0430\u0442\u0430\u043c \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0447\u044b\u0441\u0442\u0430\u0439 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0436 \u0434\u0430 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u043f\u0430\u043a\u0430\u0436\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0456 \u0430\u0434\u0437\u0456\u043d\u044b \u043c\u043e\u0446\u043d\u044b, \u041a\u0430\u0440\u043e\u043b\u044c \u043d\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0456 \u041f\u0430\u043d \u043d\u0430\u0434 \u043f\u0430\u043d\u0430\u043c\u0456, \u0430\u0434\u0437\u0456\u043d\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u045e \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430. \u042f\u043c\u0443 \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u0432\u0435\u0447\u043d\u0430\u044f \u043c\u043e\u0446. \u0410\u043c\u044d\u043d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0430\u0433\u0430\u0442\u044b\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0435\u043a\u0443 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0439, \u043a\u0430\u0431 \u0437\u0430\u0432\u044b\u0441\u043e\u043a\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u043d\u0435 \u0434\u0443\u043c\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u043d\u044f\u043f\u044d\u045e\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0430\u043b\u0435 \u043d\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0430\u0435 \u043d\u0430\u043c \u0443\u0441\u0451 \u0434\u043b\u044f \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u044f. \u041d\u044f\u0445\u0430\u0439 \u0440\u043e\u0431\u044f\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u0430\u0433\u0430\u0446\u0435\u044e\u0446\u044c \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0447\u043e\u0434\u0440\u044b\u043c\u0456, \u0434\u0437\u044f\u043b\u044f\u0446\u0446\u0430 \u0437 \u0456\u043d\u0448\u044b\u043c\u0456. \u0422\u0430\u043a, \u0437\u0431\u0456\u0440\u0430\u044e\u0447\u044b \u0441\u0430\u0431\u0435 \u0434\u043e\u0431\u0440\u044b \u0441\u043a\u0430\u0440\u0431 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0435, \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u0426\u0456\u043c\u0430\u0444\u0435\u044e, \u0431\u0435\u0440\u0430\u0436\u044b \u0433\u044d\u0442\u044b \u0434\u044d\u043f\u0430\u0437\u0456\u0442 \u0432\u0435\u0440\u044b, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0439 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0443\u0441\u0442\u0430\u0441\u043b\u043e\u045e\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u043d\u0430\u0441\u0446\u044f\u045e \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u044f\u043a\u0456\u043c, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u0432\u0435\u0440\u044b. \u041b\u0430\u0441\u043a\u0430 \u0437 \u0432\u0430\u043c\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041a\u043b\u0441 2, 6-7; \u041c\u0446 6, 19\u0430. 20\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043a \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u045e \u0406\u043c, \u0443\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u044b\u044f \u0456 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0406\u043c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0432\u0435\u0440\u0430\u044e, \u044f\u043a \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456 \u0432\u0430\u0441, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0437\u0431\u0456\u0440\u0430\u0439\u0446\u0435 \u0441\u0430\u0431\u0435 \u0441\u043a\u0430\u0440\u0431\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0437\u0431\u0456\u0440\u0430\u0439\u0446\u0435 \u0441\u0430\u0431\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u045e \u043d\u0435\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0447\u044b\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"281","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f <\/span><span style=\"color: #ff0000;\">1, 1 \u2013 2, 9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u0434\u0430 \u0430\u0434\u0431\u0443\u0434\u043e\u0432\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043b\u0430\u0432\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0423 \u0434\u0440\u0443\u0433\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0414\u0430\u0440\u044b\u044f, \u0443 \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u0448\u043e\u0441\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f \u0434\u0430 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044f, \u0441\u044b\u043d\u0430 \u0428\u044d\u0430\u043b\u044c\u0442\u044b\u044d\u043b\u044f, \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430 \u042e\u0434\u044b, \u0456 \u0434\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0415\u0437\u0443\u0441\u0430, \u0441\u044b\u043d\u0430 \u0415\u0446\u0430\u0434\u0430\u043a\u0430:&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0413\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c: \u201c\u042f\u0448\u0447\u044d \u043d\u0435 \u043d\u0430\u0434\u044b\u0448\u043e\u045e \u0447\u0430\u0441 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0434\u043e\u043c \u041f\u0430\u043d\u0430\u201d\u00bb. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0410 \u0446\u0456 \u0432\u0430\u043c \u0441\u0430\u043c\u0456\u043c \u0447\u0430\u0441 \u0436\u044b\u0446\u044c \u0443 \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u044b\u0445 \u043f\u043b\u0456\u0442\u0430\u043c\u0456 \u0434\u0430\u043c\u0430\u0445, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0434\u043e\u043c \u0443 \u0440\u0443\u0456\u043d\u0430\u0445? \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0420\u0430\u0437\u0432\u0430\u0436\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u043f\u0440\u0430 \u0441\u0432\u0430\u0435 \u0448\u043b\u044f\u0445\u0456. \u0412\u044b \u0441\u0435\u0435\u0446\u0435 \u0448\u043c\u0430\u0442, \u0430 \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0435 \u043c\u0430\u043b\u0430; \u044f\u0441\u0446\u0435, \u0430\u043b\u0435 \u0432\u0430\u043c \u043d\u0435 \u0434\u043e\u0441\u044b\u0446\u044c; \u043f\u2019\u044f\u0446\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u0442\u0430\u043b\u044f\u0435\u0446\u0435 \u0441\u043c\u0430\u0433\u0456; \u0430\u043f\u0440\u0430\u043d\u0430\u0435\u0446\u0435\u0441\u044f, \u0430\u043b\u0435 \u0432\u0430\u043c \u043d\u0435 \u0446\u0451\u043f\u043b\u0430; \u0430 \u0445\u0442\u043e \u0437\u0430\u0440\u0430\u0431\u043b\u044f\u0435, \u0437\u0430\u0440\u0430\u0431\u043b\u044f\u0435, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u045e \u0434\u0437\u0456\u0440\u0430\u0432\u0443\u044e \u0442\u043e\u0440\u0431\u0443. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0420\u0430\u0437\u0432\u0430\u0436\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u043f\u0440\u0430 \u0441\u0432\u0430\u0435 \u0448\u043b\u044f\u0445\u0456. \u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435\u0441\u044f \u045e \u0433\u043e\u0440\u044b, \u043f\u0440\u044b\u043d\u044f\u0441\u0456\u0446\u0435 \u0434\u0440\u044d\u0432\u0430 \u0456 \u0431\u0443\u0434\u0443\u0439\u0446\u0435 \u0434\u043e\u043c, \u043a\u0430\u0431 \u042f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443 \u0456\u043c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0412\u044b \u0447\u0430\u043a\u0430\u0435\u0446\u0435 \u043c\u043d\u043e\u0433\u0430\u0433\u0430, \u0430 \u0432\u043e\u0441\u044c \u043c\u0430\u043b\u0430. \u041f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0435 \u0434\u0430\u0434\u043e\u043c\u0443, \u0430 \u042f \u0456 \u0433\u044d\u0442\u0430 \u0440\u0430\u0437\u0432\u0435\u0439\u0432\u0430\u044e \u043f\u0430 \u0456\u043c. \u0427\u0430\u043c\u0443? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u0411\u043e \u041c\u043e\u0439 \u0434\u043e\u043c \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u044b \u0430 \u0432\u044b \u0437\u0430\u043d\u044f\u0442\u044b\u044f \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0430\u043c. \u0422\u0430\u043c\u0443 \u043d\u044f\u0431\u0451\u0441\u044b \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456 \u0440\u0430\u0441\u0443, \u0430 \u0437\u044f\u043c\u043b\u044f \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0441\u0432\u043e\u0439 \u043f\u043b\u0451\u043d. \u042f \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0437\u0430\u0441\u0443\u0445\u0443 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0456 \u043d\u0430 \u0433\u043e\u0440\u044b, \u043d\u0430 \u0437\u0431\u043e\u0436\u0436\u0430 \u0456 \u043d\u0430 \u043c\u0430\u043b\u0430\u0434\u043e\u0435 \u0432\u0456\u043d\u043e, \u043d\u0430 \u0430\u043b\u0435\u0439 \u0456 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0435 \u0440\u0430\u043b\u043b\u044f, \u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043d\u0430 \u0436\u044b\u0432\u0451\u043b\u0443, \u0456 \u043d\u0430 \u045e\u0441\u044e \u043f\u0440\u0430\u0446\u0443 \u0440\u0443\u043a\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044c, \u0441\u044b\u043d \u0428\u044d\u0430\u043b\u044c\u0442\u044b\u044d\u043b\u044f, \u0456 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u0415\u0446\u0430\u0434\u0430\u043a\u0430, \u0456 \u045e\u0441\u044f \u0440\u044d\u0448\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u045e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0456\u0445\u043d\u0456, \u0456 \u043d\u0430\u0440\u043e\u0434 \u0430\u0445\u0430\u043f\u0456\u045e \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430. \u0410 \u043f\u0430\u0441\u043b\u0430\u043d\u0435\u0446 \u041f\u0430\u043d\u0430 \u0410\u0433\u0435\u0439 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u042f\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u201d\u042f \u0437 \u0432\u0430\u043c\u0456\u201d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d\u00bb. \u0422\u0430\u0434\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u041f\u0430\u043d \u0434\u0443\u0445 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044f, \u0441\u044b\u043d\u0430 \u0428\u044d\u0430\u043b\u044c\u0442\u044b\u044d\u043b\u044f, \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430 \u042e\u0434\u044b, \u0434\u0443\u0445 \u0415\u0437\u0443\u0441\u0430, \u0441\u044b\u043d\u0430 \u0415\u0446\u0430\u0434\u0430\u043a\u0430, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0456 \u0434\u0443\u0445 \u0443\u0441\u0451\u0439 \u0440\u044d\u0448\u0442\u044b \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u0446\u044b \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0443 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0448\u043e\u0441\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0443 \u0434\u0440\u0443\u0433\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0414\u0430\u0440\u044b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0423 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u0441\u0451\u043c\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f: \u00ab\u0421\u043a\u0430\u0436\u044b \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044e, \u0441\u044b\u043d\u0443 \u0428\u044d\u0430\u043b\u044c\u0442\u044b\u044d\u043b\u044f, \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0443 \u042e\u0434\u044b, \u0456 \u0415\u0437\u0443\u0441\u0443, \u0441\u044b\u043d\u0443 \u0415\u0446\u0430\u0434\u0430\u043a\u0430, \u0432\u044f\u043b\u0456\u043a\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u0430\u0440\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u044d\u0448\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0443:<\/span><\/p>\r\n<p style=\"text-indent: 35.4pt; text-align: justify;\"><span>\u00ab\u0426\u0456 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043d\u0435\u0445\u0442\u0430, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u044b \u0434\u043e\u043c \u0443 \u044f\u0433\u043e \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0439 \u0441\u043b\u0430\u0432\u0435? \u0406 \u044f\u043a\u0456\u043c \u0432\u044b \u0431\u0430\u0447\u044b\u0446\u0435 \u044f\u0433\u043e \u0441\u0451\u043d\u043d\u044f? \u0426\u0456 \u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u0443 \u0432\u0430\u0447\u0430\u0445 \u0432\u0430\u0448\u044b\u0445, \u0448\u0442\u043e \u044f\u0433\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u044f\u043c\u0430? \u0410\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b\u043c, \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b\u043c, \u0415\u0437\u0443\u0441\u0435, \u0441\u044b\u043d\u0435 \u0415\u0446\u0430\u0434\u0430\u043a\u0430, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0441\u0432\u044f\u0442\u0430\u0440, \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b\u043c, \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043f\u0440\u0430\u0446\u0443\u0439\u0446\u0435, \u0431\u043e \u042f \u0437 \u0432\u0430\u043c\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0434\u0430\u045e \u0432\u0430\u043c \u0443 \u0447\u0430\u0441 \u0432\u044b\u0439\u0441\u0446\u044f \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0414\u0443\u0445 \u041c\u043e\u0439 \u0436\u044b\u0432\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u2013 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f\u0448\u0447\u044d \u0440\u0430\u0437, \u0443 \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435, \u042f \u045e\u0437\u0440\u0443\u0448\u0443 \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0437\u044f\u043c\u043b\u044e, \u043c\u043e\u0440\u0430 \u0456 \u0441\u0443\u0448\u0443. \u0423\u0437\u0440\u0443\u0448\u0443 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0441\u043a\u0430\u0440\u0431\u044b \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u042f \u043d\u0430\u043f\u043e\u045e\u043d\u044e \u0434\u043e\u043c \u0433\u044d\u0442\u044b \u0441\u043b\u0430\u0432\u0430\u044e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u041c\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430, \u0456 \u041c\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0437\u043e\u043b\u0430\u0442\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u0406 \u0441\u043b\u0430\u0432\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0434\u043e\u043c\u0443 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439, \u0447\u044b\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0423 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u042f \u0430\u0434\u0430\u0440\u0443 \u0441\u043f\u0430\u043a\u043e\u0435\u043c\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0410\u0433 1, 8; \u0406\u0441 56, 7\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u0456 \u0431\u0443\u0434\u0443\u0439\u0446\u0435 \u0434\u043e\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u042f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443 \u0456\u043c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u043e\u043c \u041c\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0434\u043e\u043c\u0430\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u042f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"282","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f <\/span><span style=\"color: #ff0000;\">2, 10-23<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0443\u0447\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044e<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0443 \u0434\u0440\u0443\u0433\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0414\u0430\u0440\u044b\u044f, \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0433\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u041f\u0440\u0430\u0448\u0443, \u0441\u043f\u044b\u0442\u0430\u0439\u0441\u044f \u045e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043f\u0440\u0430 \u0417\u0430\u043a\u043e\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0441\u0446\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0435 \u043c\u044f\u0441\u0430 \u045e \u043f\u0430\u0434\u043e\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0430 \u044f\u0433\u043e \u043a\u0440\u0430\u0435\u043c \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0434\u0430 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u0430\u0439 \u0441\u0442\u0440\u0430\u0432\u044b, \u0434\u0430 \u0432\u0456\u043d\u0430, \u0430\u043b\u0435\u044e \u0456 \u0434\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0435\u0436\u044b, \u0446\u0456 \u0441\u0442\u0430\u043d\u0435 \u0433\u044d\u0442\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u043c?\u201d\u00bb. \u0421\u0432\u044f\u0442\u0430\u0440\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u041d\u0435\u00bb. \u0422\u0430\u0434\u044b \u0410\u0433\u0435\u0439 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u00ab\u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u0445\u0442\u043e \u0441\u0442\u0430\u045e \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c, \u0431\u043e \u0434\u0430\u0442\u043a\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0442\u0440\u0443\u043f\u0430, \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430, \u0446\u0456 \u0441\u0442\u0430\u043d\u0435 \u044f\u043d\u043e \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c?\u00bb \u0421\u0432\u044f\u0442\u0430\u0440\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u042f\u043d\u043e \u0441\u0442\u0430\u043d\u0435 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c\u00bb. \u0422\u0430\u0434\u044b \u0410\u0433\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0443 \u0430\u0434\u043a\u0430\u0437: \u00ab\u0422\u0430\u043a\u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0456 \u0442\u0430\u043a\u0456 \u0433\u044d\u0442\u0430 \u043b\u044e\u0434 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0456 \u0442\u0430\u043a\u0430\u044f \u043a\u043e\u0436\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u0456\u0445\u043d\u0456\u0445 \u0440\u0443\u043a, \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0445\u0432\u044f\u0440\u0443\u044e\u0446\u044c \u0442\u0430\u043c, \u044f\u043d\u043e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0448\u0443, \u0440\u0430\u0437\u0432\u0430\u0436\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u0434\u0430 \u0434\u043d\u044f, \u044f\u043a \u0431\u044b\u045e \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043a\u0430\u043c\u0435\u043d\u044c \u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430. \u042f\u043a \u0432\u0430\u043c \u0436\u044b\u043b\u043e\u0441\u044f? \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u0430 \u043a\u0443\u0447\u044b \u0437 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0456 \u043c\u0435\u0440\u0430\u045e, \u0430 \u0431\u044b\u043b\u043e \u0456\u0445 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0434\u0430 \u0434\u0430\u0432\u0456\u043b\u0430, \u043a\u0430\u0431 \u0437\u0430\u0447\u044d\u0440\u043f\u043d\u0443\u0446\u044c \u043f\u044f\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u043c\u0435\u0440\u0430\u045e, \u0430 \u0431\u044b\u043b\u043e \u0456\u0445 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c. \u042f \u0443\u0434\u0430\u0440\u044b\u045e \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0432\u0430\u0448\u044b\u0445 \u0440\u0443\u043a \u0441\u043f\u0451\u043a\u0430\u044e, \u0446\u0432\u0456\u043b\u043b\u044e \u0456 \u0433\u0440\u0430\u0434\u0430\u043c, \u0430\u043b\u0435 \u0432\u044b \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u041f\u0440\u0430\u0448\u0443, \u0440\u0430\u0437\u0432\u0430\u0436\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0430\u0434 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0430\u0434 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430. \u0420\u0430\u0437\u0432\u0430\u0436\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445. \u0426\u0456 \u0451\u0441\u0446\u044c \u044f\u0448\u0447\u044d \u0437\u0435\u0440\u043d\u0435 \u045e \u0441\u0432\u0456\u0440\u043d\u0435? \u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430, \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u0430, \u0434\u0440\u044d\u0432\u0430 \u0433\u0440\u0430\u043d\u0430\u0442\u0443 \u0456 \u0430\u043b\u0456\u045e\u043a\u0430\u0432\u0430\u0435 \u0434\u0440\u044d\u0432\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u044f\u0448\u0447\u044d \u043f\u043b\u043e\u0434\u0443. \u0410\u0434\u043d\u0430\u043a \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u042f \u0431\u0443\u0434\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c\u00bb. \u0406 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u041f\u0430\u043d \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0434\u0430 \u0410\u0433\u0435\u044f \u045e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u043a\u0430\u0436\u044b \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044e, \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0443 \u042e\u0434\u044b: \u042f \u045e\u0441\u043a\u0430\u043b\u044b\u0445\u043d\u0443 \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0437\u044f\u043c\u043b\u044e. \u0410\u0431\u044f\u0440\u043d\u0443 \u0442\u0440\u043e\u043d\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e \u0456 \u0437\u043d\u0456\u0448\u0447\u0443 \u043c\u043e\u0446 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0430\u0431\u044f\u0440\u043d\u0443 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443 \u0456 \u044f\u0435 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e, \u0430 \u043a\u043e\u043d\u0456 \u0434\u044b \u0456\u0445 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u045e\u043f\u0430\u0434\u0443\u0446\u044c, \u043a\u043e\u0436\u043d\u044b \u0430\u0434 \u043c\u044f\u0447\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0432\u0430\u0437\u044c\u043c\u0443 \u0446\u044f\u0431\u0435, \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044c, \u0441\u044b\u043d\u0435 \u0428\u044d\u0430\u043b\u044c\u0442\u044b\u044d\u043b\u044f, \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435 \u044f\u043a \u043f\u044f\u0447\u0430\u0446\u044c, \u0431\u043e \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u0446\u044f\u0431\u0435\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u0433 2, 7. 9b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u0437\u0440\u0443\u0448\u0443 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0441\u043a\u0430\u0440\u0431\u044b \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u044e \u0434\u043e\u043c \u0433\u044d\u0442\u044b \u0441\u043b\u0430\u0432\u0430\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u042f \u0434\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u043d\u0430\u043f\u043e\u045e\u043d\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"283","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">1, 1 \u2013 2, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0430\u0434\u0431\u0443\u0434\u043e\u0432\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423 \u0432\u043e\u0441\u044c\u043c\u044b \u043c\u0435\u0441\u044f\u0446, \u0443 \u0434\u0440\u0443\u0433\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0414\u0430\u0440\u044b\u044f \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456, \u0441\u044b\u043d\u0430 \u0411\u044d\u0440\u044d\u043a\u0456\u0456, \u0441\u044b\u043d\u0430 \u0406\u0434\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041c\u043e\u0446\u043d\u0430 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u041f\u0430\u043d \u043d\u0430 \u0430\u0439\u0446\u043e\u045e \u0432\u0430\u0448\u044b\u0445. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0412\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0456 \u042f \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0434\u0430 \u0432\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u041d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435, \u044f\u043a \u0432\u0430\u0448\u044b\u044f \u0430\u0439\u0446\u044b, \u0434\u0430 \u044f\u043a\u0456\u0445 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u0440\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u041f\u0430\u043a\u0456\u043d\u044c\u0446\u0435 \u0441\u0432\u0430\u0435 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0456 \u0441\u0432\u0430\u0435 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456! \u0410\u043b\u0435 \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u043d\u0430 \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0414\u0437\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f? \u0406 \u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0456? \u0426\u0456 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0456 \u041c\u0430\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u042f \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u2013 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c, \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0432\u0430\u0448\u044b\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e? \u042f\u043d\u044b \u043f\u0430\u043a\u0430\u044f\u043b\u0456\u0441\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u201c\u042f\u043a \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0437 \u043d\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0448\u044b\u0445 \u0448\u043b\u044f\u0445\u043e\u045e \u0456 \u043d\u0430\u0448\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u0442\u0430\u043a \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0437 \u043d\u0430\u043c\u0456\u201d\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u0437\u0456\u043d\u0430\u0446\u0446\u0430\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u043c\u0435\u0441\u044f\u0446\u0430 \u0428\u044d\u0432\u0430\u0442, \u0443 \u0434\u0440\u0443\u0433\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0414\u0430\u0440\u044b\u044f, \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456, \u0441\u044b\u043d\u0430 \u0411\u044d\u0440\u044d\u043a\u0456\u0456, \u0441\u044b\u043d\u0430 \u0406\u0434\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0423 \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447 \u044f \u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c \u043d\u0435\u0439\u043a\u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a \u0431\u044b\u045e \u043d\u0430 \u0433\u043d\u044f\u0434\u044b\u043c \u043a\u0430\u043d\u0456. \u0401\u043d \u0441\u0442\u0430\u044f\u045e \u0441\u044f\u0440\u043e\u0434 \u043c\u0456\u0440\u0442\u0430\u045e \u0443 \u0434\u0430\u043b\u0456\u043d\u0435, \u0430 \u0437\u0430 \u0456\u043c \u0431\u044b\u043b\u0456 \u043a\u043e\u043d\u0456 \u0433\u043d\u044f\u0434\u044b\u044f, \u043a\u0430\u0448\u0442\u0430\u043d\u0430\u0432\u044b\u044f \u0456 \u0431\u0435\u043b\u044b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0406 \u044f \u0441\u043f\u044b\u0442\u0430\u045e: \u201c\u041c\u043e\u0439 \u041f\u0430\u043d\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c?\u201d \u0410\u043d\u0451\u043b, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u201c\u042f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c\u201d. \u0422\u0430\u0434\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u0443\u0436, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u0441\u044f\u0440\u043e\u0434 \u043c\u0456\u0440\u0442\u0430\u045e: \u201c\u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u041f\u0430\u043d \u0430\u0431\u044b\u0441\u0446\u0456 \u0437\u044f\u043c\u043b\u044e\u201d. \u0410 \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u0430\u043d\u0451\u043b\u0443 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u0441\u044f\u0440\u043e\u0434 \u043c\u0456\u0440\u0442\u0430\u045e: \u201c\u041c\u044b \u0430\u0431\u044b\u0448\u043b\u0456 \u0437\u044f\u043c\u043b\u044e \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u0437\u0430\u0441\u0435\u043b\u0435\u043d\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u044f\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0434\u0430\u043a\u0443\u043b\u044c \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u042e\u0434\u044b, \u043d\u0430 \u044f\u043a\u0456\u044f \u0433\u043d\u0435\u0432\u0430\u0435\u0448\u0441\u044f \u045e\u0436\u043e \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0433\u0430\u0434\u043e\u045e?\u201d \u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0430\u043d\u0451\u043b\u0443, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u0430\u043d\u0451\u043b, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u201c\u0417\u0430\u043a\u043b\u0456\u043a\u0430\u0439, \u043a\u0430\u0436\u0443\u0447\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f \u043f\u0430\u043b\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0421\u0456\u0451\u043d\u0430, \u0430\u043b\u0435 \u042f \u043c\u043e\u0446\u043d\u0430 \u0433\u043d\u0435\u0432\u0430\u044e\u0441\u044f \u043d\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f, \u043a\u0430\u043b\u0456 \u042f \u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043a\u0440\u044b\u0445\u0443, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0437\u043b\u043e. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u042f \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e, \u0430\u0434\u0431\u0443\u0434\u0443\u044e \u045e \u0456\u043c \u041c\u043e\u0439 \u0434\u043e\u043c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0456 \u043c\u0435\u0440\u043d\u044b \u0448\u043d\u0443\u0440 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u0442\u044b \u043d\u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c. \u0417\u0430\u043a\u043b\u0456\u043a\u0430\u0439 \u044f\u0448\u0447\u044d, \u043a\u0430\u0436\u0443\u0447\u044b:&nbsp; \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0417\u043d\u043e\u045e \u041c\u0430\u0435 \u0433\u0430\u0440\u0430\u0434\u044b \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e\u043c, \u0430 \u041f\u0430\u043d \u0437\u043d\u043e\u045e \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u0421\u0456\u0451\u043d \u0456 \u0437\u043d\u043e\u045e \u0432\u044b\u0431\u044f\u0440\u044d \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u201d.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u044f \u045e\u0437\u043d\u044f\u045e \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0447\u0430\u0442\u044b\u0440\u044b \u0440\u043e\u0433\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f \u0430\u043d\u0451\u043b\u0443, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e: \u201c\u0428\u0442\u043e \u044f\u043d\u044b \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c?\u201d \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u201c\u0413\u044d\u0442\u0430 \u0440\u043e\u0433\u0456, \u044f\u043a\u0456\u044f \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456 \u042e\u0434\u0443, \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0406 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430\u045e. \u0410 \u044f \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u201c\u0428\u0442\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0431\u0456\u0446\u044c?\u201d \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u201c\u0413\u044d\u0442\u044b\u044f \u0440\u043e\u0433\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456 \u042e\u0434\u0443, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u043d\u044f\u045e \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u044b. \u0410 \u0433\u044d\u0442\u044b\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c, \u043a\u0430\u0431 \u0437\u043b\u0430\u043c\u0430\u0446\u044c \u0440\u043e\u0433\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u045e\u0437\u043d\u044f\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u0456 \u042e\u0434\u044b, \u043a\u0430\u0431 \u044f\u0435 \u0440\u0430\u0441\u0441\u0435\u044f\u0446\u044c\u201d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0417\u0430\u0445 1, 16a; \u0410\u043f 21, 23<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430\u0434\u0431\u0443\u0434\u0443\u044e \u045e \u0456\u043c \u041c\u043e\u0439 \u0434\u043e\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0413\u043e\u0440\u0430\u0434\u0443 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u043d\u0456 \u0441\u043e\u043d\u0446\u0430, \u043d\u0456 \u043c\u0435\u0441\u044f\u0446, \u0431\u043e \u0441\u0432\u0435\u0442\u0430\u0447 \u044f\u0433\u043e\u043d\u044b \u2013 \u0411\u0430\u0440\u0430\u043d\u0430\u043a.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u0431\u0443\u0434\u0443\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"284","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">3, 1 \u2013 4, 14<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u043a\u043d\u044f\u0437\u044e \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044e \u0456 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u0430\u0440\u0443 \u0415\u0437\u0443\u0441\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0415\u0437\u0443\u0441\u0430, \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c \u041f\u0430\u043d\u0430, \u0456 \u0441\u0430\u0442\u0430\u043d\u0443, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u044f\u0433\u043e, \u043a\u0430\u0431 \u044f\u0433\u043e \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u0442\u0430\u043d\u0435: \u00ab\u041f\u0430\u043d \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0446\u044f\u0431\u0435, \u0441\u0430\u0442\u0430\u043d\u0430, \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u0426\u0456 \u043d\u0435 \u0433\u044d\u0442\u0430\u044f \u0433\u0430\u043b\u0430\u0432\u0435\u0448\u043a\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0445\u0430\u043f\u043b\u0435\u043d\u0430 \u0437 \u0430\u0433\u043d\u044f?\u00bb \u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u044b\u044f \u0448\u0430\u0442\u044b \u0456 \u0441\u0442\u0430\u044f\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c. \u0422\u043e\u0439 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0442\u0430\u044f\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0417\u0434\u044b\u043c\u0456\u0446\u0435 \u0437 \u044f\u0433\u043e \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u044b\u044f \u0448\u0430\u0442\u044b\u00bb. \u0410 \u044f\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0413\u043b\u044f\u0434\u0437\u0456, \u044f \u0437\u043d\u044f\u045e \u0437 \u0446\u044f\u0431\u0435 \u0442\u0432\u043e\u0439 \u0433\u0440\u044d\u0445, \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u0432\u0430 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435\u00bb. \u0406 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0417\u0430\u0432\u044f\u0436\u044b\u0446\u0435 \u044f\u043c\u0443 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u0447\u044b\u0441\u0442\u044b \u0442\u0443\u0440\u0431\u0430\u043d\u00bb. \u0422\u0430\u0434\u044b \u044f\u043d\u044b \u0437\u0430\u0432\u044f\u0437\u0430\u043b\u0456 \u044f\u043c\u0443 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u0447\u044b\u0441\u0442\u044b \u0442\u0443\u0440\u0431\u0430\u043d \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456 \u044f\u0433\u043e \u045e \u0448\u0430\u0442\u044b. \u0410\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0441\u0442\u0430\u044f\u045e \u043f\u043e\u0431\u0430\u0447.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0415\u0437\u0443\u0441\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u041c\u0430\u0456\u043c\u0456 \u0434\u0430\u0440\u043e\u0433\u0430\u043c\u0456 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u041c\u0430\u0435 \u0437\u0430\u0433\u0430\u0434\u044b, \u0442\u043e \u0442\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u041c\u0430\u0456\u043c \u0434\u043e\u043c\u0430\u043c \u0456 \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u041c\u0430\u0435 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b, \u0430 \u044f \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0442\u0430\u0431\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0442\u0430\u0456\u0446\u044c \u0442\u0443\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0436\u0430, \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0441\u0432\u044f\u0442\u0430\u0440, \u0442\u044b \u0456 \u0442\u0432\u0430\u0435 \u0441\u0430\u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u0441\u044f\u0434\u0437\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043f\u0440\u0430\u0434\u0432\u0435\u0441\u0446\u044f. \u0411\u043e \u0432\u043e\u0441\u044c \u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u0430\u0442\u043e\u0436\u044b\u043b\u0430\u043a. \u0412\u043e\u0441\u044c \u043a\u0430\u043c\u0435\u043d\u044c, \u044f\u043a\u0456 \u042f \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0415\u0437\u0443\u0441\u0430\u043c. \u041d\u0430 \u0430\u0434\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0456 \u0441\u0435\u043c \u0432\u0430\u0447\u044d\u0439. \u042f \u0432\u044b\u0431\u2019\u044e \u043d\u0430 \u0456\u043c \u043d\u0430\u0434\u043f\u0456\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0456 \u043f\u0440\u044b\u0431\u044f\u0440\u0443 \u0433\u0440\u044d\u0445 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0437\u0430 \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c. \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u043f\u0430\u0434 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0456 \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u0443\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u0442\u044b\u043c \u0430\u043d\u0451\u043b, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0456 \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u043c\u044f\u043d\u0435 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u043e\u0433\u0430 \u0431\u0443\u0434\u0437\u044f\u0446\u044c \u0441\u0430 \u0441\u043d\u0443, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0428\u0442\u043e \u0442\u044b \u0431\u0430\u0447\u044b\u0448?\u00bb \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0411\u0430\u0447\u0443 \u0441\u0432\u0435\u0447\u043d\u0456\u043a \u0443\u0432\u0435\u0441\u044c \u0437 \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0447\u0430\u0448\u0443 \u043d\u0430 \u044f\u0433\u043e \u0432\u0435\u0440\u0441\u0435, \u0456 \u0441\u0435\u043c \u043b\u044f\u043c\u043f\u0430\u045e \u043d\u0430 \u0456\u043c, \u0456 \u0441\u0435\u043c \u0442\u0440\u0443\u0431\u0430\u043a \u0434\u0430 \u0441\u044f\u043c\u0456 \u043b\u044f\u043c\u043f\u0430\u045e, \u0448\u0442\u043e \u043d\u0430 \u0432\u0435\u0440\u0441\u0435 \u044f\u0433\u043e. \u0410 \u043a\u0430\u043b\u044f \u044f\u0433\u043e \u0434\u0437\u0432\u0435 \u0430\u043b\u0456\u045e\u043a\u0456, \u0430\u0434\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u0430 \u0430\u0434 \u0447\u0430\u0448\u044b, \u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u0437\u043b\u0435\u0432\u0430 \u0430\u0434 \u044f\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u044f \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043c\u043e\u0439 \u043f\u0430\u043d\u0435?\u00bb \u0423 \u0430\u0434\u043a\u0430\u0437 \u0430\u043d\u0451\u043b, \u044f\u043a\u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0441\u043f\u044b\u0442\u0430\u045e \u043c\u044f\u043d\u0435: \u00ab\u0426\u0456 \u0436 \u0442\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c?\u00bb \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435, \u043c\u043e\u0439 \u043f\u0430\u043d\u0435!\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0451\u043d \u0443 \u0430\u0434\u043a\u0430\u0437 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0413\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044e: \u201c\u041d\u0435 \u043f\u0440\u0430\u0437 \u0441\u0456\u043b\u0443 \u0456 \u043c\u043e\u0446, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0430\u201d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0427\u044b\u043c \u0442\u044b \u0451\u0441\u0446\u044c, \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0433\u0430\u0440\u0430? \u041f\u0435\u0440\u0430\u0434 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u0435\u043c \u0441\u0442\u0430\u043d\u0435\u0448 \u0440\u0430\u045e\u043d\u0456\u043d\u0430\u044e! \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435 \u043a\u0440\u0430\u0435\u0432\u0443\u0433\u043e\u043b\u044c\u043d\u044b \u043a\u0430\u043c\u0435\u043d\u044c \u0437 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u043c\u0456: \u201c\u0421\u043f\u0430\u0433\u0430\u0434\u0430, \u0441\u043f\u0430\u0433\u0430\u0434\u0430 \u044f\u043c\u0443!\u201d\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0420\u0443\u043a\u0456 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044f \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u043f\u0430\u0434 \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u0456 \u044f\u0433\u043e \u0440\u0443\u043a\u0456 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u044c \u044f\u0433\u043e. \u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u0448, \u0448\u0442\u043e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441. \u0411\u043e \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0433\u0440\u044d\u0431\u0430\u0432\u0430\u0446\u044c \u0434\u043d\u0451\u043c \u043c\u0430\u043b\u044b\u0445 \u0441\u043f\u0440\u0430\u045e? \u042f\u043d\u044b \u045e\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430, \u0431\u043e \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u043a\u0430\u043c\u0435\u043d\u044c, \u0430\u0434\u0432\u0435\u0441 \u0443 \u0440\u0443\u043a\u0430\u0445 \u0417\u0430\u0440\u0430\u0431\u0430\u0431\u044d\u043b\u044f. \u0410 \u0433\u044d\u0442\u044b\u044f \u0441\u0435\u043c \u043b\u044f\u043c\u043f \u2013 \u0433\u044d\u0442\u0430 \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430, \u044f\u043d\u044b \u043a\u0440\u0443\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u0439\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0430\u0434\u043a\u0430\u0437 \u044f \u0441\u043f\u044b\u0442\u0430\u045e \u044f\u0433\u043e: \u00ab\u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0434\u0432\u0430 \u0430\u043b\u0456\u045e\u043a\u0430\u0432\u044b\u044f \u0434\u0440\u044d\u0432\u044b \u0441\u043f\u0440\u0430\u0432\u0430 \u0456 \u0437\u043b\u0435\u0432\u0430 \u0430\u0434 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430?\u00bb \u0406 \u0437\u043d\u043e\u045e \u044f \u0430\u0434\u0430\u0437\u0432\u0430\u045e\u0441\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0434\u0437\u0432\u0435 \u0430\u043b\u0456\u045e\u043a\u0430\u0432\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0437 \u0434\u0437\u0432\u0435 \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u0442\u0440\u0443\u0431\u043a\u0456 \u0432\u044b\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0437 \u0441\u044f\u0431\u0435 \u0437\u043e\u043b\u0430\u0442\u0430?\u00bb \u0401\u043d \u0441\u043f\u044b\u0442\u0430\u045e \u043c\u044f\u043d\u0435: \u00ab\u0426\u0456 \u0436 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c?\u00bb \u042f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435, \u043c\u043e\u0439 \u043f\u0430\u043d\u0435\u00bb. \u0422\u0430\u0434\u044b \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0413\u044d\u0442\u0430 \u0434\u0432\u0430 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 11, 4. \u043f\u0430\u0440. 3<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043d\u044b \u044f\u043a \u0434\u0432\u0430 \u0434\u0440\u044d\u0432\u044b \u0430\u043b\u0456\u045e\u043d\u044b\u044f \u0456 \u0434\u0432\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0448\u0442\u043e \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c, \u0431\u043e \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u0443\u043b\u0430\u0434\u0443 \u0434\u0432\u0443\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0442\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"285","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">8, 1-17. 20-23<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0421\u0456\u0451\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0406 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0434\u0430 \u0421\u0456\u0451\u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u044d\u045e\u043d\u0430\u0441\u0446\u044e, \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u0442\u0440\u0430\u0441\u0446\u044e \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0434\u0430 \u044f\u0433\u043e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u042f \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u043d\u0430 \u0421\u0456\u0451\u043d \u0456 \u043f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456, \u0430 \u0433\u0430\u0440\u0430 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0421\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0421\u0442\u0430\u0440\u044b\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u0430\u0445 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043a\u043e\u0436\u043d\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043a\u0456\u0435\u043c \u0443 \u0440\u0443\u0446\u044d \u0441\u0432\u0430\u0451\u0439 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0435\u043a\u0443. \u0406 \u0432\u0443\u043b\u0456\u0446\u044b \u0433\u043e\u0440\u0430\u0434\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0445\u043b\u0430\u043f\u0447\u0443\u043a\u0430\u043c\u0456 \u0456 \u0434\u0437\u044f\u045e\u0447\u0430\u0442\u0430\u043c\u0456, \u0448\u0442\u043e \u0433\u0443\u043b\u044f\u044e\u0446\u044c \u043d\u0430 \u044f\u0433\u043e \u0432\u0443\u043b\u0456\u0446\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u041a\u0430\u043b\u0456 \u045e \u0442\u044b\u044f \u0434\u043d\u0456 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0434\u0437\u0456\u045e\u043d\u044b\u043c \u0443 \u0432\u0430\u0447\u0430\u0445 \u0440\u044d\u0448\u0442\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0446\u0456 \u0436 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430 \u0434\u0437\u0456\u045e\u043d\u044b\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u041c\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0412\u043e\u0441\u044c \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u045e\u0441\u0445\u043e\u0434\u0443 \u0456 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430. \u042f \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445, \u0456 \u044f\u043d\u044b \u043f\u0430\u0441\u0435\u043b\u044f\u0446\u0446\u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0456 \u0432\u0430\u0448\u044b\u044f, \u0440\u0443\u043a\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u045e \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u0441\u043b\u043e\u0432\u044b \u0433\u044d\u0442\u044b\u044f \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0437\u0430\u043a\u043b\u0430\u0434\u0430\u045e \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0435. \u0414\u0430 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0451\u043d \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043b\u0430\u0442\u044b \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043b\u0430\u0442\u044b \u0434\u043b\u044f \u0436\u044b\u0432\u0451\u043b\u044b. \u041d\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e, \u043d\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e, \u043d\u0435 \u043c\u0435\u045e \u0441\u043f\u0430\u043a\u043e\u044e \u0430\u0434 \u0432\u043e\u0440\u0430\u0433\u0430, \u0431\u043e \u042f \u043f\u0430\u0434\u0431\u0443\u0445\u0442\u043e\u0440\u0432\u0430\u045e \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0410 \u0446\u044f\u043f\u0435\u0440 \u042f \u0431\u0443\u0434\u0443 \u0434\u043b\u044f \u0440\u044d\u0448\u0442\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043d\u0435 \u0442\u0430\u043a\u0456\u043c \u044f\u043a \u0443 \u0431\u044b\u043b\u044b\u044f \u0434\u043d\u0456\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u0422\u0430\u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435 \u0437\u0435\u0440\u043d\u0435 \u0441\u043f\u0430\u043a\u043e\u044e: \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0434\u0430\u0441\u0446\u044c \u0441\u0432\u043e\u0439 \u043f\u043b\u043e\u0434, \u0456 \u0437\u044f\u043c\u043b\u044f \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0441\u0432\u043e\u0439 \u043f\u043b\u0451\u043d, \u0430 \u043d\u044f\u0431\u0451\u0441\u044b \u0441\u043f\u0430\u0448\u043b\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0440\u0430\u0441\u0443. \u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u0440\u044d\u0448\u0442\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0406 \u044f\u043a \u0431\u044b\u043b\u0456 \u0432\u044b \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u043e\u043c\u0435 \u042e\u0434\u044b \u0456 \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0442\u0430\u043a \u042f \u0432\u0430\u0441 \u0443\u0440\u0430\u0442\u0443\u044e, \u0456 \u0432\u044b \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u0432\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u00ab\u042f\u043a \u042f \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0441\u043f\u0430\u0441\u043b\u0430\u0446\u044c \u043d\u0430 \u0432\u0430\u0441 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u0430\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0456 \u041c\u043e\u0439 \u0433\u043d\u0435\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0456 \u042f \u043d\u0435 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u0430\u043a \u0443 \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u042f \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u0456 \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0443 \u0456 \u0434\u043e\u043c\u0443 \u042e\u0434\u044b. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f!<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0431\u0456\u0446\u044c: \u043a\u0430\u0436\u044b\u0446\u0435 \u043f\u0440\u0430\u045e\u0434\u0443, \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443, \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u043c\u0456\u0440\u043d\u044b\u043c \u0441\u0443\u0434\u043e\u043c \u0441\u0443\u0434\u0437\u0456\u0446\u0435 \u045e \u0432\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u043c\u0430\u0445. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435 \u0437\u043b\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0456 \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u0435 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0439 \u043f\u0440\u044b\u0441\u044f\u0433\u0456, \u0431\u043e \u042f \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u00ab\u042f\u0448\u0447\u044d \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0436\u044b\u0445\u0430\u0440\u044b \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e. \u0416\u044b\u0445\u0430\u0440\u044b \u0430\u0434\u043d\u0430\u0433\u043e \u0433\u043e\u0440\u0430\u0434\u0430 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u0414\u0430\u0432\u0430\u0439\u0446\u0435 \u043f\u043e\u0439\u0434\u0437\u0435\u043c, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u0448\u0443\u043a\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0439\u0434\u0443!\u201d \u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u044f \u043f\u043b\u044f\u043c\u0451\u043d\u044b, \u043a\u0430\u0431 \u0448\u0443\u043a\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0456 \u043c\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u043c\u0443\u0436\u043e\u045e \u0437 \u0443\u0441\u0456\u0445 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0456 \u043c\u043e\u0432\u0430\u045e \u0441\u0445\u043e\u043f\u044f\u0446\u0446\u0430 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0430 \u043a\u0440\u044b\u0441\u043e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0456 \u044e\u0434\u044d\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u041c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0437 \u0432\u0430\u043c\u0456, \u0431\u043e \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0437 \u0432\u0430\u043c\u0456 \u0411\u043e\u0433\u201d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0417\u0430\u0445 8, 7. 9\u0430; \u0414\u0437 3, 25\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u0412\u043e\u0441\u044c \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u045e\u0441\u0445\u043e\u0434\u0443 \u0456 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0456 \u0432\u0430\u0448\u044b\u044f, \u0440\u0443\u043a\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u045e \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u0441\u043b\u043e\u0432\u044b \u0433\u044d\u0442\u044b\u044f \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u044b \u2013 \u0441\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0411\u043e\u0433 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0430\u0439\u0446\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"286","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0430\u043b\u0430\u0445\u0456\u0456 <\/span><span style=\"color: #ff0000;\">1, 1-14; 2, 13-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043f\u0440\u0430 \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u043d\u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0434\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0437 \u041c\u0430\u043b\u0430\u0445\u0456\u044e. \u00ab\u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0410 \u0432\u044b \u043f\u044b\u0442\u0430\u0435\u0446\u0435\u0441\u044f: \u201c\u0423 \u0447\u044b\u043c \u0422\u0432\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u043d\u0430\u0441?\u201d \u0426\u0456 \u042d\u0437\u0430\u045e \u043d\u0435 \u0431\u044b\u045e \u0431\u0440\u0430\u0442\u0430\u043c \u042f\u043a\u0443\u0431\u0430? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0410 \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u042f\u043a\u0443\u0431\u0430, \u042d\u0437\u0430\u0432\u0430 \u0436 \u0443\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e. \u0410\u0434\u0434\u0430\u045e \u043d\u0430 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435 \u044f\u0433\u043e \u0433\u043e\u0440\u044b, \u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u044f\u0433\u043e \u2013 \u0448\u0430\u043a\u0430\u043b\u0430\u043c \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0425\u043e\u0446\u044c \u042d\u0434\u043e\u043c \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u041c\u044b \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b, \u0430\u043b\u0435 \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0456 \u0430\u0434\u0431\u0443\u0434\u0443\u0435\u043c \u0440\u0443\u0456\u043d\u044b\u201d, \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0442\u0430\u043a \u0441\u043a\u0430\u0436\u0430: \u201c\u042f\u043d\u044b \u0430\u0434\u0431\u0443\u0434\u0443\u044e\u0446\u044c, \u0430 \u042f \u0437\u0440\u0443\u0439\u043d\u0443\u044e\u201d. \u0422\u0430\u043c\u0443 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0456\u0445 \u043a\u0440\u0430\u0456\u043d\u0430\u0439 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u044f\u043a\u0456 \u041f\u0430\u043d \u043f\u0440\u0430\u043a\u043b\u044f\u045e \u043d\u0430\u0432\u0435\u043a\u0456. \u041a\u0430\u043b\u0456 \u0432\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0433\u044d\u0442\u0430, \u0432\u044b \u0441\u043a\u0430\u0436\u0430\u0446\u0435: \u201c\u041f\u0430\u043d \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0430-\u0437\u0430 \u043c\u0435\u0436\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0421\u044b\u043d \u0448\u0430\u043d\u0443\u0435 \u0431\u0430\u0446\u044c\u043a\u0443, \u0430 \u0441\u043b\u0443\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430. \u0410 \u043a\u0430\u043b\u0456 \u042f \u0410\u0439\u0446\u0435\u0446, \u0442\u043e \u0434\u0437\u0435 \u043f\u0430\u0448\u0430\u043d\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435? \u0406 \u043a\u0430\u043b\u0456 \u042f \u041f\u0430\u043d, \u0442\u043e \u0434\u0437\u0435 \u0431\u043e\u044f\u0437\u044c \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e? \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043a\u0430\u0436\u0430 \u0432\u0430\u043c, \u0441\u0432\u044f\u0442\u0430\u0440\u044b: \u201c\u0412\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0446\u0435 \u041c\u0430\u0456\u043c \u0456\u043c\u0435\u043d\u0435\u043c\u201d. \u0410\u043b\u0435 \u0432\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u201c\u0427\u044b\u043c \u043c\u044b \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u043b\u0456 \u0422\u0432\u0430\u0451 \u0456\u043c\u044f?\u201d \u0412\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0435 \u043d\u0430 \u041c\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u043d\u044f\u0447\u044b\u0441\u0442\u044b \u0445\u043b\u0435\u0431 \u0456 \u043f\u044b\u0442\u0430\u0435\u0446\u0435\u0441\u044f: \u201c\u0427\u044b\u043c \u043c\u044b \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u0435\u043c \u0426\u044f\u0431\u0435?\u201d \u0422\u044b\u043c, \u0448\u0442\u043e \u043a\u0430\u0436\u0430\u0446\u0435: \u201c\u0421\u0442\u043e\u043b \u041f\u0430\u043d\u0430 \u043d\u0435 \u0432\u0430\u0440\u0442\u044b \u043f\u0430\u0448\u0430\u043d\u044b\u201d. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u043b\u044f\u043f\u043e\u0435, \u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u0437\u043b\u043e? \u0406 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0435 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0435 \u0456 \u0445\u0432\u043e\u0440\u0430\u0435, \u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u0437\u043b\u043e? \u041f\u0430\u0441\u043f\u0440\u0430\u0431\u0443\u0439 \u0437\u0430\u043d\u0435\u0441\u0446\u0456 \u0433\u044d\u0442\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u043f\u0440\u0430\u0432\u0456\u0446\u0435\u043b\u044e. \u0426\u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b \u0442\u0430\u0431\u043e\u044e \u0456 \u0446\u0456 \u043f\u0440\u044b\u043c\u0435 \u0446\u044f\u0431\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u0430? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0441\u043f\u0440\u0430\u0431\u0443\u0439\u0446\u0435 \u045e\u043b\u0430\u0433\u043e\u0434\u0437\u0456\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u043a\u0430\u0431 \u0401\u043d \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456! \u041f\u0440\u0430\u0437 \u0432\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430. \u0426\u0456 \u0436 \u043f\u0440\u044b\u043c\u0435 \u0401\u043d \u043a\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437 \u0432\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0432\u0430\u0441 \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u0431\u0440\u0430\u043c\u044b, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0456 \u0434\u0430\u0440\u043c\u0430 \u041c\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a. \u042f \u043d\u0435 \u043c\u0430\u044e \u045e \u0432\u0430\u0441 \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043c\u0443 \u0434\u0430\u0440 \u0437 \u0432\u0430\u0448\u0430\u0439 \u0440\u0443\u043a\u0456. \u0411\u043e \u0430\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 \u0430\u0436 \u0434\u0430 \u044f\u0433\u043e \u0437\u0430\u0445\u0430\u0434\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f \u041c\u0430\u0451 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u0430 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u041c\u0430\u0439\u043c\u0443 \u0456\u043c\u0435\u043d\u0456 \u0456 \u0447\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f \u041c\u0430\u0451 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410 \u0432\u044b \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0435 \u044f\u0433\u043e \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0432\u0430\u044e: \u201c\u0421\u0442\u043e\u043b \u041f\u0430\u043d\u0430 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u044b, \u0456 \u043f\u043b\u043e\u0434 \u043d\u0430 \u0456\u043c, \u0435\u0436\u0430 \u044f\u0433\u043e \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u044f\u201d. \u0412\u044b \u043a\u0430\u0436\u0430\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u201c\u0428\u0442\u043e \u0437\u0430 \u043f\u0430\u043a\u0443\u0442\u0430!\u201d \u0406 \u0433\u0440\u044d\u0431\u0443\u0435\u0446\u0435 \u0433\u044d\u0442\u044b\u043c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u041f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u043a\u0440\u0430\u0434\u0437\u0435\u043d\u0430\u0435, \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0435 \u0456 \u0445\u0432\u043e\u0440\u0430\u0435. \u0426\u0456 \u042f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0433\u044d\u0442\u0430 \u0437 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435\u043c \u0437 \u0432\u0430\u0448\u0430\u0439 \u0440\u0443\u043a\u0456? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u0430\u0448\u0443\u043a\u0430\u043d\u0435\u0446, \u0443 \u0441\u0442\u0430\u0442\u043a\u0443 \u044f\u043a\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0441\u0430\u043c\u0435\u0446, \u0456 \u0451\u043d \u0430\u0431\u044f\u0446\u0430\u0435 \u044f\u0433\u043e, \u0430\u043b\u0435 \u0430\u0445\u0432\u044f\u0440\u0443\u0435 \u041f\u0430\u043d\u0443 \u0441\u043a\u0430\u043b\u0435\u0447\u0430\u043d\u0430\u0435. \u0411\u043e \u042f \u2013 \u0432\u044f\u043b\u0456\u043a\u0456 \u041a\u0430\u0440\u043e\u043b\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0430 \u0456\u043c\u044f \u041c\u0430\u0451 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0441\u0442\u0440\u0430\u0445 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0406 \u0434\u0440\u0443\u0433\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0440\u043e\u0431\u0456\u0446\u0435: \u0430\u0431\u043b\u0456\u0432\u0430\u0435\u0446\u0435 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u041f\u0430\u043d\u0430 \u0437 \u043f\u043b\u0430\u0447\u0430\u043c \u0456 \u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u0435\u043c, \u0431\u043e \u0401\u043d \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437 \u0432\u0430\u0448\u044b\u0445 \u0440\u0443\u043a. \u0406 \u0432\u044b \u043f\u044b\u0442\u0430\u0435\u0446\u0435\u0441\u044f: \u201c\u0427\u0430\u043c\u0443?\u201d \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u043d \u0431\u044b\u045e \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u043f\u0430\u043c\u0456\u0436 \u0442\u0430\u0431\u043e\u044e \u0456 \u043f\u0430\u043c\u0456\u0436 \u0436\u043e\u043d\u043a\u0430\u044e \u0442\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u044f\u043a\u043e\u0439 \u0442\u044b \u0437\u0434\u0440\u0430\u0434\u0437\u0456\u045e, \u0445\u043e\u0446\u044c \u0431\u044b\u043b\u0430 \u044f\u043d\u0430 \u0442\u0432\u0430\u0451\u0439 \u0441\u044f\u0431\u0440\u043e\u045e\u043a\u0430\u0439 \u0456 \u0436\u043e\u043d\u043a\u0430\u0439 \u0442\u0432\u0430\u0439\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443. \u0426\u0456 \u043d\u0435 \u0410\u0434\u0437\u0456\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0432\u0430\u0441, \u0434\u0430\u044e\u0447\u044b \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0430? \u0410 \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0433\u044d\u0442\u044b \u0410\u0434\u0437\u0456\u043d? \u041d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u0430 \u045e \u0434\u0443\u0445\u0443 \u0432\u0430\u0448\u044b\u043c, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0434\u0440\u0430\u0434\u0436\u0432\u0430\u0435 \u0436\u043e\u043d\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456. \u0411\u043e \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u044f\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u2013 \u0442\u043e\u0439 \u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0433\u0432\u0430\u043b\u0442\u0430\u043c \u043d\u0456\u0431\u044b \u0430\u0434\u0437\u0435\u043d\u043d\u0435\u043c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u0422\u0430\u043c\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u0430 \u045e \u0434\u0443\u0445\u0443 \u0432\u0430\u0448\u044b\u043c \u0456 \u043d\u0435 \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0439\u0446\u0435 \u0437\u0434\u0440\u0430\u0434\u044b\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0430\u043b 2, 5. 6\u0430; \u041f\u0441 110 (109), 4<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0441\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0431\u044b\u045e \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0435\u043c. \u042f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u044f\u0433\u043e \u0431\u043e\u044f\u0437\u0437\u044e, \u0456 \u0451\u043d \u0431\u0430\u044f\u045e\u0441\u044f \u041c\u044f\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u045e \u0443 \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u0445, \u0430 \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u044f\u0433\u043e\u043d\u044b\u043c \u044f\u0437\u044b\u043a\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e \u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435: \u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0430\u043a\u043e\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"287","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041c\u0430\u043b\u0430\u0445\u0456\u0456 <\/span><span style=\"color: #ff0000;\">3, 1-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u00ab\u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0430\u043d\u0451\u043b\u0430 \u043c\u0430\u0439\u0433\u043e, \u0456 \u0451\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e. \u0417\u0430\u0442\u044b\u043c \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0447\u0430\u043a\u0430\u0435\u0446\u0435, \u0456 \u0430\u043d\u0451\u043b \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u0446\u0435. \u0412\u043e\u0441\u044c \u0401\u043d \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u2013 \u0456 \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f, \u0456 \u0445\u0442\u043e \u045e\u0441\u0442\u0430\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0401\u043d \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430?&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e \u0401\u043d, \u044f\u043a \u0430\u0433\u043e\u043d\u044c \u043f\u043b\u0430\u0432\u0456\u043b\u044c\u0448\u0447\u044b\u043a\u0430, \u0456 \u044f\u043a \u043b\u0443\u0433, \u0448\u0442\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u0435. \u0401\u043d \u0441\u044f\u0434\u0437\u0435, \u044f\u043a \u043f\u043b\u0430\u0432\u0456\u043b\u044c\u0448\u0447\u044b\u043a \u0456 \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0441\u0435\u0440\u0430\u0431\u0440\u043e, \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u041b\u0435\u0432\u0456\u044f, \u0456 \u043f\u0435\u0440\u0430\u043f\u043b\u0430\u0432\u0456\u0446\u044c \u0456\u0445, \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0435\u0440\u0430\u0431\u0440\u043e, \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u041f\u0430\u043d\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u0430\u0434\u044b \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u041f\u0430\u043d\u0443 \u0430\u0445\u0432\u044f\u0440\u0430 \u042e\u0434\u044b \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u044f\u043a \u0443 \u0434\u043d\u0456 \u0434\u0430\u045e\u043d\u0456\u044f \u0456 \u044f\u043a \u0443 \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0433\u0430\u0434\u044b. \u0422\u0430\u0434\u044b \u042f \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0432\u0430\u0441 \u043d\u0430 \u0441\u0443\u0434 \u0456 \u0431\u0443\u0434\u0443 \u0436\u0432\u0430\u0432\u044b\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0446\u0430 \u0447\u0430\u0440\u0430\u043c\u0456, \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u043a\u0430\u045e, \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0435 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430, \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0446\u0456\u0441\u043a\u0430\u0435 \u043d\u0430\u0439\u043c\u0456\u0442\u0430, \u0443\u0434\u0430\u0432\u0443 \u0456 \u0441\u0456\u0440\u0430\u0442\u0443, \u0456 \u0445\u0442\u043e \u0430\u0434\u043a\u0456\u0434\u0430\u0435 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430 \u0456 \u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e \u042f, \u041f\u0430\u043d, \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b, \u0430 \u0432\u044b \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0431\u044b\u0446\u044c \u0441\u044b\u043d\u0430\u043c\u0456 \u042f\u043a\u0443\u0431\u0430. \u0417 \u0434\u0437\u0451\u043d \u0430\u0439\u0446\u043e\u045e \u0432\u0430\u0448\u044b\u0445 \u0432\u044b \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0430\u0434 \u041c\u0430\u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045e \u0456 \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u0456\u0445. \u0412\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435, \u0456 \u042f \u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0434\u0430 \u0432\u0430\u0441, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0410\u043b\u0435 \u0432\u044b \u043f\u044b\u0442\u0430\u0435\u0446\u0435\u0441\u044f: \u201c\u042f\u043a \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044f\u0440\u043d\u0443\u0446\u0430?\u201d \u0426\u0456 \u043c\u043e\u0436\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0448\u0443\u043a\u0430\u0446\u044c \u0411\u043e\u0433\u0430? \u0410 \u0432\u044b \u041c\u044f\u043d\u0435 \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u0446\u0435. \u0410\u0434\u043d\u0430\u043a \u0432\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u201c\u0423 \u0447\u044b\u043c \u043c\u044b \u0426\u044f\u0431\u0435 \u0430\u0448\u0443\u043a\u0430\u043b\u0456?\u201d \u0423 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0430\u0445 \u0456 \u0434\u0430\u043d\u0456\u043d\u0430\u0445. \u0421\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u043d\u0430 \u0432\u0430\u0441 \u043f\u0440\u0430\u043a\u043b\u0451\u043d, \u0431\u043e \u0432\u044b, \u0443\u0432\u0435\u0441\u044c \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434, \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u0446\u0435 \u041c\u044f\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0440\u044b\u043d\u044f\u0441\u0456\u0446\u0435 \u045e\u0441\u044e \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443 \u045e \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430, \u043a\u0430\u0431 \u0431\u044b\u045e \u0437\u0430\u043f\u0430\u0441 \u0443 \u041c\u0430\u0456\u043c \u0434\u043e\u043c\u0435. \u0406 \u0442\u0430\u0434\u044b \u043c\u043e\u0436\u0430\u0446\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0446\u0456 \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u044e \u042f \u0434\u043b\u044f \u0432\u0430\u0441 \u0432\u043e\u043a\u043d\u044b \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0456 \u0446\u0456 \u043d\u0435 \u043f\u0440\u0430\u043b\u044c\u044e \u043d\u0430 \u0432\u0430\u0441 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0437 \u043b\u0456\u0448\u043a\u0430\u043c. \u0406 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u042f \u0437\u0433\u0430\u043d\u044e \u0448\u043a\u043e\u0434\u043d\u0456\u043a\u0430, \u0456 \u0451\u043d \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043f\u043b\u0451\u043d \u0432\u0430\u0448\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u043d\u0430 \u043f\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441 \u0431\u0435\u0437 \u043f\u043b\u043e\u0434\u0443, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u0423\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0432\u0430\u0441 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456, \u0431\u043e \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0451\u0439, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0414\u0437\u0451\u0440\u0437\u043a\u0456\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u044b \u0432\u0430\u0448\u044b\u044f, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0410 \u0432\u044b \u043f\u044b\u0442\u0430\u0435\u0446\u0435: \u201c\u0428\u0442\u043e \u043c\u044b \u043a\u0430\u0436\u0430\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435?\u201d \u0412\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0435: \u201c\u041c\u0430\u0440\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u2013 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443! \u042f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c <\/span><span style=\"font-style: italic;\">\u0437 \u0442\u0430\u0433\u043e<\/span><span>, \u0448\u0442\u043e \u043c\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u045e \u0436\u0430\u043b\u043e\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e? \u0410 \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u0445. \u041d\u0430\u0432\u0430\u0442 \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0448\u0430\u043d\u0446\u0443\u0435, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u045e \u0411\u043e\u0433\u0430, \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f\u201d.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0437\u0430\u043b\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443. \u0410\u043b\u0435 \u041f\u0430\u043d \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0456 \u043f\u0430\u0447\u0443\u045e, \u0456 \u045e \u042f\u0433\u043e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u043a\u043d\u0456\u0433\u0430 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u045e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430 \u0456 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435 \u042f\u0433\u043e\u043d\u0430\u0435 \u0456\u043c\u044f. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0435, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u041c\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e \u045e \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u042f \u045e\u0447\u044b\u043d\u044e. \u042f \u0431\u0443\u0434\u0443 \u043b\u0456\u0442\u0430\u0441\u0446\u0456\u0432\u044b \u0434\u0430 \u0456\u0445, \u044f\u043a \u043b\u0456\u0442\u0430\u0441\u0446\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0434\u0430 \u0441\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443. \u0406 \u0442\u0430\u0434\u044b \u0437\u043d\u043e\u045e \u0443\u0431\u0430\u0447\u044b\u0446\u0435 \u0440\u043e\u0437\u043d\u0456\u0446\u0443 \u043f\u0430\u043c\u0456\u0436 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u043c, \u043f\u0430\u043c\u0456\u0436 \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443, \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e \u0432\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0437\u0435\u043d\u044c, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0435\u0447. \u0422\u0430\u0434\u044b \u045e\u0441\u0435 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u044f \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u0441\u0430\u043b\u043e\u043c\u0430, \u0456 \u0441\u043f\u0430\u043b\u0456\u0446\u044c \u0456\u0445 \u0433\u044d\u0442\u044b \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0437\u0435\u043d\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u0442\u0430\u043a \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u045e \u0456\u0445 \u043d\u0456 \u043a\u0430\u0440\u044d\u043d\u043d\u044f, \u043d\u0456 \u0433\u0430\u043b\u043b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u0434\u043b\u044f \u0432\u0430\u0441, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430&nbsp; \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u0433\u043e, \u0443\u0437\u044b\u0434\u0437\u0435 \u0441\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u043f\u0440\u043e\u043c\u043d\u044f\u0445. \u0412\u044b \u0432\u044b\u0439\u0434\u0437\u0435\u0446\u0435 \u0456 \u0437\u0430\u0441\u043a\u0430\u0447\u0430\u0446\u0435, \u043d\u0456\u0431\u044b \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u044b\u044f \u0446\u044f\u043b\u044f\u0442\u044b, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0412\u044b \u0440\u0430\u0441\u0442\u043e\u043f\u0447\u0430\u0446\u0435 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0456\u0431\u044b \u043f\u044b\u043b \u043f\u0430\u0434 \u0441\u0442\u0443\u043f\u043d\u044f\u043c\u0456 \u0432\u0430\u0448\u044b\u0445 \u043d\u043e\u0433 \u0443 \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u042f \u045e\u0447\u044b\u043d\u044e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0417\u0430\u043a\u043e\u043d \u041c\u0430\u0439\u0441\u0435\u044f, \u0441\u043b\u0443\u0433\u0456 \u041c\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u042f \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u044f\u043c\u0443 \u043d\u0430 \u0413\u0430\u0440\u044d\u0431\u0435 \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0448\u043b\u044e \u0434\u0430 \u0432\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u043b\u043b\u044e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0430\u043c \u0434\u043d\u044f \u041f\u0430\u043d\u0430, \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0456 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0433\u0430. \u0406 \u0451\u043d \u043f\u0430\u0432\u0435\u0440\u043d\u0435 \u0441\u044d\u0440\u0446\u044b \u0430\u0439\u0446\u043e\u045e \u0434\u0430 \u0441\u044b\u043d\u043e\u045e, \u0430 \u0441\u044d\u0440\u0446\u044b \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0430\u0439\u0446\u043e\u045e \u0456\u0445\u043d\u0456\u0445, \u043a\u0430\u0431 \u042f, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0443, \u043d\u0435 \u045e\u0434\u0430\u0440\u044b\u045e \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0430\u043b 3, 1; \u041b\u043a 1, 76<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0430\u043d\u0451\u043b\u0430 \u043c\u0430\u0439\u0433\u043e, \u0456 \u0451\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0406 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0447\u0430\u043a\u0430\u0435\u0446\u0435, \u0456 \u0430\u043d\u0451\u043b \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u0446\u0435.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410 \u0442\u044b, \u0434\u0437\u0456\u0446\u044f\u0442\u043a\u0430, \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u0432\u0430\u043d\u0430, \u0431\u043e \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u043f\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u042f\u043c\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u043f\u0440\u044b\u0439\u0434\u0437\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"291","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u042d\u0441\u0442\u044d\u0440\u044b <\/span><span style=\"color: #ff0000;\">1, 1-3. 9-13. 15-16. 19; 2, 5-10. 16-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0434\u0434\u0430\u043b\u0435\u043d\u043d\u0435 \u0412\u0430\u0448\u0446\u0456 \u0456 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435 \u042d\u0441\u0442\u044d\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u044b\u043b\u043e \u0433\u044d\u0442\u0430 \u045e \u0434\u043d\u0456 \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430. \u0401\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0430\u0434 \u0406\u043d\u0434\u044b\u0456 \u0430\u0436 \u0434\u0430 \u042d\u0444\u0456\u043e\u043f\u0456\u0456 \u043d\u0430\u0434 \u0441\u0442\u0430 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0446\u044e \u0441\u044f\u043c\u044e \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u044f\u043c\u0456. \u0423 \u0442\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448 \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u043f\u0430\u0441\u0430\u0434\u0437\u0435, \u0448\u0442\u043e \u0431\u044b\u045e \u0443 \u0437\u0430\u043c\u043a\u0443 \u045e \u0421\u0443\u0437\u0430\u0445, \u0443 \u0442\u0440\u044d\u0446\u0456 \u0433\u043e\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0451\u043d \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u045e \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u043a\u043d\u044f\u0437\u0451\u045e \u0456 \u0441\u043b\u0443\u0433\u0430\u045e. \u041f\u0435\u0440\u0441\u0456\u0434\u0441\u043a\u0456\u044f \u0456 \u043c\u0456\u0434\u044b\u0439\u0441\u043a\u0456\u044f \u0432\u043e\u0435\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0456, \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b \u0456 \u043a\u043d\u044f\u0437\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439 \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0456\u043c. \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0412\u0430\u0448\u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u043b\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u0434\u043b\u044f \u0436\u0430\u043d\u0447\u044b\u043d \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043b\u0430\u0446\u0443 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430. \u041d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0441\u044d\u0440\u0446\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0432\u0456\u043d\u0430, \u0451\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0435\u0433\u0443\u043c\u0430\u043d\u0443, \u0411\u0456\u0437\u044d\u0442\u0443, \u0425\u0430\u0440\u0431\u043e\u043d\u0443, \u0411\u0456\u0433\u0442\u0443 \u0456 \u0410\u0431\u0430\u0445\u0446\u0435, \u0417\u044d\u0442\u044d\u0440\u0443 \u0456 \u0425\u0430\u0440\u043a\u0430\u0441\u0443 \u2013 \u0441\u044f\u043c\u0456 \u0435\u045e\u043d\u0443\u0445\u0430\u043c, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0441\u043b\u0443\u0436\u0432\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044e \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0443, \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0443 \u0412\u0430\u0448\u0446\u0456 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u043a\u0430\u0440\u043e\u043d\u0435, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043a\u043d\u044f\u0437\u044f\u043c \u044f\u0435 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0431\u043e \u044f\u043d\u0430 \u043c\u0435\u043b\u0430 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u044b \u0432\u044b\u0433\u043b\u044f\u0434. \u0410\u043b\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0412\u0430\u0448\u0446\u0456 \u0430\u0434\u043c\u043e\u0432\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u043d\u0430 \u0437\u0430\u0433\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u0451\u0439 \u0435\u045e\u043d\u0443\u0445\u0456. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0433\u043d\u0435\u0432\u0430\u043c. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u043c\u0443\u0434\u0440\u0430\u0446\u0430\u043c, \u044f\u043a\u0456\u044f \u0432\u0435\u0434\u0430\u043b\u0456 \u0431\u044b\u043b\u044b\u044f \u0447\u0430\u0441\u044b, \u2013 \u0431\u043e \u0442\u0430\u043a \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0430\u043b\u0456\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043a\u0430\u0440\u0430\u043b\u044f \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0437\u043d\u0430\u045e\u0446\u0430\u043c\u0456 \u0437\u0430\u043a\u043e\u043d\u0443 \u0456 \u0441\u0443\u0434\u0430: \u00ab\u0428\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443 \u0442\u0440\u044d\u0431\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439 \u0412\u0430\u0448\u0446\u0456 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u0430 \u043d\u0435 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0430 \u0437\u0430\u0433\u0430\u0434\u0443 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430, \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u0435\u045e\u043d\u0443\u0445\u0430\u043c\u0456?\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u041c\u0435\u043c\u0443\u0445\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e \u0456 \u043a\u043d\u044f\u0437\u044f\u043c: \u00ab\u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u0456\u043b\u0430\u0441\u044f \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0412\u0430\u0448\u0446\u0456, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043a\u043d\u044f\u0437\u044f\u043c\u0456 \u0456 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u044f\u0445 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430. \u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0434\u0430\u0441\u0446\u044c \u0441\u0432\u043e\u0439 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0437\u0430\u0433\u0430\u0434 \u0456 \u043d\u044f\u0445\u0430\u0439 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u043f\u0435\u0440\u0441\u0456\u0434\u0441\u043a\u0456\u043c \u0456 \u043c\u0456\u0434\u044b\u0439\u0441\u043a\u0456\u043c \u0437\u0430\u043a\u043e\u043d\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u0412\u0430\u0448\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430, \u0430 \u044f\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u044f\u0445\u0430\u0439 \u043a\u0430\u0440\u043e\u043b\u044c \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0456\u043d\u0448\u0430\u0439, \u043b\u0435\u043f\u0448\u0430\u0439 \u0437\u0430 \u044f\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0421\u0443\u0437\u0430\u0445 \u0443 \u0437\u0430\u043c\u043a\u0443 \u0431\u044b\u045e \u0430\u0434\u0437\u0456\u043d \u0433\u0430\u0431\u0440\u044d\u0439. \u0406\u043c\u044f \u044f\u0433\u043e \u0431\u044b\u043b\u043e \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439. \u0401\u043d \u0431\u044b\u045e \u0441\u044b\u043d\u0430\u043c \u042f\u0456\u0440\u0430, \u0441\u044b\u043d\u0430 \u0428\u044b\u043c\u044d\u044f, \u0441\u044b\u043d\u0430 \u041a\u0456\u0448\u0430, \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0411\u0435\u043d\u044c\u044f\u043c\u0456\u043d\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443\u0437\u044f\u0442\u044b \u045e \u043f\u0430\u043b\u043e\u043d \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u043f\u0430\u0432\u044f\u043b\u0456 \u045e \u043d\u044f\u0432\u043e\u043b\u044e \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0445\u043e\u043d\u0456\u0435\u043c, \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u043c, \u044f\u043a\u043e\u0433\u0430 \u0437\u0430\u0431\u0440\u0430\u045e \u0443 \u043d\u044f\u0432\u043e\u043b\u044e \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440, \u043a\u0430\u0440\u043e\u043b\u044c \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0456. \u0410 \u0431\u044b\u045e \u0451\u043d \u0430\u043f\u0435\u043a\u0443\u043d\u043e\u043c \u0410\u0434\u0430\u0441\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u042d\u0441\u0442\u044d\u0440\u044b, \u0434\u0430\u0447\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0437\u044f\u0434\u0437\u0456, \u0431\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u044f\u0435 \u043d\u0456 \u0430\u0439\u0446\u0430, \u043d\u0456 \u043c\u0430\u0446\u0456. \u0414\u0437\u044f\u045e\u0447\u044b\u043d\u0430 \u0433\u044d\u0442\u0430\u044f \u0431\u044b\u043b\u0430 \u0437\u0433\u0440\u0430\u0431\u043d\u0430\u044f \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443. \u041f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u044f\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0456 \u043c\u0430\u0446\u0456 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435 \u044f\u043a \u0434\u0430\u0447\u043a\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0431\u044b\u045e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0437\u0430\u0433\u0430\u0434 \u0456 \u044f\u0433\u043e \u0434\u044d\u043a\u0440\u044d\u0442 \u0456 \u043a\u0430\u043b\u0456 \u0441\u0430\u0431\u0440\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u0434\u0437\u044f\u045e\u0447\u0430\u0442 \u0443 \u0437\u0430\u043c\u043a\u0443 \u045e \u0421\u0443\u0437\u0430\u0445 \u043f\u0430\u0434 \u043d\u0430\u0433\u043b\u044f\u0434 \u042d\u0433\u0430\u044f, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u0440\u0430\u043d\u0430\u044f \u042d\u0441\u0442\u044d\u0440\u0430 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u043f\u0430\u043b\u0430\u0446 \u043f\u0430\u0434 \u043d\u0430\u0433\u043b\u044f\u0434 \u042d\u0433\u0430\u044f, \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0436\u0430\u043d\u0447\u044b\u043d. \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u044f\u043c\u0443 \u0433\u044d\u0442\u0430\u044f \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430 \u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u044f\u0433\u043e. \u0401\u043d \u043f\u0430\u0441\u043f\u044f\u0448\u044b\u045e \u0434\u0430\u0446\u044c \u0451\u0439 \u0434\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0430\u043b\u0435\u0456 \u0456 \u044f\u0435 \u0434\u043e\u043b\u044e \u0434\u043b\u044f \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f. \u0414\u0430\u045e \u0451\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0435\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0434\u0437\u044f\u045e\u0447\u0430\u0442 \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043b\u0430\u0446\u0443 \u0456 \u043f\u0435\u0440\u0430\u0441\u044f\u043b\u0456\u045e \u044f\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u044f\u045e\u0447\u0430\u0442\u0430\u043c\u0456 \u045e \u043b\u0435\u043f\u0448\u044b\u044f \u0436\u0430\u043d\u043e\u0447\u044b\u044f \u043f\u0430\u043a\u043e\u0456. \u042d\u0441\u0442\u044d\u0440\u0430 \u043d\u0435 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435, \u0431\u043e \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0451\u0439 \u043d\u0435 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u042d\u0441\u0442\u044d\u0440\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u0440\u0430\u043d\u0430\u044f \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u043f\u0430\u043b\u0430\u0446 \u0443 \u0434\u0437\u0435\u0432\u044f\u0442\u044b \u043c\u0435\u0441\u044f\u0446, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u043c\u0435\u0441\u044f\u0446 \u0422\u044d\u0432\u044d\u0442, \u0443 \u0441\u0451\u043c\u044b \u0433\u043e\u0434 \u044f\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f. \u041a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u042d\u0441\u0442\u044d\u0440\u0443 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0436\u0430\u043d\u0447\u044b\u043d. \u042f\u043d\u0430 \u043c\u0435\u043b\u0430 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043b\u0430\u0441\u043a\u0443 \u045e \u044f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0434\u0437\u044f\u045e\u0447\u0430\u0442. \u0422\u0430\u043c\u0443 \u045e\u0441\u043a\u043b\u0430\u045e \u0451\u043d \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u043a\u0430\u0440\u043e\u043d\u0443 \u0451\u0439 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439 \u0437\u0430\u043c\u0435\u0441\u0442 \u0412\u0430\u0448\u0446\u0456.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 113 (112), 5-8\u0430; \u041b\u043a 51b-52<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u044f\u043a\u0456 \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f\u043a\u0456 \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0437 \u043f\u044b\u043b\u0443 \u0456 \u0441\u0430 \u0441\u043c\u0435\u0446\u0446\u044f \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0431\u043e\u0433\u0430\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0446\u044c \u044f\u0433\u043e \u0437 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0420\u0430\u0441\u0441\u0435\u044f\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u044b\u0445\u043b\u0456\u0432\u044b \u0441\u044d\u0440\u0446\u0430\u043c, \u0441\u043a\u0456\u043d\u0443\u045e \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0437 \u0442\u0440\u043e\u043d\u0430 \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043a\u0456 \u043f\u0430\u0434\u044b\u043c\u0430\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"292","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u042d\u0441\u0442\u044d\u0440\u044b <\/span><span style=\"color: #ff0000;\">3, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0433\u0440\u043e\u0437\u0430 \u0434\u043b\u044f \u0433\u0430\u0431\u0440\u044d\u044f\u045e<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0430\u0440\u043e\u043b\u044c \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448 \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0410\u043c\u0430\u043d\u0430, \u0441\u044b\u043d\u0430 \u0410\u043c\u0435\u0434\u0430\u0442\u0430 \u0430\u0433\u0430\u0433\u0456\u0446\u044f\u043d\u0456\u043d\u0430 \u0456 \u045e\u0437\u043d\u0451\u0441 \u044f\u0433\u043e \u0434\u044b \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043a\u043d\u044f\u0437\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u043f\u0440\u044b \u0456\u043c. \u0423\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0431\u0440\u0430\u043c\u0435, \u043a\u043b\u0435\u043d\u0447\u044b\u043b\u0456 \u0456 \u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0410\u043c\u0430\u043d\u0443, \u0431\u043e \u0442\u0430\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u043d\u0435 \u043a\u043b\u0435\u043d\u0447\u044b\u045e \u0456 \u043d\u0435 \u043a\u043b\u0430\u043d\u044f\u045e\u0441\u044f. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u044f \u0441\u043b\u0443\u0433\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0431\u0440\u0430\u043c\u0435, \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044e: \u00ab\u0427\u0430\u043c\u0443 \u0442\u044b \u043f\u0430\u0440\u0443\u0448\u0430\u0435\u0448 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0437\u0430\u0433\u0430\u0434?\u00bb \u042f\u043d\u044b \u0442\u0430\u043a \u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043c\u0443 \u0434\u0437\u0435\u043d\u044c \u0443 \u0434\u0437\u0435\u043d\u044c, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u045e \u0456\u0445. \u0422\u0430\u0434\u044b \u044f\u043d\u044b \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u0410\u043c\u0430\u043d\u0443, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c, \u0446\u0456 \u043d\u0435 \u0437\u043c\u0435\u043d\u0456\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439, \u0431\u043e \u0442\u043e\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c, \u0448\u0442\u043e \u0451\u043d \u0433\u0430\u0431\u0440\u044d\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0410\u043c\u0430\u043d \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u043d\u0435 \u043a\u043b\u0435\u043d\u0447\u044b\u0446\u044c \u0456 \u043d\u0435 \u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u044f\u043c\u0443, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0410\u043c\u0430\u043d \u0433\u043d\u0435\u0432\u0430\u043c. \u0406 \u0437\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u043c\u0430\u043b\u044b\u043c \u0443 \u044f\u0433\u043e \u0432\u0430\u0447\u0430\u0445 \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u044c \u0440\u0443\u043a\u0443 \u043d\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f, \u0431\u043e \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u044f\u043c\u0443 \u043f\u0440\u0430 \u043d\u0430\u0440\u043e\u0434 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f. \u0422\u0430\u043c\u0443 \u0410\u043c\u0430\u043d \u0448\u0443\u043a\u0430\u045e \u043d\u0430\u0433\u043e\u0434\u044b \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u0433\u0430\u0431\u0440\u044d\u044f\u045e \u2013 \u043d\u0430\u0440\u043e\u0434 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f, \u0432\u0430 \u045e\u0441\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0435 \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u043f\u0435\u0440\u0448\u044b \u043c\u0435\u0441\u044f\u0446, \u0443 \u043c\u0435\u0441\u044f\u0446 \u041d\u0456\u0441\u0430\u043d, \u0443 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430, \u043a\u0456\u0434\u0430\u043b\u0456 \u043f\u0443\u0440, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043b\u0451\u0441\u044b, \u043f\u0435\u0440\u0430\u0434 \u0410\u043c\u0430\u043d\u0430\u043c \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c, \u0437 \u043c\u0435\u0441\u044f\u0446\u0430 \u045e \u043c\u0435\u0441\u044f\u0446, \u0430\u0436 \u0434\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u0430\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u0410\u0434\u0430\u0440. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u043c\u0430\u043d \u043a\u0430\u0440\u0430\u043b\u044e \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0443: \u00ab\u0401\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u043d\u0430\u0440\u043e\u0434, \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u043d\u044b \u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439 \u0442\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u0430 \u0456\u0445\u043d\u0456\u044f \u0437\u0430\u043a\u043e\u043d\u044b \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u0443\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f \u044f\u043d\u044b \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c. \u0422\u0430\u043c\u0443 \u043a\u0430\u0440\u0430\u043b\u044e \u043d\u0435 \u0432\u0430\u0440\u0442\u0430 \u043f\u0430\u043a\u0456\u0434\u0430\u0446\u044c \u0456\u0445 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456. \u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u043f\u0456\u0448\u0443\u0446\u044c, \u0448\u0442\u043e \u0456\u0445 \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0446\u044c, \u0430 \u044f \u0430\u0434\u0432\u0430\u0436\u0443 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0442\u0430\u043b\u0430\u043d\u0442\u0430\u045e \u0441\u0440\u044d\u0431\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043f\u0440\u0430\u0446\u0443, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u043d\u044f\u0441\u0443\u0446\u044c \u0433\u044d\u0442\u0430 \u045e \u043a\u0430\u0437\u043d\u0443 \u043a\u0430\u0440\u0430\u043b\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0437\u043d\u044f\u045e \u0441\u044b\u0433\u043d\u0435\u0442 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456 \u0456 \u0430\u0434\u0434\u0430\u045e \u044f\u0433\u043e \u0410\u043c\u0430\u043d\u0443, \u0441\u044b\u043d\u0443 \u0410\u043c\u0435\u0434\u0430\u0442\u0430 \u0430\u0433\u0430\u0433\u0456\u0446\u044f\u0446\u0456\u043d\u0430, \u0432\u043e\u0440\u0430\u0433\u0443 \u0433\u0430\u0431\u0440\u044d\u044f\u045e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0410\u043c\u0430\u043d\u0443: \u00ab\u0410\u0434\u0434\u0430\u044e \u0442\u0430\u0431\u0435 \u0433\u044d\u0442\u0430\u0435 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0442\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u043b\u0456\u0447\u044b\u0448 \u0432\u0430\u0440\u0442\u044b\u043c\u00bb. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u043f\u0456\u0441\u0430\u0440\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f \u045e \u0442\u0440\u044b\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0456 \u044f\u043d\u044b \u0437\u0430\u043f\u0456\u0441\u0430\u043b\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0410\u043c\u0430\u043d, \u0434\u043b\u044f \u0441\u0430\u0442\u0440\u0430\u043f\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430\u045e \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u044f\u0445, \u0434\u043b\u044f \u043a\u043d\u044f\u0437\u0451\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u044f\u0445 \u0456\u0445 \u043f\u0456\u0441\u044c\u043c\u043e\u043c, \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u043d\u0430 \u0456\u0445 \u043c\u043e\u0432\u0435. \u0411\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0430\u0434 \u0456\u043c\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430 \u0456 \u0437\u0430\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430 \u0441\u044b\u0433\u043d\u0435\u0442\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u044f. \u041b\u0456\u0441\u0442\u044b \u0432\u044b\u0441\u043b\u0430\u043b\u0456 \u0437 \u0433\u0430\u043d\u0446\u0430\u043c\u0456 \u0434\u0430 \u045e\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0446\u044c, \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0430\u0434 \u043c\u0430\u043b\u043e\u0433\u0430 \u0434\u0430 \u0441\u0442\u0430\u0440\u043e\u0433\u0430, \u0434\u0437\u044f\u0446\u0435\u0439 \u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u0443 \u0430\u0434\u0437\u0456\u043d, \u0442\u0440\u044b\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043c\u0435\u0441\u044f\u0446\u0430 \u0410\u0434\u0430\u0440\u0430, \u0430 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0456\u0445\u043d\u044e\u044e \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u043e\u043f\u0456\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0456\u0441\u044c\u043c\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430 \u044f\u043a \u0434\u044d\u043a\u0440\u044d\u0442 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439 \u0456 \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u045e\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f. \u0413\u0430\u043d\u0446\u044b \u0445\u0443\u0442\u043a\u0430 \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u043f\u0430 \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u044f, \u0430 \u0434\u044d\u043a\u0440\u044d\u0442 \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u045e \u0437\u0430\u043c\u043a\u0443 \u045e \u0421\u0443\u0437\u0430\u0445. \u041a\u0430\u0440\u043e\u043b\u044c \u0436\u0430 \u0456 \u0410\u043c\u0430\u043d \u0441\u0435\u043b\u0456 \u0431\u0430\u043d\u043a\u0435\u0442\u0430\u0432\u0430\u0446\u044c, \u0430 \u0433\u043e\u0440\u0430\u0434 \u0421\u0443\u0437\u044b \u0431\u044b\u045e \u0443 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0441\u0442 4, 17\u0441; \u041f\u0441 44 (43), 26; \u042d\u0441\u0442 4, 17h&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0422\u044b \u045e\u0441\u0451 \u043c\u043e\u0436\u0430\u0448, \u0456 \u043d\u044f\u043c\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431 \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0410\u0434\u043a\u0443\u043f\u0456 \u043d\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0447\u0443\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u043c\u0430\u044e \u0456 \u0437\u043c\u044f\u043d\u0456 \u043f\u043b\u0430\u0447 \u043d\u0430\u0448 \u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u043a\u0443\u043f\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"293","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u042d\u0441\u0442\u044d\u0440\u044b <\/span><span style=\"color: #ff0000;\">4, 1-8. 8\u0430. 9-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043c\u0430\u043d \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u0430\u0437\u0432\u043e\u043b \u0432\u044b\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u0433\u0430\u0431\u0440\u044d\u044f\u045e<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u043f\u0440\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u0441\u0432\u0430\u0451 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443, \u043f\u0430\u0441\u044b\u043f\u0430\u045e \u0441\u044f\u0431\u0435 \u043f\u043e\u043f\u0435\u043b\u0430\u043c \u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0433\u043e\u0440\u0430\u0434\u0430 \u0434\u044b \u043b\u044f\u043c\u0430\u043d\u0442\u0430\u0432\u0430\u045e \u043c\u043e\u0446\u043d\u0430 \u0456 \u0433\u043e\u0440\u043a\u0430. \u0422\u0430\u043a \u0434\u0430\u0439\u0448\u043e\u045e \u0430\u0436 \u0434\u0430 \u041a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0431\u0440\u0430\u043c\u044b, \u0431\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u041a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u0411\u0440\u0430\u043c\u0443 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u043c \u0443 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443. \u0410 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0456 \u0456 \u043c\u0435\u0441\u0446\u044b, \u043a\u0443\u0434\u044b \u0434\u0430\u0439\u0448\u043e\u045e \u0437\u0430\u0433\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u044f\u0433\u043e \u0434\u044d\u043a\u0440\u044d\u0442, \u0431\u044b\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0436\u0430\u043b\u043e\u0431\u0430 \u0441\u044f\u0440\u043e\u0434 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u043f\u043e\u0441\u0442, \u043f\u043b\u0430\u0447 \u0456 \u0433\u0430\u043b\u0430\u0448\u044d\u043d\u043d\u0435. \u041c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0430 \u0456 \u043f\u043e\u043f\u0435\u043b \u0441\u0442\u0430\u043b\u0456 \u043f\u0430\u0441\u0446\u0435\u043b\u043b\u044e \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0456 \u042d\u0441\u0442\u044d\u0440\u044b \u0456 \u044f\u0435 \u0435\u045e\u043d\u0443\u0445\u0456 \u0434\u044b \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u0451\u0439 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0412\u044f\u043b\u0456\u043a\u0456 \u0436\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0443. \u042f\u043d\u0430 \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u043a\u0430\u0431 \u0430\u0434\u0437\u0435\u043b\u0456 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f \u0456 \u0437\u043d\u044f\u043b\u0456 \u0437 \u044f\u0433\u043e \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u0456\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u042d\u0441\u0442\u044d\u0440\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0410\u0442\u0430\u0445\u0430, \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a\u043e\u0433\u0430 \u0442\u043e\u0439 \u043f\u0440\u044b\u0441\u0442\u0430\u0432\u0456\u045e \u0434\u0430 \u044f\u0435, \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u044f\u043c\u0443 \u0456\u0441\u0446\u0456 \u0434\u0430 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f, \u043a\u0430\u0431 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0456 \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0433\u044d\u0442\u0430. \u0410\u0442\u0430\u0445 \u0432\u044b\u0439\u0448\u0430\u045e \u0434\u0430 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f \u043d\u0430 \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0443\u044e \u043f\u043b\u043e\u0448\u0447\u0443, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u041a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0431\u0440\u0430\u043c\u0430\u0439. \u0410 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u043f\u0440\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0456\u043c, \u0456 \u043f\u0440\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0443\u044e \u043c\u0435\u0440\u0443 \u0441\u0440\u044d\u0431\u0440\u0430, \u044f\u043a\u0443\u044e \u0410\u043c\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u044c \u0443 \u043a\u0430\u0437\u043d\u0443 \u043a\u0430\u0440\u0430\u043b\u044f \u0434\u043b\u044f \u0432\u044b\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0430\u0431\u0440\u044d\u044f\u045e. \u0410\u0434\u0434\u0430\u045e \u044f\u043c\u0443 \u043a\u043e\u043f\u0456\u044e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0433\u0430 \u0434\u044d\u043a\u0440\u044d\u0442\u0430, \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u045e \u0421\u0443\u0437\u0430\u0445, \u0430\u0431 \u0456\u0445 \u0432\u044b\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0456, \u043a\u0430\u0431 \u0442\u043e\u0439 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u0433\u043e \u042d\u0441\u0442\u044d\u0440\u044b, \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439 \u043f\u0440\u0430 \u045e\u0441\u0451 \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043f\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u044f\u0433\u043e \u0430\u0431 \u043b\u0456\u0442\u0430\u0441\u0446\u0456 \u0456 \u043c\u0430\u043b\u0456\u043b\u0430 \u044f\u0433\u043e \u0437\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0423\u0437\u0433\u0430\u0434\u0430\u0439 \u0434\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f, \u044f\u043a \u0442\u044b \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u043c\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445, \u0431\u043e \u0410\u043c\u0430\u043d, \u0434\u0440\u0443\u0433\u0456 \u043f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0440\u0430\u0441\u0456\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0441\u043c\u0435\u0440\u0446\u0456. \u0417\u0430\u043a\u043b\u0456\u043a\u0430\u0439 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456 \u043a\u0430\u0440\u0430\u043b\u044f \u0437\u0430 \u043d\u0430\u0441 \u0456 \u045e\u0440\u0430\u0442\u0443\u0439 \u043d\u0430\u0441 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410\u0442\u0430\u0445 \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u042d\u0441\u0442\u044d\u0440\u044b \u0441\u043b\u043e\u0432\u044b \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f. \u0422\u0430\u0434\u044b \u042d\u0441\u0442\u044d\u0440\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430 \u0410\u0442\u0430\u0445\u0443 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u044f\u043c\u0443 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044e: \u00ab\u0423\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043d\u0430\u0440\u043e\u0434 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044f\u043a\u0456\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u043d\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446 \u0431\u0435\u0437 \u0437\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0437\u0430\u043a\u043e\u043d \u2013 \u0441\u043c\u0435\u0440\u0446\u044c. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0434\u0430 \u043a\u0430\u0433\u043e \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0437\u0430\u043b\u0430\u0442\u043e\u0435 \u0436\u0430\u0437\u043b\u043e, \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c. \u0410 \u043c\u044f\u043d\u0435 \u045e\u0436\u043e \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0434\u0437\u0451\u043d \u043d\u0435 \u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u044b \u042d\u0441\u0442\u044d\u0440\u044b \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044e. \u0410 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0434\u043b\u044f \u042d\u0441\u0442\u044d\u0440\u044b \u0442\u0430\u043a\u0456 \u0430\u0434\u043a\u0430\u0437: \u00ab\u041d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0442\u044b \u0430\u0434\u043d\u0430 \u0437 \u0443\u0441\u0456\u0445 \u0433\u0430\u0431\u0440\u044d\u044f\u045e \u0443\u0440\u0430\u0442\u0443\u0435\u0448\u0441\u044f \u045e \u0434\u043e\u043c\u0435 \u043a\u0430\u0440\u0430\u043b\u044f. \u041a\u0430\u043b\u0456 \u0442\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u0447\u044b\u0448 \u0443 \u0442\u0430\u043a\u0456 \u0447\u0430\u0441, \u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u0433\u0430\u0431\u0440\u044d\u044f\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437 \u0456\u043d\u0448\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430, \u0430 \u0442\u044b \u0456 \u0434\u043e\u043c \u0442\u0432\u0430\u0439\u0433\u043e \u0430\u0439\u0446\u0430 \u0437\u0430\u0433\u0456\u043d\u0435\u0446\u0435. \u0406 \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435, \u0446\u0456 \u043d\u0435 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443, \u044f\u043a \u0433\u044d\u0442\u044b, \u0442\u044b \u0441\u0442\u0430\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439?\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u042d\u0441\u0442\u044d\u0440\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0430 \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044e \u0442\u0430\u043a\u0456 \u0430\u0434\u043a\u0430\u0437: \u00ab\u0406\u0434\u0437\u0456, \u0437\u0431\u044f\u0440\u044b \u045e\u0441\u0456\u0445 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0421\u0443\u0437\u0430\u0445, \u0456 \u043f\u0430\u0441\u0446\u0456\u0446\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435. \u041d\u0435 \u0435\u0448\u0446\u0435 \u0456 \u043d\u0435 \u043f\u0456\u0446\u0435 \u0442\u0440\u044b \u0434\u043d\u0456, \u043d\u043e\u0447\u0447\u0443 \u0456 \u0434\u043d\u0451\u043c. \u042f \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0430\u043c\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0446\u0456\u0446\u044c, \u0430 \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0439\u0434\u0443 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u0443. \u0410 \u043a\u0430\u043b\u0456 \u0437\u0430\u0433\u0456\u043d\u0443, \u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u00bb. \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u0439 \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u044f\u043c\u0443 \u042d\u0441\u0442\u044d\u0440\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0441\u0442 14, 14 (Vlg); \u0422\u043e\u0431 3, 13; \u042e\u0434\u0442 6, 15 (Vlg)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u043d\u0456 \u043d\u0430 \u043a\u043e\u0433\u0430 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0431\u043e \u0422\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0445\u043e\u0446\u044c \u0433\u043d\u0435\u0432\u0430\u0435\u0448\u0441\u044f, \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0435\u0448 \u0433\u0440\u0430\u0445\u0456 \u045e \u0447\u0430\u0441 \u0443\u0446\u0456\u0441\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u0456, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0422\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"294","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u042d\u0441\u0442\u044d\u0440\u044b <\/span><span style=\"color: #ff0000;\">4, 17i-17z (LXX)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u044b \u042d\u0441\u0442\u044d\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043c\u043e\u0446\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e, \u0431\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u0445\u043d\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u042d\u0441\u0442\u044d\u0440\u0430, \u0430\u043f\u044b\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0430\u0431\u0430\u0440\u043e\u043d\u044b \u045e \u041f\u0430\u043d\u0430. \u0417\u043d\u044f\u045e\u0448\u044b \u0441\u0432\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0448\u0430\u0442\u044b, \u044f\u043d\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430 \u0448\u0430\u0442\u044b \u0431\u043e\u043b\u044e \u0456 \u0436\u0430\u043b\u043e\u0431\u044b, \u0430 \u0437\u0430\u043c\u0435\u0441\u0442 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u0445 \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044f\u045e \u043f\u0430\u043a\u0440\u044b\u043b\u0430 \u0441\u0432\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443 \u043f\u043e\u043f\u0435\u043b\u0430\u043c \u0456 \u043d\u0435\u0447\u044b\u0441\u0442\u043e\u0442\u0430\u043c\u0456 \u0456 \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u043b\u0430 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u0430 \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0433\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u043a\u0440\u044b\u043b\u0430 \u0441\u044f\u0431\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u0440\u0430\u0441\u043f\u0443\u0448\u0447\u0430\u043d\u044b\u043c\u0456 \u0432\u0430\u043b\u0430\u0441\u0430\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u042f\u043d\u0430 \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u041c\u043e\u0439 \u041f\u0430\u043d\u0435, \u043d\u0430\u0448 \u041a\u0430\u0440\u043e\u043b\u044c, \u0422\u044b \u0430\u0434\u0437\u0456\u043d\u044b, \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043c\u043d\u0435, \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0439, \u044f\u043a\u0430\u044f \u043d\u0435 \u043c\u0430\u0435 \u0430\u043a\u0440\u0430\u043c\u044f \u0426\u044f\u0431\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u044b, \u0431\u043e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430 \u043c\u0430\u044f \u045e \u043c\u0430\u0451\u0439 \u0440\u0443\u0446\u044d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u042f \u0447\u0443\u043b\u0430 \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u043c\u0430\u0439\u0433\u043e \u0440\u043e\u0434\u0443, \u0448\u0442\u043e \u0422\u044b, \u041f\u0430\u043d\u0435, \u0432\u044b\u0431\u0440\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u0437 \u0443\u0441\u0456\u0445 \u0456\u0445\u043d\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0443 \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u0456 \u0422\u044b \u0430\u0434\u0434\u0430\u045e \u043d\u0430\u0441 \u0443 \u0440\u0443\u043a\u0456 \u043d\u0430\u0448\u044b\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0456\u0445\u043d\u0456\u043c \u0431\u0430\u0433\u0430\u043c. \u0422\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u043b\u0456\u0432\u044b, \u041f\u0430\u043d\u0435!<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0446\u044f\u043f\u0435\u0440 \u0456\u043c \u043c\u0430\u043b\u0430 \u0433\u043e\u0440\u044b\u0447\u044b \u043d\u0430\u0448\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u0456, \u0456 \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e, \u043a\u0430\u0431 \u0430\u0434\u043c\u044f\u043d\u0456\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0422\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u043a\u0430\u0431 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0443\u0441\u043d\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0426\u044f\u0431\u0435, \u0456 \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443 \u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u043b\u0442\u0430\u0440\u0430 \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0432\u0443\u0441\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u045e\u0441\u0445\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u044f \u0437\u044f\u043c\u043d\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439, \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0451 \u0436\u0430\u0437\u043b\u043e \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u0456\u0441\u043d\u0443\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u043d\u0435 \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u044e\u0446\u0446\u0430 \u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0430\u0431\u044f\u0440\u043d\u0456 \u0456\u0445\u043d\u0456 \u043d\u0430\u043c\u0435\u0440 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445 \u0441\u0430\u043c\u0456\u0445. \u0410&nbsp; \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0443\u0447\u044b\u043d\u0456 \u043f\u0435\u0440\u0430\u0441\u0446\u044f\u0440\u043e\u0433\u0430\u044e! \u0423\u0441\u043f\u043e\u043c\u043d\u0456 \u043f\u0440\u0430 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0434\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0447\u0430\u0441 \u043d\u0430\u0448\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u0430 \u043c\u043d\u0435 \u0434\u0430\u0439 \u0430\u0434\u0432\u0430\u0433\u0443, \u041a\u0430\u0440\u043e\u043b\u044c \u0431\u0430\u0433\u043e\u045e \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0443\u0441\u0456\u0445 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e. \u0423\u043a\u043b\u0430\u0434\u0437\u0456 \u045e \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0447\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0456\u043b\u044c\u0432\u0430 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u0451\u043d \u0441\u0430\u043c \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0423\u0440\u0430\u0442\u0443\u0439 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u043e\u044e \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043c\u043d\u0435, \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0439, \u044f\u043a\u0430\u044f \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u043a\u043e\u0433\u0430 \u0430\u043f\u0440\u043e\u0447 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435. \u0422\u044b \u045e\u0441\u0451 \u0432\u0435\u0434\u0430\u0435\u0448, \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u044f \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u043b\u0430 \u0445\u0432\u0430\u043b\u0443 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0456 \u0433\u0440\u044d\u0431\u0443\u044e \u043b\u043e\u0436\u0430\u043c \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 \u0456 \u043a\u043e\u0436\u043d\u044b\u043c \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c. \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448 \u043c\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e, \u0448\u0442\u043e \u044f \u0433\u0440\u044d\u0431\u0443\u044e \u0437\u043d\u0430\u043a\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u0456 \u044f \u043c\u0430\u044e \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u0435 \u045e \u0434\u043d\u0456 \u043c\u0430\u0439\u0433\u043e \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u0433\u0430 \u0437\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f. \u0401\u043d \u0433\u0456\u0434\u043a\u0456 \u043c\u043d\u0435 \u044f\u043a \u0430\u043a\u0440\u044b\u0432\u0430\u045e\u043b\u0435\u043d\u0430\u044f \u0430\u043d\u0443\u0447\u0430 \u0456 \u043d\u0435 \u043d\u0430\u0448\u0443 \u044f\u0433\u043e \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0422\u0432\u0430\u044f \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0435\u043b\u0430 \u0441\u0430 \u0441\u0442\u0430\u043b\u0430 \u0410\u043c\u0430\u043d\u0430, \u043d\u0435 \u0441\u043b\u0430\u0432\u0456\u043b\u0430 \u0437\u0430\u0441\u0442\u043e\u043b\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u043d\u0435 \u043f\u0456\u043b\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0433\u0430 \u0432\u0456\u043d\u0430. \u0422\u0432\u0430\u044f \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0432\u0435\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0437 \u0434\u043d\u044f \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u044b \u044f\u0435 \u043b\u0451\u0441\u0443 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0411\u043e\u0436\u0430, \u044f\u043a\u0456 \u043c\u0430\u0435\u0448 \u043c\u043e\u0446 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u043f\u0430\u0447\u0443\u0439 \u0433\u043e\u043b\u0430\u0441 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u0445 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0432\u044b\u0440\u0432\u0456 \u043d\u0430\u0441 \u0437 \u0440\u0443\u043a\u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u0430\u0434 \u043c\u0430\u0439\u0433\u043e \u0441\u0442\u0440\u0430\u0445\u0443\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0441\u0442 4, 17rsh (LXX); \u0401\u045e 24, 23&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u0430\u0439 \u043c\u043d\u0435 \u0430\u0434\u0432\u0430\u0433\u0443, \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u0432\u044f\u0442\u044b \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0443\u043a\u043b\u0430\u0434\u0437\u0456 \u045e \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0441\u043b\u043e\u0432\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043c\u0456\u043b\u0430\u0433\u0443\u0447\u043d\u0443\u044e \u043c\u043e\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u0430\u0439 \u043d\u0430\u043c, \u041f\u0430\u043d\u0435, \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043f\u0430\u043a\u0430\u044f\u0446\u0446\u0430 \u0456 \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0439 \u0432\u0443\u0441\u043d\u0430\u045e, \u0448\u0442\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0426\u044f\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u043a\u043b\u0430\u0434\u0437\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"295","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u042d\u0441\u0442\u044d\u0440\u044b <\/span><span style=\"color: #ff0000;\">5, 1-5; 7, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0440\u043e\u043b\u044c \u0456 \u0410\u043c\u0430\u043d \u043d\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0435 \u045e \u042d\u0441\u0442\u044d\u0440\u044b. \u041f\u0430\u0432\u0435\u0448\u0430\u043d\u043d\u0435 \u0410\u043c\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u042d\u0441\u0442\u044d\u0440\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u044f \u0448\u0430\u0442\u044b \u0456 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u043c \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u0434\u043e\u043c\u0430, \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u043e\u043c\u0430 \u043a\u0430\u0440\u0430\u043b\u044f. \u041a\u0430\u0440\u043e\u043b\u044c \u0436\u0430 \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u0442\u0440\u043e\u043d\u0435 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u0434\u043e\u043c\u0435, \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0434\u043e\u043c. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0443\u0431\u0430\u0447\u044b\u045e \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0443 \u042d\u0441\u0442\u044d\u0440\u0443, \u044f\u043a\u0430\u044f \u0441\u0442\u0430\u044f\u043b\u0430 \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b, \u044f\u043d\u0430 \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0430 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u0430\u0447\u0430\u0445, \u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0434\u0430 \u042d\u0441\u0442\u044d\u0440\u044b \u0437\u0430\u043b\u0430\u0442\u043e\u0435 \u0436\u0430\u0437\u043b\u043e, \u044f\u043a\u043e\u0435 \u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u0446\u044d. \u0422\u0430\u0434\u044b \u042d\u0441\u0442\u044d\u0440\u0430 \u043f\u0430\u0434\u044b\u0448\u043b\u0430 \u0456 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u043c\u0430\u043a\u0430\u045e\u043a\u0456 \u0436\u0430\u0437\u043b\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439: \u00ab\u0428\u0442\u043e \u0442\u0430\u0431\u0435, \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u042d\u0441\u0442\u044d\u0440\u0430, \u044f\u043a\u0430\u044f \u0422\u0432\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430? \u0425\u043e\u0446\u044c \u0431\u044b \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u043f\u0430\u043b\u043e\u0432\u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0442\u0430\u0431\u0435\u00bb. \u0410 \u042d\u0441\u0442\u044d\u0440\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u044b\u043c, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u0451\u043d\u043d\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043c\u0430\u043d\u0430\u043c \u043d\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0443, \u044f\u043a\u0443\u044e \u044f \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u0434\u043b\u044f \u044f\u0433\u043e\u00bb. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u0441\u043f\u044f\u0448\u044b\u0446\u0435 \u0437\u0430 \u0410\u043c\u0430\u043d\u0430\u043c, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u044f\u043a \u0445\u043e\u0447\u0430 \u042d\u0441\u0442\u044d\u0440\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u0440\u043e\u043b\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043c\u0430\u043d\u0430\u043c \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u043a\u0430\u0431 \u0431\u0430\u043d\u043a\u0435\u0442\u0430\u0432\u0430\u0446\u044c \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439 \u042d\u0441\u0442\u044d\u0440\u0430\u0439. \u041d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u043d\u0430\u043f\u0456\u045e\u0441\u044f \u0432\u0456\u043d\u0430, \u043a\u0430\u0440\u043e\u043b\u044c \u0437\u043d\u043e\u045e \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u042d\u0441\u0442\u044d\u0440\u044b: \u00ab\u042f\u043a\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u0442\u0432\u0430\u044f, \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u042d\u0441\u0442\u044d\u0440\u0430? \u0411\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0442\u0430\u0431\u0435. \u042f\u043a\u043e\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0442\u0432\u0430\u0451? \u0425\u043e\u0446\u044c \u0431\u044b \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u043f\u0430\u043b\u043e\u0432\u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u00bb. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u042d\u0441\u0442\u044d\u0440\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u041a\u0430\u0440\u043e\u043b\u044c, \u043a\u0430\u043b\u0456 \u044f \u043c\u0430\u044e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0442\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445 \u0456 \u043a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u043c\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0430\u0451\u0439 \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0456 \u043d\u0430\u0440\u043e\u0434 \u043c\u043e\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0430\u0439\u0433\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u044f. \u0411\u043e \u043f\u0440\u0430\u0434\u0430\u043b\u0456 \u043d\u0430\u0441, \u043c\u044f\u043d\u0435 \u0456 \u043d\u0430\u0440\u043e\u0434 \u043c\u043e\u0439, \u043d\u0430 \u0432\u044b\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435, \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430 \u0456 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c. \u041a\u0430\u043b\u0456 \u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u043f\u0440\u0430\u0434\u0430\u043d\u044b\u044f \u044f\u043a \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456 \u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b, \u044f \u043c\u0430\u045e\u0447\u0430\u043b\u0430 \u0431, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u044b \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u045e \u0431\u044b \u0433\u044d\u0442\u0430\u0439 \u0448\u043a\u043e\u0434\u044b \u043a\u0430\u0440\u0430\u043b\u044e\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448, \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u044b \u042d\u0441\u0442\u044d\u0440\u044b, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0425\u0442\u043e \u0451\u043d \u0442\u0430\u043a\u0456 \u0456 \u0434\u0437\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0434\u0432\u0430\u0436\u044b\u045e\u0441\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u0446\u044c?\u00bb \u042d\u0441\u0442\u044d\u0440\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0422\u043e\u0439 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a \u0456 \u0432\u043e\u0440\u0430\u0433 \u2013 \u0410\u043c\u0430\u043d, \u0451\u043d \u0433\u044d\u0442\u044b \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u00bb. \u0421\u0442\u0440\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u0410\u043c\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439. \u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0433\u043d\u0435\u0432\u0435 \u045e\u0441\u0442\u0430\u045e \u0437-\u0437\u0430 \u0441\u0442\u0430\u043b\u0430 \u0437 \u0432\u0456\u043d\u043e\u043c \u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u0443 \u043f\u0430\u043b\u0430\u0446\u0430\u0432\u044b \u0441\u0430\u0434. \u0410\u043c\u0430\u043d \u0436\u0430 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f, \u043a\u0430\u0431 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0443 \u042d\u0441\u0442\u044d\u0440\u0443 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u044f\u043c\u0443 \u0436\u044b\u0446\u0446\u0451, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u044f\u0433\u043e \u0434\u0440\u044d\u043d\u043d\u044b \u043a\u0430\u043d\u0435\u0446 \u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437 \u043f\u0430\u043b\u0430\u0446\u0430\u0432\u0430\u0433\u0430 \u0441\u0430\u0434\u0443 \u045e \u0434\u043e\u043c, \u0434\u0437\u0435 \u0431\u044b\u043b\u043e \u0437\u0430\u0441\u0442\u043e\u043b\u043b\u0435 \u0437 \u0432\u0456\u043d\u043e\u043c, \u0443\u0431\u0430\u0447\u044b\u045e \u044f\u043a \u0410\u043c\u0430\u043d \u0443\u043f\u0430\u045e \u043d\u0430 \u043b\u043e\u0436\u0430, \u043d\u0430 \u044f\u043a\u0456\u043c \u0431\u044b\u043b\u0430 \u042d\u0441\u0442\u044d\u0440\u0430. \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u044f\u045e\u0436\u043e \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0443 \u0445\u043e\u0447\u0430\u0448 \u0437\u0433\u0432\u0430\u043b\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b \u043c\u043d\u0435 \u045e \u0434\u043e\u043c\u0435?\u00bb \u0422\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430 \u0441\u044b\u0448\u043b\u043e \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a \u0437\u0430\u043a\u0440\u044b\u043b\u0456 \u0442\u0432\u0430\u0440 \u0410\u043c\u0430\u043d\u0443. \u0422\u0430\u0434\u044b \u0425\u0430\u0440\u0431\u043e\u043d, \u0430\u0434\u0437\u0456\u043d \u0437 \u0435\u045e\u043d\u0443\u0445\u0430\u045e, \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: \u00ab\u0412\u043e\u0441\u044c \u0443 \u0434\u043e\u043c\u0435 \u0410\u043c\u0430\u043d\u0430 \u0441\u0442\u0430\u0456\u0446\u044c \u0443\u0436\u043e \u0448\u044b\u0431\u0435\u043d\u0456\u0446\u0430 \u0432\u044b\u0448\u044b\u043d\u0451\u044e \u043f\u044f\u0446\u044c\u0434\u0437\u044f\u0441\u044f\u0442 \u043b\u0430\u043a\u0446\u0435\u0439, \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u044f \u0410\u043c\u0430\u043d\u0430\u043c \u0434\u043b\u044f \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0456\u045e \u043a\u0430\u0440\u0430\u043b\u044e\u00bb. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c: \u00ab\u041f\u0430\u0432\u0435\u0441\u0446\u0435 \u044f\u0433\u043e \u043d\u0430 \u0451\u0439\u00bb. \u0422\u0430\u043c\u0443 \u043f\u0430\u0432\u0435\u0441\u0456\u043b\u0456 \u0410\u043c\u0430\u043d\u0430 \u043d\u0430 \u0448\u044b\u0431\u0435\u043d\u0456\u0446\u044b, \u044f\u043a\u0443\u044e \u0442\u043e\u0439 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u041c\u0430\u0440\u0434\u0430\u0445\u0435\u044f. \u0406 \u0441\u0446\u0456\u0445 \u0433\u043d\u0435\u045e \u043a\u0430\u0440\u0430\u043b\u044f.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0441\u0442 10, 3f; \u0406\u0441 48, 20b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u041f\u0430\u043d\u0430, \u0456 \u041f\u0430\u043d \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u044f\u0433\u043e \u0437 \u0443\u0441\u0456\u0445 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0437\u043d\u0430\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0448\u0442\u043e \u041f\u0430\u043d \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u042f\u043a\u0443\u0431\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u044b\u0437\u0432\u0430\u043b\u0456\u045e<\/span><span style=\"font-size: 13.999999999999998pt; font-family: Calibri, sans-serif;\">.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"296","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0411\u0430\u0440\u0443\u0445\u0430 <\/span><span style=\"color: #ff0000;\">1, 14 \u2013 2, 5; 3, 1-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043a\u0430\u044f\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443, \u044f\u043a\u0443\u044e \u043c\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0432\u0430\u043c. \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u044f\u0435 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u045e \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0456 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0434\u043d\u0456. \u041a\u0430\u0436\u044b\u0446\u0435:<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u00ab\u0423 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0443 \u043d\u0430\u0441 \u0436\u0430 \u2013 \u0441\u043e\u0440\u0430\u043c \u043d\u0430 \u0442\u0432\u0430\u0440\u0430\u0445, \u044f\u043a \u0441\u0451\u043d\u043d\u044f \u0432\u0430 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0433\u0430\u0431\u0440\u044d\u044f \u0456 \u045e \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0443 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u043d\u0430\u0448\u044b\u0445 \u0456 \u045e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0443 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u0443 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u045e \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u0431\u043e \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u042f\u0433\u043e, \u043d\u0435 \u043f\u0430\u0447\u0443\u043b\u0456 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456\u044f \u0401\u043d \u043d\u0430\u043c \u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0417 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u043c\u044b \u0431\u044b\u043b\u0456 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u0456 \u043d\u0435 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0430 \u043d\u0430\u0441, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043b\u0456 \u043d\u0430\u0441 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d, \u044f\u043a\u0456\u043c\u0456 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e \u041f\u0430\u043d \u043f\u0440\u0430\u0437 \u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u041c\u0430\u0439\u0441\u0435\u044f \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u045e \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u043d\u0430\u043c \u0437\u044f\u043c\u043b\u044e, \u0434\u0437\u0435 \u043f\u043b\u044b\u0432\u0443\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u043e \u0456 \u043c\u0451\u0434, \u044f\u043a \u0441\u0451\u043d\u043d\u044f. \u0406 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u043c\u044b \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u0445 \u043f\u0430\u0441\u044b\u043b\u0430\u045e \u0434\u0430 \u043d\u0430\u0441. \u041a\u043e\u0436\u043d\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u043b\u044b\u0445 \u043d\u0430\u043c\u0435\u0440\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0441\u043b\u0443\u0436\u0430\u0447\u044b \u0447\u0443\u0436\u044b\u043c \u0431\u0430\u0433\u0430\u043c \u0456 \u0440\u043e\u0431\u044f\u0447\u044b \u0437\u043b\u043e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0441\u043f\u043e\u045e\u043d\u0456\u045e \u041f\u0430\u043d \u0441\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u043d\u0430\u0448\u044b\u0445, \u044f\u043a\u0456\u044f \u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0448\u044b\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042e\u0434\u044b. \u041d\u0456\u0434\u0437\u0435 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0433\u0430 \u045e \u0437\u0430\u043a\u043e\u043d\u0435 \u041c\u0430\u0439\u0441\u0435\u044f, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430 \u0456 \u043a\u043e\u0436\u043d\u044b \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0447\u043a\u0456. \u0406 \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u0443 \u043d\u044f\u0432\u043e\u043b\u044e \u045e\u0441\u0456\u043c \u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430\u043c, \u043d\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0443 \u0456 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u0456\u0445 \u041f\u0430\u043d. \u0406 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456, \u0430 \u043d\u0435 \u043f\u0430\u043d\u0443\u044e\u0447\u044b\u043c\u0456, \u0431\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u042f\u0433\u043e \u0433\u043e\u043b\u0430\u0441\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u0430\u044f \u0434\u0443\u0448\u0430 \u0456 \u0437\u043b\u0430\u043c\u0430\u043d\u044b \u0434\u0443\u0445 \u043a\u043b\u0456\u0447\u0430 \u0426\u044f\u0431\u0435. \u041f\u0430\u0447\u0443\u0439, \u041f\u0430\u043d\u0435, \u0456 \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f, \u0431\u043e \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0411\u043e \u0422\u044b \u0442\u0440\u044b\u0432\u0430\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456, \u0430 \u043c\u044b \u0432\u0435\u0447\u043d\u0430 \u0433\u0456\u043d\u0435\u043c. \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0430\u0447\u0443\u0439 \u0436\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u044b\u043d\u043e\u045e, \u044f\u043a\u0456\u044f \u0433\u0440\u0430\u0448\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0430\u0447\u0443\u043b\u0456 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u043d\u0430 \u0441\u044f\u0431\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u0430\u043b\u0435 \u0437\u0433\u0430\u0434\u0430\u0439 \u043f\u0440\u0430 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0456 \u0441\u0432\u0430\u0451 \u0456\u043c\u044f \u045e \u0433\u044d\u0442\u044b \u0447\u0430\u0441! \u0411\u043e \u0422\u044b \u2013 \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435. \u0422\u0430\u043c\u0443 \u0422\u044b \u045e\u043b\u0456\u045e \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u045e \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456\u043c\u044f \u0422\u0432\u0430\u0451. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u043d\u0430\u0448\u044b\u043c \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456, \u0431\u043e \u043c\u044b \u0432\u044b\u043a\u0456\u043d\u0443\u043b\u0456 \u0437 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u044f\u043a\u0456\u044f \u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0412\u043e\u0441\u044c \u043c\u044b \u0441\u0451\u043d\u043d\u044f \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456, \u0434\u0437\u0435 \u0422\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u043d\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u0433\u0430\u043d\u044c\u0431\u044b \u0456 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443, \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0437\u0430 \u045e\u0441\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u044f\u043a\u0456\u044f \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0444 2, 4-5; \u043f\u0430\u0440. \u0411\u0430\u0440 2, 12<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0430\u0441, \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437-\u0437\u0430 \u0433\u0440\u0430\u0445\u043e\u045e, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043e\u0433, \u0431\u0443\u0434\u0443\u0447\u044b \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0443 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0430\u0436\u044b\u0432\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430 \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0422\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e, \u043d\u0430\u0448 \u0411\u043e\u0436\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"297","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0411\u0430\u0440\u0443\u0445\u0430 <\/span><span style=\"color: #ff0000;\">3, 9-15. 24 \u2013 4, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u2013 \u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u043b\u0443\u0445\u0430\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0441\u0445\u0456\u043b\u0456 \u0432\u0443\u0445\u0430, \u043a\u0430\u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0448\u0442\u043e \u0442\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u045e \u0437\u044f\u043c\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u045e? \u0417\u043c\u0430\u0440\u043d\u0435\u045e \u0442\u044b \u045e \u0447\u0443\u0436\u043e\u0439 \u0437\u044f\u043c\u043b\u0456. \u041b\u0456\u0447\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u044b\u043c, \u044f\u043a \u043c\u0451\u0440\u0442\u0432\u044b\u0445. \u0422\u044b \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c. \u0422\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0445\u0430\u0434\u0437\u0456\u045e \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u0442\u043e \u0436\u044b\u045e \u0431\u044b \u043d\u0430\u0432\u0435\u043a\u0456 \u045e \u0441\u043f\u0430\u043a\u043e\u0456. \u0421\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0456, \u0434\u0437\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0434\u0437\u0435 \u0441\u0456\u043b\u0430 \u0456 \u0440\u043e\u0437\u0443\u043c, \u043f\u0430\u0437\u043d\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0434\u0437\u0435 \u0434\u0430\u045e\u0433\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0456 \u0436\u044b\u0446\u0446\u0451, \u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0447\u044d\u0439 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439. \u0410\u043b\u0435 \u0436 \u0445\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u044f\u0435 \u043c\u0435\u0441\u0446\u0430, \u0445\u0442\u043e \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u044f\u0435 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b?<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456 \u0436 \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u043e\u043c \u0411\u043e\u0433\u0430 \u0456 \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u043d\u0430\u0435 \u042f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435! \u0412\u044f\u043b\u0456\u043a\u0430\u0435 \u0456 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0435, \u0432\u044b\u0441\u043e\u043a\u0430\u0435 \u0456 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0435. \u0422\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0433\u0456\u0433\u0430\u043d\u0442\u044b, \u0441\u043b\u0430\u0432\u0443\u0442\u044b\u044f \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0440\u043e\u0441\u043b\u044b\u044f \u0434\u044b \u045e\u043c\u0435\u043b\u044b\u044f \u0432\u0430\u044f\u0440\u044b. \u0410\u043b\u0435 \u043d\u0435 \u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433 \u0456 \u043d\u0435 \u0456\u043c \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0448\u043b\u044f\u0445 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u042f\u043d\u044b \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456, \u0431\u043e \u043d\u0435 \u043c\u0435\u043b\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u0437-\u0437\u0430 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0425\u0442\u043e \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430 \u0456 \u0437\u0434\u0430\u0431\u044b\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0445\u0442\u043e \u0441\u043f\u0443\u0441\u0446\u0456\u045e \u044f\u0435 \u0437 \u0430\u0431\u043b\u043e\u043a\u0430\u045e? \u0425\u0442\u043e \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0434\u0440\u0443\u0433\u0456 \u0431\u0435\u0440\u0430\u0433 \u043c\u043e\u0440\u0430 \u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u044f\u0435, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u0435 \u0437\u0430\u043c\u0435\u0441\u0442 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430? \u041d\u044f\u043c\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u044f\u0435 \u0448\u043b\u044f\u0445 \u0456 \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u044f\u0435 \u0441\u0446\u0435\u0436\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u045e\u0441\u0451, \u0432\u0435\u0434\u0430\u0435 \u044f\u0435, \u0430\u0434\u043a\u0440\u044b\u045e \u044f\u0435 \u0441\u0432\u0430\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0437\u044f\u043c\u043b\u044e \u043d\u0430 \u0432\u0435\u0447\u043d\u044b\u044f \u0447\u0430\u0441\u044b \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u044f\u0435 \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u043d\u043e\u0433\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456; \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u044f\u043d\u043e \u043f\u0430\u0439\u0448\u043b\u043e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e, \u0456 \u044f\u043d\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0430\u0441\u044f \u042f\u0433\u043e \u0437 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c. \u0417\u043e\u0440\u043a\u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0437\u0456\u0445\u0430\u0446\u044f\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0430\u0440\u0446\u0435. \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456\u0445, \u0430 \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0412\u043e\u0441\u044c \u043c\u044b\u00bb. \u0406 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437\u0430\u0441\u0432\u044f\u0446\u0456\u043b\u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0456\u0445 \u0443\u0447\u044b\u043d\u0456\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0401\u043d \u2013 \u0411\u043e\u0433 \u043d\u0430\u0448. \u0406 \u043d\u0456\u0445\u0442\u043e \u0456\u043d\u0448\u044b \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u0446\u0430 \u0437 \u0406\u043c. \u0401\u043d \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443\u0441\u0435 \u0448\u043b\u044f\u0445\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u045e \u044f\u0435 \u0441\u043b\u0443\u0437\u0435 \u0441\u0432\u0430\u0439\u043c\u0443, \u042f\u043a\u0443\u0431\u0443, \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044e, \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443. \u041f\u0430\u0441\u043b\u044f \u044f\u043d\u0430 \u0437\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f\u043d\u0430 \u2013 \u043a\u043d\u0456\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0411\u043e\u0436\u044b\u0445 \u0456 \u0417\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u044f\u0435, \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435, \u0430 \u0445\u0442\u043e \u044f\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0435, \u043f\u0430\u043c\u0440\u044d. \u0412\u044f\u0440\u043d\u0456\u0441\u044f, \u042f\u043a\u0443\u0431\u0435, \u043f\u0440\u044b\u043c\u0456 \u044f\u0435, \u0445\u0430\u0434\u0437\u0456 \u045e \u0437\u0437\u044f\u043d\u043d\u0456 \u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u0430. \u041d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0447\u0443\u0436\u044b\u043d\u0446\u0443, \u043d\u0456 \u043f\u0440\u044b\u0432\u0456\u043b\u0435\u044f\u045e \u0442\u0432\u0430\u0456\u0445 \u0456\u043d\u0448\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443. \u041c\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0431\u043e \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u043c\u0443 \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 11, 33; \u0411\u0430\u0440 3, 32\u0430. 37b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041e \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430! <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u042f\u043a\u0456\u044f \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u042f\u0433\u043e \u0456 \u043d\u044f\u0437\u0432\u0435\u0434\u0430\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u042f\u0433\u043e\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u045e\u0441\u0451, \u0432\u0435\u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0434\u0430\u045e \u044f\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044e, \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456\u044f \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"301","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">1, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041b\u044e\u0431\u0456\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u045e \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0456 \u045e \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0441\u044d\u0440\u0446\u0430 \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u042f\u0433\u043e. \u0411\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u042f\u0433\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u042f\u0433\u043e, \u0456 \u0430\u0431\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0401\u043d \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u045e\u0441\u044f \u045e \u0406\u043c. \u0411\u043e \u043b\u0456\u0445\u0456\u044f \u0434\u0443\u043c\u043a\u0456 \u0430\u0434\u0434\u0430\u043b\u044f\u044e\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u043a\u0430\u043b\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u043c\u043e\u0446, \u044f\u043d\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0439 \u0434\u0443\u0448\u044b \u0456 \u043d\u0435 \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435, \u0448\u0442\u043e \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u0430 \u0433\u0440\u0430\u0445\u043e\u043c. \u0411\u043e \u0441\u0432\u044f\u0442\u044b \u0414\u0443\u0445 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u0456 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0434\u0443\u043c\u0430\u043a, \u0456 \u0437\u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043b\u044e\u0431\u043d\u044b \u0434\u0443\u0445, \u0430\u043b\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0431\u0435\u0437 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u2013 \u0441\u0432\u0435\u0434\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0443\u0442\u0440\u0430, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0434\u0430\u0437\u043e\u0440\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0441\u043b\u0443\u0445\u0430\u0447 \u044f\u0433\u043e\u043d\u0430\u0439 \u043c\u043e\u0432\u044b. \u0411\u043e \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u0432\u0435\u0442, \u0456 \u0442\u043e\u0439, \u044f\u043a\u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0440\u0430\u0437\u0430\u043c \u0443\u0441\u0451, \u0432\u0435\u0434\u0430\u0435 \u043c\u043e\u0432\u0443. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0456 \u043d\u0435 \u0430\u0431\u043c\u0456\u043d\u0435 \u044f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435. \u0417\u0430\u0434\u0443\u043c\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u043a\u0440\u044b\u0442\u044b, \u0456 \u0434\u0430 \u041f\u0430\u043d\u0430 \u0434\u043e\u0439\u0434\u0437\u0435 \u043d\u0430\u0432\u0456\u043d\u0430 \u043f\u0440\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f \u044f\u0433\u043e \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e. \u0411\u043e \u0447\u0443\u0439\u043d\u0430\u0435 \u0432\u0443\u0445\u0430 \u0447\u0443\u0435 \u045e\u0441\u0451, \u0456 \u0448\u044d\u043f\u0442 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0447\u0443\u0442\u044b. \u0422\u0430\u043c\u0443 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f, \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0446\u0435 \u044f\u0437\u044b\u043a \u0430\u0434 \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u044f, \u0431\u043e \u0456 \u0442\u0430\u0435\u043c\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u0431\u0435\u0437\u0432\u044b\u043d\u0456\u043a\u043e\u0432\u0430\u0435, \u0430 \u0456\u043b\u0436\u044b\u0432\u044b\u044f \u0432\u0443\u0441\u043d\u044b \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0434\u0443\u0448\u0443. \u041d\u0435 \u0456\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0443\u0434\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043d\u0435 \u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0441\u0430\u0431\u0435 \u0437\u0433\u0443\u0431\u0443 \u0441\u0432\u0430\u0456\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u0456, \u0401\u043d \u043d\u0435 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u0430 \u0437\u0433\u0443\u0431\u044b \u0436\u044b\u0432\u043e\u0433\u0430. \u0411\u043e \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f, \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0441\u0432\u0435\u0442\u0443 \u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0437\u0434\u0430\u0440\u043e\u045e\u0435, \u043d\u044f\u043c\u0430 \u045e \u0456\u0445 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0439 \u0430\u0442\u0440\u0443\u0442\u044b, \u043d\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u043f 3, 13\u0430. 15\u0430. 17; \u042f\u043a 3, 17<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0434\u0430\u0431\u044b\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0431\u043e \u044f\u043d\u0430 \u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u044f \u0437\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u042f\u0435 \u0448\u043b\u044f\u0445\u0456 \u2013 \u0448\u043b\u044f\u0445\u0456 \u043b\u044e\u0431\u044b\u044f, \u0443\u0441\u0435 \u0441\u0446\u0435\u0436\u043a\u0456 \u044f\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u043a\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0432\u044b\u0448, \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u2013 \u0447\u044b\u0441\u0442\u0430\u044f, \u043f\u043e\u0442\u044b\u043c \u2013 \u043c\u0456\u0440\u0430\u043b\u044e\u0431\u043d\u0430\u044f, \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0430\u044f, \u043f\u043e\u045e\u043d\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u043b\u0430\u0434\u043e\u045e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u0435 \u0448\u043b\u044f\u0445\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"302","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">1, 16 \u2013 2, 1\u0430. 10-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435\u0434\u0430\u0440\u044d\u0447\u043d\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u043d\u044f\u043c\u0443\u0434\u0440\u044b\u0445 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0430\u043b\u0456\u0447\u044b\u045e\u0448\u044b \u044f\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u043a\u0430\u0439, \u0437\u043c\u0430\u0440\u043d\u0435\u043b\u0456 \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u043b\u0456 \u0437 \u0451\u0439 \u0434\u0430\u043c\u043e\u0432\u0443, \u0431\u043e \u044f\u043d\u044b \u0433\u043e\u0434\u043d\u044b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0437 \u0451\u0439 \u043b\u0451\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043c\u044b\u043b\u043a\u043e\u0432\u0430 \u043c\u044f\u0440\u043a\u0443\u044e\u0447\u044b, \u044f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u0430\u043c\u0456 \u0441\u0430\u0431\u0435: \u00ab\u0411\u0443\u0434\u0437\u0435\u043c \u0443\u0446\u0456\u0441\u043a\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0431\u0435\u0434\u043d\u044f\u043a\u0430, \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435\u043c \u043d\u0430\u0432\u0430\u0442 \u0443\u0434\u0430\u0432\u044b \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u0448\u043c\u0430\u0442\u0433\u0430\u0434\u043e\u0432\u0430\u0439 \u0441\u0456\u0432\u0456\u0437\u043d\u044b \u0441\u0442\u0430\u0440\u0446\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u0430\u044f \u0441\u0456\u043b\u0430 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u043e \u0441\u043b\u0430\u0431\u043e\u0435, \u043d\u0435 \u043c\u0430\u0435 \u0432\u0430\u0440\u0442\u0430\u0441\u0446\u0456. \u0417\u0440\u043e\u0431\u0456\u043c \u043f\u0430\u0441\u0442\u043a\u0443 \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0431\u043e \u0451\u043d \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b \u0434\u043b\u044f \u043d\u0430\u0441 \u0456 \u043f\u0440\u0430\u0446\u0456\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u0443\u0447\u044b\u043d\u043a\u0430\u043c, \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0433\u0440\u0430\u0445\u0430\u0445 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0417\u0430\u043a\u043e\u043d\u0443, \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u0443 \u0433\u0440\u0430\u0445\u0430\u0445 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f. \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0435, \u043d\u0456\u0431\u044b\u0442\u0430 \u0451\u043d \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430, \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0434\u0437\u0456\u0446\u0435\u043c \u041f\u0430\u043d\u0430. \u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0434\u0430\u043a\u043e\u0440\u0430\u043c \u0434\u0443\u043c\u0430\u043a \u043d\u0430\u0448\u044b\u0445, \u043d\u0430\u043c \u0446\u044f\u0436\u043a\u0430 \u043d\u0430\u0432\u0430\u0442 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u044f\u0433\u043e, \u0431\u043e \u0436\u044b\u0446\u0446\u0451 \u044f\u0433\u043e \u043d\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0456\u043d\u0448\u044b\u0445 \u0456 \u0448\u043b\u044f\u0445\u0456 \u042f\u0433\u043e \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u044e\u0446\u0446\u0430. \u0401\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u043d\u0430\u0441 \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c; \u0451\u043d \u0443\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0448\u043b\u044f\u0445\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u044f\u043a \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043a\u0430\u043d\u0435\u0446 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0456 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u0430\u0435 \u0411\u043e\u0433\u0430 \u0437\u0430 \u0430\u0439\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0431\u0430\u0447\u044b\u043c, \u0446\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u044f\u0433\u043e\u043d\u044b\u044f, \u0456 \u043f\u0440\u0430\u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b \u0441\u043a\u043e\u043d\u0435 \u044f\u0433\u043e\u043d\u044b\u043c. \u0411\u043e \u043a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u2013 \u0433\u044d\u0442\u0430 \u0441\u044b\u043d \u0411\u043e\u0436\u044b, \u0442\u043e \u0411\u043e\u0433 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u044f\u0433\u043e \u0456 \u0432\u044b\u0440\u0432\u0435 \u044f\u0433\u043e \u0437 \u0440\u0443\u043a\u0456 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e. \u041f\u0440\u0430\u0432\u0435\u0440\u044b\u043c \u044f\u0433\u043e \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u044e \u0456 \u043c\u0443\u043a\u0430\u044e, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u044f\u0433\u043e \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0410\u0441\u0443\u0434\u0437\u0456\u043c \u044f\u0433\u043e \u043d\u0430 \u0433\u0430\u043d\u0435\u0431\u043d\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u0431\u043e, \u044f\u043a \u0451\u043d \u043a\u0430\u0436\u0430, \u043f\u0430\u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u0430\u0431 \u0456\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043b\u0456 \u0456 \u043f\u0430\u043c\u044b\u043b\u0456\u043b\u0456\u0441\u044f, \u0431\u043e \u0456\u0445\u043d\u044f\u044f \u0437\u043b\u0430\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0437\u0430\u0441\u043b\u044f\u043f\u0456\u043b\u0430 \u0456\u0445. \u042f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0411\u043e\u0436\u044b\u0445, \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0430\u0434\u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0456 \u043d\u0435 \u0434\u0443\u043c\u0430\u043b\u0456 \u043f\u0440\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0434\u043b\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u0445 \u0434\u0443\u0448. \u0411\u043e \u0434\u043b\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0411\u043e\u0433 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0443\u0447\u044b\u043d\u0456\u045e \u044f\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456. \u0410\u043b\u0435 \u043f\u0440\u0430\u0437 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c \u0434\u2019\u044f\u0431\u043b\u0430 \u045e \u0441\u0432\u0435\u0442 \u0443\u0432\u0430\u0439\u0448\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0456 \u0437\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u044f\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0437 \u0456\u043c \u0443\u0434\u0437\u0435\u043b.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0434\u0440 2, 1\u0430. 12\u0430. 13b. 17\u0430. 18; \u041c\u0446 27, 43&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u043a\u0430\u0437\u0430\u043b\u0456: \u0417\u0440\u043e\u0431\u0456\u043c \u043f\u0430\u0441\u0442\u043a\u0443 \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0431\u043e \u0451\u043d \u043f\u0440\u0430\u0446\u0456\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u0443\u0447\u044b\u043d\u043a\u0430\u043c, \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0434\u0437\u0456\u0446\u0435\u043c \u041f\u0430\u043d\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041f\u0430\u0431\u0430\u0447\u044b\u043c, \u0446\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u044f\u0433\u043e\u043d\u044b\u044f. \u0411\u043e \u043a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u2013 \u0433\u044d\u0442\u0430 \u0441\u044b\u043d \u0411\u043e\u0436\u044b, \u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u0440\u0432\u0435 \u044f\u0433\u043e \u0437 \u0440\u0443\u043a\u0456 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u042f\u0433\u043e \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u0431\u043e \u0401\u043d \u043a\u0430\u0437\u0430\u045e: \u042f \u2013 \u0421\u044b\u043d \u0411\u043e\u0436\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0431\u0430\u0447\u044b\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"303","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">3, 1-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0443\u0448\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0443 \u0440\u0443\u043a\u0430\u0445 \u0411\u043e\u0433\u0430 \u2013 \u0456 \u043d\u0435 \u0437\u0430\u043a\u0440\u0430\u043d\u0435 \u0456\u0445 \u043d\u0456\u044f\u043a\u0430\u044f \u043f\u0430\u043a\u0443\u0442\u0430. \u0423 \u0432\u0430\u0447\u0430\u0445 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0430 \u0456\u0445 \u0441\u043c\u0435\u0440\u0446\u044c \u043b\u0456\u0447\u044b\u043b\u0430\u0441\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435\u043c, \u0456\u0445 \u0430\u0434\u044b\u0445\u043e\u0434 \u0430\u0434 \u043d\u0430\u0441 \u043b\u0456\u0447\u044b\u045e\u0441\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435\u043c, \u0430 \u044f\u043d\u044b \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u043a\u043e\u0456. \u0425\u043e\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u043d\u044b \u0437\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c\u0456, \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u0441\u043b\u044f \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0441\u044f\u0431\u0435. \u0412\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445, \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430 \u045e \u0433\u0430\u0440\u043d\u0456\u043b\u0435, \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0456\u0445, \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u044f \u044f\u043d\u044b \u0437\u0430\u0441\u0432\u0435\u0446\u044f\u0446\u044c \u0456 \u0440\u0430\u0437\u044b\u0434\u0443\u0446\u0446\u0430, \u044f\u043a \u0456\u0441\u043a\u0440\u044b \u045e \u0442\u0440\u044b\u0441\u043d\u044f\u0433\u0443. \u0411\u0443\u0434\u0443\u0446\u044c \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u0430 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u0425\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e, \u0442\u043e\u0439 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043f\u0440\u0430\u045e\u0434\u0443, \u0430 \u0432\u0435\u0440\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u044b \u0406\u043c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u043b\u0430\u0441\u043a\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f \u0437\u0430 \u0441\u0432\u0430\u0435 \u0437\u0430\u0434\u0443\u043c\u044b, \u0431\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u041f\u0430\u043d\u0430. \u041d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0433\u0440\u044d\u0431\u0443\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u043c\u0430\u0440\u043d\u0430\u044f \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f, \u0434\u0430\u0440\u044d\u043c\u043d\u044b\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u044b. \u0416\u043e\u043d\u043a\u0456 \u0456\u0445\u043d\u0456\u044f \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u0434\u0437\u0435\u0446\u0456 \u0456\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0456, \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u0456\u0445\u043d\u0456 \u0440\u043e\u0434.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u043d\u044f\u043f\u043b\u043e\u0434\u043d\u0430\u044f, \u0430\u043b\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u043b\u043e\u0436\u0430 \u0433\u0440\u0430\u0445\u0443. \u042f\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u045e \u0447\u0430\u0441 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u044f \u0434\u0443\u0448. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0435\u045e\u043d\u0443\u0445, \u044f\u043a\u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0440\u0443\u043a\u043e\u044e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u045e \u0437\u043b\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430. \u0417\u0430 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430. \u0411\u043e \u0434\u043e\u0431\u0440\u044b\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b \u043f\u043b\u0451\u043d, \u0430 \u043a\u043e\u0440\u0430\u043d\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u0435\u0446\u0456 \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u043a\u0430\u045e \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0435\u0434\u0430\u0440\u043e\u0441\u0442\u043a\u0430\u043c\u0456, \u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0430\u0433\u0430 \u043b\u043e\u0436\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0430\u0432\u0430\u0442 \u0436\u044b\u043b\u0456 \u0434\u043e\u045e\u0433\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u0456\u0447\u044b\u0446\u044c \u0456\u0445 \u0437\u0430 \u043d\u0456\u0448\u0442\u043e, \u0456 \u045e \u043a\u0430\u043d\u0446\u044b \u0456\u0445 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u0430\u044f. \u0406 \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0440\u0443\u0446\u044c \u0440\u0430\u043d\u0435\u0439, \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u0456, \u043d\u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430 \u2013 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0434\u0440 3, 6-7\u0430. 9&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445, \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430 \u045e \u0433\u0430\u0440\u043d\u0456\u043b\u0435, \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0456\u0445, \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f. \u041f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u044f \u044f\u043d\u044b \u0437\u0430\u0441\u0432\u0435\u0446\u044f\u0446\u044c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u043b\u0430\u0441\u043a\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e, \u0442\u043e\u0439 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043f\u0440\u0430\u045e\u0434\u0443, \u0430 \u0432\u0435\u0440\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u044b \u0406\u043c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043b\u0430\u0441\u043a\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"304","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">6, 1-25&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u043a\u0430\u0440\u0430\u043b\u0456, \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0439\u0446\u0435, \u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f, \u0441\u0443\u0434\u0434\u0437\u0456 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043d\u044b\u0445! \u0421\u0445\u0456\u043b\u0456\u0446\u0435 \u0432\u0443\u0445\u0430, \u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u043d\u0443\u0435\u0446\u0435 \u043d\u0430\u0434 \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0435\u0441\u044f \u0431\u0435\u0437\u043b\u0456\u0447\u0447\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0410\u0434 \u041f\u0430\u043d\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c \u0443\u043b\u0430\u0434\u0430, \u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u2013 \u0430\u0434 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0443\u0435 \u0432\u0430\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0432\u0430\u0448\u044b\u044f \u043d\u0430\u043c\u0435\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0411\u043e \u0432\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0435 \u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u0437\u0430\u043a\u043e\u043d \u0456 \u043d\u0435 \u0456\u0448\u043b\u0456 \u0437\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439. \u0401\u043d \u0433\u0440\u043e\u0437\u043d\u0430 \u0456 \u0445\u0443\u0442\u043a\u0430 \u0441\u044b\u0434\u0437\u0435 \u043d\u0430 \u0432\u0430\u0441, \u0431\u043e \u0441\u0443\u0440\u043e\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434 \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u0430\u043d\u0443\u0435. \u041d\u0430\u0439\u043c\u0435\u043d\u0448\u044b \u043f\u0440\u0430\u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435, \u0430\u043b\u0435 \u043c\u043e\u0446\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f. \u0411\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0443\u0441\u044f\u0433\u043e \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0430\u0441\u043e\u0431\u0443, \u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430 \u0432\u0435\u043b\u0456\u0447, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456 \u043c\u0430\u043b\u043e\u0433\u0430, \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0456 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0441\u0456\u0445, \u0430\u043b\u0435 \u043c\u043e\u0446\u043d\u044b\u0445 \u0447\u0430\u043a\u0430\u0435 \u0441\u0443\u0440\u043e\u0432\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0414\u0430 \u0432\u0430\u0441, \u0443\u043b\u0430\u0434\u0430\u0440\u044b, \u2013 \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u043a\u0430\u0431 \u0432\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u045e\u043f\u0430\u043b\u0456. \u0411\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u043e\u0435, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0430 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u043c\u0443 \u2013 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0430\u0431\u0430\u0440\u043e\u043d\u0443. \u0422\u0430\u043c\u0443 \u0436\u0430\u0434\u0430\u0439\u0446\u0435 \u041c\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e, \u0441\u0443\u043c\u0443\u0439\u0446\u0435 \u043f\u0430 \u0456\u0445, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0456 \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u0430\u044f. \u0417 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u044f\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u044f\u0435, \u0430 \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435, \u0442\u043e\u0439 \u044f\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435. \u042f\u043d\u0430 \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0435 \u043f\u0440\u0430\u0433\u043d\u0435, \u043a\u0430\u0431 \u043f\u0435\u0440\u0448\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u0430 \u0456\u043c. \u041d\u0435 \u0441\u0442\u043e\u043c\u0456\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0437\u0435\u043b\u044f \u044f\u0435 \u045e\u0441\u0442\u0430\u0435 \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0435, \u044f\u043a \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u044b \u044f\u0433\u043e\u043d\u044b\u0445 \u0434\u0437\u0432\u044f\u0440\u0430\u0445. \u0414\u0443\u043c\u0430\u0446\u044c \u043f\u0440\u0430 \u044f\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0445\u0442\u043e \u0447\u0443\u0432\u0430\u0435 \u0437-\u0437\u0430 \u044f\u0435, \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e. \u0411\u043e \u044f\u043d\u0430 \u0441\u0430\u043c\u0430 \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u0433\u043e\u0434\u043d\u044b\u0445 \u044f\u0435, \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0456\u043c \u043d\u0430 \u0448\u043b\u044f\u0445\u0430\u0445 \u0456\u0445\u043d\u0456\u0445, \u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0456\u0445\u043d\u044f\u0439 \u0437\u0430\u0434\u0443\u043c\u0435. \u042f\u0435 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u2013 \u0448\u0447\u044b\u0440\u0430\u044f \u043f\u0440\u0430\u0433\u0430 \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0430 \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u043d\u0430\u0432\u0443\u043a\u0443 \u2013 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e. \u041b\u044e\u0431\u043e\u045e \u0436\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u044f\u0435 \u0437\u0430\u043a\u043e\u043d\u0430\u045e, \u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u0443 \u2013 \u0433\u044d\u0442\u0430 \u0433\u0430\u0440\u0430\u043d\u0442\u044b\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u041d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0436\u0430 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0433\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f, \u0430 \u043a\u0430\u043b\u0456 \u0432\u044b, \u0443\u043b\u0430\u0434\u0430\u0440\u044b \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043c\u0430\u0435\u0446\u0435 \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u045e \u0456 \u0436\u044d\u0437\u043b\u0430\u045e, \u0442\u043e \u0448\u0430\u043d\u0443\u0439\u0446\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u0432\u0435\u0447\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0443, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u044f\u043a \u044f\u043d\u0430 \u045e\u0437\u043d\u0456\u043a\u043b\u0430, \u0456 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u044e \u0430\u0434 \u0432\u0430\u0441 \u0442\u0430\u044f\u043c\u043d\u0456\u0446, \u0430\u043b\u0435 \u043f\u0430\u0439\u0434\u0443 \u045e\u0441\u043b\u0435\u0434 \u0437\u0430 \u0451\u044e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0456 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044e \u0432\u0435\u0434\u044b \u043f\u0440\u0430 \u044f\u0435, \u0456 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0440\u0430\u0437\u043c\u0456\u043d\u0443\u0441\u044f \u0437 \u043f\u0440\u0430\u045e\u0434\u0430\u0439. \u041d\u0435 \u043f\u0430\u0439\u0434\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u0437\u2019\u044f\u0434\u0430\u0435 \u0437\u0430\u0439\u0437\u0434\u0430\u0440\u0441\u0446\u044c, \u0431\u043e \u0442\u0430\u043a\u0456 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0411\u043e \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u2013 \u0433\u044d\u0442\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443, \u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u2013 \u0433\u044d\u0442\u0430 \u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0443. \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u0435\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0434\u0440 7, 13\u0430. 14\u0430; 3, 11\u0430; 7, 28<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0448\u0447\u044b\u0440\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0431\u0435\u0437 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u044e \u044f\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0433\u044d\u0442\u0430 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u044b \u0441\u043a\u0430\u0440\u0431 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c; \u0411\u043e\u0433 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0433\u044d\u0442\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"305","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">7, 15-30<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0434\u0430c\u0446\u044c \u043c\u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435\u043c \u0456 \u0433\u043e\u0434\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0447\u044b\u043c \u044f \u0430\u0434\u043e\u0440\u0430\u043d\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0401\u043d \u2013 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0435 \u043c\u0443\u0434\u0440\u044b\u0445. \u0423 \u042f\u0433\u043e\u043d\u044b\u0445 \u0440\u0443\u043a\u0430\u0445 \u0456 \u043c\u044b, \u0456 \u043d\u0430\u0448\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u043a\u0442\u044b\u0447\u043d\u0430\u0435 \u045e\u043c\u0435\u043d\u043d\u0435. \u0401\u043d \u0441\u0430\u043c \u043c\u043d\u0435 \u0434\u0430\u045e \u0431\u0435\u0441\u043f\u0430\u043c\u044b\u043b\u043a\u043e\u0432\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0456\u0441\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u0446\u044c \u0443\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0441\u0442\u044b\u0445\u0456\u0439, \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u043a\u0430\u043d\u0435\u0446 \u0456 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0447\u0430\u0441\u043e\u045e, \u0437\u043c\u0435\u043d\u0443 \u0441\u043e\u043d\u0446\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044f \u0456 \u0447\u0430\u0440\u0433\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u043e\u0440\u0430\u045e <\/span><span style=\"font-style: italic;\">\u0433\u043e\u0434\u0430<\/span><span>, \u0433\u0430\u0434\u0430\u0432\u044b\u0445 \u0446\u044b\u043a\u043b\u0430\u045e \u0456 \u0440\u0430\u0437\u043c\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0437\u043e\u0440\u0430\u043a, \u043f\u0440\u044b\u0440\u043e\u0434\u0443 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442\u0430\u045e \u0434\u044b \u0456\u043d\u0441\u0442\u044b\u043d\u043a\u0442\u044b \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e, \u043c\u043e\u0446 \u0434\u0443\u0445\u0430\u045e \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0440\u0430\u0441\u043b\u0456\u043d\u0430\u045e \u0456 \u0441\u0456\u043b\u0443 \u043a\u0430\u0440\u0430\u043d\u0451\u045e. \u042f \u043f\u0430\u0437\u043d\u0430\u045e \u0443\u043a\u0440\u044b\u0442\u0430\u0435 \u0456 \u0431\u0430\u0447\u043d\u0430\u0435, \u0431\u043e \u0432\u0443\u0447\u044b\u043b\u0430 \u043c\u044f\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u2013 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u0430 \u045e\u0441\u044f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0401\u0441\u0446\u044c \u0443 \u0451\u0439 \u0434\u0443\u0445 \u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u0441\u0432\u044f\u0442\u044b, \u0430\u0434\u0437\u0456\u043d\u044b, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b, \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u044b, \u0440\u0443\u0445\u0430\u0432\u044b, \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u043d\u044b, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u044f\u0441\u043d\u044b, \u0431\u044f\u0441\u0448\u043a\u043e\u0434\u043d\u044b, \u0434\u0430\u0431\u0440\u0430\u043b\u044e\u0431\u043d\u044b, \u0432\u043e\u0441\u0442\u0440\u044b, \u043d\u044f\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b, \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u044b, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043b\u044e\u0431\u043d\u044b, \u043f\u044d\u045e\u043d\u044b, \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b, \u0431\u0435\u0441\u043a\u043b\u0430\u043f\u043e\u0442\u043d\u044b, \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u045e\u0441\u0451\u0431\u0430\u0447\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0435 \u0434\u0443\u0445\u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u043d\u0430\u0439\u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0435\u0439\u0448\u044b\u044f. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u0445\u0430\u0432\u0430\u044f \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0440\u0443\u0445, \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0447\u044b\u0441\u0446\u0456\u043d\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0413\u044d\u0442\u0430 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b, \u0447\u044b\u0441\u0442\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u043c\u0435\u043d\u044c\u0432\u0430\u043d\u043d\u0435 \u0441\u043b\u0430\u0432\u044b \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u0440\u0443\u0434\u043d\u0430\u0433\u0430 \u045e \u044f\u0435 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c. \u0413\u044d\u0442\u0430 \u0437\u0437\u044f\u043d\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u043b\u044e\u0441\u0442\u0440\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456. \u042f\u043d\u0430 \u0430\u0434\u043d\u0430, \u0430\u043b\u0435 \u045e\u0441\u0451 \u043c\u043e\u0436\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u043e\u0439, \u0443\u0441\u0451 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0443\u0448\u044b \u0441\u0432\u044f\u0442\u044b\u0445, \u0440\u044b\u0445\u0442\u0443\u0435 \u0441\u044f\u0431\u0440\u043e\u045e \u0411\u043e\u0436\u044b\u0445 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e. \u0411\u043e\u0433 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u042f\u043d\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u0430\u044f \u0437\u0430 \u0441\u043e\u043d\u0446\u0430, \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u045e\u0441\u0435 \u0441\u0443\u0437\u043e\u0440\u2019\u0456. \u0423 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u044f\u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u044f, \u0431\u043e \u0437\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0456\u0434\u0437\u0435 \u043d\u043e\u0447, \u0430 \u0437\u043b\u043e \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041a\u043b\u0441 1, 15-16\u0430; \u041c\u0434\u0440 7, 26<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043e \u045e \u0406\u043c \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u045e\u0441\u0451.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u2013 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u043b\u044e\u0441\u0442\u0440\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u045e \u0406\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"306","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">8, 1-21b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u0440\u044d\u0431\u0430 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0430\u0431 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043c\u0430\u0433\u0443\u0442\u043d\u0430 \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u043a\u0440\u0430\u044e \u0434\u0430 \u043a\u0440\u0430\u044e, \u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u044e \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u0456\u043c. \u042f\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f \u0456 \u0448\u0443\u043a\u0430\u045e \u0437 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439, \u0456 \u0436\u0430\u0434\u0430\u045e \u0443\u0437\u044f\u0446\u044c \u044f\u043a \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u0431\u043e \u0441\u0442\u0430\u045e \u0437\u0430\u0447\u0430\u0440\u0430\u0432\u0430\u043d\u044b \u044f\u0435 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e. \u042f\u043d\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0431\u043e \u0436\u044b\u0432\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0443\u0441\u044f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u044f\u0435. \u042f\u043d\u0430 \u045e\u0442\u0430\u044f\u043c\u043d\u0456\u0447\u0430\u043d\u0430 \u045e \u0432\u0435\u0434\u044b \u0411\u043e\u0433\u0430 \u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u0430\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u041a\u0430\u043b\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0436\u0430\u0434\u0430\u043d\u044b\u043c \u043d\u0430\u0431\u044b\u0442\u043a\u0430\u043c \u0443 \u0436\u044b\u0446\u0446\u0456, \u0442\u043e \u0448\u0442\u043e \u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0435 \u0437\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e? \u041a\u0430\u043b\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u043b\u0451\u043d\u043d\u0430, \u0442\u043e \u0445\u0442\u043e \u0437 \u0456\u0441\u043d\u0430\u0433\u0430 \u043b\u0435\u043f\u0448\u044b \u043c\u0430\u0439\u0441\u0442\u0430\u0440 \u0437\u0430 \u044f\u0435? \u0406 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e \u043f\u043b\u0451\u043d\u0430\u043c \u044f\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u043d\u043e\u0442\u044b, \u0431\u043e \u044f\u043d\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456, \u0437\u0430 \u044f\u043a\u0456\u0445 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0433\u0430 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0436\u044b\u0446\u0446\u0456. \u0410 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u0433\u043d\u0435&nbsp; \u0431\u043e\u043b\u044c\u0448\u044b\u0445 \u0432\u0435\u0434\u0430\u045e, \u0442\u043e \u044f\u043d\u0430 \u0432\u0435\u0434\u0430\u0435 \u043c\u0456\u043d\u0443\u043b\u0430\u0435 \u0456 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u0446\u044c \u0431\u0443\u0434\u0443\u0447\u0430\u0435, \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u0442\u043e\u043d\u043a\u0430\u0441\u0446\u0456 \u0441\u043b\u043e\u0432\u0430\u045e \u0456 \u0440\u0430\u0437\u0433\u0430\u0434\u0432\u0430\u0435 \u0437\u0430\u0433\u0430\u0434\u043a\u0456, \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0437\u043d\u0430\u043a\u0456 \u0456 \u0446\u0443\u0434\u044b, \u0432\u044b\u043d\u0456\u043a\u0456 \u043f\u043e\u0440\u0430\u045e \u0456 \u0447\u0430\u0441\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0422\u0430\u0434\u044b \u044f \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0436\u044b\u0446\u044c \u0437 \u0451\u0439, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0456\u043c \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u043c \u0443 \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c \u0441\u044f\u0440\u043e\u0434 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e \u0456 \u0441\u043c\u0443\u0442\u043a\u0443. \u041f\u0440\u0430\u0437 \u044f\u0435 \u044f, \u0445\u043e\u0446\u044c \u043c\u0430\u043b\u0430\u0434\u044b, \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u0445\u0432\u0430\u043b\u0443 \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d. \u0411\u0443\u0434\u0443 \u043a\u0435\u043c\u043b\u0456\u0432\u044b\u043c \u0443 \u0441\u0443\u0434\u0437\u0435, \u043d\u0430\u0432\u0430\u0442 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b \u0441\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u043c\u044f\u043d\u0435. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u2013 \u044f\u043d\u044b \u043f\u0430\u0447\u0430\u043a\u0430\u044e\u0446\u044c, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u043e\u045e\u043b\u044e \u2013 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c, \u0456 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0434\u043e\u045e\u0433\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u2013 \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0430\u0434\u0443\u0446\u044c \u0440\u0443\u043a\u0443 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u041f\u0440\u0430\u0437 \u044f\u0435 \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043a\u0456\u043d\u0443 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u0432\u0435\u0447\u043d\u0443\u044e \u043f\u0430\u043c\u044f\u0446\u044c \u0442\u044b\u043c, \u0448\u0442\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u043c\u044f\u043d\u0435. \u042f \u0431\u0443\u0434\u0443 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c\u0456 \u0456 \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u043d\u0435. \u0421\u043f\u0430\u043b\u043e\u0445\u0430\u044e\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u0440\u0430\u043d\u044b. \u0414\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u044f \u0431\u0443\u0434\u0443 \u0434\u043e\u0431\u0440\u044b\u043c, \u0430 \u043d\u0430 \u0432\u0430\u0439\u043d\u0435 \u2013 \u043c\u0443\u0436\u043d\u044b\u043c. \u041a\u0430\u043b\u0456 \u045e\u0432\u0430\u0439\u0434\u0443 \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c, \u044f \u0430\u0434\u043f\u0430\u0447\u043d\u0443 \u043f\u043e\u0431\u0430\u0447 \u0437 \u0451\u044e, \u0431\u043e \u045e \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0435 \u0437 \u0451\u0439 \u043d\u044f\u043c\u0430 \u0433\u043e\u0440\u044b\u0447\u044b, \u0456 \u0431\u043e\u043b\u044e \u043d\u044f\u043c\u0430 \u045e \u0441\u0443\u0436\u044b\u0446\u0446\u0456 \u0437 \u0451\u0439, \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0422\u0430\u043a \u0434\u0443\u043c\u0430\u045e \u044f \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0448\u0442\u043e \u045e \u0441\u0432\u0430\u044f\u0446\u0442\u0432\u0435 \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u2013 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0430 \u045e \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0435 \u0437 \u0451\u0439 \u2013 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u0430, \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u044f\u0435 \u0440\u0443\u043a \u2013 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0430 \u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u044e \u2013 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u0441\u043b\u0430\u0432\u0430 \u2013 \u0443 \u0433\u0443\u0442\u0430\u0440\u0446\u044b \u0437 \u0451\u044e. \u042f \u043a\u0440\u0443\u0436\u044b\u045e, \u0448\u0443\u043a\u0430\u044e\u0447\u044b, \u044f\u043a \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u044f\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u045e \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u044e\u043d\u0430\u043a\u043e\u043c \u0441\u0430 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u0430\u0439 \u0434\u0443\u0448\u043e\u0439, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u045e \u0434\u043e\u0431\u0440\u044b\u043c, \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0446\u0435\u043b\u0430. \u0410 \u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b, \u0448\u0442\u043e \u043d\u0435 \u0437\u043c\u0430\u0433\u0443 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u044f\u0435, \u2013 \u0456 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u044f\u0432\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456: \u0432\u0435\u0434\u0430\u0446\u044c, \u0447\u044b\u0439 \u0433\u044d\u0442\u0430 \u0434\u0430\u0440, \u2013 \u044f \u0441\u0443\u0441\u0442\u0440\u044d\u045e \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0434\u0440 7, 7. 8\u0430; \u042f\u043a 1, 5<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u2013 \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u2013 \u0456 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u042f \u0430\u0434\u0434\u0430\u045e \u0451\u0439 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0441\u043a\u0456\u043f\u0435\u0442\u0440\u0430\u043c\u0456 \u0456 \u0442\u0440\u043e\u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u043c\u0443 \u0437 \u0432\u0430\u0441 \u043d\u0435\u0441\u0442\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0443 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u0456 \u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0435, \u2013 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"307","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 <\/span><span style=\"color: #ff0000;\">11, 20b \u2013 12, 2. 11b-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d\u0435, \u0422\u044b \u045e\u0441\u0451 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b, \u043b\u0456\u0447\u0431\u044b \u0456 \u0432\u0430\u0433\u0456. \u0411\u043e \u0422\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u043e\u0436\u0430\u0448 \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0456 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0456\u043b\u044b \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u043b\u044f\u0447\u0430? \u0423\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u044f\u043a \u0432\u0430\u0433\u0430\u043d\u043d\u0435 \u0448\u0430\u043b\u044f\u045e \u0430\u0431\u043e \u044f\u043a \u043a\u0440\u043e\u043f\u043b\u044f \u0440\u0430\u043d\u0456\u0448\u043d\u044f\u0439 \u0440\u0430\u0441\u044b, \u044f\u043a\u0430\u044f \u0432\u044b\u043f\u0430\u0434\u0430\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0410\u043b\u0435 \u0422\u044b \u043b\u0456\u0442\u0443\u0435\u0448\u0441\u044f \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0431\u043e \u045e\u0441\u0451 \u043c\u043e\u0436\u0430\u0448 \u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435\u0448 \u043d\u0430 \u0433\u0440\u0430\u0445\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430. \u0411\u043e \u0422\u044b \u043b\u044e\u0431\u0456\u0448 \u0443\u0441\u0451, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435, \u0456 \u043d\u0456\u0447\u044b\u043c, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u043d\u0435 \u0433\u0440\u044d\u0431\u0443\u0435\u0448; \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435\u0448\u0442\u0430 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e, \u0422\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0431 \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e. \u042f\u043a \u0431\u044b \u043c\u0430\u0433\u043b\u043e \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0448\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e? \u0426\u0456 \u044f\u043a \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u0430 \u0422\u0430\u0431\u043e\u044e? \u0422\u044b \u045e\u0441\u0451 \u0448\u043a\u0430\u0434\u0443\u0435\u0448, \u0431\u043e \u044f\u043d\u043e \u0422\u0432\u0430\u0451, \u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u044f\u043a\u0456 \u043b\u044e\u0431\u0456\u0448 \u0436\u044b\u0446\u0446\u0451. \u041d\u044f\u0442\u043b\u0435\u043d\u043d\u044b \u0434\u0443\u0445 \u0422\u0432\u043e\u0439 \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u043c. \u0422\u0430\u043c\u0443 \u0422\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u043a\u0430\u0440\u0430\u0435\u0448 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u0430\u0435, \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u0448 \u0456\u043c, \u0443 \u0447\u044b\u043c \u044f\u043d\u044b \u0433\u0440\u0430\u0448\u0430\u0446\u044c, \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0435\u0448, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0437\u043b\u043e \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043d\u0435 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u043a\u0456\u043c\u0441\u044c\u0446\u0456 \u0422\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0456\u0445 \u0433\u0440\u0430\u0445\u0456 \u0431\u0435\u0437 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f. \u0425\u0442\u043e \u0436 \u0441\u043a\u0430\u0436\u0430: \u00ab\u0428\u0442\u043e \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e?\u00bb, \u0446\u0456 \u0445\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0443\u0434\u0430, \u0445\u0442\u043e \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u043e\u0435 \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e, \u0446\u0456 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0422\u0430\u0431\u0435, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u044f\u043a \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439? \u0411\u043e \u0430\u043f\u0440\u043e\u0447 \u0426\u044f\u0431\u0435 \u043d\u044f\u043c\u0430 \u0411\u043e\u0433\u0430. \u0422\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0441\u0451, \u0442\u0430\u043c\u0443 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u043d\u0430, \u0448\u0442\u043e \u0422\u044b \u0441\u0443\u0434\u0437\u0456\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u041d\u0456 \u043a\u0430\u0440\u043e\u043b\u044c, \u043d\u0456 \u045e\u043b\u0430\u0434\u0430\u0440 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u043f\u0430\u0441\u043f\u0440\u0430\u0447\u0430\u0446\u0446\u0430 \u0437 \u0422\u0430\u0431\u043e\u044e \u0437\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0422\u044b \u043f\u0430\u043a\u0430\u0440\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0443\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u0422\u044b \u045e\u0441\u0456\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043a\u0456\u0440\u0443\u0435\u0448, \u043b\u0456\u0447\u044b\u0448 \u043d\u0435\u045e\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u043c \u0422\u0432\u0430\u0451\u0439 \u0441\u0456\u043b\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c \u043d\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0433\u0430. \u0422\u0432\u0430\u044f \u043c\u043e\u0446 \u2013 \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0422\u0432\u0430\u0451 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0440\u043e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u044b\u043c. \u0422\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0432\u0435\u0440\u0430\u0446\u044c \u0443 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b, \u0456 \u0432\u044b\u043a\u0440\u044b\u0432\u0430\u0435\u0448 \u0434\u0437\u0451\u0440\u0437\u043a\u0430\u0441\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0435 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0435. \u0422\u044b \u0436, \u0443\u043b\u0430\u0434\u0430\u0440 \u043c\u043e\u0446\u044b, \u0443 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0441\u0443\u0434\u0437\u0456\u0448 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430 \u043a\u0456\u0440\u0443\u0435\u0448 \u043d\u0430\u043c\u0456, \u0431\u043e \u0422\u044b \u043c\u043e\u0436\u0430\u0448 \u0443\u0441\u0451, \u0448\u0442\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u0435\u0448. \u0422\u0430\u043a\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0422\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043b\u044e\u0431\u0456\u0446\u044c \u0456\u043d\u0448\u044b\u0445, \u0456 \u0434\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044b\u043d\u0430\u043c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u043f\u0430\u0441\u043b\u044f \u0433\u0440\u0430\u0445\u043e\u045e.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041c\u0434\u0440 11, 23. 24. 28; \u0421\u0456\u0440 36, 1<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u0435, \u0422\u044b \u043b\u044e\u0431\u0456\u0448 \u0443\u0441\u0451, \u0456 \u043d\u0456\u0447\u044b\u043c, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u043d\u0435 \u0433\u0440\u044d\u0431\u0443\u0435\u0448, \u0422\u044b \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0435\u0448 \u0433\u0440\u0430\u0445\u0456 \u043b\u044e\u0434\u0437\u044f\u043c, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043a\u0430\u044e\u0446\u0446\u0430, \u0456 \u0434\u0430\u0440\u0443\u0435\u0448 \u0456\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043e \u041f\u0430\u043d\u0435, \u044f\u043a\u0456 \u043b\u044e\u0431\u0456\u0448 \u0436\u044b\u0446\u0446\u0451.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043d\u0430\u0441; \u043f\u0430\u043a\u0430\u0436\u044b \u043d\u0430\u043c \u0441\u0432\u044f\u0442\u043b\u043e \u0422\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041e \u041f\u0430\u043d\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"311","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0435\u0440\u0448\u0430\u0439 \u043a\u043d\u0456\u0433\u0456 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">1, 1-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u0456 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0433\u0440\u044d\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0410\u043b\u044f\u043a\u0441\u0430\u043d\u0434\u0440, \u0441\u044b\u043d \u0424\u0456\u043b\u0456\u043f\u0430 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0441\u043a\u0430\u0433\u0430, \u044f\u043a\u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u041a\u0456\u0446\u0456\u043c \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0414\u0430\u0440\u044b\u044f, \u043a\u0430\u0440\u0430\u043b\u044f \u043f\u0435\u0440\u0441\u0430\u045e \u0456 \u043c\u0456\u0434\u044b\u0439\u0446\u0430\u045e, \u0456 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0437\u0430\u043c\u0435\u0441\u0442 \u044f\u0433\u043e \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0430\u0434 \u0413\u0440\u044d\u0446\u044b\u044f\u0439, \u0451\u043d \u043f\u0440\u0430\u0432\u0451\u045e \u0448\u043c\u0430\u0442 \u0432\u043e\u0439\u043d\u0430\u045e, \u0437\u0434\u0430\u0431\u044b\u045e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456 \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0437\u044f\u043c\u043b\u0456. \u0401\u043d \u0434\u0430\u0439\u0448\u043e\u045e \u0430\u0436 \u0434\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456 \u0456 \u0430\u0431\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b. \u0417\u044f\u043c\u043b\u044f \u0441\u0446\u0456\u0445\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c. \u0401\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f, \u0456 \u0437\u0430\u0433\u0430\u043d\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u0401\u043d \u0441\u0430\u0431\u0440\u0430\u045e \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u0432\u0456\u045e \u043a\u0440\u0430\u0456\u043d\u0430\u043c\u0456, \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0456 \u045e\u043b\u0430\u0434\u0430\u0440\u0430\u043c\u0456. \u042f\u043d\u044b \u0441\u043f\u043b\u0430\u0447\u0432\u0430\u043b\u0456 \u044f\u043c\u0443 \u0434\u0430\u043d\u0456\u043d\u0443. \u0410\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0451\u043d \u0437\u043b\u0451\u0433 \u0456 \u0430\u0434\u0447\u0443\u045e, \u0448\u0442\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u0435. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u044f\u043a\u0456\u044f \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0437 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u043f\u0430\u043c\u0456\u0436 \u0456\u043c\u0456 \u0441\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u044f\u0448\u0447\u044d \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456. \u0410\u043b\u044f\u043a\u0441\u0430\u043d\u0434\u0440 \u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u0456 \u043f\u0430\u043c\u0451\u0440. \u0406 \u043f\u0430\u0447\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u0443\u0433\u0456, \u043a\u043e\u0436\u043d\u044b \u045e \u0441\u0432\u0430\u0456\u043c \u043c\u0435\u0441\u0446\u044b. \u041f\u0430\u0441\u043b\u044f \u044f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456 \u044f\u043d\u044b \u045e\u0441\u0435 \u045e\u0441\u043a\u043b\u0430\u043b\u0456 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0434\u044b\u044f\u0434\u044d\u043c\u044b, \u0430 \u0456\u0445\u043d\u0456\u044f \u0441\u044b\u043d\u044b \u043f\u0430\u0441\u043b\u044f \u0456\u0445 \u043d\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0433\u0430\u0434\u044b, \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0456 \u0437\u043b\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0412\u044b\u0439\u0448\u0430\u045e \u0437 \u0456\u0445 \u043a\u043e\u0440\u0430\u043d\u044c \u0433\u0440\u0430\u0445\u0443 \u2013 \u0410\u043d\u0442\u044b\u0451\u0445 \u042d\u043f\u0456\u0444\u0430\u043d, \u0441\u044b\u043d \u043a\u0430\u0440\u0430\u043b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0437\u0430\u043b\u043e\u0436\u043d\u0456\u043a\u0430\u043c \u0443 \u0420\u044b\u043c\u0435, \u0456 \u043f\u0430\u0447\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u0442\u043e \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0441\u0451\u043c\u044b\u043c \u0433\u043e\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u0440\u044d\u043a\u0430\u045e. \u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u044f \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u0441\u044b\u043d\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u044f \u0456 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u043c\u043d\u043e\u0433\u0456\u0445, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041f\u043e\u0439\u0434\u0437\u0435\u043c \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u0430\u043a\u043e\u043b \u043d\u0430\u0441, \u0431\u043e \u0430\u0434 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a \u043c\u044b \u0430\u0434\u0434\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u0456\u0445, \u0441\u043f\u0430\u0442\u043a\u0430\u043b\u0430 \u043d\u0430\u0441 \u0448\u043c\u0430\u0442 \u0437\u043b\u0430\u00bb. \u041c\u043d\u043e\u0433\u0456\u043c \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430\u044f \u043f\u0440\u0430\u043f\u0430\u043d\u043e\u0432\u0430. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0456 \u0451\u043d \u0434\u0430\u045e \u0456\u043c \u0443\u043b\u0430\u0434\u0443 \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0432\u044b\u0447\u0430\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. \u042f\u043d\u044b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0433\u0456\u043c\u043d\u0430\u0441\u0456\u0439 \u043f\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u0446\u043a\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043b\u0430\u0445, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435\u043c, \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u043f\u0440\u0430\u0434\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u041a\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0410\u043d\u0442\u044b\u0451\u0445\u0430 \u0431\u044b\u043b\u043e \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430, \u0451\u043d \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u0439 \u0415\u0433\u0456\u043f\u0442\u0430, \u043a\u0430\u0431 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u0434\u0432\u0443\u043c\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0433\u0456\u043f\u0435\u0442 \u0437 \u0432\u044f\u043b\u0456\u0437\u043d\u044b\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u043c\u0456 \u0456 \u0441\u043b\u0430\u043d\u0430\u043c\u0456, \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0444\u043b\u043e\u0442\u0430\u043c. \u0401\u043d \u0432\u0430\u044f\u0432\u0430\u045e \u0437 \u041f\u0442\u0430\u043b\u0430\u043c\u0435\u0435\u043c, \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0415\u0433\u0456\u043f\u0442\u0430. \u041f\u0442\u0430\u043b\u0430\u043c\u0435\u0439, \u0432\u044b\u043c\u0443\u0448\u0430\u043d\u044b \u0431\u044b\u045e \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u044c. \u041f\u0430\u043b\u0430 \u0448\u043c\u0430\u0442 \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b\u0445. \u0423 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0451\u043d \u0437\u0434\u0430\u0431\u044b\u045e \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b \u0456 \u0430\u0431\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e \u0415\u0433\u0456\u043f\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u041a\u0430\u043b\u0456 \u0410\u043d\u0442\u044b\u0451\u0445 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u0445\u043e\u043f\u0443 \u0415\u0433\u0456\u043f\u0442\u0430 \u045e \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0442\u0440\u044d\u0446\u0456\u043c \u0433\u043e\u0434\u0437\u0435, \u0451\u043d \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0437 \u0432\u044f\u043b\u0456\u0437\u043d\u044b\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u041d\u0430\u0445\u0430\u0431\u043d\u0430 \u045e\u0432\u0430\u0440\u0432\u0430\u045e\u0441\u044f \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0437\u0430\u0431\u0440\u0430\u045e \u0437\u0430\u043b\u0430\u0442\u044b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a, \u0441\u0432\u0435\u0447\u043d\u0456\u043a \u0456 \u045e\u0441\u0451 \u044f\u0433\u043e \u0430\u0431\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0435, \u0441\u0442\u043e\u043b \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u0445 \u0445\u043b\u044f\u0431\u043e\u045e, \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u044f \u043a\u0443\u0431\u043a\u0456, \u0447\u0430\u0448\u044b, \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u044b, \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u0432\u044f\u043d\u043a\u0456 \u0456 \u0437\u0430\u043b\u0430\u0442\u043e\u0435 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u0435 \u0444\u0430\u0441\u0430\u0434\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0456 \u045e\u0441\u0451 \u0430\u0431\u0430\u0431\u0440\u0430\u045e. \u0417\u0430\u0431\u0440\u0430\u045e \u0441\u0440\u044d\u0431\u0440\u0430, \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e. \u0417\u0430\u0431\u0440\u0430\u045e\u0448\u044b \u045e\u0441\u0451, \u0443\u0447\u044b\u043d\u0456\u045e \u0440\u0430\u0437\u043d\u044e \u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u044b\u0445\u0430\u044e, \u0430 \u0437\u0430\u0442\u044b\u043c \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0441\u0432\u0430\u044e \u0437\u044f\u043c\u043b\u044e.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u041c\u0430\u043a 7, 33; \u0413\u0431\u0440 12, 11<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0436\u044b\u0432\u044b \u041f\u0430\u043d \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u043d\u0430\u0441 \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0401\u043d \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0430 \u0441\u043c\u0443\u0442\u043a\u0430\u043c. \u0410\u043b\u0435 \u043f\u0430\u0437\u043d\u0435\u0439 \u044f\u043d\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043c\u0456\u0440\u043d\u044b \u043f\u043b\u0451\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d \u0437\u043d\u043e\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"312","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">1, 41-64<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0413\u0430\u043d\u0435\u043d\u043d\u0435 \u0437 \u0431\u043e\u043a\u0443 \u0410\u043d\u0442\u044b\u0451\u0445\u0430<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u0440\u043e\u043b\u044c \u0410\u043d\u0442\u044b\u0451\u0445 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0443, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u0442\u0430\u043b\u0456 \u0430\u0434\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0432\u0430\u0435 \u0437\u0430\u043a\u043e\u043d\u044b. \u0423\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0433\u044d\u0442\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0437\u0430\u0433\u0430\u0434. \u041c\u043d\u043e\u0433\u0456\u044f \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456 \u044f\u0433\u043e \u0437\u0432\u044b\u0447\u0430\u0456, \u043f\u0430\u0447\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b \u0456\u0434\u0430\u043b\u0430\u043c \u0456 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0446\u044c \u0448\u0430\u0431\u0430\u0442. \u0417\u0430\u0442\u044b\u043c \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0440\u0430\u0437 \u0433\u0430\u043d\u0446\u043e\u045e \u043b\u0456\u0441\u0442\u044b \u045e \u0415\u0437\u0443\u0437\u0430\u043b\u0435\u043c \u0456 \u045e \u0433\u0430\u0440\u0430\u0434\u044b \u042e\u0434\u044b, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0447\u0443\u0436\u044b\u0445 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0437\u0432\u044b\u0447\u0430\u044f\u045e, \u043a\u0430\u0431 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0431\u044b\u043b\u0456 \u0437\u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456, \u043a\u0440\u044b\u0432\u0430\u0432\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0432\u044b\u043b\u0456\u0432\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u043b\u0456\u0441\u044f \u0448\u0430\u0431\u0430\u0442\u044b \u0456 \u0441\u0432\u044f\u0442\u044b, \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0456 \u0441\u0432\u044f\u0442\u044b\u044f, \u043a\u0430\u0431 \u0443\u0437\u043d\u043e\u0441\u0456\u043b\u0456\u0441\u044f \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0456, \u0441\u0432\u044f\u0446\u0456\u043b\u0456\u0448\u0447\u044b \u0434\u044b \u0456\u0434\u0430\u043b\u044b, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0432\u0456\u043d\u0435\u0439 \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0443\u044e \u0436\u044b\u0432\u0451\u043b\u0443, \u043a\u0430\u0431 \u043f\u0430\u043a\u0456\u0434\u0430\u043b\u0456 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0431\u0435\u0437 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u043b\u0456 \u0456\u0445 \u0434\u0443\u0448\u044b \u045e\u0441\u0456\u043c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c \u0434\u044b \u0430\u0433\u0456\u0434\u043d\u044b\u043c, \u043a\u0430\u0431 \u0437\u0430\u0431\u044b\u043b\u0456 \u0417\u0430\u043a\u043e\u043d \u0456 \u0437\u043c\u044f\u043d\u0456\u043b\u0456 \u045e\u0441\u0435 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456. \u0406 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u0433\u0430\u0434\u0443 \u043a\u0430\u0440\u0430\u043b\u044f, \u0442\u043e \u043f\u0430\u043c\u0440\u044d. \u041f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0433\u044d\u0442\u044b\u0445 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0451\u043d \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0443 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0430\u045e \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0413\u0430\u0440\u0430\u0434\u0430\u043c \u042e\u0434\u044b, \u0430\u0434\u043d\u0430\u043c\u0443 \u0437\u0430 \u0434\u0440\u0443\u0433\u0456\u043c, \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0414\u0430\u043b\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0434\u0430 \u0456\u0445 \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0417\u0430\u043a\u043e\u043d. \u0406 \u0440\u0430\u0431\u0456\u043b\u0456 \u044f\u043d\u044b \u0437\u043b\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043c\u0443 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u045e\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u045e \u0445\u043e\u0432\u0430\u043d\u043a\u0430\u0445 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u0445 \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0423 \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430 \u043a\u0456\u0441\u043b\u0435\u045e \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u043f\u044f\u0442\u0430\u0433\u0430 \u0433\u043e\u0434\u0430 \u045e\u0437\u043d\u0435\u0441\u043b\u0456 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0443 \u0430\u0433\u0456\u0434\u0443 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u044f, \u0430 \u045e \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u0430\u0445 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u0430\u043b\u0442\u0430\u0440\u044b \u0456 \u043f\u0435\u0440\u0430\u0434 \u0434\u0437\u0432\u044f\u0440\u044b\u043c\u0430 \u0434\u0430\u043c\u043e\u045e \u0456 \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u0430\u0445 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u0417\u043d\u043e\u0439\u0434\u0437\u0435\u043d\u044b\u044f \u043a\u043d\u0456\u0433\u0456 \u0417\u0430\u043a\u043e\u043d\u0443 \u0440\u0432\u0430\u043b\u0456 \u0456 \u043f\u0430\u043b\u0456\u043b\u0456, \u0430 \u045e \u043a\u0430\u0433\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0437\u0435-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043a\u043d\u0456\u0433\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0456 \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u045e \u0417\u0430\u043a\u043e\u043d, \u0442\u0430\u0433\u043e \u043f\u0430 \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u044f \u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u041c\u0435\u0441\u044f\u0446 \u0437\u0430 \u043c\u0435\u0441\u044f\u0446\u0430\u043c \u0447\u044b\u043d\u0456\u043b\u0456 \u0433\u0432\u0430\u043b\u0442 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u043d\u0430\u0434 \u043a\u043e\u0436\u043d\u044b\u043c, \u043a\u0430\u0433\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u0433\u0430\u0440\u0430\u0434\u0430\u0445. \u0423 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0443, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0430 \u043c\u0435\u0441\u0446\u044b \u0430\u043b\u0442\u0430\u0440\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u045e. \u0416\u0430\u043d\u0447\u044b\u043d, \u044f\u043a\u0456\u044f \u0430\u0431\u0440\u0430\u0437\u0430\u043b\u0456 \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u043a\u0430\u0437\u0430\u043c, \u0430 \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442 \u0432\u0435\u0448\u0430\u043b\u0456 \u0437\u0430 \u0448\u044b\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u0445\u043d\u0456\u0445 \u0445\u0430\u0442\u043d\u0456\u0445 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0440\u0430\u0437\u0430\u045e \u0456\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt;\"><span>\u0410\u043b\u0435 \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u044f\u0440\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c\u0456 \u0456 \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u044b\u0440\u0430\u0448\u044b\u043b\u0456 \u043d\u0435 \u0435\u0441\u0446\u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u0446\u0446\u0430 \u0435\u0436\u0430\u044e \u0456 \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0422\u0430\u043c\u0443 \u043f\u0430\u043c\u0435\u0440\u043b\u0456. \u0412\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043d\u0435\u045e \u0442\u0430\u0434\u044b \u0430\u0445\u0430\u043f\u0456\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0414\u0430\u043d 9, 18\u0430; \u0414\u0437 4, 29<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435 \u0456 \u043d\u0430 \u0433\u043e\u0440\u0430\u0434, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0422\u0432\u0430\u0451 \u0456\u043c\u044f. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041f\u0430\u043d\u0435, \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0448\u0443\u044e \u0434\u0443\u0448\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0426\u044f\u043f\u0435\u0440, \u041f\u0430\u043d\u0435, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0456\u0445\u043d\u0456\u044f \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u0456 \u0434\u0430\u0439 \u0441\u043b\u0443\u0433\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u0437 \u0443\u0441\u0451\u0439 \u0430\u0434\u0432\u0430\u0433\u0430\u044e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0422\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u043d\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"313","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">2, 1. 15-28. 42-50. 65-70<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u045e\u0441\u0442\u0430\u043d\u043d\u0435 \u041c\u0430\u0442\u0430\u0446\u0456\u0456 \u0456 \u044f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u041c\u0430\u0442\u0430\u0446\u0456\u044f, \u0441\u044b\u043d \u042f\u043d\u0430, \u0441\u044b\u043d\u0430 \u0421\u0456\u043c\u044f\u043e\u043d\u0430, \u0441\u0432\u044f\u0442\u0430\u0440 \u0437 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0401\u0430\u0440\u044b\u0431\u0430 \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0416\u044b\u045e \u0451\u043d \u0443 \u041c\u0430\u0434\u0437\u0456\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0433\u043e\u0440\u0430\u0434 \u041c\u0430\u0434\u0437\u0456\u043d \u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u045e \u0434\u0430 \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430, \u043a\u0430\u0431 \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435. \u0428\u043c\u0430\u0442 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0434\u0430 \u0456\u0445. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u041c\u0430\u0442\u0430\u0446\u0456\u044f \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u044b\u043d\u044b, \u0442\u0430\u0434\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u044f \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u044b \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u041c\u0430\u0442\u0430\u0446\u0456\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0423 \u0433\u044d\u0442\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0442\u044b \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u044b \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440, \u043c\u0430\u0435\u0448 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0441\u044b\u043d\u043e\u045e \u0456 \u0431\u0440\u0430\u0442\u043e\u045e. \u0426\u044f\u043f\u0435\u0440 \u043f\u0430\u0434\u044b\u0434\u0437\u0456 \u043f\u0435\u0440\u0448\u044b \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u0439 \u0437\u0430\u0433\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u043c\u0443\u0436\u044b \u042e\u0434\u044b \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0422\u0430\u0434\u044b \u0442\u044b \u0456 \u0442\u0432\u0430\u0435 \u0441\u044b\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u044f\u0431\u0440\u0430\u043c\u0456 \u043a\u0430\u0440\u0430\u043b\u044f, \u0456 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u044b\u043d\u0430\u043c\u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0441\u0440\u044d\u0431\u0440\u0430\u043c, \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u041c\u0430\u0442\u0430\u0446\u0456\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: \u00ab\u041d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u0430\u0439 \u043a\u0430\u0440\u0430\u043b\u044f, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u044e\u0446\u0446\u0430 \u044f\u0433\u043e \u0456 \u043a\u043e\u0436\u043d\u044b \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0430\u0434 \u0432\u0435\u0440\u044b \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e, \u0456 \u043f\u043e\u0439\u0434\u0437\u0435 \u0437\u0430 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043c\u0456, \u044f \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0431\u0443\u0434\u0443 \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e. \u0411\u0430\u0440\u0430\u043d\u0456 \u0411\u043e\u0436\u0430, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0417\u0430\u043a\u043e\u043d \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u041d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0437\u0430\u0433\u0430\u0434 \u0456 \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043c \u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b \u043d\u0456 \u045e\u043f\u0440\u0430\u0432\u0430, \u043d\u0456 \u045e\u043b\u0435\u0432\u0430!\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0430\u0434\u0437\u0456\u043d \u044e\u0434\u044d\u0439 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u0456\u0445 \u043f\u0430\u0434\u044b\u0448\u043e\u045e, \u043a\u0430\u0431 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u045e\u043a\u0430\u0437\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u045e \u041c\u0430\u0434\u0437\u0456\u043d\u0435. \u041a\u0430\u043b\u0456 \u041c\u0430\u0442\u0430\u0446\u0456\u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u0441\u043a\u0430\u043b\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u044f\u0433\u043e\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u0401\u043d \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0433\u043d\u0435\u0432\u0430\u043c, \u043f\u0430\u0434\u0431\u0435\u0433 \u0456 \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u043b\u044f \u0430\u043b\u0442\u0430\u0440\u0430. \u0417\u0430\u0431\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a\u0456 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443, \u0430 \u0441\u0430\u043c \u0430\u043b\u0442\u0430\u0440 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u045e. \u041d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0430\u0431 \u0417\u0430\u043a\u043e\u043d\u0435, \u044f\u043a \u041f\u0456\u043d\u0445\u0430\u0441 \u0437\u0440\u0430\u0431\u0456\u045e \u0417\u0430\u043c\u0431\u0440\u044d\u044e, \u0441\u044b\u043d\u0443 \u0421\u0430\u043b\u043e\u043c\u0430. \u0417\u0430\u0442\u044b\u043c \u041c\u0430\u0442\u0430\u0446\u0456\u044f \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435: \u00ab\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0431 \u0417\u0430\u043a\u043e\u043d\u0435 \u0456 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u043c\u043d\u043e\u044e!\u00bb \u041f\u0430\u0441\u043b\u044f \u0451\u043d \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u044b\u043d\u044b \u045e\u0446\u044f\u043a\u043b\u0456 \u045e \u0433\u043e\u0440\u044b \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u0435\u043b\u0456, \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0437\u043d\u0435\u0439 \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0434\u0430 \u0456\u0445 \u0433\u0440\u0430\u043c\u0430\u0434\u0430 \u0445\u0430\u0441\u0456\u0434\u0430\u045e, \u0434\u0443\u0436\u044b\u0445 \u0437 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e, \u0437 \u044f\u043a\u0456\u0445 \u043a\u043e\u0436\u043d\u044b \u0431\u044b\u045e \u0430\u0434\u0434\u0430\u043d\u044b \u0417\u0430\u043a\u043e\u043d\u0443. \u0423\u0441\u0435, \u0445\u0442\u043e \u045e\u0446\u044f\u043a\u0430\u045e \u0430\u0434 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e, \u0434\u0430\u043b\u0443\u0447\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0456\u0445 \u0456 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0434\u043b\u044f \u0456\u0445 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430\u044e. \u042f\u043d\u044b \u045e\u0442\u0432\u0430\u0440\u044b\u043b\u0456 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0433\u043d\u0435\u0432\u0435 \u043d\u0430\u043f\u0430\u0434\u0430\u043b\u0456 \u043d\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u043d\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u0446\u0430, \u043f\u0430\u045e\u0446\u044f\u043a\u0430\u043b\u0456 \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0430\u0442\u0430\u0446\u0456\u044f \u0456 \u044f\u0433\u043e \u0441\u044f\u0431\u0440\u044b \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u043f\u0430 \u0432\u0430\u043a\u043e\u043b\u0456\u0446\u0430\u0445 \u0456 \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043b\u0456 \u0430\u043b\u0442\u0430\u0440\u044b. \u0421\u0456\u043b\u0430\u0439 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 \u0445\u043b\u043e\u043f\u0447\u044b\u043a\u0430\u045e, \u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u043c\u0435\u0436\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u044b\u043d\u043e\u045e \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u044b\u0445, \u0430 \u0441\u043f\u0440\u0430\u0432\u0430 \u0456\u0445 \u043c\u0435\u043b\u0430 \u043f\u043e\u0441\u043f\u0435\u0445. \u042f\u043d\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0456 \u0417\u0430\u043a\u043e\u043d \u0430\u0434 \u0440\u0443\u043a \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0456 \u043d\u0435 \u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0456\u0441\u044f \u0434\u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u041c\u0430\u0442\u0430\u0446\u0456\u0456, \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044b\u043d\u0430\u043c: \u00ab\u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0431\u0440\u0430\u043b\u0430 \u043c\u043e\u0446 \u043f\u044b\u0445\u0430 \u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435. \u041d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0456 \u043b\u044e\u0442\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443. \u0426\u044f\u043f\u0435\u0440, \u0434\u0437\u0435\u0446\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0440\u0443\u043f\u043b\u0456\u045e\u0446\u0430\u043c\u0456 \u0417\u0430\u043a\u043e\u043d\u0443 \u0456 \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0437\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0421\u0456\u043c\u044f\u043e\u043d, \u0432\u0430\u0448 \u0431\u0440\u0430\u0442. \u042f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0451\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b, \u044f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0430\u0439\u0446\u043e\u043c. \u042e\u0434\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u0439, \u0434\u0443\u0436\u044b \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0432\u0430\u0448\u0430\u0433\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456. \u0410 \u0432\u044b \u0437\u0431\u044f\u0440\u044b\u0446\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0417\u0430\u043a\u043e\u043d, \u0456 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u0435 \u0437\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434. \u0410\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c \u0456 \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0417\u0430\u043a\u043e\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u0456\u0445 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u0456 \u0431\u044b\u045e \u0434\u0430\u043b\u0443\u0447\u0430\u043d\u044b \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e. \u041f\u0430\u043c\u0451\u0440 \u0451\u043d \u0443 \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0448\u043e\u0441\u0442\u044b\u043c \u0433\u043e\u0434\u0437\u0435, \u0456 \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0443 \u041c\u0430\u0434\u0437\u0456\u043d\u0435, \u0430 \u045e\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u045e \u044f\u0433\u043e \u0441\u0430 \u0441\u043a\u0440\u0443\u0445\u0430\u044e.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041c\u0430\u043a 2, 51. 64<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0430\u0439\u0446\u043e\u045e, \u044f\u043a\u0456\u044f \u044f\u043d\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0456 \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0456\u043c\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u0437\u0435\u0446\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0443\u0436\u043d\u044b\u043c\u0456 \u0456 \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u045e \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u0417\u0430\u043a\u043e\u043d\u0443, \u0431\u043e \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0441\u043b\u0430\u0432\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"314","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">3, 1-26<\/span><\/p>\r\n<p><span style=\"color: #ff0000; font-style: italic;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000; font-style: italic;\">\u042e\u0434\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u0439<\/span><span style=\"color: #ff0000; font-style: italic;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0417\u0430\u043c\u044f\u043d\u0456\u045e \u044f\u0433\u043e \u042e\u0434\u0430, \u044f\u043a\u0456 \u0437\u0432\u0430\u045e\u0441\u044f \u041c\u0430\u043a\u0430\u0431\u044d\u0439, \u0441\u044b\u043d \u044f\u0433\u043e\u043d\u044b. \u0414\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0456 \u044f\u043c\u0443 \u045e\u0441\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0434\u0430\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0430\u0439\u0446\u0430. \u042f\u043d\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0432\u044f\u043b\u0456 \u0432\u0430\u0439\u043d\u0443 \u0437\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u0406 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0451\u043d \u0445\u0432\u0430\u043b\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043f\u0430\u043d\u0446\u044b\u0440 \u044f\u043a \u0432\u043e\u043b\u0430\u0442, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0440\u043e\u044f\u0439 \u0456 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0447\u044b \u043c\u044f\u0447\u043e\u043c \u0441\u0442\u0430\u043d. \u0421\u0432\u0430\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0451\u043d \u0431\u044b\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043b\u044c\u0432\u0430, \u0456 \u0431\u044b\u045e \u044f\u043a \u043c\u0430\u043b\u0430\u0434\u044b \u043b\u0435\u045e, \u0448\u0442\u043e \u0440\u044b\u043a\u0430\u0435 \u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0447\u0443. \u0401\u043d \u0430\u0434\u0441\u043e\u0447\u0432\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e, \u0430 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0441\u0435\u044f\u043b\u0456 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u045e. \u041a\u0443\u0440\u0447\u044b\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f, \u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0442\u0440\u044b\u0432\u043e\u0433\u0430, \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0440\u0443\u043a\u0443 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435. \u0401\u043d \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0430 \u042f\u043a\u0443\u0431\u0430 \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u0456 \u043d\u0430\u0432\u0435\u043a\u0456 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439. \u0401\u043d \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043f\u0430 \u0433\u0430\u0440\u0430\u0434\u0430\u0445 \u042e\u0434\u044b, \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0443 \u0456\u0445 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0456 \u0430\u0434\u0445\u0456\u043b\u0456\u045e \u0433\u043d\u0435\u045e \u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f\u0433\u043e \u0456\u043c\u044f \u0441\u0442\u0430\u043b\u0430 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u0430\u0436 \u0434\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456, \u0456 \u0441\u0430\u0431\u0440\u0430\u045e \u0451\u043d \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u043e\u0433 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0410\u043f\u0430\u043b\u043e\u043d\u0456\u0439 \u0441\u0430\u0431\u0440\u0430\u045e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0437 \u0421\u0430\u043c\u0430\u0440\u044b\u0456, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041a\u0430\u043b\u0456 \u042e\u0434\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0432\u044b\u0439\u0448\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447, \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u044f\u0433\u043e \u0456 \u0437\u0430\u0431\u0456\u045e. \u0428\u043c\u0430\u0442 \u043f\u0430\u043b\u0435\u0433\u043b\u0430 \u0437\u0430\u0431\u0456\u0442\u044b\u0445, \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u043f\u0430\u045e\u0446\u044f\u043a\u0430\u043b\u0456. \u042f\u043d\u044b \u0437\u0430\u0431\u0440\u0430\u043b\u0456 \u0456\u0445\u043d\u044e\u044e \u0437\u0434\u0430\u0431\u044b\u0447\u0443, \u0430 \u042e\u0434\u0430 \u0437\u0430\u0431\u0440\u0430\u045e \u043c\u0435\u0447 \u0410\u043f\u0430\u043b\u043e\u043d\u0456\u044f \u0456 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0432\u0430\u044f\u0432\u0430\u045e \u0456\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u044d\u0440\u043e\u043d, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0441\u0456\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430 \u0432\u043e\u0439\u0441\u043a\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u045e, \u0448\u0442\u043e \u042e\u0434\u0430 \u0441\u0430\u0431\u0440\u0430\u045e \u043a\u0430\u043b\u044f \u0441\u044f\u0431\u0435 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0443 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u043d\u0430 \u0432\u0430\u0439\u043d\u0443, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0423\u0441\u043b\u0430\u045e\u043b\u044e \u0441\u0432\u0430\u0451 \u0456\u043c\u044f \u0456 \u0441\u0442\u0430\u043d\u0443 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u2013 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0443 \u042e\u0434\u0443 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437 \u0456\u043c, \u044f\u043a\u0456\u044f \u0433\u0440\u044d\u0431\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u044f. \u0406 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0451\u043d, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u043f\u0430\u0439\u0448\u043b\u043e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u043a\u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u044f\u043c\u0443 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u0434\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u045e\u0437\u0432\u044b\u0448\u0448\u0430 \u0411\u044d\u0442-\u0425\u0430\u0440\u043e\u043d, \u0430 \u042e\u0434\u0430 \u0437 \u043a\u0443\u043f\u043a\u0430\u0439 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u044b\u0439\u0448\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447. \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u043e\u0439\u0441\u043a\u0430, \u044f\u043a\u043e\u0435 \u0456\u0448\u043b\u043e \u0456\u043c \u043d\u0430\u0441\u0443\u0441\u0442\u0430\u0447, \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u042e\u0434\u0437\u0435: \u00ab\u042f\u043a \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044e, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441 \u0442\u0430\u043a \u043c\u0430\u043b\u0430 \u0456 \u043c\u044b \u0441\u043b\u0430\u0431\u044b\u044f, \u0431\u043e \u043d\u0435 \u0435\u043b\u0456 \u0441\u0451\u043d\u043d\u044f?\u00bb \u0410\u043b\u0435 \u042e\u0434\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0417 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u043c\u0430\u043b\u0430\u044f \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u043c\u043e\u0436\u0430 \u0437\u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0443\u044e. \u0414\u043b\u044f \u043d\u0435\u0431\u0430 \u043d\u044f\u043c\u0430 \u0440\u043e\u0437\u043d\u0456\u0446\u044b, \u0446\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u0446\u0456 \u043c\u0430\u043b\u0430\u043b\u0456\u043a\u0456\u043c, \u0431\u043e \u043d\u0435 \u045e \u043c\u043d\u043e\u0441\u0442\u0432\u0435 \u0441\u0456\u043b\u044b \u0432\u0430\u0435\u043d\u043d\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430, \u0430\u043b\u0435 \u045e \u043c\u043e\u0446\u044b \u0437 \u043d\u0435\u0431\u0430. \u042f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u043f\u043e\u045e\u043d\u044b\u044f \u043f\u044b\u0445\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u043d\u0430\u0448\u044b\u0445 \u0436\u043e\u043d\u0430\u043a \u0456 \u0434\u0437\u044f\u0446\u0435\u0439, \u043a\u0430\u0431 \u0430\u0431\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0441. \u041c\u044b \u0436 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0456 \u0437\u0432\u044b\u0447\u0430\u0456. \u0401\u043d \u0441\u0430\u043c \u0440\u0430\u0437\u0430\u0431\u2019\u0435 \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456, \u0432\u044b \u0436 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456\u0445\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u043a\u0456\u043d\u0443\u045e\u0441\u044f \u043d\u0430 \u0456\u0445 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430 \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0421\u044d\u0440\u043e\u043d\u0430 \u0456 \u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456. \u042f\u043d\u044b \u0433\u043d\u0430\u043b\u0456 \u044f\u0433\u043e \u043f\u0430 \u0441\u0445\u0456\u043b\u0435 \u0411\u044d\u0442-\u0425\u0430\u0440\u043e\u043d \u0430\u0436 \u0434\u0430 \u0440\u0430\u045e\u043d\u0456\u043d\u044b. \u041f\u0430\u043b\u0435\u0433\u043b\u0430 \u0437 \u0456\u0445 \u043a\u0430\u043b\u044f \u0432\u0430\u0441\u044c\u043c\u0456\u0441\u043e\u0442 \u043c\u0443\u0436\u0447\u044b\u043d, \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u045e\u0446\u044f\u043a\u043b\u0456 \u045e \u0437\u044f\u043c\u043b\u044e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e. \u0421\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u042e\u0434\u0430\u0439 \u0456 \u044f\u0433\u043e \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0456 \u0436\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b. \u0410\u0436 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0434\u0430\u0439\u0448\u043b\u0430 \u0441\u043b\u0430\u0432\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456\u043c\u044f, \u0430 \u043f\u0440\u0430 \u0431\u0456\u0442\u0432\u044b \u042e\u0434\u044b \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u044b.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041c\u0430\u043a 3, 20\u0430. 22b. 19. 21-22\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u043f\u043e\u045e\u043d\u044b\u044f \u043f\u044b\u0445\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0432\u044b \u0436 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456\u0445,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0431\u043e \u043d\u0435 \u045e \u043c\u043d\u043e\u0441\u0442\u0432\u0435 \u0441\u0456\u043b\u044b \u0432\u0430\u0435\u043d\u043d\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430, \u0430\u043b\u0435 \u045e \u043c\u043e\u0446\u044b \u0437 \u043d\u0435\u0431\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u0436 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0456 \u0437\u0432\u044b\u0447\u0430\u0456. \u041f\u0430\u043d \u0441\u0430\u043c \u0440\u0430\u0437\u0430\u0431\u2019\u0435 \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043d\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"315","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">4, 36-59<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435 \u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u042e\u0434\u0430 \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0412\u043e\u0441\u044c \u0440\u0430\u0437\u0431\u0456\u0442\u044b \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0440\u0430\u0433\u0456, \u043f\u043e\u0439\u0434\u0437\u0435\u043c, \u043a\u0430\u0431 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u043d\u044e\u00bb. \u0421\u0430\u0431\u0440\u0430\u043b\u0430\u0441\u044f \u0446\u044d\u043b\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430, \u0456 \u045e\u0437\u044b\u0448\u043b\u0456 \u044f\u043d\u044b \u043d\u0430 \u0433\u0430\u0440\u0443 \u0421\u0456\u0451\u043d. \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u044b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u0456 \u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0431\u0440\u0430\u043c\u044b, \u0430 \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u0430\u0445 \u043a\u0443\u0441\u0442\u043e\u045e\u0435, \u0448\u0442\u043e \u0440\u0430\u0437\u0440\u0430\u0441\u043b\u043e\u0441\u044f \u043d\u0456\u0431\u044b \u045e \u043b\u0435\u0441\u0435 \u0446\u0456 \u043d\u0430 \u0430\u0434\u043d\u043e\u0439 \u0437 \u0433\u043e\u0440, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b\u044f \u043f\u0430\u043a\u043e\u0456, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0448\u0430\u0442\u044b, \u043c\u043e\u0446\u043d\u0430 \u0431\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u045e \u0433\u0440\u0443\u0434\u0437\u0456 \u0456 \u043f\u0430\u0441\u044b\u043f\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u043f\u043e\u043f\u0435\u043b\u0430\u043c. \u0423\u043f\u0430\u043b\u0456 \u043d\u0456\u0446\u043c\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0441\u0456\u0433\u043d\u0430\u043b\u044c\u043d\u044b\u044f \u0442\u0440\u0443\u0431\u044b \u0434\u044b \u0433\u0430\u043b\u0430\u0441\u0456\u043b\u0456 \u0434\u0430 \u043d\u0435\u0431\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u042e\u0434\u0430 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u0443\u0436\u0447\u044b\u043d\u0430\u043c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0431\u044b\u045e \u0443 \u0446\u044b\u0442\u0430\u0434\u044d\u043b\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f. \u041f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u0430\u0434\u0434\u0430\u043d\u044b\u0445 \u0417\u0430\u043a\u043e\u043d\u0443. \u042f\u043d\u044b \u0430\u0447\u044b\u0441\u0446\u0456\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0456 \u0432\u044b\u043d\u0435\u0441\u043b\u0456 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0430\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u0435 \u045e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430. \u0420\u0430\u0456\u043b\u0456\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u043a\u043e\u043d\u0442 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0430\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f, \u0448\u0442\u043e \u0437 \u0456\u043c \u0437\u0440\u0430\u0431\u0456\u0446\u044c. \u0406 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0434\u043e\u0431\u0440\u0430\u0435 \u0432\u044b\u0440\u0430\u0448\u044d\u043d\u043d\u0435: \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u0446\u044c \u044f\u0433\u043e, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0456\u0445 \u0433\u0430\u043d\u044c\u0431\u0430\u044e, \u0431\u043e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u043b\u0456 \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u043b\u0456 \u0430\u043b\u0442\u0430\u0440, \u0430 \u043a\u0430\u043c\u044f\u043d\u0456 \u0441\u043a\u043b\u0430\u043b\u0456 \u043d\u0430 \u0433\u0430\u0440\u044b \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0440\u043e\u043a \u0456 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u0456\u043c\u0456. \u0417\u0430\u0442\u044b\u043c \u0443\u0437\u044f\u043b\u0456 \u043d\u0435\u0430\u0431\u0447\u0430\u0441\u0430\u043d\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0417\u0430\u043a\u043e\u043d\u0430\u043c, \u0456 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u043d\u043e\u0432\u044b \u0430\u043b\u0442\u0430\u0440 \u043d\u0430 \u045e\u0437\u043e\u0440 \u043f\u0435\u0440\u0448\u0430\u0433\u0430. \u0410\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u043d\u0443\u0442\u0440\u044b \u0434\u043e\u043c\u0430, \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u043b\u0456 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b. \u0417\u0440\u0430\u0431\u0456\u043b\u0456 \u043d\u043e\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u0456 \u045e\u043d\u0435\u0441\u043b\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0441\u0432\u0435\u0447\u043d\u0456\u043a, \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u044b \u0430\u043b\u0442\u0430\u0440 \u0456 \u0441\u0442\u043e\u043b. \u041f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u0456 \u0437\u0430\u043f\u0430\u043b\u0456\u043b\u0456 \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u0456 \u044f\u043d\u044b \u0437\u0430\u0437\u0437\u044f\u043b\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u041d\u0430 \u0441\u0442\u043e\u043b \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u0445\u043b\u044f\u0431\u044b \u0456 \u043f\u0430\u0432\u0435\u0441\u0456\u043b\u0456 \u0437\u0430\u0441\u043b\u043e\u043d\u0443. \u0422\u0430\u043a \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0456 \u045e\u0441\u0435 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0442\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043c\u0435\u0441\u044f\u0446\u0430 \u043a\u0456\u0441\u043b\u0435\u045e, \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0432\u043e\u0441\u044c\u043c\u0430\u0433\u0430 \u0433\u043e\u0434\u0430 \u045e\u0441\u0442\u0430\u043b\u0456 \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430 \u043d\u043e\u0432\u044b\u043c \u0430\u043b\u0442\u0430\u0440\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u044f\u043a\u0456 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456. \u0410\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0430\u043b\u0442\u0430\u0440\u0430 \u043f\u0430\u0434 \u0441\u043f\u0435\u0432\u044b \u0456 \u0433\u0440\u0430\u043d\u043d\u0435 \u043b\u0456\u0440, \u0446\u044b\u0442\u0440\u0430\u045e \u0456 \u0446\u044b\u043c\u0431\u0430\u043b\u0430\u045e \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u0437\u043d\u044f\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u044f\u0433\u043e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0443\u043f\u0430\u045e \u043d\u0456\u0446\u043c\u0430, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u045e \u0434\u0430 \u043d\u0435\u0431\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0441\u043f\u0440\u044b\u044f\u045e \u0456\u043c. \u0412\u043e\u0441\u0435\u043c \u0434\u0437\u0451\u043d \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043b\u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0430\u043b\u0442\u0430\u0440\u0430 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0456. \u0424\u0430\u0441\u0430\u0434 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043b\u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u043c\u0456 \u0432\u044f\u043d\u043a\u0430\u043c\u0456 \u0456 \u043c\u0430\u043b\u044b\u043c\u0456 \u0448\u0447\u044b\u0442\u0430\u043c\u0456, \u0430\u0434\u043d\u0430\u0432\u0456\u043b\u0456 \u0431\u0440\u0430\u043c\u044b \u0456 \u043f\u0430\u043a\u043e\u0456, \u043f\u0430\u045e\u0441\u0442\u0430\u045e\u043b\u044f\u043b\u0456 \u045e \u0456\u0445 \u0434\u0437\u0432\u0435\u0440\u044b. \u0412\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435, \u0431\u043e \u043f\u0440\u044b\u0431\u0440\u0430\u043d\u0430\u044f \u0431\u044b\u043b\u0430 \u0430\u0433\u0456\u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. \u0422\u0430\u0434\u044b \u042e\u0434\u0430, \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b \u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0445\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456, \u0448\u0442\u043e \u0434\u043d\u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u0448\u0442\u043e\u0433\u043e\u0434, \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0432\u0430\u0441\u044c\u043c\u0456 \u0434\u0437\u0451\u043d, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0437 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u044f\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u043c\u0435\u0441\u044f\u0446\u0430 \u043a\u0456\u0441\u043b\u0435\u045e.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041c\u0430\u043a 4, 57\u0430. 56\u0430. 58\u0430; 2 \u041c\u0430\u043a 10, 38\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0424\u0430\u0441\u0430\u0434 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043b\u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u043c\u0456 \u0432\u044f\u043d\u043a\u0430\u043c\u0456<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u043b\u0456 \u0430\u043b\u0442\u0430\u0440. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0413\u0456\u043c\u043d\u0430\u043c\u0456 \u0456 \u043f\u0435\u0441\u043d\u044f\u043c\u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u041f\u0430\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0441\u0442\u0430\u043b\u0430\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"316","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">12, 32-46<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0445\u0432\u044f\u0440\u0430 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u043a \u0437\u0432\u0430\u043d\u0430\u0439 \u041f\u044f\u0446\u0456\u0434\u0437\u044f\u0441\u044f\u0442\u043d\u0456\u0446\u044b \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0413\u043e\u0440\u0433\u0456\u0456, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u0406\u0434\u0443\u043c\u0435\u0456. \u0410 \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u045e \u042e\u0434\u0430 \u0437 \u0442\u0440\u044b\u043c\u0430 \u0442\u044b\u0441\u044f\u0447\u0430\u043c\u0456 \u043f\u0435\u0448\u044b\u0445 \u0456 \u0437 \u0447\u0430\u0442\u044b\u0440\u043c\u0430 \u0441\u043e\u0442\u043d\u044f\u043c\u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e. \u0417 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0431\u0456\u0442\u0432\u044b \u043f\u0430\u043b\u0435\u0433\u043b\u0430 \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u044e\u0434\u044d\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u0414\u0430\u0437\u0456\u0442\u044d\u0439, \u0430\u0434\u0437\u0456\u043d \u0437 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u0411\u0430\u043a\u0435\u043d\u043e\u0440\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0446\u043d\u044b, \u0441\u0445\u0430\u043f\u0456\u045e \u0413\u043e\u0440\u0433\u0456\u044e \u0456, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0437\u0430 \u043f\u043b\u0430\u0448\u0447, \u0446\u044f\u0433\u043d\u0443\u045e \u044f\u0433\u043e \u043c\u043e\u0446\u043d\u0430, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u045e\u0437\u044f\u0446\u044c \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0430 \u0436\u044b\u0432\u044b\u043c. \u0410\u043b\u0435 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0442\u0440\u0430\u043a\u0456\u0439\u0441\u043a\u0456\u0445 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u043d\u0430\u043b\u044f\u0446\u0435\u045e \u043d\u0430 \u044f\u0433\u043e \u0456 \u0430\u0434\u0441\u0435\u043a \u043f\u043b\u044f\u0447\u043e. \u0422\u0430\u043a \u0413\u043e\u0440\u0433\u0456\u044f \u045e\u0446\u0451\u043a \u0443 \u041c\u0430\u0440\u044b\u0441\u0443. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u042d\u0437\u0434\u0440\u044b\u043d\u0430\u043c, \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0434\u043e\u045e\u0433\u0430 \u0456 \u0431\u044b\u043b\u0456 \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u044b\u044f, \u042e\u0434\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0401\u043d \u0441\u0442\u0430\u045e \u0441\u0430\u044e\u0437\u043d\u0456\u043a\u0430\u043c \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0431\u0456\u0442\u0432\u044b. \u0420\u0430\u0441\u043f\u0430\u0447\u0430\u045e\u0448\u044b \u043d\u0430 \u0440\u043e\u0434\u043d\u0430\u0439 \u043c\u043e\u0432\u0435 \u0433\u0443\u0447\u043d\u044b \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u045e, \u0451\u043d \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u043a\u0456\u043d\u0443\u045e\u0441\u044f \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u0413\u043e\u0440\u0433\u0456\u0435\u043c, \u0456 \u0437\u043c\u0443\u0441\u0456\u045e \u0456\u0445 \u0443\u0446\u044f\u043a\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u042e\u0434\u0430, \u0437\u0430\u0431\u0440\u0430\u045e\u0448\u044b \u0432\u043e\u0439\u0441\u043a\u0430, \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0433\u043e\u0440\u0430\u0434 \u0410\u0434\u0443\u043b\u0430\u043c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c, \u044f\u043d\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0432\u044b\u0447\u0430\u044e, \u0430\u0447\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f \u0456 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043b\u0456 \u0442\u0430\u043c \u0448\u0430\u0431\u0430\u0442. \u041d\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u042e\u0434\u0430\u043c, \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0446\u0435\u043b\u044b \u043f\u0430\u043b\u0435\u0433\u043b\u044b\u0445, \u0431\u043e \u045e\u0436\u043e \u043c\u0456\u043d\u0443\u043b\u0430 \u0448\u043c\u0430\u0442 \u0447\u0430\u0441\u0443, \u043a\u0430\u0431 \u043f\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0456\u0445 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u044f\u043a\u0430\u043c\u0456 \u045e \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u0430\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e. \u0423 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0437\u0430\u0431\u0456\u0442\u044b\u0445 \u043f\u0430\u0434 \u0442\u0443\u043d\u0456\u043a\u0430\u0439 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0430\u043c\u0443\u043b\u0435\u0442\u044b \u0456\u0434\u0430\u043b\u0430\u045e \u0437 \u042f\u043c\u043d\u0456\u0456, \u0448\u0442\u043e \u044e\u0434\u044d\u044f\u043c \u0431\u044b\u043b\u043e \u0437\u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u0430 \u0417\u0430\u043a\u043e\u043d\u0430\u043c. \u0422\u0430\u043a \u0443\u0441\u0456\u043c \u0441\u0442\u0430\u043b\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0447\u0430\u043c\u0443 \u044f\u043d\u044b \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u041f\u0430\u043d\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u0443\u0434\u0434\u0437\u044e, \u044f\u043a\u0456 \u0432\u044b\u043a\u0440\u044b\u0432\u0430\u0435 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0447\u0430\u043b\u0456 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0446\u0430\u043b\u043a\u0430\u043c \u0431\u044b\u045e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u045e\u0447\u044b\u043d\u0435\u043d\u044b \u0433\u0440\u044d\u0445. \u0412\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b \u042e\u0434\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0447\u0443\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0431\u0435\u0437 \u0433\u0440\u0430\u0445\u0443, \u0431\u043e \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b, \u0448\u0442\u043e \u0442\u044b\u044f \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u0440\u0430\u0445\u0443. \u0417\u0430\u0442\u044b\u043c \u0441\u0430\u0431\u0440\u0430\u045e \u043f\u0430 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043c\u0443\u0436\u0447\u044b\u043d \u043a\u0430\u043b\u044f \u0434\u0437\u0432\u044e\u0445 \u0442\u044b\u0441\u044f\u0447 \u0434\u0440\u0430\u0445\u043c \u0441\u0440\u044d\u0431\u0440\u0430\u043c \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u0433\u0440\u044d\u0445. \u0423\u0447\u044b\u043d\u0456\u045e \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430 \u0456 \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430, \u0431\u043e \u0434\u0443\u043c\u0430\u045e \u043f\u0440\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0447\u0430\u043a\u0430\u045e \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0437\u0430\u0431\u0456\u0442\u044b\u0445, \u0442\u043e \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u043c \u0456 \u0431\u0435\u0441\u0441\u044d\u043d\u0441\u043e\u045e\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0431 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0410\u0434\u043d\u0430\u043a \u0451\u043d \u0447\u0430\u043a\u0430\u045e \u043d\u0430\u0439\u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0443\u044e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0441\u044b\u043d\u0430\u0435 \u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u0430 \u0456 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430. \u0422\u0430\u043c\u0443 \u0451\u043d \u0447\u044b\u043d\u0456\u045e \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0433\u0440\u0430\u0445\u0443.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u041c\u0430\u043a 12, 45. 46<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0441\u044b\u043d\u0430\u0435 \u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u043d\u0430\u0439\u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u0432\u044f\u0442\u0430\u044f \u0456 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u044f \u0440\u044d\u0447 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0433\u0440\u0430\u0445\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"317","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041c\u0430\u043a\u0430\u0431\u044d\u044f\u045e <\/span><span style=\"color: #ff0000;\">9, 1-22<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043c\u0435\u0440\u0446\u044c \u042e\u0434\u044b \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435<\/span><\/p>\r\n<p style=\"text-indent: 27pt;\"><span>\u041a\u0430\u043b\u0456 \u0414\u044b\u043c\u0435\u0442\u0440\u044b\u0439 \u043f\u0430\u0447\u0443\u045e, \u0448\u0442\u043e \u045e \u0431\u0456\u0442\u0432\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u041d\u0456\u043a\u0430\u043d\u043e\u0440 \u0456 \u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430, \u0437\u043d\u043e\u045e \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u0430\u043a\u0445\u0456\u0434\u0430 \u0456 \u0410\u043b\u043a\u0456\u043c\u0430 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0443 \u0437\u044f\u043c\u043b\u044e \u042e\u0434\u044b, \u0430 \u0437 \u0456\u043c \u043f\u0440\u0430\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u043e \u0432\u043e\u0439\u0441\u043a\u0430. \u042f\u043d\u044b \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u045e \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u0430 \u0413\u0430\u043b\u0456\u043b\u0435\u0456 \u0456 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043a\u0430\u043b\u044f \u041c\u0435\u0441\u0430\u043b\u043e\u0442\u0430 \u045e \u0410\u0440\u0431\u044d\u043b\u0456, \u0437\u0430\u0445\u0430\u043f\u0456\u043b\u0456 \u044f\u0433\u043e \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u043b\u044e\u0434\u0437\u0435\u0439. \u0423 \u043f\u0435\u0440\u0448\u044b \u043c\u0435\u0441\u044f\u0446 \u0441\u0442\u043e \u043f\u044f\u0446\u044c\u0434\u0437\u044f\u0441\u044f\u0442 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0433\u043e\u0434\u0430 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043a\u0430\u043b\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0456 \u0437 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0446\u044e \u0442\u044b\u0441\u044f\u0447\u0430\u043c\u0456 \u043f\u0435\u0448\u044b\u0445 \u0434\u044b \u0437 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0456\u0442\u044b\u0441\u044f\u0447\u043d\u0430\u0439 \u043a\u043e\u043d\u043d\u0456\u0446\u0430\u0439 \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u045e \u0411\u044d\u0440\u044d\u044e. \u042e\u0434\u0430 \u0436 \u0441\u0442\u0430\u044f\u045e \u043b\u0430\u0433\u0435\u0440\u0430\u043c \u0443 \u042d\u043b\u0430\u0441\u0435. \u0422\u0440\u044b \u0442\u044b\u0441\u044f\u0447\u044b \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u043c\u0443\u0436\u0447\u044b\u043d \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430, \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f, \u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u0437\u0431\u0435\u0433\u043b\u0456 \u0437 \u043b\u0430\u0433\u0435\u0440\u0430. \u0417\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u0437 \u0456\u0445 \u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0432\u0430\u0441\u0435\u043c\u0441\u043e\u0442 \u043c\u0443\u0436\u0447\u044b\u043d. \u041a\u0430\u043b\u0456 \u042e\u0434\u0430 \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0440\u0430\u0437\u0431\u0435\u0433\u043b\u0430\u0441\u044f, \u0430 \u0431\u0456\u0442\u0432\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u0430\u0439, \u0443\u0441\u0442\u0440\u044b\u0432\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0431\u043e \u0451\u043d \u043d\u0435 \u043c\u0435\u045e \u0447\u0430\u0441\u0443 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0456\u0445, \u0442\u0430\u043c\u0443 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f: \u00ab\u0423\u0441\u0442\u0430\u043d\u0435\u043c \u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u043c \u043d\u0430 \u043d\u0430\u0448\u044b\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e; \u0430 \u043c\u043e\u0436\u0430 \u0437\u0434\u043e\u043b\u0435\u0435\u043c \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0456\u0445\u00bb. \u042f\u043d\u044b \u0436 \u0430\u0434\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u043b\u0456 \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u043c. \u0414\u0430\u0432\u0430\u0439\u0446\u0435 \u043b\u0435\u043f\u0448 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u041f\u0430\u0441\u043b\u044f \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0437 \u043d\u0430\u0448\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456, \u0431\u043e \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0441 \u043c\u0430\u043b\u0430\u00bb. \u0410 \u042e\u0434\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u045e\u0446\u044f\u043a\u0430\u043b\u0456 \u0430\u0434 \u0456\u0445. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430\u0448 \u0447\u0430\u0441, \u043f\u0430\u043c\u0440\u043e\u043c \u0437 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e \u0437\u0430 \u043d\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u043b\u044f\u043c\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0432\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt;\"><span>\u0406 \u0432\u044b\u0439\u0448\u043b\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u0437 \u043b\u0430\u0433\u0435\u0440\u0430, \u0456 \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445. \u041a\u043e\u043d\u043d\u0456\u0446\u0430 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0434\u0432\u0430 \u0430\u0442\u0440\u0430\u0434\u044b, \u0430 \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456\u0448\u043b\u0456 \u043f\u0440\u0430\u0448\u0447\u043d\u0456\u043a\u0456 \u0456 \u043b\u0443\u0447\u043d\u0456\u043a\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0435 \u0441\u0430\u043c\u044b\u044f \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u044f \u0456 \u043c\u043e\u0446\u043d\u044b\u044f. \u0411\u0430\u043a\u0445\u0456\u0434 \u0431\u044b\u045e \u043d\u0430 \u043f\u0440\u0430\u0432\u044b\u043c \u043a\u0440\u044b\u043b\u0435. \u0424\u0430\u043b\u0430\u043d\u0433\u0430 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u043b\u0430\u0441\u044f \u0437 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0431\u0430\u043a\u043e\u045e \u043f\u0430\u0434 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u0442\u0440\u0443\u0431\u0430\u045e. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u042e\u0434\u0430\u0439, \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u043b\u0456 \u045e \u0442\u0440\u0443\u0431\u044b. \u0417\u044f\u043c\u043b\u044f \u0437\u0430\u0434\u0440\u044b\u0436\u044d\u043b\u0430 \u0430\u0434 \u0433\u0443\u043b\u0443 \u0432\u0430\u0435\u043d\u043d\u044b\u0445 \u0430\u0442\u0440\u0430\u0434\u0430\u045e. \u0420\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u0431\u0456\u0442\u0432\u0430, \u044f\u043a\u0430\u044f \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0437\u0440\u0430\u043d\u0456\u0446\u044b \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 27pt;\"><span>\u042e\u0434\u0430 \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0411\u0430\u043a\u0445\u0456\u0434 \u0456 \u0446\u044d\u043d\u0442\u0440 \u0432\u043e\u0439\u0441\u043a\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u0430. \u0423\u0441\u0435 \u043c\u0443\u0436\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0456 \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043f\u0440\u0430\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u043e \u0432\u043e\u0440\u0430\u0433\u0430. \u042f\u043d\u044b \u0433\u043d\u0430\u043b\u0456 \u0456\u0445 \u0430\u0436 \u0434\u0430 \u0433\u0430\u0440\u044b \u0410\u0437\u043e\u0442. \u041a\u0430\u043b\u0456 \u0442\u044b\u044f, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u043d\u0430 \u043b\u0435\u0432\u044b\u043c \u043a\u0440\u044b\u043b\u0435, \u0443\u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u043f\u0440\u0430\u0432\u0430\u0435 \u043a\u0440\u044b\u043b\u043e \u0440\u0430\u0437\u0431\u0456\u0442\u0430, \u0442\u043e \u043a\u0456\u043d\u0443\u043b\u0456\u0441\u044f \u045e\u0441\u043b\u0435\u0434 \u0437\u0430 \u042e\u0434\u0430\u043c \u0456 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u0456\u043c. \u0417\u0430\u0432\u044f\u0437\u0430\u043b\u0430\u0441\u044f \u0446\u044f\u0436\u043a\u0430\u044f \u0431\u0456\u0442\u0432\u0430, \u043f\u0430\u043b\u0435\u0433\u043b\u0430 \u0448\u043c\u0430\u0442 \u0437\u0430\u0431\u0456\u0442\u044b\u0445, \u044f\u043a \u0430\u0434\u043d\u044b\u0445, \u0442\u0430\u043a \u0456 \u0434\u0440\u0443\u0433\u0456\u0445. \u0417\u0430\u0433\u0456\u043d\u0443\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042e\u0434\u0430, \u0456\u043d\u0448\u044b\u044f \u043f\u0430\u045e\u0446\u044f\u043a\u0430\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt;\"><span>\u042f\u043d\u0430\u0442\u0430\u043d \u0456 \u0421\u0456\u043c\u044f\u043e\u043d \u0437\u0430\u0431\u0440\u0430\u043b\u0456 \u042e\u0434\u0443, \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430, \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u045e \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0443 \u041c\u0430\u0434\u0437\u0456\u043d\u0435. \u0410\u043f\u043b\u0430\u043a\u0432\u0430\u043b\u0456 \u044f\u0433\u043e, \u0430 \u045e\u0432\u0435\u0441\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043c\u043e\u0446\u043d\u0430 \u0433\u0430\u043b\u0430\u0441\u0456\u045e \u043f\u0430 \u0456\u043c. \u0428\u043c\u0430\u0442 \u0434\u0437\u0451\u043d \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u0436\u0430\u043b\u043e\u0431\u0435 \u0456 \u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u042f\u043a \u043c\u043e\u0433 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0441\u0456\u043b\u0430\u043a, \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c?\u00bb \u041c\u043d\u043e\u0433\u0430\u0435 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u042e\u0434\u0430: \u0431\u0456\u0442\u0432\u044b, \u0433\u0435\u0440\u0430\u0456\u0447\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u044f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f, \u0431\u043e \u0456\u0445 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 1 \u041c\u0430\u043a 4, 8b. 9\u0430. 10\u0430. 9<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u043d\u0430\u0448\u044d\u0441\u0446\u044f \u0432\u043e\u0440\u0430\u0433\u0430\u045e; \u0437\u0433\u0430\u0434\u0430\u0439\u0446\u0435, \u044f\u043a \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0434\u043a\u0456.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0426\u044f\u043f\u0435\u0440 \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u0430 \u043d\u0435\u0431\u0430, \u0456 \u043d\u0430\u0448 \u0411\u043e\u0433 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0439\u0446\u0435, \u044f\u043a\u0456 \u0446\u0443\u0434 \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0437 \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c \u0456 \u044f\u0433\u043e\u043d\u044b\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0443 \u0427\u044b\u0440\u0432\u043e\u043d\u044b\u043c \u043c\u043e\u0440\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0426\u044f\u043f\u0435\u0440.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"321","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">1, 1-21&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0406\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u044f \u044e\u043d\u0430\u043a\u0456 \u045e \u043f\u0430\u043b\u0430\u0446\u044b \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u0440\u044d\u0446\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0401\u0430\u043a\u0456\u043c\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440, \u043a\u0430\u0440\u043e\u043b\u044c \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430, \u0434\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u045e\u0437\u044f\u045e \u0443 \u0430\u0431\u043b\u043e\u0433\u0443. \u041f\u0430\u043d \u0432\u044b\u0434\u0430\u045e \u0443 \u044f\u0433\u043e\u043d\u044b\u044f \u0440\u0443\u043a\u0456 \u0401\u0430\u043a\u0456\u043c\u0430, \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0456 \u0447\u0430\u0441\u0442\u043a\u0443 \u043d\u0430\u0447\u044b\u043d\u043d\u044f \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u043e\u043c\u0443. \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u0437\u0430\u043d\u0451\u0441 \u044f\u0433\u043e \u045e \u0437\u044f\u043c\u043b\u044e \u0428\u044b\u043d\u0430\u0430\u0440, \u0443 \u0434\u043e\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u0433\u0430, \u0456 \u045e\u043d\u0451\u0441 \u0433\u044d\u0442\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u045e \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u0433\u0430. \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0443 \u0441\u0432\u0430\u0456\u0445 \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u0410\u0448\u0444\u0435\u043d\u0430\u0437\u0443, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0437 \u043b\u0456\u043a\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u0456 \u0437 \u043a\u043d\u044f\u0437\u0451\u045e \u043f\u0440\u044b\u0432\u0451\u045e \u0445\u043b\u043e\u043f\u0446\u0430\u045e \u0431\u0435\u0437 \u044f\u043a\u043e\u0439-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437\u0430\u0433\u0430\u043d\u044b, \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0445 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u0430\u0434\u043e\u0440\u0430\u043d\u044b\u0445 \u0443\u0441\u044f\u043a\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0430\u0431\u0430\u0437\u043d\u0430\u043d\u044b\u0445 \u0443 \u043d\u0430\u0432\u0443\u043a\u0430\u0445 \u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u0445 \u0434\u0430 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u043f\u0430\u043b\u0430\u0446\u044b \u0456 \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0456\u0445 \u043f\u0456\u0441\u044c\u043c\u0443 \u0456 \u043c\u043e\u0432\u0435 \u0445\u0430\u043b\u0434\u044d\u044f\u045e. \u041a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0456\u043c \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0443\u044e \u043f\u043e\u0440\u0446\u044b\u044e \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u0441\u0442\u0440\u0430\u0432\u0430\u045e \u0456 \u0432\u0456\u043d\u0430, \u044f\u043a\u043e\u0435 \u0441\u0430\u043c \u043f\u0456\u045e. \u0417\u0430\u0433\u0430\u0434\u0430\u045e \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445 \u0442\u0440\u044b \u0433\u0430\u0434\u044b, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u044f \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u0451\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u044b\u043b\u0456 \u0436 \u0441\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u044b\u0445 \u0441\u044b\u043d\u043e\u045e \u042e\u0434\u044b \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0410\u043d\u0430\u043d\u0456\u044f, \u041c\u0456\u0441\u0430\u044d\u043b\u044c \u0456 \u0410\u0437\u0430\u0440\u044b\u044f. \u041d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u0434\u0430\u045e \u0456\u043c \u0456\u043c\u0451\u043d\u044b. \u0414\u0430\u043d\u0456\u044d\u043b\u044f \u043d\u0430\u0437\u0432\u0430\u045e \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440\u0430\u043c, \u0410\u043d\u0430\u043d\u0456\u044e \u0428\u0430\u0434\u0440\u0430\u0445\u0430\u043c, \u041c\u0456\u0441\u0430\u044d\u043b\u044f \u041c\u0435\u0448\u0430\u0445\u0430\u043c, \u0410\u0437\u0430\u0440\u044b\u044e \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430\u043c. \u0410\u043b\u0435 \u0414\u0430\u043d\u0456\u044d\u043b\u044c \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u0446\u0446\u0430 \u0435\u0436\u0430\u044e \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u0432\u0456\u043d\u043e\u043c, \u044f\u043a\u043e\u0435 \u0442\u043e\u0439 \u043f\u0456\u045e, \u0442\u0430\u043c\u0443 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u0435\u045e\u043d\u0443\u0445\u0430\u045e, \u043a\u0430\u0431 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u044f\u043c\u0443 \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u0446\u0446\u0430. \u0411\u043e\u0433 \u0436\u0430 \u0430\u0434\u0430\u0440\u044b\u045e \u0414\u0430\u043d\u0456\u044d\u043b\u044f \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044e \u0456 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435\u043c \u0443 \u0432\u0430\u0447\u0430\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u0435\u045e\u043d\u0443\u0445\u0430\u045e. \u0410\u0434\u043d\u0430\u043a \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u043d\u0456\u044d\u043b\u044e: \u00ab\u042f \u0431\u0430\u044e\u0441\u044f \u043c\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u043a\u0430\u0440\u0430\u043b\u044f, \u044f\u043a\u0456 \u0441\u0430\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0432\u0430\u043c \u0435\u0436\u0443 \u0456 \u043f\u0456\u0442\u0432\u043e. \u041a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0432\u0430\u0448\u044b\u044f \u0442\u0432\u0430\u0440\u044b \u0445\u0443\u0434\u0437\u0435\u0439\u0448\u044b\u044f, \u0447\u044b\u043c \u0443 \u0456\u043d\u0448\u044b\u0445 \u044e\u043d\u0430\u043a\u043e\u045e, \u0432\u0430\u0448\u044b\u0445 \u0430\u0434\u043d\u0430\u0433\u043e\u0434\u043a\u0430\u045e, \u0442\u043e \u0432\u044b \u043d\u0430\u043a\u043b\u0456\u0447\u0430\u0446\u0435 \u0431\u044f\u0434\u0443 \u043d\u0430 \u043c\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443 \u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0414\u0430\u043d\u0456\u044d\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0443, \u044f\u043a\u043e\u0433\u0430 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430\u0434 \u0414\u0430\u043d\u0456\u044d\u043b\u0435\u043c, \u0410\u043d\u0430\u043d\u0456\u0435\u043c, \u041c\u0456\u0441\u0430\u044d\u043b\u0435\u043c \u0456 \u0410\u0437\u0430\u0440\u044b\u0435\u043c: \u00ab\u041f\u0440\u0430\u0448\u0443, \u0432\u044b\u043f\u0440\u0430\u0431\u0443\u0439 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0434\u0437\u0451\u043d. \u041d\u044f\u0445\u0430\u0439 \u0434\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0435\u0441\u0446\u0456 \u0430\u0433\u0430\u0440\u043e\u0434\u043d\u0456\u043d\u0443 \u0456 \u0432\u0430\u0434\u0443 \u0434\u043b\u044f \u043f\u0456\u0446\u0446\u044f. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0448 \u043d\u0430 \u0442\u0432\u0430\u0440\u044b \u043d\u0430\u0448\u044b\u044f \u0456 \u0442\u0432\u0430\u0440\u044b \u044e\u043d\u0430\u043a\u043e\u045e, \u044f\u043a\u0456\u044f \u0445\u0430\u0440\u0447\u0443\u044e\u0446\u0446\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0435\u0436\u0430\u0439, \u0456 \u0437\u0440\u043e\u0431\u0456\u0448 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0448\u00bb. \u0422\u043e\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0456\u0445 \u0443 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u045e \u0456\u0445 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0434\u0437\u0451\u043d. \u041f\u0430\u0441\u043b\u044f \u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0434\u0437\u0451\u043d \u0456\u0445 \u0442\u0432\u0430\u0440\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u044b\u043c\u0456, \u0430 \u0446\u0435\u043b\u044b \u2013 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0436\u043d\u044b\u043c\u0456, \u0447\u044b\u043c \u0443 \u044e\u043d\u0430\u043a\u043e\u045e, \u044f\u043a\u0456\u0445 \u043a\u0430\u0440\u043c\u0456\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0435\u0436\u0430\u0439. \u0422\u0430\u0434\u044b \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0441\u0442\u0430\u045e \u0437\u0430\u0431\u0456\u0440\u0430\u0446\u044c \u0456\u0445\u043d\u044e\u044e \u0435\u0436\u0443 \u0456 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0456\u0446\u044c, \u0430 \u0434\u0430\u0432\u0430\u045e \u0456\u043c \u0430\u0433\u0430\u0440\u043e\u0434\u043d\u0456\u043d\u0443. \u0406 \u0434\u0430\u045e \u0411\u043e\u0433 \u0433\u044d\u0442\u044b\u043c \u0447\u0430\u0442\u044b\u0440\u043e\u043c \u044e\u043d\u0430\u043a\u0430\u043c \u0432\u0435\u0434\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043f\u0456\u0441\u0430\u043d\u043d\u044f \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u0410 \u0414\u0430\u043d\u0456\u044d\u043b\u044c \u043c\u043e\u0433 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0456 \u0456 \u0441\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f\u043a \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0456\u0441\u044f \u0442\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u0445 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0435\u045e\u043d\u0443\u0445\u0430\u045e \u043f\u0440\u044b\u0432\u0451\u045e \u0456\u0445 \u0434\u0430 \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440\u0430. \u041a\u0430\u0440\u043e\u043b\u044c \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u0456\u043c\u0456, \u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0443\u0441\u0456\u0445 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0442\u0430\u043a\u0456\u0445, \u044f\u043a \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0410\u043d\u0430\u043d\u0456\u044f, \u041c\u0456\u0441\u0430\u044d\u043b\u044c \u0456 \u0410\u0437\u0430\u0440\u044b\u044f. \u0406 \u0441\u0442\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044e. \u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0456\u0445 \u043d\u0430\u043a\u043e\u043d\u0442 \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0451\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0456\u0445 \u0443 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0437\u043e\u045e \u043b\u0435\u043f\u0448\u044b\u043c\u0456 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043c\u0430\u0433\u0430\u045e \u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043e\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435. \u0406 \u0431\u044b\u045e \u0442\u0430\u043c \u0414\u0430\u043d\u0456\u044d\u043b\u044c \u0430\u0436 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0433\u043e\u0434\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u041a\u0456\u0440\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0414\u0430\u043d 1, 17\u0430. 20\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433 \u0434\u0430\u045e \u0456\u043c \u0432\u0435\u0434\u044b \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0456\u0445 \u043b\u0430\u0441\u043a\u0430\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u043c\u0435\u043d\u043d\u0435\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u041f\u0430\u043d \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0456\u0445 \u043d\u0430\u043a\u043e\u043d\u0442 \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u044f\u043d\u044b \u045e\u043c\u0435\u043b\u0430 \u0432\u044b\u0440\u0430\u0448\u0430\u043b\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u043c\u0435\u043d\u043d\u0435\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"322","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f  <\/span><span style=\"color: #ff0000;\">2, 26-47&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0456\u0434\u0430\u043b\u0430 \u0456 \u043a\u0430\u043c\u0435\u043d\u044f. \u0412\u0435\u0447\u043d\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u0440\u043e\u043b\u044c \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f, \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u043b\u043e \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440, \u0456 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u00ab\u0426\u0456 \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043c\u043d\u0435 \u0441\u043e\u043d, \u044f\u043a\u0456 \u044f \u0431\u0430\u0447\u044b\u045e, \u0456 \u044f\u0433\u043e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435?\u00bb \u0410\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0414\u0430\u043d\u0456\u044d\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: \u00ab\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u043a\u0430\u0440\u043e\u043b\u044c, \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044e \u043d\u0456 \u043c\u0443\u0434\u0440\u0430\u0446\u044b, \u043d\u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u044b, \u043d\u0456 \u043c\u0430\u0433\u0456, \u043d\u0456 \u0432\u0435\u0448\u0447\u0443\u043d\u044b. \u0410\u043b\u0435 \u045e \u043d\u0435\u0431\u0435 \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u0401\u043d \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044e \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440\u0443, \u0448\u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0434\u0437\u0451\u043d. \u0422\u0432\u043e\u0439 \u0441\u043e\u043d \u0456 \u0432\u0456\u0437\u0456\u0456 \u0442\u0432\u0430\u0435, \u044f\u043a\u0456\u044f \u0442\u044b \u043c\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043b\u043e\u0436\u044b, \u0442\u0430\u043a\u0456\u044f:&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u044f\u0431\u0435, \u043a\u0430\u0440\u043e\u043b\u044c, \u043d\u0430 \u0442\u0432\u0430\u0456\u043c \u043b\u043e\u0436\u044b \u0430\u0445\u0430\u043f\u0456\u043b\u0456 \u0434\u0443\u043c\u043a\u0456, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f. \u0406 \u0442\u043e\u0439, \u044f\u043a\u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0434\u0430\u045e \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f. \u041c\u043d\u0435 \u0436 \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u043e\u0439 \u0443\u0432\u0430 \u043c\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445, \u0430\u043b\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0456 \u043a\u0430\u0431 \u0442\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0434\u0443\u043c\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u0422\u044b, \u043a\u0430\u0440\u043e\u043b\u044c, \u043c\u0435\u045e \u0431\u0430\u0447\u0430\u043d\u043d\u0435: \u0432\u043e\u0441\u044c \u043d\u0435\u0439\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456\u0434\u0430\u043b, \u2013 \u0432\u0435\u043b\u0456\u0437\u0430\u0440\u043d\u044b \u0431\u044b\u045e \u0433\u044d\u0442\u044b \u0456\u0434\u0430\u043b, \u0456 \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0431\u044b\u045e \u044f\u0433\u043e \u0431\u043b\u044f\u0441\u043a, \u2013 \u0441\u0442\u0430\u044f\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0430 \u0432\u044b\u0433\u043b\u044f\u0434 \u044f\u0433\u043e \u0431\u044b\u045e \u0433\u0440\u043e\u0437\u043d\u044b. \u0413\u0430\u043b\u0430\u0432\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456\u0434\u0430\u043b\u0430 \u0431\u044b\u043b\u0430 \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u0433\u0440\u0443\u0434\u0437\u0456 \u044f\u0433\u043e \u0456 \u0440\u0443\u043a\u0456 \u2013 \u0441\u0430 \u0441\u0440\u044d\u0431\u0440\u0430, \u0436\u044b\u0432\u043e\u0442 \u0456 \u0441\u0446\u0451\u0433\u043d\u044b \u2013 \u0437 \u043c\u0435\u0434\u0437\u0456, \u0433\u0430\u043b\u0451\u043d\u043a\u0456 \u044f\u0433\u043e \u2013 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f, \u0430 \u043d\u043e\u0433\u0456 \u044f\u0433\u043e \u2013 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0437 \u0436\u0430\u043b\u0435\u0437\u0430 \u0456 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0437 \u0433\u043b\u0456\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u045e\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0430\u0434\u0430\u0440\u0432\u0430\u045e\u0441\u044f \u0430\u0434 \u0433\u0430\u0440\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0445\u043e\u0446\u044c \u043d\u0435 \u043a\u0440\u0430\u043d\u0430\u043b\u0456 \u044f\u0433\u043e \u0440\u0443\u043a\u0456, \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0456\u0434\u0430\u043b\u0430 \u045e \u044f\u0433\u043e \u043d\u043e\u0433\u0456 \u0437 \u0436\u0430\u043b\u0435\u0437\u0430 \u0456 \u0433\u043b\u0456\u043d\u044b \u0434\u044b \u0440\u0430\u0437\u0431\u0456\u045e \u0456\u0445 \u043d\u0430 \u043a\u0430\u0432\u0430\u043b\u043a\u0456. \u0422\u0430\u0434\u044b \u0441\u043a\u0440\u044b\u0448\u044b\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0436\u0430\u043b\u0435\u0437\u0430, \u0433\u043b\u0456\u043d\u0430, \u043c\u0435\u0434\u0437\u044c, \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0442\u0430\u043b\u0456\u0441\u044f, \u044f\u043a \u043c\u044f\u043a\u0456\u043d\u0430 \u043d\u0430 \u043b\u0435\u0442\u043d\u0456\u0445 \u0442\u0430\u043a\u0430\u0445. \u0412\u0435\u0446\u0435\u0440 \u043f\u0430\u043d\u0451\u0441 \u0456\u0445, \u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0430\u0432\u0430\u0442 \u0441\u043b\u0435\u0434\u0443 \u043f\u0430\u0441\u043b\u044f \u0456\u0445. \u0410 \u043a\u0430\u043c\u0435\u043d\u044c, \u044f\u043a\u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0456\u0434\u0430\u043b\u0430, \u0441\u0442\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0433\u0430\u0440\u043e\u044e \u0456 \u0437\u0430\u043d\u044f\u045e \u0443\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u0422\u0430\u043a\u0456 \u0431\u044b\u045e \u0441\u043e\u043d. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u044e \u044f\u0433\u043e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0431\u0435, \u043a\u0430\u0440\u043e\u043b\u044c, \u043a\u0430\u0440\u043e\u043b\u044c \u043d\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456, \u0411\u043e\u0433 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0434\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043c\u043e\u0446, \u0441\u0456\u043b\u0443 \u0456 \u0441\u043b\u0430\u0432\u0443. \u0423\u0441\u0451, \u0434\u0437\u0435 \u0431 \u043d\u0456 \u0436\u044b\u043b\u0456 \u0441\u044b\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f, \u043f\u0430\u043b\u044f\u0432\u044b\u044f \u0437\u0432\u044f\u0440\u044b \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u043f\u0442\u0443\u0448\u043a\u0456, \u0401\u043d \u0434\u0430\u045e \u0443 \u0442\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u043d\u0430\u0434 \u0456\u043c\u0456 \u045e\u0441\u0456\u043c\u0456. \u0422\u044b \u2013 \u0433\u044d\u0442\u0430 \u0433\u0430\u043b\u0430\u0432\u0430 \u0437 \u0437\u043e\u043b\u0430\u0442\u0430. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435 \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0456\u043d\u0448\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u0442\u0432\u0430\u0451, \u0430 \u043f\u043e\u0442\u044b\u043c \u0456\u043d\u0448\u0430\u0435, \u0442\u0440\u044d\u0446\u044f\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0437 \u043c\u0435\u0434\u0437\u0456, \u044f\u043a\u043e\u0435 \u0437\u0430\u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u044e. \u0410\u043b\u0435 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u043c\u043e\u0446\u043d\u0430\u0435, \u044f\u043a \u0436\u0430\u043b\u0435\u0437\u0430. \u0411\u043e, \u044f\u043a \u0436\u0430\u043b\u0435\u0437\u0430 \u043a\u0440\u044b\u0448\u044b\u0446\u044c \u0456 \u0440\u0430\u0437\u0431\u0456\u0432\u0430\u0435 \u045e\u0441\u0451, \u0442\u0430\u043a \u0456 \u044f\u043d\u043e, \u044f\u043a \u0436\u0430\u043b\u0435\u0437\u0430, \u0441\u043a\u0440\u044b\u0448\u044b\u0446\u044c \u0456 \u0440\u0430\u0437\u0430\u0431\u2019\u0435 \u045e\u0441\u0451. \u0410 \u0441\u0442\u0443\u043f\u043d\u0456 \u0456 \u043f\u0430\u043b\u044c\u0446\u044b \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0437 \u0433\u0430\u043d\u0447\u0430\u0440\u043d\u0430\u0439 \u0433\u043b\u0456\u043d\u044b \u0456 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0437 \u0436\u0430\u043b\u0435\u0437\u0430, \u044f\u043a\u0456\u044f \u0442\u044b \u0431\u0430\u0447\u044b\u045e, \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0443 \u044f\u043a\u0456\u043c \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043f\u044d\u045e\u043d\u0430\u044f \u043c\u043e\u0446 \u0436\u0430\u043b\u0435\u0437\u0430, \u0431\u043e \u0442\u044b \u0431\u0430\u0447\u044b\u045e \u0436\u0430\u043b\u0435\u0437\u0430, \u0437\u043c\u044f\u0448\u0430\u043d\u0430\u0435 \u0437 \u0433\u043b\u0435\u0439\u043a\u0430\u0439 \u0433\u043b\u0456\u043d\u0430\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u043b\u044c\u0446\u044b \u043d\u043e\u0433 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f \u0456 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0433\u043b\u0456\u043d\u044f\u043d\u044b\u044f, \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u043c\u043e\u0446\u043d\u044b\u043c, \u0430 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u043a\u0440\u043e\u0445\u043a\u0456\u043c. \u0416\u0430\u043b\u0435\u0437\u0430, \u0437\u043c\u044f\u0448\u0430\u043d\u0430\u0435 \u0437 \u0433\u043b\u0435\u0439\u043a\u0430\u0439 \u0433\u043b\u0456\u043d\u0430\u0439, \u044f\u043a\u043e\u0435 \u0442\u044b \u0431\u0430\u0447\u044b\u045e, \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u043c\u044f\u0448\u0430\u044e\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043b\u0456\u044e\u0446\u0446\u0430 \u0430\u0434\u043d\u043e \u0437 \u0430\u0434\u043d\u044b\u043c, \u044f\u043a \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u043c\u044f\u0448\u0430\u0446\u044c \u0436\u0430\u043b\u0435\u0437\u0430 \u0437 \u0433\u043b\u0456\u043d\u0430\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0434\u043d\u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u044b\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0411\u043e\u0433 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430. \u0406 \u0433\u044d\u0442\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0456\u043d\u0448\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443. \u042f\u043d\u043e \u0441\u043a\u0440\u044b\u0448\u044b\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u044b, \u0430 \u0441\u0430\u043c\u043e \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430, \u044f\u043a \u0442\u044b \u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0430\u0434 \u0433\u0430\u0440\u044b \u0430\u0434\u0430\u0440\u0432\u0430\u045e\u0441\u044f \u043a\u0430\u043c\u0435\u043d\u044c, \u0445\u043e\u0446\u044c \u044f\u0433\u043e \u0456 \u043d\u0435 \u043a\u0440\u0430\u043d\u0430\u043b\u0456 \u0440\u0443\u043a\u0456, \u0456 \u0441\u043a\u0440\u044b\u0448\u044b\u045e \u0436\u0430\u043b\u0435\u0437\u0430, \u043c\u0435\u0434\u0437\u044c, \u0433\u043b\u0456\u043d\u0443, \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430. \u0412\u044f\u043b\u0456\u043a\u0456 \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u043a\u0430\u0440\u0430\u043b\u044e, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043b\u044f. \u0421\u043e\u043d \u0433\u044d\u0442\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u0456 \u044f\u0433\u043e \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u043b\u0443\u0448\u043d\u0430\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u0443\u043f\u0430\u045e \u043d\u0456\u0446\u043c\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u0414\u0430\u043d\u0456\u044d\u043b\u044e. \u0417\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u045e \u044f\u0433\u043e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u0435\u0436\u044b \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u0417\u0430\u0442\u044b\u043c \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u0430\u0448 \u0411\u043e\u0433 \u2013 \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u043d\u0430\u0434 \u0431\u0430\u0433\u0430\u043c\u0456 \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456, \u044f\u043a\u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u0431\u043e \u0442\u044b \u0437\u043c\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0430\u043d 2, 44; \u043f\u0430\u0440. \u041b\u043a 20, 17. 18<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430. \u042f\u043d\u043e \u0441\u043a\u0440\u044b\u0448\u044b\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430 \u0441\u0430\u043c\u043e \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043c\u0435\u043d\u044c, \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430, \u0430 \u043d\u0430 \u043a\u0430\u0433\u043e \u0451\u043d \u0443\u043f\u0430\u0434\u0437\u0435, \u0442\u0430\u0433\u043e \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410 \u0441\u0430\u043c\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"323","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">3, 8-12. 19-24. 91-97<\/span><span> <\/span><span style=\"color: #ff0000;\">(Vlg)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u043b\u0430\u0442\u0430\u044f \u0441\u0442\u0430\u0442\u0443\u044f \u043a\u0430\u0440\u0430\u043b\u044f. \u0412\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u044e\u043d\u0430\u043a\u043e\u045e \u0437 \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0439 \u043f\u0435\u0447\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043c\u0443\u0436\u044b \u0445\u0430\u043b\u0434\u044d\u0439\u0441\u043a\u0456\u044f \u0456 \u0434\u0430\u043d\u0435\u0441\u043b\u0456 \u043d\u0430 \u0433\u0430\u0431\u0440\u044d\u044f\u045e. \u042f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044e \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440\u0443: \u00ab\u0416\u044b\u0432\u0456 \u0432\u0435\u0447\u043d\u0430, \u043a\u0430\u0440\u043e\u043b\u044c! \u0422\u044b, \u043a\u0430\u0440\u043e\u043b\u044c, \u0432\u044b\u0434\u0430\u045e \u0434\u044d\u043a\u0440\u044d\u0442, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0430\u0447\u0443\u0435 \u0433\u0443\u043a \u0440\u043e\u0433\u0443, \u0444\u043b\u0435\u0439\u0442\u044b, \u0446\u044b\u0442\u0440\u044b, \u043b\u0456\u0440\u044b, \u0430\u0440\u0444\u044b, \u0442\u0440\u0443\u0431\u044b, \u0434\u0443\u0434\u044b \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0432\u0456\u0434\u0443 \u043c\u0443\u0437\u044b\u0447\u043d\u044b\u0445 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u045e, \u0443\u043f\u0430\u045e \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u0437\u0430\u043b\u0430\u0442\u043e\u043c\u0443 \u0456\u0434\u0430\u043b\u0443. \u0410 \u0445\u0442\u043e \u043d\u0435 \u045e\u043f\u0430\u0434\u0437\u0435 \u0456 \u043d\u0435 \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u045e\u043a\u0456\u043d\u0443\u0442\u044b \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0439 \u043f\u0435\u0447\u044b. \u0410\u0434\u043d\u0430\u043a \u0451\u0441\u0446\u044c \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0456\u044f \u043c\u0443\u0436\u044b, \u044f\u043a\u0456\u0445 \u0442\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u044f\u0439: \u0421\u044d\u0434\u0440\u0430\u0445, \u041c\u0435\u0441\u0430\u0445 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430. \u0413\u044d\u0442\u044b\u044f \u043c\u0443\u0436\u044b, \u043a\u0430\u0440\u043e\u043b\u044c, \u043d\u0435 \u043b\u0456\u0447\u0430\u0446\u0446\u0430 \u0437 \u0442\u0432\u0430\u0456\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c, \u043d\u0435 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0442\u0432\u0430\u0456\u043c \u0431\u0430\u0433\u0430\u043c \u0456 \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u044e\u0446\u0446\u0430 \u0437\u0430\u043b\u0430\u0442\u043e\u043c\u0443 \u0456\u0434\u0430\u043b\u0443, \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0437\u043c\u044f\u043d\u0456\u045e\u0441\u044f \u0432\u044b\u0440\u0430\u0437 \u0442\u0432\u0430\u0440\u0443 \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u0456 \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0433\u043d\u0435\u0432\u0430\u043c \u043d\u0430 \u0421\u044d\u0434\u0440\u0430\u0445\u0430, \u041c\u0435\u0441\u0430\u0445\u0430 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430. \u0423 \u0430\u0434\u043a\u0430\u0437 \u0451\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u043b\u0456 \u043f\u0435\u0447 \u0443 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e \u0433\u0430\u0440\u0430\u0447\u044d\u0439, \u0447\u044b\u043c \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430. \u0421\u0430\u043c\u044b\u043c \u0434\u0443\u0436\u044b\u043c \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0437\u0432\u044f\u0437\u0430\u0446\u044c \u0421\u044d\u0434\u0440\u0430\u0445\u0430, \u041c\u0435\u0441\u0430\u0445\u0430 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430 \u0456 \u045e\u043a\u0456\u043d\u0443\u0446\u044c \u0456\u0445 \u0443 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0443\u044e \u043f\u0435\u0447. \u0422\u0430\u0434\u044b \u0437\u0432\u044f\u0437\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u0445 \u043c\u0443\u0436\u043e\u045e, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0441\u0432\u0430\u0456\u0445 \u043f\u043b\u0430\u0448\u0447\u0430\u0445, \u0442\u0443\u043d\u0456\u043a\u0430\u0445, \u0442\u0443\u0440\u0431\u0430\u043d\u0430\u0445 \u0456 \u0448\u0430\u0442\u0430\u0445 \u0434\u044b \u043a\u0456\u043d\u0443\u043b\u0456 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0439 \u043f\u0435\u0447\u044b. \u0410\u0434\u043d\u0430\u043a, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0433\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f \u0431\u044b\u045e \u0441\u0443\u0440\u043e\u0432\u044b, \u0430 \u043f\u0435\u0447 \u0431\u044b\u043b\u0430 \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430, \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u043a\u0456\u0434\u0430\u043b\u0456 \u0421\u044d\u0434\u0440\u0430\u0445\u0430, \u041c\u0435\u0441\u0430\u0445\u0430 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430, \u0441\u043f\u0430\u043b\u0456\u043b\u0430 \u043f\u043e\u043b\u044b\u043c\u0435\u043c. \u0410 \u0433\u044d\u0442\u044b\u044f \u0442\u0440\u044b \u043c\u0443\u0436\u044b, \u0421\u044d\u0434\u0440\u0430\u0445, \u041c\u0435\u0441\u0430\u0445 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433, \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u044f, \u0443\u043f\u0430\u043b\u0456 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0439 \u043f\u0435\u0447\u044b. \u042f\u043d\u044b \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u043f\u043e\u043b\u044b\u043c\u044f, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0440\u043e\u043b\u044c \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u0437\u0434\u0437\u0456\u0432\u0456\u045e\u0441\u044f, \u0445\u0443\u0442\u043a\u0430 \u045e\u0441\u0442\u0430\u045e \u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0426\u0456 \u043d\u0435 \u045e\u043a\u0456\u043d\u0443\u043b\u0456 \u043c\u044b \u0442\u0440\u043e\u0445 \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u0443 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0430\u0433\u043d\u044e?\u00bb \u042f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u044e: \u00ab\u0411\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430, \u043a\u0430\u0440\u043e\u043b\u044c\u00bb. \u0401\u043d \u0436\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0410\u043b\u0435 \u044f \u0431\u0430\u0447\u0443 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e, \u044f\u043a\u0456\u044f \u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0430\u0433\u043d\u044e, \u0456 \u043d\u044f\u043c\u0430 \u043d\u0430 \u0456\u0445 \u0440\u0430\u043d\u0430\u045e, \u0430 \u0432\u044b\u0433\u043b\u044f\u0434 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0433\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0441\u044b\u043d\u0430 \u0431\u0430\u0433\u043e\u045e\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u043f\u0430\u0434\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0436\u0430\u0440\u0430\u043b\u0430 \u043f\u0435\u0447\u044b, \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0439 \u0430\u0433\u043d\u0451\u043c, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0421\u044d\u0434\u0440\u0430\u0445, \u041c\u0435\u0441\u0430\u0445 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433, \u0441\u043b\u0443\u0433\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0432\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0456 \u043f\u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0441\u044e\u0434\u044b!\u00bb \u0422\u0430\u0434\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0421\u044d\u0434\u0440\u0430\u0445, \u041c\u0435\u0441\u0430\u0445 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433 \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u0430\u0433\u043d\u044f. \u0421\u0430\u0431\u0440\u0430\u045e\u0448\u044b\u0441\u044f, \u0441\u0430\u0442\u0440\u0430\u043f\u044b, \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0456, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439 \u0456 \u0434\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u044f, \u0443\u0431\u0430\u0447\u044b\u043b\u0456 \u0433\u044d\u0442\u044b\u0445 \u043c\u0443\u0436\u043e\u045e. \u0410\u0433\u043e\u043d\u044c \u043d\u0435 \u043c\u0435\u045e \u0443\u043b\u0430\u0434\u044b \u043d\u0430\u0434 \u0456\u0445\u043d\u0456\u043c \u0446\u0435\u043b\u0430\u043c, \u0456 \u0432\u043e\u043b\u0430\u0441 \u0456\u0445\u043d\u044f\u0439 \u0433\u0430\u043b\u0430\u0432\u044b \u043d\u0435 \u0431\u044b\u045e \u0441\u043f\u0430\u043b\u0435\u043d\u044b, \u0430 \u043f\u043b\u0430\u0448\u0447\u044b \u0456\u0445\u043d\u0456\u044f \u043d\u0435 \u0437\u043c\u044f\u043d\u0456\u043b\u0456\u0441\u044f, \u0456 \u043f\u0430\u0445 \u0430\u0433\u043d\u044e \u043d\u0435 \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u0456\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0430\u0437\u0432\u0430\u045e\u0441\u044f \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433 \u0421\u044d\u0434\u0440\u0430\u0445\u0430, \u041c\u0435\u0441\u0430\u0445\u0430 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043d\u0451\u043b\u0430 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u042f\u0433\u043e \u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u043a\u0430\u0437\u0443, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u043b\u0456 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0430\u043c\u0443 \u0431\u043e\u0433\u0443, \u0430\u043f\u0440\u043e\u0447 \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u044f \u0432\u044b\u0434\u0430\u045e \u0434\u044d\u043a\u0440\u044d\u0442, \u043a\u0430\u0431 \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0456 \u043c\u043e\u0432\u0430\u045e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0441\u043a\u0430\u0436\u0430 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0421\u044d\u0434\u0440\u0430\u0445\u0430, \u041c\u0435\u0441\u0430\u0445\u0430 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0430, \u0431\u044b\u045e \u043f\u0430\u0441\u0435\u0447\u0430\u043d\u044b \u043d\u0430 \u043a\u0430\u0432\u0430\u043b\u043a\u0456, \u0430 \u0434\u043e\u043c \u044f\u0433\u043e\u043d\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u045e \u0441\u043c\u0435\u0442\u043d\u0456\u043a, \u0431\u043e \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a \u0401\u043d, \u044f\u043a\u0456 \u0431 \u043c\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u044b\u044f\u045e \u0421\u044d\u0434\u0440\u0430\u0445\u0443, \u041c\u0435\u0441\u0430\u0445\u0443 \u0456 \u0410\u0431\u044d\u0434-\u041d\u044d\u0433\u0443 \u045e \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0414\u0430\u043d 3, 49. 50b. 95<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0441\u044b\u0448\u043e\u045e \u0443 \u043f\u0435\u0447 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0437\u0430\u0440\u044b\u0435\u043c \u0456 \u044f\u0433\u043e \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u043c\u0456 \u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u045e \u0430\u0433\u043e\u043d\u044c \u0437 \u043f\u0435\u0447\u044b. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0422\u0430\u043c\u0443 \u0430\u0433\u043e\u043d\u044c \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0456\u0445, \u043d\u0435 \u043f\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u045e \u0456\u043c \u0456 \u043d\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u045e \u0431\u043e\u043b\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0456\u0445 \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043d\u0451\u043b\u0430 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u042f\u0433\u043e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443 \u0430\u0433\u043e\u043d\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"324","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">5, 1-2. 5-9. 13-17. 25 \u2013 6, 1<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0443\u0434 \u0411\u043e\u0436\u044b \u043d\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0435 \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u0440\u043e\u043b\u044c \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440 \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u045e \u0432\u044f\u043b\u0456\u0437\u043d\u0443\u044e \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u0434\u043b\u044f \u0442\u044b\u0441\u044f\u0447\u044b \u0441\u0432\u0430\u0456\u0445 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u0430\u045e \u0456 \u043f\u0456\u045e \u0432\u0456\u043d\u043e \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0442\u044b\u0441\u044f\u0447\u0447\u0443. \u041f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e\u0448\u044b \u0432\u0456\u043d\u0430, \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0437\u0430\u043b\u0430\u0442\u043e\u0435 \u0456 \u0441\u0440\u044d\u0431\u043d\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u041d\u0430\u0432\u0443\u0445\u0430\u0434\u0430\u043d\u043e\u0441\u0430\u0440, \u044f\u0433\u043e\u043d\u044b \u0431\u0430\u0446\u044c\u043a\u0430, \u0437\u0430\u0431\u0440\u0430\u045e \u0437 \u0435\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0456\u043b\u0456 \u0437 \u044f\u0433\u043e \u043a\u0430\u0440\u043e\u043b\u044c \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b, \u044f\u0433\u043e\u043d\u044b\u044f \u0436\u043e\u043d\u043a\u0456 \u0456 \u043d\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u043c\u043e\u043c\u0430\u043d\u0442 \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u043b\u044c\u0446\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0440\u0443\u043a\u0456 \u0456 \u043f\u0456\u0441\u0430\u043b\u0456 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0434\u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430 \u043d\u0430 \u0442\u044b\u043d\u043a\u0443 \u0441\u0446\u044f\u043d\u044b \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u043f\u0430\u043b\u0430\u0446\u044b, \u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0431\u0430\u0447\u044b\u045e \u043a\u0456\u0441\u0446\u044c \u0440\u0443\u043a\u0456, \u044f\u043a\u0430\u044f \u043f\u0456\u0441\u0430\u043b\u0430. \u0422\u0430\u0434\u044b \u0437\u0431\u044f\u043b\u0435\u045e \u043a\u0430\u0440\u043e\u043b\u044c, \u0437\u0431\u044f\u043d\u0442\u044d\u0436\u044b\u045e\u0441\u044f \u045e \u0434\u0443\u043c\u043a\u0430\u0445, \u0430\u0441\u043b\u0430\u0431\u043b\u0456 \u0441\u0443\u0441\u0442\u0430\u0432\u044b \u0441\u0446\u0451\u0433\u043d\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445, \u0456 \u043a\u0430\u043b\u0435\u043d\u0456 \u0441\u0442\u0430\u043b\u0456 \u0431\u0456\u0446\u0446\u0430 \u0430\u0434\u043d\u043e \u0430\u0431 \u0430\u0434\u043d\u043e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u0440\u043e\u043b\u044c \u043c\u043e\u0446\u043d\u0430 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0445\u0430\u043b\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u0447\u0430\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0456 \u043f\u0440\u0430\u0437\u043e\u0440\u0446\u0430\u045e. \u0417\u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0456\u0445 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e, \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0435 \u0433\u044d\u0442\u044b \u043d\u0430\u0434\u043f\u0456\u0441 \u0456 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u043f\u0443\u0440\u043f\u0443\u0440 \u0456 \u0437\u0430\u043b\u0430\u0442\u044b \u043b\u0430\u043d\u0446\u0443\u0433 \u043d\u0430\u0434\u0437\u0435\u043d\u0443\u0446\u044c \u044f\u043c\u0443 \u043d\u0430 \u0448\u044b\u044e, \u0456 \u044f\u043a \u0442\u0440\u044d\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0435\u00bb. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e\u0441\u0435 \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u043a\u0430\u0440\u0430\u043b\u044f, \u0430\u043b\u0435 \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0446\u044c \u043d\u0430\u0434\u043f\u0456\u0441 \u0456 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044e \u044f\u0433\u043e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435. \u041a\u0430\u0440\u043e\u043b\u044c \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440 \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f, \u0456 \u0437\u0431\u044f\u043b\u0435\u045e \u044f\u0433\u043e\u043d\u044b \u0442\u0432\u0430\u0440, \u0430 \u044f\u0433\u043e \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b \u0437\u0430\u043d\u0435\u043f\u0430\u043a\u043e\u0456\u043b\u0456\u0441\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0414\u0430\u043d\u0456\u044d\u043b\u044f, \u0430 \u043a\u0430\u0440\u043e\u043b\u044c, \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0422\u044b \u2013 \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0437 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445, \u044f\u043a\u043e\u0433\u0430 \u043a\u0430\u0440\u043e\u043b\u044c, \u043c\u043e\u0439 \u0431\u0430\u0446\u044c\u043a\u0430, \u043f\u0440\u044b\u0432\u0451\u045e \u0437 \u042e\u0434\u044b? \u042f \u0447\u0443\u045e \u043f\u0440\u0430 \u0446\u044f\u0431\u0435, \u0448\u0442\u043e \u0442\u044b \u043c\u0430\u0435\u0448 \u0434\u0443\u0445\u0430 \u0431\u0430\u0433\u043e\u045e, \u0441\u0432\u044f\u0442\u043b\u043e, \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0456 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435\u0448\u0441\u044f \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e, \u0447\u0430\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u0434\u043f\u0456\u0441 \u0456 \u0440\u0430\u0437\u2019\u044f\u0441\u043d\u0456\u043b\u0456 \u043c\u043d\u0435 \u044f\u0433\u043e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435, \u0430\u043b\u0435 \u044f\u043d\u044b \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430. \u0410 \u044f \u0447\u0443\u045e \u043f\u0440\u0430 \u0446\u044f\u0431\u0435, \u0448\u0442\u043e \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0432\u044b\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0446\u044c\u043c\u044f\u043d\u0430\u0435 \u0456 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u0437\u0430\u0431\u043b\u044b\u0442\u0430\u043d\u0430\u0435. \u041a\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u0437\u0434\u043e\u043b\u0435\u0435\u0448 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u043d\u0430\u0434\u043f\u0456\u0441 \u0456 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043c\u043d\u0435 \u044f\u0433\u043e, \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u043f\u0443\u0440\u043f\u0443\u0440, \u0437\u0430\u043b\u0430\u0442\u044b \u043b\u0430\u043d\u0446\u0443\u0433 \u043f\u0430\u0432\u0435\u0441\u044f\u0446\u044c \u0442\u0430\u0431\u0435 \u043d\u0430 \u0448\u044b\u044e, \u0456 \u044f\u043a \u0442\u0440\u044d\u0446\u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u045e \u0430\u0434\u043a\u0430\u0437 \u0414\u0430\u043d\u0456\u044d\u043b\u044c \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u0442\u0432\u0430\u0435 \u043f\u0430\u0434\u0430\u0440\u0443\u043d\u043a\u0456, \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0442\u0432\u0430\u0435 \u043f\u0430\u043a\u0456\u043d\u044c \u0456\u043d\u0448\u0430\u043c\u0443, \u0430\u043b\u0435 \u043d\u0430\u0434\u043f\u0456\u0441 \u044f \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u044e \u043a\u0430\u0440\u0430\u043b\u044e&nbsp; \u0456 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u0443 \u044f\u0433\u043e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u044f\u043a\u0456 \u043d\u0430\u0434\u043f\u0456\u0441 \u0431\u044b\u045e \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u044b: \u201c\u041c\u044d\u043d\u044d, \u043c\u044d\u043d\u044d, \u0442\u044d\u043a\u0435\u043b\u044c, \u0443\u043f\u0430\u0440\u0441\u0456\u043d\u201d. \u0410 \u0432\u043e\u0441\u044c \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435 \u043c\u043e\u0432\u044b: \u043c\u044d\u043d\u044d \u2013 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0411\u043e\u0433 \u0442\u0432\u0430\u0451 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u045e \u044f\u043c\u0443 \u043a\u0430\u043d\u0435\u0446; \u0442\u044d\u043a\u0435\u043b\u044c \u2013 \u0443\u0437\u0432\u0430\u0436\u044b\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430 \u0432\u0430\u0433\u0430\u0445, \u0456 \u0442\u044b \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u043b\u0451\u0433\u043a\u0456\u043c; \u043f\u044d\u0440\u044d\u0441 \u2013 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0451 \u0456 \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u0456\u0434\u044b\u0439\u0446\u0430\u043c \u0456 \u043f\u0435\u0440\u0441\u0430\u043c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440 \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u0456 \u0414\u0430\u043d\u0456\u044d\u043b\u044f \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456 \u045e \u043f\u0443\u0440\u043f\u0443\u0440 \u0456 \u043d\u0430\u0434\u0437\u0435\u043b\u0456 \u044f\u043c\u0443 \u043d\u0430 \u0448\u044b\u044e \u0437\u0430\u043b\u0430\u0442\u044b \u043b\u0430\u043d\u0446\u0443\u0433, \u0456 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430, \u0448\u0442\u043e \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u044f\u043a \u0442\u0440\u044d\u0446\u0456 \u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0435. \u0423 \u0433\u044d\u0442\u0443\u044e \u0436 \u043d\u043e\u0447 \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440, \u043a\u0430\u0440\u043e\u043b\u044c \u0445\u0430\u043b\u0434\u044d\u0439\u0441\u043a\u0456. \u0410 \u0414\u0430\u0440\u044b\u0439, \u043c\u0456\u0434\u044b\u0435\u0446, \u043f\u0430\u0447\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c, \u043c\u0430\u044e\u0447\u044b \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u044f\u0441\u044f\u0442 \u0434\u0432\u0430 \u0433\u0430\u0434\u044b.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 75 (74), 6. 8. 9; \u0410\u043f 14, 9. 10<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0439\u0446\u0435 \u0432\u044b\u0441\u043e\u043a\u0430 \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u044b, \u0431\u043e \u0441\u0430\u043c \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0421\u0443\u0434\u0434\u0437\u044f: \u0430\u0434\u043d\u0430\u0433\u043e \u0401\u043d \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u0435, \u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u045e\u0437\u0432\u044b\u0448\u0430\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043e \u045e \u0440\u0443\u0446\u044d \u041f\u0430\u043d\u0430 \u043a\u0435\u043b\u0456\u0445, \u043f\u043e\u045e\u043d\u044b \u043f\u0435\u043d\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u044f\u0448\u0430\u043d\u0430\u0433\u0430 \u0432\u0456\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u0437\u0432\u0435\u0440\u0443 \u0456 \u044f\u0433\u043e\u043d\u0430\u043c\u0443 \u0432\u043e\u0431\u0440\u0430\u0437\u0443, \u043d\u0430\u043f\u2019\u0435\u0446\u0446\u0430 \u0432\u0456\u043d\u0430 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0442\u0430\u0441\u0446\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u045e \u0440\u0443\u0446\u044d.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"325","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">9, 1-4\u0430. 18-27<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0456 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0414\u0430\u043d\u0456\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u043f\u0435\u0440\u0448\u044b \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0414\u0430\u0440\u044b\u044f, \u0441\u044b\u043d\u0430 \u0410\u0445\u0430\u0448\u0432\u0435\u0440\u043e\u0448\u0430 \u0437 \u0440\u043e\u0434\u0443 \u043c\u0456\u0434\u044b\u0439\u0446\u0430\u045e, \u044f\u043a\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430\u043c \u0445\u0430\u043b\u0434\u044d\u044f\u045e, \u0443 \u043f\u0435\u0440\u0448\u044b \u0433\u043e\u0434 \u044f\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u044f, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u043b\u0456\u0447\u0431\u0443 \u0433\u0430\u0434\u043e\u045e \u0443 \u043a\u043d\u0456\u0433\u0430\u0445, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u043f\u0440\u0430\u0440\u043e\u043a\u0443 \u0415\u0440\u0430\u043c\u0456\u044e, \u0448\u0442\u043e \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0433\u0430\u0434\u043e\u045e. \u0422\u0430\u0434\u044b \u044f \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u045e \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440 \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0443\u0437\u043d\u0435\u0441\u0446\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0456 \u043c\u043e\u043b\u044c\u0431\u044b \u045e \u043f\u043e\u0441\u0446\u0435, \u0443 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0435 \u0434\u044b \u043f\u043e\u043f\u0435\u043b\u0435. \u042f \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0456 \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u0445\u0456\u043b\u0456, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430 \u0456 \u043f\u0430\u0447\u0443\u0439! \u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435 \u0456 \u043d\u0430 \u0433\u043e\u0440\u0430\u0434, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430\u0441\u044f \u0422\u0432\u0430\u0451 \u0456\u043c\u044f. \u0411\u043e \u043c\u044b \u043d\u0435 \u0437 \u043d\u0430\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0441\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u043d\u0430 \u0422\u0432\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u041f\u0430\u043d\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439! \u041f\u0430\u043d\u0435, \u0434\u0430\u0440\u0443\u0439! \u041f\u0430\u043d\u0435, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f \u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0439! \u041d\u0435 \u0441\u043f\u0430\u0437\u043d\u044f\u0439\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0431\u043e \u0422\u0432\u0430\u0451 \u0456\u043c\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430\u0441\u044f \u043d\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u0456 \u043d\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u044f \u044f\u0448\u0447\u044d \u043a\u0430\u0437\u0430\u045e, \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0456 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u0433\u0440\u044d\u0445 \u0456 \u0433\u0440\u044d\u0445 \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u045e \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0441\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u043c\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u0437\u0430 \u0441\u0432\u044f\u0442\u0443\u044e \u0433\u0430\u0440\u0443 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u0442\u043e\u0439 \u043c\u0443\u0436, \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c, \u044f\u043a\u043e\u0433\u0430 \u044f \u045e\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u0430\u0447\u044b\u045e \u0443 \u0432\u0456\u0437\u0456\u0456, \u0443 \u0445\u0443\u0442\u043a\u0456\u043c \u043b\u0451\u0446\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043c\u044f\u043d\u0435 \u043a\u0430\u043b\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u0432\u0435\u0447\u0430\u0440\u043e\u0432\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u043f\u0430\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u045e \u043c\u043d\u0435 \u045e \u0440\u0430\u0437\u043c\u043e\u0432\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e \u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u044f \u0432\u044b\u0439\u0448\u0430\u045e \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044e. \u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0442\u0432\u0430\u0456\u0445 \u043c\u043e\u043b\u044c\u0431\u0430\u045e \u0432\u044b\u0439\u0448\u043b\u0430 \u0441\u043b\u043e\u0432\u0430, \u0430 \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u044f\u0433\u043e, \u0431\u043e \u0442\u044b \u0434\u0430\u0440\u0430\u0433\u0456 \u0441\u043a\u0430\u0440\u0431. \u0422\u0430\u043c\u0443 \u043f\u0430\u0437\u043d\u0430\u0439 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439 \u0431\u0430\u0447\u0430\u043d\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0442\u044b\u0434\u043d\u044f\u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0442\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0442\u0432\u0430\u0439\u043c\u0443 \u0441\u0432\u044f\u0442\u043e\u043c\u0443 \u0433\u043e\u0440\u0430\u0434\u0443, \u043a\u0430\u0431 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u0437 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u043c \u0456 \u0441\u043f\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u0430\u0434\u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u0446\u044c \u0437\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u0443 \u0456 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u0446\u044c \u0432\u0456\u0437\u0456\u044e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0434\u044b \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u0432\u044f\u0442\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u0435\u0434\u0430\u0439 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439: \u0430\u0434 \u0432\u044b\u0439\u0441\u0446\u044f \u043d\u0430\u043a\u0430\u0437\u0443 \u0430\u0431 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0456 \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0430\u0436 \u0434\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430 \u043c\u0456\u043d\u0435 \u0441\u0435\u043c \u0442\u044b\u0434\u043d\u044f\u045e, \u0456 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u0434\u0432\u0430 \u0442\u044b\u0434\u043d\u0456, \u0456 \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u0430 \u0456 \u0432\u0430\u043b\u044b, \u0430\u043b\u0435 \u045e \u0447\u0430\u0441 \u0443\u0446\u0456\u0441\u043a\u0443. \u0410 \u043f\u0430\u0441\u043b\u044f \u0448\u0430\u0441\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0434\u0432\u0443\u0445 \u0442\u044b\u0434\u043d\u044f\u045e \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b \u0456 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u044f\u0433\u043e, \u0430 \u0433\u043e\u0440\u0430\u0434 \u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435. \u041a\u0430\u043d\u0435\u0446 \u044f\u0433\u043e \u0431\u0443\u0434\u0437\u0435 \u045e \u043f\u0430\u0432\u043e\u0434\u0446\u044b, \u0456 \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0432\u0430\u0439\u043d\u044b \u043d\u0430\u043a\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0401\u043d \u0443\u043c\u0430\u0446\u0443\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u043d\u0430 \u0430\u0434\u0437\u0456\u043d \u0442\u044b\u0434\u0437\u0435\u043d\u044c, \u0430 \u045e \u043f\u0430\u043b\u043e\u0432\u0435 \u0442\u044b\u0434\u043d\u044f \u0441\u043f\u044b\u043d\u0456\u0446\u044c \u043a\u0440\u044b\u0432\u0430\u0432\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435. \u0410 \u043d\u0430 \u043a\u0440\u044b\u043b\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0433\u0456\u0434\u0430 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u044f \u0430\u0436 \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u0437\u0433\u0443\u0431\u0430 \u043d\u0435 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0411\u0430\u0440 2, 16\u0430; \u0414\u0430\u043d 9, 18\u0430; \u041f\u0441 80 (79), 20<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u041f\u0430\u043d\u0435, \u043d\u0430 \u043d\u0430\u0441 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u045e\u0441\u043f\u043e\u043c\u043d\u0456 \u043f\u0440\u0430 \u043d\u0430\u0441. \u0421\u0445\u0456\u043b\u0456, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430, \u0456 \u043f\u0430\u0447\u0443\u0439.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0436\u0430, \u0430\u0434\u043d\u0430\u0432\u0456 \u043d\u0430\u0441, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0437\u0437\u044f\u0435 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u2013 \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u043a\u0440\u044b\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"326","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">10, 1-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0437\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u043d\u0451\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u0440\u044d\u0446\u0456 \u0433\u043e\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u041a\u0456\u0440\u0430, \u043f\u0435\u0440\u0441\u0456\u0434\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0431\u044b\u043b\u043e \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044e, \u044f\u043a\u043e\u043c\u0443 \u0434\u0430\u043b\u0456 \u0456\u043c\u044f \u0411\u0430\u043b\u0442\u0430\u0437\u0430\u0440. \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0442\u043e\u0435 \u0441\u043b\u043e\u0432\u0430, \u0456 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435. \u0401\u043d \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0433\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u045e \u0432\u0456\u0437\u0456\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u044f, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0431\u044b\u045e \u0443 \u0436\u0430\u043b\u043e\u0431\u0435 \u0442\u0440\u044b \u0442\u044b\u0434\u043d\u0456. \u042f \u043d\u0435 \u0435\u045e \u0441\u043c\u0430\u0447\u043d\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u043d\u0435 \u0431\u0440\u0430\u045e \u0443 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043c\u044f\u0441\u0430 \u0456 \u0432\u0456\u043d\u0430, \u043d\u0435 \u043d\u0430\u043c\u0430\u0448\u0447\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u0430\u043b\u0435\u0435\u043c \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043c\u0456\u043d\u0443\u043b\u0430 \u0442\u0440\u044b \u0442\u044b\u0434\u043d\u0456. \u041d\u0430 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u044f \u0431\u044b\u045e \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u043a\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0422\u044b\u0433\u0440\u0430. \u041a\u0430\u043b\u0456 \u044f \u045e\u0437\u043d\u044f\u045e \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435 \u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u045e, \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u044f\u045e \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u0443\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0430 \u0441\u0446\u0451\u0433\u043d\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u043d\u044b\u044f \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0437 \u0423\u0444\u0430\u0437\u0430. \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0431\u044b\u043b\u043e \u044f\u043a \u0442\u0430\u043f\u0430\u0437, \u0442\u0432\u0430\u0440 \u044f\u0433\u043e \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0431\u044b\u045e \u044f\u043a \u043c\u0430\u043b\u0430\u043d\u043a\u0430, \u0432\u043e\u0447\u044b \u044f\u0433\u043e \u2013 \u044f\u043a \u043f\u0430\u043b\u0430\u044e\u0447\u044b\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u0456, \u044f\u0433\u043e \u043f\u043b\u0435\u0447\u044b \u0456 \u043d\u043e\u0433\u0456 \u2013 \u043d\u0456\u0431\u044b \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u044f \u0430\u0434\u043f\u0430\u043b\u0456\u0440\u0430\u0432\u0430\u043d\u0430\u044f \u0431\u0440\u043e\u043d\u0437\u0430, \u0430 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u045e \u2013 \u043d\u0456\u0431\u044b \u0433\u0443\u043b \u043d\u0430\u0442\u043e\u045e\u043f\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u044f, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0433\u044d\u0442\u0443\u044e \u0432\u0456\u0437\u0456\u044e, \u0430 \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0441\u0430 \u043c\u043d\u043e\u044e, \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0433\u044d\u0442\u0430\u0439 \u0432\u0456\u0437\u0456\u0456, \u0430\u0434\u043d\u0430\u043a \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0442\u0440\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u0456\u0445, \u0456 \u044f\u043d\u044b \u045e\u0446\u044f\u043a\u043b\u0456, \u043a\u0430\u0431 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430. \u042f \u0436 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0456 \u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0432\u0456\u0437\u0456\u044e, \u0430\u043b\u0435 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0441\u0456\u043b\u044b, \u0430 \u043c\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0430\u0434 \u043c\u044f\u043d\u0435 \u0456 \u0437\u043d\u0456\u043a\u043b\u0430, \u0456 \u044f \u0437\u0433\u0443\u0431\u0456\u045e \u0441\u0432\u0430\u0435 \u0441\u0456\u043b\u044b. \u042f \u043f\u0430\u0447\u0443\u045e \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u045e, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u045e \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u045e, \u0430\u0433\u0430\u043b\u043e\u043c\u0448\u0430\u043d\u044b, \u0443\u043f\u0430\u045e \u043d\u0456\u0446\u043c\u0430, \u0442\u0432\u0430\u0440\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0406 \u0432\u043e\u0441\u044c \u043d\u0435\u0439\u043a\u0430\u044f \u0440\u0443\u043a\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u043c\u044f\u043d\u0435, \u0441\u0442\u0440\u0430\u0441\u044f\u043d\u0443\u043b\u0430 \u043c\u044f\u043d\u0435, \u0430\u0436 \u044f \u0430\u0431\u0430\u043f\u0435\u0440\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0435 \u043a\u0430\u043b\u0435\u043d\u0456 \u0456 \u043d\u0430 \u0434\u0430\u043b\u043e\u043d\u0456 \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a. \u041f\u0430\u0441\u043b\u044f \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u043c\u0443\u0436! \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u0439 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u044f \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u0456 \u0441\u0442\u0430\u043d\u044c \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u0434\u0437\u0435 \u0441\u0442\u0430\u0456\u0448, \u0431\u043e \u0446\u044f\u043f\u0435\u0440 \u044f \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0430 \u0446\u044f\u0431\u0435\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u043a\u0430\u043b\u0456 \u0451\u043d \u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f \u0441\u0442\u0430\u044f\u045e \u0456 \u0434\u0440\u044b\u0436\u044d\u045e. \u041f\u043e\u0442\u044b\u043c \u0430\u043d\u0451\u043b \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0431\u043e \u0437 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0442\u044b \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0456 \u0441\u043a\u0430\u0440\u044b\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u0431\u044b\u043b\u0456 \u043f\u0430\u0447\u0443\u0442\u044b\u044f \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u0456 \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0446\u044f\u0431\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d \u0442\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e. \u0410\u043b\u0435 \u043a\u043d\u044f\u0437\u044c \u043f\u0435\u0440\u0441\u0456\u0434\u0441\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u044e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c, \u0456 \u0432\u043e\u0441\u044c \u041c\u0456\u0445\u0430\u043b, \u0430\u0434\u0437\u0456\u043d \u0437 \u043f\u0435\u0440\u0448\u044b\u0445 \u043a\u043d\u044f\u0437\u0451\u045e, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u0431\u044b\u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b \u0442\u0430\u043c \u043f\u0440\u044b \u043a\u0430\u0440\u0430\u043b\u044f\u0445 \u041f\u0435\u0440\u0441\u0456\u0456. \u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u0442\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0434\u0437\u0451\u043d, \u0431\u043e \u044f\u0448\u0447\u044d \u0431\u0443\u0434\u0437\u0435 \u0432\u0456\u0437\u0456\u044f \u043f\u0440\u0430 \u0442\u044b\u044f \u0434\u043d\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0451\u043d \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043c\u043d\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f \u0441\u0445\u0456\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0430\u043d\u044f\u043c\u0435\u045e. \u0406 \u0432\u043e\u0441\u044c \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e, \u0456 \u044f \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0430\u044f\u045e \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041c\u043e\u0439 \u043f\u0430\u043d\u0435! \u0410\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u044f \u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0431\u043e\u043b\u0435\u043c \u0456 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0441\u0456\u043b\u044b. \u042f\u043a \u0436\u0430 \u043c\u043e\u0436\u0430 \u0433\u044d\u0442\u043a\u0456 \u0441\u043b\u0443\u0433\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u043d\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0442\u0430\u043a\u0456\u043c \u043f\u0430\u043d\u0430\u043c \u043c\u0430\u0456\u043c, \u043a\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u043d\u044f\u043c\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0441\u0456\u043b\u044b \u0456 \u044f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0434\u044b\u0445\u0430\u0446\u044c?\u00bb \u0406 \u0437\u043d\u043e\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0442\u043e\u0439, \u044f\u043a\u0456 \u043c\u0435\u045e \u0432\u044b\u0433\u043b\u044f\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0434\u0430\u0440\u0430\u0433\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a! \u0421\u0443\u043f\u0430\u043a\u043e\u0439 \u0442\u0430\u0431\u0435! \u0411\u0443\u0434\u0437\u044c \u043c\u043e\u0446\u043d\u044b, \u0431\u0443\u0434\u0437\u044c \u0434\u0443\u0436\u044b!\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0451\u043d \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f \u043d\u0430\u0431\u0440\u0430\u045e\u0441\u044f \u0441\u0456\u043b\u044b \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0413\u0430\u0432\u0430\u0440\u044b, \u043c\u043e\u0439 \u043f\u0430\u043d\u0435, \u0431\u043e \u0442\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435\u00bb. \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0426\u0456 \u0432\u0435\u0434\u0430\u0435\u0448, \u0447\u0430\u0433\u043e \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0446\u044f\u0431\u0435? \u0410\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u044f \u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u043a\u043d\u044f\u0437\u0435\u043c \u041f\u0435\u0440\u0441\u0456\u0456. \u041a\u0430\u043b\u0456 \u044f \u0430\u0434\u044b\u0434\u0443, \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043a\u043d\u044f\u0437\u044c \u042f\u0432\u0430\u043d\u0430. \u0410\u043b\u0435 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0442\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u043f\u0440\u0430\u045e\u0434\u044b. \u0406 \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0431 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445, \u0430\u043a\u0440\u0430\u043c\u044f \u041c\u0456\u0445\u0430\u043b\u0430, \u0432\u0430\u0448\u0430\u0433\u0430 \u043a\u043d\u044f\u0437\u044f\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0414\u0430\u043d 10, 12. 19\u0430. 21\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0442\u044b \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0456 \u0441\u043a\u0430\u0440\u044b\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u044b\u043b\u0456 \u043f\u0430\u0447\u0443\u0442\u044b\u044f \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0442\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u043f\u0440\u0430\u045e\u0434\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u044b\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"327","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">12, 1-13&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0456 \u043f\u0440\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u043d\u0451\u043b \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u041f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441 \u041c\u0456\u0445\u0430\u043b, \u043a\u043d\u044f\u0437\u044c \u0432\u044f\u043b\u0456\u043a\u0456, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0440\u044b \u0441\u044b\u043d\u0430\u0445 \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. \u0410 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430 \u0447\u0430\u0441 \u0443\u0446\u0456\u0441\u043a\u0443, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0434 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0443 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c. \u0423 \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b \u0442\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u043e\u0436\u043d\u044b, \u043a\u0430\u0433\u043e \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u043c \u0443 \u043a\u043d\u0456\u0437\u0435. \u0406 \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0456\u0446\u044c \u0443 \u0437\u044f\u043c\u043d\u044b\u043c \u043f\u044b\u043b\u0435, \u0430\u0431\u0443\u0434\u0437\u044f\u0446\u0446\u0430: \u0430\u0434\u043d\u044b \u2013 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0434\u0440\u0443\u0433\u0456\u044f \u2013 \u043d\u0430 \u0433\u0430\u043d\u044c\u0431\u0443 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435. \u0410 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0437\u044f\u0446\u044c, \u044f\u043a \u0441\u0432\u044f\u0446\u0456\u043b\u044b \u043d\u0435\u0431\u0430\u0441\u0445\u0456\u043b\u0443, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u2013 \u044f\u043a \u0437\u043e\u0440\u043a\u0456 \u043d\u0430 \u0432\u0435\u0447\u043d\u0443\u044e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c. \u0410 \u0442\u044b, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0437\u0430\u043c\u043a\u043d\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0456 \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0443 \u0430\u0436 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443! \u041c\u043d\u043e\u0433\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0435\u0433\u0430\u0446\u044c \u0442\u0443\u0434\u044b \u0456 \u0441\u044e\u0434\u044b, \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u044f, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e, \u2013 \u0456 \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u044f\u043b\u0456 \u0434\u0432\u0430 \u0456\u043d\u0448\u044b\u044f, \u0430\u0434\u0437\u0456\u043d, \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0431\u0435\u0440\u0430\u0437\u0435 \u0440\u0430\u043a\u0456, \u0434\u0440\u0443\u0433\u0456 \u043d\u0430 \u0442\u044b\u043c \u0431\u0435\u0440\u0430\u0437\u0435 \u0440\u0430\u043a\u0456. \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u043c\u0443 \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u0443\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456 \u0440\u0430\u043a\u0456: \u00ab\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043d\u0435\u0446 \u0433\u044d\u0442\u044b\u0445 \u0446\u0443\u0434\u0430\u045e \u00bb \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0442\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043f\u0430\u0440\u0430\u043d\u0443\u0442\u0430\u0433\u0430 \u045e \u0456\u043b\u044c\u043d\u044f\u043d\u0443\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456 \u0440\u0430\u043a\u0456. \u0401\u043d \u0443\u0437\u043d\u044f\u045e \u0434\u0430 \u043d\u0435\u0431\u0430 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0432\u0456\u0446\u0443 \u0456 \u0441\u0432\u0430\u044e \u043b\u0435\u0432\u0443\u044e \u0440\u0430\u043a\u0443 \u0456 \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e \u0432\u0435\u0447\u043d\u0430 \u0416\u044b\u0432\u044b\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0434\u0430 \u0447\u0430\u0441\u0443, \u0447\u0430\u0441\u043e\u045e \u0456 \u043f\u0430\u043b\u043e\u0432\u044b \u0447\u0430\u0441\u0443. \u0410 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0431\u0456\u0442\u0430 \u043c\u043e\u0446 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0442\u0430\u0434\u044b \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u0446\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f \u043f\u0430\u0447\u0443\u045e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0442\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041c\u043e\u0439 \u043f\u0430\u043d\u0435, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u044b\u0445\u043e\u0434 \u0433\u044d\u0442\u0430\u0433\u0430?\u00bb \u0406 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0406\u0434\u0437\u0456, \u0414\u0430\u043d\u0456\u044d\u043b\u044c, \u0431\u043e \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u0456 \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u044b\u044f \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0430\u0436 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443. \u0428\u043c\u0430\u0442 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u0435\u044f\u043d\u044b\u0445, \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b\u0445 \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b\u0445, \u0430\u043b\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043d\u044f\u0433\u043e\u0434\u043d\u0430. \u041d\u0456\u0445\u0442\u043e \u0437 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0430\u043b\u0435 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c. \u0417 \u0447\u0430\u0441\u0443 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0430\u0433\u0456\u0434\u044b \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u044f \u043c\u0456\u043d\u0435 \u0442\u044b\u0441\u044f\u0447\u0430 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u0434\u0437\u0435\u0432\u044f\u043d\u043e\u0441\u0442\u0430 \u0434\u0437\u0451\u043d. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0445\u0442\u043e \u0434\u0430\u0447\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0456 \u0434\u0430\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u0442\u044b\u0441\u044f\u0447\u0430 \u0442\u0440\u043e\u0445\u0441\u043e\u0442 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u0456 \u043f\u044f\u0446\u0456 \u0434\u0437\u0451\u043d. \u0410 \u0442\u044b \u0456\u0434\u0437\u0456 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u043f\u0430\u0447\u043d\u0435\u0448, \u0430&nbsp; \u045e \u043a\u0430\u043d\u0446\u044b \u0434\u0437\u0451\u043d \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435\u0448 \u0434\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0434\u043e\u043b\u0456\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041b\u043a 20, 35\u0430. 36. 38<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b\u044f, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0433\u043e\u0434\u043d\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u045e\u0436\u043e \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u044f\u043d\u044b \u0440\u043e\u045e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u0430\u043c \u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u044b\u043d\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u044b\u043d\u0430\u043c\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u0436\u0430 \u043d\u0435 \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0430\u043b\u0435 \u0436\u044b\u0432\u044b\u0445, \u0431\u043e \u045e\u0441\u0435 \u0434\u043b\u044f \u042f\u0433\u043e \u0436\u044b\u0432\u0443\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u044f\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"331","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0401\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">2, 21 \u2013 3, 5<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0437\u044f\u043c\u043b\u044f, \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f \u0456 \u0440\u0430\u0434\u0443\u0439\u0441\u044f, \u0431\u043e \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b! \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f, \u0434\u0437\u0456\u043a\u0456\u044f \u0436\u044b\u0432\u0451\u043b\u044b, \u0431\u043e \u0437\u0435\u043b\u044f\u043d\u0435\u044e\u0446\u044c \u0443\u0436\u043e \u043f\u0443\u0441\u0442\u044b\u043d\u043d\u044b\u044f \u043f\u0430\u0448\u044b, \u0434\u0440\u044d\u0432\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u043f\u043b\u043e\u0434, \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u0430 \u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u043b\u0430\u0434\u0430\u043d\u043e\u0441\u044f\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0432\u044b, \u0441\u044b\u043d\u044b \u0421\u0456\u0451\u043d\u0430, \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u0456 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u044b\u043c, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u0432\u0430\u043c \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0406 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0432\u0430\u043c \u0434\u043e\u0436\u0434\u0436, \u0440\u0430\u043d\u043d\u0456 \u0456 \u043f\u043e\u0437\u043d\u0456 \u044f\u043a \u0434\u0430\u045e\u043d\u0435\u0439. \u0417\u0431\u043e\u0436\u0436\u0430\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u043a\u0456, \u0430 \u0434\u0430\u0432\u0456\u043b\u044b \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0432\u0456\u043d\u043e\u043c \u0456 \u0430\u043b\u0435\u0435\u043c. \u042f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0443 \u0432\u0430\u043c \u0437\u0430 \u0433\u0430\u0434\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u0436\u044d\u0440\u043b\u0430 \u0441\u0430\u0440\u0430\u043d\u0447\u0430, \u043a\u043e\u043d\u0456\u043a, \u0447\u0430\u0440\u0432\u044f\u043a \u0456 \u0432\u0443\u0441\u0435\u043d\u044c \u2013 \u041c\u0430\u0451 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430, \u044f\u043a\u043e\u0435 \u042f \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0432\u0430\u0441. \u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0435\u0436\u0443 \u0456 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0435\u0441\u044f, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0437 \u0432\u0430\u043c\u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0440\u044d\u0447\u044b, \u0456 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u043e\u0440\u0430\u043c\u0443 \u043d\u0430\u0432\u0435\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u2013 \u0441\u044f\u0440\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0456 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u043e\u0440\u0430\u043c\u0443 \u043d\u0430\u0432\u0435\u043a\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u043f\u0430\u0441\u043b\u044f \u042f \u043f\u0440\u0430\u043b\u044c\u044e \u041c\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0441\u044b\u043d\u044b \u0456 \u0432\u0430\u0448\u044b\u044f \u0434\u043e\u0447\u043a\u0456; \u0441\u0442\u0430\u0440\u0446\u0430\u043c \u0432\u0430\u0448\u044b\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043d\u0456\u0446\u0446\u0430 \u0441\u043d\u044b, \u0430 \u044e\u043d\u0430\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0456\u0437\u0456\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u041c\u0430\u0456\u0445 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446 \u0443 \u0442\u044b\u044f \u0434\u043d\u0456 \u042f \u043f\u0440\u0430\u043b\u044c\u044e \u041c\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430. \u0423\u0447\u044b\u043d\u044e \u0446\u0443\u0434\u044b \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456: \u043a\u0440\u043e\u045e, \u0430\u0433\u043e\u043d\u044c \u0456 \u0441\u043b\u0443\u043f\u044b \u0434\u044b\u043c\u0443. \u0421\u043e\u043d\u0446\u0430 \u0430\u0431\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0446\u0435\u043c\u0440\u0443, \u0430 \u043c\u0435\u0441\u044f\u0446 \u2013 \u0443 \u043a\u0440\u043e\u045e, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0441\u0442\u0440\u0430\u0448\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430, \u0431\u043e \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d \u0456 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u0456 \u0441\u044f\u0440\u043e\u0434 \u0430\u0446\u0430\u043b\u0435\u043b\u044b\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 21, 25\u0430. 31; \u041c\u043a 13, 33<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u0443\u0434\u0443\u0446\u044c \u0437\u043d\u0430\u043a\u0456 \u043d\u0430 \u0441\u043e\u043d\u0446\u044b, \u043c\u0435\u0441\u044f\u0446\u044b \u0456 \u0437\u043e\u0440\u043a\u0430\u0445, \u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u2013 \u0442\u0440\u044b\u0432\u043e\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0430\u0441\u044f \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0447\u0443\u0432\u0430\u0439\u0446\u0435, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0442\u043e\u0439 \u0447\u0430\u0441. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"332","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0401\u044d\u043b\u044f <\/span><span style=\"color: #ff0000;\">4, 1-3. 9-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u043e\u0448\u043d\u0456 \u0441\u0443\u0434 \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0412\u043e\u0441\u044c \u0443 \u0442\u044b\u044f \u0434\u043d\u0456 \u0456 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0430\u0434\u043c\u044f\u043d\u044e \u043b\u0451\u0441 \u042e\u0434\u044b \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u042f \u0437\u0431\u044f\u0440\u0443 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445 \u0443 \u0434\u0430\u043b\u0456\u043d\u0443 \u042f\u0437\u0430\u0444\u0430\u0442\u0430 \u0456 \u0442\u0430\u043c \u0431\u0443\u0434\u0443 \u0441\u0443\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456 \u0437\u0430 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0437\u0430 \u041c\u0430\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456 \u044f\u043d\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0456 \u041c\u0430\u044e \u0437\u044f\u043c\u043b\u044e. \u041a\u0456\u0434\u0430\u043b\u0456 \u043b\u0451\u0441\u044b \u0430\u0431 \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0437\u0435, \u0445\u043b\u043e\u043f\u0446\u0430 \u0432\u044b\u0434\u0430\u0432\u0430\u043b\u0456 \u0437\u0430 \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0443, \u0430 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0443 \u043f\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456 \u0437\u0430 \u0432\u0456\u043d\u043e \u0456 \u043f\u0456\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0440\u044b\u0447\u044b\u0446\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0437\u0440\u0430\u0431\u0456\u0446\u0435 \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u0430\u0439\u043d\u0443, \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u0435 \u0432\u0430\u044f\u0440\u043e\u045e! \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u044b\u0434\u0443\u0446\u044c \u0456 \u0432\u044b\u0441\u0442\u0443\u043f\u044f\u0446\u044c \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0432\u0430\u0439\u043d\u044b. \u041f\u0435\u0440\u0430\u043a\u0443\u0439\u0446\u0435 \u043f\u043b\u0443\u0433\u0456 \u0432\u0430\u0448\u044b\u044f \u043d\u0430 \u043c\u044f\u0447\u044b, \u0456 \u0441\u044f\u0440\u043f\u044b \u0432\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0437\u0456\u0434\u044b. \u041d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430 \u0441\u043b\u0430\u0431\u044b: \u201c\u042f \u2013 \u0432\u0430\u044f\u0440\u201d. \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443, \u0443\u0441\u0435 \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0437\u0431\u044f\u0440\u044b\u0446\u0435\u0441\u044f \u0442\u0430\u043c! \u041f\u0430\u043d\u0435, \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0442\u0443\u0434\u044b \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u044f\u0440\u043e\u045e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0430\u0431\u0443\u0434\u0437\u044f\u0446\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0443 \u0434\u0430\u043b\u0456\u043d\u0443 \u042f\u0437\u0430\u0444\u0430\u0442\u0430, \u0431\u043e \u042f \u0441\u044f\u0434\u0443 \u0442\u0430\u043c, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b. \u041f\u0443\u0441\u0446\u0456\u0446\u0435 \u0441\u0435\u0440\u043f, \u0431\u043e \u0436\u043d\u0456\u0432\u043e \u0441\u0430\u0441\u043f\u0435\u043b\u0430. \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0456 \u0442\u0430\u045e\u0447\u044b\u0446\u0435, \u0431\u043e \u0434\u0430\u0432\u0456\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0435, \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u043a\u0430\u0434\u0437\u044f\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u0445 \u0437\u043b\u043e. \u041d\u0430\u0442\u043e\u045e\u043f\u044b, \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043d\u0430\u0442\u043e\u045e\u043f\u044b \u045e \u0434\u0430\u043b\u0456\u043d\u0435 \u041f\u0440\u044b\u0441\u0443\u0434\u0443, \u0431\u043e \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u045e \u0434\u0430\u043b\u0456\u043d\u0435 \u041f\u0440\u044b\u0441\u0443\u0434\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043e\u043d\u0446\u0430 \u0456 \u043c\u0435\u0441\u044f\u0446 \u043f\u0430\u0446\u044f\u043c\u043d\u0435\u043b\u0456, \u0437\u043e\u0440\u043a\u0456 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u0441\u0432\u043e\u0439 \u0431\u043b\u044f\u0441\u043a. \u0411\u0443\u0434\u0437\u0435 \u0433\u0440\u044b\u043c\u0435\u0446\u044c \u041f\u0430\u043d \u0437 \u0421\u0456\u0451\u043d\u0430 \u0456 \u043f\u0430\u0434\u044b\u043c\u0435 \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439 \u0437&nbsp; \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0417\u0430\u0442\u0440\u0430\u0441\u0443\u0446\u0446\u0430 \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0437\u044f\u043c\u043b\u044f, \u0430\u043b\u0435 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430\u043c \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f\u0439 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0422\u0430\u0434\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u042f \u2013 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b. \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0441\u0442\u0430\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u043c, \u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0437 \u044f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0433\u043e\u0440\u044b \u0437\u0430\u0441\u043e\u0447\u0430\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0432\u0456\u043d\u043e\u043c, \u0430 \u0437 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u045e \u043f\u0430\u0446\u044f\u0447\u044d \u043c\u0430\u043b\u0430\u043a\u043e, \u0456 \u045e\u0441\u0435 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u044f \u0440\u044d\u0447\u044b\u0448\u0447\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0432\u0430\u0434\u043e\u044e, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043f\u0430\u0446\u044f\u0447\u044d \u0437 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0437\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0434\u0430\u043b\u0456\u043d\u0443 \u0428\u044b\u0446\u0456\u043c. \u0415\u0433\u0456\u043f\u0435\u0442 \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u043f\u0443\u0441\u0442\u044d\u043b\u044c\u043d\u044e, \u0430 \u042d\u0434\u043e\u043c \u2013 \u0443 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b \u0441\u0442\u044d\u043f \u0437\u0430 \u045e\u0446\u0456\u0441\u043a \u0441\u044b\u043d\u043e\u045e \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u0456 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u0451 \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u043d\u0430 \u0456\u0445\u043d\u044f\u0439 \u0437\u044f\u043c\u043b\u0456. \u042e\u0434\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0441\u0435\u043b\u0435\u043d\u0430 \u043d\u0430\u0432\u0435\u043a\u0456, \u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u2013 \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435. \u042f \u0430\u0434\u043f\u043e\u043c\u0448\u0447\u0443 \u0437\u0430 \u0456\u0445\u043d\u044e\u044e \u043a\u0440\u043e\u045e, \u0437\u0430 \u044f\u043a\u0443\u044e \u044f\u0448\u0447\u044d \u043d\u0435 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e, \u0456 \u041f\u0430\u043d \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0401\u044d\u043b 4, 18; \u0410\u043f 22, 17\u0441. 1<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u043e\u0440\u044b \u0437\u0430\u0441\u043e\u0447\u0430\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0432\u0456\u043d\u043e\u043c, \u0430 \u0437 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u045e \u043f\u0430\u0446\u044f\u0447\u044d \u043c\u0430\u043b\u0430\u043a\u043e, \u0456 \u045e\u0441\u0435 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u044f \u0440\u044d\u0447\u044b\u0448\u0447\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0432\u0430\u0434\u043e\u044e, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043f\u0430\u0446\u044f\u0447\u044d \u0437 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430, \u043d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u0432\u0430\u0434\u0443 \u0436\u044b\u0446\u0446\u044f \u0434\u0430\u0440\u043c\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u043d\u0451\u043b \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0440\u0430\u043a\u0443 \u0432\u0430\u0434\u044b \u0436\u044b\u0446\u0446\u044f, \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0443\u044e, \u044f\u043a \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c, \u044f\u043a\u0430\u044f \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u043b\u0430 \u0430\u0434 \u0442\u0440\u043e\u043d\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"333","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">9, 1 \u2013 10, 2<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0421\u0456\u0451\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u0456 \u0425\u0430\u0434\u0440\u0430\u0445\u0430 \u0456 \u0414\u0430\u043c\u0430\u0441\u043a\u0430, \u043c\u0435\u0441\u0446\u0430 \u042f\u0433\u043e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u0431\u043e \u0434\u0430 \u041f\u0430\u043d\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0432\u043e\u043a\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0425\u0430\u043c\u0430\u0442 \u043c\u044f\u0436\u0443\u0435 \u0437 \u0456\u043c, \u0422\u044b\u0440 \u0456 \u0421\u0456\u0434\u043e\u043d, \u0431\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u0443\u0434\u0440\u044b\u044f. \u0422\u044b\u0440 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e \u0456 \u043d\u0430\u0437\u0431\u0456\u0440\u0430\u045e \u0441\u0440\u044d\u0431\u0440\u0430, \u044f\u043a \u043f\u044f\u0441\u043a\u0443, \u0456 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a \u0432\u0443\u043b\u0456\u0447\u043d\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443. \u0412\u043e\u0441\u044c \u041f\u0430\u043d \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0435 \u0456\u043c \u0434\u044b \u043a\u0456\u043d\u0435 \u045e \u043c\u043e\u0440\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0430 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u2019\u0435\u0434\u0437\u0435\u043d\u044b \u0430\u0433\u043d\u0451\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0448\u043a\u0435\u043b\u043e\u043d \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430, \u0430 \u0413\u0430\u0437\u0430 \u043c\u043e\u0446\u043d\u0430 \u0437\u0430\u0434\u0440\u044b\u0436\u044b\u0446\u044c, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042d\u043a\u0440\u043e\u043d, \u0431\u043e \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u041a\u0430\u0440\u043e\u043b\u044c \u0437\u043d\u0456\u043a\u043d\u0435 \u0437 \u0413\u0430\u0437\u044b, \u0430 \u045e \u0410\u0448\u043a\u0435\u043b\u043e\u043d\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e. \u0423 \u0410\u0448\u0434\u043e\u0434\u0437\u0435 \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u0432\u044b\u0440\u0430\u0434\u0430\u043a, \u0430 \u043f\u044b\u0445\u0443 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e \u042f \u0437\u043d\u0456\u0448\u0447\u0443. \u042f \u0430\u0447\u044b\u0448\u0447\u0443 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u0456 \u0437\u0443\u0431\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u0434 \u0431\u0440\u044b\u0434\u043e\u0442\u044b. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0431\u0443\u0434\u0437\u0435 \u043d\u0456\u0431\u044b \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u045e \u042e\u0434\u0437\u0435, \u0430 \u042d\u043a\u0440\u043e\u043d, \u044f\u043a \u0435\u0432\u0443\u0441\u0435\u0439. \u042f \u0441\u0442\u0430\u043d\u0443 \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u041c\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0456\u043c\u0430 \u0456 \u0445\u0442\u043e \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430. \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u0456\u0445 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a, \u0431\u043e \u0446\u044f\u043f\u0435\u0440 \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0420\u0430\u0434\u0443\u0439\u0441\u044f \u043c\u043e\u0446\u043d\u0430, \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430. \u0412\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0434\u0430\u0447\u043a\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430! \u0412\u043e\u0441\u044c \u043a\u0430\u0440\u043e\u043b\u044c \u0442\u0432\u043e\u0439 \u0456\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0437\u0431\u0430\u045e\u0447\u044b \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u044f\u043a\u0456 \u0435\u0434\u0437\u0435 \u043d\u0430 \u0430\u0441\u043b\u0435, \u043d\u0430 \u0430\u0441\u043b\u044f\u043d\u044f\u0446\u0456, \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u0430\u0441\u043b\u0456\u0446\u044b. \u042f \u0437\u043d\u0456\u0448\u0447\u0443 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0437 \u042d\u0444\u0440\u0430\u0456\u043c\u0430 \u0456 \u043a\u043e\u043d\u0435\u0439 \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0456 \u0437\u043b\u0430\u043c\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u044f\u0432\u044b \u043b\u0443\u043a. \u0410 \u0451\u043d \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043c\u0456\u0440, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434 \u043c\u043e\u0440\u0430 \u0434\u0430 \u043c\u043e\u0440\u0430 \u0456 \u0430\u0434 \u0420\u0430\u043a\u0456 \u0430\u0436 \u0434\u0430 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0437 \u0442\u0430\u0431\u043e\u044e \u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044f\u0437\u043d\u044f\u045e \u0442\u0432\u0430\u0456\u0445 \u0437 \u0446\u044b\u0441\u0442\u044d\u0440\u043d\u044b \u0431\u0435\u0437 \u0432\u0430\u0434\u044b. \u0412\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e, \u0432\u044f\u0437\u043d\u0456 \u043d\u0430\u0434\u0437\u0435\u0456! \u0421\u0451\u043d\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e, \u0448\u0442\u043e \u0432\u044f\u0440\u043d\u0443 \u0442\u0430\u0431\u0435 \u045e\u0434\u0432\u0430\u044f. \u0411\u043e \u042f \u043d\u0430\u0446\u044f\u0433\u043d\u0443 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u042e\u0434\u0443, \u044f\u043a \u043b\u0443\u043a, \u0443 \u044f\u043a\u0456 \u045e\u043a\u043b\u0430\u0434\u0443 \u044f\u043a \u0441\u0442\u0440\u0430\u043b\u0443 \u042d\u0444\u0440\u0430\u0456\u043c\u0430, \u0456 \u0430\u0431\u0443\u0434\u0436\u0443 \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0421\u0456\u0451\u043d, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445, \u042f\u0432\u0430\u043d, \u0456 \u045e\u0447\u044b\u043d\u044e \u0437 \u0446\u044f\u0431\u0435 \u043c\u0435\u0447 \u0432\u0430\u044f\u0440\u0430. \u0422\u0430\u0434\u044b \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0434 \u0456\u043c\u0456 \u041f\u0430\u043d! \u042f\u043a \u043c\u0430\u043b\u0430\u043d\u043a\u0430 \u043f\u0430\u043b\u044f\u0446\u0456\u0446\u044c \u044f\u0433\u043e \u0441\u0442\u0440\u0430\u043b\u0430. \u041f\u0430\u043d \u0411\u043e\u0433 \u0437\u0430\u0434\u0437\u044c\u043c\u0435 \u045e \u0440\u043e\u0433 \u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0431\u0443\u0440 \u0422\u044d\u043c\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0446\u044c \u0456\u0445, \u0456 \u044f\u043d\u044b \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u0456 \u0441\u043a\u0440\u044b\u0448\u0430\u0446\u044c \u043a\u0430\u043c\u044f\u043d\u0456 \u043f\u0440\u0430\u0448\u0447\u044b. \u0411\u0443\u0434\u0443\u0446\u044c \u043f\u0456\u0446\u044c, \u0448\u0443\u043c\u0435\u0446\u044c, \u044f\u043a \u0432\u0456\u043d\u043e, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430, \u044f\u043a \u0447\u0430\u0448\u0430, \u044f\u043a \u0440\u043e\u0433\u0456 \u0430\u043b\u0442\u0430\u0440\u0430. \u0410 \u041f\u0430\u043d, \u0456\u0445\u043d\u0456 \u0411\u043e\u0433, \u0443\u0440\u0430\u0442\u0443\u0435 \u0456\u0445 \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u044f\u043a \u0441\u0442\u0430\u0442\u0430\u043a \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0431\u043e \u044f\u043d\u044b \u0437\u0437\u044f\u044e\u0446\u044c \u043d\u0430\u0434 \u042f\u0433\u043e \u0437\u044f\u043c\u043b\u0451\u0439 \u043d\u0456\u0431\u044b \u043a\u0430\u043c\u044f\u043d\u0456 \u0434\u044b\u044f\u0434\u044d\u043c\u044b. \u041e, \u044f\u043a\u043e\u0435 \u0436 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u043e \u0456 \u044f\u043a\u0430\u044f \u042f\u0433\u043e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c! \u0417\u0431\u043e\u0436\u0436\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0440\u0430\u0441\u0446\u0456 \u044e\u043d\u0430\u043a\u0430\u043c, \u0430 \u043c\u0430\u043b\u0430\u0434\u043e\u0435 \u0432\u0456\u043d\u043e \u2013 \u0434\u0437\u044f\u045e\u0447\u0430\u0442\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u045e \u041f\u0430\u043d\u0430 \u0434\u0430\u0436\u0434\u0436\u0443 \u045e \u0447\u0430\u0441 \u043f\u043e\u0437\u043d\u0456\u0445 \u0434\u0430\u0436\u0434\u0436\u043e\u045e. \u041f\u0430\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u0446\u044b \u0456 \u0434\u0430\u0435 \u0432\u0430\u043c \u043c\u043e\u0446\u043d\u044b \u043b\u0456\u0432\u0435\u043d\u044c, \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435 \u0437\u044f\u043b\u0435\u043d\u0456\u0432\u0430 \u043d\u0430 \u043f\u043e\u043b\u0456. \u0411\u043e \u0431\u0430\u0436\u043a\u0456 \u0445\u043b\u0443\u0441\u044f\u0446\u044c, \u0430 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u044b \u043c\u0430\u044e\u0446\u044c \u0456\u043b\u0436\u044b\u0432\u044b\u044f \u0432\u0456\u0437\u0456\u0456, \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430 \u0442\u043b\u0443\u043c\u0430\u0447\u0430\u0446\u044c \u0441\u043d\u044b, \u0441\u0443\u0446\u044f\u0448\u0430\u044e\u0446\u044c \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044e. \u0422\u0430\u043c\u0443 \u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043d\u044b \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u044f, \u0431\u043e \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0417\u0430\u0445 9, 9; \u042f\u043d 12, 14<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0420\u0430\u0434\u0443\u0439\u0441\u044f \u043c\u043e\u0446\u043d\u0430, \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430! \u0412\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0434\u0430\u0447\u043a\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430! <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0412\u043e\u0441\u044c \u043a\u0430\u0440\u043e\u043b\u044c \u0442\u0432\u043e\u0439 \u0456\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0431\u0430\u045e\u0447\u044b \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u044f\u043a\u0456 \u0435\u0434\u0437\u0435 \u043d\u0430 \u0430\u0441\u043b\u0435, \u043d\u0430 \u0430\u0441\u043b\u044f\u043d\u044f\u0446\u0456, \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u0430\u0441\u043b\u0456\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0415\u0437\u0443\u0441 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0430\u0441\u043b\u044f\u043d\u044f \u0456 \u0441\u0435\u045e \u043d\u0430 \u044f\u0433\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u043e\u0441\u044c \u043a\u0430\u0440\u043e\u043b\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"334","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">10, 3 \u2013 11, 3<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0417\u0430\u043f\u0430\u043b\u0430\u045e \u041c\u043e\u0439 \u0433\u043d\u0435\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0456 \u042f \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u0437 \u0433\u044d\u0442\u044b\u0445 \u043a\u0430\u0437\u043b\u043e\u045e. \u0411\u043e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0437\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a, \u0434\u043e\u043c \u042e\u0434\u044b, \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0437 \u0456\u0445 \u044f\u043a \u0431\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u043a\u0430\u043d\u044f. \u0417 \u044f\u0433\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0437 \u044f\u0433\u043e \u2013 \u043f\u0430\u0434\u043f\u043e\u0440\u0430, \u0437 \u044f\u0433\u043e \u2013 \u0432\u0430\u0435\u043d\u043d\u044b \u043b\u0443\u043a, \u0437 \u044f\u0433\u043e \u0432\u044b\u0439\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0443\u0441\u0435 \u043f\u0440\u0430\u0432\u0456\u0446\u0435\u043b\u0456. \u0406 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0432\u0430\u044f\u0440\u044b, \u044f\u043a\u0456\u044f \u045e\u0442\u043e\u043f\u0442\u0432\u0430\u044e\u0446\u044c \u0432\u0443\u043b\u0456\u0447\u043d\u044b \u0431\u0440\u0443\u0434 \u043f\u0430\u0434\u0447\u0430\u0441 \u0431\u0456\u0442\u0432\u044b. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430, \u0431\u043e \u041f\u0430\u043d \u0437 \u0456\u043c\u0456, \u0456 \u0430\u0441\u0430\u0440\u043e\u043c\u044f\u0446\u0446\u0430 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u043d\u0430 \u043a\u043e\u043d\u044f\u0445. \u042f \u045e\u043c\u0430\u0446\u0443\u044e \u0434\u043e\u043c \u042e\u0434\u044b, \u0430 \u0434\u043e\u043c \u042e\u0437\u0430\u0444\u0430 \u045e\u0440\u0430\u0442\u0443\u044e \u0456 \u0432\u044f\u0440\u043d\u0443 \u0456\u0445, \u0431\u043e \u0430\u043a\u0430\u0436\u0443 \u0456\u043c \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u044b\u0446\u0446\u0430\u043c \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u042f \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u045e, \u0431\u043e \u042f \u2013 \u041f\u0430\u043d, \u0456\u0445\u043d\u0456 \u0411\u043e\u0433, \u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u044e \u0456\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042d\u0444\u0440\u0430\u0456\u043c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0432\u0430\u044f\u0440\u0430, \u0430 \u0456\u0445\u043d\u044f\u0435 \u0441\u044d\u0440\u0446\u0430 \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u044f\u043a \u043f\u0430\u0441\u043b\u044f \u0432\u0456\u043d\u0430. \u0421\u044b\u043d\u044b \u0456\u0445\u043d\u0456\u044f \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0456 \u045e\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430, \u0456 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430 \u0456\u0445\u043d\u044f\u0435 \u045e \u041f\u0430\u043d\u0443. \u0417\u0430\u0441\u0432\u0456\u0448\u0447\u0443 \u0456\u043c \u0456 \u0437\u0431\u044f\u0440\u0443 \u0456\u0445, \u0431\u043e \u042f \u0430\u0434\u043a\u0443\u043f\u043b\u044e \u0456\u0445, \u0456 \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456, \u044f\u043a \u0431\u044b\u043b\u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u0440\u0430\u043d\u0435\u0439. \u042f \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u044e \u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0430\u043b\u0435 \u045e \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u043a\u0440\u0430\u044f\u0445 \u044f\u043d\u044b \u045e\u0441\u043f\u043e\u043c\u043d\u044f\u0446\u044c \u043f\u0440\u0430 \u041c\u044f\u043d\u0435, \u0456\u0445 \u0441\u044b\u043d\u044b \u0432\u044b\u0436\u044b\u0432\u0443\u0446\u044c \u0456 \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0432\u044f\u0440\u043d\u0443 \u0456\u0445 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0437 \u0410\u0441\u0456\u0440\u044b\u0456. \u041f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445 \u0443 \u0437\u044f\u043c\u043b\u044e \u0413\u0456\u043b\u0435\u0430\u0434 \u0456 \u043d\u0430 \u041b\u0456\u0431\u0430\u043d, \u0456 \u043d\u0435 \u0445\u043e\u043f\u0456\u0446\u044c \u0434\u043b\u044f \u0456\u0445 \u043c\u0435\u0441\u0446\u0430. \u042f\u043d\u044b \u043f\u0440\u043e\u0439\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u042f \u045e\u0434\u0430\u0440\u0443 \u045e \u0445\u0432\u0430\u043b\u0456 \u043c\u043e\u0440\u0430, \u0456 \u0432\u044b\u0441\u0430\u0445\u043d\u0443\u0446\u044c \u0443\u0441\u0435 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u041d\u0456\u043b\u0430. \u0423\u043f\u0430\u0434\u0437\u0435 \u043f\u044b\u0445\u0430 \u0410\u0441\u0456\u0440\u044b\u0456, \u0430 \u0436\u0430\u0437\u043b\u043e \u0415\u0433\u0456\u043f\u0442\u0430 \u0437\u043d\u0456\u043a\u043d\u0435. \u042f&nbsp; \u045e\u043c\u0430\u0446\u0443\u044e \u0456\u0445 \u0443 \u041f\u0430\u043d\u0443 \u0456 \u045e \u042f\u0433\u043e \u0456\u043c\u044f \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043a\u0440\u044b\u0439, \u041b\u0456\u0431\u0430\u043d, \u0441\u0432\u0430\u0435 \u0432\u0430\u0440\u043e\u0442\u044b, \u043d\u044f\u0445\u0430\u0439 \u0430\u0433\u043e\u043d\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0442\u0432\u0430\u0435 \u043a\u0435\u0434\u0440\u044b. \u0413\u0430\u043b\u0430\u0441\u0456, \u043a\u0456\u043f\u0430\u0440\u044b\u0441, \u0431\u043e \u045e\u043f\u0430\u045e \u043a\u0435\u0434\u0440, \u0431\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0432\u0435\u043b\u0456\u0447. \u0413\u0430\u043b\u0430\u0441\u0456\u0446\u0435, \u0434\u0443\u0431\u044b \u0411\u0430\u0448\u0430\u043d\u0430, \u0431\u043e \u043f\u0430\u0432\u0430\u043b\u0435\u043d\u044b \u0432\u0435\u043a\u0430\u0432\u044b \u043b\u0435\u0441. \u0427\u0443\u0442\u043d\u044b \u043a\u0440\u044b\u043a \u0433\u0430\u043b\u0430\u0448\u044d\u043d\u043d\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0431\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0456\u0445\u043d\u044f\u044f \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c. \u0427\u0443\u0442\u043d\u044b \u0440\u044b\u043a \u0456\u043b\u044c\u0432\u044f\u043d\u044f\u0446\u0456, \u0431\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0433\u043e\u043d\u0430\u0440 \u042f\u0440\u0434\u0430\u043d\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0417\u0430\u0445 10, 6bd. 7d; \u0406\u0441 28, 5<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u0456 \u0432\u044f\u0440\u043d\u0443 \u0456\u0445, \u0430\u043a\u0430\u0436\u0443 \u0456\u043c \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u042f \u041f\u0430\u043d, \u0456\u0445\u043d\u0456 \u0411\u043e\u0433. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0406 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430 \u0456\u0445\u043d\u044f\u0435 \u045e \u041f\u0430\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u043e\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439 \u0434\u044b\u044f\u0434\u044d\u043c\u0430\u0439 \u0434\u043b\u044f \u0440\u044d\u0448\u0442\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"335","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">11, 4 \u2013 12, 8<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044c \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u043c\u043e\u0439 \u0411\u043e\u0433: \u00ab\u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437. \u0422\u044b\u044f, \u0445\u0442\u043e \u043a\u0443\u043f\u043b\u044f\u0435 \u0456\u0445, \u0437\u0430\u0440\u0430\u0437\u0430\u044e\u0446\u044c \u0456\u0445 \u0456 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c\u0456, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u0434\u0430\u0435 \u0456\u0445, \u043a\u0430\u0436\u0443\u0446\u044c: \u201c\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0431\u043e \u044f \u0441\u0442\u0430\u045e \u0431\u0430\u0433\u0430\u0442\u044b\u043c\u201d. \u041f\u0430\u0441\u0442\u044b\u0440\u044b \u0456\u0445\u043d\u0456\u044f \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e\u0446\u044c \u0456\u0445. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u0412\u043e\u0441\u044c \u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0456 \u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u044f. \u042f\u043d\u044b \u0437\u0440\u0443\u0439\u043d\u0443\u044e\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0456 \u042f \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u044e \u043d\u0456\u043a\u043e\u0433\u0430 \u0437 \u0456\u0445\u043d\u0456\u0445 \u0440\u0443\u043a\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043f\u0430\u0441\u0432\u0456\u045e \u0430\u0432\u0435\u0447\u0430\u043a, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u0431\u043e \u0431\u0435\u0434\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u0430\u0432\u0435\u0447\u043a\u0456, \u0456 \u045e\u0437\u044f\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0434\u0432\u0430 \u043a\u0456\u0456. \u0410\u0434\u0437\u0456\u043d \u043d\u0430\u0437\u0432\u0430\u045e \u00ab\u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c\u00bb, \u0434\u0440\u0443\u0433\u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u00ab\u0435\u0434\u043d\u0430\u0441\u0446\u044c\u00bb. \u0422\u0430\u043a \u043f\u0430\u0441\u0432\u0456\u045e \u0430\u0432\u0435\u0447\u0430\u043a. \u0417\u0430 \u0430\u0434\u0437\u0456\u043d \u043c\u0435\u0441\u044f\u0446 \u044f \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0442\u0440\u043e\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e. \u041c\u0430\u044f \u0434\u0443\u0448\u0430 \u0441\u0442\u0430\u043c\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0456\u0445, \u0430 \u0456\u0445\u043d\u0456 \u0434\u0443\u0445 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0447\u0430\u045e \u0431\u0440\u044b\u0434\u0437\u0456\u0446\u0446\u0430 \u041c\u043d\u043e\u044e. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u042f: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0443 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0441 \u043f\u0430\u0441\u0432\u0456\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0433\u0456\u043d\u0435 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u0433\u0456\u043d\u0435, \u0430 \u0442\u044b\u044f, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0437\u2019\u044f\u0434\u0443\u0446\u044c \u0446\u0435\u043b\u0430 \u0430\u0434\u043d\u0430 \u0430\u0434\u043d\u043e\u0439\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u045e\u0437\u044f\u045e \u044f \u0441\u0432\u043e\u0439 \u043a\u0456\u0439 \u00ab\u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c\u00bb, \u0456 \u0440\u0430\u0441\u0441\u0435\u043a \u044f\u0433\u043e, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u0446\u044c \u041c\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456. \u0406 \u0451\u043d \u0431\u044b\u045e \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043d\u044b \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c. \u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0431\u0435\u0434\u043d\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043a\u0456\u044f \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u043c\u044f\u043d\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430. \u0410 \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: \u00ab\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u0430 \u045e \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445, \u0442\u043e \u0434\u0430\u0439\u0446\u0435 \u043c\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u043d\u0443\u044e \u043f\u043b\u0430\u0442\u0443, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435, \u0430\u0434\u043c\u043e\u045e\u0446\u0435\u0441\u044f\u00bb. \u0422\u0430\u0434\u044b \u044f\u043d\u044b \u0430\u0434\u0432\u0430\u0436\u044b\u043b\u0456 \u043c\u043d\u0435 \u043f\u043b\u0430\u0442\u0443 \u2013 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0441\u044f\u0440\u044d\u0431\u0440\u0430\u043d\u0456\u043a\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u043d\u0435: \u00ab\u041a\u0456\u043d\u044c \u0433\u0430\u043d\u0447\u0430\u0440\u0443 \u0442\u0443\u044e \u043f\u0440\u044b\u0433\u043e\u0436\u0443\u044e \u0446\u0430\u043d\u0443, \u044f\u043a\u043e\u0439 \u044f\u043d\u044b \u0430\u0446\u0430\u043d\u0456\u043b\u0456 \u041c\u044f\u043d\u0435\u00bb. \u042f \u045e\u0437\u044f\u045e \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430\u043d\u0456\u043a\u0430\u045e \u0456 \u043a\u0456\u043d\u0443\u045e \u0456\u0445 \u0433\u0430\u043d\u0447\u0430\u0440\u0443 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430. \u041f\u0430\u0441\u043b\u044f \u0437\u043b\u0430\u043c\u0430\u045e \u0441\u0432\u043e\u0439 \u0434\u0440\u0443\u0433\u0456 \u043a\u0456\u0439 \u2013 \u00ab\u0435\u0434\u043d\u0430\u0441\u0446\u044c\u00bb, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u0446\u044c \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430 \u043f\u0430\u043c\u0456\u0436 \u042e\u0434\u0430\u0439 \u0456 \u043f\u0430\u043c\u0456\u0436 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: \u00ab\u0417\u043d\u043e\u045e \u0432\u0430\u0437\u044c\u043c\u0456 \u0441\u0430\u0431\u0435 \u043f\u0440\u044b\u043b\u0430\u0434\u0443 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430. \u0411\u043e \u0432\u043e\u0441\u044c \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u044f\u043a\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0433\u0456\u043d\u0443\u0446\u044c, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0456 \u043f\u0430\u043a\u0430\u043b\u0435\u0447\u0430\u043d\u044b\u0445 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043b\u044f\u0447\u044b\u0446\u044c, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0442\u044b\u0445, \u0448\u0442\u043e \u0441\u0442\u0430\u044f\u0446\u044c, \u0430\u043b\u0435 \u0437\u2019\u0435\u0441\u0446\u044c \u043c\u044f\u0441\u0430 \u0442\u043b\u0443\u0441\u0442\u0430\u0439 \u0456 \u043f\u0430\u0430\u0431\u0440\u044b\u0432\u0430\u0435 \u0456\u0445 \u043a\u0430\u043f\u044b\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u044b\u0440\u0443, \u044f\u043a\u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u041d\u044f\u0445\u0430\u0439 \u043c\u0435\u0447 \u0443\u043f\u0430\u0434\u0437\u0435 \u044f\u043c\u0443 \u043d\u0430 \u043f\u043b\u044f\u0447\u043e \u0456 \u043d\u0430 \u044f\u0433\u043e \u043f\u0440\u0430\u0432\u0430\u0435 \u0432\u043e\u043a\u0430. \u041d\u044f\u0445\u0430\u0439 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0441\u043e\u0445\u043d\u0435 \u044f\u0433\u043e \u043f\u043b\u044f\u0447\u043e, \u0430 \u044f\u0433\u043e \u043f\u0440\u0430\u0432\u0430\u0435 \u0432\u043e\u043a\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0441\u043b\u0435\u043f\u043d\u0435\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u043f\u0440\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u041a\u0430\u0436\u0430 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0440\u0430\u0441\u0446\u044f\u0433\u0432\u0430\u0435 \u043d\u044f\u0431\u0451\u0441\u044b, \u043a\u043b\u0430\u0434\u0437\u0435 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0444\u0430\u0440\u043c\u0443\u0435 \u0434\u0443\u0445 \u0443\u043d\u0443\u0442\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u043e\u0441\u044c \u042f \u045e\u0447\u044b\u043d\u044e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0447\u0430\u0448\u0430\u044e \u0430\u043f\u2019\u044f\u043d\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042e\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u043b\u043e\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u042f \u045e\u0447\u044b\u043d\u044e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0446\u044f\u0436\u043a\u0456\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u0434\u044b\u043c\u0435 \u044f\u0433\u043e, \u043c\u043e\u0446\u043d\u0430 \u0441\u043a\u0430\u043b\u0435\u0447\u044b\u0446\u0446\u0430. \u0410 \u0437\u0431\u044f\u0440\u0443\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u044f\u043c\u043b\u0456. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u042f \u045e\u0434\u0430\u0440\u0443 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043a\u0430\u043d\u044f \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043c, \u0430 \u044f\u0433\u043e \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430\u043c. \u0410\u043b\u0435 \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u0432\u043e\u0447\u044b, \u0442\u0430\u043c\u0443 \u045e\u0434\u0430\u0440\u0443 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043a\u0430\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0441\u043b\u0435\u043f\u0430\u0442\u043e\u044e. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u042e\u0434\u044b \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b: \u201c\u041c\u0430\u044f \u0441\u0456\u043b\u0430 \u2013 \u0436\u044b\u0445\u0430\u0440\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u041f\u0430\u043d\u0443 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433\u0443 \u0456\u0445\u043d\u0456\u043c\u201d. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u044f \u045e\u0447\u044b\u043d\u044e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u042e\u0434\u044b \u043d\u0456\u0431\u044b \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0439 \u0436\u0430\u0440\u043e\u045e\u043d\u044f\u0439 \u0441\u044f\u0440\u043e\u0434 \u0434\u0440\u044d\u0432\u0430 \u0456 \u043d\u0456\u0431\u044b \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0439 \u043f\u0430\u0445\u043e\u0434\u043d\u044f\u0439 \u0441\u044f\u0440\u043e\u0434 \u0441\u043d\u0430\u043f\u043e\u045e. \u042f\u043d\u044b \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0441\u043f\u0440\u0430\u0432\u0430 \u0456 \u0437\u043b\u0435\u0432\u0430, \u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0437\u043d\u043e\u045e \u0430\u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u041f\u0430\u043d \u0443\u0440\u0430\u0442\u0443\u0435 \u0448\u0430\u0442\u0440\u044b \u042e\u0434\u044b, \u043a\u0430\u0431 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0434\u043e\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0437\u0430 \u042e\u0434\u0443. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0441\u0442\u0430\u043d\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u0439 \u0434\u043b\u044f \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0456 \u043d\u0430\u0439\u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u0443 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0414\u0430\u0432\u0456\u0434, \u0430 \u0434\u043e\u043c \u0414\u0430\u0432\u0456\u0434\u0430 \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0411\u043e\u0433, \u044f\u043a \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u0445\u043d\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0417\u0430\u0445 11, 12b. 13b; \u041c\u0446 26, 15<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u0434\u044b \u044f\u043d\u044b \u0430\u0434\u0432\u0430\u0436\u044b\u043b\u0456 \u041c\u043d\u0435 \u043f\u043b\u0430\u0442\u0443 \u2013 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430\u043d\u0456\u043a\u0430\u045e, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0440\u044b\u0433\u043e\u0436\u0443\u044e \u0446\u0430\u043d\u0443, \u044f\u043a\u043e\u0439 \u044f\u043d\u044b \u0430\u0446\u0430\u043d\u0456\u043b\u0456 \u041c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042e\u0434\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: \u0428\u0442\u043e \u0445\u043e\u0447\u0430\u0446\u0435 \u043c\u043d\u0435 \u0434\u0430\u0446\u044c, \u0456 \u044f \u0432\u044b\u0434\u0430\u043c \u0432\u0430\u043c \u042f\u0433\u043e? \u042f\u043d\u044b \u0436 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u043b\u0456 \u044f\u043c\u0443 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430\u043d\u0456\u043a\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0440\u044b\u0433\u043e\u0436\u0443\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"336","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">12, 9-12\u0430; 13, 1-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u042f \u0431\u0443\u0434\u0443 \u043d\u0430\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u0456\u0434\u0443\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u042f \u0432\u044b\u043b\u044c\u044e \u043d\u0430 \u0434\u043e\u043c \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u043d\u0430 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0434\u0443\u0445 \u043b\u0430\u0441\u043a\u0456 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u045e \u0430\u0431 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u045e \u041c\u044f\u043d\u0435, \u0443 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u043b\u0456. \u0411\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u044c \u043f\u0430 \u0456\u043c, \u044f\u043a \u0433\u0430\u043b\u043e\u0441\u044f\u0446\u044c \u043f\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043e\u0440\u043a\u0430 \u043f\u043b\u0430\u043a\u0430\u0446\u044c \u043f\u0430 \u0456\u043c, \u044f\u043a \u0433\u043e\u0440\u043a\u0430 \u043f\u043b\u0430\u0447\u0443\u0446\u044c \u043f\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u043b\u0430\u0447 \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u044f\u043a \u043f\u043b\u0430\u0447 \u0425\u0430\u0434\u0430\u0434-\u0420\u044b\u043c\u043e\u043d\u0430 \u045e \u041c\u044d\u0433\u0456\u0434\u0441\u043a\u0430\u0439 \u0434\u0430\u043b\u0456\u043d\u0435. \u0411\u0443\u0434\u0437\u0435 \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044f, \u043a\u043e\u0436\u043d\u0430\u0435 \u043f\u043b\u0435\u043c\u044f \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0434\u043b\u044f \u0430\u0431\u043c\u044b\u0446\u0446\u044f \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u2013 \u042f \u0437\u043d\u0456\u0448\u0447\u0443 \u0456\u043c\u0451\u043d\u044b \u0456\u0434\u0430\u043b\u0430\u045e \u0437 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430 \u0456\u0445 \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u0434\u0430\u043b\u044e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u0434\u0443\u0445 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0410 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437\u043d\u043e\u045e \u043f\u0430\u0447\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c, \u0442\u043e \u044f\u043c\u0443 \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0430\u0439\u0446\u0435\u0446 \u044f\u0433\u043e\u043d\u044b \u0456 \u043c\u0430\u0446\u0456 \u044f\u0433\u043e\u043d\u0430\u044f, \u044f\u043a\u0456\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u044f\u0433\u043e: \u201c\u0422\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0436\u044b\u0446\u044c, \u0431\u043e \u043a\u0430\u0436\u0430\u0448 \u0445\u043b\u0443\u0441\u043d\u044e \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430\u201d. \u0406 \u0437\u0430\u043a\u043e\u043b\u044e\u0446\u044c \u044f\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0430&nbsp; \u044f\u0433\u043e\u043d\u044b \u0456 \u043c\u0430\u0446\u0456 \u044f\u0433\u043e\u043d\u0430\u044f, \u044f\u043a\u0456\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u044f\u0433\u043e, \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0446\u0446\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u043a\u043e\u0436\u043d\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u0456\u0437\u0456\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u0456 \u043d\u0435 \u043d\u0430\u0434\u0437\u0435\u043d\u0443\u0446\u044c \u043d\u0430 \u0441\u044f\u0431\u0435 \u0432\u0430\u043b\u0430\u0441\u044f\u043d\u044b \u043f\u043b\u0430\u0448\u0447, \u043a\u0430\u0431 \u0445\u043b\u0443\u0441\u0456\u0446\u044c. \u0406 \u0441\u043a\u0430\u0436\u0430: \u201d\u042f \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a, \u0430\u043b\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u0430\u0446\u0443\u0435 \u043d\u0430 \u0440\u0430\u043b\u043b\u0456, \u0431\u043e \u044f \u043d\u0430\u0431\u044b\u045e \u044f\u0435 \u0430\u0434 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439\u201d. \u0410 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043a\u0430\u0436\u0430 \u044f\u043c\u0443: \u201c\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0440\u0430\u043d\u044b \u043d\u0430 \u0442\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445?\u201d, \u0430 \u0451\u043d \u0430\u0434\u043a\u0430\u0436\u0430: \u201e\u042f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430 \u045e \u0434\u043e\u043c\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c\u201d.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0435\u0447, \u043f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0433\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u041c\u0430\u0439\u0433\u043e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u2013 \u0423\u0434\u0430\u0440 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0456 \u0440\u0430\u0441\u0441\u0435\u044e\u0446\u0446\u0430 \u0430\u0432\u0435\u0447\u043a\u0456, \u0430 \u042f \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u0430\u043b\u044b\u0445. \u0406 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0434\u0437\u0432\u0435 \u0442\u0440\u044d\u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u0440\u0430\u0437\u0430\u043d\u044b\u044f \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430 \u0442\u0440\u044d\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430 \u043d\u0430 \u0451\u0439. \u042f \u043f\u0440\u0430\u0432\u044f\u0434\u0443 \u0442\u0440\u0430\u0446\u0456\u043d\u0443 \u043f\u0440\u0430\u0437 \u0430\u0433\u043e\u043d\u044c \u0456 \u043f\u0435\u0440\u0430\u043f\u043b\u0430\u045e\u043b\u044e \u0456\u0445, \u044f\u043a \u043f\u0435\u0440\u0430\u043f\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0440\u044d\u0431\u0440\u0430, \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0443\u044e \u0456\u0445, \u044f\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u043e\u043b\u0430\u0442\u0430. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u041c\u0430\u0451 \u0456\u043c\u044f, \u0456 \u042f \u0430\u0434\u043a\u0430\u0436\u0443. \u0421\u043a\u0430\u0436\u0443 \u042f: \u201e\u0401\u043d \u2013 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434\u201d. \u0410 \u0451\u043d \u0441\u043a\u0430\u0436\u0430: \u201e\u041f\u0430\u043d \u2013 \u043c\u043e\u0439 \u0411\u043e\u0433\u201d\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 26, 31; \u0417\u0430\u0445 13, 7<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b \u045e\u0441\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u0446\u0435\u0441\u044f \u045e\u0432\u0430 \u041c\u043d\u0435 \u045e \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u0434\u0430\u0440\u0443 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0456 \u0440\u0430\u0441\u0441\u0435\u044e\u0446\u0446\u0430 \u0430\u0432\u0435\u0447\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u0435\u0447, \u043f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0433\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u041c\u0430\u0439\u0433\u043e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0434\u0430\u0440\u0443 \u043f\u0430\u0441\u0442\u044b\u0440\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"337","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 <\/span><span style=\"color: #ff0000;\">14, 1-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0456 \u0441\u043b\u0430\u0432\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0412\u043e\u0441\u044c \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0434\u0437\u0435\u043d\u044c \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0442\u0432\u0430\u044f \u0437\u0434\u0430\u0431\u044b\u0447\u0430 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435. \u042f \u0437\u0431\u044f\u0440\u0443 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u043d\u0430 \u0432\u0430\u0439\u043d\u0443. \u0413\u043e\u0440\u0430\u0434 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b, \u0434\u0430\u043c\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0431\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0437\u0433\u0432\u0430\u043b\u0442\u0430\u0432\u0430\u043d\u044b\u044f. \u041f\u0430\u043b\u043e\u0432\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435, \u0430\u043b\u0435 \u0440\u044d\u0448\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0440\u0430\u043d\u0430 \u0437 \u0433\u043e\u0440\u0430\u0434\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0422\u0430\u0434\u044b \u0432\u044b\u0439\u0434\u0437\u0435 \u041f\u0430\u043d \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0442\u044b\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u044f\u043a \u0443 \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f, \u044f\u043a \u0443 \u0434\u0437\u0435\u043d\u044c \u0431\u0456\u0442\u0432\u044b. \u0421\u0442\u0443\u043f\u043d\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043d\u0430 \u0410\u043b\u0456\u045e\u043d\u0430\u0439 \u0433\u0430\u0440\u044b, \u044f\u043a\u0430\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0437 \u0443\u0441\u0445\u043e\u0434\u0443. \u0406 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0410\u043b\u0456\u045e\u043d\u0430\u044f \u0433\u0430\u0440\u0430 \u043f\u0430\u043f\u0430\u043b\u0430\u043c \u0430\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0434\u0430\u043b\u0456\u043d\u0430\u0439. \u041f\u0430\u043b\u043e\u0432\u0430 \u0433\u0430\u0440\u044b \u043f\u0435\u0440\u0430\u0441\u0443\u043d\u0435\u0446\u0446\u0430 \u043d\u0430 \u043f\u043e\u045e\u043d\u0430\u0447, \u0430 \u044f\u0435 \u0434\u0440\u0443\u0433\u0430\u044f \u043f\u0430\u043b\u043e\u0432\u0430 \u2013 \u043d\u0430 \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c. \u0410 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0446\u044f\u043a\u0430\u0446\u044c \u0434\u0430\u043b\u0456\u043d\u0430\u044e \u041c\u0430\u0456\u0445 \u0433\u043e\u0440, \u0431\u043e \u0446\u044f\u0433\u043d\u0435\u0446\u0446\u0430 \u0434\u0430\u043b\u0456\u043d\u0430 \u0433\u043e\u0440 \u0430\u0436 \u0434\u0430 \u0410\u0446\u0430\u043b\u044f. \u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0442\u0430\u043a \u0443\u0446\u044f\u043a\u0430\u0446\u044c, \u044f\u043a \u0443\u0446\u044f\u043a\u0430\u043b\u0456 \u0430\u0434 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441\u0443 \u045e \u0434\u043d\u0456 \u0423\u0437\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u044f \u042e\u0434\u044b. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u041f\u0430\u043d, \u043c\u043e\u0439 \u0411\u043e\u0433, \u0430 \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0437 \u0406\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456 \u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u043d\u0456 \u0437\u0430\u0446\u044f\u0442\u0430\u0433\u0430 \u0445\u043e\u043b\u0430\u0434\u0443. \u0406 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0432\u044f\u0434\u043e\u043c\u044b \u041f\u0430\u043d\u0443, \u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u0435 \u043d\u043e\u0447. \u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434 \u0432\u0435\u0447\u0430\u0440 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0436\u044b\u0432\u044b\u044f \u0432\u043e\u0434\u044b. \u041f\u0430\u043b\u043e\u0432\u0430 \u0437 \u0456\u0445 \u043f\u0430\u0446\u044f\u0447\u044d \u0434\u0430 \u045e\u0441\u0445\u043e\u0434\u043d\u044f\u0433\u0430 \u043c\u043e\u0440\u0430, \u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u043f\u0430\u043b\u043e\u0432\u0430 \u2013 \u0434\u0430 \u043c\u043e\u0440\u0430 \u0437\u0430\u0445\u043e\u0434\u043d\u044f\u0433\u0430. \u0422\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u043b\u0435\u0442\u0430\u043c \u0456 \u0437\u0456\u043c\u043e\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u0411\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d \u041f\u0430\u043d \u0456 \u042f\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0456\u043c\u044f. \u0423\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u0440\u0430\u045e\u043d\u0456\u043d\u0443, \u0430\u0434 \u0413\u0435\u0431\u044b \u0434\u0430 \u0420\u044b\u043c\u043e\u043d\u0430, \u043d\u0430 \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c \u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0410 \u0451\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430, \u0430\u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043c\u0435\u0441\u0446\u044b \u0430\u0434 \u0431\u0440\u0430\u043c\u044b \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0430 \u0434\u0430 \u043c\u0435\u0441\u0446\u0430 \u043f\u0435\u0440\u0448\u0430\u0439 \u0431\u0440\u0430\u043c\u044b, \u0434\u0430 \u0431\u0440\u0430\u043c\u044b \u041a\u0443\u0442\u043d\u044f\u0439, \u0456 \u0430\u0434 \u0432\u0435\u0436\u044b \u0425\u0430\u043d\u0430\u043d\u044d\u043b\u044f \u0434\u0430 \u0434\u0430\u0432\u0456\u043b\u044c\u043d\u044f\u045e \u043a\u0430\u0440\u0430\u043b\u044f. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0441\u0435\u043b\u0435\u043d\u044b, \u0430 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0422\u0430\u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435 \u0431\u0435\u0434\u0441\u0442\u0432\u0430, \u044f\u043a\u0456\u043c \u041f\u0430\u043d \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430: \u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u0437\u0433\u043d\u0456\u0435, \u0445\u043e\u0446\u044c \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0442\u0430\u044f\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u0433\u0430\u0445, \u0456 \u0432\u043e\u0447\u044b \u044f\u0433\u043e \u0437\u0433\u043d\u0456\u044e\u0446\u044c \u0443 \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u0430\u0447\u043d\u0456\u0446\u0430\u0445, \u0456 \u044f\u0437\u044b\u043a \u044f\u0433\u043e \u0437\u0433\u043d\u0456\u0435 \u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u0445. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u043f\u0430\u0441\u0435\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0435. \u041a\u043e\u0436\u043d\u044b \u0441\u0445\u043e\u043f\u0456\u0446\u044c \u0437\u0430 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0456 \u043f\u0430\u0434\u044b\u043c\u0435 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u042e\u0434\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0411\u0443\u0434\u0437\u0435 \u0441\u0430\u0431\u0440\u0430\u043d\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0430\u0434\u0437\u0435\u043d\u043d\u044f. \u0422\u0430\u043a\u043e\u0435 \u0436 \u0431\u0435\u0434\u0441\u0442\u0432\u0430 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u0435 \u043a\u0430\u043d\u044f, \u043c\u0443\u043b\u0430, \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430 \u0456 \u0430\u0441\u043b\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0436\u044b\u0432\u0451\u043b\u0456\u043d\u0443, \u044f\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u045e \u0433\u044d\u0442\u044b\u0445 \u0441\u0442\u0430\u043d\u0430\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0423\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456\u044f \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u0437 \u0433\u043e\u0434\u0443 \u045e \u0433\u043e\u0434 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u043a\u0430\u0440\u0430\u043b\u044e, \u041f\u0430\u043d\u0443 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0456 \u043a\u0430\u0431 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430 \u0428\u0430\u0442\u0440\u043e\u045e. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0435\u0439\u043a\u0430\u0435 \u043f\u043b\u0435\u043c\u044f \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u045e\u0437\u044b\u0434\u0437\u0435 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u043a\u0430\u0440\u0430\u043b\u044e, \u041f\u0430\u043d\u0443 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0456\u0445 \u0434\u0430\u0436\u0434\u0436\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456 \u0440\u043e\u0434 \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435 \u0456 \u043d\u0435 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u0445 \u0434\u0430\u0436\u0434\u0436\u0443 \u0456 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0435 \u0456\u0445 \u0431\u0435\u0434\u0441\u0442\u0432\u0430, \u044f\u043a\u0456\u043c \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u041f\u0430\u043d \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u043a\u0430\u0431 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430 \u0428\u0430\u0442\u0440\u043e\u045e. \u0422\u0430\u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u043a\u0430\u0431 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430 \u0428\u0430\u0442\u0440\u043e\u045e. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u043d\u0430 \u0431\u043e\u043c\u0430\u0445 \u043a\u0430\u043d\u044f: \u201c\u041f\u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u041f\u0430\u043d\u0430\u201d, \u0456 \u043a\u0430\u0442\u043b\u044b \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u044f \u0447\u0430\u0448\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u043e\u043c. \u041a\u043e\u0436\u043d\u044b \u043a\u0430\u0446\u0451\u043b \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 \u0456 \u042e\u0434\u0437\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u041f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0443\u0441\u0435, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443, \u0432\u043e\u0437\u044c\u043c\u0443\u0446\u044c \u0456\u0445 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0456\u0445 \u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c. \u0406 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0433\u0430\u043d\u0434\u043b\u044f\u0440\u0430 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c\u00bb.&nbsp;<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0417\u0430\u0445 14, 8\u0430; 13, 1; \u042f\u043d 19, 34<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0436\u044b\u0432\u044b\u044f \u0432\u043e\u0434\u044b, \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0434\u043b\u044f \u0430\u0431\u043c\u044b\u0446\u0446\u044f \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434\u0437\u0456\u043d \u0437 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u043f\u0440\u0430\u0431\u0456\u045e \u0434\u0437\u0456\u0434\u0430\u044e \u0431\u043e\u043a \u0415\u0437\u0443\u0441\u0430, \u0456 \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u044b\u0446\u0435\u043a\u043b\u0430 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0414\u043b\u044f \u0430\u0431\u043c\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"341","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u042f\u043d\u0430, \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430<\/span><\/p>\r\n<p style=\"text-align: right;\"><span style=\"color: #ff0000;\">1, 4-6. 10. 12-18; 2, 26. 28; 3, 5b. 12. 20-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0456\u0437\u0456\u044f \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u045e \u042f\u0433\u043e \u0441\u043b\u0430\u0432\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c, \u0456 \u0431\u044b\u045e, \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0456 \u0430\u0434 \u0441\u044f\u043c\u0456 \u0414\u0443\u0445\u0430\u045e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u043c \u0442\u0440\u043e\u043d\u0430\u043c, \u0456 \u0430\u0434 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0434\u043a\u0456, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0456 \u0423\u043b\u0430\u0434\u0430\u0440\u0430 \u0437\u044f\u043c\u043d\u044b\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u043d\u0430\u0441 \u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u0443 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0447\u0443\u045e \u0437\u0430 \u0441\u0430\u0431\u043e\u044e \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u0431\u044b\u0446\u0446\u0430\u043c \u0442\u0440\u0443\u0431\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0430\u0431\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c, \u0447\u044b\u0439 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u043c\u044f\u043d\u0435. \u041a\u0430\u043b\u0456 \u0430\u0431\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0435\u043c \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e, \u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u0433\u0430 \u045e \u0434\u043e\u045e\u0433\u0456\u044f \u0448\u0430\u0442\u044b \u0456 \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u043d\u0430 \u0433\u0440\u0443\u0434\u0437\u044f\u0445 \u0437\u0430\u043b\u0430\u0442\u044b\u043c \u043f\u0430\u0441\u0430\u043c. \u0410 \u042f\u0433\u043e \u0433\u0430\u043b\u0430\u0432\u0430 \u0456 \u0432\u0430\u043b\u0430\u0441\u044b \u0431\u044b\u043b\u0456 \u0431\u0435\u043b\u044b\u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u0435\u043b\u0430\u044f \u0432\u043e\u045e\u043d\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u043d\u0435\u0433, \u0430 \u0432\u043e\u0447\u044b \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u044f\u043a \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e. \u041d\u043e\u0433\u0456 \u0436 \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0431\u0440\u043e\u043d\u0437\u044b, \u043d\u0456\u0431\u044b \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0439 \u0443 \u043f\u0435\u0447\u044b, \u0430 \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e \u2013 \u044f\u043a \u0448\u0443\u043c \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0432\u0430\u0434\u044b. \u0423 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0430\u0439 \u0440\u0443\u0446\u044d \u043c\u0435\u045e \u0401\u043d \u0441\u0435\u043c \u0437\u043e\u0440\u0430\u043a, \u0430 \u0437 \u042f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u045e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0432\u043e\u0441\u0442\u0440\u044b \u0434\u0432\u0443\u0445\u0431\u0430\u043a\u043e\u0432\u044b \u043c\u0435\u0447, \u0456 \u0442\u0432\u0430\u0440 \u042f\u0433\u043e \u0431\u044b\u045e \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0448\u0442\u043e \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u042f\u0433\u043e, \u0443\u043f\u0430\u045e \u0434\u0430 \u043d\u043e\u0433 \u042f\u0433\u043e\u043d\u044b\u0445, \u043d\u0456\u0431\u044b \u043c\u0451\u0440\u0442\u0432\u044b. \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u0446\u0443 \u0441\u0432\u0430\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f! \u042f \u2013 \u041f\u0435\u0440\u0448\u044b \u0456 \u0410\u043f\u043e\u0448\u043d\u0456, \u0456 \u0436\u044b\u0432\u044b; \u0456 \u0431\u044b\u045e \u043c\u0451\u0440\u0442\u0432\u044b, \u0456 \u0432\u043e\u0441\u044c \u0436\u044b\u0432\u044b \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f; \u0456 \u043c\u0430\u044e \u043a\u043b\u044e\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u045e\u0447\u044b\u043d\u043a\u0456 \u041c\u0430\u0435, \u0442\u0430\u043c\u0443 \u0434\u0430\u043c \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456. \u0406 \u044f\u043a \u0443\u0437\u044f\u045e \u042f \u0430\u0434 \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u0442\u0430\u043a \u0456 \u044f\u043c\u0443 \u0434\u0430\u043c \u0440\u0430\u043d\u0456\u0448\u043d\u044e\u044e \u0437\u043e\u0440\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043d\u0435 \u0441\u0430\u0442\u0440\u0443 \u0456\u043c\u0435\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0437 \u043a\u043d\u0456\u0433\u0456 \u0436\u044b\u0446\u0446\u044f, \u0456 \u0432\u044b\u0437\u043d\u0430\u044e \u0456\u043c\u044f \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u043d\u0451\u043b\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0437\u0440\u0430\u0431\u043b\u044e \u043a\u0430\u043b\u043e\u043d\u0430\u0439 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0432\u044b\u0439\u0434\u0437\u0435 \u0432\u043e\u043d\u043a\u0456, \u0456 \u043d\u0430\u043f\u0456\u0448\u0443 \u043d\u0430 \u0456\u043c \u0456\u043c\u044f \u041c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043c\u044f \u0433\u043e\u0440\u0430\u0434\u0430 \u041c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u043d\u043e\u0432\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u044f\u043a\u0456 \u0441\u043f\u0443\u0441\u043a\u0430\u0435\u0446\u0446\u0430 \u0437 \u043d\u0435\u0431\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430 \u041c\u0430\u0439\u0433\u043e, \u0456 \u041c\u0430\u0451 \u043d\u043e\u0432\u0430\u0435 \u0456\u043c\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0441\u0442\u0430\u044e \u043a\u0430\u043b\u044f \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0456 \u0441\u0442\u0443\u043a\u0430\u044e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u0435 \u041c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0437\u0432\u0435\u0440\u044b, \u0443\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e. \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0434\u0430\u043c \u0441\u0435\u0441\u0446\u0456 \u0441\u0430 \u041c\u043d\u043e\u044e \u043d\u0430 \u041c\u0430\u0456\u043c \u0442\u0440\u043e\u043d\u0435, \u044f\u043a \u0456 \u042f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0456 \u0441\u0435\u045e \u0437 \u041c\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u043c \u043d\u0430 \u042f\u0433\u043e \u0442\u0440\u043e\u043d\u0435.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u043a 13, 26-27; \u041f\u0441 98 (97), 9b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0456\u0441\u0446\u0456 \u043d\u0430 \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u0456\u043b\u0430\u0439 \u0456 \u045e \u0441\u043b\u0430\u0432\u0435. \u0401\u043d \u043f\u0430\u0448\u043b\u0435 \u0442\u0430\u0434\u044b \u0430\u043d\u0451\u043b\u0430\u045e <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0437\u0431\u044f\u0440\u044d \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0441\u0432\u0430\u0456\u0445 \u0430\u0434 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0432\u044f\u0442\u0440\u043e\u045e, <\/span><span style=\"color: #ff0000;\">\/ <\/span><span>\u0430\u0434 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u043a\u0440\u0430\u044e \u043d\u0435\u0431\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u0437\u0431\u044f\u0440\u044d.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"342","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <\/span><span style=\"color: #ff0000;\">1, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u044b\u043c\u043e\u043d \u041f\u0451\u0442\u0440, \u0441\u043b\u0443\u0433\u0430 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u2013 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u0434\u0430\u0440\u0430\u0433\u0443\u044e \u043d\u0430\u043c \u0432\u0435\u0440\u0443 \u043f\u0440\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u0443 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u0430\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u043b\u0430\u0441\u043a\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0440\u0430\u0437 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0415\u0437\u0443\u0441\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434 \u0411\u043e\u0441\u043a\u0430\u0439 \u0441\u0456\u043b\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043d\u0430\u043c \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u045e\u0441\u0451 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0456 \u0445\u0432\u0430\u043b\u044b, \u043f\u0440\u0430\u0437 \u0448\u0442\u043e \u0434\u0430\u045e \u043d\u0430\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0456\u0445 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u045e\u0448\u044b \u0437\u0433\u0443\u0431\u044b \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0417 \u0433\u044d\u0442\u0430\u0439 \u0441\u0430\u043c\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0432\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u0446\u043d\u043e\u0442\u0430\u0439, \u0446\u043d\u043e\u0442\u0443 \u2013 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u2013 \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044e, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c \u2013 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u044f\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u2013 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u2013 \u0431\u0440\u0430\u0442\u043d\u044f\u044e \u043b\u044e\u0431\u043e\u045e\u044e, \u0430 \u0431\u0440\u0430\u0442\u043d\u044e\u044e \u043b\u044e\u0431\u043e\u045e \u2013 \u043b\u044e\u0431\u043e\u045e\u044e. \u041a\u0430\u043b\u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u045e \u0432\u0430\u0441 \u0451\u0441\u0446\u044c \u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430, \u0442\u043e \u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u043d\u044b\u043c\u0456 \u0434\u044b \u0431\u044f\u0441\u043f\u043b\u0451\u043d\u043d\u044b\u043c\u0456 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0423 \u043a\u0430\u0433\u043e \u0436 \u043d\u044f\u043c\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u043e\u0439 \u0441\u043b\u044f\u043f\u044b, \u0437\u0430\u043a\u0440\u044b\u045e\u0448\u044b \u0432\u043e\u0447\u044b, \u0437\u0430\u0431\u044b\u045e\u0441\u044f \u043f\u0440\u0430 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u045e\u043d\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. \u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0456 \u0432\u044b\u0431\u0430\u0440. \u0422\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0430\u0442\u043a\u043d\u0456\u0446\u0451\u0441\u044f. \u0422\u0430\u0434\u044b \u0448\u044b\u0440\u043e\u043a\u0430 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u045e\u0432\u0430\u0445\u043e\u0434 \u0443 \u0432\u0435\u0447\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u041f 1, 3b. 4; \u0413\u0430\u043b 3, 27<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0456 \u0445\u0432\u0430\u043b\u044b, \u043f\u0440\u0430\u0437 \u0448\u0442\u043e \u0434\u0430\u045e \u043d\u0430\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0456\u0445 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0441\u0435 \u0432\u044b, \u0445\u0442\u043e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u043f\u0440\u0430\u0437.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"343","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <\/span><span style=\"color: #ff0000;\">1, 12-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0422\u0430\u043c\u0443 \u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0443 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u0432\u0430\u043c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0445\u043e\u0446\u044c \u0432\u044b \u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u0434\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u045e \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u041b\u0456\u0447\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u043c\u0451\u0446\u0435, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043c, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0445\u0443\u0442\u043a\u0430 \u043f\u0430\u043a\u0456\u043d\u0443 \u0433\u044d\u0442\u044b \u043c\u043e\u0439 \u043d\u0430\u043c\u0451\u0442, \u044f\u043a \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u043c\u043d\u0435 \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0411\u0443\u0434\u0443 \u0436 \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430, \u043a\u0430\u0431 \u0432\u044b \u0456 \u043f\u0430\u0441\u043b\u044f \u043c\u0430\u0439\u0433\u043e \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0434\u0430\u043b\u0456 \u0432\u0430\u043c \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043c\u043e\u0446 \u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u043c\u0443\u0434\u0440\u0430 \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b\u043c\u0456 \u0431\u0430\u0439\u043a\u0430\u043c\u0456, \u0430\u043b\u0435 \u0431\u0443\u0434\u0443\u0447\u044b \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u0446\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b. \u0401\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043f\u0430\u0448\u0430\u043d\u0443 \u0456 \u0441\u043b\u0430\u0432\u0443, \u043a\u0430\u043b\u0456 \u0430\u0434 \u0432\u0435\u043b\u0456\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0434\u0430 \u042f\u0433\u043e \u0441\u044b\u0448\u043e\u045e \u0442\u0430\u043a\u0456 \u0433\u043e\u043b\u0430\u0441: \u00ab\u0413\u044d\u0442\u0430 \u041c\u043e\u0439 \u0421\u044b\u043d \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e\u00bb. \u0406 \u043c\u044b \u0447\u0443\u043b\u0456, \u044f\u043a \u0433\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0441 \u0434\u0430\u043d\u043e\u0441\u0456\u045e\u0441\u044f \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u0437 \u0406\u043c \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b. \u0414\u0430 \u0442\u0430\u0433\u043e \u0436 \u0443 \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435, \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. \u0406 \u0432\u044b \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u043e\u0431\u0456\u0446\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u044b \u0456\u043c, \u044f\u043a \u043f\u0440\u044b \u043b\u044f\u043c\u043f\u0435, \u0448\u0442\u043e \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443 \u0446\u0451\u043c\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0447\u043d\u0435 \u0441\u0432\u0456\u0442\u0430\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u0456 \u0437\u0430\u0440\u0430\u043d\u0456\u0446\u0430 \u043d\u0435 \u045e\u0437\u044b\u0434\u0437\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445. \u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0456\u044f\u043a\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u043f\u0440\u044b\u0432\u0430\u0442\u043d\u0430\u0433\u0430 \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u044f. \u0411\u043e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u0432\u043e\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0456\u043c\u044f \u0411\u043e\u0433\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u044f\u0433\u043e \u043b\u044e\u0434\u0437\u0456, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0421\u0432\u044f\u0442\u044b\u043c \u0414\u0443\u0445\u0430\u043c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 1, 14; \u043f\u0430\u0440. 2 \u041f 1, 16b. 18b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u043c\u044b \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e\u043d\u0443\u044e, \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u0441\u0442\u0430\u043b\u0456 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u0446\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u0437 \u0406\u043c \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"344","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <\/span><span style=\"color: #ff0000;\">2, 1-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0424\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0411\u044b\u043b\u0456 \u0436 \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435, \u044f\u043a \u0456 \u045e \u0432\u0430\u0441 \u0431\u0443\u0434\u0443\u0446\u044c \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u045e\u0432\u044f\u0434\u0443\u0446\u044c \u0437\u0433\u0443\u0431\u043d\u044b\u044f \u0435\u0440\u0430\u0441\u0456 \u0456, \u0432\u044b\u0440\u0430\u043a\u0430\u044e\u0447\u044b\u0441\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456\u0445, \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u043d\u0430\u043a\u043b\u0456\u0447\u0443\u0446\u044c \u043d\u0430 \u0441\u044f\u0431\u0435 \u0445\u0443\u0442\u043a\u0443\u044e \u0437\u0433\u0443\u0431\u0443. \u041c\u043d\u043e\u0433\u0456\u044f \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0437\u0430 \u0456\u0445 \u0440\u0430\u0437\u0431\u044d\u0448\u0447\u0430\u043d\u0430\u0441\u0446\u044e, \u0456 \u043f\u0440\u0430\u0437 \u0456\u0445 \u0448\u043b\u044f\u0445 \u043f\u0440\u0430\u045e\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u044f\u0432\u0430\u0436\u0430\u043d\u044b. \u0423 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043b\u0456\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u041f\u0440\u044b\u0441\u0443\u0434 \u0456\u043c \u0434\u0430\u045e\u043d\u043e \u0433\u0430\u0442\u043e\u0432\u044b, \u0456 \u0437\u0433\u0443\u0431\u0430 \u0456\u0445 \u043d\u0435 \u0430\u0431\u043c\u0456\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0411\u043e \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u0430\u043b\u0435, \u0437\u0432\u044f\u0437\u0430\u045e\u0448\u044b \u043f\u0443\u0442\u0430\u043c\u0456 \u0446\u0435\u043c\u0440\u044b, \u0441\u043a\u0456\u043d\u0443\u045e \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u043a\u0430\u0431 \u0442\u0430\u043c \u0447\u0430\u043a\u0430\u043b\u0456 \u0441\u0443\u0434\u0430; \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0430\u0442\u043e\u043f \u043d\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u0437\u0430\u0445\u0430\u0432\u0430\u045e\u0448\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u043e\u0441\u0435\u043c \u0430\u0441\u043e\u0431\u0430\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u041d\u043e\u0435\u043c, \u0432\u0435\u0441\u043d\u0456\u043a\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456; \u0456 \u043a\u0430\u043b\u0456 \u0433\u0430\u0440\u0430\u0434\u044b \u0421\u0430\u0434\u043e\u043c\u0443 \u0456 \u0413\u0430\u043c\u043e\u0440\u0443, \u0430\u0441\u0443\u0434\u0437\u0456\u045e\u0448\u044b \u043d\u0430 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435, \u0430\u0431\u044f\u0440\u043d\u0443\u045e \u0443 \u043f\u043e\u043f\u0435\u043b, \u044f\u043a \u043f\u0435\u0440\u0430\u0441\u0446\u044f\u0440\u043e\u0433\u0443 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u043c, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u041b\u043e\u0442\u0430, \u0437\u043c\u0443\u0447\u0430\u043d\u0430\u0433\u0430 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0430\u045e, \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e, \u0431\u043e \u0433\u044d\u0442\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0436\u044b\u0432\u0443\u0447\u044b \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0456 \u0447\u0443\u044e\u0447\u044b \u0434\u044b \u0431\u0430\u0447\u0430\u0447\u044b \u045e\u0447\u044b\u043d\u043a\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0448\u0442\u043e\u0434\u043d\u044f \u0437\u0432\u0435\u0434\u0432\u0430\u045e \u043f\u0430\u043a\u0443\u0442\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0439 \u0434\u0443\u0448\u044b, \u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u041f\u0430\u043d, \u044f\u043a \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u0445 \u0430\u0434 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 7, 15; 24, 11\u0430. \u043f\u0430\u0440. 24<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u0432\u0430\u0441 \u0443 \u0430\u0432\u0435\u0447\u0430\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u0446\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u2013 \u0432\u0430\u045e\u043a\u0456 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0406 \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0448\u043c\u0430\u0442 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0437\u043d\u0430\u043a\u0456, \u043a\u0430\u0431 \u0443\u0432\u0435\u0441\u0446\u0456 \u045e \u0437\u043c\u0430\u043d \u043c\u043d\u043e\u0433\u0456\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"345","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <\/span><span style=\"color: #ff0000;\">2, 9-22<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b\u043a\u0440\u044b\u0446\u0446\u0451 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0412\u0435\u0434\u0430\u0435 \u041f\u0430\u043d, \u044f\u043a \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u0445 \u0430\u0434 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u044b\u0445, \u0448\u0442\u043e \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0446\u0435\u043b\u0443 \u045e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u0451\u0440\u0437\u043a\u0456\u044f, \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f, \u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u043d\u0430\u0432\u0430\u0442 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b, \u0442\u0430\u0434\u044b \u044f\u043a \u0430\u043d\u0451\u043b\u044b, \u0445\u043e\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0441\u0456\u043b\u0430\u044e \u0456 \u043c\u043e\u0446\u0430\u044e, \u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u044e\u0446\u044c \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u0410 \u044f\u043d\u044b, \u044f\u043a \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0436\u044b\u0432\u0451\u043b\u044b, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u044b\u0440\u043e\u0434\u044b \u043d\u0430 \u045e\u043b\u043e\u045e \u0434\u044b \u045e\u0431\u043e\u0439, \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0442\u0430\u043c\u0443 \u044f\u043a \u0433\u044d\u0442\u044b\u044f \u0436\u044b\u0432\u0451\u043b\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b\u044f \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0430\u0434\u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0428\u0447\u0430\u0441\u0446\u0435\u043c \u043b\u0456\u0447\u0430\u0446\u044c \u044f\u043d\u044b \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0443\u044e \u0430\u0441\u0430\u043b\u043e\u0434\u0443; \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u044b\u044f \u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u043a\u0456, \u044f\u043d\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0448\u0443\u043a\u0430\u043d\u0441\u0442\u0432\u0430\u0445, \u0431\u0430\u043d\u043a\u0435\u0442\u0443\u044e\u0447\u044b \u0437 \u0432\u0430\u043c\u0456. \u0412\u043e\u0447\u044b \u0456\u0445\u043d\u0456\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u0441\u0442\u0432\u0430\u043c \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b\u043c \u0433\u0440\u0430\u0445\u043e\u043c; \u044f\u043d\u044b \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u0445; \u0456\u0445 \u0441\u044d\u0440\u0446\u0430 \u043f\u0440\u044b\u0432\u0443\u0447\u0430\u043d\u0430 \u0434\u0430 \u043d\u0430\u0436\u044b\u0432\u044b; \u0433\u044d\u0442\u0430 \u0441\u044b\u043d\u044b \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443. \u042f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u043f\u0440\u043e\u0441\u0442\u044b \u0448\u043b\u044f\u0445, \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0456, \u0441\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443 \u0411\u0430\u043b\u044f\u0430\u043c\u0430, \u0441\u044b\u043d\u0430 \u0411\u0430\u0441\u043e\u0440\u0430, \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0430\u043b\u0435 \u0431\u044b\u045e \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0437\u0430 \u0441\u0432\u0430\u0451 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435: \u0431\u044f\u0437\u043c\u043e\u045e\u043d\u0430\u044f \u045e\u044e\u0447\u043d\u0430\u044f \u0436\u044b\u0432\u0451\u043b\u0456\u043d\u0430, \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0441\u043f\u044b\u043d\u0456\u043b\u0430 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430. \u0413\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0431\u044f\u0437\u0432\u043e\u0434\u043d\u044b\u044f, \u0445\u043c\u0430\u0440\u044b, \u0448\u0442\u043e \u0431\u0443\u0440\u0430 \u0433\u0430\u043d\u044f\u0435; \u0434\u043b\u044f \u0456\u0445 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0437\u043c\u0440\u043e\u043a \u0446\u0435\u043c\u0440\u044b. \u0411\u043e, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u044c\u043c\u0443\u0442\u044b\u044f \u0456 \u043f\u0443\u0441\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043d\u044b \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0440\u0430\u0437 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u0435\u0434\u0437\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0446\u0451\u043a \u0430\u0434 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445. \u042f\u043d\u044b \u0430\u0431\u044f\u0446\u0430\u044e\u0446\u044c \u0456\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443, \u0445\u043e\u0446\u044c \u0441\u0430\u043c\u0456 \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f, \u0431\u043e \u0445\u0442\u043e \u043a\u0456\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b, \u0442\u043e\u0439 \u0442\u0430\u0433\u043e \u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436, \u0443\u0446\u0451\u043a\u0448\u044b \u0430\u0434 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u0430\u0437 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u043d\u043e\u045e, \u0437\u0430\u0431\u043b\u044b\u0442\u0430\u045e\u0448\u044b\u0441\u044f, \u043f\u0430\u0434\u0434\u0430\u044e\u0446\u0446\u0430 \u0451\u0439, \u0442\u043e \u0430\u043f\u043e\u0448\u043d\u044f\u0435 \u0434\u043b\u044f \u0456\u0445 \u0433\u043e\u0440\u0448\u0430\u0435 \u0437\u0430 \u043f\u0435\u0440\u0448\u0430\u0435. \u0411\u043e \u043b\u0435\u043f\u0448 \u0431\u044b\u043b\u043e \u0431 \u0456\u043c \u043d\u0435 \u0432\u0435\u0434\u0430\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0447\u044b\u043c, \u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b, \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0430\u0434 \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u0456\u043c \u0441\u0432\u044f\u0442\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0421\u0442\u0430\u043b\u0430\u0441\u044f \u0437 \u0456\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u043f\u0440\u044b\u043a\u0430\u0437\u043a\u0456: \u00ab\u0421\u0430\u0431\u0430\u043a\u0430 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u043d\u0456\u0442\u0430\u045e, \u0430 \u0432\u044b\u043c\u044b\u0442\u0430\u044f \u0441\u0432\u0456\u043d\u043d\u044f \u2013 \u0443 \u0431\u0440\u0443\u0434\u043d\u0443\u044e \u043b\u0443\u0436\u044b\u043d\u0443\u00bb.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 4, 8\u0430. 9b; 1 \u041a\u0430\u0440 16, 13<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0433\u043e\u0434\u043d\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u2013 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u0443\u043c\u0430\u0439\u0446\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435, \u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0427\u0443\u0432\u0430\u0439\u0446\u0435, \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u0432\u0435\u0440\u044b, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0443\u0436\u043d\u044b\u043c\u0456 \u0456 \u043c\u043e\u0446\u043d\u044b\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u043e\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"346","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <\/span><span style=\"color: #ff0000;\">3, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u043a\u043b\u0456\u043a \u0447\u0430\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0433\u044d\u0442\u0430 \u045e\u0436\u043e \u0434\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c; \u0443 \u0456\u0445 \u043f\u0440\u0430\u0437 \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u0430\u0431\u0443\u0434\u0436\u0430\u044e \u0432\u0430\u0448\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0434\u0443\u043c\u043a\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u044b, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0440\u0430\u043d\u0435\u0439 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456 \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u0432\u0430\u0448\u044b\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u2019\u044f\u0432\u044f\u0446\u0446\u0430 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0437 \u043a\u043f\u0456\u043d\u0430\u043c\u0456 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u044b\u0442\u0430\u0446\u0446\u0430: \u00ab\u0414\u0437\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f? \u0411\u043e \u0430\u0434 \u0447\u0430\u0441\u043e\u045e, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0430\u0439\u0446\u044b, \u0443\u0441\u0451 \u0442\u0440\u044b\u0432\u0430\u0435 \u0442\u0430\u043a, \u044f\u043a \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u00bb. \u042f\u043d\u044b \u0436 \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0437\u0434\u0430\u045e\u043d\u0430 \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0437\u044f\u043c\u043b\u044f \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u0437 \u0432\u0430\u0434\u044b \u0456 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443, \u0442\u0430\u043c\u0443 \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u0442\u0430\u0433\u0430\u0447\u0430\u0441\u043d\u044b \u0441\u0432\u0435\u0442, \u0437\u0430\u0442\u043e\u043f\u043b\u0435\u043d\u044b \u0432\u0430\u0434\u043e\u044e. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0437\u044f\u043c\u043b\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0442\u044b\u043c \u0436\u0430 \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u0430\u0433\u043d\u044f \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430 \u0456 \u0437\u0433\u0443\u0431\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0433\u044d\u0442\u0430 \u0430\u0434\u043d\u043e \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u0432\u0430\u0441, \u0448\u0442\u043e \u045e \u041f\u0430\u043d\u0430 \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c, \u044f\u043a \u0442\u044b\u0441\u044f\u0447\u0430 \u0433\u0430\u0434\u043e\u045e, \u0456 \u0442\u044b\u0441\u044f\u0447\u0430 \u0433\u0430\u0434\u043e\u045e, \u044f\u043a \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c. \u041d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c \u041f\u0430\u043d \u0437 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u044f\u043a \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043b\u0456\u0447\u0430\u0446\u044c \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u0443\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0430\u043b\u0435 \u0401\u043d \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0434\u0430 \u043d\u0430\u0441. \u0401\u043d \u043d\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u043d\u0435\u0445\u0442\u0430 \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u0430\u043b\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f. \u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u0436 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439. \u0406 \u0442\u0430\u0434\u044b \u043d\u044f\u0431\u0451\u0441\u044b \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u0446\u044c \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0448\u0443\u043c\u0430\u043c, \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0441\u0442\u044b\u0445\u0456\u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u0446\u0446\u0430, \u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u045e\u0441\u0451 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0435 \u043d\u0430 \u0451\u0439 \u0437\u0433\u0430\u0440\u0430\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0442\u0430\u043a \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430, \u0434\u044b\u043a \u044f\u043a\u0456\u043c\u0456 \u0436 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0432\u0430\u043c, \u044f\u043a\u0456\u044f \u0447\u0430\u043a\u0430\u0435\u0446\u0435 \u0456 \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u0432\u0430\u0435\u0446\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u043b\u0430\u044e\u0447\u044b\u044f \u043d\u044f\u0431\u0451\u0441\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0441\u0442\u044b\u0445\u0456\u0456 \u0440\u0430\u0441\u0442\u043e\u043f\u044f\u0446\u0446\u0430. \u0410\u043b\u0435 \u043c\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u0447\u0430\u043a\u0430\u0435\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043d\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430, \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0401\u043d \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0432\u0430\u0441 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456, \u0443 \u0441\u043f\u0430\u043a\u043e\u0456, \u0430 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u043b\u0456\u0447\u044b\u0446\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u044f\u043a \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u043d\u0430\u0448 \u0431\u0440\u0430\u0442 \u041f\u0430\u0432\u0435\u043b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u044f\u043a \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u0445, \u0443 \u044f\u043a\u0456\u0445 \u0451\u0441\u0446\u044c \u0446\u044f\u0436\u043a\u0456\u044f \u0434\u043b\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0440\u044d\u0447\u044b, \u0456 \u043d\u0435\u0432\u0443\u043a\u0456 \u0434\u044b \u043d\u044f\u0441\u0442\u0430\u043b\u044b\u044f \u045e \u0432\u0435\u0440\u044b \u043f\u0435\u0440\u0430\u043a\u0440\u0443\u0447\u0432\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u0430, \u044f\u043a \u0456 \u0456\u043d\u0448\u044b\u044f \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u0437\u0433\u0443\u0431\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u044b, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u0430 \u043d\u0430\u043f\u0435\u0440\u0430\u0434, \u0441\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f, \u043a\u0430\u0431, \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b\u044f \u043f\u0430\u043c\u044b\u043b\u043a\u0430\u043c\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u0445, \u0432\u044b \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u045e\u043b\u0430\u0441\u043d\u044b \u0433\u0440\u0443\u043d\u0442 \u043f\u0430\u0434 \u043d\u0430\u0433\u0430\u043c\u0456. \u0410\u043b\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0439\u0446\u0435 \u045e \u043b\u0430\u0441\u0446\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043c\u0443 \u0441\u043b\u0430\u0432\u0430 \u0456 \u0446\u044f\u043f\u0435\u0440, \u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 65, 17\u0430. 18; \u0410\u043f 21, 5\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u042f \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u043d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e; \u0430 \u0432\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0446\u0435\u0448\u0446\u0435\u0441\u044f \u0432\u0435\u0447\u043d\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u042f \u0441\u0442\u0432\u0430\u0440\u0443. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u043e\u0441\u044c \u0447\u044b\u043d\u044e \u045e\u0441\u0451 \u043d\u043e\u0432\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0430 \u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434 \u2013 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u043e\u0441\u044c \u0447\u044b\u043d\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"347","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042e\u0434\u044b <\/span><span style=\"color: #ff0000;\">1-8. 12-13. 17-23&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b\u043a\u0440\u044b\u0446\u0446\u0451 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u043d\u044b\u0445<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042e\u0434\u0430, \u0441\u043b\u0443\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u0440\u0430\u0442 \u042f\u043a\u0443\u0431\u0430, \u2013 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u043c, \u044f\u043a\u0456\u0445 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u045e \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u0430\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u043b\u044e\u0431\u043e\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0437 \u0443\u0441\u0451\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u043f\u0456\u0448\u0443 \u0432\u0430\u043c \u043f\u0440\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u042f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437\u0430 \u0432\u0435\u0440\u0443, \u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043c. \u0411\u043e \u0437\u0430\u043a\u0440\u0430\u043b\u0456\u0441\u044f \u043c\u0456\u0436 \u0432\u0430\u0441 \u043d\u0435\u0439\u043a\u0456\u044f \u043b\u044e\u0434\u0437\u0456, \u0437\u0434\u0430\u045e\u043d\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435, \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0430\u043c\u044f\u043d\u0456\u043b\u0456 \u043d\u0430 \u0440\u0430\u0437\u0431\u044d\u0448\u0447\u0430\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0440\u0430\u043a\u0430\u044e\u0446\u0446\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430 \u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0430\u0447\u0443 \u043d\u0430\u0433\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c, \u0445\u043e\u0446\u044c \u0432\u044b \u045e\u0441\u0451 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0440\u043e\u0434 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0437\u043d\u0456\u0448\u0447\u044b\u045e. \u0410\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0451\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0441\u0432\u0430\u0451 \u0436\u044b\u043b\u043b\u0451, \u0401\u043d \u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u0432\u0435\u0447\u043d\u044b\u0445 \u043f\u0443\u0442\u0430\u0445 \u0443 \u0446\u0435\u043c\u0440\u044b \u0430\u0436 \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0443\u0434\u043d\u0430\u0433\u0430 \u0434\u043d\u044f. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0421\u0430\u0434\u043e\u043c\u0430 \u0456 \u0413\u0430\u043c\u043e\u0440\u0430, \u0456 \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b, \u0448\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0436\u044b\u043b\u0456 \u045e \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0432\u0435\u0447\u043d\u044b\u043c \u0430\u0433\u043d\u0451\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0435 \u0436 \u0431\u0443\u0434\u0437\u0435 \u0456 \u0437 \u0433\u044d\u0442\u044b\u043c\u0456 \u043c\u0440\u043e\u0439\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0430\u043f\u0430\u0433\u0430\u043d\u044c\u0432\u0430\u044e\u0446\u044c \u0446\u0435\u043b\u0430, \u0430\u0434\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u045e\u043b\u0430\u0434\u0443, \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u0430\u0431\u043b\u043e\u043a\u0456 \u0431\u044f\u0437\u0432\u043e\u0434\u043d\u044b\u044f, \u0448\u0442\u043e \u0432\u0435\u0446\u0435\u0440 \u0433\u0430\u043d\u044f\u0435, \u0433\u044d\u0442\u0430 \u0432\u043e\u0441\u0435\u043d\u044c\u0441\u043a\u0456\u044f \u0434\u0440\u044d\u0432\u044b, \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u044b\u044f, \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0430\u0441\u043e\u0445\u043b\u044b\u044f \u0456 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u044b\u044f, \u0433\u044d\u0442\u0430 \u0434\u0437\u0456\u043a\u0456\u044f \u0445\u0432\u0430\u043b\u0456 \u043c\u0430\u0440\u0441\u043a\u0456\u044f, \u0448\u0442\u043e \u043f\u0435\u043d\u044f\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u0441\u043e\u0440\u0430\u043c\u0430\u043c, \u0437\u043e\u0440\u044b \u0431\u043b\u0443\u043a\u0430\u044e\u0447\u044b\u044f, \u0434\u043b\u044f \u044f\u043a\u0456\u0445 \u0437\u043c\u0440\u043e\u043a \u0446\u0435\u043c\u0440\u044b \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430\u043a\u0430\u043d\u0430\u0432\u0430\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b \u0436, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u044b, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0440\u0430\u043d\u0435\u0439 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u0432\u0430\u043c, \u0448\u0442\u043e \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0437\u2019\u044f\u0432\u044f\u0446\u0446\u0430 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0456\u0445 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0441\u0435\u0435 \u043f\u0430\u0434\u0437\u0435\u043b\u044b, \u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u0456\u043d\u0441\u0442\u044b\u043d\u043a\u0442\u0430\u043c\u0456 \u0456 \u043d\u0435 \u043c\u0430\u0435 \u0414\u0443\u0445\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0432\u044b, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u043d\u0430 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439 \u0456 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u0447\u0430\u043a\u0430\u0439\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430. \u0414\u0430 \u0430\u0434\u043d\u044b\u0445, \u0448\u0442\u043e \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u044e\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f; \u0434\u0440\u0443\u0433\u0456\u0445 \u0440\u0430\u0442\u0443\u0439\u0446\u0435, \u0432\u044b\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0437 \u0430\u0433\u043d\u044e; \u044f\u0448\u0447\u044d \u0456\u043d\u0448\u044b\u043c \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0439\u0446\u0435 \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u0430, \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044f\u0447\u044b \u043d\u0430\u0432\u0430\u0442 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0443\u044e \u0446\u0435\u043b\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0437\u0431\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u0430\u0441 \u0430\u0434 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0441\u043b\u0430\u0432\u044b \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c\u0456, \u0411\u043e\u0433\u0443 \u0430\u0434\u0437\u0456\u043d\u0430\u043c\u0443, \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u043c\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u2013 \u0441\u043b\u0430\u0432\u0430, \u0432\u0435\u043b\u0456\u0447, \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u045e\u043b\u0430\u0434\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0432\u044f\u043a\u0430\u043c\u0456, \u0446\u044f\u043f\u0435\u0440 \u0456 \u043d\u0430 \u045e\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0426\u0456\u0442 2, 12b-13; \u0413\u0431\u0440 10, 24<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u045e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0445\u0432\u0430\u043b\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u043d\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0427\u0430\u043a\u0430\u044e\u0447\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"411","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">1, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0413\u0430\u043d\u044c\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u0437\u0456\u044f \u0406\u0441\u0430\u0456, \u0441\u044b\u043d\u0430 \u0410\u043c\u043e\u0441\u0430, \u044f\u043a\u0430\u044f \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u042e\u0434\u044b \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u0434\u043d\u0456 \u041e\u0437\u0456\u0456, \u0401\u0430\u0442\u0430\u043d\u0430, \u0410\u0445\u0430\u0437\u0430 \u0456 \u042d\u0437\u044d\u0445\u0456\u0456, \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u042e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u043f\u0430\u0447\u0443\u0439, \u0437\u044f\u043c\u043b\u044f, \u0431\u043e \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e: &laquo;\u042f \u0432\u044b\u0433\u0430\u0434\u0430\u0432\u0430\u045e \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u0441\u044b\u043d\u043e\u045e, \u0430\u043b\u0435 \u044f\u043d\u044b \u045e\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u044f\u043d\u0435. \u0412\u043e\u043b \u0432\u0435\u0434\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0430\u0441\u0451\u043b &ndash; \u0436\u043e\u043b\u0430\u0431 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e; \u0430\u043b\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430 \u0433\u0440\u044d\u0448\u043d\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u043d\u0430\u0440\u043e\u0434\u0443 \u0446\u044f\u0436\u043a\u0430\u0433\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0437\u043b\u0430\u0434\u0437\u0435\u0439\u0441\u043a\u0430\u043c\u0443 \u043d\u0430\u0441\u0435\u043d\u043d\u044e, \u0441\u044b\u043d\u0430\u043c \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u0456! \u042f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041f\u0430\u043d\u0430, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0421\u0432\u044f\u0442\u044b\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0430\u0437\u0430\u0434.<br \/>\u042f\u043a \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u044f\u0448\u0447\u044d \u0432\u0430\u0441, \u0448\u0442\u043e \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b? \u0423\u0441\u044f \u0433\u0430\u043b\u0430\u0432\u0430 \u0445\u0432\u043e\u0440\u0430\u044f, \u0456 \u045e\u0441\u0451 \u0441\u044d\u0440\u0446\u0430 \u0430\u0441\u043b\u0430\u0431\u043b\u0430. \u0410\u0434 \u0441\u0442\u0443\u043f\u043d\u0456 \u043d\u0430\u0433\u0456 \u0434\u0430 \u043c\u0430\u043a\u0430\u045e\u043a\u0456 \u0433\u0430\u043b\u0430\u0432\u044b \u043d\u044f\u043c\u0430 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430: \u044f\u0437\u0432\u044b, \u0441\u0456\u043d\u044f\u043a\u0456 \u0456 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u0440\u0430\u043d\u044b, \u044f\u043a\u0456\u0445 \u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0456, \u043d\u0435 \u043b\u044f\u0447\u044b\u043b\u0456 \u0456 \u043d\u0435 \u0437\u043c\u044f\u043a\u0447\u0430\u043b\u0456 \u0430\u043b\u0435\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b \u043a\u0440\u0430\u0439 \u0432\u0430\u0448, \u0433\u0430\u0440\u0430\u0434\u044b \u0432\u0430\u0448\u044b\u044f \u0441\u043f\u0430\u043b\u0435\u043d\u044b \u0430\u0433\u043d\u0451\u043c; \u0437\u044f\u043c\u043b\u044e \u0432\u0430\u0448\u0443 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0446\u044c \u043d\u0430 \u0432\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445 \u0447\u0443\u0436\u044b\u044f &ndash; \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435, \u044f\u043a \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0448\u044d\u0441\u0446\u044f \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e.<br \/>\u0406 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430, \u044f\u043a \u0445\u0430\u0446\u0456\u043d\u0430 \u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443, \u044f\u043a \u0448\u0430\u043b\u0430\u0448 \u043d\u0430 \u0430\u0433\u0443\u0440\u043a\u043e\u0432\u044b\u043c \u043f\u043e\u043b\u0456, \u044f\u043a \u0433\u043e\u0440\u0430\u0434 \u0443 \u0430\u0431\u043b\u043e\u0437\u0435. \u041a\u0430\u043b\u0456 \u0431 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u043c \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u044d\u0448\u0442\u044b, \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u0431 \u044f\u043a \u0421\u0430\u0434\u043e\u043c\u0430, \u0431\u044b\u043b\u0456 \u0431 \u044f\u043a \u0413\u0430\u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0441\u0430\u0434\u043e\u043c\u0441\u043a\u0456\u044f, \u043f\u0430\u0447\u0443\u0439 \u0437\u0430\u043a\u043e\u043d \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043d\u0430\u0440\u043e\u0434 \u0413\u0430\u043c\u043e\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u041c\u043d\u0435 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0432\u0430\u0448\u044b? &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u042f \u0441\u044b\u0442\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u043c\u0456 \u0431\u0430\u0440\u0430\u043d\u043e\u045e \u0456 \u0442\u0443\u043a\u0430\u043c \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u044b\u0445 \u0436\u044b\u0432\u0451\u043b. \u042f \u043d\u0435 \u0445\u0430\u0447\u0443 \u043a\u0440\u044b\u0432\u0456 \u0446\u044f\u043b\u044f\u0442, \u044f\u0433\u043d\u044f\u0442 \u0456 \u043a\u0430\u0437\u043b\u043e\u045e. \u041a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0434 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u0442\u0430\u043f\u0442\u0430\u043b\u0456 \u041c\u0430\u0435 \u043f\u0430\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0456? \u041d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u044c\u0446\u0435 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0440\u043d\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u045e, \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u045e \u041c\u044f\u043d\u0435 \u0430\u0433\u0456\u0434\u0443. \u0421\u0432\u044f\u0442\u0430\u045e \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a\u0430, \u0448\u0430\u0431\u0430\u0442\u0443 \u0456 \u0441\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0441\u0445\u043e\u0434\u0430\u045e \u042f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0437\u043d\u0435\u0441\u0446\u0456: \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043d\u043d\u044f. \u041c\u0430\u044f \u0434\u0443\u0448\u0430 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u043b\u0430 \u0432\u0430\u0448\u044b\u044f \u0441\u0432\u044f\u0442\u044b \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a\u0430 \u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u044b. \u042f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0456 \u041c\u043d\u0435 \u0456\u0445 \u0446\u044f\u0436\u043a\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c. \u041a\u0430\u043b\u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435, \u042f \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e \u0430\u0434 \u0432\u0430\u0441 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b. \u0406 \u043a\u0430\u043b\u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u043d\u043e\u0436\u044b\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0441\u0432\u0430\u0435, \u042f \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u043d\u0435 \u0431\u0443\u0434\u0443, \u0431\u043e \u0432\u0430\u0448\u044b \u0440\u0443\u043a\u0456 \u043f\u043e\u045e\u043d\u044b\u044f \u043a\u0440\u044b\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u043c\u044b\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0435 \u0430\u0434 \u0432\u0430\u0447\u044d\u0439 \u041c\u0430\u0456\u0445 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f. \u041f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439\u0446\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u0430\u043c\u0443, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0441\u0456\u0440\u0430\u0442\u0443, \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u045e\u0434\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u043c, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c, \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433; \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0440\u0432\u043e\u0432\u044b\u044f \u044f\u043a \u043f\u0443\u0440\u043f\u0443\u0440, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u0432\u043e\u045e\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 1, 16. 18. 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u043c\u044b\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0435 \u0430\u0434 \u0432\u0430\u0447\u044d\u0439 \u041c\u0430\u0456\u0445 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c, \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c, \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433.<\/p>\r\n"}, {"GCH_CH_1_ID":"412","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\"> 1, 21-27; 2, 1-5<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u0434 \u043d\u0430\u0434 \u0421\u0456\u0451\u043d\u0430\u043c \u0456 \u044f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. <\/span><br><span style=\"color: #ff0000;\">\u0421\u0445\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0441\u0442\u0430\u045e \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446\u0430\u0439 \u0432\u0435\u0440\u043d\u044b \u0433\u043e\u0440\u0430\u0434? \u0401\u043d \u0431\u044b\u045e \u043f\u043e\u045e\u043d\u044b \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0436\u044b\u043b\u0430 \u045e \u0456\u043c, \u0430 \u0446\u044f\u043f\u0435\u0440 &ndash; \u0437\u0430\u0431\u043e\u0439\u0446\u044b. \u0421\u0440\u044d\u0431\u0440\u0430 \u0442\u0432\u0430\u0451 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0448\u043b\u0430\u043a, \u0432\u0456\u043d\u043e \u0442\u0432\u0430\u0451 \u0440\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u0432\u0430\u0434\u043e\u044e. \u041a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u0442\u0432\u0430\u0435 \u043d\u0435\u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f, \u044f\u043d\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0456 \u0437\u043b\u043e\u0434\u0437\u0435\u044f\u045e, \u0443\u0441\u0435 \u043b\u044e\u0431\u044f\u0446\u044c \u0445\u0430\u0431\u0430\u0440 \u0456 \u0433\u043e\u043d\u044f\u0446\u0446\u0430 \u0437\u0430 \u043f\u0430\u0434\u0430\u0440\u0443\u043d\u043a\u0430\u043c\u0456. \u0421\u0456\u0440\u0430\u0442\u044b \u043d\u0435 \u0431\u0430\u0440\u043e\u043d\u044f\u0446\u044c, \u0456 \u0441\u043a\u0430\u0440\u0433\u0430 \u045e\u0434\u0430\u0432\u044b \u0434\u0430 \u0456\u0445 \u043d\u0435 \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u041c\u043e\u0446\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u0410\u0445, \u042f \u0441\u0443\u0446\u0435\u0448\u0443 \u0441\u044f\u0431\u0435 \u043f\u043e\u043c\u0441\u0442\u0430\u044e \u043d\u0430\u0434 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456 \u0430\u0434\u043f\u043b\u0430\u0447\u0443 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u043c \u0441\u0432\u0430\u0456\u043c. \u042f \u0437\u0432\u044f\u0440\u043d\u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0456 \u043d\u0456\u0431\u044b \u0448\u0447\u043e\u043b\u0430\u043a\u0430\u043c \u0430\u0447\u044b\u0448\u0447\u0443 \u0430\u0434 \u0448\u043b\u0430\u043a\u0443 \u0446\u044f\u0431\u0435, \u0456 \u0432\u044b\u0434\u0430\u043b\u044e \u0437 \u0446\u044f\u0431\u0435 \u045e\u0441\u0451 \u0432\u043e\u043b\u0430\u0432\u0430. \u0406 \u0432\u044f\u0440\u043d\u0443 \u0442\u0430\u0431\u0435 \u0441\u0443\u0434\u0434\u0437\u044f\u045e, \u044f\u043a \u0431\u044b\u043b\u043e \u0440\u0430\u043d\u0435\u0439, \u0456 \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u044f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456. \u0422\u0430\u0434\u044b \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c &ldquo;\u0433\u043e\u0440\u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0433\u043e\u0440\u0430\u0434 \u0432\u0435\u0440\u043d\u044b&rdquo;&raquo;. \u041f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435\u043c \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0421\u0456\u0451\u043d, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0431\u0430\u0447\u044b\u045e \u0406\u0441\u0430\u044f, \u0441\u044b\u043d \u0410\u043c\u043e\u0441\u0430, \u043f\u0440\u0430 \u042e\u0434\u044d\u044e \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u0406 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456, \u0448\u0442\u043e \u0433\u0430\u0440\u0430 \u0434\u043e\u043c\u0443 \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u043e\u0440 \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u043c\u0456, \u0456 \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0434\u0430 \u044f\u0435 \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b. \u0406 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0456 \u045e\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430 \u045e \u0434\u043e\u043c \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430\u0432\u0430, \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0401\u043d \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0456 \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456&raquo;. \u0411\u043e \u0437 \u0421\u0456\u0451\u043d\u0430 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437\u0430\u043a\u043e\u043d, \u0456 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0431\u0443\u0434\u0437\u0435 \u0401\u043d \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043f\u043b\u044f\u043c\u0451\u043d\u044b, \u0456 \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b; \u0456 \u043f\u0435\u0440\u0430\u043a\u0443\u044e\u0446\u044c \u043c\u044f\u0447\u044b \u0441\u0432\u0430\u0435 \u043d\u0430 \u043f\u043b\u0443\u0433\u0456, \u0456 \u0434\u0437\u0456\u0434\u044b \u0441\u0432\u0430\u0435 \u043d\u0430 \u0441\u044f\u0440\u043f\u044b; \u043d\u0435 \u045e\u0437\u0434\u044b\u043c\u0435 \u043d\u0430\u0440\u043e\u0434 \u043d\u0430 \u043d\u0430\u0440\u043e\u0434 \u043c\u044f\u0447\u0430, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0432\u0430\u044f\u0432\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u043c\u0435 \u042f\u043a\u0443\u0431\u0430, \u043f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0456\u0445 4, 2; \u042f\u043d 4, 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u0434\u044b\u043c\u0435\u043c\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430\u0432\u0430: * \u0401\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0456 \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u041c\u0435\u0441\u0456\u044f, \u044f\u043a\u0456 \u0437\u0430\u0432\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u041a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0443\u0441\u0451.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0456 \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456 \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_1_ID":"413","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">2,<\/span> <span style=\"color: #ff0000;\">6-22; 4, 2-6&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u0434 \u0411\u043e\u0436\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0434\u043e\u043c \u042f\u043a\u0443\u0431\u0430, \u0431\u043e \u0451\u043d \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u045e\u0441\u0445\u043e\u0434\u043d\u0456\u043c\u0456 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u0430\u043c\u0456, \u044f\u043a \u0443 \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e. \u0420\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e \u0431&rsquo;\u044e\u0446\u044c \u0443 \u0434\u0430\u043b\u043e\u043d\u0456. \u042f\u0433\u043e \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0441\u0440\u044d\u0431\u0440\u0430\u043c \u0456 \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u0456 \u043d\u044f\u043c\u0430 \u043c\u0435\u0436\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u043a\u0430\u0440\u0431\u0430\u043c. \u042f\u0433\u043e \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u043a\u043e\u043d\u0435\u0439, \u0456 \u043d\u044f\u043c\u0430 \u043b\u0456\u0447\u0431\u044b \u044f\u0433\u043e\u043d\u044b\u043c \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u043c. \u042f\u0433\u043e \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0456\u0434\u0430\u043b\u0430\u045e, \u0456 \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u044e\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u0435 \u0440\u0443\u043a \u0441\u0432\u0430\u0456\u0445 &ndash; \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0456\u0445 \u043f\u0430\u043b\u044c\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u0445\u0456\u043b\u0456\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0456 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e\u0441\u044f \u043c\u0443\u0436. \u0406 \u0422\u044b \u043d\u0435 \u0434\u0430\u0440\u0443\u0439 \u0456\u043c. \u0406\u0434\u0437\u0456 \u045e \u0441\u043a\u0430\u043b\u044b \u0456 \u0441\u0445\u0430\u0432\u0430\u0439\u0441\u044f \u045e \u043f\u044b\u043b\u0435 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u0443\u0441\u0446\u044f\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0432\u043e\u0447\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u043f\u044b\u0445\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430 \u045e \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439. \u0411\u043e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b, \u043f\u044b\u0445\u043b\u0456\u0432\u044b \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u043c\u0435\u0440\u043d\u044b; \u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c. \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u043a\u0435\u0434\u0440\u0430\u045e \u041b\u0456\u0431\u0430\u043d\u0430, \u0432\u044b\u0441\u043e\u043a\u0456\u0445 \u0456 \u043f\u0430\u0432\u0430\u0436\u043d\u044b\u0445, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0434\u0443\u0431\u043e\u045e \u0411\u0430\u0448\u0430\u043d\u0430, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0432\u044b\u0441\u043e\u043a\u0456\u0445 \u0433\u043e\u0440 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0437\u043d\u044f\u0442\u044b\u0445 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u044f\u043a\u0430\u0439 \u0432\u044b\u0441\u043e\u043a\u0430\u0439 \u0432\u0435\u0436\u044b \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u043c\u0443\u0440\u0443, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u0431\u043b\u0451\u045e \u0437 \u0422\u0430\u0440\u0441\u0456\u0441\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0440\u0430\u0441\u043a\u043e\u0448\u043d\u044b\u0445 \u0432\u044b\u044f\u0432\u0430\u045e \u0456\u0445\u043d\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u044b\u0445\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e\u043f\u0430\u0434\u0437\u0435, \u0430 \u0432\u044b\u0441\u0430\u043a\u0430\u043c\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435, \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u0456\u0434\u0430\u043b\u044b \u0436 \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0430\u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c. \u042f\u043d\u044b \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0441\u043a\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u044f\u0447\u043e\u0440\u044b \u0456 \u043f\u0430\u0434\u0437\u0435\u043c\u043d\u044b\u044f \u044f\u043c\u044b \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435, \u043a\u0430\u0431 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u043a\u0456\u043d\u0435 \u043a\u0440\u0430\u0442\u0430\u043c \u0456 \u043a\u0430\u0436\u0430\u043d\u0430\u043c \u0441\u0432\u0430\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0437 \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u044b\u0445 \u0434\u043b\u044f \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f. \u0406 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0441\u043a\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u044f\u0447\u043e\u0440\u044b \u0456 \u043f\u0430\u0434\u0437\u0435\u043c\u043d\u044b\u044f \u044f\u043c\u044b \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435, \u043a\u0430\u0431 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e\u043c \u0456 \u0441\u043b\u0430\u0432\u0430\u044e, \u0456 \u043f\u043b\u043e\u0434 \u0437\u044f\u043c\u043b\u0456 &ndash; \u0433\u043e\u043d\u0430\u0440\u0430\u043c \u0456 \u0430\u0437\u0434\u043e\u0431\u0430\u044e \u0430\u0446\u0430\u043b\u0435\u043b\u044b\u0445 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430: \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0456 \u0430\u0446\u0430\u043b\u0435\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0441\u0432\u044f\u0442\u044b\u043c, \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0437\u043c\u044b\u0435 \u0431\u0440\u0443\u0434 \u0437 \u0434\u0430\u0447\u043e\u043a \u0421\u0456\u0451\u043d\u0430 \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0430\u0434 \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u0439 \u0443 \u0456\u043c \u043a\u0440\u044b\u0432\u0456 \u0434\u0443\u0445\u0430\u043c \u0441\u0443\u0434\u0430 \u0456 \u0434\u0443\u0445\u0430\u043c \u0430\u0433\u043d\u044f, \u0441\u0442\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d \u043d\u0430\u0434 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u0430\u043c \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d\u0441\u043a\u0430\u0439 \u0456 \u043d\u0430\u0434 \u0437\u0431\u043e\u0440\u0430\u043c\u0456 \u044f\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u045e\u0434\u0437\u0435\u043d\u044c, \u0456 \u0434\u044b\u043c \u0456 \u0431\u043b\u044f\u0441\u043a \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430 \u043d\u043e\u0447\u0447\u0443, \u0431\u043e \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0456 \u0448\u0430\u0442\u0440\u043e\u043c, \u0448\u0442\u043e \u045e\u0434\u0437\u0435\u043d\u044c \u0434\u0430\u0435 \u0446\u0435\u043d\u044c \u0430\u0434 \u0441\u043f\u0451\u043a\u0456, \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0430\u043c \u0456 \u0437\u0430\u0446\u0456\u0448\u043a\u0430\u043c \u0430\u0434 \u0431\u0443\u0440\u044b \u0456 \u0434\u0430\u0436\u0434\u0436\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 2, 11; \u041c\u0446 24, 30<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043f\u0443\u0441\u0446\u044f\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0432\u043e\u0447\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u043f\u044b\u0445\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0431\u0430\u0447\u0430\u0446\u044c \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u043e\u0446\u0430\u0439 \u0456 \u0432\u0435\u043b\u0456\u0447\u0447\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"414","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">5, 1-7<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443 \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0441\u043f\u044f\u0432\u0430\u044e \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044e \u043c\u0430\u0439\u043c\u0443 \u043f\u0435\u0441\u043d\u044e \u0441\u044f\u0431\u0440\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0440\u0430 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u044f\u0433\u043e\u043d\u044b:<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0439 \u0441\u044f\u0431\u0440\u0430 \u043c\u0435\u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u043d\u0430 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439 \u0433\u0430\u0440\u044b. \u0401\u043d \u0443\u0441\u043a\u0430\u043f\u0430\u045e \u044f\u0433\u043e \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0430\u0434 \u043a\u0430\u043c\u0435\u043d\u043d\u044f, \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u0443 \u0456\u043c \u0430\u0434\u0431\u043e\u0440\u043d\u0443\u044e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0443\u044e \u043b\u0430\u0437\u0443, \u0456 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0432\u0435\u0436\u0443 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u044f\u0433\u043e, \u0456 \u0434\u0430\u0432\u0456\u043b\u0430 \u0432\u044b\u0447\u0430\u0441\u0430\u045e \u0443 \u0456\u043c. \u0427\u0430\u043a\u0430\u045e, \u0448\u0442\u043e \u0434\u0430\u0441\u0446\u044c \u0451\u043d \u0433\u0440\u043e\u043d\u043a\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443, \u0430\u043b\u0435 \u0451\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0434\u0437\u0456\u043a\u0456\u044f \u044f\u0433\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0446\u044f\u043f\u0435\u0440, \u0436\u044b\u0445\u0430\u0440\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u043c\u0443\u0436\u044b \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u044f, \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u0446\u0435 \u043c\u044f\u043d\u0435 \u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u043c\u043e\u0439. \u0428\u0442\u043e \u044f\u0448\u0447\u044d \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0434\u043b\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443 \u043c\u0430\u0439\u0433\u043e \u0456 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u044f\u0433\u043e? \u0427\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u044f \u0447\u0430\u043a\u0430\u045e \u0433\u0440\u043e\u043d\u0430\u043a \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443, \u0451\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0434\u0437\u0456\u043a\u0456\u044f \u044f\u0433\u0430\u0434\u044b?<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u043f\u0430\u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u044f \u0437\u0440\u0430\u0431\u043b\u044e \u0437 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u043c \u043c\u0430\u0456\u043c: \u044f \u043f\u0440\u044b\u0431\u044f\u0440\u0443 \u044f\u0433\u043e \u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0443, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b \u0451\u043d, \u0437\u043d\u0456\u0448\u0447\u0443 \u0441\u0446\u044f\u043d\u0443 \u044f\u0433\u043e, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u044b. \u0406 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u044f\u0433\u043e \u045e \u0437\u0430\u043f\u0443\u0441\u0446\u0435\u043d\u043d\u0435: \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u0440\u0430\u0437\u0430\u0446\u044c \u0456 \u045e\u0441\u043a\u043e\u043f\u0432\u0430\u0446\u044c \u044f\u0433\u043e, \u0456 \u0437\u0430\u0440\u0430\u0441\u0446\u0435 \u0451\u043d \u0446\u0435\u0440\u043d\u0435\u043c \u0456 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435\u043c, \u0456 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044e \u0445\u043c\u0430\u0440\u0430\u043c \u043b\u0456\u0446\u044c \u043d\u0430 \u044f\u0433\u043e \u0434\u043e\u0436\u0434\u0436.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e &ndash; \u0433\u044d\u0442\u0430 \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u043c\u0443\u0436\u044b \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u044f &ndash; \u042f\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u0430\u0434\u0436\u0430\u043d\u0446\u044b; \u0401\u043d \u0447\u0430\u043a\u0430\u045e \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f &ndash; \u0456 \u0432\u043e\u0441\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435; \u0447\u0430\u043a\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 &ndash; \u0456 \u0432\u043e\u0441\u044c \u043a\u0440\u044b\u043a.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 80 (79), 14. 15. 3. 16. 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044f\u0441\u043d\u044b \u0434\u0437\u0456\u043a \u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0422\u0432\u043e\u0439 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u0456 \u0437\u0432\u0435\u0440 \u043f\u0430\u043b\u044f\u0432\u044b \u044f\u0433\u043e \u0430\u0431&rsquo;\u044f\u0434\u0430\u0435; \u0443\u0431\u0430\u0447, \u041f\u0430\u043d\u0435, \u0456 \u0430\u0431\u0443\u0434\u0437\u0456 \u0441\u0432\u0430\u044e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u043b\u0430 \u0422\u0432\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0456 \u045e\u0431\u0430\u0447, \u043d\u0430\u0432\u0435\u0434\u0430\u0439 \u0433\u044d\u0442\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u043b\u0430 \u0422\u0432\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"415","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">16, 1-5; 17, 4-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0456\u0451\u043d &ndash; \u043f\u0440\u044b\u0442\u0443\u043b\u0430\u043a \u0434\u043b\u044f \u043c\u0430\u0430\u0431\u0456\u0442\u0430\u045e. <\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u041d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u042d\u0444\u0440\u0430\u0456\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0448\u043b\u0456\u0446\u0435 \u044f\u0433\u043d\u044f \u0434\u043b\u044f \u045e\u043b\u0430\u0434\u0430\u0440\u0430 \u0437\u044f\u043c\u043b\u0456 \u0437 \u0421\u044d\u043b\u044b \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0434\u0430 \u0433\u0430\u0440\u044b \u0434\u0430\u0447\u043a\u0456 \u0421\u0456\u0451\u043d\u0430. \u042f\u043a \u0431\u043b\u0443\u043a\u0430\u0435 \u043f\u0442\u0443\u0448\u043a\u0430, \u043f\u0440\u0430\u0433\u043d\u0430\u043d\u0430\u044f \u0437 \u0433\u043d\u044f\u0437\u0434\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u043e\u0447\u043a\u0456 \u041c\u0430\u0430\u0431\u0430 \u043d\u0430 \u043f\u0435\u0440\u0430\u043f\u0440\u0430\u0432\u0435 \u043f\u0440\u0430\u0437 \u0410\u0440\u043d\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0439 \u043f\u0430\u0440\u0430\u0434\u0443, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456 \u043f\u0440\u044b\u0441\u0443\u0434, \u0437\u0440\u0430\u0431\u0456 \u044f\u043a \u043d\u043e\u0447 \u0441\u0432\u043e\u0439 \u0446\u0435\u043d\u044c \u043f\u0430\u045e\u0434\u0437\u0451\u043d\u043d\u044b, \u0441\u0445\u0430\u0432\u0430\u0439 \u0432\u044b\u0433\u043d\u0430\u043d\u0446\u0430\u045e \u0456 \u043d\u0435 \u0432\u044b\u0434\u0430\u0432\u0430\u0439 \u0443\u0446\u0435\u043a\u0430\u0447\u043e\u045e. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u0435\u043b\u044f\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435 \u0432\u044b\u0433\u043d\u0430\u043d\u0446\u044b \u0437 \u041c\u0430\u0430\u0431\u0430; \u0441\u0442\u0430\u043d\u044c \u0434\u043b\u044f \u0456\u0445 \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430\u043c \u0430\u0434 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430. \u0411\u043e \u0437\u043d\u0456\u043a \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a, \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435, \u0441\u044b\u0448\u043b\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0442\u0430\u043f\u0442\u0430\u045e \u0437\u044f\u043c\u043b\u044e. \u0406 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0431\u0443\u0434\u0437\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0442\u0440\u043e\u043d, \u0456 \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0456\u043c \u0443 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u045e \u0448\u0430\u0442\u0440\u044b \u0414\u0430\u0432\u0456\u0434\u0430 \u0441\u0443\u0434\u0434\u0437\u044f, \u044f\u043a\u0456 \u0448\u0443\u043a\u0430\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f \u0456 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439 \u043f\u0430\u043c\u0435\u043d\u0448\u044b\u0446\u0446\u0430 \u0441\u043b\u0430\u0432\u0430 \u042f\u043a\u0443\u0431\u0430, \u0456 \u0441\u0445\u0443\u0434\u043d\u0435\u0435 \u0441\u044b\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u044f\u0433\u043e. \u0406 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u044f\u043a \u043f\u0430\u0441\u043b\u044f \u0436\u043d\u0456\u0432\u0430 \u045e \u0434\u0430\u043b\u0456\u043d\u0435 \u0420\u044d\u0444\u0430\u0456\u043c\u0430, \u043a\u0430\u043b\u0456 \u0436\u043d\u0435\u0446 \u0437\u0431\u0456\u0440\u0430\u0435 \u0437\u0431\u043e\u0436\u0436\u0430 \u0456 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u043e\u0439 \u0436\u043d\u0435 \u043a\u0430\u043b\u0430\u0441\u044b. \u0406 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0456\u043c \u0440\u044d\u0448\u0442\u043a\u0456, \u044f\u043a \u043f\u0440\u044b \u0430\u0431\u0442\u0440\u0443\u0448\u0432\u0430\u043d\u043d\u0456 \u0430\u043b\u0456\u0432\u0430\u043a &ndash; \u0434\u0437\u0432\u0435-\u0442\u0440\u044b \u0430\u043b\u0456\u045e\u043a\u0456 \u043d\u0430 \u0432\u0435\u0440\u0441\u0435 \u0433\u0430\u043b\u0456\u043d\u044b, \u0447\u0430\u0442\u044b\u0440\u044b-\u043f\u044f\u0446\u044c \u043d\u0430 \u0433\u0430\u043b\u0456\u043d\u0430\u0445 \u043f\u043b\u0451\u043d\u043d\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043a\u0456\u0440\u0443\u0435 \u043f\u043e\u0437\u0456\u0440\u043a \u0441\u0432\u043e\u0439 \u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0430 \u0432\u043e\u0447\u044b \u044f\u0433\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b, \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u0443 \u0440\u0443\u043a \u0441\u0432\u0430\u0456\u0445, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u043b\u044c\u0446\u044b, \u043d\u0456 \u043d\u0430 \u043a\u0443\u043b\u044c\u0442\u0430\u0432\u044b\u044f \u0441\u043b\u0443\u043f\u044b, \u043d\u0456 \u043d\u0430 \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0415\u0440 33, 15, 16; \u0406\u0441 16, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0437\u0433\u0430\u0434\u0443\u044e \u0434\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u044f\u0433\u043e: \u041f\u0430\u043d &ndash; \u043d\u0430\u0448\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0431\u0443\u0434\u0437\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0442\u0440\u043e\u043d, \u0456 \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0456\u043c \u0443 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0443\u0434\u0434\u0437\u044f, \u044f\u043a\u0456 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u044f\u0433\u043e: \u041f\u0430\u043d &ndash; \u043d\u0430\u0448\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"416","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">19, 16-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0443\u0447\u0430\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u0456 \u0430\u0441\u0456\u0440\u044b\u0439\u0446\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u0436\u0430\u043d\u0447\u044b\u043d\u044b: \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0440\u044b\u0436\u044d\u0446\u044c \u0456 \u0431\u0430\u044f\u0446\u0446\u0430 \u0440\u0443\u043a\u0456 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0448\u0442\u043e \u043f\u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u0445. \u0422\u0430\u0434\u044b \u0437\u044f\u043c\u043b\u044f \u042e\u0434\u044b \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0415\u0433\u0456\u043f\u0442\u0430 \u0436\u0430\u0445\u0430\u043c. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u045e\u0437\u0433\u0430\u0434\u0430\u0435 \u043f\u0440\u0430 \u044f\u0435, \u0442\u043e\u0439 \u0437\u0430\u0442\u0440\u0430\u043f\u0435\u0447\u0430 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0443 \u0415\u0433\u0456\u043f\u0446\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u044f\u0446\u044c \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0430\u0439 \u043c\u043e\u0432\u0435 \u0456 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0446\u044c \u043d\u0430 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0410\u0434\u0437\u0456\u043d \u0437 \u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u0441\u043e\u043d\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0430\u043b\u0442\u0430\u0440 \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0430 \u043a\u0430\u043b\u044f \u044f\u0433\u043e \u043c\u044f\u0436\u044b &ndash; \u0441\u0442\u044d\u043b\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430. \u0406 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0430\u043a\u0430\u043c \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0443 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u041a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u043a\u043b\u0456\u0447\u0443\u0446\u044c \u041f\u0430\u043d\u0430, \u0401\u043d \u043f\u0430\u0448\u043b\u0435 \u0456\u043c \u0437\u0431\u0430\u045e\u0446\u0443 \u0456 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0443, \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0456\u0445. \u041f\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c, \u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u043c\u0456, \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0430\u0432\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u041f\u0430\u043d\u0443 \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u044e\u0446\u044c \u0456\u0445. \u0406 \u041f\u0430\u043d \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u0456 \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c. \u0422\u0430\u0434\u044b \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0456 \u0401\u043d \u0430\u0434\u043a\u0430\u0436\u0430 \u0456\u043c, \u0456 \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0448\u043b\u044f\u0445 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u045e \u0410\u0441\u0456\u0440\u044b\u044e. \u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0430\u0441\u0456\u0440\u044b\u0439\u0446\u044b \u0434\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 &ndash; \u0434\u0430 \u0430\u0441\u0456\u0440\u044b\u0439\u0446\u0430\u045e, \u0456 \u0415\u0433\u0456\u043f\u0435\u0442 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u0441\u0456\u0440\u044b\u0439\u0446\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044d\u0446\u0456\u043c \u043f\u043e\u0431\u0430\u0447 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430\u043c \u0456 \u0410\u0441\u0456\u0440\u044b\u044f\u0439, \u0441\u0442\u0430\u043d\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0430\u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0415\u0433\u0456\u043f\u0435\u0442, \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0456 \u0410\u0441\u0456\u0440\u044b\u044f, \u0441\u043f\u0440\u0430\u0432\u0430 \u0440\u0443\u043a \u041c\u0430\u0456\u0445, \u0456 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u041c\u0430\u044f &ndash; \u0406\u0437\u0440\u0430\u044d\u043b\u044c!&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 19, 21; \u041b\u043a 13, 29<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u041f\u0430\u043d\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u043c\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0443\u0441\u0445\u043e\u0434\u0443 \u0456 \u0437 \u0437\u0430\u0445\u0430\u0434\u0443, \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u0456 \u0437 \u043f\u043e\u045e\u0434\u043d\u044f, \u0456 \u0441\u044f\u0434\u0443\u0446\u044c \u0437\u0430 \u0441\u0442\u043e\u043b \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0411\u043e\u0436\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"417","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">21, 6-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u043f\u0430\u0441\u0442\u0430\u045e \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u043d\u044f\u0445\u0430\u0439 \u0451\u043d \u043f\u0435\u0440\u0430\u0434\u0430\u0435, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c. \u0406 \u043a\u0430\u043b\u0456 \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0435\u0434\u0443\u0447\u044b\u0445 \u043f\u0430\u0440\u0430\u043c\u0456 \u043d\u0430\u0435\u0437\u043d\u0456\u043a\u0430\u045e, \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e, \u043d\u0430\u0435\u0437\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0430\u0441\u043b\u0430\u0445 \u0456 \u043d\u0430\u0435\u0437\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u0445, \u043d\u044f\u0445\u0430\u0439 \u043f\u0456\u043b\u044c\u043d\u0430 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u0446\u0446\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0451\u043d \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e, \u0431\u044b\u0446\u0446\u0430\u043c \u043b\u0435\u045e: &laquo;\u041f\u0430\u043d\u0435, \u044f \u043d\u0430 \u0432\u0430\u0440\u0446\u0435 \u0441\u0442\u0430\u044f\u045e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0446\u044d\u043b\u044b \u0434\u0437\u0435\u043d\u044c, \u043d\u0430 \u043c\u0435\u0441\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u0430\u0440\u0442\u044b \u044f \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0446\u044d\u043b\u044b\u044f \u043d\u043e\u0447\u044b. \u0406 \u0432\u043e\u0441\u044c \u044f\u043d\u044b \u0435\u0434\u0443\u0446\u044c, \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u043f\u0430\u0440\u0430\u043c\u0456&raquo;. \u0406 \u0434\u0430\u0434\u0430\u045e: &laquo;\u0423\u043f\u0430\u045e, \u0443\u043f\u0430\u045e \u0411\u0430\u0431\u0456\u043b\u0451\u043d, \u0456 \u045e\u0441\u0435 \u0432\u044b\u044f\u0432\u044b \u044f\u0433\u043e\u043d\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u043f\u0430\u0440\u0430\u0437\u0431\u0456\u0432\u0430\u043b\u0456\u0441\u044f \u0430\u0431 \u0437\u044f\u043c\u043b\u044e&raquo;. \u0410\u0431\u043c\u0430\u043b\u043e\u0447\u0430\u043d\u044b \u043c\u043e\u0439 \u0456 \u0441\u044b\u043d \u043c\u0430\u0439\u0433\u043e \u0433\u0443\u043c\u043d\u0430, \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0432\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u045e \u0430\u0434 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0430\u0434 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u042d\u0434\u043e\u043c. \u041a\u043b\u0456\u0447\u0443\u0446\u044c \u041c\u044f\u043d\u0435 \u0437 \u0421\u044d\u0456\u0440\u0430: &laquo;\u0412\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a, \u044f\u043a\u0430\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430 \u043d\u043e\u0447\u044b? \u0412\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a, \u044f\u043a\u0430\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430 \u043d\u043e\u0447\u044b?&raquo; \u0412\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0440\u0430\u043d\u0456\u0446\u0430, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u043e\u0447. \u041a\u0430\u043b\u0456 \u0432\u044b \u0445\u043e\u0447\u0430\u0446\u0435 \u043f\u044b\u0442\u0430\u0446\u0446\u0430, \u043f\u044b\u0442\u0430\u0439\u0446\u0435\u0441\u044f, \u0432\u044f\u0440\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 18, 2. 4. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: \u0423\u043f\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u0430\u0431\u0456\u043b\u0451\u043d; \u0456 \u044f \u043f\u0430\u0447\u0443\u045e \u0456\u043d\u0448\u044b \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b\u0439\u0434\u0437\u0456 \u0437 \u044f\u0433\u043e, \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u043d\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u045e \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u0430\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430\u0439\u0448\u043b\u0456 \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u0456 \u0430\u0436\u043d\u043e \u0434\u0430 \u043d\u0435\u0431\u0430, \u0456 \u045e\u0441\u043f\u043e\u043c\u043d\u0456\u045e \u041f\u0430\u043d \u043f\u0440\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u044f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0439\u0434\u0437\u0456 \u0437 \u044f\u0433\u043e, \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u043d\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u045e \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u0430\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"421","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">22, 8-23<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u044b\u0445\u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0428\u044d\u0431\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0437\u0434\u044b\u043c\u0430\u044e\u0446\u044c \u043f\u043e\u043a\u0440\u044b\u0432\u0430 \u0437 \u042e\u0434\u044d\u0456. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0442\u044b \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0437\u0430\u043f\u0430\u0441 \u0437\u0431\u0440\u043e\u0456 \u045e \u043a\u0435\u0434\u0440\u0430\u0432\u044b\u043c \u0434\u043e\u043c\u0435. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0414\u0430\u0432\u0456\u0434\u0430 \u0448\u0447\u044b\u043b\u0456\u043d\u044b, \u0431\u043e \u0456\u0445 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442. \u0412\u044b \u0441\u0430\u0431\u0440\u0430\u043b\u0456 \u0432\u043e\u0434\u044b \u0437 \u043d\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0442\u0430\u0432\u0443, \u043f\u0430\u043b\u0456\u0447\u044b\u043b\u0456 \u0434\u0430\u043c\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0440\u0430\u0437\u0430\u0431\u0440\u0430\u043b\u0456 \u0431\u0443\u0434\u044b\u043d\u043a\u0456, \u043a\u0430\u0431 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043c\u0443\u0440\u044b \u0433\u043e\u0440\u0430\u0434\u0430. \u041f\u0430\u043c\u0456\u0436 \u0434\u0432\u0443\u043c\u0430 \u043c\u0443\u0440\u0430\u043c\u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0431\u0430\u0441\u0435\u0439\u043d \u0434\u043b\u044f \u0432\u0430\u0434\u044b \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0441\u0442\u0430\u0432\u0430. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u044d\u0442\u0430 \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u043d\u0435 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u043f\u043b\u0430\u043d\u0430\u0432\u0430\u045e \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u045e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u043f\u043b\u0430\u043a\u0430\u0446\u044c \u0456 \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u044c, \u0441\u0442\u0440\u044b\u0433\u0447\u044b \u0432\u0430\u043b\u0430\u0441\u044b \u0456 \u0430\u043f\u0440\u0430\u043d\u0430\u0446\u044c \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443. \u0410\u043b\u0435 \u0432\u043e\u0441\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u0441\u0435\u043b\u043b\u0435, \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0432\u0430\u043b\u043e\u045e \u0456 \u0440\u044d\u0436\u0443\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a, \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0446\u044c \u043c\u044f\u0441\u0430 \u0456 \u043f&rsquo;\u044e\u0446\u044c \u0432\u0456\u043d\u043e: &laquo;\u0411\u0443\u0434\u0437\u0435\u043c \u0435\u0441\u0446\u0456 \u0456 \u043f\u0456\u0446\u044c, \u0431\u043e \u0437\u0430\u045e\u0442\u0440\u0430 \u043f\u0430\u043c\u0440\u043e\u043c&raquo;. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u043c\u0430\u0456\u043c \u0432\u0443\u0448\u0430\u043c: &laquo;\u0413\u044d\u0442\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0434\u0430\u0440\u0443\u0435\u0446\u0446\u0430 \u0432\u0430\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u0446\u0435!&raquo;, &ndash; \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: &laquo;\u041d\u0430\u043a\u0456\u0440\u0443\u0439\u0441\u044f \u0456 \u045e\u0432\u0430\u0439\u0434\u0437\u0456 \u0434\u0430 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430, \u0434\u0430 \u0428\u044d\u0431\u043d\u044b, \u0448\u0442\u043e \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0447\u0430\u043b\u0435 \u043f\u0430\u043b\u0430\u0446\u0430, \u0456 \u0441\u043a\u0430\u0436\u044b \u044f\u043c\u0443: &ldquo;\u0428\u0442\u043e \u045e \u0446\u044f\u0431\u0435 \u0442\u0443\u0442 \u0456 \u043a\u0430\u0433\u043e \u0442\u044b \u0442\u0443\u0442 \u043c\u0430\u0435\u0448, \u043a\u0430\u0431 \u0432\u044b\u0447\u044d\u0441\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u0443?&rdquo; \u0422\u044b \u0432\u044b\u0447\u0430\u0441\u0430\u045e \u0441\u0430\u0431\u0435 \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u0443 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u0432\u044b\u0441\u0435\u043a \u0441\u0430\u0431\u0435 \u0436\u044b\u043b\u043b\u0451 \u045e \u0441\u043a\u0430\u043b\u0435. \u0412\u043e\u0441\u044c \u041f\u0430\u043d \u0441\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0456 \u043c\u043e\u0446\u043d\u0430 \u0441\u0445\u043e\u043f\u0456\u0446\u044c \u0446\u044f\u0431\u0435. \u0401\u043d \u0441\u043a\u0440\u0443\u0446\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u045e \u043a\u043b\u0443\u0431\u043e\u043a \u0456 \u043a\u0456\u043d\u0435, \u044f\u043a \u043c\u044f\u0447, \u043d\u0430 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0422\u0430\u043c \u0442\u044b \u043f\u0430\u043c\u0440\u044d\u0448, \u0441\u043e\u0440\u0430\u043c \u0434\u043e\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u0456 \u0442\u0430\u043c \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u0430\u043f\u0445\u043d\u0443 \u0446\u044f\u0431\u0435 \u0437 \u043c\u0435\u0441\u0446\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u0441\u043a\u0456\u043d\u0443 \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u0441\u0430\u0434\u044b \u0442\u0432\u0430\u0451\u0439. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u042f \u043f\u0430\u043a\u043b\u0456\u0447\u0443 \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u0433\u043e \u042d\u043b\u0456\u044f\u043a\u0456\u043c\u0430, \u0441\u044b\u043d\u0430 \u0425\u0435\u043b\u043a\u0456\u044f. \u0410\u043f\u0440\u0430\u043d\u0443 \u044f\u0433\u043e \u045e \u0445\u0456\u0442\u043e\u043d \u0442\u0432\u043e\u0439, \u0456 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u0443 \u044f\u0433\u043e \u043f\u0430\u0441\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u043b\u0430\u0434\u0443 \u0442\u0432\u0430\u044e \u043f\u0435\u0440\u0430\u0434\u0430\u043c \u0443 \u0440\u0443\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0456 \u0441\u0442\u0430\u043d\u0435 \u0451\u043d \u0430\u0439\u0446\u043e\u043c \u0434\u043b\u044f \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0456 \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u042e\u0434\u044b. \u0406 \u045e\u0441\u043a\u043b\u0430\u0434\u0443 \u043a\u043b\u044e\u0447 \u0434\u043e\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u043d\u0430 \u043f\u043b\u0435\u0447\u044b \u044f\u0433\u043e\u043d\u044b\u044f. \u0406 \u043a\u0430\u043b\u0456 \u0451\u043d \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0447\u044b\u043d\u0456\u0446\u044c, \u0456 \u043a\u0430\u043b\u0456 \u0437\u0430\u0447\u044b\u043d\u0456\u0446\u044c, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c. \u0406 \u045e\u0432\u0430\u0431&rsquo;\u044e \u044f\u0433\u043e, \u044f\u043a \u043a\u043e\u043b \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0456 \u0451\u043d \u0441\u0442\u0430\u043d\u0435 \u0442\u0440\u043e\u043d\u0430\u043c \u0441\u043b\u0430\u0432\u044b \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0430\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 3, 7. 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u044b \u0456 \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043a\u043b\u044e\u0447 \u0414\u0430\u0432\u0456\u0434\u0430: <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u0439 \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u0434\u0437\u0432\u0435\u0440\u044b, \u044f\u043a\u0456\u0445 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0437\u0430\u0447\u044b\u043d\u0456\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u041c\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0456 \u043d\u0435 \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f \u0430\u0434 \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u0439 \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u0434\u0437\u0432\u0435\u0440\u044b, \u044f\u043a\u0456\u0445 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0437\u0430\u0447\u044b\u043d\u0456\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"422","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">24, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u045e \u042f\u0433\u043e\u043d\u044b \u0434\u0437\u0435\u043d\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u041f\u0430\u043d \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0437\u044f\u043c\u043b\u044e \u0456 \u044f\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u0435, \u043f\u0435\u0440\u0430\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435 \u044f\u0435 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u044e \u0456 \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u044f\u0435. \u0406 \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0442\u0430\u043a \u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u044f\u043a \u0441\u0430 \u0441\u043b\u0443\u0433\u043e\u044e, \u0442\u0430\u043a \u0456 \u0437 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c, \u044f\u043a \u0441\u0430 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0430\u044e, \u0442\u0430\u043a \u0456 \u0437 \u0433\u0430\u0441\u043f\u0430\u0434\u044b\u043d\u044f\u0439, \u044f\u043a \u0437 \u0433\u0430\u043d\u0434\u043b\u044f\u0440\u043e\u043c, \u0442\u0430\u043a \u0456 \u0437 \u043f\u0430\u043a\u0443\u043f\u043d\u0456\u043a\u043e\u043c, \u044f\u043a \u0437 \u043f\u0430\u0437\u044b\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c, \u0442\u0430\u043a \u0456 \u0437 \u043f\u0430\u0437\u044b\u043a\u043e\u045e\u0446\u0430\u043c. \u0417\u044f\u043c\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u0430 \u0456 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u0430 \u0446\u0430\u043b\u043a\u0430\u043c, \u0431\u043e \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043b\u0430\u0447\u0430 \u0456 \u0441\u043e\u0445\u043d\u0435 \u0437\u044f\u043c\u043b\u044f, \u0441\u0432\u0435\u0442 \u0441\u043b\u0430\u0431\u0435\u0435 \u0456 \u043d\u0456\u0448\u0447\u044b\u0446\u0446\u0430, \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u0437\u044f\u043c\u043b\u0456. \u0410\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0430 \u0437\u044f\u043c\u043b\u044f \u044f\u0435 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0440\u0443\u0448\u044b\u043b\u0456 \u0437\u0430\u043a\u043e\u043d\u044b, \u043f\u0435\u0440\u0430\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u043f\u0440\u0430\u0437 \u043d\u0430\u043a\u0430\u0437\u044b \u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043b\u0456 \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u043a\u043b\u0451\u043d \u043f\u0430\u0436\u044b\u0440\u0430\u0435 \u0437\u044f\u043c\u043b\u044e, \u0430 \u0436\u044b\u0445\u0430\u0440\u044b \u044f\u0435 \u0440\u0430\u0441\u043f\u043b\u0430\u0447\u0432\u0430\u044e\u0446\u0446\u0430 \u0437\u0430 \u0432\u0456\u043d\u0443. \u0422\u0430\u043c\u0443 \u0437\u0433\u0430\u0440\u0430\u044e\u0446\u044c \u0436\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456, \u0456 \u043c\u0430\u043b\u0430 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043c\u0443\u0442\u043a\u0443\u0435 \u043c\u0430\u043b\u0430\u0434\u043e\u0435 \u0432\u0456\u043d\u043e, \u0456 \u0432\u044f\u043d\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u0443\u0437\u0434\u044b\u0445\u0430\u044e\u0446\u044c \u0443\u0441\u0435, \u0445\u0442\u043e \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0441\u044d\u0440\u0446\u0430\u043c. \u0421\u0446\u0456\u0445\u043b\u0430 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c \u0431\u0443\u0431\u043d\u0430\u045e, \u0441\u043f\u044b\u043d\u0456\u045e\u0441\u044f \u0433\u043e\u043c\u0430\u043d \u0441\u0432\u044f\u0442\u043a\u0443\u044e\u0447\u044b\u0445, \u0437\u043c\u043e\u045e\u043a\u043b\u0430 \u0432\u044f\u0441\u0451\u043b\u0430\u0435 \u0433\u0440\u0430\u043d\u043d\u0435 \u0430\u0440\u0444\u044b. \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f&rsquo;\u044e\u0446\u044c \u0432\u0456\u043d\u0430 \u043f\u0430\u0434 \u0441\u043f\u0435\u0432\u044b, \u0456 \u0433\u043e\u0440\u043a\u0456\u043c \u0441\u0442\u0430\u045e \u043d\u0430\u043f\u043e\u0439 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u043f&rsquo;\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u044b, \u0437\u0430\u0447\u044b\u043d\u0435\u043d\u044b \u045e\u0441\u0435 \u0434\u0430\u043c\u044b, \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456. \u041d\u0430 \u0432\u0443\u043b\u0456\u0446\u0430\u0445 \u043a\u0440\u044b\u043a, \u0448\u0442\u043e \u043d\u0435\u0441\u0442\u0430\u0435 \u0432\u0456\u043d\u0430. \u0417\u043d\u0456\u043a\u043b\u0430 \u045e\u0441\u044f\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u0437\u044f\u043c\u043b\u044e. \u0423 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435, \u0431\u0440\u0430\u043c\u044b \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u044b. \u0411\u043e \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a \u043f\u0440\u044b \u0430\u0431\u0442\u0440\u0443\u0448\u0432\u0430\u043d\u043d\u0456 \u0430\u043b\u0456\u0432\u0430\u043a, \u044f\u043a \u043f\u0440\u044b \u0437\u0431\u0456\u0440\u0430\u043d\u043d\u0456 \u0440\u044d\u0448\u0442\u0430\u043a \u043f\u0430\u0441\u043b\u044f \u045e\u0431\u043e\u0440\u043a\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0430\u0446\u0430\u043b\u0435\u043b\u044b\u044f \u043f\u0430\u0434\u044b\u043c\u0443\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0432\u0435\u043b\u0456\u0447 \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0437 \u043c\u043e\u0440\u0430. \u0422\u0430\u043c\u0443 \u043d\u0430 \u045e\u0441\u0445\u043e\u0434\u0437\u0435 \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u0445\u0432\u0430\u043b\u0443 \u041f\u0430\u043d\u0443, \u043d\u0430 \u0430\u0441\u0442\u0440\u0430\u0432\u0430\u0445 \u043c\u0430\u0440\u0441\u043a\u0456\u0445 \u0445\u0432\u0430\u043b\u0456\u0446\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0410\u0434 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456 \u043c\u044b \u0447\u0443\u0435\u043c \u043f\u0435\u0441\u043d\u0456: &laquo;\u0421\u043b\u0430\u0432\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u043c\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0440\u0430\u043f\u0430\u045e \u044f, \u043f\u0440\u0430\u043f\u0430\u045e. \u0413\u043e\u0440\u0430 \u043c\u043d\u0435!&raquo; \u041a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0456\u043a\u0456 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0456\u0447\u0430\u044e\u0446\u044c, \u0437\u043b\u0430\u043c\u044b\u0441\u043d\u0456\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430. \u0416\u0430\u0445, \u0456 \u044f\u043c\u0430, \u0456 \u043f\u0430\u0441\u0442\u043a\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0436\u044b\u0445\u0430\u0440 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u0434\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0431\u044f\u0436\u044b\u0446\u044c \u0430\u0434 \u0436\u0430\u0445\u043b\u0456\u0432\u0430\u0433\u0430 \u043a\u0440\u044b\u043a\u0443, \u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u044f\u043c\u0443, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043b\u0435\u0437\u0435 \u0437 \u044f\u043c\u044b, \u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u043f\u0430\u0441\u0442\u043a\u0443, \u0431\u043e \u0430\u0434\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u045e\u0432\u0435\u0440\u0441\u0435 \u0432\u043e\u043a\u043d\u044b, \u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456 \u0437\u044f\u043c\u043b\u0456 \u0437\u0430\u0442\u0440\u0430\u0441\u0443\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 24, 14. 15; \u041f\u0441 96 (95), 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0446\u0430\u043b\u0435\u043b\u044b\u044f \u043f\u0430\u0434\u044b\u043c\u0443\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0437 \u043f\u0435\u0441\u043d\u044f\u043c\u0456 \u0445\u0432\u0430\u043b\u044b,<span style=\"color: #ff0000;\"> *<\/span> \u0430\u0434 \u0437\u0430\u0445\u0430\u0434\u0443 \u0456 \u0434\u0430 \u045e\u0441\u0445\u043e\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u041f\u0430\u043d\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0441\u043f\u044f\u0432\u0430\u0439 \u041f\u0430\u043d\u0443, \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434 \u0437\u0430\u0445\u0430\u0434\u0443 \u0456 \u0434\u0430 \u045e\u0441\u0445\u043e\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"423","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">24, 19 &ndash; 25, 5<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. \u041f\u0430\u0434\u0437\u044f\u043a\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c: \u0417\u044f\u043c\u043b\u044f \u0440\u0430\u0441\u043a\u043e\u043b\u0435\u0446\u0446\u0430 \u0446\u0430\u043b\u043a\u0430\u043c, \u0437\u044f\u043c\u043b\u044f \u0440\u0430\u0437\u0430\u0431&rsquo;\u0435\u0446\u0446\u0430, \u0437\u044f\u043c\u043b\u044f \u0437\u0430\u0442\u0440\u0430\u0441\u0435\u0446\u0446\u0430. \u0417\u0430\u0445\u0456\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f, \u044f\u043a \u043f&rsquo;\u044f\u043d\u044b, \u0456 \u0437\u0430\u0432\u0430\u0433\u0430\u0435\u0446\u0446\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0448\u0430\u0446\u0451\u0440. \u0406 \u044f\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0446\u044c \u044f\u0435, \u044f\u043d\u0430 \u045e\u043f\u0430\u0434\u0437\u0435 \u0456 \u045e\u0436\u043e \u043d\u0435 \u043f\u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u043d\u0430\u0432\u0435\u0434\u0430\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u045e\u0432\u0435\u0440\u0441\u0435, \u0430 \u045e\u043d\u0456\u0437\u0435 &ndash; \u0437\u044f\u043c\u043d\u044b\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0430\u0431\u0440\u0430\u043d\u044b \u0456 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u045e \u044f\u043c\u0435, \u0437\u0430\u043c\u043a\u043d\u0443\u0446\u044c \u0456\u0445 \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u0456 \u043f\u0430\u0441\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0437\u0451\u043d \u043f\u0430\u043a\u0430\u0440\u0430\u044e\u0446\u044c. \u0422\u0430\u0434\u044b \u0437\u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u0446\u0430 \u043c\u0435\u0441\u044f\u0446 \u0456 \u0437\u0431\u044f\u043d\u0442\u044d\u0436\u044b\u0446\u0446\u0430 \u0441\u043e\u043d\u0446\u0430, \u0431\u043e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0441\u0442\u0430\u043d\u0435 \u041a\u0430\u0440\u0430\u043b\u0451\u043c \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d \u0456 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u043f\u0435\u0440\u0430\u0434 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c\u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0441\u043b\u0430\u0432\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b &ndash; \u043c\u043e\u0439 \u0411\u043e\u0433; \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u0431\u043e \u0422\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0446\u0443\u0434\u044b, \u0434\u0430\u045e\u043d\u0456\u044f \u043d\u0430\u043c\u0435\u0440\u044b \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0456\u0441\u0446\u0456\u043d\u044b. \u0411\u043e \u0422\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0433\u043e\u0440\u0430\u0434 \u0443 \u0433\u0440\u0443\u0434\u0443 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 &ndash; \u0443 \u0440\u0443\u0456\u043d\u044b. \u0423 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u043d\u044f\u043c\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043b\u0430\u0446\u0430 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e, \u0451\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434 \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u0430 \u0433\u0430\u0440\u0430\u0434\u044b \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u0445 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u044f\u0446\u0446\u0430 \u0426\u044f\u0431\u0435. \u0422\u044b \u0441\u0442\u0430\u045e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f\u0439 \u0434\u043b\u044f \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u043b\u044f \u045e\u0431\u043e\u0433\u0430\u0433\u0430 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c, \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430\u043c \u0430\u0434 \u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u0446\u044b, \u0446\u0435\u043d\u0435\u043c \u0430\u0434 \u0441\u043f\u0451\u043a\u0456: \u0431\u043e \u043f\u043e\u0434\u044b\u0445 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u0445 \u044f\u043a \u0437\u0456\u043c\u043e\u0432\u0430\u044f \u0431\u0443\u0440\u0430, \u044f\u043a \u0441\u043f\u044f\u043a\u043e\u0442\u0430 \u045e \u0431\u044f\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u043c\u044f\u0441\u0446\u0456\u043d\u0430\u0445. \u0422\u044b \u0441\u0443\u043d\u044f\u045e \u0433\u0430\u0440\u043c\u0456\u0434\u0430\u0440 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e, \u044f\u043a \u0441\u043f\u044f\u043a\u043e\u0442\u0443 \u0446\u0435\u043d\u0435\u043c \u0445\u043c\u0430\u0440\u044b. \u0422\u044b \u0441\u0443\u0446\u0456\u0448\u044b\u045e \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u044b \u0441\u043f\u0435\u045e \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 25, 1. 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0435, \u0422\u044b &ndash; \u043c\u043e\u0439 \u0411\u043e\u0433; \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0422\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0446\u0443\u0434\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0441\u0442\u0430\u045e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f\u0439 \u0434\u043b\u044f \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u043b\u044f \u045e\u0431\u043e\u0433\u0430\u0433\u0430 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0422\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0446\u0443\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"424","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">25, 6 &ndash; 26, 6<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0436\u0430\u044f \u0433\u0430\u0441\u0446\u0456\u043d\u0430. \u041f\u0435\u0441\u043d\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0440\u044b\u0433\u0430\u0442\u0443\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0440\u044b \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u0437 \u0442\u043b\u0443\u0441\u0442\u044b\u0445 \u0441\u0442\u0440\u0430\u045e, \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u0437 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0432\u0456\u043d\u0430, \u0437 \u0442\u0443\u043a\u0443 \u043a\u0430\u0441\u0446\u0435\u0439 \u0434\u044b \u0437 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0432\u0456\u043d\u0430. \u0421\u043a\u0456\u043d\u0435 \u0401\u043d \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0440\u044b \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u0448\u0442\u043e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0442\u0432\u0430\u0440 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043f\u043e\u043a\u0440\u044b\u0432\u0430, \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u0442\u0430\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c\u0456. \u0401\u043d \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u0406 \u0432\u044b\u0442\u0440\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0441\u043b\u0451\u0437\u044b \u0437 \u0443\u0441\u0456\u0445 \u0442\u0432\u0430\u0440\u0430\u045e, \u0456 \u0437\u0434\u044b\u043c\u0435 \u0433\u0430\u043d\u044c\u0431\u0443 \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c: &laquo;\u0413\u044d\u0442\u0430 \u0401\u043d, \u043d\u0430\u0448 \u0411\u043e\u0433, \u043d\u0430 \u042f\u0433\u043e \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u0446\u044c. \u0413\u044d\u0442\u0430 \u041f\u0430\u043d, \u0443 \u0406\u043c \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456. \u0411\u043e \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u0441\u043f\u0430\u0447\u043d\u0435 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0440\u044b&raquo;. \u0406 \u041c\u0430\u0430\u0431 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u044b \u043d\u0430 \u043c\u0435\u0441\u0446\u044b \u0441\u0432\u0430\u0456\u043c, \u044f\u043a \u0442\u043e\u043f\u0447\u0443\u0446\u044c \u0441\u0430\u043b\u043e\u043c\u0443 \u043d\u0430 \u043a\u0443\u0447\u044b \u0433\u043d\u043e\u044e. \u0406 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0451\u043d \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u044f\u043a \u043f\u043b\u044b\u0432\u0435\u0446 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u0440\u0443\u043a\u0456, \u043a\u0430\u0431 \u043f\u043b\u044b\u0441\u0446\u0456, \u0430\u043b\u0435 \u041f\u0430\u043d \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u0446\u044c \u043f\u044b\u0445\u0443 \u044f\u0433\u043e\u043d\u0443\u044e \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u044f\u0433\u043e. \u0406 \u0432\u044b\u0441\u043e\u043a\u0430\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0443\u0440\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0401\u043d \u0437\u0440\u0443\u0439\u043d\u0443\u0435, \u0440\u0430\u0437\u0431\u0443\u0440\u044b\u0446\u044c \u0456 \u043a\u0456\u043d\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0443 \u043f\u044b\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043f\u0435\u0441\u043d\u044e \u045e \u0437\u044f\u043c\u043b\u0456 \u042e\u0434\u044d\u0439\u0441\u043a\u0430\u0439: &laquo;\u0423 \u043d\u0430\u0441 \u043c\u043e\u0446\u043d\u044b \u0433\u043e\u0440\u0430\u0434; \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043c\u0443\u0440\u044b \u0456 \u0432\u0430\u043b \u0434\u043b\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u044b. \u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u0431\u0440\u0430\u043c\u044b, \u043d\u044f\u0445\u0430\u0439 \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u043d\u0430\u0440\u043e\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c. \u041c\u043e\u0446\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u0430\u043c \u0422\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0448 \u0443 \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0441\u043f\u0430\u043a\u043e\u0456, \u0431\u043e \u0451\u043d \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u043d\u0430 \u041f\u0430\u043d\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0431\u043e \u041f\u0430\u043d &ndash; \u0432\u0435\u0447\u043d\u0430\u044f \u0421\u043a\u0430\u043b\u0430. \u0401\u043d \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u0432\u044b\u0441\u043e\u043a\u0430 \u045e\u0437\u043d\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0437\u0432\u0430\u043b\u0456\u045e, \u0437\u0432\u0430\u043b\u0456\u045e \u044f\u0433\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0441\u043a\u0456\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u043f\u044b\u043b. \u0422\u043e\u043f\u0447\u0443\u0446\u044c \u044f\u0433\u043e \u043d\u043e\u0433\u0456, \u043d\u043e\u0433\u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0456 \u0441\u0442\u0443\u043f\u043d\u0456 \u0431\u0435\u0434\u043d\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 21, 3; \u0406\u0441 25, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u0447\u0443\u045e \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0437 \u0442\u0440\u043e\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: \u0412\u043e\u0441\u044c \u0441\u043a\u0456\u043d\u0456\u044f \u0411\u043e\u0433\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0437 \u0456\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0433\u0430\u043c \u0437 \u0456\u043c\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u0432\u044b\u0442\u0440\u0430 \u0441\u043b\u0451\u0437\u044b \u0437 \u0443\u0441\u0456\u0445 \u0442\u0432\u0430\u0440\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0411\u043e\u0433\u0430\u043c \u0437 \u0456\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"425","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430&nbsp;<span style=\"color: #ff0000;\">26, 7-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0435\u0441\u043d\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445. \u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u043b\u044f\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u043f\u0440\u043e\u0441\u0442\u044b; \u0422\u044b \u0440\u043e\u0431\u0456\u0448 \u043f\u0440\u043e\u0441\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0443 \u044f\u0433\u043e. \u0406 \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0422\u0432\u0430\u0456\u0445 \u0441\u0443\u0434\u043e\u045e, \u041f\u0430\u043d\u0435, \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0426\u044f\u0431\u0435. \u041d\u0430\u0448\u0430 \u0434\u0443\u0448\u0430 \u0436\u0430\u0434\u0430\u0435 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0443 \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044f \u0434\u0443\u0448\u0430 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0426\u044f\u0431\u0435 \u045e\u043d\u0430\u0447\u044b, \u043c\u043e\u0439 \u0434\u0443\u0445 \u0443\u043d\u0443\u0442\u0440\u044b \u043c\u044f\u043d\u0435 \u0426\u044f\u0431\u0435 \u0448\u0443\u043a\u0430\u0435. \u041a\u0430\u043b\u0456 \u0422\u0432\u0430\u0435 \u0441\u0443\u0434\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u0446\u0430 \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0436\u044b\u0445\u0430\u0440\u044b \u0441\u0432\u0435\u0442\u0443 \u0432\u0443\u0447\u0430\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u043b\u0443\u0435 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430, \u0451\u043d \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0423 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043a\u0440\u0430\u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0456 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u0432\u0435\u043b\u0456\u0447\u044b \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u0432\u0430\u044f \u0440\u0443\u043a\u0430 \u0432\u044b\u0441\u043e\u043a\u0430 \u043f\u0430\u0434\u043d\u044f\u0442\u0430\u044f, \u0430\u043b\u0435 \u044f\u043d\u044b \u043d\u0435 \u0431\u0430\u0447\u0430\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0443\u0431\u0430\u0447\u0430\u0446\u044c \u0422\u0432\u0430\u044e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0431 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0441\u043e\u0440\u0430\u043c; \u043d\u044f\u0445\u0430\u0439 \u0430\u0433\u043e\u043d\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0422\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0434\u043e\u0440\u044b\u0448 \u043d\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439, \u0431\u043e \u045e\u0441\u0435 \u043d\u0430\u0448\u044b \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043d\u0430\u0441. \u041f\u0430\u043d\u0435 \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u0456\u043d\u0448\u044b\u044f \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u044b, \u0430\u043a\u0440\u0430\u043c\u044f \u0426\u044f\u0431\u0435, \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. \u0410\u043b\u0435 \u043c\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0451\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0426\u044f\u0431\u0435, \u0422\u0432\u0430\u0451 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u043d\u0435 \u0430\u0436\u044b\u0432\u0443\u0446\u044c, \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0434\u0443\u0445\u0456 \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0422\u044b \u0456\u0445 \u043f\u0430\u043a\u0430\u0440\u0430\u045e \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e, \u0456 \u0441\u0446\u0451\u0440 \u0443\u0441\u044f\u043a\u0443\u044e \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u043d\u0430\u0440\u043e\u0434, \u041f\u0430\u043d\u0435, \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u043d\u0430\u0440\u043e\u0434 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f. \u0422\u044b \u043f\u0430\u0448\u044b\u0440\u044b\u045e \u0443\u0441\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u043c\u0435\u0436\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u045e \u043d\u044f\u0434\u043e\u043b\u0456, \u0443\u0437\u043d\u043e\u0441\u0456\u043b\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0422\u0432\u0430\u0451 \u0431\u044b\u043b\u043e \u043d\u0430\u0434 \u0456\u043c\u0456. \u042f\u043a \u0446\u044f\u0436\u0430\u0440\u043d\u0430\u044f \u043f\u0440\u044b \u043d\u0430\u0431\u043b\u0456\u0436\u044d\u043d\u043d\u0456 \u0440\u043e\u0434\u0430\u045e \u043a\u0443\u0440\u0447\u044b\u0446\u0446\u0430 \u0430\u0434 \u0431\u043e\u043b\u044e \u0456 \u043a\u0440\u044b\u0447\u044b\u0446\u044c, \u0442\u0430\u043a \u043c\u044b \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c, \u041f\u0430\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0437\u0430\u0447\u0430\u043b\u0456 \u0456 \u043a\u0443\u0440\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u0431\u043e\u043b\u044e, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u043b\u0456; \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0445\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0436\u044b\u0445\u0430\u0440\u044b \u0441\u0443\u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0436\u044b\u0432\u0443\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u0422\u0432\u0430\u0435, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0456\u0445\u043d\u0456\u044f \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0446\u0435\u043b\u044b. \u0410\u0431\u0443\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u0456 \u045e\u0437\u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0432\u044b, \u0448\u0442\u043e \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u043f\u044b\u043b\u0435, \u0431\u043e \u0422\u0432\u0430\u044f \u0440\u0430\u0441\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u0437\u044f\u043c\u043b\u044f \u0432\u044b\u0434\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0434\u0437\u0456, \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434\u0437\u0435, \u0443\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u043f\u0430\u043a\u043e\u0456 \u0441\u0432\u0430\u0435 \u0456 \u0437\u0430\u0447\u044b\u043d\u0456 \u0437\u0430 \u0441\u0430\u0431\u043e\u0439 \u0434\u0437\u0432\u0435\u0440\u044b, \u0441\u0445\u0430\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u0456\u043c\u0433\u043d\u0435\u043d\u043d\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0435 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435. \u0411\u043e \u0432\u043e\u0441\u044c \u041f\u0430\u043d \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0440\u0430\u0446\u044c \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456 \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456, \u0456 \u0437\u044f\u043c\u043b\u044f \u0430\u0434\u043a\u0440\u044b\u0435 \u043a\u0440\u043e\u045e \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0445\u0430\u0432\u0430\u0446\u044c \u0437\u0430\u0431\u0456\u0442\u044b\u0445 \u0441\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 26, 19; \u0414\u0430\u043d 12, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u0443\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u0456 \u045e\u0437\u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u043f\u044b\u043b\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0440\u0430\u0441\u0430 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u0430 \u0441\u0432\u044f\u0442\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0431\u0443\u0434\u0437\u044f\u0446\u0446\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0456\u0446\u044c \u0443 \u043f\u044b\u043b\u0435 \u0437\u044f\u043c\u043d\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0440\u0430\u0441\u0430 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u0430 \u0441\u0432\u044f\u0442\u043b\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"426","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">27, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u041f\u0430\u043d\u0430 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u043d\u043e\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0440\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0446\u0432\u0451\u0440\u0434\u044b\u043c, \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0456 \u0432\u043e\u0441\u0442\u0440\u044b\u043c \u043c\u044f\u0447\u043e\u043c \u041b\u0435\u0432\u0456\u044f\u0442\u0430\u043d\u0430 &ndash; \u0445\u0443\u0442\u043a\u0430\u0433\u0430 \u0437\u043c\u0435\u044f, \u041b\u0435\u0432\u0456\u044f\u0442\u0430\u043d\u0430 &ndash; \u0437\u043c\u0435\u044f, \u044f\u043a\u0456 \u045e\u0435\u0446\u0446\u0430, \u0456 \u0437\u0430\u0431&rsquo;\u0435 \u043c\u0430\u0440\u0441\u043a\u0443\u044e \u043f\u0430\u0447\u0432\u0430\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u044b\u043c, \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u044f\u043c\u0443. \u042f, \u041f\u0430\u043d, \u044f\u0433\u043e \u0441\u0446\u0435\u0440\u0430\u0433\u0443, \u0443 \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u043c\u0430\u043d\u0442 \u044f\u0433\u043e \u043f\u0430\u043b\u0456\u0432\u0430\u044e. \u0423\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b \u043f\u0456\u043b\u044c\u043d\u0443\u044e \u044f\u0433\u043e, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0432\u0430\u0440\u0432\u0430\u045e\u0441\u044f \u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043d\u0435\u0432\u0443 \u043d\u044f\u043c\u0430 \u045e\u0432\u0430 \u041c\u043d\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u0448\u043b\u0435 \u041c\u043d\u0435 \u0446\u0435\u0440\u043d\u0456 \u0456 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435, \u044f \u043f\u0430\u0439\u0434\u0443 \u0432\u0430\u0439\u043d\u043e\u0439 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u0430\u0433\u043e \u0456 \u0441\u043f\u0430\u043b\u044e \u0456\u0445 \u0443\u0441\u0456\u0445. \u0425\u0456\u0431\u0430 \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u0430\u0451\u0439 \u0430\u0431\u0430\u0440\u043e\u043d\u044b, \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u0446\u044c \u043c\u0456\u0440 \u0441\u0430 \u041c\u043d\u043e\u0439, \u0443\u0441\u0442\u0430\u043b\u044e\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u0441\u0430 \u041c\u043d\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0434\u043d\u0456 \u042f\u043a\u0443\u0431 \u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043a\u0430\u0440\u0430\u043d\u0456, \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u0456 \u0440\u0430\u0437\u0440\u0430\u0441\u0446\u0435\u0446\u0446\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u041f\u0430\u043d \u044f\u0433\u043e \u0442\u0430\u043a, \u044f\u043a \u0443\u0434\u0430\u0440\u044b\u045e \u044f\u0433\u043e \u0432\u043e\u0440\u0430\u0433\u0430\u045e? \u0426\u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u045e \u044f\u0433\u043e \u0442\u0430\u043a, \u044f\u043a \u0431\u044b\u043b\u0456 \u0437\u0430\u0431\u0456\u0442\u044b \u044f\u0433\u043e \u0437\u0430\u0431\u043e\u0439\u0446\u044b? \u0422\u044b \u044f\u0433\u043e \u0430\u0434\u043a\u0456\u043d\u0443\u045e, \u0432\u044b\u0433\u043d\u0430\u045e \u044f\u0433\u043e \u0456 \u0441\u0443\u0434\u0437\u0456\u0448\u0441\u044f \u0437 \u0456\u043c. \u0422\u044b \u043f\u0440\u0430\u0433\u043d\u0430\u045e \u044f\u0433\u043e \u043c\u043e\u0446\u043d\u044b\u043c \u043f\u043e\u0434\u044b\u0445\u0430\u043c \u0443 \u0434\u0437\u0435\u043d\u044c \u0443\u0441\u0445\u043e\u0434\u043d\u044f\u0433\u0430 \u0432\u0435\u0442\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u0456\u043d\u0430 \u042f\u043a\u0443\u0431\u0430. \u0410 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u0432\u0435\u0441\u044c \u043f\u043b\u0451\u043d \u0437\u043d\u044f\u0446\u0446\u044f \u0433\u0440\u0430\u0445\u0443 \u0437 \u044f\u0433\u043e: \u0451\u043d \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0443\u0441\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u0440\u0430\u0437\u0431\u0456\u0442\u044b\u0445 \u043a\u0430\u0432\u0430\u043b\u043a\u0430\u045e \u0432\u0430\u043f\u043d\u044b. \u041d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u044f\u0446\u044c \u043a\u0443\u043b\u044c\u0442\u0430\u0432\u044b\u044f \u0434\u0440\u044d\u0432\u044b \u0456 \u0441\u043e\u043d\u0435\u0447\u043d\u044b\u044f \u0441\u043b\u0443\u043f\u044b. \u0423\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0433\u043e\u0440\u0430\u0434 \u0430\u043f\u0443\u0441\u0446\u0435\u0435, \u0436\u044b\u043b\u043b\u0451 \u0431\u0443\u0434\u0437\u0435 \u0431\u044f\u0437\u043b\u044e\u0434\u043d\u044b\u043c \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u043c, \u043d\u0456\u0431\u044b \u043f\u0443\u0441\u0442\u044b\u043d\u044f. \u0422\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0446\u044f\u043b\u044f, \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u043b\u044f\u0436\u0430\u0446\u044c \u0456 \u0430\u0431\u0433\u0440\u044b\u0437\u0430\u0446\u044c \u044f\u0433\u043e \u0433\u0430\u043b\u0456\u043d\u044b. \u041a\u0430\u043b\u0456 \u044f\u0433\u043e\u043d\u0430\u0435 \u0433\u0430\u043b\u043b\u0451 \u043f\u0430\u0432\u044b\u0441\u044b\u0445\u0430\u0435, \u0430\u0431\u043b\u0430\u043c\u0430\u044e\u0446\u044c \u044f\u0433\u043e. \u041f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0456 \u0441\u043f\u0430\u043b\u044f\u0446\u044c \u044f\u0433\u043e. \u0411\u043e \u0433\u044d\u0442\u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u043d\u0430\u0440\u043e\u0434. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0456\u043c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c, \u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u044f\u0433\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0430\u0431\u043c\u0430\u043b\u043e\u0446\u0456\u0446\u044c \u043a\u0430\u043b\u043e\u0441\u0441\u0435 \u0430\u0434 \u0420\u0430\u043a\u0456 \u0430\u0436\u043d\u043e \u0434\u0430 \u043f\u0430\u0442\u043e\u043a\u0443 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430. \u0406 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u044f \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u0433\u0443\u0434\u0437\u044f\u0446\u044c \u0443 \u043c\u0430\u0433\u0443\u0442\u043d\u0443\u044e \u0442\u0440\u0443\u0431\u0443, \u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0442\u044b\u044f, \u0448\u0442\u043e \u0437\u0433\u0443\u0431\u0456\u043b\u0456\u0441\u044f \u045e \u0437\u044f\u043c\u043b\u0456 \u0430\u0441\u0456\u0440\u044b\u0439\u0441\u043a\u0430\u0439 \u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u045e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u043c \u043a\u0440\u0430\u0456, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0443 \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 24, 31; \u0406\u0441 27, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043f\u0430\u0448\u043b\u0435 \u0441\u0432\u0430\u0456\u0445 \u0430\u043d\u0451\u043b\u0430\u045e \u0437 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0442\u0440\u0443\u0431\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0410\u043d\u0451\u043b\u044b \u0437\u0431\u044f\u0440\u0443\u0446\u044c \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0431\u0430\u043a\u043e\u045e \u0441\u0432\u0435\u0442\u0443, \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0440\u0430\u044e \u043d\u0435\u0431\u0430 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c, \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0443 \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b\u044b \u0437\u0431\u044f\u0440\u0443\u0446\u044c \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0431\u0430\u043a\u043e\u045e \u0441\u0432\u0435\u0442\u0443, \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0440\u0430\u044e \u043d\u0435\u0431\u0430 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"427","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">29, 1-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u0434 \u0411\u043e\u0436\u044b \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445, \u0410\u0440\u044b\u044d\u043b\u044c, \u0410\u0440\u044b\u044d\u043b\u044c, \u0433\u043e\u0440\u0430\u0434, \u0434\u0437\u0435 \u0414\u0430\u0432\u0456\u0434 \u0440\u0430\u0437\u0431\u0456\u0432\u0430\u045e \u043b\u0430\u0433\u0435\u0440! \u0414\u0430\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0433\u043e\u0434 \u0434\u0430 \u0433\u043e\u0434\u0430, \u043d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u044b \u0456\u0434\u0443\u0446\u044c \u043f\u0430 \u0447\u0430\u0440\u0437\u0435. \u041f\u0430\u0441\u043b\u044f \u042f \u0431\u0443\u0434\u0443 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0446\u044c \u0410\u0440\u044b\u044d\u043b\u044c, \u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0441\u043c\u0443\u0442\u0430\u043a \u0437\u0430 \u0441\u043c\u0443\u0442\u043a\u0430\u043c, \u0456 \u0451\u043d \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u044f\u043a \u0411\u043e\u0436\u0430\u0435 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430. \u0420\u0430\u0437\u0430\u0431&rsquo;\u044e \u0432\u0430\u043a\u043e\u043b \u0446\u044f\u0431\u0435 \u043b\u0430\u0433\u0435\u0440 \u0456 \u0430\u043a\u0440\u0443\u0436\u0443 \u0446\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u0430\u044e, \u0456 \u045e\u0437\u0432\u044f\u0434\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e \u0430\u0431\u043b\u043e\u0433\u0456 \u0442\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b, \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b, \u0442\u044b \u0437\u0430\u0433\u0430\u0432\u043e\u0440\u044b\u0448, \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437 \u043f\u044b\u043b\u0443 \u0434\u0430\u043d\u044f\u0441\u0435\u0446\u0446\u0430 \u0442\u0432\u043e\u0439 \u043f\u0440\u044b\u0433\u043b\u0443\u0448\u0430\u043d\u044b \u0448\u044d\u043f\u0442; \u0442\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u0430\u0434 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a \u0433\u043e\u043b\u0430\u0441 \u0437\u0434\u0430\u043d\u0456; \u0442\u0432\u0430\u044f \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0456\u0441\u043a\u0430\u043c \u0441\u044f\u0440\u043e\u0434 \u043f\u044b\u043b\u0443. \u041c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445 \u0441\u0442\u0430\u043d\u0435 \u0431\u044b\u0446\u0446\u0430\u043c \u0434\u0440\u043e\u0431\u043d\u044b \u043f\u044b\u043b, \u0456 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0442\u0432\u0430\u0456\u0445 &ndash; \u043d\u0456\u0431\u044b \u043c\u044f\u043a\u0456\u043d\u0430 \u043d\u0430 \u0432\u0435\u0442\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u043f\u0442\u043e\u045e\u043d\u0430, \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u043f\u0430\u043a\u0430\u0440\u0430\u0435 \u0446\u044f\u0431\u0435 \u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u0446\u0430\u0439, \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441\u0430\u043c \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u0443\u043b\u0430\u043c, \u0431\u0443\u0440\u0430\u044e, \u0432\u0456\u0445\u0443\u0440\u0430\u0439 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0447\u044b\u043c \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u0430\u0433\u043d\u044e. \u0406 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0410\u0440\u044b\u044d\u043b\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u0432\u0430\u044f\u0432\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u0456 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456 \u044f\u0433\u043e, \u0456 \u0445\u0442\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u045e \u044f\u0433\u043e &ndash; \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u043d\u043e\u043c \u0456 \u043d\u0430\u0447\u043d\u044b\u043c \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443 \u0441\u043d\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u0435\u0441\u0446\u044c, \u0430\u043b\u0435 \u043f\u0440\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0451\u043d \u0437 \u043f\u0443\u0441\u0442\u044b\u043c \u0441\u0442\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c, \u0446\u0456 \u044f\u043a \u0441\u0430\u0441\u043c\u044f\u0433\u043b\u0430\u043c\u0443 \u0441\u043d\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u043f&rsquo;\u0435, \u0430\u043b\u0435 \u043f\u0440\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0451\u043d \u0441\u0430 \u0441\u043c\u0430\u0433\u0430\u0439, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u0437 \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u0456\u0448\u043b\u0456 \u043d\u0430 \u0431\u0456\u0442\u0432\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 54, 4; 29, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u043e \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430\u0432\u0435\u0434\u0430\u0435 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u043d\u0456\u043a\u043d\u0435, \u044f\u043a \u0434\u0440\u043e\u0431\u043d\u044b \u043f\u044b\u043b, <span style=\"color: #ff0000;\">*<\/span> \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0448\u0442\u043e \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430\u0432\u0435\u0434\u0430\u0435 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"431","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">29, 13-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u0443\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u0413\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u041c\u044f\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0430\u0456\u043c \u044f\u0437\u044b\u043a\u043e\u043c, \u0430\u043b\u0435 \u0441\u044d\u0440\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041c\u044f\u043d\u0435, \u0430 \u044f\u0433\u043e \u043f\u0430\u0448\u0430\u043d\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435 &ndash; \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0432\u0443\u0447\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043d\u0430\u043a\u0430\u0437. \u0422\u0430\u043c\u0443 \u042f \u0437\u043d\u043e\u045e \u0443\u0447\u044b\u043d\u044e \u0437 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043d\u044f\u0437\u0432\u044b\u043a\u043b\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0446\u0443\u0434\u044b. \u0406 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456\u0445\u043d\u0456\u0445 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0437\u0430\u0433\u0456\u043d\u0435, \u0456 \u0437\u043d\u0456\u043a\u043d\u0435 \u0440\u043e\u0437\u0443\u043c \u0456\u0445\u043d\u0456\u0445 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u0432\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0445\u0430\u0432\u0430\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0456\u0445 \u0443 \u0446\u0435\u043c\u0440\u044b, \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0425\u0442\u043e \u043d\u0430\u0441 \u0431\u0430\u0447\u044b\u0446\u044c, \u0456 \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u043f\u0440\u0430 \u043d\u0430\u0441?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0431\u0435\u0437\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c! \u0425\u0456\u0431\u0430 \u043c\u043e\u0436\u043d\u0430 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0433\u0430\u043d\u0447\u0430\u0440\u0430 \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0433\u043b\u0456\u043d\u0430\u0439? \u0426\u0456 \u043c\u043e\u0436\u0430 \u0442\u0432\u043e\u0440 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u043c\u0443 \u0442\u0432\u043e\u0440\u0446\u044b: &laquo;\u041d\u0435 \u0442\u044b \u043c\u044f\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e?&raquo; \u0425\u0456\u0431\u0430 \u043c\u043e\u0436\u0430 \u0432\u044b\u0440\u0430\u0431 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u044c\u043d\u0456\u043a\u0443, \u0448\u0442\u043e \u0401\u043d \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0436 \u0443 \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u041b\u0456\u0431\u0430\u043d \u0441\u0430\u0434\u0430\u043c, \u0456 \u0446\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u0430\u0434 \u043b\u0435\u0441\u0430\u043c? \u0406 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0433\u043b\u0443\u0445\u0456\u044f \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u043a\u043d\u0456\u0433\u0456, \u0456 \u0432\u043e\u0447\u044b \u0441\u043b\u044f\u043f\u044b\u0445 \u0437 \u0446\u0435\u043c\u0440\u044b \u0456 \u0437\u043c\u0440\u043e\u043a\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0447\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u044b\u0445 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443, \u0456 \u0431\u0435\u0434\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0411\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u0435\u043b\u044f, \u0456 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a \u0437\u043d\u0456\u043a\u043d\u0435, \u0456 \u043f\u0440\u0430\u043f\u0430\u0434\u0443\u0446\u044c \u0443\u0441\u0435, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0445\u0442\u043e \u045e \u0441\u043b\u043e\u0432\u0430\u0445 \u0430\u0441\u0443\u0434\u0436\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0443\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0431\u0440\u0430\u043c\u0435, \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0430\u0441\u0442\u043a\u0443, \u0443\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u045e \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430: &laquo;\u0426\u044f\u043f\u0435\u0440 \u042f\u043a\u0443\u0431 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b, \u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u0431\u044f\u043b\u0435\u0435. \u0411\u043e \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0441\u0432\u0430\u0456\u0445, \u0441\u043f\u0440\u0430\u0432\u0443 \u0440\u0443\u043a \u041c\u0430\u0456\u0445, \u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u0430 \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0456\u043c\u044f \u041c\u0430\u0451, \u0456 \u0441\u0432\u044f\u0442\u0430 \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0431\u0443\u0434\u0443\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430\u0432\u0430\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u044f\u0446\u0446\u0430. \u0406 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u043b\u0443\u043a\u0430\u0435 \u0434\u0443\u0445\u0430\u043c, \u043d\u0430\u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u0456 \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u043a\u0430\u0435, \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 29, 18. 19; \u043f\u0430\u0440. \u041c\u0446 11, 4. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c <span style=\"color: #ff0000;\">&dagger;<\/span> \u0433\u043b\u0443\u0445\u0456\u044f \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u043a\u043d\u0456\u0433\u0456, <span style=\"color: #ff0000;\">\/<\/span> \u0456 \u0432\u043e\u0447\u044b \u0441\u043b\u044f\u043f\u044b\u0445 \u0437 \u0446\u0435\u043c\u0440\u044b \u0456 \u0437\u043c\u0440\u043e\u043a\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0447\u044b\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0431\u0435\u0434\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406\u0434\u0437\u0456\u0446\u0435, \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u0435 \u042f\u043d\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u0443\u0435\u0446\u0435 \u0456 \u0431\u0430\u0447\u044b\u0446\u0435: \u0441\u043b\u044f\u043f\u044b\u044f \u0437\u043d\u043e\u045e \u0431\u0430\u0447\u0430\u0446\u044c, \u0433\u043b\u0443\u0445\u0456\u044f \u0447\u0443\u044e\u0446\u044c, \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u044f \u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0456 \u045e\u0431\u043e\u0433\u0456\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0435\u0434\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"432","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">30, 18-26<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0447\u0430\u043a\u0430\u0435, \u043a\u0430\u0431 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0441, \u0401\u043d \u043f\u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456. \u0411\u043e \u041f\u0430\u043d &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b, \u043d\u0430\u0440\u043e\u0434 \u0421\u0456\u0451\u043d\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0430\u043a\u0430\u0446\u044c. \u0411\u043e\u0433 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u043b\u044f\u043c\u0430\u043d\u0442\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u0456, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435 \u044f\u0433\u043e, \u0430\u0434\u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u041f\u0430\u043d \u0445\u043b\u0435\u0431 \u043f\u0430\u043a\u0443\u0442\u044b \u0456 \u0432\u0430\u0434\u0443 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443; \u0430\u043b\u0435 \u0442\u0432\u043e\u0439 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0432\u0430\u0446\u0446\u0430, \u0456 \u0432\u043e\u0447\u044b \u0442\u0432\u0430\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0432\u0443\u0448\u044b \u0442\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0437\u0430 \u0442\u0430\u0431\u043e\u044e: &laquo;\u0413\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430, \u0456\u0434\u0437\u0456\u0446\u0435 \u043f\u0430 \u0451\u0439&raquo;, \u043a\u0430\u043b\u0456 \u0431 \u0432\u044b \u0430\u0434\u0445\u0456\u043b\u0456\u043b\u0456\u0441\u044f \u045e\u043f\u0440\u0430\u0432\u0430 \u0446\u0456 \u045e\u043b\u0435\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0432\u044b \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u0435 \u0433\u0430\u043d\u044c\u0431\u0430\u0439 \u0456\u0434\u0430\u043b\u0430\u045e \u0432\u0430\u0448\u044b\u0445, \u043f\u0430\u043a\u0440\u044b\u0442\u044b\u0445 \u0441\u0440\u044d\u0431\u0440\u0430\u043c, \u0456 \u043b\u0456\u0442\u044b\u044f \u0432\u044b\u044f\u0432\u044b, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0437\u043e\u043b\u0430\u0442\u0430. \u0422\u044b \u0430\u0434\u043a\u0456\u043d\u0435\u0448 \u0456\u0445 \u044f\u043a \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u0440\u044d\u0447\u044b, \u0456 \u0441\u043a\u0430\u0436\u0430\u0448 \u0456\u043c: &laquo;\u041f\u0440\u044d\u0447&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0441\u043f\u0430\u0448\u043b\u0435 \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u0442\u0432\u0430\u0451, \u044f\u043a\u0456\u043c \u0442\u044b \u0437\u0430\u0441\u0435\u0435\u0448 \u0440\u0430\u043b\u043b\u044e, \u0456 \u0445\u043b\u0435\u0431, \u043f\u043b\u0451\u043d \u0437\u044f\u043c\u043b\u0456, \u0431\u0443\u0434\u0437\u0435 \u0441\u044b\u0442\u043d\u044b \u0456 \u043f\u0430\u0436\u044b\u045e\u043d\u044b. \u0421\u0442\u0430\u0442\u0430\u043a \u0442\u0432\u043e\u0439 \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u043d\u044b\u0445 \u043f\u0430\u0448\u0430\u0445. \u0412\u0430\u043b\u044b \u0456 \u0430\u0441\u043b\u044b, \u044f\u043a\u0456\u044f \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456 \u0441\u0430\u043b\u0451\u043d\u0443\u044e \u043c\u044f\u0448\u0430\u043d\u043a\u0443, \u043f\u0440\u0430\u0441\u0435\u044f\u043d\u0443\u044e \u043b\u0430\u043f\u0430\u0442\u0430\u0439 \u0456 \u0432\u0456\u043b\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0439 \u0432\u044b\u0441\u043e\u043a\u0430\u0439 \u0433\u0430\u0440\u044b, \u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u0443\u0437\u0433\u043e\u0440\u043a\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0443\u0447\u0430\u0456, \u043f\u0430\u0442\u043e\u043a\u0456 \u0432\u043e\u0434\u0430\u045e \u0443 \u0434\u0437\u0435\u043d\u044c \u0440\u0430\u0437\u0433\u0440\u043e\u043c\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u045e\u043f\u0430\u0434\u0443\u0446\u044c \u0432\u0435\u0436\u044b. \u0406 \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0435\u0441\u044f\u0446\u0430 \u0431\u0443\u0434\u0437\u0435, \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u043e\u043d\u0446\u0430, \u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u043e\u043d\u0446\u0430 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u045e \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e, \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u044f\u043c\u0456 \u0434\u0437\u0451\u043d, \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0432\u044f\u0436\u0430 \u0440\u0430\u043d\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0437\u0430\u043b\u0435\u0447\u044b\u0446\u044c \u044f\u0437\u0432\u044b \u0430\u0434 \u0443\u0434\u0430\u0440\u0443 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 30, 26. 18; \u041f\u0441 27 (26), 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0432\u044f\u0436\u0430 \u0440\u0430\u043d\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0437\u0430\u043b\u0435\u0447\u044b\u0446\u044c \u044f\u0437\u0432\u044b \u0430\u0434 \u0443\u0434\u0430\u0440\u0443 \u0441\u0432\u0430\u0439\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u0443\u043c\u0430\u0446\u0443\u0435\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451, \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"433","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">30, 27-33; 31, 4-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0430\u0434 \u0430\u0441\u0456\u0440\u044b\u0439\u0446\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a, \u0456 \u043f\u0430\u043b\u0430\u0435 \u0433\u043d\u0435\u045e \u042f\u0433\u043e, \u0456 \u0446\u044f\u0436\u043a\u043e\u0435 \u043f\u043e\u043b\u044b\u043c\u044f \u044f\u0433\u043e. \u0412\u0443\u0441\u043d\u044b \u042f\u0433\u043e \u043f\u043e\u045e\u043d\u044b\u044f \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u044f, \u0430 \u044f\u0437\u044b\u043a \u044f\u043a \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0433\u043e\u043d\u044c. \u041f\u043e\u0434\u044b\u0445 \u042f\u0433\u043e \u044f\u043a \u0431\u0443\u0440\u043b\u0456\u0432\u044b \u043f\u0430\u0442\u043e\u043a, \u0448\u0442\u043e \u0441\u044f\u0433\u0430\u0435 \u0434\u0430 \u0448\u044b\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0441\u0435\u044f\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0440\u044d\u0448\u0430\u0442\u0430\u043c \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0456 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u043d\u0430 \u0456\u0445 \u0441\u043a\u0456\u0432\u0456\u0446\u044b \u0446\u0443\u0433\u043b\u0456 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0430\u0448\u0430 \u043f\u0435\u0441\u043d\u044f \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0443 \u043d\u043e\u0447, \u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430, \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u044f\u043a \u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0434 \u0433\u0443\u043a\u0456 \u0444\u043b\u0435\u0439\u0442\u044b \u0456\u0434\u0437\u0435 \u0434\u0430 \u0433\u0430\u0440\u044b \u041f\u0430\u043d\u0430, \u0434\u0430 \u0421\u043a\u0430\u043b\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u041f\u0430\u043d \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u0432\u043e\u0439 \u0441\u043b\u0430\u045e\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u0443\u0434\u0430\u0440\u0430\u0435 \u042f\u0433\u043e \u0440\u0443\u043a\u0430 \u045e \u043f\u0430\u043b\u043a\u0456\u043c \u0433\u043d\u0435\u0432\u0435 \u0456 \u045e \u043f\u0440\u0430\u0436\u044d\u0440\u043b\u0456\u0432\u044b\u043c \u043f\u043e\u043b\u044b\u043c\u0456 \u0430\u0433\u043d\u044e, \u0441\u044f\u0440\u043e\u0434 \u043b\u0456\u045e\u043d\u044f, \u0431\u0443\u0440\u044b \u0456 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434 \u0433\u043e\u043b\u0430\u0441\u0443 \u041f\u0430\u043d\u0430 \u0437\u0430\u0434\u0440\u044b\u0436\u044b\u0446\u044c \u0410\u0441\u0456\u0440\u044b\u044f, \u043f\u0430\u0431\u0456\u0442\u0430\u044f \u0440\u043e\u0437\u0433\u0430\u0439. \u0406 \u043a\u043e\u0436\u043d\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u045e\u0434\u0430\u0440 \u0440\u043e\u0437\u0433\u0456, \u044f\u043a\u0456 \u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0443\u0435 \u043d\u0430 \u044f\u0435, \u0431\u0443\u0434\u0437\u0435 \u0437 \u0431\u0443\u0431\u043d\u0430\u043c\u0456 \u0456 \u0430\u0440\u0444\u0430\u043c\u0456, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u043b\u044c\u043d\u0430\u0439 \u0432\u0430\u0439\u043d\u043e\u0439 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0435. \u0411\u043e \u0433\u043e\u0440\u0430\u043d \u0434\u0430\u045e\u043d\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b, \u0451\u043d \u0433\u0430\u0442\u043e\u0432\u044b \u0456 \u0434\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u044f, \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0456 \u0448\u044b\u0440\u043e\u043a\u0456. \u0423 \u044f\u0433\u043e \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u044b \u0448\u043c\u0430\u0442 \u0436\u0430\u0440\u0443 \u0456 \u0434\u0440\u043e\u045e. \u041f\u043e\u0434\u044b\u0445 \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u043f\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e, \u043d\u0456\u0431\u044b \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u044c \u0441\u0435\u0440\u044b. \u0411\u043e \u0442\u0430\u043a \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u042f\u043a \u043b\u0435\u045e \u0430\u0431\u043e \u043b\u044c\u0432\u044f\u043d\u044f \u0440\u044b\u0447\u044b\u0446\u044c \u043d\u0430\u0434 \u0441\u0432\u0430\u0451\u044e \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439 \u0456, \u0445\u043e\u0446\u044c \u0441\u0430\u0431\u0440\u0430\u043b\u0430\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u0431\u0430\u0433\u0430\u0442\u0430 \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u045e, \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u0456\u0445 \u0456 \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0442\u043e\u045e\u043f\u0430\u043c, \u0442\u0430\u043a \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0441\u044b\u0434\u0437\u0435 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u0443 \u0421\u0456\u0451\u043d \u0456 \u043d\u0430 \u044f\u0435 \u045e\u0437\u0433\u043e\u0440\u043a\u0456. \u042f\u043a \u043f\u0442\u0443\u0448\u043a\u0456 \u045e \u043f\u0430\u043b\u0451\u0446\u0435, \u0442\u0430\u043a \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c, \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u0456 \u045e\u0440\u0430\u0442\u0443\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0430\u0434 \u043a\u0430\u0433\u043e \u0432\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f. \u0411\u043e \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u043a\u0456\u043d\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u0440\u044d\u0431\u043d\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0456 \u0441\u0432\u0430\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0437\u0430\u043b\u0430\u0442\u044b\u0445, \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u044b\u0445 \u0432\u0430\u0448\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u043d\u0430 \u0433\u0440\u044d\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u043f\u0430\u0434\u0437\u0435 \u0410\u0441\u0456\u0440\u044b\u044f \u043d\u0435 \u0430\u0434 \u043b\u044e\u0434\u0441\u043a\u043e\u0433\u0430 \u043c\u044f\u0447\u0430, \u0456 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043c\u0435\u0447 \u044f\u0435 \u043f\u0430\u0433\u043b\u044b\u043d\u0435. \u042f\u043d\u0430 \u045e\u0446\u044f\u0447\u044d \u0430\u0434 \u043c\u044f\u0447\u0430, \u0456 \u044e\u043d\u0430\u043a\u0456 \u044f\u0435 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0440\u0430\u0431\u0430\u043c\u0456. \u0406 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044e, \u0430 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u044f\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u044e\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0441\u0446\u044f\u0433\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0447\u044b\u0439 \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0456 \u0447\u044b\u0439 \u0433\u043e\u0440\u0430\u043d \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 31, 4. 5; 30, 29<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0441\u044b\u0434\u0437\u0435 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0421\u0456\u0451\u043d. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043a \u043f\u0442\u0443\u0448\u043a\u0456 \u045e \u043f\u0430\u043b\u0451\u0446\u0435, \u0442\u0430\u043a \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u0456 \u045e\u0440\u0430\u0442\u0443\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u0448\u0430 \u043f\u0435\u0441\u043d\u044f \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0443 \u043d\u043e\u0447, \u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430, \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043f\u0442\u0443\u0448\u043a\u0456 \u045e \u043f\u0430\u043b\u0451\u0446\u0435, \u0442\u0430\u043a \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u0456 \u045e\u0440\u0430\u0442\u0443\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"434","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">31, 1-3; 32, 1-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0415\u0433\u0456\u043f\u0435\u0442 \u0437\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0456 \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u043a\u043e\u043d\u0435\u0439, \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b, \u0431\u043e \u0456\u0445 \u0448\u043c\u0430\u0442, \u0456 \u043d\u0430 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e, \u0431\u043e \u044f\u043d\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u044b\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0435 \u045e\u0432\u0430\u0433\u0443 \u043d\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u043d\u0435 \u0448\u0443\u043a\u0430\u0435 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0443\u0434\u0440\u044b, \u043d\u0430\u0432\u044f\u0434\u0437\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u043d\u0435 \u0432\u043e\u0437\u044c\u043c\u0435 \u043d\u0430\u0437\u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u045e. \u041f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u043e\u043c\u0443 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0434\u0437\u0456, \u0430 \u043d\u0435 \u0411\u043e\u0433; \u0430 \u0456\u0445 \u043a\u043e\u043d\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0446\u0435\u043b\u0430, \u0430 \u043d\u0435 \u0434\u0443\u0445. \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443, \u0442\u043e \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435, \u0456 \u045e\u043f\u0430\u0434\u0437\u0435 \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0456, \u0456 \u044f\u043d\u044b \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u043a\u0430\u0440\u043e\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0437\u0430\u043a\u043e\u043d\u0430\u043c. \u0406 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430 \u0430\u0434 \u0432\u0435\u0442\u0440\u0443, \u044f\u043a \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u0430\u0434 \u0434\u0430\u0436\u0434\u0436\u0443, \u044f\u043a \u043f\u0430\u0442\u043e\u043a \u0432\u043e\u0434\u0430\u045e \u0443 \u0441\u0442\u044d\u043f\u0435, \u044f\u043a \u0446\u0435\u043d\u044c \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u043a\u0430\u043b\u044b \u043d\u0430 \u0432\u044b\u0441\u0430\u0445\u043b\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0412\u043e\u0447\u044b \u0432\u0456\u0434\u0443\u0448\u0447\u044b\u0445 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u044f, \u0430 \u0432\u0443\u0448\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u0443\u0435, \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u044c. \u0406 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044e, \u0430 \u044f\u0437\u044b\u043a \u0437\u0430\u0456\u043a\u0430\u045e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0432\u044b\u0440\u0430\u0437\u043d\u0430. \u041d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u043c, \u0430 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430 \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u043a\u0430\u0431 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430 \u0456 \u043a\u0430\u0437\u0430\u0446\u044c \u0430\u0431\u043b\u0443\u0434\u0443 \u043d\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0434\u0443\u0448\u0443 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u043f\u0443\u0441\u0442\u043e\u0439 \u0456 \u045e \u0441\u0430\u0441\u043c\u044f\u0433\u043b\u0430\u0433\u0430 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u043f\u0456\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0456 \u045e\u0447\u044b\u043d\u043a\u0456: \u0451\u043d \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435 \u0434\u0440\u044d\u043d\u043d\u0430\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u0430\u0439 \u043c\u043e\u0432\u0430\u0439, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u045e\u0431\u043e\u0433\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443. \u0410\u043b\u0435 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 32, 3. 4; \u0415\u0440 23, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0447\u044b \u0432\u0456\u0434\u0443\u0448\u0447\u044b\u0445 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u044f, \u0430 \u0432\u0443\u0448\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u0443\u0435, \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0431\u0443\u0434\u0436\u0443 \u0434\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0456 \u0437\u0430\u043f\u0430\u043d\u0443\u0435 \u043a\u0430\u0440\u043e\u043b\u044c, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u043c\u0443\u0434\u0440\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"435","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">\u0406\u0441 32, 15 &ndash; 33, 6<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0427\u0430\u043a\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043a\u0430\u043d\u0446\u044b \u043d\u0430 \u043d\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043b\u0456\u0442\u044b \u0414\u0443\u0445 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456; \u0442\u0430\u0434\u044b \u043f\u0443\u0441\u0442\u044b\u043d\u044f \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u0441\u0430\u0434, \u0430 \u0441\u0430\u0434 \u0431\u0443\u0434\u0437\u0435 \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u043b\u0435\u0441\u0430\u043c. \u0423 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0443 \u0441\u0430\u0434\u0437\u0435. \u0406 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u043c\u0456\u0440, \u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 &ndash; \u0431\u044f\u0441\u043f\u0435\u043a\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0443 \u043c\u0456\u0440\u043d\u044b\u0445 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430\u0445, \u0443 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u0445 \u0448\u0430\u0442\u0440\u0430\u0445 \u0456 \u0437\u0430\u0446\u0456\u0448\u043b\u0456\u0432\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u045e\u043f\u0430\u0434\u0437\u0435 \u0433\u0440\u0430\u0434 \u0456 \u043f\u0430\u0432\u0430\u043b\u0456\u0446\u044c \u043b\u0435\u0441, \u0430 \u0433\u043e\u0440\u0430\u0434 \u0441\u043f\u0443\u0441\u0446\u0456\u0446\u0446\u0430 \u045e \u0434\u0430\u043b\u0456\u043d\u0443. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0432\u044b, \u0448\u0442\u043e \u0441\u0435\u0435\u0446\u0435 \u043d\u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0432\u0430\u0434\u043e\u0439 \u0456 \u043f\u0443\u0441\u043a\u0430\u0435\u0446\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430 \u0432\u0430\u043b\u043e\u045e \u0456 \u0430\u0441\u043b\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430 \u0442\u0430\u0431\u0435, \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0456\u043a, \u044f\u043a\u0456 \u0441\u0430\u043c \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u045e \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f; \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456. \u041a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u0448 \u0441\u043f\u0440\u0430\u0432\u0443 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f, \u0441\u0430\u043c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u0448; \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435\u0448 \u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c, \u0446\u044f\u0431\u0435 \u0430\u0431\u0440\u0430\u0431\u0443\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u043c\u044b \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f. \u0411\u0443\u0434\u0437\u044c \u043d\u0430\u0448\u0430\u0439 \u043c\u043e\u0446\u0430\u0439 \u043a\u043e\u0436\u043d\u0443\u044e \u0440\u0430\u043d\u0456\u0446\u0443 \u0456 \u043d\u0430\u0448\u044b\u043c \u0440\u0430\u0442\u0443\u043d\u043a\u0430\u043c \u0443 \u0447\u0430\u0441 \u043d\u044f\u0434\u043e\u043b\u0456. \u0410\u0434 \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u045e\u0446\u044f\u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u044b, \u0430\u0434 \u0443\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u043f\u043b\u044f\u043c\u0451\u043d\u044b. \u042f\u043d\u044b \u0437\u0431\u044f\u0440\u0443\u0446\u044c \u0437\u0434\u0430\u0431\u044b\u0447\u0443 \u0432\u0430\u0448\u0443, \u044f\u043a \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0432\u0443\u0441\u0435\u043d\u044f\u045e; \u044f\u043a \u0441\u0430\u0440\u0430\u043d\u0447\u0430, \u043a\u0456\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u041f\u0430\u043d, \u044f\u043a\u0456 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456. \u0401\u043d \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0421\u0456\u0451\u043d \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435\u043c \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u0422\u0430\u0434\u044b \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b \u0447\u0430\u0441, \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u042f\u0433\u043e \u0441\u043a\u0430\u0440\u0431\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 32, 18. 17; \u042f\u043d 14, 27<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0443 \u043c\u0456\u0440\u043d\u044b\u0445 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430\u0445, \u0443 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u0445 \u0448\u0430\u0442\u0440\u0430\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u043c\u0456\u0440.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u043a\u0456\u0434\u0430\u044e \u0432\u0430\u043c, \u0441\u043f\u0430\u043a\u043e\u0439 \u041c\u043e\u0439 \u0434\u0430\u044e \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u043c\u0456\u0440.<\/p>\r\n"}, {"GCH_CH_1_ID":"436","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">\u0406\u0441 33, 7-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0443\u0447\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u0456\u0445\u043d\u0456\u044f \u0436\u0430\u045e\u043d\u0435\u0440\u044b \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0437\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0443, \u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u044b \u043c\u0456\u0440\u0443 \u0433\u043e\u0440\u043a\u0430 \u043f\u043b\u0430\u0447\u0443\u0446\u044c. \u0410\u043f\u0443\u0441\u0446\u0435\u043b\u0456 \u0434\u0430\u0440\u043e\u0433\u0456, \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0441\u0446\u0435\u0436\u043a\u0430\u0445. \u0401\u043d \u043f\u0430\u0440\u0443\u0448\u044b\u045e \u0434\u0430\u043c\u043e\u0432\u0443, \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u045e \u0433\u0430\u0440\u0430\u0434\u044b, \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u043d\u0456 \u0437 \u043a\u0456\u043c. \u0417\u044f\u043c\u043b\u044f \u043f\u043b\u0430\u0447\u0430 \u0456 \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435. \u041b\u0456\u0431\u0430\u043d \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0456 \u0432\u044f\u043d\u0435. \u0428\u0430\u0440\u043e\u043d \u0441\u0442\u0430\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0430 \u0411\u0430\u0448\u0430\u043d \u0456 \u041a\u0430\u0440\u043c\u044d\u043b\u044c \u0441\u043a\u0456\u043d\u0443\u043b\u0456 \u043b\u0456\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0426\u044f\u043f\u0435\u0440 \u042f \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0443, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0446\u044f\u043f\u0435\u0440 \u042f \u045e\u0437\u043d\u0456\u043c\u0443\u0441\u044f, \u0446\u044f\u043f\u0435\u0440 \u042f \u043f\u0430\u0434\u044b\u043c\u0443\u0441\u044f. \u0412\u044b \u0437\u0430\u0447\u0430\u043b\u0456 \u0441\u0435\u043d\u0430, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u0441\u0430\u043b\u043e\u043c\u0443, \u0430 \u0432\u0430\u0448\u0430 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 &ndash; \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0432\u0430\u0441. \u041d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0441\u043f\u0430\u043b\u0435\u043d\u0430\u044f \u0432\u0430\u043f\u043d\u0430, \u044f\u043a \u0441\u0441\u0435\u0447\u0430\u043d\u044b\u044f \u0446\u0435\u0440\u043d\u0456 \u0437\u0433\u0430\u0440\u0430\u0446\u044c \u0443 \u0430\u0433\u043d\u0456. \u041f\u0430\u0447\u0443\u0439\u0446\u0435 \u0442\u044b\u044f, \u0448\u0442\u043e \u0434\u0430\u043b\u0451\u043a\u0430, \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041c\u0430\u0435; \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u043b\u0456\u0437\u043a\u0430, \u0441\u043f\u0430\u0437\u043d\u0430\u0439\u0446\u0435 \u041c\u0430\u044e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0434\u0440\u044b\u0436\u044d\u043b\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435. \u0425\u0442\u043e \u0437 \u043d\u0430\u0441 \u043c\u043e\u0436\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u044b \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0447\u044b\u043c \u0430\u0433\u043d\u0456? \u0425\u0442\u043e \u0437 \u043d\u0430\u0441 \u043c\u043e\u0436\u0430 \u0436\u044b\u0446\u044c \u043f\u0440\u044b \u0432\u0435\u0447\u043d\u044b\u043c \u043f\u043e\u043b\u044b\u043c\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c \u043f\u0440\u044b\u0431\u044b\u0442\u043a\u0430\u043c \u0456 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0430\u0434 \u0445\u0430\u0431\u0430\u0440\u0443, \u0437\u0430\u0442\u044b\u043a\u0430\u0435 \u0432\u0443\u0448\u044b \u0441\u0432\u0430\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0447\u0443\u0446\u044c \u0430\u0431 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u0456 \u043a\u0440\u044b\u0432\u0456, \u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0437\u043b\u0430. \u0422\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u044f\u0433\u043e \u043f\u0440\u044b\u0431\u0435\u0436\u044b\u0448\u0447\u0430 &ndash; \u043d\u0435\u043f\u0440\u044b\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043a\u0430\u043b\u044b; \u0445\u043b\u0435\u0431 \u044f\u043c\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0430\u0432\u0430\u0446\u044c, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u0432\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044f \u045e \u044f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u0430\u0441\u0435, \u044f\u043d\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0434\u0430\u043b\u0451\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0422\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u043f\u0440\u0430 \u0436\u0430\u0445\u0456: &laquo;\u0414\u0437\u0435 \u0442\u043e\u0439, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u043f\u0435\u0440\u0430\u043f\u0456\u0441? \u0414\u0437\u0435 \u0442\u043e\u0439, \u0448\u0442\u043e \u045e\u0437\u0432\u0430\u0436\u0432\u0430\u045e? \u0414\u0437\u0435 \u0442\u043e\u0439, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u045e \u0432\u0435\u0436\u044b?&raquo; \u0422\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0448 \u043d\u0430\u0440\u043e\u0434\u0443 \u043b\u044e\u0442\u0430\u0433\u0430, \u043d\u0430\u0440\u043e\u0434\u0443 \u0437 \u043d\u0435\u0440\u0430\u0437\u0431\u043e\u0440\u043b\u0456\u0432\u0430\u0439 \u0433\u0430\u0432\u043e\u0440\u043a\u0430\u0439, \u0437 \u043c\u043e\u0432\u0430\u0439 \u0447\u0443\u0436\u043e\u0439 \u0456 \u043d\u0435\u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0421\u0456\u0451\u043d, \u0433\u043e\u0440\u0430\u0434 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044f\u045e \u043d\u0430\u0448\u044b\u0445. \u0422\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u043b\u043b\u0451 \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b \u0448\u0430\u0446\u0451\u0440. \u042f\u0433\u043e \u043a\u0430\u043b\u043e\u045e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0432\u044b\u0440\u0432\u0443\u0446\u044c, \u0456 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0432\u044f\u0440\u043e\u045e\u043a\u0430 \u044f\u0433\u043e \u043d\u0435 \u043f\u0430\u0440\u0432\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u041f\u0430\u043d, \u044f\u043a \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u0442\u043e\u043a\u0430\u045e \u0456 \u0448\u044b\u0440\u043e\u043a\u0456\u0445 \u0440\u044d\u043a, \u043a\u0443\u0434\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u043d\u0456 \u0432\u0435\u0441\u043b\u0430\u0432\u044b \u0447\u043e\u0432\u0435\u043d, \u043d\u0456 \u043c\u043e\u0446\u043d\u044b \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c. \u0411\u043e \u041f\u0430\u043d &ndash; \u0441\u0443\u0434\u0434\u0437\u044f \u043d\u0430\u0448, \u041f\u0430\u043d &ndash; \u043d\u0430\u0448 \u0437\u0430\u043a\u0430\u043d\u0430\u0434\u0430\u045e\u0446\u0430, \u041f\u0430\u043d &ndash; \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u0430\u0448, \u0401\u043d \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0441\u043b\u0430\u0431\u043b\u0456 \u0442\u0432\u0430\u0435 \u0432\u044f\u0440\u043e\u045e\u043a\u0456, \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u043c\u0430\u0447\u0442\u0443 \u0456 \u0432\u0435\u0442\u0440\u0430\u0437\u0456. \u0422\u0430\u0434\u044b \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0437\u0434\u0430\u0431\u044b\u0447\u0430, \u043d\u0430\u0432\u0430\u0442 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b \u043f\u043e\u0439\u0434\u0437\u0435 \u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c. \u041d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0436\u044b\u0445\u0430\u0440 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430: &laquo;\u042f \u0445\u0432\u043e\u0440\u044b&raquo;. \u041d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0442\u0430\u043c, \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 33, 22; \u041f\u0441 97 (96), 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d &ndash; \u0441\u0443\u0434\u0434\u0437\u044f \u043d\u0430\u0448, \u041f\u0430\u043d &ndash; \u043d\u0430\u0448 \u0437\u0430\u043a\u0430\u043d\u0430\u0434\u0430\u045e\u0446\u0430, \u041f\u0430\u043d &ndash; \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u0430\u0448, <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u045e\u0440\u0430\u0442\u0443\u0435 \u043d\u0430\u0441. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0430\u0441\u0442\u0440\u0430\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u045e\u0440\u0430\u0442\u0443\u0435 \u043d\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"442","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">45, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u041a\u0456\u0440\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0441\u0432\u0430\u0439\u043c\u0443 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0443 \u041a\u0456\u0440\u0443: &laquo;\u042f \u0442\u0440\u044b\u043c\u0430\u044e \u043c\u043e\u0446\u043d\u0430 \u044f\u0433\u043e\u043d\u0443\u044e \u043f\u0440\u0430\u0432\u0456\u0446\u0443, \u043a\u0430\u0431 \u0441\u043a\u0430\u0440\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u043f\u0430\u044f\u0441\u044b \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u043a\u0430\u0431 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0434\u0437\u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u0431\u0440\u0430\u043c\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0437\u0430\u0447\u044b\u043d\u0435\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0430\u0439\u0434\u0443 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0440\u043e\u045e\u043d\u044b\u043c \u0432\u044b\u0441\u043e\u043a\u0430\u0435, \u042f \u0432\u044b\u043b\u0430\u043c\u0430\u044e \u043c\u0435\u0434\u043d\u044b\u044f \u0434\u0437\u0432\u0435\u0440\u044b \u0456 \u0440\u0430\u0437\u0430\u0431&rsquo;\u044e \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f \u0437\u0430\u0441\u043e\u0432\u044b. \u0414\u0430\u043c \u0442\u0430\u0431\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b \u0456 \u045e\u043a\u0440\u044b\u0442\u044b\u044f \u0431\u0430\u0433\u0430\u0446\u0446\u0456, \u043a\u0430\u0431 \u0442\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u043a\u043b\u0456\u0447\u0430 \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0433\u0456 \u043c\u0430\u0439\u0433\u043e \u042f\u043a\u0443\u0431\u0430 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u043c\u0430\u0439\u0433\u043e, \u044f \u043d\u0430\u0437\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u0456\u043c\u0435\u043c \u0442\u0432\u0430\u0456\u043c; \u042f \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0433\u0430\u043d\u0430\u0440\u043e\u0432\u0430\u0435 \u0456\u043c\u044f, \u0445\u043e\u0446\u044c \u0442\u044b \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u041c\u044f\u043d\u0435. \u042f &ndash; \u041f\u0430\u043d, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430. \u0410\u043f\u0440\u043e\u0447 \u041c\u044f\u043d\u0435 \u043d\u044f\u043c\u0430 \u0431\u043e\u0433\u0430. \u042f \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e \u0446\u044f\u0431\u0435, \u0445\u043e\u0446\u044c \u0442\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u041c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u0430\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 \u0456 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430 \u0430\u043f\u0440\u043e\u0447 \u041c\u044f\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f &ndash; \u041f\u0430\u043d, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430. \u042f \u0444\u0430\u0440\u043c\u0443\u044e \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u0446\u0435\u043c\u0440\u0443, \u0447\u044b\u043d\u044e \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e. \u042f, \u041f\u0430\u043d, \u0447\u044b\u043d\u044e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0440\u0430\u043f\u0456\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0437 \u0432\u044b\u0448\u044b\u043d\u044f\u045e, \u0456 \u0445\u043c\u0430\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043b\u044c\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0456 \u0440\u0430\u0437\u0430\u043c \u0443\u0437\u044b\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u042f, \u041f\u0430\u043d, \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451 \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u043f\u0440\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0441\u0432\u0430\u0456\u043c, \u0433\u044d\u0442\u0430 \u0430\u0441\u043a\u043e\u043b\u0430\u043a \u0437 \u0430\u0441\u043a\u043e\u043b\u043a\u0430\u045e \u0437\u044f\u043c\u043d\u044b\u0445! \u0426\u0456 \u0441\u043a\u0430\u0436\u0430 \u0433\u043b\u0456\u043d\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u0433\u0430\u043d\u0447\u0430\u0440\u0443: &laquo;\u0428\u0442\u043e \u0442\u044b \u0440\u043e\u0431\u0456\u0448?&raquo; \u0410 \u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0442\u0432\u0430\u0451: &laquo;\u0425\u0456\u0431\u0430 \u0442\u044b \u0431\u0435\u0437 \u0440\u0443\u043a?&raquo; \u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u0431\u0430\u0446\u044c\u043a\u0443: &laquo;\u0428\u0442\u043e \u0442\u044b \u0441\u043f\u0430\u0440\u0430\u0434\u0437\u0456\u045e?&raquo;, \u0430\u0431\u043e \u0436\u0430\u043d\u0447\u044b\u043d\u0435: &laquo;\u0428\u0442\u043e \u0442\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u042f\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c: &laquo;\u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u045e \u041c\u044f\u043d\u0435 \u043f\u0440\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e \u041c\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0441\u043f\u0440\u0430\u0432\u044b \u041c\u0430\u0456\u0445 \u0440\u0443\u043a? \u042f \u045e\u0447\u044b\u043d\u0456\u045e \u0437\u044f\u043c\u043b\u044e \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430 \u0451\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u042f \u0441\u0432\u0430\u0456\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u045e \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u0446\u044d\u043b\u0430\u043c\u0443 \u0456\u0445\u043d\u044f\u043c\u0443 \u0432\u043e\u0439\u0441\u043a\u0443 \u042f \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e. \u042f \u045e\u0437\u043d\u044f\u045e \u044f\u0433\u043e \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0456 \u042f \u0432\u044b\u043f\u0440\u0430\u0441\u0442\u0430\u044e \u045e\u0441\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456. \u0401\u043d \u0430\u0434\u0431\u0443\u0434\u0443\u0435 \u041c\u043e\u0439 \u0433\u043e\u0440\u0430\u0434 \u0456 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u041c\u0430\u0456\u0445 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445 \u0431\u0435\u0437 \u0432\u043e\u0434\u043a\u0443\u043f\u0443 \u0456 \u043f\u043b\u0430\u0442\u044b&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 45, 8; \u043f\u0430\u0440. 16, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0440\u0430\u043f\u0456\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0437 \u0432\u044b\u0448\u044b\u043d\u044f\u045e, \u0456 \u0445\u043c\u0430\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043b\u044c\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0448\u043b\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u041f\u0430\u043d\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430 \u0437\u044f\u043c\u043b\u0456, \u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u0434\u0430\u0447\u043a\u0456 \u0421\u0456\u0451\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"443","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">46, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044d\u043b\u044c \u0443\u043f\u0430\u045e \u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u0456, \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u041d\u044d\u0431\u0430. \u0406\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u043f\u0430\u0433\u0440\u0443\u0437\u0456\u043b\u0456 \u043d\u0430 \u0437\u0432\u044f\u0440\u043e\u045e \u0456 \u043d\u0430 \u045e\u044e\u0447\u043d\u044b\u0445 \u0436\u044b\u0432\u0451\u043b\u0430\u045e. \u0412\u0430\u0448\u0430 \u043d\u043e\u0448\u0430 \u0441\u0442\u0430\u043b\u0430 \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0434\u043b\u044f \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u0430\u0439 \u0436\u044b\u0432\u0451\u043b\u044b. \u0421\u0445\u0456\u043b\u0456\u043b\u0456\u0441\u044f \u0456 \u045e\u043f\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u0456; \u044f\u043d\u044b \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u043e\u0448\u044b \u0456 \u0441\u0430\u043c\u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u043f\u0430\u043b\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0434\u043e\u043c \u042f\u043a\u0443\u0431\u0430 \u0456 \u045e\u0441\u044f \u0440\u044d\u0448\u0442\u0430 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u043d\u0430\u0441\u0456\u045e \u0432\u0430\u0441 \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0432\u0430\u0441 \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u0410\u0436 \u0434\u0430 \u0432\u0430\u0448\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456 \u042f \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0456 \u0430\u0436 \u0434\u0430 \u0441\u0456\u0432\u0456\u0437\u043d\u044b \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u0430\u0441. \u042f \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456 \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u0456\u0446\u044c, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u043a\u0430\u0433\u043e \u0432\u044b \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0435 \u041c\u044f\u043d\u0435, \u0437 \u043a\u0456\u043c \u0441\u0443\u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u0435 \u0456 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0435\u0446\u0435 \u041c\u044f\u043d\u0435, \u0437 \u043a\u0456\u043c \u041c\u044f\u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0446\u0435 \u0440\u043e\u045e\u043d\u044b\u043c? \u042f\u043d\u044b \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u0441\u044b\u043f\u0430\u044e\u0446\u044c \u0437\u043e\u043b\u0430\u0442\u0430 \u0437 \u043c\u0430\u0448\u043d\u044b \u0456 \u045e\u0437\u0432\u0430\u0436\u0432\u0430\u044e\u0446\u044c \u0441\u0440\u044d\u0431\u0440\u0430 \u043d\u0430 \u0448\u0430\u043b\u044f\u0445, \u043d\u0430\u0439\u043c\u0430\u044e\u0446\u044c \u043f\u043b\u0430\u0432\u0456\u043b\u044c\u0448\u0447\u044b\u043a\u0430\u045e, \u043a\u0430\u0431 \u0442\u044b\u044f \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0456\u043c \u0431\u043e\u0433\u0430. \u041a\u043b\u0430\u043d\u044f\u044e\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0456 \u043f\u0430\u0434\u0430\u044e\u0446\u044c \u043d\u0456\u0446\u043c\u0430, \u043d\u043e\u0441\u044f\u0446\u044c \u044f\u0433\u043e \u043d\u0430 \u043f\u043b\u044f\u0447\u0430\u0445 \u0456 \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u043d\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430. \u0410 \u0442\u043e\u0439 \u0441\u0442\u0430\u0456\u0446\u044c \u0456 \u043d\u0435 \u043a\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0435\u0441\u0446\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u043b\u0456\u043a\u0430\u0446\u044c \u044f\u0433\u043e, \u0451\u043d \u043d\u0435 \u043f\u0430\u0447\u0443\u0435 \u0456 \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435 \u0456\u0445 \u0430\u0434 \u043d\u044f\u0434\u043e\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u043c\u043d\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u0439\u0446\u0435 \u0441\u043e\u0440\u0430\u043c, \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0456, \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u0417\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u042f &ndash; \u0411\u043e\u0433 \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u042f \u0411\u043e\u0433 \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u044f\u043a \u042f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u045e \u043a\u0430\u043d\u0446\u044b \u0456 \u0437\u0434\u0430\u045e\u043d\u0430 &ndash; \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f. \u042f \u043a\u0430\u0436\u0443: &laquo;\u041c\u043e\u0439 \u043d\u0430\u043c\u0435\u0440 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430, \u044f \u0441\u043f\u043e\u045e\u043d\u044e \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0432\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435&raquo;. \u042f \u043f\u0430\u043a\u043b\u0456\u0447\u0443 \u0437 \u0423\u0441\u0445\u043e\u0434\u0443 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u0443\u044e \u043f\u0442\u0443\u0448\u043a\u0443 \u0456 \u0437 \u0434\u0430\u043b\u0451\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 &ndash; \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u041c\u0430\u0451\u0439 \u0437\u0430\u0434\u0443\u043c\u044b. \u0422\u0430\u043a, \u042f \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0456 \u0441\u043f\u043e\u045e\u043d\u044e; \u042f \u0433\u044d\u0442\u0430 \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0456 \u0437\u0440\u0430\u0431\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u041c\u044f\u043d\u0435, \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0434\u0430\u043b\u0451\u043a\u0456\u044f \u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u042f \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043d\u0430 \u043d\u0435 \u0434\u0430\u043b\u0451\u043a\u0430, \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041c\u0430\u0451 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c. \u042f \u0434\u0430\u043c \u043d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456 &ndash; \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 46, 12. 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u041c\u044f\u043d\u0435, \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0434\u0430\u043b\u0451\u043a\u0456\u044f \u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0434\u0430\u043c \u043d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456 &ndash; \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043d\u0430 \u043d\u0435 \u0434\u0430\u043b\u0451\u043a\u0430, \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041c\u0430\u0451 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0434\u0430\u043c \u043d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456 &ndash; \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"444","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">47, 1. 3b-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u043b\u0430\u0447 \u043d\u0430\u0434 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u0434\u0437\u0456 \u0456 \u0441\u044f\u0434\u0437\u044c \u0443 \u043f\u044b\u043b, \u0434\u0437\u0435\u0432\u0430, \u0434\u0430\u0447\u043a\u0430 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430. \u0421\u044f\u0434\u0437\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0431\u0435\u0437 \u0442\u0440\u043e\u043d\u0430, \u0434\u0430\u0447\u043a\u0430 \u0445\u0430\u043b\u0434\u044d\u044f\u045e. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0436\u043e \u0446\u044f\u0431\u0435 \u043d\u0435 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u043f\u044f\u0448\u0447\u043e\u0442\u043d\u0430\u0439 \u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0439. \u042f \u0431\u0443\u0434\u0443 \u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u044e \u043d\u0456\u043a\u043e\u0433\u0430. \u041d\u0430\u0448 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u0456\u043c\u044f \u042f\u043c\u0443 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, &ndash; \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044f\u0434\u0437\u044c \u043c\u043e\u045e\u0447\u043a\u0456 \u0456 \u0430\u0434\u044b\u0434\u0437\u0456 \u045e \u0446\u0435\u043c\u0440\u0443, \u043e \u0434\u0430\u0447\u043a\u0430 \u0445\u0430\u043b\u0434\u044d\u044f\u045e, \u0431\u043e \u0446\u044f\u0431\u0435 \u045e\u0436\u043e \u043d\u0435 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0443\u043b\u0430\u0434\u0430\u0440\u043a\u0430\u0439 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0456 \u0430\u0434\u0434\u0430\u045e \u0456\u0445 \u0443 \u0442\u0432\u0430\u0435 \u0440\u0443\u043a\u0456. \u0422\u044b \u043d\u0435 \u043f\u0440\u0430\u044f\u0432\u0456\u043b\u0430 \u0434\u0430 \u0456\u0445 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043d\u0430 \u0441\u0442\u0430\u0440\u0446\u0430 \u045e\u0441\u043a\u043b\u0430\u043b\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0446\u044f\u0436\u043a\u0430\u0435 \u044f\u0440\u043c\u043e \u0441\u0432\u0430\u0451. \u0421\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0441\u044f \u045e\u043b\u0430\u0434\u0430\u0440\u043a\u0430\u0439&raquo;. \u0410\u043b\u0435 \u0442\u044b \u043d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0430 \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c\u0456 \u043f\u0430\u0434\u0437\u0435\u044f\u043c\u0456 \u0456 \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u043a\u0430\u043d\u0435\u0446.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0433\u044d\u0442\u0430, \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u044f, \u0448\u0442\u043e \u0436\u044b\u0432\u0435\u0448 \u0431\u0435\u0441\u043a\u043b\u0430\u043f\u043e\u0442\u043d\u0430 \u0456 \u043a\u0430\u0436\u0430\u0448 \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &laquo;\u0422\u043e\u043b\u044c\u043a\u0456 \u044f, \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0456\u0445\u0442\u043e; \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u044f\u043a \u0443\u0434\u0430\u0432\u0430 \u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0441\u044f \u0431\u044f\u0437\u0434\u0437\u0435\u0442\u043d\u0430\u0439&raquo;. \u0410\u0434\u043d\u0430\u043a \u0443 \u043f\u044d\u045e\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0434\u0430 \u0446\u044f\u0431\u0435 \u043d\u0435\u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435, \u0456 \u0441\u0442\u0440\u0430\u0442\u0430 \u0434\u0437\u044f\u0446\u0435\u0439, \u0456 \u045e\u0434\u0430\u045e\u0441\u0442\u0432\u043e. \u0423\u0441\u0451 \u0437 \u043b\u0456\u0445\u0432\u043e\u044e \u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0430 \u0446\u044f\u0431\u0435, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0456\u0445 \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e \u0456 \u043d\u0430 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0442\u0432\u0430\u0435 \u0437\u0430\u043a\u043b\u044f\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u044e \u0437\u043b\u0430\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041d\u0456\u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c&raquo;. \u0422\u0432\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0434\u044b \u0442\u0432\u0430\u0435 \u045e\u0432\u044f\u043b\u0456 \u0446\u044f\u0431\u0435 \u045e \u0437\u043c\u0430\u043d. \u0406 \u0442\u044b \u043a\u0430\u0437\u0430\u043b\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b: &laquo;\u0422\u043e\u043b\u044c\u043a\u0456 \u044f, \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0456\u0445\u0442\u043e&raquo;. \u0406 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430 \u0446\u044f\u0431\u0435 \u0431\u044f\u0434\u0430, \u043d\u0430 \u044f\u043a\u0443\u044e \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0437\u0430\u043a\u043b\u044f\u0446\u0446\u044f, \u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430 \u0446\u044f\u0431\u0435 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430, \u044f\u043a\u043e\u0439 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u0435\u0448 \u043f\u0440\u0430\u0434\u0443\u0445\u0456\u043b\u0456\u0446\u044c, \u0456 \u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0430 \u0446\u044f\u0431\u0435 \u0437\u0433\u0443\u0431\u0430, \u044f\u043a\u043e\u0439 \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0443\u044f\u0432\u0456\u0446\u044c.\u0417\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0437 \u0437\u0430\u043a\u043b\u044f\u0446\u0446\u044f\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456 \u0437 \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u0447\u0430\u0440\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u044f\u043a\u0456\u043c\u0456 \u0442\u044b \u0437\u0430\u0439\u043c\u0430\u043b\u0430\u0441\u044f \u0430\u0434 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439. \u041c\u043e\u0436\u0430, \u0442\u0430\u0431\u0435 \u045e\u0434\u0430\u0441\u0446\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u044c \u0456\u0445, \u043c\u043e\u0436\u0430, \u0432\u044b\u043a\u043b\u0456\u0447\u0430\u0448 \u0441\u0442\u0440\u0430\u0445?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0442\u0430\u043c\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0436\u0430 \u0432\u044b\u0441\u0442\u0443\u043f\u044f\u0446\u044c \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u0442\u0430\u0431\u0435 \u0430\u0441\u0442\u0440\u043e\u043b\u0430\u0433\u0456, \u044f\u043a\u0456\u044f \u045e\u0433\u043b\u044f\u0434\u0430\u044e\u0446\u0446\u0430 \u045e \u0437\u043e\u0440\u043a\u0456 \u0456 \u0432\u044b\u043b\u0456\u0447\u0432\u0430\u044e\u0446\u044c \u043d\u0430 \u043a\u043e\u0436\u043d\u044b \u043c\u0435\u0441\u044f\u0446, \u0448\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u043f\u0430\u0442\u043a\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u044f\u043a \u043c\u044f\u043a\u0456\u043d\u0430, \u0430\u0433\u043e\u043d\u044c \u0456\u0445 \u0441\u043f\u0430\u043b\u0456\u0446\u044c. \u042f\u043d\u044b \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u044e\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0437 \u0440\u0443\u043a\u0456 \u0430\u0433\u043d\u044e. \u0413\u044d\u0442\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0443\u0433\u043e\u043b\u043b\u0435, \u043a\u0430\u0431 \u043f\u0430\u0433\u0440\u044d\u0446\u0446\u0430, \u0446\u0456 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u044f\u0434\u0437\u0435\u0446\u044c \u043f\u0440\u044b \u0456\u043c. \u0422\u0430\u043a\u0456\u043c\u0456 \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0442\u044b\u044f, \u0437 \u043a\u0456\u043c \u0442\u044b \u0433\u0430\u043d\u0434\u043b\u044f\u0432\u0430\u043b\u0430 \u0430\u0434 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439. \u041a\u043e\u0436\u043d\u044b \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u043e\u0439 \u0431\u043e\u043a, \u043d\u044f\u043c\u0430 \u043a\u0430\u043c\u0443 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 49, 13; 47, 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0437\u044f\u043c\u043b\u044f. \u0413\u043e\u0440\u044b, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0456\u0446\u0435 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u041f\u0430\u043d \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0431\u043e\u0433\u0456\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0448 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, &ndash; \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u041f\u0430\u043d \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0431\u043e\u0433\u0456\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"445","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">48, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0434\u0437\u0456\u043d \u0411\u043e\u0433 &ndash; \u041f\u0430\u043d \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0447\u0430\u0441\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0433\u044d\u0442\u0430, \u0434\u043e\u043c \u042f\u043a\u0443\u0431\u0430, \u044f\u043a\u0456 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0456\u043c\u0435\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0448 \u0437 \u0432\u043e\u0434\u0430\u045e \u042e\u0434\u044b, \u044f\u043a\u0456 \u043a\u043b\u044f\u043d\u0435\u0448\u0441\u044f \u0456\u043c\u0435\u043c \u041f\u0430\u043d\u0430 \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u0448 \u0456\u043c\u044f \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u043d\u0435 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0411\u043e \u044f\u043d\u044b \u0437\u0430\u0432\u0443\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u0456 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 &ndash; \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0430\u045e\u043d\u0430 \u042f \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043c\u0456\u043d\u0443\u043b\u0430\u0435, \u0456 \u044f\u043d\u043e \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u043c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e, \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0432\u0430\u043c \u043f\u0430\u0447\u0443\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e. \u042f \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430 &ndash; \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u044f\u043d\u043e. \u0411\u043e \u042f \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0422\u044b \u045e\u043f\u0430\u0440\u0442\u044b, \u0448\u0442\u043e \u0442\u0432\u043e\u0439 \u043a\u0430\u0440\u0430\u043a &ndash; \u0433\u044d\u0442\u0430 \u0436\u0430\u043b\u0435\u0437\u043d\u0430\u044f \u0436\u044b\u043b\u0430, \u0430 \u043b\u043e\u0431 \u0442\u0432\u043e\u0439 &ndash; \u0437 \u043c\u0435\u0434\u0437\u0456. \u0422\u0430\u043c\u0443 \u042f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0442\u0430\u0431\u0435 \u0437\u0430\u0434\u043e\u045e\u0433\u0430, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c \u044f\u043a \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f; \u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0442\u0430\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u043e\u0439 \u0456\u0434\u0430\u043b \u0433\u044d\u0442\u0430 \u045e\u0447\u044b\u043d\u0456\u045e, \u043c\u043e\u0439 \u0431\u0430\u0436\u043e\u043a \u0456 \u0441\u0442\u0430\u0442\u0443\u044f \u043c\u0430\u044f \u0433\u044d\u0442\u0430\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0456&raquo;. \u0422\u044b \u0447\u0443\u045e \u0456 \u0431\u0430\u0447\u044b\u045e \u0443\u0441\u0451 \u0433\u044d\u0442\u0430, \u0445\u0456\u0431\u0430 \u0432\u044b \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u0446\u0435 \u0433\u044d\u0442\u0430\u0433\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0442\u0430\u0431\u0435 \u043d\u043e\u0432\u044b\u044f \u0440\u044d\u0447\u044b, \u0442\u0430\u0435\u043c\u043d\u044b\u044f \u0456 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u044f \u0442\u0430\u0431\u0435. \u042f\u043d\u044b \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0446\u044f\u043f\u0435\u0440, \u0430 \u043d\u0435 \u0437\u0434\u0430\u045e\u043d\u0430; \u0456 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u0442\u044b \u043d\u0435 \u0447\u0443\u045e \u043f\u0440\u0430 \u0456\u0445, \u043a\u0430\u0431 \u0442\u044b \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0432\u0435\u0434\u0430\u045e \u043f\u0440\u0430 \u0456\u0445&raquo;. \u0422\u044b \u043d\u0435 \u0447\u0443\u045e \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0442\u0432\u0430\u0451 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0434\u043a\u0440\u044b\u0442\u0430, \u0431\u043e \u042f \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0442\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b \u0456 \u0430\u0434 \u043c\u0430\u0442\u0447\u044b\u043d\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0448\u0441\u044f \u0431\u0443\u043d\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u042f \u0430\u0434\u043a\u043b\u0430\u0434\u0430\u044e \u0441\u0432\u043e\u0439 \u0433\u043d\u0435\u045e, \u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u044b \u042f \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0441\u044f, \u043a\u0430\u0431 \u0446\u044f\u0431\u0435 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c. \u0412\u043e\u0441\u044c, \u042f \u043f\u0435\u0440\u0430\u043f\u043b\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u0441\u0440\u044d\u0431\u0440\u0430, \u042f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u045e \u0433\u0430\u0440\u043d\u0456\u043b\u0435 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443. \u0414\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435, \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u042f \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u043b\u044e, \u0431\u043e \u0445\u0456\u0431\u0430 \u043c\u0430\u0433\u0443 \u042f \u0437\u0432\u0435\u0434\u0430\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0433\u0443? \u0410 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0456\u043d\u0448\u0430\u043c\u0443 \u042f \u043d\u0435 \u0430\u0434\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 48, 10. 11; 54, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u045e \u0433\u0430\u0440\u043d\u0456\u043b\u0435 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443. \u0414\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u042f \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u043b\u044e, \u0431\u043e \u0445\u0456\u0431\u0430 \u043c\u0430\u0433\u0443 \u042f \u0437\u0432\u0435\u0434\u0430\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0433\u0443? <span style=\"color: #ff0000;\">*<\/span> \u042f \u043d\u0435 \u0430\u0434\u0434\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0456\u043d\u0448\u0430\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0435 \u0433\u043d\u0435\u0432\u0443 \u042f \u0441\u0445\u0430\u0432\u0430\u045e \u0430\u0434 \u0446\u044f\u0431\u0435 \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041c\u0430\u0451, \u0430\u043b\u0435 \u045e \u0432\u0435\u0447\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0437\u043c\u0456\u043b\u0443\u044e\u0441\u044f \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0435 \u0430\u0434\u0434\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0456\u043d\u0448\u0430\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"446","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">48, 12-21; 49, 9b-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u044b \u0437\u044b\u0445\u043e\u0434<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u0421\u043b\u0443\u0445\u0430\u0439 \u041c\u044f\u043d\u0435, \u042f\u043a\u0443\u0431 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456 \u042f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e. \u042f \u0442\u043e\u0439 \u0441\u0430\u043c\u044b, \u042f &ndash; \u043f\u0435\u0440\u0448\u044b, \u0456 \u042f &ndash; \u0430\u043f\u043e\u0448\u043d\u0456. \u0413\u044d\u0442\u0430 \u041c\u0430\u044f \u0440\u0443\u043a\u0430 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u041c\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u0446\u0430 \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440\u043b\u0430 \u043d\u044f\u0431\u0451\u0441\u044b; \u043a\u0430\u043b\u0456 \u042f \u0456\u0445 \u043a\u043b\u0456\u0447\u0443, \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0431\u044f\u0440\u044b\u0446\u0435\u0441\u044f \u045e\u0441\u0435 \u0456 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435: \u0445\u0442\u043e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430? \u0422\u043e\u0439, \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0432\u044b\u043a\u0430\u043d\u0430\u0435 \u0432\u043e\u043b\u044e \u042f\u0433\u043e \u043d\u0430\u0434 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430\u043c \u0456 \u043f\u0430\u0434\u044b\u043c\u0435 \u0440\u0443\u043a\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0445\u0430\u043b\u0434\u044d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u042f, \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0456 \u042f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e. \u042f \u043f\u0440\u044b\u0432\u0451\u045e \u044f\u0433\u043e, \u0456 \u0448\u043b\u044f\u0445 \u044f\u0433\u043e\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c. \u041f\u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u0430: \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u042f \u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0434\u0430 \u0432\u0430\u0441 \u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0430\u0434 \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043b\u0430, \u042f \u0431\u044b\u045e \u0442\u0430\u043c. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0456 \u042f\u0433\u043e \u0414\u0443\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435, \u044f\u043a\u0456 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u043a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0437\u0432\u0430\u0436\u0430\u045e \u043d\u0430 \u043c\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0442\u0430\u0434\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0442\u0432\u043e\u0439 \u0431\u044b\u045e \u0431\u044b, \u044f\u043a \u0440\u0430\u043a\u0430, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f, \u044f\u043a \u0445\u0432\u0430\u043b\u0456 \u043c\u0430\u0440\u0441\u043a\u0456\u044f. \u0406 \u0442\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0431\u044b\u043b\u043e \u0431, \u044f\u043a \u043f\u044f\u0441\u043a\u0443, \u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u044f\u0433\u043e \u043f\u044f\u0441\u0447\u044b\u043d\u0430\u043a. \u041d\u0435 \u0437\u043d\u0456\u043a\u043b\u0430 \u0431 \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0456\u043c\u044f \u0442\u0432\u0430\u0451 \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u0437 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430, \u0443\u0446\u044f\u043a\u0430\u0439\u0446\u0435 \u0437 \u0425\u0430\u043b\u0434\u044d\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u0430 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u043c, \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456. \u041a\u0430\u0436\u044b\u0446\u0435: &ldquo;\u041f\u0430\u043d \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u042f\u043a\u0443\u0431\u0430&rdquo;. \u042f\u043d\u044b \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0456 \u0441\u043c\u0430\u0433\u0456, \u043a\u0430\u043b\u0456 \u0401\u043d \u0432\u0451\u045e \u0456\u0445 \u043f\u0440\u0430\u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u044e. \u0401\u043d \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u045e \u0456\u043c \u0432\u0430\u0434\u0443 \u0441\u0430 \u0441\u043a\u0430\u043b\u044b, \u0440\u0430\u0441\u0441\u0435\u043a \u0441\u043a\u0430\u043b\u0443 &ndash; \u0456 \u043f\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0432\u0430\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u044b \u0434\u0430\u0440\u043e\u0433\u0430\u0445, \u0456\u0445 \u043f\u0430\u0448\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044b\u0441\u044b\u0445 \u0443\u0437\u0433\u043e\u0440\u043a\u0430\u0445. \u042f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u043b\u0430\u0434\u0430\u0446\u044c \u0456 \u0441\u043c\u0430\u0433\u043d\u0443\u0446\u044c, \u0456 \u043d\u0435 \u045e\u0434\u0430\u0440\u044b\u0446\u044c \u043f\u0430 \u0456\u0445 \u043d\u0456 \u0441\u043f\u0451\u043a\u0430, \u043d\u0456 \u0441\u043e\u043d\u0446\u0430, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0448\u043a\u0430\u0434\u0443\u0435 \u0456\u0445, \u043d\u0430\u043a\u0456\u0440\u0443\u0435 \u0456\u0445 \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0432\u0430\u0434\u044b. \u0410\u0431\u044f\u0440\u043d\u0443 \u045e\u0441\u0435 \u0433\u043e\u0440\u044b \u045e \u0434\u0430\u0440\u043e\u0433\u0456, \u0456 \u0448\u043b\u044f\u0445\u0456 \u041c\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0437\u043d\u044f\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0430\u0434\u043d\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a. \u0406 \u0432\u043e\u0441\u044c \u0434\u0440\u0443\u0433\u0456\u044f &ndash; \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u0456 \u0437 \u0437\u0430\u0445\u0430\u0434\u0443, \u0430 \u0456\u043d\u0448\u044b\u044f &ndash; \u0437 \u0437\u044f\u043c\u043b\u0456 \u0421\u0456\u043d\u0456\u043c&raquo;. \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0437\u044f\u043c\u043b\u044f. \u0413\u043e\u0440\u044b, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0456\u0446\u0435 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u0411\u043e \u041f\u0430\u043d \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0431\u043e\u0433\u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 49, 13; \u041f\u0441 72 (71), 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0437\u044f\u043c\u043b\u044f. \u0413\u043e\u0440\u044b, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0456\u0446\u0435 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u0411\u043e \u041f\u0430\u043d \u043d\u0430\u0448 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0431\u043e\u0433\u0456\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u042f\u0433\u043e \u0434\u043d\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0431\u043e\u0433\u0456\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"447","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">49, 14 &ndash; 50, 1<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0421\u0456\u0451\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0437\u0430\u045e \u0421\u0456\u0451\u043d: &laquo;\u041f\u0430\u043d \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e, \u041f\u0430\u043d \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u043c\u044f\u043d\u0435&raquo;. \u0426\u0456 \u0437\u0430\u0431\u0443\u0434\u0437\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u043d\u0435\u043c\u0430\u045e\u043b\u044f, \u0445\u0456\u0431\u0430 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u0441\u044b\u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e? \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u0437\u0430\u0431\u0443\u0434\u0437\u0435, \u042f \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u043f\u0440\u0430 \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u042f \u0432\u044b\u0440\u0430\u0437\u0430\u045e \u0446\u044f\u0431\u0435 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u043b\u043e\u043d\u044f\u0445, \u0441\u0446\u0435\u043d\u044b \u0442\u0432\u0430\u0435 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u0439. \u0421\u043f\u044f\u0448\u0430\u044e\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0441\u044b\u043d\u044b, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u045e \u0456 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u0430\u045e \u0446\u044f\u0431\u0435, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0446\u044f\u0431\u0435 \u0434\u0430\u043b\u0451\u043a\u0430. \u041f\u0430\u0434\u044b\u043c\u0456 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u0430\u0433\u043b\u0435\u0434\u0437\u044c\u0441\u044f: \u0443\u0441\u0435 \u044f\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. &laquo;\u041f\u0440\u044b\u0441\u044f\u0433\u0430\u044e \u042f, \u0436\u044b\u0432\u044b, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0442\u044b \u0430\u043f\u0440\u0430\u043d\u0435\u0448\u0441\u044f \u045e \u0456\u0445 \u0443\u0441\u0456\u0445, \u043d\u0456\u0431\u044b \u0432\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0456, \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0436\u0430\u0448\u0441\u044f \u0456\u043c\u0456, \u044f\u043a \u043d\u044f\u0432\u0435\u0441\u0442\u0430&raquo;. \u0411\u043e \u0442\u0432\u0430\u0435 \u0440\u0430\u0437\u0432\u0430\u043b\u0456\u043d\u044b \u0456 \u0440\u0443\u0456\u043d\u044b, \u0442\u0432\u0430\u044f \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0441\u0442\u0430\u043d\u0435 \u0446\u0435\u0441\u043d\u0430\u0439 \u0434\u043b\u044f \u0436\u044b\u0445\u0430\u0440\u043e\u045e, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u045e, \u0430\u0434\u0434\u0430\u043b\u044f\u0446\u0446\u0430. \u0421\u044b\u043d\u044b \u0441\u0456\u0440\u043e\u0446\u0442\u0432\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u043d\u0430 \u0432\u0443\u0445\u0430: &laquo;\u0417\u0430\u043d\u0430\u0434\u0442\u0430 \u0446\u0435\u0441\u043d\u0430\u044f \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0437\u0440\u0430\u0431\u0456 \u043c\u043d\u0435 \u043c\u0435\u0441\u0446\u0430, \u043a\u0430\u0431 \u044f \u0437\u043c\u043e\u0433 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430&raquo;. \u0422\u0430\u0434\u044b \u0442\u044b \u0441\u043a\u0430\u0436\u0430\u0448 \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c: &laquo;\u0425\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043c\u043d\u0435 \u0456\u0445? \u042f \u0436 \u0431\u044b\u043b\u0430 \u0431\u044f\u0437\u0434\u0437\u0435\u0442\u043d\u0430\u0439 \u0456 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u0439, \u0431\u044b\u043b\u0430 \u045e \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u044f. \u0425\u0442\u043e \u0456\u0445 \u0432\u044b\u0433\u0430\u0434\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435? \u042f \u0436 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0434\u043d\u0430. \u0410\u0434\u043a\u0443\u043b\u044c \u044f\u043d\u044b?&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: &laquo;\u0412\u043e\u0441\u044c, \u042f \u043f\u0430\u0434\u044b\u043c\u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u045e\u0437\u043d\u0456\u043c\u0443 \u0441\u0432\u043e\u0439 \u0441\u0446\u044f\u0433 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c. \u042f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u043d\u0430 \u0440\u0443\u043a\u0430\u0445, \u0430 \u0442\u0432\u0430\u0456\u0445 \u0434\u0430\u0447\u043e\u043a &ndash; \u043d\u0430 \u043f\u043b\u044f\u0447\u0430\u0445. \u041a\u0430\u0440\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044f\u043c\u0456 \u0442\u0432\u0430\u0456\u043c\u0456, \u0430 \u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u044b &ndash; \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044c\u043a\u0430\u043c\u0456 \u0442\u0432\u0430\u0456\u043c\u0456. \u0410\u0436 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u0456 \u043b\u0456\u0437\u0430\u0446\u044c \u043f\u044b\u043b \u0437 \u0442\u0432\u0430\u0456\u0445 \u043d\u043e\u0433. \u0422\u0430\u0434\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0448, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0456 \u043d\u0435 \u043f\u0430\u0441\u0430\u0440\u043e\u043c\u044f\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430 \u041c\u044f\u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0437\u0434\u0430\u0431\u044b\u0447\u0443 \u045e \u0430\u0441\u0456\u043b\u043a\u0430? \u0426\u0456 \u043c\u043e\u0436\u0430 \u0441\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u045e \u043f\u0430\u043b\u043e\u043d \u0443\u0446\u044f\u0447\u044b \u0430\u0434 \u0442\u044b\u0440\u0430\u043d\u0430? \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u041d\u0430\u0432\u0430\u0442 \u0443 \u0430\u0441\u0456\u043b\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0440\u0430\u043d\u044b \u043f\u0430\u043b\u043e\u043d\u043d\u044b, \u0456 \u0430\u0434 \u0442\u044b\u0440\u0430\u043d\u0430 \u045e\u0446\u044f\u0447\u044d \u0437\u0434\u0430\u0431\u044b\u0447\u0430, \u042f \u0431\u0443\u0434\u0443 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0442\u0432\u0430\u0456\u043c\u0456, \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043d\u0430\u043a\u0430\u0440\u043c\u043b\u044e \u0442\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0456\u0445 \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0446\u0435\u043b\u0430\u043c, \u0456 \u044f\u043d\u044b \u043d\u0430\u043f&rsquo;\u044e\u0446\u0446\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u043a\u0440\u044b\u0432\u0456, \u043d\u0456\u0431\u044b \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u0432\u0456\u043d\u0430, \u043a\u0430\u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0442\u0432\u043e\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u041c\u043e\u0446\u043d\u044b \u042f\u043a\u0443\u0431\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u0414\u0437\u0435 \u0440\u0430\u0437\u0432\u043e\u0434\u043d\u044b \u043b\u0456\u0441\u0442 \u0432\u0430\u0448\u0430\u0439 \u043c\u0430\u0446\u0456, \u0437 \u044f\u043a\u0456\u043c \u042f \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u044f\u0435? \u0410\u0431\u043e \u0445\u0442\u043e \u041c\u043e\u0439 \u043f\u0430\u0437\u044b\u043a\u043e\u0432\u0435\u0446, \u044f\u043a\u043e\u043c\u0443 \u042f \u043f\u0440\u0430\u0434\u0430\u045e \u0432\u0430\u0441? \u0414\u044b\u043a \u0432\u043e\u0441\u044c \u0437\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0433\u0440\u0430\u0445\u0456 \u043f\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0432\u044b \u0456 \u0437\u0430 \u0432\u0430\u0448\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u0430 \u0432\u0430\u0448\u0430\u044f \u043c\u0430\u0446\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 49, 15; \u043f\u0430\u0440. \u041f\u0441 27 (26), 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u0456 \u0437\u0430\u0431\u0443\u0434\u0437\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u043d\u0435\u043c\u0430\u045e\u043b\u044f, \u0445\u0456\u0431\u0430 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435 \u0441\u044b\u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e? <span style=\"color: #ff0000;\">*<\/span> \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u0437\u0430\u0431\u0443\u0434\u0437\u0435, \u042f \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u043f\u0440\u0430 \u0446\u044f\u0431\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0430\u0446\u044c\u043a\u0430 \u043c\u043e\u0439 \u0456 \u043c\u0430\u044f \u043c\u0430\u0446\u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u0422\u044b, \u041f\u0430\u043d\u0435, \u043f\u0440\u044b\u043d\u044f\u045e \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u0437\u0430\u0431\u0443\u0434\u0437\u0435, \u042f \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u043f\u0440\u0430 \u0446\u044f\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"448","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">51, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u044b\u043d\u043e\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u041c\u044f\u043d\u0435 \u0432\u044b, \u0448\u0442\u043e \u0456\u043c\u043a\u043d\u0435\u0446\u0435\u0441\u044f \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0448\u0443\u043a\u0430\u0435\u0446\u0435 \u041f\u0430\u043d\u0430. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0441\u043a\u0430\u043b\u0443, \u0437 \u044f\u043a\u043e\u0439 \u0432\u044b\u0447\u0430\u0441\u0430\u043d\u044b \u0432\u044b, \u0456 \u043d\u0430 \u0433\u043b\u044b\u0431\u0456\u043d\u044e \u0440\u0432\u0430, \u0437 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u043a\u0430\u043f\u0430\u043b\u0456 \u0432\u0430\u0441. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u043e\u0434\u043a\u0430, \u0456 \u043d\u0430 \u0421\u0430\u0440\u0443, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0432\u0430\u0441. \u0411\u043e \u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u0430\u0434\u043d\u0430\u0433\u043e, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u041f\u0430\u043d \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u0421\u0456\u0451\u043d, \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u0443\u0441\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0440\u0443\u0456\u043d\u044b. \u042f\u0433\u043e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0401\u043d \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u044c \u0443 \u042d\u0434\u044d\u043d, \u0430 \u044f\u0433\u043e \u0441\u0442\u044d\u043f \u0441\u0442\u0430\u043d\u0435 \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0430\u0434 \u041f\u0430\u043d\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u0441\u0435\u043b\u043b\u0435, \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f \u0456 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u043c\u0443\u0437\u044b\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435, \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0441\u0445\u0456\u043b\u0456 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430, \u043b\u044e\u0434 \u041c\u043e\u0439. \u0411\u043e \u0430\u0434 \u041c\u044f\u043d\u0435 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437\u0430\u043a\u043e\u043d \u0456 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u041c\u0430\u0451 \u0441\u0442\u0430\u043d\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0411\u043b\u0456\u0437\u043a\u0430 \u041c\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u041c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041c\u0430\u044f \u0440\u0443\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b. \u0410\u0441\u0442\u0440\u0430\u0432\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u041c\u044f\u043d\u0435 \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u041c\u0430\u044e \u0440\u0443\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0432\u043e\u0447\u044b \u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u045e\u043d\u0456\u0437 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0431\u043e \u043d\u044f\u0431\u0451\u0441\u044b \u0440\u0430\u0441\u0441\u0435\u044e\u0446\u0446\u0430, \u044f\u043a \u0434\u044b\u043c, \u0430 \u0437\u044f\u043c\u043b\u044f \u0440\u0430\u0441\u043f\u0430\u0434\u0437\u0435\u0446\u0446\u0430, \u044f\u043a \u0448\u0430\u0442\u044b, \u0456 \u044f\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c, \u0431\u044b\u0446\u0446\u0430\u043c \u043c\u0443\u0445\u0456. \u0410\u043b\u0435 \u041c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430, \u0456 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u043d\u0435 \u041c\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u041c\u044f\u043d\u0435 \u0432\u044b, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u0430\u0440\u043e\u0434, \u0443 \u0441\u044d\u0440\u0446\u044b \u044f\u043a\u043e\u0433\u0430 \u041c\u043e\u0439 \u0437\u0430\u043a\u043e\u043d. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u0433\u0430\u043d\u044c\u0431\u044b \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u0456\u0445\u043d\u0456\u0445 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430\u045e. \u042f\u043a \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0456\u0445 \u043f\u0430\u0442\u043e\u0447\u044b\u0446\u044c \u043c\u043e\u043b\u044c, \u0456, \u044f\u043a \u0432\u043e\u045e\u043d\u0443, \u043f\u0430\u0436\u0440\u044d \u0456\u0445 \u0447\u0430\u0440\u0432\u044f\u043a. \u0410\u043b\u0435 \u041c\u0430\u044f \u043f\u0440\u0430\u045e\u0434\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456, \u0430 \u041c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 &ndash; \u0432\u0430 \u045e\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u0430\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u0430\u043f\u0440\u0430\u043d\u0456\u0441\u044f \u045e \u043c\u043e\u0446, \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430. \u041f\u0430\u045e\u0441\u0442\u0430\u043d\u044c, \u044f\u043a \u0443 \u0434\u0430\u045e\u043d\u0456\u044f \u0434\u043d\u0456, \u044f\u043a \u0437\u0430 \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456. \u0425\u0456\u0431\u0430 \u043d\u0435 \u0442\u044b \u043f\u0430\u0440\u0443\u0431\u0456\u043b\u0430 \u0420\u0430\u0445\u0430\u0431\u0430 \u043d\u0430 \u043a\u0430\u0432\u0430\u043b\u043a\u0456, \u0443\u0434\u0430\u0440\u044b\u043b\u0430 \u0446\u043c\u043e\u043a\u0430? \u0425\u0456\u0431\u0430 \u043d\u0435 \u0442\u044b \u0430\u0441\u0443\u0448\u044b\u043b\u0430 \u043c\u043e\u0440\u0430, \u0432\u043e\u0434\u044b \u0431\u0435\u0437\u0434\u0430\u043d\u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439, \u0437\u0440\u0430\u0431\u0456\u045e\u0448\u044b \u0437 \u043c\u0430\u0440\u0441\u043a\u0456\u0445 \u0433\u043b\u044b\u0431\u0456\u043d\u044f\u045e \u0434\u0430\u0440\u043e\u0433\u0443, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u0439\u0441\u0446\u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u041f\u0430\u043d\u0430\u043c \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u043d\u0430 \u0421\u0456\u0451\u043d \u0437 \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043c. \u0406 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0456\u0445 \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456. \u0406\u0445 \u0430\u0445\u043e\u043f\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u0441\u0435\u043b\u043b\u0435, \u0430 \u0441\u043c\u0443\u0442\u0430\u043a \u0456 \u0435\u043d\u043a\u0456 \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 51, 4. 5; 35, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435, \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0441\u0445\u0456\u043b\u0456 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430, \u043b\u044e\u0434 \u041c\u043e\u0439.<span style=\"color: #ff0000;\"> *<\/span> \u0411\u043b\u0456\u0437\u043a\u0430 \u041c\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u041c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u041f\u0430\u043d\u0430\u043c \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u043d\u0430 \u0421\u0456\u0451\u043d \u0437 \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0456\u0437\u043a\u0430 \u041c\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u041c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"449","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">51, 17 &ndash; 52, 1-2. 7-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0430\u0431\u0440\u0430\u0432\u0435\u0441\u0446\u0435 \u0434\u043b\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u0430\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u044c, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u044f\u043a\u0456 \u043f\u0456\u045e \u0437 \u0440\u0443\u043a\u0456 \u041f\u0430\u043d\u0430 \u043a\u0435\u043b\u0456\u0445 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443. \u0422\u044b \u0432\u044b\u043f\u0456\u045e \u043a\u0435\u043b\u0456\u0445 \u043f&rsquo;\u044f\u043d\u043b\u0456\u0432\u044b, \u0434\u0430 \u0434\u043d\u0430 \u044f\u0433\u043e \u0432\u044b\u043f\u0456\u045e. \u041d\u0435 \u0431\u044b\u043b\u043e \u043a\u0430\u043c\u0443 \u043f\u0440\u0430\u0432\u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e, \u044f\u043a\u0456\u0445 \u0451\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e; \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0430\u043c\u0443 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e, \u044f\u043a\u0456\u0445 \u0451\u043d \u0432\u044b\u0433\u0430\u0434\u0430\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435; \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u043b\u0430\u043a\u0430\u0446\u044c \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e? \u0417\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u044d\u043d\u043d\u0435, \u0433\u043e\u043b\u0430\u0434 \u0456 \u043c\u0435\u0447; \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c? \u0422\u0432\u0430\u0435 \u0441\u044b\u043d\u044b \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u044e\u0446\u044c, \u0431\u0435\u0437\u0434\u0430\u043f\u0430\u043c\u043e\u0436\u043d\u0430 \u043b\u044f\u0436\u0430\u0446\u044c \u043d\u0430 \u0440\u0430\u0433\u0430\u0445 \u0432\u0443\u043b\u0456\u0446, \u044f\u043a \u0430\u043d\u0442\u044b\u043b\u043e\u043f\u0430 \u045e \u0446\u044f\u043d\u0451\u0442\u0430\u0445, \u043f\u043e\u045e\u043d\u044b\u044f \u0433\u043d\u0435\u0432\u0443 \u041f\u0430\u043d\u0430, \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0433\u044d\u0442\u0430, \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0456 \u0430\u043f&rsquo;\u044f\u043d\u0435\u043b\u044b, \u0430\u043b\u0435 \u043d\u0435 \u0430\u0434 \u0432\u0456\u043d\u0430. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0442\u0432\u043e\u0439 \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u0442\u0432\u043e\u0439 \u041f\u0430\u043d \u0456 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434: &laquo;\u0412\u043e\u0441\u044c \u042f \u0437\u0430\u0431\u0456\u0440\u0430\u044e \u0437 \u0442\u0432\u0430\u0456\u0445 \u0440\u0443\u043a \u043f&rsquo;\u044f\u043d\u043b\u0456\u0432\u044b \u043a\u0435\u043b\u0456\u0445, \u043f\u0435\u043d\u0443 \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u041c\u0430\u0439\u0433\u043e \u0433\u043d\u0435\u0432\u0443. \u0422\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u044f\u0433\u043e \u043f\u0456\u0446\u044c. \u042f \u045e\u043a\u043b\u0430\u0434\u0443 \u044f\u0433\u043e \u045e \u0440\u0443\u043a\u0456 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u044f\u043a\u0456\u044f \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u0442\u0430\u0431\u0435: &ldquo;\u0421\u0445\u0456\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u043d\u0430\u043c \u043f\u0440\u0430\u0439\u0441\u0446\u0456 \u043f\u0430 \u0442\u0430\u0431\u0435&rdquo;, \u0430 \u0442\u044b \u043f\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0456\u043d\u0443, \u044f\u043a \u0437\u044f\u043c\u043b\u044e \u0456 \u044f\u043a \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u043b\u044f \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u0430\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u0430\u043f\u0440\u0430\u043d\u0456\u0441\u044f \u045e \u0441\u0432\u0430\u044e \u043c\u043e\u0446, \u0421\u0456\u0451\u043d. \u0410\u043f\u0440\u0430\u043d\u0456\u0441\u044f \u045e \u0448\u0430\u0442\u044b \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0441\u0432\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434. \u0411\u043e \u045e\u0436\u043e \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0446\u044f\u0431\u0435 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0442\u0440\u0430\u0441\u0456 \u0437 \u0441\u044f\u0431\u0435 \u043f\u044b\u043b, \u0443\u0441\u0442\u0430\u043d\u044c, \u043f\u0430\u043b\u043e\u043d\u043d\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u0420\u0430\u0437\u0432\u044f\u0436\u044b \u043f\u0443\u0442\u044b \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0448\u044b\u0456, \u043f\u0430\u043b\u043e\u043d\u043d\u0430\u044f \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456\u044f \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u043d\u043e\u0433\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u0430, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u0421\u0456\u0451\u043d\u0443: &laquo;\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0411\u043e\u0433 \u0442\u0432\u043e\u0439!&raquo; \u0413\u043e\u043b\u0430\u0441 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0442\u0432\u0430\u0456\u0445: \u044f\u043d\u044b \u045e\u0437\u043d\u044f\u043b\u0456 \u0433\u043e\u043b\u0430\u0441, \u0443\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c, \u0431\u043e \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b \u0431\u0430\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u041f\u0430\u043d \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0421\u0456\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044b\u0443\u043c\u0444\u0443\u0439\u0446\u0435, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u0440\u0430\u0437\u0430\u043c, \u0440\u0430\u0437\u0432\u0430\u043b\u0456\u043d\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0431\u043e \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u041f\u0430\u043d \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439, \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u041f\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u0432\u044f\u0442\u043e\u0435 \u043f\u043b\u044f\u0447\u043e \u0441\u0432\u0430\u0451 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e; \u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0443\u0441\u0435 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0417\u044b\u0445 19, 10. 11; \u0414\u0440\u0433 7, 15; \u0414\u0430\u043d 9, 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0441\u0432\u044f\u0442\u0430, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0431\u043e \u0437\u0430\u045e\u0442\u0440\u0430 \u0441\u044b\u0434\u0437\u0435 \u041f\u0430\u043d <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0437\u0430\u0431\u044f\u0440\u044d \u0430\u0434 \u0432\u0430\u0441 \u0443\u0441\u044f\u043a\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u045e\u0442\u0440\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 \u0437\u0430\u043f\u0430\u043d\u0443\u0435 \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437\u0430\u0431\u044f\u0440\u044d \u0430\u0434 \u0432\u0430\u0441 \u0443\u0441\u044f\u043a\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"450","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">\u0406\u0441 11, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0415\u0441\u044d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: &laquo;\u0412\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0437 \u043f\u043d\u044f \u0415\u0441\u044d\u0435\u0432\u0430\u0433\u0430, \u0456 \u0430\u0442\u043e\u0436\u044b\u043b\u0430\u043a \u0437 \u043a\u043e\u0440\u0430\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u043e\u0434; \u0456 \u0441\u043f\u0430\u0447\u043d\u0435 \u043d\u0430 \u0456\u043c \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0434\u0443\u0445 \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043c\u043e\u0446\u044b, \u0434\u0443\u0445 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0456 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0431\u043e\u044f\u0437\u0437\u044e \u041f\u0430\u043d\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u0437 \u043f\u043e\u0433\u043b\u044f\u0434\u0443 \u0432\u0430\u0447\u044d\u0439 \u0441\u0432\u0430\u0456\u0445, \u0456 \u043d\u0435 \u0441\u0430 \u0441\u043b\u044b\u0445\u0443 \u0432\u0443\u0448\u044d\u0439 \u0441\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0440\u044b\u0441\u0443\u0434 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435; \u0456 \u0436\u0430\u0437\u043b\u043e\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u0456 \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0431&rsquo;\u0435 \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0431\u0451\u0434\u0440\u0430\u0445 \u042f\u0433\u043e, \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c &ndash; \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0432\u043e\u045e\u043a \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043d\u0451\u043c, \u0456 \u043b\u0435\u0430\u043f\u0430\u0440\u0434 \u0440\u0430\u0437\u0430\u043c \u0437 \u043a\u0430\u0437\u043b\u044f\u043d\u0451\u043c \u0431\u0443\u0434\u0437\u0435 \u043b\u044f\u0436\u0430\u0446\u044c; \u0456 \u0446\u044f\u043b\u044f, \u0456 \u043c\u0430\u043b\u0430\u0434\u044b \u043b\u0435\u045e, \u0456 \u0432\u043e\u043b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c, \u0430 \u043c\u0430\u043b\u044b \u0445\u043b\u043e\u043f\u0447\u044b\u043a \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0433\u0430\u043d\u044f\u0446\u044c \u0456\u0445. \u0406 \u043a\u0430\u0440\u043e\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043c\u044f\u0434\u0437\u0432\u0435\u0434\u0437\u0456\u0446\u0430\u0439, \u0456 \u0434\u0437\u0435\u0446\u0456 \u0456\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u044f\u0436\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c, \u0456 \u043b\u0435\u045e, \u044f\u043a \u0432\u043e\u043b, \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u0441\u0430\u043b\u043e\u043c\u0443. \u0406 \u043d\u0435\u043c\u0430\u045e\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0433\u0443\u043b\u044f\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u044e \u0430\u0441\u043f\u0456\u0434\u0430, \u0456 \u0434\u0437\u0456\u0446\u044f \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u0433\u043d\u044f\u0437\u0434\u0430 \u0433\u0430\u0434\u0437\u044e\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0456 \u0437\u043b\u0430, \u043d\u0456 \u0448\u043a\u043e\u0434\u044b \u043d\u0430 \u045e\u0441\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u041c\u0430\u0451\u0439, \u0431\u043e \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0437\u044f\u043c\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u041f\u0430\u043d\u0430, \u044f\u043a \u0432\u043e\u0434\u0430\u043c\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0431\u0443\u0434\u0437\u0435 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c: \u043a\u043e\u0440\u0430\u043d\u044c \u0415\u0441\u044d\u044f, \u0448\u0442\u043e \u0441\u0442\u0430\u043d\u0435 \u0448\u0442\u0430\u043d\u0434\u0430\u0440\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u044f\u0437\u044b\u0447&shy;\u043d\u0456\u043a\u0456, \u0456 \u0441\u0442\u0430\u043d\u0435 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u0447\u044b\u043d\u043a\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u0430\u0434 \u0414\u0437\u0435\u0432\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u041a\u0430\u0440\u043e\u043b\u044c, <span style=\"color: #ff0000;\">&dagger;<\/span> \u043a\u0430\u0431 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0420\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0432\u043e\u0439\u0441\u043a\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, <span style=\"color: #ff0000;\">\/<\/span> \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0440\u043e\u0434\u0443 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0411\u043e\u0433\u0443, \u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0432\u043e\u0439\u0441\u043a\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, <span style=\"color: #ff0000;\">\/<\/span> \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0440\u043e\u0434\u0443 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"451","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">5, 21 &ndash; 6, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u044f\u043c&rsquo;\u0456<\/span><\/em><\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u045e \u0431\u043e\u044f\u0437\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u043e\u043d\u043a\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u043c\u0443\u0436\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u044f\u043a \u041f\u0430\u043d\u0443, \u0431\u043e \u043c\u0443\u0436 &ndash; \u0433\u0430\u043b\u0430\u0432\u0430 \u0436\u043e\u043d\u043a\u0456, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0413\u0430\u043b\u0430\u0432\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0401\u043d &ndash; \u0417\u0431\u0430\u045e\u0446\u0430 \u0446\u0435\u043b\u0430. \u0422\u0430\u043c\u0443, \u044f\u043a \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443, \u0442\u0430\u043a \u0456 \u0436\u043e\u043d\u043a\u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u043c\u0443\u0436\u0430\u043c \u0432\u0430 \u045e\u0441\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0436\u044b, \u043b\u044e\u0431\u0456\u0446\u0435 \u0441\u0432\u0430\u0456\u0445 \u0436\u043e\u043d\u0430\u043a, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u044f\u0433\u043e, \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u044f\u0433\u043e, \u0430\u0447\u044b\u0441\u0446\u0456\u045e\u0448\u044b \u043a\u0443\u043f\u0435\u043b\u043b\u044e \u0432\u0430\u0434\u044b \u045e \u0441\u043b\u043e\u0432\u0435, \u043a\u0430\u0431 \u0451\u043d \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0430\u0435 \u043f\u043b\u044f\u043c\u044b, \u0446\u0456 \u0437\u0430\u0433\u0430\u043d\u044b, \u0446\u0456 \u0447\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430, \u0456 \u043a\u0430\u0431 \u0451\u043d \u0431\u044b\u045e \u0441\u0432\u044f\u0442\u044b \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043c\u0443\u0436\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0436\u043e\u043d\u0430\u043a, \u044f\u043a \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430. \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0436\u043e\u043d\u043a\u0443, \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0411\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043c\u0435\u045e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u0456 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u044f\u0433\u043e, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b; \u0431\u043e \u043c\u044b \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u0456\u043d\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u0430 \u0431\u0430\u0446\u044c\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u0456 \u0437\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0437 \u0436\u043e\u043d\u043a\u0430\u0439 \u0441\u0432\u0430\u0451\u0439, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0432\u043e\u0435 \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0430\u043c. \u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0433\u044d\u0442\u0430\u044f, \u0430 \u043a\u0430\u0436\u0443 \u044f \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0436\u043e\u043d\u043a\u0443 \u0442\u0430\u043a, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0430 \u0436\u043e\u043d\u043a\u0430 \u043d\u044f\u0445\u0430\u0439 \u0448\u0430\u043d\u0443\u0435 \u043c\u0443\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456, \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443 \u0441\u0432\u0430\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0431\u043e \u0433\u044d\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0428\u0430\u043d\u0443\u0439 \u0431\u0430\u0446\u044c\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u043b\u043e \u0442\u0430\u0431\u0435 \u0456 \u043a\u0430\u0431 \u0434\u043e\u045e\u0433\u0430 \u0436\u044b\u045e \u0442\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b, \u0431\u0430\u0446\u044c\u043a\u0456, \u043d\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u043d\u044f\u0439\u0446\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0432\u0430\u0448\u044b\u0445, \u0430\u043b\u0435 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0456\u0445 \u043f\u0440\u0430\u0437 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 6, 1-2. 3; \u041b\u043a 2, 51<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u0446\u0456, \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443 \u0441\u0432\u0430\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0431\u043e \u0433\u044d\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0428\u0430\u043d\u0443\u0439 \u0431\u0430\u0446\u044c\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041fa\u0439\u0448o\u045e\u0448\u044b \u0437 \u041c\u0430\u0440\u044b\u044f\u0439 \u0456 \u042e\u0437\u0430\u0444\u0430\u043c, \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u0431\u044b\u045e \u0443 \u041da\u0437a\u0440\u044d\u0442 i \u0431\u044b\u045e i\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0430\u043d\u0443\u0439 \u0431\u0430\u0446\u044c\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"455","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 1-14<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0437\u044f\u043a\u0430 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u043b, \u0437 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0431\u0440\u0430\u0442 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 &ndash; \u0441\u0432\u044f\u0442\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u044f\u043a\u0456\u044f \u045e \u041a\u0430\u043b\u043e\u0441\u0430\u0445: \u043b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0437\u0430 \u0432\u0430\u0441, \u0431\u043e \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u0456 \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u0446\u0435 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0434\u0437\u0435\u0456, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430 \u0434\u043b\u044f \u0432\u0430\u0441 \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u0412\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u044f\u0435 \u0440\u0430\u043d\u0435\u0439 \u0443 \u0441\u043b\u043e\u0432\u0435 \u043f\u0440\u0430\u045e\u0434\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0434\u0430 \u0432\u0430\u0441. \u0406 \u044f\u043a \u044f\u043d\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d \u0456 \u0440\u0430\u0441\u0446\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u0442\u0430\u043a \u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0437 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0412\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0433\u044d\u0442\u0430\u043c\u0443 \u0430\u0434 \u042d\u043f\u0430\u0444\u0440\u0430\u0441\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430, \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u043b\u044f \u0432\u0430\u0441, \u044f\u043a\u0456 \u0456 \u0432\u044b\u044f\u0432\u0456\u045e \u043d\u0430\u043c \u0432\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0443 \u0414\u0443\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0432\u0430\u0441, \u043c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0456 \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439 \u0432\u0430 \u045e\u0441\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0456; \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u0433\u043e\u0434\u043d\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0456\u0441\u044f \u042f\u043c\u0443, \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u043f\u043b\u0451\u043d \u0432\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0411\u043e\u0433\u0430; \u043a\u0430\u0431 \u0432\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u045e\u0441\u0451\u044e \u0441\u0456\u043b\u0430\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u043e\u0446\u044b \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0434\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u0439 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456 \u0456 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043c\u044b \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443, \u044f\u043a\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437&shy;\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 1, 12. 13; \u042f\u043a 1, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443,<span style=\"color: #ff0000;\"> *<\/span> \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437&shy;\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0434\u0430\u0440 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0432\u044b\u0448, \u0430\u0434 \u0410\u0439\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437&shy;\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_1_ID":"456","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 15 &ndash; 2, 3<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0413\u0430\u043b\u0430\u0432\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430; \u041f\u0430\u0432\u0435\u043b, \u0441\u043b\u0443\u0433\u0430 \u042f\u0433\u043e\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0411\u043e \u045e \u0406\u043c \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0431\u0430\u0447\u043d\u0430\u0435 \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435: \u0446\u0456 \u0442\u0440\u043e\u043d\u044b, \u0446\u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456, \u0446\u0456 \u043d\u0430\u0447\u0430\u043b\u044c\u0441\u0442\u0432\u044b, \u0446\u0456 \u045e\u043b\u0430\u0434\u044b &ndash; \u0443\u0441\u0451 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0456 \u0434\u043b\u044f \u042f\u0433\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430. \u0401\u043d \u0451\u0441\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0437\u0430 \u045e\u0441\u0451, \u0456 \u045e\u0441\u0451 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d &ndash; \u0413\u0430\u043b\u0430\u0432\u0430 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0401\u043d &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u0401\u043d \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e. \u0411\u043e \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0410\u0439\u0446\u0443, \u043a\u0430\u0431 \u0443 \u0406\u043c \u0436\u044b\u043b\u0430 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0456 \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u045e\u0441\u0451, \u0456 \u0437\u044f\u043c\u043d\u043e\u0435, \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435, \u0443\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u045e\u0448\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0432\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0456 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u0430\u0456\u0445 \u0431\u043b\u0430\u0433\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0411\u043e\u0433 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0432\u0430\u0441 \u0443 \u0446\u0435\u043b\u0435 \u043f\u043b\u043e\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0433\u0440\u0443\u043d\u0442\u043e\u045e\u043d\u0430 \u0456 \u0446\u0432\u0451\u0440\u0434\u0430 \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u0432\u0435\u0440\u044b \u0456 \u043d\u0435 \u0434\u0430\u0435\u0446\u0435 \u0430\u0434\u0432\u0435\u0441\u0446\u0456 \u0441\u044f\u0431\u0435 \u0430\u0434 \u043d\u0430\u0434\u0437\u0435\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0447\u0443\u043b\u0456 \u0456 \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u045e\u0441\u044f\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u0441\u043b\u0443\u0433\u043e\u044e \u044f\u043a\u043e\u0433\u0430 \u0441\u0442\u0430\u045e \u044f, \u041f\u0430\u0432\u0435\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u044f \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0437\u0430 \u0432\u0430\u0441 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u044e \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0443 \u043c\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0441\u043b\u0443\u0433\u043e\u044e \u044f\u043a\u043e\u0433\u0430 \u044f \u0441\u0442\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043c\u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u0411\u043e\u0436\u0430\u0433\u0430 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u0441\u0445\u0430\u0432\u0430\u043d\u0443\u044e \u0430\u0434 \u0432\u044f\u043a\u043e\u045e \u0456 \u0430\u0434 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u044f\u043a\u0430\u044f \u0446\u044f\u043f\u0435\u0440 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u042f\u0433\u043e\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u044b\u043c. \u0406\u043c \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u043b\u0430\u0432\u044b \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0433\u044d\u0442\u0430\u0439, \u044f\u043a\u043e\u044e \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 &ndash; \u043d\u0430\u0434\u0437\u0435\u044f \u0441\u043b\u0430\u0432\u044b. \u042f\u0433\u043e \u043c\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435\u043c, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f \u0456 \u043f\u0440\u0430\u0446\u0443\u044e, \u0437\u043c\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f \u043c\u043e\u0446\u0430\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u044f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u044f\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u044f \u0432\u044f\u0434\u0443 \u0437\u0430 \u0432\u0430\u0441 \u0456 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u043c\u044f\u043d\u0435 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u043d\u044b \u0441\u044d\u0440\u0446\u044b \u0456\u0445\u043d\u0456\u044f \u0456 \u0437\u043b\u0443\u0447\u0430\u043d\u044b \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0437\u0435\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0411\u043e\u0433\u0430, \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u044f\u043a\u0456\u043c \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 1, 18. 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0413\u0430\u043b\u0430\u0432\u0430 \u0446\u0435\u043b\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0435\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0451\u0441\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0437\u0430 \u045e\u0441\u0451, \u0456 \u045e\u0441\u0451 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u045e \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0435\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e.<\/p>\r\n"}, {"GCH_CH_1_ID":"457","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 4-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u042f \u043a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u045e\u0441\u044f \u0437\u043c\u0430\u043d\u0443 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e. \u0411\u043e \u0445\u043e\u0446\u044c \u044f \u0456 \u0430\u0434\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u044e \u0446\u0435\u043b\u0430\u043c, \u0430\u043b\u0435 \u045e \u0434\u0443\u0445\u0443 \u044f \u0437 \u0432\u0430\u043c\u0456 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0431\u0430\u0447\u0443 \u0432\u0430\u0448 \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0456 \u0446\u0432\u0451\u0440\u0434\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u045e \u0406\u043c, \u0443\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u044b\u044f \u0456 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0406\u043c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0432\u0435\u0440\u0430\u044e, \u044f\u043a \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456 \u0432\u0430\u0441, \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e. <br \/>\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0445\u0430\u043f\u0456\u045e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043b\u043e\u043d \u0444\u0456\u043b\u0430\u0441\u043e\u0444\u0456\u044f\u0439 \u0456 \u043c\u0430\u0440\u043d\u044b\u043c \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u045e \u0441\u0432\u0435\u0442\u0443, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/>\u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u045e \u0406\u043c \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456, \u0456 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u045e \u0406\u043c, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u043e\u044e \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u045e\u043b\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0406\u043c \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435\u043c, \u043a\u0430\u043b\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430 \u0437\u043d\u044f\u043b\u043e \u0437 \u0432\u0430\u0441 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430. \u041f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0445\u0440\u043e\u0441\u0446\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0406\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u0430\u0441, \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u043f\u0440\u0430\u0437 \u0433\u0440\u0430\u0445\u0456 \u0456 \u043d\u0435\u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0446\u0435\u043b\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0401\u043d \u0430\u0436\u044b\u0432\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u0434\u0430\u0440\u0430\u0432\u0430\u045e\u0448\u044b \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456. \u0401\u043d \u0441\u0446\u0451\u0440 \u0437\u0430\u043f\u0456\u0441 \u043d\u0430\u0448\u044b\u0445 \u0434\u0430\u045e\u0433\u043e\u045e \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e, \u043f\u0440\u044b\u0431\u0456\u045e\u0448\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430. \u0420\u0430\u0437\u0437\u0431\u0440\u043e\u0456\u045e\u0448\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u045e\u043b\u0430\u0434\u044b, \u0401\u043d \u0432\u044b\u0441\u0442\u0430\u0432\u0456\u045e \u0456\u0445 \u043d\u0430 \u0441\u043c\u0435\u0445, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u0456\u0445 \u0443 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 2, 9. 10. 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u0436\u044b\u0432\u0435 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0451\u0441\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u043e\u044e \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u045e\u043b\u0430\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0445\u0440\u043e\u0441\u0446\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u043c\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0406\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0451\u0441\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u043e\u044e \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u045e\u043b\u0430\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"458","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">2, 9-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044b \u0431\u0430\u0447\u044b\u043c \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u043c\u0430\u043b\u0430 \u043c\u0435\u043d\u0448\u044b \u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u045e, \u0443\u0432\u0435\u043d\u0447\u0430\u043d\u044b \u0441\u043b\u0430\u0432\u0430\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e, \u0431\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u0437 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456.<br \/>\u0411\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u0456 \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451, \u044f\u043a\u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0443\u0447\u044b&shy;\u043d\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456\u0445\u043d\u044f\u0433\u0430. \u0411\u043e \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u0435, \u0456 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c, &ndash; \u0443\u0441\u0435 \u0430\u0434 \u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430. \u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0401\u043d \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0456\u0445 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0443 \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0441\u0445\u043e\u0434\u0443 \u044f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e \u0426\u044f\u0431\u0435&raquo;. \u0406 \u044f\u0448\u0447\u044d: &laquo;\u042f \u0431\u0443\u0434\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u044f\u0433\u043e&raquo;. \u0406 \u0437\u043d\u043e\u045e: &laquo;\u0412\u043e\u0441\u044c \u044f \u0456 \u0434\u0437\u0435\u0446\u0456, \u044f\u043a\u0456\u0445 \u0434\u0430\u045e \u043c\u043d\u0435 \u0411\u043e\u0433&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u0446\u0456 \u043c\u0430\u044e\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0446\u0435\u043b\u0435 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0442\u0430\u043c\u0443 \u045e \u0456\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u045e \u0443\u0434\u0437\u0435\u043b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0415\u0437\u0443\u0441, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0456\u0437\u0440\u044b\u043d\u0443\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434&rsquo;\u044f\u0431\u043b\u0430, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u045e \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e. \u0411\u043e, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0401\u043d \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0435 \u0430\u043d\u0451\u043b\u0430\u043c, \u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u0422\u0430\u043c\u0443 \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0411\u043e\u0436\u044b\u0445 \u0434\u043b\u044f \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b, \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f, \u044f\u043a\u0430\u044f \u043d\u0430\u0441\u0456\u043b\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0441\u0432\u0435\u0442\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0426\u044f\u0431\u0435, \u0456 \u043d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0448\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0456\u0442\u0430\u0439, \u041c\u0430\u0440\u044b\u044f, \u043f\u043e\u045e\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0456, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0426\u044f\u0431\u0435, \u0456 \u043d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0448\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"460","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 16 &ndash; 3, 4<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0435 \u0432\u0430\u0441 \u0437\u0430 \u0435\u0436\u0443, \u043f\u0456\u0446&shy;\u0446\u0451 \u0430\u0431\u043e \u0441\u0432\u044f\u0442\u044b, \u0430\u0431\u043e \u0430\u0434\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a\u0430 \u0446\u0456 \u0448\u0430\u0431\u0430\u0442\u0430\u045e. \u0413\u044d\u0442\u0430 \u0446\u0435\u043d\u044c \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0440\u044d\u0447\u0430\u045e. \u0426\u0435\u043b\u0430 \u0436 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u045e \u0441\u0430\u043c\u0430\u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0456 \u0430\u043d\u0451\u043b\u0430\u043c, \u0445\u0442\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u045e, \u043c\u0430\u0440\u043d\u0430 \u0440\u0430\u0437\u0434\u0437\u0456\u043c\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u043c \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0430\u043b\u0435 \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0413\u0430\u043b\u0430\u0432\u044b. \u0410\u0434 \u044f\u0435 \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u043c\u0456 \u0456 \u0441\u0443\u0445\u0430\u0436\u044b\u043b\u043b\u044f\u043c\u0456, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u0440\u043e\u0441\u0442\u0430\u043c \u0411\u043e\u0436\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u043b\u044f \u0441\u0442\u044b\u0445\u0456\u044f\u045e \u0441\u0432\u0435\u0442\u0443, \u0447\u0430\u043c\u0443 \u0432\u044b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0435\u0441\u044f \u043f\u0440\u0430\u0432\u0456\u043b\u0430\u043c, \u043d\u0456\u0431\u044b \u044f\u0448\u0447\u044d \u0436\u044b\u0432\u044f\u0446\u0435 \u045e \u0441\u0432\u0435\u0446\u0435? &laquo;\u041d\u0435 \u0447\u0430\u043f\u0430\u0439, \u043d\u0435 \u043a\u0430\u0448\u0442\u0443\u0439, \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0439\u0441\u044f&raquo; &ndash; \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0434\u0430 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u043f\u0440\u0430\u0432\u0456\u043b \u0456 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0441\u0430\u043c\u0430\u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044e \u0456 \u0441\u0443\u0440\u043e\u0432\u0430\u0439 \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u0435 \u0446\u0435\u043b\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0432\u0430\u0440\u0442\u0430\u0441\u0446\u0456 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0441\u044b\u0442\u0430\u0441\u0446\u0456 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430; \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0431\u043e \u0432\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041a\u043b\u0441 3, 1-2; \u041b\u043a 12, 34<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435 \u0441\u043a\u0430\u0440\u0431 \u0432\u0430\u0448, \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0456 \u0441\u044d\u0440\u0446\u0430 \u0432\u0430\u0448\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"461","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">3, 5-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0416\u044b\u0446\u0446\u0451 \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0417\u0440\u0430\u0431\u0456\u0446\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435 \u045e \u0446\u0435\u043b\u0435 \u0432\u0430\u0448\u044b\u043c: \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0441\u0442\u0440\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0456 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430\u043c. \u0417-\u0437\u0430 \u0433\u044d\u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0433\u043d\u0435\u045e \u0411\u043e\u0436\u044b \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u044b\u043d\u043e\u045e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u0456 \u0432\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0445\u0430\u0434\u0437\u0456\u043b\u0456, \u043a\u0430\u043b\u0456 \u0436\u044b\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u0456 \u0432\u044b \u0430\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0433\u044d\u0442\u0430 \u045e\u0441\u0451: \u0433\u043d\u0435\u045e, \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435, \u0437\u043b\u043e\u0441\u0446\u044c, \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430, \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u0435 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0432\u0430\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0445\u043b\u0443\u0441\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u0431\u043e \u0432\u044b \u0437\u043d\u044f\u043b\u0456 \u0437 \u0441\u044f\u0431\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u043d\u043e\u0432\u0430\u0433\u0430, \u044f\u043a\u0456 \u0430\u0431\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e. \u0406 \u0442\u0443\u0442 \u0443\u0436\u043e \u043d\u044f\u043c\u0430 \u043d\u0456 \u0433\u0440\u044d\u043a\u0430, \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u043d\u0456 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u043d\u0456 \u0432\u0430\u0440\u0432\u0430\u0440\u0430, \u043d\u0456 \u0441\u043a\u0456\u0444\u0430, \u043d\u0456 \u0440\u0430\u0431\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0436 \u044f\u043a \u0432\u044b\u0431\u0440\u0430\u043d\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u0432\u044f\u0442\u044b\u044f \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0443 \u0448\u0447\u044b\u0440\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u043f\u0430\u043a\u043e\u0440\u0443, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0434\u0430\u0440\u0443\u044e\u0447\u044b \u0441\u0430\u0431\u0435 \u045e\u0437\u0430\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0430 \u043a\u0430\u0433\u043e \u043c\u0430\u0435 \u043a\u0440\u044b\u045e\u0434\u0443; \u044f\u043a \u041f\u0430\u043d \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0432\u0430\u043c, \u0442\u0430\u043a \u0456 \u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0430\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0406 \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0441\u043f\u0430\u043a\u043e\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0406 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456. \u0421\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441 \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0446\u0435, \u0437 \u0443\u0441\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u043c\u0456, \u0433\u0456\u043c\u043d\u0430\u043c\u0456 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u043f\u0435\u0441\u043d\u044f\u043c\u0456, \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 3, 27-28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u043c\u044b, \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0448\u044b\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u045e\u0441\u0435 \u043c\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u043c\u0430 \u045e\u0436\u043e \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0433\u0440\u044d\u043a\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u0440\u0430\u0431\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u043d\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0441\u0435 \u043c\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"462","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">3, 17 &ndash; 4, 1<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0416\u044b\u0446\u0446\u0451 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0441\u044f\u043c&rsquo;\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0423\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0456 \u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c, \u0443\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u043e\u043d\u043a\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u043c\u0443\u0436\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0443 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0436\u044b, \u043a\u0430\u0445\u0430\u0439\u0446\u0435 \u0436\u043e\u043d\u0430\u043a \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0443\u0440\u043e\u0432\u044b\u043c\u0456 \u0434\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u0432\u0430\u0448\u044b\u043c \u0432\u0430 \u045e\u0441\u0456\u043c, \u0431\u043e \u0433\u044d\u0442\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0439\u0446\u044b, \u043d\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u043d\u044f\u0439\u0446\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0432\u0430\u0448\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0434\u0430\u043b\u0456 \u0434\u0443\u0445\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0433\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0430\u0456\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u043d\u0435 \u0441\u043b\u0443\u0436\u0430\u0447\u044b \u0456\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u043d\u0456\u0431\u044b \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430\u043b\u0435 \u0430\u0434 \u0448\u0447\u044b\u0440\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u041f\u0430\u043d\u0430. \u0406 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456, \u0440\u0430\u0431\u0456\u0446\u0435 \u0430\u0434 \u0434\u0443\u0448\u044b, \u044f\u043a \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0430 \u043d\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0430\u0434 \u041f\u0430\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0432\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0421\u043b\u0443\u0436\u044b\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0443 \u041f\u0430\u043d\u0443. \u0411\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u0443, \u0440\u0430\u0441\u043f\u043b\u0430\u0446\u0456\u0446\u0446\u0430 \u0437\u0430 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0443\u044e \u043a\u0440\u044b\u045e\u0434\u0443, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u044b, \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0439\u0446\u0435 \u0441\u043b\u0443\u0433\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u0441\u043b\u0443\u0448\u043d\u0430, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0456 \u0432\u044b \u043c\u0430\u0435\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u045e \u043d\u0435\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0456 \u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"463","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 2-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0417\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0447\u0443\u0432\u0430\u044e\u0447\u044b \u043d\u0430 \u0451\u0439 \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0456 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0430\u0434\u0447\u044b\u043d\u0456\u045e \u0432\u0430\u043c \u0434\u0437\u0432\u0435\u0440\u044b \u0441\u043b\u043e\u0432\u0430 \u0434\u043b\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0439 \u044f \u0456 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b, \u043a\u0430\u0431 \u044f \u0430\u0434\u043a\u0440\u044b\u045e \u044f\u0435 \u0442\u0430\u043a, \u044f\u043a \u043c\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0434\u0440\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0441\u044f\u0431\u0435 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0432\u043e\u043d\u043a\u0443, \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u0433\u043e\u0434\u0443. \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u0430 \u043c\u043e\u0432\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0439, \u043f\u0440\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u0430\u0439 \u0441\u043e\u043b\u043b\u044e, \u043d\u0456\u0431\u044b \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u043c\u044f\u043d\u0435 \u045e\u0441\u0451 \u0440\u0430\u0441\u043a\u0430\u0436\u0430 \u0432\u0430\u043c \u0422\u044b\u0445\u0456\u043a, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0431\u0440\u0430\u0442 \u043c\u043e\u0439, \u0432\u0435\u0440\u043d\u044b \u0441\u043b\u0443\u0433\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a \u0443 \u041f\u0430\u043d\u0443. \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e \u0434\u0430 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u043d\u0430\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u044b\u045e \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0456 \u0410\u043d\u044d\u0437\u0456\u043c\u0430, \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430, \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0432\u0430\u0441. \u042f\u043d\u044b \u0440\u0430\u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0432\u0430\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u0442\u0443\u0442 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0410\u0440\u044b\u0441\u0442\u0430\u0440\u0445, \u043c\u043e\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a \u043f\u0430 \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u0456 \u041c\u0430\u0440\u043a, \u0441\u0442\u0440\u044b\u0435\u0447\u043d\u044b \u0431\u0440\u0430\u0442 \u0411\u0430\u0440\u043d\u0430\u0431\u044b (\u043d\u0430\u043a\u043e\u043d\u0442 \u044f\u0433\u043e \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0430\u043a\u0430\u0437\u044b; \u043a\u0430\u043b\u0456 \u0451\u043d \u0437\u0430\u0445\u043e\u0447\u0430 \u0434\u0430 \u0432\u0430\u0441, \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u044f\u0433\u043e), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0415\u0437\u0443\u0441, \u044f\u043a\u043e\u0433\u0430 \u0437\u0430\u0432\u0443\u0446\u044c \u042e\u0441\u0442\u0430\u043c. \u042f\u043d\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445. \u0411\u0443\u0434\u0443\u0447\u044b \u043c\u0430\u0456\u043c\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u043c\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u045e \u0441\u043f\u0440\u0430\u0432\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u0442\u0430\u0435 \u0432\u0430\u0441 \u042d\u043f\u0430\u0444\u0440\u0430\u0441, \u0448\u0442\u043e \u0437 \u0432\u0430\u0448\u0430\u0433\u0430 \u043b\u0456\u043a\u0443, \u0432\u044f\u0437\u0435\u043d\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0432\u0430\u0441 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445, \u043a\u0430\u0431 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u044e \u0411\u043e\u0436\u0430\u044e \u0432\u043e\u043b\u044f\u044e. \u042f \u0441\u0432\u0435\u0434\u0447\u0443 \u043f\u0440\u0430 \u044f\u0433\u043e, \u0448\u0442\u043e \u0451\u043d \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0432\u0430\u0441, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0456 \u0456 \u0413\u0456\u0435\u0440\u0430\u043f\u0430\u043b\u0456. \u0412\u0456\u0442\u0430\u0435 \u0432\u0430\u0441 \u041b\u0443\u043a\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u043b\u0435\u043a\u0430\u0440, \u0456 \u0414\u044d\u043c\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u0439\u0446\u0435 \u0431\u0440\u0430\u0442\u043e\u045e \u043c\u0430\u0456\u0445 \u0443 \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0456 \u0456 \u041d\u0456\u043c\u0444\u0430\u043d\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0441\u0446\u0451\u043b, \u0448\u0442\u043e \u045e \u0434\u043e\u043c\u0435 \u044f\u0433\u043e\u043d\u044b\u043c. \u041a\u0430\u043b\u0456 \u045e \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043d\u044b \u0433\u044d\u0442\u044b \u043b\u0456\u0441\u0442, \u0442\u043e \u0437\u0440\u0430\u0431\u0456\u0446\u0435, \u043a\u0430\u0431 \u044f\u0433\u043e \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043b\u0456 \u0456 \u045e \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0439\u0441\u043a\u0456\u043c \u043a\u0430\u0441\u0446\u0451\u043b\u0435, \u0430 \u0442\u043e\u0439, \u0448\u0442\u043e \u0437 \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0456, \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0439\u0446\u0435 \u0456 \u0432\u044b. \u0406 \u0441\u043a\u0430\u0436\u044b\u0446\u0435 \u0410\u0440\u0445\u0456\u043f\u0443: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u041f\u0430\u043d\u0430&raquo;.&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043c\u0430\u0451, \u041f\u0430\u045e\u043b\u0430, \u0443\u043b\u0430\u0441\u043d\u0430\u0440\u0443\u0447\u043d\u0430\u0435 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435. \u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u043c\u0430\u0435 \u043a\u0430\u0439\u0434\u0430\u043d\u044b. \u041b\u0430\u0441\u043a\u0430 \u0437 \u0432\u0430\u043c\u0456.&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 4, 3; \u043f\u0430\u0440. \u041f\u0441 51 (50), 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0456 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0430\u0434\u0447\u044b\u043d\u0456\u045e \u0432\u0430\u043c \u0434\u0437\u0432\u0435\u0440\u044b \u0441\u043b\u043e\u0432\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0434\u043b\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u0435 \u043d\u0430\u0448\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u0456 \u043d\u0430\u0448 \u044f\u0437\u044b\u043a \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043b\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"464","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">42, 1-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u043b\u0443\u0433\u0430 \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u042f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u044e, \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041c\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430 \u0434\u0443\u0448\u0430 \u041c\u0430\u044f. \u042f \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u042f\u0433\u043e; \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0442\u043d\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e. \u0401\u043d \u043d\u0435 \u0437\u043b\u043e\u043c\u0456\u0446\u044c \u043d\u0430\u0434\u043b\u043e\u043c\u043b\u0435\u043d\u0430\u0439 \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u044b \u0456 \u043d\u0435 \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u0442\u043b\u0435\u044e\u0447\u0430\u0433\u0430 \u043a\u043d\u043e\u0442\u0443; \u0434\u043b\u044f \u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0401\u043d \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435. \u041d\u0435 \u0430\u0441\u043b\u0430\u0431\u043d\u0435 \u0456 \u043d\u0435 \u043d\u0430\u0434\u043b\u043e\u043c\u0456\u0446\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0430\u0441\u0442\u0440\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u0443, \u044f\u043a\u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u044f\u0435, \u0456 \u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043d\u0430 \u0451\u0439, \u0456 \u0434\u0443\u0445 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430 \u0451\u0439 \u0445\u043e\u0434\u0437\u0456\u0446\u044c: &laquo;\u042f, \u041f\u0430\u043d, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0426\u044f\u0431\u0435 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u045e\u0437\u044f\u045e \u0426\u044f\u0431\u0435 \u0437\u0430 \u0440\u0443\u043a\u0443 \u0456 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0426\u044f\u0431\u0435, \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0430\u0431 \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u045e \u0432\u043e\u0447\u044b \u0441\u043b\u044f\u043f\u044b\u043c \u0456 \u0437 \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u0432\u044b\u0432\u0435\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445, \u0437 \u0434\u043e\u043c\u0443 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u043d\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f &ndash; \u041f\u0430\u043d, \u0433\u044d\u0442\u0430 \u0456\u043c\u044f \u041c\u0430\u0451. \u042f \u043d\u0435 \u0430\u0434\u0434\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0456\u043d\u0448\u0430\u043c\u0443, \u0430 \u0456\u0434\u0430\u043b\u0430\u043c &ndash; \u0441\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 12, 18. 21 (\u0406\u0441 42, 1)<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u042f \u0432\u044b\u0431\u0440\u0430\u045e, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u041c\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430 \u0434\u0443\u0448\u0430 \u041c\u0430\u044f.<span style=\"color: #ff0000;\"> *<\/span> \u0406 \u045e \u0456\u043c\u0435\u043d\u0456 \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u043a\u043b\u0430\u0434\u0443 \u0434\u0443\u0445 \u041c\u043e\u0439 \u043d\u0430 \u042f\u0433\u043e, \u0430 \u0401\u043d \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e \u0456\u043c\u0435\u043d\u0456 \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"465","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">61, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u043d\u0430 \u0441\u043b\u0443\u0433\u0443 \u042f\u0433\u043e\u043d\u044b\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u043c\u043d\u0435, \u0431\u043e \u041f\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c. \u041f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443; \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0433\u043e\u0434 \u043b\u0430\u0441\u043a\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u043e\u043c\u0441\u0442\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430; \u043a\u0430\u0431 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0456\u043c \u0432\u044f\u043d\u043e\u043a \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u043e\u043f\u0435\u043b\u0443, \u0430\u043b\u0435\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u0443\u043c\u0443, \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0445\u0432\u0430\u043b\u044b \u0437\u0430\u043c\u0435\u0441\u0442 \u0434\u0443\u0445\u0430 \u043c\u0430\u0440\u043a\u043e\u0442\u044b. \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0456\u0445 \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u0434\u0440\u044d\u0432\u0430\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0430\u0434\u0436\u0430\u043d\u0446\u0430\u043c\u0456 \u041f\u0430\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f\u043d\u044b \u0437\u0430\u0431\u0443\u0434\u0443\u044e\u0446\u044c \u0441\u0442\u0430\u0440\u044b\u044f \u0440\u0443\u0456\u043d\u044b, \u0443\u0437\u0434\u044b\u043c\u0443\u0446\u044c \u0434\u0430\u045e\u043d\u043e \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b\u044f \u043c\u0435\u0441\u0446\u044b, \u0430\u0434\u043d\u043e\u0432\u044f\u0446\u044c \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b, \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b\u044f \u0448\u043c\u0430\u0442 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0442\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u044b \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0441\u0442\u0430\u0442\u043a\u0456, \u0441\u044b\u043d\u044b \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0432\u0430\u0448\u044b\u043c\u0456 \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431\u0430\u043c\u0456 \u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0440\u0430\u043c\u0456. \u0412\u044b \u0436 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u041f\u0430\u043d\u0430, \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u043f\u0440\u0430 \u0432\u0430\u0441: \u044f\u043d\u044b \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0456\u0445\u043d\u044f\u044e \u0441\u043b\u0430\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u0432\u0430\u0448 \u0441\u043e\u0440\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u045e\u0434\u0432\u0430\u044f, \u0437\u0430 \u0432\u0430\u0448\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u045e\u0441\u0446\u0435\u0448\u044b\u0446\u0435\u0441\u044f \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456; \u0443 \u0432\u0430\u0448\u044b\u043c \u043a\u0440\u0430\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u045e\u0434\u0432\u0430\u044f, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u041f\u0430\u043d, \u043b\u044e\u0431\u043b\u044e \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443 \u0440\u0430\u0431\u0443\u043d\u043a\u0456 \u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b, \u0442\u0430\u043c\u0443 \u042f \u0430\u0434\u0434\u0430\u043c \u0456\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437 \u0456\u043c\u0456 \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0406\u0445 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u043f\u0430\u043c\u0456\u0436 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c\u0456 &ndash; \u0456\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0456\u0445 \u0443\u0431\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u044b &ndash; \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u041f\u0430\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0440\u0430\u0434\u0443\u044e\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0443\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0411\u043e\u0433\u0443 \u043c\u0430\u0456\u043c; \u0431\u043e \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u045e \u0448\u0430\u0442\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u043b\u0430\u0448\u0447\u043e\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u0445\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435, \u044f\u043a \u0436\u0430\u043d\u0456\u0445\u0430, \u0443\u0432\u044f\u043d\u0447\u0430\u045e \u043a\u0430\u0440\u043e\u043d\u0430\u0439, \u044f\u043a \u043d\u044f\u0432\u0435\u0441\u0442\u0443, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e, \u044f\u043a \u0437\u044f\u043c\u043b\u044f \u0434\u0430\u0435 \u0441\u0432\u0430\u044e \u0440\u0430\u0441\u043b\u0456\u043d\u043d\u0430\u0441\u0446\u044c, \u0456, \u044f\u043a \u0441\u0430\u0434 \u0440\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u0441\u0435\u044f\u043d\u0430\u0435 \u045e \u0456\u043c, \u0442\u0430\u043a \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c, \u0448\u0442\u043e \u045e\u0437\u044b\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0441\u043b\u0430\u0432\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 61, 1; \u042f\u043d 8, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u043c\u043d\u0435, \u0431\u043e \u041f\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0430\u0434 \u0411\u043e\u0433\u0430 \u0432\u044b\u0439\u0448\u0430\u045e \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443; \u042f \u043d\u0435 \u0441\u0430\u043c \u0430\u0434 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430\u043b\u0435 \u0401\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"466","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">60, 1-22<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u043b\u0430\u0432\u044b \u041f\u0430\u043d\u0430 \u043d\u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0442\u0430\u043d\u044c, \u0441\u0432\u044f\u0446\u0456\u0441\u044f, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e\u0437\u044b\u0448\u043b\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. \u0411\u043e \u0432\u043e\u0441\u044c \u0446\u0435\u043c\u0440\u0430 \u043f\u0430\u043a\u0440\u044b\u0435 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0437\u043c\u0440\u043e\u043a &ndash; \u043d\u0430\u0440\u043e\u0434\u044b, \u0430 \u041f\u0430\u043d \u0443\u0437\u044b\u0434\u0437\u0435 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0456 \u0441\u043b\u0430\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u044f \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. \u0406 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0434\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u043a\u0430\u0440\u0430\u043b\u0456 \u0434\u0430 \u0431\u043b\u044f\u0441\u043a\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0445\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u043d\u0456\u043c\u0456 \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430\u0432\u043e\u043a\u0430\u043b: \u0443\u0441\u0435 \u044f\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u0446\u0430, \u0456\u0434\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. \u0421\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a, \u0456 \u0434\u0430\u0447\u043e\u043a \u0442\u0432\u0430\u0456\u0445 \u043d\u044f\u0441\u0443\u0446\u044c \u043d\u0430 \u0440\u0443\u043a\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u0442\u044b \u0456 \u0437\u0430\u0437\u0437\u044f\u0435\u0448, \u0437\u0430\u0442\u0440\u0430\u043f\u0435\u0447\u0430 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451, \u0431\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u043c\u043e\u0440\u0430 \u043f\u0430\u043f\u043b\u044b\u0432\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435, \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0441\u043a\u0430\u0440\u0431 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043a\u0440\u044b\u0435 \u0446\u044f\u0431\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u045e, \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u045e \u0437 \u041c\u0430\u0434\u044b\u044f\u043d\u0430 \u0456 \u0437 \u042d\u0444\u044b. \u0423\u0441\u0435 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0421\u0430\u0431\u044b, \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0432\u0430\u043b\u0443 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0430\u0432\u0435\u0447\u043a\u0456 \u041a\u0435\u0434\u0430\u0440\u0430 \u0437\u0431\u044f\u0440\u0443\u0446\u0446\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0431\u0430\u0440\u0430\u043d\u044b \u041d\u0430\u0431\u0430\u0451\u0442\u0430 \u043f\u0430\u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0456\u043b\u0430\u044e \u0430\u0445\u0432\u044f\u0440\u0430\u044e \u043d\u0430 \u041c\u0430\u0456\u043c \u0430\u043b\u0442\u0430\u0440\u044b, \u0456 \u042f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0433\u044d\u0442\u0430, \u0448\u0442\u043e \u043b\u044f\u0446\u044f\u0446\u044c, \u044f\u043a \u0445\u043c\u0430\u0440\u044b \u0456 \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u044b \u045e \u0441\u0432\u0430\u0435 \u0433\u0430\u043b\u0443\u0431\u044f\u0442\u043d\u0456? \u0422\u0430\u043a, \u0430\u0441\u0442\u0440\u0430\u0432\u044b \u041c\u044f\u043d\u0435 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0437 \u043a\u0430\u0440\u0430\u0431\u043b\u044f\u043c\u0456 \u0422\u0430\u0440\u0441\u0456\u0441\u0430 \u043d\u0430 \u0447\u0430\u043b\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0437\u0446\u0456 \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0437\u0434\u0430\u043b\u0451\u043a, \u0456\u0445 \u0441\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456, \u0434\u0437\u0435&shy;\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u0434\u0437\u0435\u043b\u044f \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0431\u043e \u0401\u043d \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u044b \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e \u0430\u0434\u0431\u0443\u0434\u0443\u044e\u0446\u044c \u0442\u0432\u0430\u0435 \u043c\u0443\u0440\u044b, \u0430 \u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435. \u0411\u043e \u045e \u0433\u043d\u0435\u0432\u0435 \u0441\u0432\u0430\u0456\u043c \u042f \u045e\u0434\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435, \u0430 \u045e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u0432\u0430\u0435 \u0431\u0440\u0430\u043c\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430, \u044f\u043d\u044b \u043d\u0435 \u0437\u0430\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u043d\u0456 \u045e\u043d\u043e\u0447, \u043d\u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u0431 \u0434\u0430 \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0456\u0445\u043d\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e. \u0411\u043e \u043d\u0430\u0440\u043e\u0434 \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435, \u0437\u0430\u0433\u0456\u043d\u0435, \u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u0433\u044d\u0442\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0430\u0432\u0430 \u041b\u0456\u0431\u0430\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435, \u043a\u0456\u043f\u0430\u0440\u044b\u0441, \u044f\u0434\u043b\u043e\u0432\u0435\u0446 \u0456 \u043a\u0435\u0434\u0440 \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c, \u043a\u0430\u0431 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0446\u044c \u041c\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u043c\u0435\u0441\u0446\u0430, \u0456 \u042f \u045e\u0441\u043b\u0430\u045e\u043b\u044e \u043c\u0435\u0441\u0446\u0430 \u041c\u0430\u0456\u0445 \u043d\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u043a\u043b\u043e\u043d\u0430\u043c \u0441\u044b\u043d\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u045e \u0446\u044f\u0431\u0435, \u0456 \u0441\u0445\u0456\u043b\u044f\u0446\u0446\u0430 \u0434\u0430 \u0441\u0442\u0443\u043f\u043d\u0435\u0439 \u043d\u043e\u0433 \u0442\u0432\u0430\u0456\u0445 \u0443\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u045e \u0442\u0430\u0431\u043e\u0439, \u0456 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u041f\u0430\u043d\u0430, \u0421\u0456\u0451\u043d\u0430\u043c \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043c\u0435\u0441\u0442 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u043c \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u044b\u043c, \u0434\u0430 \u043a\u0430\u0433\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0433\u043e\u043d\u0430\u0440\u0430\u043c \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c, \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0441\u0430\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u043e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u043a\u0430\u0440\u043c\u0456\u0446\u0446\u0430 \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u0445 \u0433\u0440\u0443\u0434\u0437\u0435\u0439, \u0456 \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0448\u0441\u044f, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0442\u0432\u043e\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u041c\u043e\u0446\u043d\u044b \u042f\u043a\u0443\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043c\u0435\u0441\u0442 \u043c\u0435\u0434\u0437\u0456 \u042f \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u0437\u043e\u043b\u0430\u0442\u0430, \u0437\u0430\u043c\u0435\u0441\u0442 \u0436\u0430\u043b\u0435\u0437\u0430 &ndash; \u0441\u0440\u044d\u0431\u0440\u0430, \u0437\u0430\u043c\u0435\u0441\u0442 \u0434\u0440\u044d\u0432\u0430 &ndash; \u0431\u0440\u043e\u043d\u0437\u0443, \u0437\u0430\u043c\u0435\u0441\u0442 \u043a\u0430\u043c\u044f\u043d\u0451\u045e &ndash; \u0436\u0430\u043b\u0435\u0437\u0430. \u0406 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0441\u043f\u0430\u043a\u043e\u0439 \u0442\u0432\u0430\u0456\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u043c, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c &ndash; \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0430\u043c \u0442\u0432\u0430\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0442\u043d\u0430 \u043f\u0440\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u045e \u0442\u0432\u0430\u0456\u043c \u043a\u0440\u0430\u0456, \u043f\u0440\u0430 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u0435 \u0456 \u0437\u0433\u0443\u0431\u0443 \u045e \u043c\u0435\u0436\u0430\u0445 \u0442\u0432\u0430\u0456\u0445. \u0406 \u0442\u044b \u043d\u0430\u0437\u0430\u0432\u0435\u0448 \u0441\u0432\u0430\u0435 \u043c\u0443\u0440\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0430 \u0441\u0432\u0430\u0435 \u0431\u0440\u0430\u043c\u044b &ndash; \u0441\u043b\u0430\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043e\u043d\u0446\u0430 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0435\u0441\u044f\u0446\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u0446\u044f\u0431\u0435, \u0430\u043b\u0435 \u041f\u0430\u043d \u0441\u0442\u0430\u043d\u0435 \u0442\u0432\u0430\u0456\u043c \u0432\u0435\u0447\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 &ndash; \u0441\u043b\u0430\u0432\u0430\u0439 \u0442\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u0451 \u0441\u043e\u043d\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u043e\u0439\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0437\u043c\u0435\u043d\u0448\u044b\u0446\u0446\u0430 \u043f\u043e\u045e\u043d\u044f, \u0431\u043e \u041f\u0430\u043d \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0432\u0435\u0447\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0456 \u0437\u0430\u043a\u043e\u043d\u0447\u0430\u0446\u0446\u0430 \u0434\u043d\u0456 \u0442\u0432\u0430\u0451\u0439 \u0436\u0430\u043b\u043e\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u043e\u0434 \u0436\u0430 \u0442\u0432\u043e\u0439 &ndash; \u0433\u044d\u0442\u0430 \u045e\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u044f\u043d\u044b \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u044e\u0446\u044c \u0437\u044f\u043c\u043b\u0451\u0439 \u043d\u0430\u0432\u0435\u043a\u0456, \u0433\u044d\u0442\u0430 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a, \u043f\u0430\u0441\u0430\u0434\u0436\u0430\u043d\u044b \u041c\u043d\u043e\u0439, \u0441\u043f\u0440\u0430\u0432\u0430 \u041c\u0430\u0456\u0445 \u0440\u0443\u043a, \u0443\u0447\u044b\u043d\u0435\u043d\u0430\u044f \u0434\u0437\u0435\u043b\u044f \u041c\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u043c\u0435\u043d\u0448\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u0442\u044b\u0441\u044f\u0447\u0443, \u0430 \u043d\u0430\u0439\u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b &ndash; \u0443 \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u043d\u0430\u0440\u043e\u0434. \u042f, \u041f\u0430\u043d, \u0445\u0443\u0442\u043a\u0430 \u0437\u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 60, 1. 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0442\u0430\u043d\u044c, \u0441\u0432\u044f\u0446\u0456\u0441\u044f, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e\u0437\u044b\u0448\u043b\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0434\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u043a\u0430\u0440\u0430\u043b\u0456 \u0434\u0430 \u0431\u043b\u044f\u0441\u043a\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0445\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e\u0437\u044b\u0448\u043b\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"467","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">61, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u043d\u0430 \u0441\u043b\u0443\u0433\u0443 \u042f\u0433\u043e\u043d\u044b\u043c <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u043c\u043d\u0435, \u0431\u043e \u041f\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c. \u041f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443; \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0433\u043e\u0434 \u043b\u0430\u0441\u043a\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u043e\u043c\u0441\u0442\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430; \u043a\u0430\u0431 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0456\u043c \u0432\u044f\u043d\u043e\u043a \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u043e\u043f\u0435\u043b\u0443, \u0430\u043b\u0435\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u0443\u043c\u0443, \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0445\u0432\u0430\u043b\u044b \u0437\u0430\u043c\u0435\u0441\u0442 \u0434\u0443\u0445\u0430 \u043c\u0430\u0440\u043a\u043e\u0442\u044b. \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0456\u0445 \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u0434\u0440\u044d\u0432\u0430\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0430\u0434\u0436\u0430\u043d\u0446\u0430\u043c\u0456 \u041f\u0430\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f\u043d\u044b \u0437\u0430\u0431\u0443\u0434\u0443\u044e\u0446\u044c \u0441\u0442\u0430\u0440\u044b\u044f \u0440\u0443\u0456\u043d\u044b, \u0443\u0437\u0434\u044b\u043c\u0443\u0446\u044c \u0434\u0430\u045e\u043d\u043e \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b\u044f \u043c\u0435\u0441\u0446\u044b, \u0430\u0434\u043d\u043e\u0432\u044f\u0446\u044c \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b, \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b\u044f \u0448\u043c\u0430\u0442 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0442\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u044b \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0441\u0442\u0430\u0442\u043a\u0456, \u0441\u044b\u043d\u044b \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0432\u0430\u0448\u044b\u043c\u0456 \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431\u0430\u043c\u0456 \u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0440\u0430\u043c\u0456. \u0412\u044b \u0436 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u041f\u0430\u043d\u0430, \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u043f\u0440\u0430 \u0432\u0430\u0441: \u044f\u043d\u044b \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0456\u0445\u043d\u044f\u044e \u0441\u043b\u0430\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u0432\u0430\u0448 \u0441\u043e\u0440\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u045e\u0434\u0432\u0430\u044f, \u0437\u0430 \u0432\u0430\u0448\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u045e\u0441\u0446\u0435\u0448\u044b\u0446\u0435\u0441\u044f \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456; \u0443 \u0432\u0430\u0448\u044b\u043c \u043a\u0440\u0430\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u045e\u0434\u0432\u0430\u044f, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u041f\u0430\u043d, \u043b\u044e\u0431\u043b\u044e \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443 \u0440\u0430\u0431\u0443\u043d\u043a\u0456 \u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b, \u0442\u0430\u043c\u0443 \u042f \u0430\u0434\u0434\u0430\u043c \u0456\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437 \u0456\u043c\u0456 \u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0406\u0445 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u043f\u0430\u043c\u0456\u0436 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c\u0456 &ndash; \u0456\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0456\u0445 \u0443\u0431\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u044b &ndash; \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u041f\u0430\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0440\u0430\u0434\u0443\u044e\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0443\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0411\u043e\u0433\u0443 \u043c\u0430\u0456\u043c; \u0431\u043e \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u045e \u0448\u0430\u0442\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u043b\u0430\u0448\u0447\u043e\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u0445\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435, \u044f\u043a \u0436\u0430\u043d\u0456\u0445\u0430, \u0443\u0432\u044f\u043d\u0447\u0430\u045e \u043a\u0430\u0440\u043e\u043d\u0430\u0439, \u044f\u043a \u043d\u044f\u0432\u0435\u0441\u0442\u0443, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e, \u044f\u043a \u0437\u044f\u043c\u043b\u044f \u0434\u0430\u0435 \u0441\u0432\u0430\u044e \u0440\u0430\u0441\u043b\u0456\u043d\u043d\u0430\u0441\u0446\u044c, \u0456, \u044f\u043a \u0441\u0430\u0434 \u0440\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u0441\u0435\u044f\u043d\u0430\u0435 \u045e \u0456\u043c, \u0442\u0430\u043a \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c, \u0448\u0442\u043e \u045e\u0437\u044b\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0441\u043b\u0430\u0432\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 61, 1; \u042f\u043d 8, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u041c\u043d\u0435, \u0431\u043e \u041f\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u041c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0430\u0434 \u0411\u043e\u0433\u0430 \u0432\u044b\u0439\u0448\u0430\u045e \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443; \u042f \u043d\u0435 \u0441\u0430\u043c \u0430\u0434 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430\u043b\u0435 \u0401\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"468","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">62, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043b\u0456\u0437\u043a\u0430\u0441\u0446\u044c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0421\u0456\u0451\u043d\u0430 \u043d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0430\u045e\u0447\u0430\u0446\u044c, \u0434\u0437\u0435\u043b\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u043d\u0435 \u0441\u0443\u043f\u0430\u043a\u043e\u044e\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0437\u044b\u0434\u0437\u0435, \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e \u0456 \u044f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u0437\u0430\u043f\u0430\u043b\u0430\u0435, \u044f\u043a \u043f\u0430\u0445\u043e\u0434\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0442\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u045e\u0441\u0435 \u043a\u0430\u0440\u0430\u043b\u0456 &ndash; \u0442\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443; \u0456 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u043e\u0432\u044b\u043c \u0456\u043c\u0435\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0432\u0443\u0441\u043d\u044b \u041f\u0430\u043d\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0430\u0440\u043e\u043d\u0430\u044e \u0441\u043b\u0430\u0432\u044b \u045e \u0440\u0443\u0446\u044d \u041f\u0430\u043d\u0430, \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0434\u044b\u044f\u0434\u044d\u043c\u0430\u0439 \u043d\u0430 \u0434\u0430\u043b\u043e\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u043d\u0435 \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u043f\u0440\u0430 \u0446\u044f\u0431\u0435: &laquo;\u041f\u0430\u043a\u0456\u043d\u0443\u0442\u044b&raquo;, \u0456 \u0437\u044f\u043c\u043b\u044e \u0442\u0432\u0430\u044e \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u043f\u0443\u0441\u0442\u044b\u043d\u044f\u0439. \u0410\u043b\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435: &laquo;\u041c\u0430\u0451 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u045e \u0456\u043c&raquo;, \u0430 \u0437\u044f\u043c\u043b\u044e \u0442\u0432\u0430\u044e \u0437\u0430\u043c\u0443\u0436\u043d\u044f\u0439, \u0431\u043e \u0442\u044b \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u041f\u0430\u043d\u0443, \u0456 \u0437\u044f\u043c\u043b\u044f \u0442\u0432\u0430\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043c\u0443\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e, \u044f\u043a \u044e\u043d\u0430\u043a \u0436\u044d\u043d\u0456\u0446\u0446\u0430 \u0437 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430\u0439, \u0442\u0430\u043a \u0432\u043e\u0437\u044c\u043c\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0435; \u044f\u043a \u0436\u0430\u043d\u0456\u0445 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u044f\u0432\u0435\u0441\u0446\u0435, \u0442\u0430\u043a \u0443\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0442\u0430\u0431\u043e\u044e \u0442\u0432\u043e\u0439 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0442\u0432\u0430\u0456\u0445 \u043c\u0443\u0440\u0430\u0445, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u045e. \u042f\u043d\u044b \u043d\u0456\u043a\u043e\u043b\u0456, \u043d\u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u043d\u0456 \u045e\u043d\u0430\u0447\u044b \u043d\u0435 \u0437\u0430\u043c\u043e\u045e\u043a\u043d\u0443\u0446\u044c. \u0412\u044b, \u044f\u043a\u0456\u044f \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u0446\u0435 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430, \u043d\u0435 \u043c\u0430\u0439\u0446\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0456 \u043d\u0435 \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u042f\u043c\u0443 \u0441\u043f\u0430\u043a\u043e\u044e, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u045e\u043c\u0430\u0446\u0443\u0435 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u044f\u0433\u043e \u0441\u043b\u0430\u0432\u0430\u044e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0441\u0432\u0430\u0451\u044e \u043f\u0440\u0430\u0432\u0456\u0446\u0430\u0439 \u0456 \u0441\u0432\u0430\u0456\u043c \u043c\u043e\u0446\u043d\u044b\u043c \u043f\u043b\u044f\u0447\u043e\u043c: &laquo;\u042f \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0430\u0434\u0434\u0430\u043c \u0442\u0432\u0430\u0439\u0433\u043e \u0437\u0431\u043e\u0436\u0436\u0430 \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0443 \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u0442\u0432\u0430\u0456\u043c; \u0441\u044b\u043d\u044b \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0456\u0446\u044c \u0442\u0432\u0430\u0439\u0433\u043e \u0432\u0456\u043d\u0430, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0442\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e. \u0410\u043b\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0431\u0456\u0440\u0430\u045e \u0443\u0440\u0430\u0434\u0436\u0430\u0439, \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u0456 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u041f\u0430\u043d\u0430; \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0432\u0456\u043d\u043e, \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0456\u0446\u044c \u044f\u0433\u043e \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u0430\u0445 \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0445\u043e\u0434\u0437\u044c\u0446\u0435, \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u043f\u0440\u0430\u0437 \u0431\u0440\u0430\u043c\u044b, \u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u043d\u0430\u0440\u043e\u0434\u0443. \u041f\u0440\u0430\u0441\u0442\u0443\u0439\u0446\u0435, \u043f\u0440\u0430\u0441\u0442\u0443\u0439\u0446\u0435 \u0448\u043b\u044f\u0445, \u0430\u0447\u044b\u0448\u0447\u0430\u0439\u0446\u0435 \u0430\u0434 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u043f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0441\u0446\u044f\u0433 \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u041f\u0430\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456: &laquo;\u0421\u043a\u0430\u0436\u044b\u0446\u0435 \u0434\u0430\u0447\u0446\u044d \u0421\u0456\u0451\u043d\u0430: \u0432\u043e\u0441\u044c \u0456\u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0432\u043e\u0441\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u044f \u0437 \u0406\u043c \u0456 \u0430\u0434\u043f\u043b\u0430\u0442\u0430 \u042f\u0433\u043e\u043d\u0430\u044f \u043f\u0435\u0440\u0430\u0434 \u0406\u043c. \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u043c, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u043c\u0456 \u041f\u0430\u043d\u0430\u043c, \u0430 \u0446\u044f\u0431\u0435 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0433\u043e\u0440\u0430\u0434\u0430\u043c \u0436\u0430\u0434\u0430\u043d\u044b\u043c, \u043d\u0435\u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 62, 2-3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0431\u0430\u0447\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0442\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u045e\u0441\u0435 \u043a\u0430\u0440\u0430\u043b\u0456 &ndash; \u0442\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u043e\u0432\u044b\u043c \u0456\u043c\u0435\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0432\u0443\u0441\u043d\u044b \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0430\u0440\u043e\u043d\u0430\u044e \u0441\u043b\u0430\u0432\u044b \u045e \u0440\u0443\u0446\u044d \u041f\u0430\u043d\u0430, \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0434\u044b\u044f\u0434\u044d\u043c\u0430\u0439 \u043d\u0430 \u0434\u0430\u043b\u043e\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u043e\u0432\u044b\u043c \u0456\u043c\u0435\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0432\u0443\u0441\u043d\u044b \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"469","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">63, 7-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u043f\u043e\u043c\u043d\u0456\u0446\u044c \u043f\u0440\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0443 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c. \u0425\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0443 \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043d\u0430\u0441, \u0437\u0430 \u045e\u0441\u0451 \u042f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u043e\u0435 \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0433\u044d\u0442\u0430 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0441\u044b\u043d\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430&raquo;. \u0406 \u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0456\u0445 \u0417\u0431\u0430\u045e\u0446\u0430\u043c \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c \u0443\u0446\u0456\u0441\u043a\u0443 \u0456\u0445\u043d\u0456\u043c. \u0413\u044d\u0442\u0430 \u043d\u0435 \u0430\u043d\u0451\u043b, \u0430\u043b\u0435 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u0431\u0430\u0432\u0456\u043b\u0430 \u0456\u0445. \u0423 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0456 \u0401\u043d \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456\u0445, \u043f\u0430\u0434\u043d\u044f\u045e \u0456 \u043d\u0430\u0441\u0456\u045e \u0456\u0445 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0434\u0430\u045e\u043d\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b \u0436 \u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043b\u0456 \u042f\u0433\u043e \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0414\u0443\u0445\u0430, \u0442\u0430\u043c\u0443 \u0401\u043d \u0430\u0431\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0456\u0445\u043d\u044f\u0433\u0430 \u0432\u043e\u0440\u0430\u0433\u0430 \u0456 \u0441\u0442\u0430\u045e \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434 \u0443\u0441\u043f\u043e\u043c\u043d\u0456\u045e \u0434\u0430\u045e\u043d\u0456\u044f \u0434\u043d\u0456 \u0456 \u041c\u0430\u0439\u0441\u0435\u044f. \u0414\u0437\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0432\u043e\u0434\u0437\u0456\u045e \u0456\u0445 \u0437 \u043c\u043e\u0440\u0430 \u0437 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0430\u0432\u0435\u0447\u0430\u043a \u0441\u0432\u0430\u0456\u0445? \u0414\u0437\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u043a\u043b\u0430\u045e \u0443 \u0456\u0445\u043d\u044f\u0435 \u043d\u0443\u0442\u0440\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0414\u0443\u0445\u0430; \u0445\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e, \u0448\u0442\u043e \u042f\u0433\u043e \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u043f\u043b\u044f\u0447\u043e \u0456\u0448\u043b\u043e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u041c\u0430\u0439\u0441\u0435\u044f; \u0445\u0442\u043e \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u043c\u043e\u0440\u0430 \u0456 \u0437\u0434\u0430\u0431\u044b\u045e \u0441\u0430\u0431\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0456\u043c\u044f; \u0445\u0442\u043e \u0432\u0451\u045e \u0456\u0445 \u043f\u0440\u0430\u0437 \u0431\u0435\u0437\u0434\u0430\u043d\u044c, \u044f\u043a \u043a\u0430\u043d\u044f \u043f\u0430 \u0441\u0442\u044d\u043f\u0435, \u0456 \u044f\u043d\u044b \u043d\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0443\u043b\u0456\u0441\u044f? \u042f\u043a \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0430\u043b\u0456\u043d\u0443 \u0436\u044b\u0432\u0451\u043b\u0430, \u0442\u0430\u043a \u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0432\u0451\u045e \u0456\u0445 \u0434\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0422\u0430\u043a, \u041f\u0430\u043d\u0435, \u0422\u044b \u0432\u0451\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0441\u0430\u0431\u0435 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0456\u0440\u043d\u0456 \u0437 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f! \u0414\u0437\u0435 \u0422\u0432\u0430\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0422\u0432\u0430\u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c? \u0422\u0432\u0430\u0451 \u043d\u0443\u0442\u0440\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0434\u0440\u044b\u0436\u044b\u0446\u044c \u0437\u0430 \u043c\u044f\u043d\u0435, \u0422\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u0448 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u0430 \u043c\u044f\u043d\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0422\u044b \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448, \u0431\u043e \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0441 \u0456 \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u043d\u0430\u0441 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u0422\u044b, \u041f\u0430\u043d\u0435, \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448, \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u043d\u0430\u0448, \u0442\u0430\u043a\u043e\u0435 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u0456\u043c\u044f \u0422\u0432\u0430\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443, \u041f\u0430\u043d\u0435, \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435\u0448 \u0437\u0431\u043e\u0447\u0432\u0430\u0446\u044c \u0441\u0430 \u0448\u043b\u044f\u0445\u043e\u045e \u0422\u0432\u0430\u0456\u0445 \u0456 \u0440\u043e\u0431\u0456\u0448 \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u0446\u0432\u0451\u0440\u0434\u044b\u043c\u0456, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0426\u044f\u0431\u0435? \u0412\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0433\u0430\u045e \u0422\u0432\u0430\u0456\u0445, \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0422\u0432\u0430\u0451\u0439. \u0422\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u044f\u0434\u043e\u045e\u0433\u0430 \u0432\u0430\u043b\u043e\u0434\u0430\u045e \u0422\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439, \u043d\u0430\u0448\u044b \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0456 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043b\u0456 \u044f\u0435. \u041c\u044b \u0441\u0442\u0430\u043b\u0456 \u0437\u0434\u0430\u045e\u043d\u0430 \u0431\u044b\u0446\u0446\u0430\u043c \u0442\u044b\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u0422\u044b \u043d\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u043d\u0456\u043a\u043e\u043b\u0456 \u0456 \u043d\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u043d\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430\u0441\u044f \u0422\u0432\u0430\u0451 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0441\u044b\u0448\u043e\u045e, \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u0440\u0430\u0441\u0442\u0430\u044f\u043b\u0456 \u0431 \u0433\u043e\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 63, 17. 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043c\u0443, \u041f\u0430\u043d\u0435, \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435\u0448 \u0437\u0431\u043e\u0447\u0432\u0430\u0446\u044c \u0441\u0430 \u0448\u043b\u044f\u0445\u043e\u045e \u0422\u0432\u0430\u0456\u0445 \u0456 \u0440\u043e\u0431\u0456\u0448 \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u0446\u0432\u0451\u0440\u0434\u044b\u043c\u0456, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0426\u044f\u0431\u0435? <span style=\"color: #ff0000;\">*<\/span> \u041e, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0441\u044b\u0448\u043e\u045e!<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0433\u0430\u045e \u0422\u0432\u0430\u0456\u0445, \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0422\u0432\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041e, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0441\u044b\u0448\u043e\u045e!<\/p>\r\n"}, {"GCH_CH_1_ID":"470","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">63, 19 &ndash; 64, 11<\/span>&nbsp;<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u043e\u0441\u044c\u0431\u0430 \u0430\u0431 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0441\u044b\u0448\u043e\u045e! \u041f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u0440\u0430\u0441\u0442\u0430\u044f\u043b\u0456 \u0431 \u0433\u043e\u0440\u044b. \u042f\u043a \u0430\u0433\u043e\u043d\u044c \u043f\u0430\u043b\u0456\u0446\u044c \u0433\u0430\u043b\u043b\u0451, \u044f\u043a \u043d\u0430 \u043f\u043e\u043b\u044b\u043c\u0456 \u043a\u0456\u043f\u0456\u0446\u044c \u0432\u0430\u0434\u0430, \u0442\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u043c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f. \u0406 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u0430\u0442\u0440\u0430\u043f\u0435\u0447\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e. \u041a\u0430\u043b\u0456 \u0431 \u0422\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0433\u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u0445 \u043c\u044b \u043d\u0435 \u0447\u0430\u043a\u0430\u043b\u0456, \u0456 \u0441\u044b\u0448\u043e\u045e, \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u0440\u0430\u0441\u0442\u0430\u044f\u043b\u0456 \u0431 \u0433\u043e\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0430\u0434\u0432\u0435\u043a\u0443 \u043d\u0456 \u0447\u0443\u043b\u0456, \u043d\u0456 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0432\u0443\u0445\u0430\u043c, \u043d\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u043e\u043a\u0430\u043c, \u043a\u0430\u0431 \u0456\u043d\u0448\u044b \u0431\u043e\u0433, \u0430\u043f\u0440\u043e\u0447 \u0426\u044f\u0431\u0435, \u0437\u0440\u0430\u0431\u0456\u045e \u0431\u044b \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e. \u0422\u044b \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435\u0448 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0456 \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0445\u0442\u043e \u043f\u0430\u043c\u044f\u0442\u0430\u0435 \u043f\u0440\u0430 \u0426\u044f\u0431\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445\u0430\u0445 \u0422\u0432\u0430\u0456\u0445. \u0406 \u0432\u043e\u0441\u044c \u0422\u044b \u0437\u0430\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f, \u0431\u043e \u0437\u0434\u0430\u045e\u043d\u0430 \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0456 \u045e\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u044f\u043a \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f, \u0456 \u044f\u043a \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u0430\u0435 &ndash; \u0443\u0441\u044f \u043d\u0430\u0448\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0417\u0430\u0432\u044f\u043b\u0456 \u043c\u044b \u044f\u043a \u043b\u0456\u0441\u0446\u0435, \u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b\u044f, \u044f\u043a \u0432\u0435\u0446\u0435\u0440 \u043d\u044f\u0441\u0443\u0446\u044c \u043d\u0430\u0441. \u0406 \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0431\u044b \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u0445\u0442\u043e \u045e\u0441\u0442\u0430\u045e \u0431\u044b, \u043a\u0430\u0431 \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0437\u0430 \u0426\u044f\u0431\u0435. \u0411\u043e \u0422\u044b \u0437\u0430\u043a\u0440\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0451 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441 \u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0434 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u043d\u0430\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435, \u041f\u0430\u043d\u0435, \u0422\u044b &ndash; \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448, \u043c\u044b &ndash; \u0433\u043b\u0456\u043d\u0430, \u0430 \u0422\u044b &ndash; \u043d\u0430\u0448 \u0433\u0430\u043d\u0447\u0430\u0440, \u0456 \u045e\u0441\u0435 \u043c\u044b &ndash; \u0441\u043f\u0440\u0430\u0432\u0430 \u0440\u0443\u043a\u0456 \u0422\u0432\u0430\u0451\u0439. \u041d\u0435 \u0433\u043d\u0435\u0432\u0430\u0439\u0441\u044f \u043c\u043e\u0446\u043d\u0430, \u041f\u0430\u043d\u0435, \u0456 \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u0432\u0435\u0447\u043d\u0430 \u043f\u0440\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435. \u0412\u043e\u0441\u044c, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456: \u043c\u044b \u045e\u0441\u0435 &ndash; \u043d\u0430\u0440\u043e\u0434 \u0422\u0432\u043e\u0439. \u0422\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0433\u0430\u0440\u0430\u0434\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0443\u0441\u0442\u044b\u043d\u044f\u0439, \u043f\u0443\u0441\u0442\u044b\u043d\u044f\u0439 \u0441\u0442\u0430\u045e \u0421\u0456\u0451\u043d, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0441\u0432\u044f\u0442\u044b \u0456 \u0441\u043b\u0430\u045e\u043d\u044b \u0434\u043e\u043c, \u0434\u0437\u0435 \u043d\u0430\u0448\u044b\u044f \u0430\u0439\u0446\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0426\u044f\u0431\u0435, \u0441\u0442\u0430\u045e \u043f\u0430\u043f\u044f\u043b\u0456\u0448\u0447\u0430\u043c; \u0443\u0441\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u044f \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u045e \u0440\u0443\u0456\u043d\u044b. \u0426\u0456 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435? \u0426\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0434\u0430\u043b\u0435\u0439 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u0456 \u043a\u0430\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 56, 1; \u041c\u0456\u0445 4, 9; \u0406\u0441 43, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0445\u0443\u0442\u043a\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0442\u0432\u0430\u0451. \u0427\u0430\u043c\u0443 \u0446\u044f\u0431\u0435 \u0437&rsquo;\u044f\u0434\u0430\u0435 \u0441\u043c\u0443\u0442\u0430\u043a? \u0425\u0456\u0431\u0430 \u043d\u044f\u043c\u0430 \u0434\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430 \u045e \u0446\u044f\u0431\u0435, \u0448\u0442\u043e \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0432\u043e\u0439 \u0431\u043e\u043b\u044c? <span style=\"color: #ff0000;\">*<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u042f \u0437\u0431\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435, \u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0446\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u042f \u041f\u0430\u043d \u0411\u043e\u0433 \u0422\u0432\u043e\u0439, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0422\u0432\u043e\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u042f \u0437\u0431\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435, \u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0446\u044f\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"471","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">65, 13-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0430\u044f \u0437\u044f\u043c\u043b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: &laquo;\u0412\u043e\u0441\u044c, \u041c\u0430\u0435 \u0441\u043b\u0443\u0433\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u044f; \u041c\u0430\u0435 \u0441\u043b\u0443\u0433\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0456\u0446\u044c, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043c\u0430\u0433\u043d\u0443\u0446\u044c; \u041c\u0430\u0435 \u0441\u043b\u0443\u0433\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0430 \u0432\u044b \u0437\u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u0441\u043e\u0440\u0430\u043c; \u041c\u0430\u0435 \u0441\u043b\u0443\u0433\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e \u0441\u044d\u0440\u0446\u044b, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0430\u0434 \u0440\u043e\u0441\u043f\u0430\u0447\u044b \u0441\u044d\u0440\u0446\u0430 \u0456 \u0441\u0442\u0430\u0433\u043d\u0430\u0446\u044c \u0430\u0434 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u043a\u0440\u0443\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b \u043f\u0430\u043a\u0456\u043d\u0435\u0446\u0435 \u0441\u0432\u0430\u0451 \u0456\u043c\u044f \u044f\u043a \u043f\u0440\u0430\u043a\u043b\u0451\u043d \u0434\u043b\u044f \u041c\u0430\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u0446\u044f\u0431\u0435 \u0437\u0430\u0431&rsquo;\u0435 \u041f\u0430\u043d \u0411\u043e\u0433&rdquo;, \u0430 \u041c\u0430\u0435 \u0441\u043b\u0443\u0433\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0456\u043d\u0448\u044b\u043c \u0456\u043c\u0435\u043c. \u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b; \u0456 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043a\u043b\u044f\u0441\u0446\u0456\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0431\u0443\u0434\u0437\u0435 \u043a\u043b\u044f\u0441\u0446\u0456\u0441\u044f \u0411\u043e\u0433\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b, \u0431\u043e \u0441\u0442\u0430\u0440\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0431\u044b\u0442\u044b \u0456 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0430\u0434 \u041c\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u042f \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u043d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e; \u043c\u0456\u043d\u0443\u043b\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430 \u0434\u0443\u043c\u043a\u0443. \u0410 \u0432\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0446\u0435\u0448\u0446\u0435\u0441\u044f \u0432\u0435\u0447\u043d\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u042f \u0441\u0442\u0432\u0430\u0440\u0443, \u0431\u043e \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0430 \u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434 &ndash; \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e. \u0406 \u0431\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0443 \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c \u0447\u0443\u0442\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u043f\u043b\u0430\u0447\u0443 \u0456 \u0433\u043e\u043b\u0430\u0441 \u043a\u0440\u044b\u043a\u0443. \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043c \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0446\u0456, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0434\u0437\u0451\u043d, \u043d\u0456 \u0441\u0442\u0430\u0440\u043e\u0433\u0430, \u044f\u043a\u0456 \u0431 \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u0451\u043d. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043c\u0440\u044d \u045e \u0441\u0442\u043e \u0433\u0430\u0434\u043e\u045e, \u0431\u0443\u0434\u0437\u0435 \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u044e\u043d\u0430\u043a\u043e\u043c; \u0430\u043b\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a, \u044f\u043a\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0441\u0442\u0430 \u0433\u0430\u0434\u043e\u045e, \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0431\u0443\u0434\u0443\u044e\u0446\u044c \u0434\u0430\u043c\u044b, \u0456 \u043d\u0430\u0441\u0435\u043b\u044f\u0446\u044c \u0456\u0445, \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u044f\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0456, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456\u0445 \u043f\u043b\u0451\u043d. \u042f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0456\u043d\u0448\u044b; \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0430\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u0456\u043d\u0448\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u045e, \u0431\u043e \u0434\u043d\u0456 \u041c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0434\u043e\u045e\u0433\u0456\u0445 \u0434\u0437\u0451\u043d \u0434\u0440\u044d\u0432\u0430. \u041c\u0430\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0456\u0445\u043d\u0456\u044f \u0440\u0443\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430, \u043d\u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430\u043c, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c \u0430\u0434 \u041f\u0430\u043d\u0430, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 &ndash; \u0456\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456. \u0406 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a, \u0448\u0442\u043e \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0456\u0447\u0443\u0446\u044c, \u042f \u0430\u0434\u043a\u0430\u0436\u0443, \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u0448\u0447\u044d \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0430 \u042f \u045e\u0436\u043e \u043f\u0430\u0447\u0443\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u045e\u043a \u0456 \u044f\u0433\u043d\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c, \u0456 \u043b\u0435\u045e, \u044f\u043a \u0432\u043e\u043b, \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u0441\u0430\u043b\u043e\u043c\u0443, \u0456 \u0434\u043b\u044f \u0437\u043c\u0435\u044f \u043f\u044b\u043b \u0431\u0443\u0434\u0437\u0435 \u0435\u0436\u0430\u0439. \u042f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0447\u044b\u043d\u0456\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u044b \u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u043d\u0430 \u045e\u0441\u0451\u0439 \u041c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 21, 1. 3. 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u043d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0437 \u0442\u0440\u043e\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u0441\u043a\u0456\u043d\u0456\u044f \u0411\u043e\u0433\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0437 \u0456\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0432\u044b\u0442\u0440\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043b\u044f\u0437\u0443 \u0437 \u0432\u0430\u0447\u044d\u0439 \u0456\u0445\u043d\u0456\u0445, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043c\u0435\u0440\u0446\u0456, \u0431\u043e \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u043c\u0456\u043d\u0443\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u043a\u0456\u043d\u0456\u044f \u0411\u043e\u0433\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0437 \u0456\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"472","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">66, 10-14. 18-23<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u045e \u0456\u043c \u0443\u0441\u0435, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u044f\u0433\u043e. \u0420\u0430\u0434\u0430\u0441\u043d\u0430 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0443\u0441\u0435, \u0445\u0442\u043e \u043f\u043b\u0430\u043a\u0430\u045e \u043d\u0430\u0434 \u0456\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0456\u0441\u044f \u045e\u0434\u043e\u0441\u0442\u0430\u043b\u044c \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0432\u044b \u043a\u0430\u0440\u043c\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0456\u0441\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u0439 \u044f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u0412\u043e\u0441\u044c \u042f \u0441\u043a\u0456\u0440\u0443\u044e \u0434\u0430 \u044f\u0433\u043e \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a \u0440\u0430\u043a\u0443, \u0456 \u0445\u0432\u0430\u043b\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a \u043f\u0430\u045e\u043d\u0430\u0432\u043e\u0434\u043d\u044b \u043f\u0430\u0442\u043e\u043a. \u0412\u0430\u0441 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0456 \u043d\u0430\u0441\u0456\u0446\u044c \u043d\u0430 \u0440\u0443\u043a\u0430\u0445, \u0456 \u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u044f\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0435\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441. \u042f\u043a \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043c\u0430\u0446\u0456, \u0442\u0430\u043a \u042f \u0431\u0443\u0434\u0443 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0432\u0430\u0441, \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0423\u0431\u0430\u0447\u044b\u0446\u0435, \u0456 \u045e\u0441\u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0432\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0456 \u043a\u043e\u0441\u0446\u0456 \u0432\u0430\u0448\u044b \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0446\u044c, \u044f\u043a \u0442\u0440\u0430\u0432\u0430. \u0406 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u0441\u043b\u0443\u0433\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c, \u0456 \u042f\u0433\u043e \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u0441\u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u0435\u0434\u0430\u044e \u045e\u0447\u044b\u043d\u043a\u0456 \u0456\u0445\u043d\u0456\u044f \u0456 \u0437\u0430\u0434\u0443\u043c\u044b \u0456\u0445\u043d\u0456\u044f. \u0406 \u043f\u0440\u044b\u0439\u0434\u0443 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u043c\u043e\u0432\u044b, \u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c, \u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e. \u0406 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0437\u043d\u0430\u043a, \u0456 \u043f\u0430\u0448\u043b\u044e \u0430\u0446\u0430\u043b\u0435\u043b\u044b\u0445 \u0437 \u0456\u0445 \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e: \u0443 \u0422\u0430\u0440\u0441, \u041f\u0443\u043b \u0456 \u041b\u0443\u0434, \u0443 \u041c\u044d\u0441\u044d\u0445, \u0422\u0443\u0431\u0430\u043b\u044c \u0456 \u042f\u0432\u0430\u043d, \u043d\u0430 \u0434\u0430\u043b\u0451\u043a\u0456\u044f \u0430\u0441\u0442\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u044b \u041c\u0430\u0451\u0439. \u042f\u043d\u044b \u0430\u0431\u0432\u0435\u0441\u0446\u044f\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456. \u0406 \u043f\u0440\u044b\u0432\u044f\u0434\u0443\u0446\u044c \u0443\u0441\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0432\u0430\u0448\u044b\u0445 \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0443 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u041f\u0430\u043d\u0443 \u043d\u0430 \u043a\u043e\u043d\u044f\u0445, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u0445 \u0456 \u043d\u0430\u0441\u0456\u043b\u043a\u0430\u0445, \u043d\u0430 \u043c\u0443\u043b\u0430\u0445 \u0456 \u0432\u044f\u0440\u0431\u043b\u044e\u0434\u0430\u0445 \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043d\u0430 \u041c\u0430\u044e \u0441\u0432\u044f\u0442\u0443\u044e \u0433\u0430\u0440\u0443, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u044f\u043a \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u045e \u0447\u044b\u0441\u0442\u044b\u043c \u043d\u0430\u0447\u044b\u043d\u043d\u0456 \u045e \u0434\u043e\u043c \u041f\u0430&shy;\u043d\u0430. \u0406 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0443 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0437 \u0456\u0445 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0456 \u043b\u0435\u0432\u0456\u0442\u0430\u043c\u0456&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u043e \u044f\u043a \u043d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0430\u044f \u0437\u044f\u043c\u043b\u044f, \u044f\u043a\u0456\u044f \u042f \u0441\u0442\u0432\u0430\u0440\u0430\u044e, \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0442\u0430\u043a \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0456 \u0432\u0430\u0448\u0430\u0435 \u0456\u043c\u044f. \u0406 \u0437 \u043c\u0435\u0441\u044f\u0446\u0430 \u045e \u043c\u0435\u0441\u044f\u0446, \u0456 \u0437 \u0448\u0430\u0431\u0430\u0442\u0443 \u045e \u0448\u0430\u0431\u0430\u0442 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 66, 18. 19; \u042f\u043d 17, 6. 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0440\u044b\u0439\u0434\u0443 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u043c\u043e\u0432\u044b.<span style=\"color: #ff0000;\"> *<\/span> \u0406 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c, \u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e, \u0456 \u0430\u0431\u0432\u0435\u0441\u0446\u044f\u0446\u044c \u044f\u0435 \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u0445 \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435 \u0441\u0430 \u0441\u0432\u0435\u0442\u0443. \u042f\u043a \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u045e \u0441\u0432\u0435\u0442, \u0442\u0430\u043a \u0456 \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0443 \u0441\u0432\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c, \u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e, \u0456 \u0430\u0431\u0432\u0435\u0441\u0446\u044f\u0446\u044c \u044f\u0435 \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"473","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">42, 1-9; 49, 1-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043e\u0440\u043d\u044b \u0421\u043b\u0443\u0433\u0430 \u041f\u0430\u043d\u0430, \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430\u0440\u043e\u0434\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u042f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u044e, \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041c\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430 \u0434\u0443\u0448\u0430 \u041c\u0430\u044f. \u042f \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u042f\u0433\u043e; \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0442\u043d\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e. \u0401\u043d \u043d\u0435 \u0437\u043b\u043e\u043c\u0456\u0446\u044c \u043d\u0430\u0434\u043b\u043e\u043c\u043b\u0435\u043d\u0430\u0439 \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u044b \u0456 \u043d\u0435 \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u0442\u043b\u0435\u044e\u0447\u0430\u0433\u0430 \u043a\u043d\u043e\u0442\u0443; \u0434\u043b\u044f \u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0401\u043d \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435. \u041d\u0435 \u0430\u0441\u043b\u0430\u0431\u043d\u0435 \u0456 \u043d\u0435 \u043d\u0430\u0434\u043b\u043e\u043c\u0456\u0446\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0430\u0441\u0442\u0440\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u0443, \u044f\u043a\u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u044f\u0435, \u0434\u0430\u044e\u0447\u044b \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043d\u0430 \u0451\u0439, \u0456 \u0434\u0443\u0445 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430 \u0451\u0439 \u0445\u043e\u0434\u0437\u0456\u0446\u044c:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f, \u041f\u0430\u043d, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0426\u044f\u0431\u0435 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u045e\u0437\u044f\u045e \u0426\u044f\u0431\u0435 \u0437\u0430 \u0440\u0443\u043a\u0443 \u0456 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0426\u044f\u0431\u0435, \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0430\u0431 \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u045e \u0432\u043e\u0447\u044b \u0441\u043b\u044f\u043f\u044b\u043c \u0456 \u0437 \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u0432\u044b\u0432\u0435\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445, \u0437 \u0434\u043e\u043c\u0443 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u043d\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f &ndash; \u041f\u0430\u043d, \u0433\u044d\u0442\u0430 \u0456\u043c\u044f \u041c\u0430\u0451. \u042f \u043d\u0435 \u0430\u0434\u0434\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0456\u043d\u0448\u0430\u043c\u0443, \u0430 \u0456\u0434\u0430\u043b\u0430\u043c &ndash; \u0441\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u044b. \u0412\u043e\u0441\u044c \u0434\u0430\u045e\u043d\u0456\u044f \u043f\u0430\u0434\u0437\u0435\u0456 \u045e\u0436\u043e \u043d\u0430\u0434\u044b\u0448\u043b\u0456, \u0456 \u042f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0432\u0430\u043c \u043d\u043e\u0432\u044b\u044f; \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0430\u0434\u0431\u0443\u0434\u0443\u0446\u0446\u0430, \u044f \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u044e \u0432\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0430\u0441\u0442\u0440\u0430\u0432\u044b, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u0432\u044b, \u0434\u0430\u043b\u0451\u043a\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b: \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u044f\u043d\u0435 \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456, \u0437 \u043d\u0443\u0442\u0440\u0430 \u044f\u0435 \u043d\u0430\u0437\u0432\u0430\u045e \u043c\u0430\u0451 \u0456\u043c\u044f. \u0417\u0440\u0430\u0431\u0456\u045e \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u0435, \u044f\u043a \u0432\u043e\u0441\u0442\u0440\u044b \u043c\u0435\u0447, \u0441\u0445\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u045e \u0446\u0435\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456. \u0417\u0440\u0430\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0439 \u0441\u0442\u0440\u0430\u043b\u043e\u0439, \u0441\u0445\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u043a\u0430\u043b\u0447\u0430\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0422\u044b \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0443 \u0442\u0430\u0431\u0435 \u042f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e\u0441\u044f&raquo;. \u0410 \u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u0430\u0440\u044d\u043c\u043d\u0430 \u044f \u043d\u0430\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u043c\u0430\u0440\u043d\u0430 \u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u043e\u0435 \u0442\u0440\u0430\u0446\u0456\u045e \u0441\u0432\u0430\u044e \u0441\u0456\u043b\u0443. \u0410\u043b\u0435 \u0437\u0430\u043a\u043e\u043d \u043c\u043e\u0439 \u0443 \u041f\u0430\u043d\u0430 \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u043c\u0430\u044f \u045e \u0411\u043e\u0433\u0430 \u043c\u0430\u0439\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0446\u044f\u043f\u0435\u0440 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u045e\u0436\u043e \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u043e\u0439 \u0441\u0432\u0430\u0456\u043c, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u045e \u0434\u043b\u044f \u042f\u0433\u043e \u042f\u043a\u0443\u0431\u0430 \u0456 \u0441\u0430\u0431\u0440\u0430\u045e \u0434\u043b\u044f \u042f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u0406 \u044f \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430, \u0430 \u043c\u043e\u0439 \u0411\u043e\u0433 \u0441\u0442\u0430\u045e \u043c\u0430\u0451\u0439 \u0441\u0456\u043b\u0430\u0439. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u0433\u043e \u043c\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u044b \u0431\u044b\u045e \u0441\u043b\u0443\u0433\u043e\u0439 \u041c\u0430\u0456\u043c, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u042f\u043a\u0443\u0431\u0430, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u045e \u0440\u044d\u0448\u0442\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0430\u0431 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041c\u0430\u0451 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0421\u0432\u044f\u0442\u044b \u044f\u0433\u043e, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u0430\u043c\u0443 \u045e \u0441\u0432\u0430\u0451\u0439 \u0430\u0441\u043e\u0431\u0435,&nbsp;\u0430\u0434\u043a\u0456\u043d\u0443\u0442\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0441\u043b\u0443\u0433\u0443 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e: &laquo;\u041a\u0430\u0440\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c, \u0456 \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0443\u0446\u044c \u043a\u043d\u044f\u0437\u0456, \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043d\u0430, \u0431\u043e \u0401\u043d \u0432\u0435\u0440\u043d\u044b, \u0456 \u0434\u0437\u0435\u043b\u044f \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u0446\u044f\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u042f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u044e \u0446\u044f\u0431\u0435 \u045e \u0447\u0430\u0441 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b, \u0443 \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u042f \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0443 \u0442\u0430\u0431\u0435. \u042f \u0437\u0430\u0445\u0430\u0432\u0430\u044e \u0446\u044f\u0431\u0435 \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u043a\u0430\u0431 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u044f\u0437\u043d\u044f\u043c: &ldquo;\u0412\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435&rdquo;, &ndash; \u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u0446\u0435\u043c\u0440\u044b: &ldquo;\u041f\u0430\u043a\u0430\u0436\u044b\u0446\u0435\u0441\u044f&rdquo;. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u044b \u0434\u0430\u0440\u043e\u0433\u0430\u0445, \u0456\u0445 \u043f\u0430\u0448\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044b\u0441\u044b\u0445 \u0443\u0437\u0433\u043e\u0440\u043a\u0430\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 3, 16. 17; \u041b\u043a 3, 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u045e \u042f\u0440\u0434\u0430\u043d\u0435, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f, \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u0414\u0443\u0445 \u0411\u043e\u0436\u044b \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u042f\u0433\u043e. \u0406 \u0433\u043e\u043b\u0430\u0441 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e:<span style=\"color: #ff0000;\"> *<\/span> \u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u042f\u0433\u043e \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430, \u0456 \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430 \u0437\u0430\u0433\u0443\u0447\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"504","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456 <span style=\"color: #ff0000;\">58, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u043e\u0441\u0442, \u044f\u043a\u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u041a\u0440\u044b\u0447\u044b \u043d\u0430 \u045e\u0441\u044e \u043c\u043e\u0446, \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0441\u044f. \u041f\u0430\u0434\u044b\u043c\u0456 \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u043e\u0433, \u0456 \u0440\u0430\u0441\u043a\u0430\u0436\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u043c\u0443 \u043f\u0440\u0430 \u044f\u0433\u043e \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0456 \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430 \u043f\u0440\u0430 \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435 \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u041c\u0430\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u042f\u043d\u044b \u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u041c\u044f\u043d\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0441\u0443\u0434\u043e\u045e \u0456 \u0445\u043e\u0447\u0443\u0446\u044c \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430. \u042f\u043d\u044b \u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u0427\u0430\u043c\u0443 \u043f\u0430\u0441\u0446\u0456\u043b\u0456 \u043c\u044b, \u0430 \u0422\u044b \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e, \u0447\u0430\u043c\u0443 \u045e\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u043b\u0456 \u043c\u044b \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, \u0430 \u0422\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u045e?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0443 \u0434\u0437\u0435\u043d\u044c \u043f\u043e\u0441\u0442\u0443 \u0432\u0430\u0448\u0430\u0433\u0430 \u0432\u044b \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u0435\u0446\u0435 \u0441\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435\u0446\u0435 \u045e\u0441\u0456\u0445 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u0432\u0430\u0448\u044b\u0445. \u0412\u043e\u0441\u044c \u043f\u043e\u0441\u0446\u0456\u0446\u0435 \u0432\u044b \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u044d\u0447\u0430\u043a \u0456 \u0441\u0432\u0430\u0440\u0430\u043a \u0456 \u0431&rsquo;\u0435\u0446\u0435 \u0433\u0440\u044d\u0448\u043d\u044b\u043c \u043a\u0443\u043b\u0430\u043a\u043e\u043c. \u041d\u0435 \u043f\u0430\u0441\u0446\u0456\u0446\u0435 \u0442\u0430\u043a, \u044f\u043a \u0441\u0451\u043d\u043d\u044f, \u043a\u0430\u0431 \u0431\u044b\u045e \u0447\u0443\u0442\u043d\u044b \u0432\u0430\u0448 \u0433\u043e\u043b\u0430\u0441 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u0442\u0430\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u043f\u043e\u0441\u0442, \u043a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u0435 \u0434\u0443\u0448\u0443 \u0441\u0432\u0430\u044e; \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0437\u0433\u0456\u043d\u0430\u0435 \u0433\u0430\u043b\u0430\u0432\u0443 \u0441\u0432\u0430\u044e, \u044f\u043a \u0447\u0430\u0440\u043e\u0442, \u0456 \u043b\u044f\u0436\u044b\u0446\u044c \u043d\u0430 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0435 \u0434\u044b \u043f\u043e\u043f\u0435\u043b\u0435? \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0430\u0437\u0430\u0432\u0435\u0448 \u043f\u043e\u0441\u0442\u0430\u043c \u0456 \u0434\u043d\u0451\u043c, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c \u0434\u043b\u044f \u041f\u0430\u043d\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0436 \u043d\u0435 \u0442\u0430\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u043e\u0441\u0442, \u044f\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e: \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u0446\u044c \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u043f\u0443\u0442\u044b \u043d\u044f\u0432\u043e\u043b\u0456, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0456 \u0440\u0430\u0437\u0431\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u044f\u0440\u043c\u043e? \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e; \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u044c \u0433\u043e\u043b\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0456 \u0445\u0443\u0442\u043a\u0430 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u0432\u0430\u0451 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0430 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u0430\u0446\u044c \u0446\u044f\u0431\u0435. \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u0456 \u041f\u0430\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435, \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0448 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u0456 \u0401\u043d \u0430\u0434\u043a\u0430\u0436\u0430: &laquo;\u0412\u043e\u0441\u044c \u042f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u0441\u043a\u0456\u043d\u0435\u0448 \u0437 \u0441\u044f\u0431\u0435 \u044f\u0440\u043c\u043e, \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435\u0448 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0446\u044c \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u0430\u0434\u0434\u0430\u0441\u0456 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443 \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431 \u0456 \u0434\u0443\u0448\u0443 \u0433\u0430\u0440\u043e\u0442\u043d\u0456\u043a\u0430 \u043d\u0430\u0441\u044b\u0446\u0456\u0448, \u0442\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435 \u045e \u0446\u0435\u043c\u0440\u044b \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0437\u043c\u0440\u043e\u043a \u0442\u0432\u043e\u0439 \u0431\u0443\u0434\u0437\u0435, \u044f\u043a \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c. \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0432\u0430\u0434\u0437\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u0456 \u043d\u0430\u0442\u043e\u043b\u0456\u0446\u044c \u0434\u0443\u0448\u0443 \u0442\u0432\u0430\u044e \u045e \u0447\u0430\u0441 \u0437\u0430\u0441\u0443\u0445\u0456, \u0456 \u045e\u043c\u0430\u0446\u0443\u0435 \u0442\u0432\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456. \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448, \u044f\u043a \u0430\u0440\u043e\u0448\u0430\u043d\u044b \u0441\u0430\u0434 \u0456 \u044f\u043a \u043d\u0435\u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u044c\u043d\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0432\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u0435 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u0430\u0434\u0431\u0443\u0434\u0443\u044e\u0446\u044c \u0434\u0430\u045e\u043d\u0456\u044f \u0440\u0443\u0456\u043d\u044b, \u0442\u044b \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u0448 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456 \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e. \u0406 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u043b\u043e\u043c\u044b \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u0441\u0446\u0435\u0436\u043a\u0456, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419&nbsp;<\/span> <span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0406\u0441 58, 6. 7. 9; \u041c\u0446 25, 31. 34. 35<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u043f\u043e\u0441\u0442, \u044f\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u0414\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0445\u043b\u0435\u0431\u0430\u043c \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c, \u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u0456 \u041f\u0430\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435, \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0448 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u0456 \u0401\u043d \u0430\u0434\u043a\u0430\u0436\u0430: \u0412\u043e\u0441\u044c \u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0441\u043a\u0430\u0436\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u042f\u0433\u043e: \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0431\u043e \u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u0456 \u041f\u0430\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435, \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0448 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u0456 \u0401\u043d \u0430\u0434\u043a\u0430\u0436\u0430: \u0412\u043e\u0441\u044c \u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"505","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">1, 1-22<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0433\u043d\u0451\u0442 \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0456\u043c\u0451\u043d\u044b \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0415\u0433\u0456\u043f\u0435\u0442 \u0440\u0430\u0437\u0430\u043c \u0437 \u042f\u043a\u0443\u0431\u0430\u043c. \u041a\u043e\u0436\u043d\u044b \u0437 \u0434\u043e\u043c\u0430\u043c \u0441\u0432\u0430\u0456\u043c: \u0420\u0443\u0431\u044d\u043d, \u0421\u0456\u043c\u044f\u043e\u043d, \u041b\u0435\u0432\u0456, \u042e\u0434\u0430, \u0406\u0441\u0430\u0445\u0430\u0440, \u0417\u0430\u0431\u0443\u043b\u043e\u043d \u0456 \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d, \u0414\u0430\u043d \u0456 \u041d\u044d\u0444\u0442\u0430\u043b\u0456, \u0413\u0430\u0434 \u0456 \u0410\u0448\u044d\u0440. \u0423\u0441\u0456\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0432\u044b\u0439\u0448\u043b\u0456 \u0441\u0430 \u0441\u0446\u044f\u0433\u043d\u0430 \u042f\u043a\u0443\u0431\u0430, \u0431\u044b\u043b\u043e \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442. \u0410 \u042e\u0437\u0430\u0444 \u0431\u044b\u045e \u0443\u0436\u043e \u045e \u0415\u0433\u0456\u043f\u0446\u0435. \u0406 \u043f\u0430\u043c\u0451\u0440 \u042e\u0437\u0430\u0444, \u0456 \u045e\u0441\u0435 \u044f\u0433\u043e \u0431\u0440\u0430\u0442\u044b, \u0456 \u045e\u0432\u0435\u0441\u044c \u0440\u043e\u0434 \u0456\u0445\u043d\u0456. \u0410\u043b\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0441\u043b\u0456\u0441\u044f, \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u044b\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u043b\u0456\u0441\u044f, \u0456 \u0441\u0442\u0430\u043b\u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u044b\u043c\u0456, \u0456 \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0447\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0415\u0433\u0456\u043f\u0446\u0435 \u043d\u043e\u0432\u044b \u043a\u0430\u0440\u043e\u043b\u044c, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u042e\u0437\u0430\u0444\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u043c\u0443: &laquo;\u0412\u043e\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0435\u0439\u0448\u044b \u0437\u0430 \u043d\u0430\u0441. \u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u043c \u0437 \u0456\u043c \u043c\u0443\u0434\u0440\u0430, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u045e\u0441\u044f. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0439\u043d\u0430, \u0451\u043d \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0448\u044b\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u0448\u0430\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u043f\u0430\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044f\u045e, \u043a\u0430\u0431 \u0442\u044b\u044f \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u0456 \u044f\u0433\u043e \u0446\u044f\u0436\u043a\u0456\u043c\u0456 \u043f\u0440\u0430\u0446\u0430\u043c\u0456. \u0406 \u0451\u043d \u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0433\u0430\u0440\u0430\u0434\u044b \u0434\u043b\u044f \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430\u045e: \u041f\u0456\u0442\u043e\u043c \u0456 \u0420\u0430\u043c\u0437\u044d\u0441. \u0410\u043b\u0435 \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u0456, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0451\u043d \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u045e\u0441\u044f \u0456 \u0440\u043e\u0441. \u0411\u0430\u044f\u043b\u0456\u0441\u044f \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0442\u0430\u043c\u0443 \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0456 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c. \u0420\u0430\u0431\u0456\u043b\u0456 \u0456\u0445 \u0436\u044b\u0446\u0446\u0451 \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u043d\u044b\u043c \u0430\u0434 \u0446\u044f\u0436\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u044b \u0437 \u0433\u043b\u0456\u043d\u0430\u0439 \u0456 \u0437 \u0446\u044d\u0433\u043b\u0430\u0439, \u0456 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u043d\u0430 \u043f\u043e\u043b\u0456, \u0456 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u044f\u043a\u0443\u044e \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0456 \u0456\u0445 \u0440\u0430\u0431\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0433\u0456\u043f\u0442\u0430 \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0456\u043c \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0430\u043c, \u0437 \u044f\u043a\u0456\u0445 \u0430\u0434\u043d\u0443 \u0437\u0432\u0430\u043b\u0456 \u0428\u044b\u0444\u0440\u0430, \u0430 \u0434\u0440\u0443\u0433\u0443\u044e &ndash; \u041f\u0443\u0430, \u043a\u0430\u0436\u0443\u0447\u044b \u0456\u043c: &laquo;\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0430\u043c\u0456 \u045e \u0433\u0430\u0431\u0440\u044d\u0435\u043a \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u043f\u0440\u044b \u0440\u043e\u0434\u0430\u0445, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0445\u043b\u043e\u043f\u0435\u0446, \u0437\u0430\u0431\u0456\u0432\u0430\u0439\u0446\u0435 \u044f\u0433\u043e, \u0430 \u043a\u0430\u043b\u0456 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430 &ndash; \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0436\u044b\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0456 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0411\u043e\u0433\u0430 \u0456 \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a, \u044f\u043a \u0456\u043c \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0433\u0456\u043f\u0442\u0430, \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0436\u044b\u0432\u044b\u043c\u0456 \u0445\u043b\u043e\u043f\u0446\u0430\u045e. \u0422\u0430\u0434\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0433\u0456\u043f\u0442\u0430 \u043f\u0430\u0432\u0456\u0442\u0443\u0445 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0427\u0430\u043c\u0443 \u0432\u044b \u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u0447\u0430\u043c\u0443 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0445\u043b\u043e\u043f\u0446\u0430\u045e \u0436\u044b\u0432\u044b\u043c\u0456?&raquo; \u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0443: &laquo;\u0413\u0430\u0431\u0440\u044d\u0439\u043a\u0456 \u043d\u0435 \u0442\u0430\u043a\u0456\u044f, \u044f\u043a \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u043a\u0456, \u044f\u043d\u044b \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u044f; \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0434\u0430 \u0456\u0445 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0430, \u044f\u043d\u044b \u045e\u0436\u043e \u0441\u0430\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u044f\u0446\u044c&raquo;. \u0406 \u0441\u043f\u0430\u0433\u0430\u0434\u0430\u045e \u0411\u043e\u0433 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0430\u043c, \u0430 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u045e\u0441\u044f \u0456 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e\u0441\u044f \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u044b\u043c. \u0406 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0456 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0411\u043e\u0433\u0430, \u0451\u043d \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u045e \u0456\u0445 \u0434\u0430\u043c\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0444\u0430\u0440\u0430\u043e\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u044b\u043d\u0430, \u044f\u043a\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u045e \u041d\u0456\u043b, \u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0434\u0430\u0447\u043a\u0443 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0436\u044b\u0432\u043e\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0411\u044b\u0446 15, 13-14a; \u0406\u0441 49, 26c<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443: \u0414\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u0442\u0432\u0430\u0435 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0447\u0443\u0436\u044b\u043d\u0446\u044b \u0436\u044b\u0446\u044c \u0443 \u043a\u0440\u0430\u0456, \u044f\u043a\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043a\u0440\u0430\u0435\u043c, \u0456 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u0441\u043e\u0442 \u0433\u0430\u0434\u043e\u045e \u0456\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0446\u044c \u0442\u0430\u043c \u044f\u043a \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0430 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u043e\u043c\u0443 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c, \u044f \u043f\u0430\u043a\u0430\u0440\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u041f\u0430\u043d, \u0422\u0432\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u043e\u043c\u0443 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c, \u044f \u043f\u0430\u043a\u0430\u0440\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_1_ID":"506","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">2, 1-22 <\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0456 \u045e\u0446\u0451\u043a\u0456 \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u044d\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0434\u043e\u043c\u0443 \u041b\u0435\u0432\u0456\u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u045e\u0437\u044f\u045e \u0441\u0430\u0431\u0435 \u0436\u043e\u043d\u043a\u0443 \u0437 \u0434\u0430\u0447\u043e\u043a \u041b\u0435\u0432\u0456\u044f. \u0406 \u044f\u043d\u0430 \u0437\u0430\u0447\u0430\u043b\u0430, \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0441\u044b\u043d\u0430. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u0451\u043d \u043f\u0440\u044b\u0433\u043e\u0436\u044b, \u0456 \u0445\u0430\u0432\u0430\u043b\u0430 \u044f\u0433\u043e \u0442\u0440\u044b \u043c\u0435\u0441\u044f\u0446\u044b. \u0410 \u043a\u0430\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0445\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e, \u0443\u0437\u044f\u043b\u0430 \u043a\u043e\u0448\u044b\u043a \u0437 \u0442\u0440\u044b\u0441\u043d\u044f\u0433\u0443, \u043f\u0430\u043a\u0440\u044b\u043b\u0430 \u044f\u0433\u043e \u0436\u044b\u0432\u0456\u0446\u0430\u044e \u0456 \u0441\u043c\u0430\u043b\u043e\u044e \u0456, \u043f\u0430\u043a\u043b\u0430\u045e\u0448\u044b \u0442\u0443\u0434\u044b \u0434\u0437\u0456\u0446\u044f, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0430 \u045e \u0442\u0440\u044b\u0441\u043d\u044f\u0433\u0443 \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0440\u0430\u043a\u0456. \u0410 \u0441\u044f\u0441\u0442\u0440\u0430 \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u0441\u0442\u0430\u043b\u0430 \u0437\u0434\u0430\u043b\u0451\u043a, \u043a\u0430\u0431 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u0437 \u0456\u043c \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c \u0447\u0430\u0441\u0430\u043c \u0434\u0430\u0447\u043a\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0441\u044b\u0448\u043b\u0430 \u045e\u043d\u0456\u0437, \u043a\u0430\u0431 \u0432\u044b\u043a\u0443\u043f\u0430\u0446\u0446\u0430 \u045e \u0440\u044d\u0447\u0446\u044b, \u0430 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0456 \u044f\u0435 \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u043f\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0440\u0430\u043a\u0456. \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u043b\u0430 \u045e \u0442\u0440\u044b\u0441\u043d\u044f\u0433\u0443 \u043a\u043e\u0448\u044b\u043a, \u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0430\u0434\u043d\u0443 \u0441\u0430 \u0441\u043b\u0443\u0436\u0430\u043d\u0430\u043a \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u044f\u0433\u043e. \u0410\u0434\u043a\u0440\u044b\u045e\u0448\u044b, \u044f\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u0434\u0437\u0456\u0446\u044f &ndash; \u0445\u043b\u043e\u0447\u044b\u043a\u0430, \u044f\u043a\u0456 \u043f\u043b\u0430\u043a\u0430\u045e. \u0406 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u043b\u0430 \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0413\u044d\u0442\u0430 \u0430\u0434\u043d\u043e \u0437 \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439&raquo;. \u0422\u0430\u0434\u044b \u0441\u044f\u0441\u0442\u0440\u0430 \u0445\u043b\u043e\u043f\u0447\u044b\u043a\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0434\u0430\u0447\u0446\u044d \u0444\u0430\u0440\u0430\u043e\u043d\u0430: &laquo;\u0425\u043e\u0447\u0430\u0448, \u044f \u043f\u0430\u0439\u0434\u0443 \u0456 \u043f\u0430\u043a\u043b\u0456\u0447\u0443 \u0442\u0430\u0431\u0435 \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044c\u043a\u0443 \u0437 \u0433\u0430\u0431\u0440\u044d\u0435\u043a, \u044f\u043a\u0430\u044f \u0437\u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u0437\u0456\u0446\u044f?&raquo; \u0422\u0430\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0406\u0434\u0437\u0456&raquo;. \u0406 \u043f\u0430\u0439\u0448\u043b\u0430 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430, \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u043c\u0430\u0446\u0456 \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0446\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0451\u0439 \u0434\u0430\u0447\u043a\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u043b\u043e\u043f\u0447\u044b\u043a\u0430 \u0456 \u0432\u044b\u043a\u0430\u0440\u043c\u0456 \u044f\u0433\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f \u0431\u0443\u0434\u0443 \u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0442\u0430\u0431\u0435&raquo;. \u0406 \u045e\u0437\u044f\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0445\u043b\u043e\u043f\u0447\u044b\u043a\u0430, \u0456 \u0432\u044b\u043a\u0430\u0440\u043c\u0456\u043b\u0430 \u044f\u0433\u043e, \u0430 \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u0434\u0440\u043e\u0441, \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0430 \u0434\u0430\u0447\u0446\u044d \u0444\u0430\u0440\u0430\u043e\u043d\u0430. \u0422\u0430\u044f \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u044f\u0433\u043e \u044f\u043a \u0441\u044b\u043d\u0430 \u0456 \u043d\u0430\u0437\u0432\u0430\u043b\u0430 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u042f \u0434\u0430\u0441\u0442\u0430\u043b\u0430 \u044f\u0433\u043e \u0437 \u0432\u0430\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u044b\u0440\u0430\u0441, \u0451\u043d \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u045e\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0456\u0445 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0446\u044c. \u0423\u0431\u0430\u0447\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u044f\u043a \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0456\u043d \u0431&rsquo;\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0431\u0440\u0430\u0442\u043e\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e\u0448\u044b \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u0456 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u043d\u0456\u043a\u043e\u0433\u0430, \u0451\u043d \u0437\u0430\u0431\u0456\u045e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0456\u043d\u0430 \u0456 \u0441\u0445\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u045e \u043f\u044f\u0441\u043a\u0443. \u041f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0441\u0432\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u0434\u0432\u0430 \u0433\u0430\u0431\u0440\u044d\u0456, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u0430\u043c\u0443: &laquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u0431&rsquo;\u0435\u0448 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e?&raquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0456 \u0441\u0443\u0434\u0434\u0437\u0451\u044e \u043d\u0430\u0434 \u043d\u0430\u043c\u0456? \u0426\u0456 \u0442\u044b \u0445\u043e\u0447\u0430\u0448 \u0437\u0430\u0431\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u044f\u043a \u0437\u0430\u0431\u0456\u045e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0456\u043d\u0430?&raquo; \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u0441\u0442\u0430\u043b\u0430 \u0432\u044f\u0434\u043e\u043c\u0430\u0439 \u0442\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d \u043f\u0430\u0447\u0443\u045e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0451\u043d \u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0437\u0430\u0431\u0456\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f. \u0410\u043b\u0435 \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0446\u0451\u043a \u0430\u0434 \u044f\u0433\u043e \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u045e \u0437\u044f\u043c\u043b\u0456 \u041c\u0430\u0434\u044b\u044f\u043d, \u0456 \u0441\u0435\u045e \u043a\u0430\u043b\u044f \u0441\u0442\u0443\u0434\u043d\u0456. \u0410 \u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u041c\u0430\u0434\u044b\u044f\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u0435\u043c \u0434\u0430\u0447\u043e\u043a. \u042f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0441\u0442\u0443\u0434\u043d\u0456 \u043d\u0430\u0431\u0440\u0430\u0446\u044c \u0432\u0430\u0434\u044b. \u0406 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u043a\u0430\u0440\u044b\u0442\u044b, \u043a\u0430\u0431 \u043d\u0430\u043f\u0430\u0456\u0446\u044c \u0441\u0442\u0430\u0442\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0456. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043f\u0430\u0441\u0442\u0443\u0445\u0456 \u0456 \u043f\u0440\u0430\u0433\u043d\u0430\u043b\u0456 \u0456\u0445. \u0422\u0430\u0434\u044b \u045e\u0441\u0442\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u0456\u0445, \u0456 \u043d\u0430\u043f\u0430\u0456\u045e \u0456\u0445\u043d\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a. \u0412\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u044f\u043d\u044b \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0456 \u0420\u0430\u0433\u0443\u044d\u043b\u044f, \u0430 \u0451\u043d \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: &laquo;\u0427\u0430\u043c\u0443 \u0441\u0451\u043d\u043d\u044f \u0432\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0440\u0430\u043d\u0435\u0439?&raquo; \u042f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041d\u0435\u0439\u043a\u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0456\u043d \u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u0440\u0443\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u045e \u0456 \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0431\u0440\u0430\u045e \u043d\u0430\u043c \u0432\u0430\u0434\u044b, \u0456 \u043d\u0430\u043f\u0430\u0456\u045e \u0430\u0432\u0435\u0447\u0430\u043a&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u0447\u043a\u0430\u043c: &laquo;\u0410 \u0434\u0437\u0435 \u0451\u043d? \u0427\u0430\u043c\u0443 \u0432\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u043c\u0443\u0436\u0430 \u0433\u044d\u0442\u0430\u0433\u0430? \u041f\u0430\u043a\u043b\u0456\u0447\u0446\u0435 \u044f\u0433\u043e \u0437&rsquo;\u0435\u0441\u0446\u0456 \u0445\u043b\u0435\u0431\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0422\u043e\u0439 \u0432\u044b\u0434\u0430\u045e \u0437\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0441\u0432\u0430\u044e \u0434\u0430\u0447\u043a\u0443 \u0421\u044d\u0444\u043e\u0440\u0443. \u042f\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043c\u0443 \u0441\u044b\u043d\u0430, \u0456 \u0451\u043d \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e \u0456\u043c\u0435\u043c \u0413\u0435\u0440\u0448\u043e\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u0441\u0442\u0430\u045e \u043f\u0440\u044b\u0445\u0430\u0434\u043d\u0435\u043c \u043d\u0430 \u0447\u0443\u0436\u043e\u0439 \u0437\u044f\u043c\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 11, 24-25. 26. 27<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0441\u0442\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u0451\u043d \u043d\u0435 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u044f\u0433\u043e \u043b\u0456\u0447\u044b\u043b\u0456 \u0441\u044b\u043d\u0430\u043c \u0434\u0430\u0447\u043a\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0430; \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u0430 \u043d\u0435 \u043c\u0435\u0446\u044c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0430\u0434 \u0447\u0430\u0441\u043e\u0432\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0451\u043d \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u0456\u0447\u044b\u045e \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c, \u0447\u044b\u043c \u0443\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u0415\u0433\u0456\u043f\u0442\u0430, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0415\u0433\u0456\u043f\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0451\u043d \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u0456\u0447\u044b\u045e \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c, \u0447\u044b\u043c \u0443\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u0415\u0433\u0456\u043f\u0442\u0430, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0415\u0433\u0456\u043f\u0435\u0442.<\/p>\r\n"}, {"GCH_CH_1_ID":"507","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">3, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u0451 \u0411\u043e\u0436\u0430\u0433\u0430 \u0456\u043c\u044f <\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0441\u0432\u0456\u045e \u0430\u0432\u0435\u0447\u0430\u043a \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u0441\u0446\u044f \u0415\u0442\u0440\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043c\u0430\u0434\u044b\u044f\u043d\u0441\u043a\u0430\u0433\u0430. \u0406 \u0437\u0430\u0432\u0451\u045e \u0451\u043d \u0430\u0432\u0435\u0447\u0430\u043a \u0434\u0430\u043b\u0451\u043a\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0413\u0430\u0440\u044d\u0431\u0430, \u0411\u043e\u0436\u0430\u0439 \u0433\u0430\u0440\u044b. \u0422\u0430\u043c \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u044f\u043c\u0443 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u045e \u043f\u043e\u043b\u044b\u043c\u0456 \u0430\u0433\u043d\u044e \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u0446\u044f\u0440\u043d\u043e\u0432\u0430\u0433\u0430 \u043a\u0443\u0441\u0442\u0430. \u0406 \u0431\u0430\u0447\u044b\u045e \u0451\u043d, \u044f\u043a \u043a\u0443\u0441\u0442 \u043f\u0430\u043b\u0430\u045e \u0430\u0433\u043d\u0451\u043c, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0433\u0430\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u041f\u0430\u0434\u044b\u0434\u0443 \u0431\u043b\u0456\u0436\u044d\u0439 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0436\u0443 \u043d\u0430 \u0433\u044d\u0442\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0437&rsquo;\u044f\u0432\u0443: \u0447\u0430\u043c\u0443 \u043a\u0443\u0441\u0442 \u043d\u0435 \u0437\u0433\u0430\u0440\u0430\u0435&raquo;. \u0423\u0431\u0430\u0447\u044b\u045e \u041f\u0430\u043d, \u0448\u0442\u043e \u0451\u043d \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c, \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u043a\u0443\u0441\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041c\u0430\u0439\u0441\u0435\u0439, \u041c\u0430\u0439\u0441\u0435\u0439&raquo;. \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u043e\u0441\u044c \u044f&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433: &laquo;\u041d\u0435 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0439\u0441\u044f \u0441\u044e\u0434\u044b, \u0437\u0434\u044b\u043c\u0456 \u0430\u0431\u0443\u0442\u0430\u043a \u0437 \u043d\u043e\u0433 \u0442\u0432\u0430\u0456\u0445, \u0431\u043e \u043c\u0435\u0441\u0446\u0430, \u043d\u0430 \u044f\u043a\u0456\u043c \u0442\u044b \u0441\u0442\u0430\u0456\u0448, \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u0430\u044f \u0437\u044f\u043c\u043b\u044f&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u0448\u0447\u044d: &laquo;\u042f &ndash; \u0411\u043e\u0433 \u0430\u0439\u0446\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0411\u043e\u0433 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0411\u043e\u0433 \u0406\u0441\u0430\u0430\u043a\u0430, \u0411\u043e\u0433 \u042f\u043a\u0443\u0431\u0430&raquo;. \u0406 \u0441\u0445\u0430\u0432\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u044f\u045e\u0441\u044f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &laquo;\u042f \u0434\u043e\u0431\u0440\u0430 \u0431\u0430\u0447\u044b\u045e \u043f\u0430\u043a\u0443\u0442\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u0433\u043e \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u042f \u0447\u0443\u045e \u043a\u0440\u044b\u043a \u044f\u0433\u043e\u043d\u044b \u0437-\u0437\u0430 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u044f\u0433\u043e. \u042f \u0432\u0435\u0434\u0430\u044e \u044f\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0422\u0430\u043c\u0443 \u0441\u044b\u0448\u043e\u045e \u042f, \u043a\u0430\u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e \u0437 \u0440\u0443\u043a \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u0456 \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u0437 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u045e \u0437\u044f\u043c\u043b\u044e \u0434\u043e\u0431\u0440\u0443\u044e \u0456 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u043d\u0443\u044e, \u0434\u0437\u0435 \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e \u0456 \u043c\u0451\u0434. \u0412\u043e\u0441\u044c \u043a\u0440\u044b\u043a \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041c\u044f\u043d\u0435, \u0456 \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u0443\u0446\u0456\u0441\u043a \u0456\u0445\u043d\u0456, \u044f\u043a\u0456\u043c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0446\u044c \u0456\u0445. \u0410\u043b\u0435 \u0456\u0434\u0437\u0456, \u042f \u043f\u0430\u0448\u043b\u044e \u0446\u044f\u0431\u0435 \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0431 \u0442\u044b \u0432\u044b\u0432\u0435\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439, \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433\u0443: &laquo;\u0425\u0442\u043e \u044f, \u043a\u0430\u0431 \u0456\u0441\u0446\u0456 \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u0432\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0415\u0433\u0456\u043f\u0442\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043f\u0430\u0439\u0434\u0443 \u0437 \u0442\u0430\u0431\u043e\u044e. \u0406 \u0432\u043e\u0441\u044c \u0437\u043d\u0430\u043a \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u0446\u044f\u0431\u0435: \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u0434\u0437\u0435\u0448 \u043d\u0430\u0440\u043e\u0434 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u0446\u0435\u0441\u044f \u0411\u043e\u0433\u0443 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0440\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433\u0443: &laquo;\u0412\u043e\u0441\u044c \u044f \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0436\u0443 \u0456\u043c: \u0411\u043e\u0433 \u0430\u0439\u0446\u043e\u045e \u0432\u0430\u0448\u044b\u0445 \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441. \u0410 \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u043c\u044f\u043d\u0435: &ldquo;\u042f\u043a\u043e\u0435 \u045e \u042f\u0433\u043e \u0456\u043c\u044f?&rdquo; \u0428\u0442\u043e \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u043c\u043d\u0435 \u0456\u043c?&raquo; \u0422\u0430\u0434\u044b \u0411\u043e\u0433 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u042f \u0451\u0441\u0446\u044c, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c&raquo;. \u0406 \u0434\u0430\u0434\u0430\u045e: &laquo;\u0422\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &ldquo;\u042f\u043a\u0456 \u0451\u0441\u0446\u044c&rdquo; \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0434\u0430\u043b\u0435\u0439 \u0411\u043e\u0433 \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0422\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041f\u0430\u043d, \u0411\u043e\u0433 \u0430\u0439\u0446\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u0411\u043e\u0433 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0411\u043e\u0433 \u0406\u0441\u0430\u0430\u043a\u0430 \u0456 \u0411\u043e\u0433 \u042f\u043a\u0443\u0431\u0430 \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441. \u0413\u044d\u0442\u0430 \u0456\u043c\u044f \u041c\u0430\u0451 \u043d\u0430\u0432\u0435\u043a\u0456 \u0456 \u0433\u044d\u0442\u0430 \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u041c\u044f\u043d\u0435 \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435. \u0406\u0434\u0437\u0456, \u0437\u0431\u044f\u0440\u044b \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u041f\u0430\u043d, \u0411\u043e\u0433 \u0430\u0439\u0446\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u0411\u043e\u0433 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0411\u043e\u0433 \u0406\u0441\u0430\u0430\u043a\u0430 \u0456 \u0411\u043e\u0433 \u042f\u043a\u0443\u0431\u0430, \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043c\u043d\u0435 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u042f \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u0432\u0430\u0441 \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u0432\u0430\u043c\u0456 \u045e \u0415\u0433\u0456\u043f\u0446\u0435. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e: \u042f \u0432\u044b\u0432\u0435\u0434\u0443 \u0432\u0430\u0441 \u0437 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430 \u045e \u0437\u044f\u043c\u043b\u044e \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430\u045e, \u0445\u0435\u0442\u0430\u045e, \u0430\u043c\u0430\u0440\u044d\u044f\u045e, \u0444\u044d\u0440\u044d\u0437\u0435\u044f\u045e, \u0445\u0435\u0432\u0435\u044f\u045e \u0456 \u0435\u0432\u0443\u0441\u0435\u044f\u045e &ndash; \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c. \u0406 \u044f\u043d\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0442\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0456 \u0442\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u0441\u043a\u0430\u0436\u0430\u0448 \u044f\u043c\u0443: \u041f\u0430\u043d, \u0411\u043e\u0433 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0441\u0443\u0441\u0442\u0440\u044d\u045e\u0441\u044f \u0437 \u043d\u0430\u043c\u0456. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u043d\u0430\u043c \u043f\u0430\u0439\u0441\u0446\u0456 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u043d\u0430 \u0442\u0440\u044b \u0434\u043d\u0456 \u0445\u0430\u0434\u0437\u044c\u0431\u044b, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u042f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0433\u0456\u043f\u0442\u0430 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u0430\u043c \u043f\u0430\u0439\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0443\u0448\u0430\u043d\u044b \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e. \u0422\u0430\u043c\u0443 \u042f \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0456 \u045e\u0434\u0430\u0440\u0443 \u0415\u0433\u0456\u043f\u0435\u0442 \u0443\u0441\u0456\u043c\u0456 \u0446\u0443\u0434\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u044f\u043a\u0456\u044f \u045e\u0447\u044b\u043d\u044e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0451\u043d \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419&nbsp;<\/span> <span style=\"color: #ff0000;\">\u0417\u044b\u0445 3, 14; \u0406\u0441 43, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: \u042f \u0451\u0441\u0446\u044c, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u042f\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u041f\u0430\u043d, \u042f \u0451\u0441\u0446\u044c, \u0456 \u0431\u0435\u0437 \u041c\u044f\u043d\u0435 \u043d\u044f\u043c\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u042f\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"511","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">5, 1 &ndash; 6, 1<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0433\u043d\u0451\u0442 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0440\u044b\u0448\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0443: &laquo;\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456&raquo;. \u0410\u043b\u0435 \u0444\u0430\u0440\u0430\u043e\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u0442\u0430\u043a\u0456 \u041f\u0430\u043d, \u043a\u0430\u0431 \u044f \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c? \u042f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;. \u0422\u0430\u0434\u044b \u044f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0411\u043e\u0433 \u0433\u0430\u0431\u0440\u044d\u044f\u045e \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u043d\u0430\u043c \u043f\u0440\u0430\u0439\u0441\u0446\u0456 \u0434\u0430\u0440\u043e\u0433\u0430\u044e \u045e \u0442\u0440\u044b \u0434\u043d\u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u043a\u0430\u0431 \u0401\u043d \u043d\u0435 \u045e\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0441\u043b\u043e\u0432\u0430\u043c \u0430\u0431\u043e \u043c\u044f\u0447\u043e\u043c&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0433\u0456\u043f\u0442\u0430: &laquo;\u0427\u0430\u043c\u0443 \u0432\u044b, \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d, \u0445\u043e\u0447\u0430\u0446\u0435 \u0430\u0434\u0430\u0440\u0432\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0430\u0434 \u044f\u0433\u043e \u0441\u043f\u0440\u0430\u045e? \u0412\u044f\u0440\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0446&raquo;. \u0406 \u0434\u0430\u0434\u0430\u045e \u0444\u0430\u0440\u0430\u043e\u043d: &laquo;\u0412\u043e\u0441\u044c, \u043d\u0430\u0440\u043e\u0434 \u043a\u0440\u0430\u044e \u0446\u044f\u043f\u0435\u0440 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456, \u0430 \u0432\u044b \u0445\u043e\u0447\u0430\u0446\u0435 \u0430\u0434\u0430\u0440\u0432\u0430\u0446\u044c \u0456\u0445 \u0430\u0434 \u043f\u0440\u0430\u0446 \u044f\u0433\u043e\u043d\u044b\u0445?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0444\u0430\u0440\u0430\u043e\u043d \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0433\u0430\u043d\u044f\u0442\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0430\u043c \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0430\u043b\u043e\u043c\u0443 \u0434\u043b\u044f \u0432\u044b\u0440\u0430\u0431\u0443 \u0446\u044d\u0433\u043b\u044b, \u044f\u043a \u0443\u0447\u043e\u0440\u0430 \u0456 \u043f\u0430\u0437\u0430\u045e\u0447\u043e\u0440\u0430. \u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u044f\u0445\u0430\u0439 \u0441\u0430\u043c\u0456 \u0456\u0434\u0443\u0446\u044c \u0456 \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0441\u0430\u0431\u0435 \u0441\u0430\u043b\u043e\u043c\u0443. \u0410 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0443\u044e \u0456\u043c \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0446\u044d\u0433\u043b\u044b, \u044f\u043a\u0443\u044e \u044f\u043d\u044b \u0440\u0430\u0431\u0456\u043b\u0456 \u045e\u0447\u043e\u0440\u0430 \u0456 \u043f\u0430\u0437\u0430\u045e\u0447\u043e\u0440\u0430, \u043d\u0435 \u0437\u043c\u044f\u043d\u0448\u0430\u0439\u0446\u0435, \u0431\u043e \u044f\u043d\u044b \u0433\u0443\u043b\u044c\u0442\u0430\u0456, \u0442\u0430\u043c\u0443 \u0456 \u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u041f\u043e\u0439\u0434\u0437\u0435\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0411\u043e\u0433\u0443&rdquo;. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0446\u0430 \u0433\u044d\u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u0442\u0430\u043d\u0435 \u0446\u044f\u0436\u044d\u0439\u0448\u0430\u0439, \u043a\u0430\u0431 \u0437\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0451\u0439, \u0430 \u043d\u0435 \u0441\u0445\u0456\u043b\u044f\u043b\u0456\u0441\u044f \u0434\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0441\u043b\u043e\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b\u0439\u0448\u043b\u0456 \u043f\u0430\u0433\u0430\u043d\u044f\u0442\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0456 \u044f\u0433\u043e, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0444\u0430\u0440\u0430\u043e\u043d: &ldquo;\u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u0430\u043b\u043e\u043c\u044b. \u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u0437\u0431\u0456\u0440\u0430\u0439\u0446\u0435 \u0441\u0430\u043c\u0456 \u0441\u0430\u043b\u043e\u043c\u0443, \u0434\u0437\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435, \u0431\u043e \u043d\u0456\u044f\u043a \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0435\u043d\u0448\u0430\u043d\u0430 \u043f\u0440\u0430\u0446\u0430 \u0432\u0430\u0448\u0430\u044f&rdquo;&raquo;. \u0406 \u0440\u0430\u0437\u044b\u0448\u043e\u045e\u0441\u044f \u043d\u0430\u0440\u043e\u0434 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0441\u0446\u0435\u0440\u043d\u0435 \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u0430\u043b\u043e\u043c\u044b. \u0410 \u043f\u0430\u0433\u0430\u043d\u044f\u0442\u044b\u044f \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u0432\u0430\u043b\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u0443, \u044f\u043a \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0432\u0430\u043c \u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u0430\u043b\u043e\u043c\u0443&raquo;. \u041d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0430\u045e, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u0437 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u0445 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c\u0456 \u043f\u0430\u0433\u0430\u043d\u044f\u0442\u044b\u044f \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0437\u0431\u0456\u0432\u0430\u043b\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0427\u0430\u043c\u0443 \u0432\u044b \u043d\u0456 \u045e\u0447\u043e\u0440\u0430, \u043d\u0456 \u043f\u0430\u0437\u0430\u045e\u0447\u043e\u0440\u0430, \u043d\u0456 \u0441\u0451\u043d\u043d\u044f \u043d\u0435 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0456 \u044f\u043a \u0440\u0430\u043d\u0435\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430 \u0432\u044b\u0440\u0430\u0431\u0443 \u0446\u044d\u0433\u043b\u044b?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u0442\u0430\u043a \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456? \u0426\u044f\u043f\u0435\u0440 \u0442\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u043d\u0435 \u0434\u0430\u044e\u0446\u044c \u0441\u0430\u043b\u043e\u043c\u044b \u0456 \u043a\u0430\u0436\u0443\u0446\u044c \u043d\u0430\u043c: &ldquo;\u0420\u0430\u0431\u0456\u0446\u0435 \u0446\u044d\u0433\u043b\u0443&rdquo;. \u0406 \u0432\u043e\u0441\u044c \u0437\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0442\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0456 \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u044f\u0446\u044c \u043d\u0430\u0440\u043e\u0434&raquo;. \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0412\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u043b\u044f\u043d\u0456\u0432\u044b\u044f \u0456 \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0430\u0446\u0435: &ldquo;\u041f\u043e\u0439\u0434\u0437\u0435\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443&rdquo;. \u0426\u044f\u043f\u0435\u0440 \u0456\u0434\u0437\u0456\u0446\u0435 \u0456 \u043f\u0440\u0430\u0446\u0443\u0439\u0446\u0435. \u0410\u043b\u0435 \u0441\u0430\u043b\u043e\u043c\u044b \u043d\u0435 \u0434\u0430\u0434\u0443\u0446\u044c \u0432\u0430\u043c, \u0430\u0434\u043d\u0430\u043a \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0443\u044e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0446\u044d\u0433\u043b\u044b \u0437\u0440\u0430\u0431\u0456\u0446\u0435&raquo;. \u0406 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u0432\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041d\u0435 \u0430\u0434\u044b\u043c\u0430\u0439\u0446\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u0434 \u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0432\u044b\u0440\u0430\u0431\u0443 \u0446\u044d\u0433\u043b\u044b \u0432\u0430\u0448\u0430\u0439&raquo;. \u041a\u0430\u043b\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0441\u043f\u0430\u0442\u043a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430, \u044f\u043a\u0456\u044f \u0456\u0445 \u0447\u0430\u043a\u0430\u043b\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0456\u043c: &laquo;\u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0432\u0430\u0441 \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u0446\u044c, \u0431\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u043d\u0430\u0441 \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u044b\u043c\u0456 \u045e \u0432\u0430\u0447\u0430\u0445 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u044f\u0433\u043e\u043d\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e. \u0412\u044b \u0434\u0430\u043b\u0456 \u0456\u043c \u0443 \u0440\u0443\u043a\u0456 \u043c\u0435\u0447, \u043a\u0430\u0431 \u044f\u043d\u044b \u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u043d\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d\u0435, \u0447\u0430\u043c\u0443 \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a\u0443\u044e \u043a\u0440\u044b\u045e\u0434\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u043c\u0443? \u0427\u0430\u043c\u0443 \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435? \u0417 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u0422\u0432\u0430\u0451 \u0456\u043c\u044f, \u0451\u043d \u043f\u0430\u0447\u0430\u045e \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0433\u043e\u0440\u0448 \u0437 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u0422\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u043e\u0431\u0456\u0448 \u0434\u043b\u044f \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0426\u044f\u043f\u0435\u0440 \u0443\u0431\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0444\u0430\u0440\u0430\u043e\u043d\u0443, \u0431\u043e \u043c\u043e\u0446\u043d\u0430\u044f \u0440\u0443\u043a\u0430 \u043f\u0440\u044b\u043c\u0443\u0441\u0456\u0446\u044c \u044f\u0433\u043e \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0456\u0445 \u0456 \u043f\u0440\u0430\u0433\u043d\u0430\u0446\u044c \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0440\u0430\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0417\u044b\u0445 5, 1. 3.<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: <span style=\"color: #ff0000;\">*<\/span> \u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0433\u0430\u0431\u0440\u044d\u044f\u045e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"512","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">6, 2-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0411\u043e\u0433 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u042f &ndash; \u041f\u0430\u043d, \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443 \u044f\u043a \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0433, \u0430\u043b\u0435 \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u0433\u043e &ndash; \u041f\u0430\u043d, \u042f \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0456\u043c. \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0456\u043c\u0456 \u0441\u0432\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0448\u0442\u043e \u0434\u0430\u043c \u0456\u043c \u0437\u044f\u043c\u043b\u044e \u041a\u0430\u043d\u0430\u0430\u043d, \u0437\u044f\u043c\u043b\u044e, \u0443 \u044f\u043a\u043e\u0439 \u0436\u044b\u043b\u0456, \u0434\u0437\u0435 \u044f\u043d\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456\u0441\u044f. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0447\u0443\u045e \u0435\u043d\u043a\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u0445 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0443 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u0456 \u0437\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u042f &ndash; \u041f\u0430\u043d, \u0432\u044b\u0432\u0435\u0434\u0443 \u0432\u0430\u0441 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0432\u0430\u0441 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0440\u0430\u0441\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u043f\u043b\u044f\u0447\u043e\u043c \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u043f\u0440\u044b\u0441\u0443\u0434\u0430\u043c\u0456. \u0406 \u0432\u0430\u0437\u044c\u043c\u0443 \u0432\u0430\u0441 \u0441\u0430\u0431\u0435 \u044f\u043a \u043d\u0430\u0440\u043e\u0434, \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u043c \u0411\u043e\u0433\u0430\u043c, \u0456 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f &ndash; \u0411\u043e\u0433 \u0432\u0430\u0448, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443. \u042f \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0432\u0430\u0441 \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0437 \u043f\u0430\u0434\u043d\u044f\u0442\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0441\u0432\u0430\u0451\u044e \u042f \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0434\u0430\u0446\u044c \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0406\u0441\u0430\u0430\u043a\u0443 \u0456 \u042f\u043a\u0443\u0431\u0443. \u042f \u0434\u0430\u043c \u0432\u0430\u043c \u044f\u0435 \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c. \u042f &ndash; \u041f\u0430\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430\u043b\u0435, \u0443\u043f\u0430\u045e\u0448\u044b \u0434\u0443\u0445\u0430\u043c \u0456 \u0437-\u0437\u0430 \u0446\u044f\u0436\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u044f\u043d\u044b \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u044f\u0433\u043e. \u0406 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0406\u0434\u0437\u0456, \u0437\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0415\u0433\u0456\u043f\u0442\u0430, \u043a\u0430\u0431 \u0451\u043d \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456&raquo;. \u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430: &laquo;\u0412\u043e\u0441\u044c, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u043c\u044f\u043d\u0435, \u0434\u044b\u043a \u044f\u043a \u0436\u0430 \u043c\u044f\u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u0444\u0430\u0440\u0430\u043e\u043d? \u042f \u043c\u0430\u044e \u0446\u044f\u0436\u043a\u0456\u044f \u0432\u0443\u0441\u043d\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430, \u0456 \u0434\u0430\u045e \u0456\u043c \u0437\u0430\u0433\u0430\u0434 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0434\u043b\u044f \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 9\u0430. 10\u0430; \u0417\u044b\u0445 6, 7\u0430. 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0432\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f, \u041f\u0430\u043d, \u0432\u044b\u0432\u0435\u0434\u0443 \u0432\u0430\u0441 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0432\u0430\u0441 \u0443\u0437\u043d\u044f\u0442\u0430\u044e \u0440\u0443\u043a\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0432\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"513","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">6, 29 &ndash; 7, 25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u044f \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u044f \u043a\u0430\u0440\u0430 <\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f &ndash; \u041f\u0430\u043d. \u0421\u043a\u0430\u0436\u044b \u0444\u0430\u0440\u0430\u043e\u043d\u0443, \u043a\u0430\u0440\u0430\u043b\u044e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u043c\u0443, \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435&raquo;. \u0410 \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443: &laquo;\u042f \u043c\u0430\u044e \u0432\u0443\u0441\u043d\u044b \u0437\u0430\u0456\u043a\u0456, \u044f\u043a \u0436\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u043c\u044f\u043d\u0435 \u0444\u0430\u0440\u0430\u043e\u043d?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456, \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0431\u043e\u0433\u0430\u043c \u0434\u043b\u044f \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0430 \u0410\u0430\u0440\u043e\u043d, \u0431\u0440\u0430\u0442 \u0442\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c. \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0430\u0437\u0430\u0446\u044c \u044f\u043c\u0443 \u0443\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u042f \u0442\u0430\u0431\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u044e, \u0430 \u0410\u0430\u0440\u043e\u043d, \u0431\u0440\u0430\u0442 \u0442\u0432\u043e\u0439, \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0440\u0430\u044e. \u0410\u043b\u0435 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u045e\u043f\u0430\u0440\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u0443 \u0437\u043d\u0430\u043a\u0456 \u0441\u0432\u0430\u0435 \u0456 \u0446\u0443\u0434\u044b \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u0424\u0430\u0440\u0430\u043e\u043d \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u0432\u0430\u0441. \u0422\u0430\u0434\u044b \u042f \u043f\u0430\u0434\u044b\u043c\u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u0432\u044b\u0432\u0435\u0434\u0443 \u0441\u0432\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0456, \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043a\u0430\u0440\u044b. \u0406 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u042f \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043d\u0430\u0434 \u0415\u0433\u0456\u043f\u0442\u0430\u043c \u0456 \u0432\u044b\u0432\u0435\u0434\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0434 \u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u043c \u041f\u0430\u043d. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u041c\u0430\u0439\u0441\u0435\u044e \u0431\u044b\u043b\u043e \u0432\u043e\u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0433\u0430\u0434\u043e\u045e, \u0410\u0430\u0440\u043e\u043d\u0443 \u0436 &ndash; \u0432\u043e\u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0442\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e \u0456 \u0410\u0430\u0440\u043e\u043d\u0443: &laquo;\u041a\u0430\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d \u0441\u043a\u0430\u0436\u0430 \u0432\u0430\u043c: &ldquo;\u041f\u0430\u043a\u0430\u0436\u044b\u0446\u0435 \u0446\u0443\u0434 \u0441\u0432\u043e\u0439&rdquo;, &ndash; \u0442\u0430\u0434\u044b \u0441\u043a\u0430\u0436\u0430\u0448 \u0410\u0430\u0440\u043e\u043d\u0443: \u0412\u0430\u0437\u044c\u043c\u0456 \u043a\u0456\u0439 \u0456 \u043a\u0456\u043d\u044c \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c, \u0430 \u0451\u043d \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u0437\u043c\u044f\u044e&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d \u043f\u0440\u044b\u0431\u044b\u043b\u0456 \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a, \u044f\u043a \u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d. \u0406 \u043a\u0456\u043d\u0443\u045e \u0410\u0430\u0440\u043e\u043d \u0441\u0432\u043e\u0439 \u043a\u0456\u0439 \u043f\u0435\u0440\u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c \u0456 \u044f\u0433\u043e \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u0430 \u0451\u043d \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e\u0441\u044f \u045e \u0437\u043c\u044f\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0444\u0430\u0440\u0430\u043e\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0456 \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u044f\u045e, \u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u044f \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0447\u0430\u0440\u0430\u043c\u0456 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435. \u041a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u043a\u0456\u043d\u0443\u045e \u0441\u0432\u043e\u0439 \u043a\u0456\u0439, \u0430 \u0451\u043d \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e\u0441\u044f \u045e \u0437\u043c\u044f\u044e. \u0410\u0434\u043d\u0430\u043a \u043a\u0456\u0439 \u0410\u0430\u0440\u043e\u043d\u0430 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u0456\u0445 \u043a\u0456\u0456. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430, \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u045e\u043f\u0430\u0440\u0442\u044b\u043c, \u0456 \u0451\u043d \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e \u0456\u0445, \u044f\u043a \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0421\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u045e\u043f\u0430\u0440\u0442\u0430\u0435, \u0451\u043d \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434. \u0420\u0430\u043d\u0456\u0446\u0430\u0439 \u043f\u0430\u0439\u0434\u0437\u0456 \u0434\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0432\u0430\u0434\u044b, \u0456 \u043f\u0430\u0441\u043f\u044f\u0448\u044b \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u044f\u043c\u0443, \u0434\u0430 \u0431\u0435\u0440\u0430\u0433\u0443 \u0440\u0430\u043a\u0456. \u0412\u0430\u0437\u044c\u043c\u0456 \u045e \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043a\u0456\u0439, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e\u0441\u044f \u045e \u0437\u043c\u044f\u044e, \u0456 \u0441\u043a\u0430\u0436\u044b \u044f\u043c\u0443: \u041f\u0430\u043d, \u0411\u043e\u0433 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0437 \u0437\u0430\u0433\u0430\u0434\u0430\u043c \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u041c\u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0422\u044b \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u045e \u041c\u044f\u043d\u0435. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u041f\u0430 \u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u0435\u0448, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d. \u0412\u043e\u0441\u044c \u042f \u045e\u0434\u0430\u0440\u0443 \u043a\u0456\u0435\u043c, \u044f\u043a\u0456 \u043c\u0430\u044e \u045e \u0440\u0443\u043a\u0430\u0445, \u043f\u0430 \u0432\u043e\u0434\u0430\u0445 \u0440\u0430\u043a\u0456, \u0456 \u044f\u043d\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u0430\u0446\u0446\u0430 \u045e \u043a\u0440\u043e\u045e. \u0406 \u0440\u044b\u0431\u044b, \u0448\u0442\u043e \u045e \u0440\u0430\u0446\u044d, \u0432\u044b\u043c\u0440\u0443\u0446\u044c, \u0456 \u0440\u0430\u043a\u0430 \u0437\u0430\u0441\u043c\u044f\u0440\u0434\u0437\u0456\u0446\u044c \u0442\u0430\u043a, \u0448\u0442\u043e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0431\u0440\u044b\u0434\u043a\u0430 \u043f\u0456\u0446\u044c \u0432\u0430\u0434\u0443 \u0437 \u044f\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0421\u043a\u0430\u0436\u044b \u0410\u0430\u0440\u043e\u043d\u0443, \u043a\u0430\u0431 \u0451\u043d \u0443\u0437\u044f\u045e \u0441\u0432\u043e\u0439 \u043a\u0456\u0439 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456 \u0415\u0433\u0456\u043f\u0442\u0430, \u043d\u0430\u0434 \u0441\u0442\u0440\u0443\u043c\u044f\u043d\u044f\u043c\u0456 \u0456 \u043a\u0430\u043d\u0430\u043b\u0430\u043c\u0456, \u043d\u0430\u0434 \u0430\u0437\u0451\u0440\u0430\u043c\u0456 \u0456 \u045e\u0441\u0456\u043c\u0456 \u0432\u0430\u0434\u0430\u0437\u0431\u043e\u0440\u043d\u0456\u043a\u0430\u043c\u0456 \u0456\u0445\u043d\u0456\u043c\u0456, \u0456 \u044f\u043d\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u0430\u0446\u0446\u0430 \u045e \u043a\u0440\u043e\u045e. \u0406 \u0431\u0443\u0434\u0437\u0435 \u043a\u0440\u043e\u045e \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0443 \u0434\u0440\u0430\u045e\u043b\u044f\u043d\u044b\u043c \u0456 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u043c \u043f\u043e\u0441\u0443\u0434\u0437\u0435&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d. \u0410\u0430\u0440\u043e\u043d \u043f\u0430\u0434\u043d\u044f\u045e \u043a\u0456\u0439 \u0456 \u045e\u0434\u0430\u0440\u044b\u045e \u0456\u043c \u0432\u043e\u0434\u044b \u0440\u0430\u043a\u0456 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u044f\u0433\u043e \u0441\u043b\u0443\u0433\u0430\u045e. \u0406 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u045e\u0441\u044f \u0432\u0430\u0434\u0430 \u045e \u043a\u0440\u043e\u045e. \u0420\u044b\u0431\u0430 \u045e \u0440\u0430\u0446\u044d \u0432\u044b\u043c\u0435\u0440\u043b\u0430, \u0430 \u0440\u0430\u043a\u0430 \u0437\u0430\u0441\u043c\u044f\u0440\u0434\u0437\u0435\u043b\u0430 \u0442\u0430\u043a, \u0448\u0442\u043e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c \u0441\u0442\u0430\u043b\u0430 \u0431\u0440\u044b\u0434\u043a\u0430 \u043f\u0456\u0446\u044c \u0437 \u044f\u0435 \u0432\u0430\u0434\u0443. \u041a\u0440\u043e\u045e \u0431\u044b\u043b\u0430 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u044f \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u043c \u0447\u0430\u0440\u0430\u043c. \u0406 \u0441\u0442\u0430\u043b\u0430 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0456 \u0451\u043d \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e \u0456\u0445, \u044f\u043a \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d. \u0410\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0444\u0430\u0440\u0430\u043e\u043d \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c, \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430 \u0441\u044d\u0440\u0446\u0430. \u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0436 \u043a\u0430\u043f\u0430\u043b\u0456 \u043a\u0430\u043b\u044f \u0440\u0430\u043a\u0456, \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u0432\u0430\u0434\u0443 \u0434\u043b\u044f \u043f\u0456\u0446\u0446\u044f, \u0431\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043f\u0456\u0446\u044c \u0437 \u0440\u0430\u043a\u0456. \u0406 \u043c\u0456\u043d\u0443\u043b\u0430 \u0441\u0435\u043c \u0434\u0437\u0451\u043d \u0437 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0443\u0434\u0430\u0440\u044b\u045e \u0443 \u0440\u0430\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 16, 4-5. 6. 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u0447\u0430\u0448\u0443 \u043d\u0430 \u0440\u044d\u043a\u0456 &ndash; \u0456 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043a\u0440\u043e\u045e. \u0406 \u044f \u043f\u0430\u0447\u0443\u045e \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0422\u044b, \u041f\u0430\u043d\u0435, \u0456 \u0441\u0432\u044f\u0442\u044b, \u0448\u0442\u043e \u0442\u0430\u043a \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u045e,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e \u044f\u043d\u044b \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u0430: \u0422\u0430\u043a, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0422\u0432\u0430\u0435 \u043f\u0440\u044b\u0441\u0443\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u044f\u043d\u044b \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"514","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">10, 21 &ndash; 11, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0446\u0435\u043c\u0440\u0430\u0439 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u043a\u0430\u0440\u044b \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f: &laquo;\u041f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043d\u0435\u0431\u0430 &ndash; \u0456 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0446\u0435\u043c\u0440\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0433\u0443\u0441\u0442\u0430\u044f \u0446\u0435\u043c\u0440\u0430&raquo;. \u0406 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0434\u0430 \u043d\u0435\u0431\u0430, \u0456 \u0433\u0443\u0441\u0442\u0430\u044f \u0446\u0435\u043c\u0440\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e \u0415\u0433\u0456\u043f\u0442\u0430 \u043d\u0430 \u0442\u0440\u044b \u0434\u043d\u0456. \u041d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043a\u0440\u0430\u043d\u0430\u045e\u0441\u044f \u0437 \u043c\u0435\u0441\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0442\u0440\u044b \u0434\u043d\u0456. \u0410\u0434\u043d\u0430\u043a \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u044f\u0434\u0437\u0456\u0431\u0430\u0445 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u044b\u043b\u043e \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0444\u0430\u0440\u0430\u043e\u043d \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435, \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u043f\u0430\u0448\u0430\u043d\u0443 \u041f\u0430\u043d\u0443, \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u0441\u0442\u0430\u0442\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u0456 \u0447\u0430\u0440\u043e\u0434\u044b. \u0414\u0437\u0435\u0446\u0456 \u0432\u0430\u0448\u044b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0443\u0446\u044c \u0437 \u0432\u0430\u043c\u0456&raquo;. \u0422\u0430\u0434\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u0422\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0430\u0446\u044c \u0443 \u0440\u0443\u043a\u0456 \u043d\u0430\u0448\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0434\u043b\u044f \u0437\u0430\u0431\u043e\u044e \u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0456\u0445 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0434\u0430\u0431\u044b\u0442\u0430\u043a \u043d\u0430\u0448 \u043f\u043e\u0439\u0434\u0437\u0435 \u0437 \u043d\u0430\u043c\u0456, \u043d\u0430\u0432\u0430\u0442 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u043a\u0430\u043f\u044b\u0442\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0431\u043e \u0437 \u044f\u0433\u043e \u043c\u044b \u0432\u043e\u0437\u044c\u043c\u0435\u043c \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443. \u0422\u044b\u043c \u0431\u043e\u043b\u044c\u0448, \u043c\u044b \u0441\u0430\u043c\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0430\u0445\u0432\u044f\u0440\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0442\u0443\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u041f\u0430\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0456 \u0442\u043e\u0439 \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0456\u0445. \u0424\u0430\u0440\u0430\u043e\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0410\u0434\u044b\u0434\u0437\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435! \u0421\u0446\u0435\u0440\u0430\u0436\u044b\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u0432\u0430\u0440\u0443 \u043c\u0430\u0439\u0433\u043e, \u0431\u043e \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u0448\u0447\u044d \u0440\u0430\u0437 \u0437&rsquo;\u044f\u0432\u0456\u0448\u0441\u044f \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u0439, \u043f\u0430\u043c\u0440\u044d\u0448&raquo;. \u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u0425\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a, \u044f\u043a \u0442\u044b \u0441\u043a\u0430\u0437\u0430\u045e. \u042f \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u0442\u0432\u0430\u0440\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u042f\u0448\u0447\u044d \u0430\u0434\u043d\u0443 \u043a\u0430\u0440\u0443 \u0441\u043f\u0430\u0448\u043b\u044e \u043d\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u0415\u0433\u0456\u043f\u0435\u0442, \u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0451\u043d \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0430\u0434\u0442\u0443\u043b\u044c; \u0430 \u043a\u0430\u043b\u0456 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0456\u0445, \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u043f\u0435\u0448\u043d\u0430 \u0433\u043d\u0430\u0446\u044c \u0432\u0430\u0441 \u0430\u0434\u0442\u0443\u043b\u044c. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b \u045e\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u045e \u0441\u0443\u0441\u0435\u0434\u0437\u044f\u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u0440\u044d\u0431\u043d\u044b \u0456 \u0437\u0430\u043b\u0430\u0442\u044b \u043f\u043e\u0441\u0443\u0434. \u041f\u0430\u043d \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u043b\u0430\u0441\u043a\u0443 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u045e \u0432\u0430\u0447\u0430\u0445 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u0456\u0447\u044b\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043c\u0443\u0436\u0430\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0443 \u0432\u0430\u0447\u0430\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0410\u043f\u043e\u045e\u043d\u0430\u0447\u044b \u042f \u043f\u0440\u0430\u0439\u0434\u0443 \u043f\u0440\u0430\u0437 \u0415\u0433\u0456\u043f\u0435\u0442; \u0456 \u043f\u0430\u043c\u0440\u044d \u045e\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0441\u0432\u0430\u0456\u043c, \u0434\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0441\u043b\u0443\u0436\u0430\u043d\u043a\u0456, \u044f\u043a\u0430\u044f \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0440\u044b \u0436\u043e\u0440\u043d\u0430\u0445, \u0456 \u045e\u0441\u044f\u043a\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0431\u044b\u0434\u043b\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0433\u0430\u043b\u0430\u0448\u044d\u043d\u043d\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u044f\u043a\u043e\u0433\u0430 \u0440\u0430\u043d\u0435\u0439 \u043d\u0435 \u0431\u044b\u043b\u043e \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043f\u0430\u0441\u043b\u044f. \u0410 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u0431\u0430\u043a\u0430 \u043d\u0435 \u0437\u0430\u0431\u0440\u044d\u0448\u0430 \u043d\u0456 \u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u043d\u0456 \u043d\u0430 \u0431\u044b\u0434\u043b\u0430, \u043a\u0430\u0431 \u0432\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u044f\u043a\u0456 \u043f\u0430\u0434\u0437\u0435\u043b \u0443\u0447\u044b\u043d\u0456\u045e \u041f\u0430\u043d \u043f\u0430\u043c\u0456\u0436 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c\u0456 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u0422\u0430\u0434\u044b \u045e\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u0442\u0432\u0430\u0435 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u043c\u044f\u043d\u0435 \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u043c\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0412\u044b\u0439\u0434\u0437\u0456 \u0442\u044b \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0442\u0430\u0431\u043e\u0439&rdquo;. \u0406 \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0439\u0434\u0443 \u044f&raquo;. \u0406 \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0433\u043d\u0435\u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u0432\u0430\u0441 \u0444\u0430\u0440\u0430\u043e\u043d, \u043a\u0430\u0431 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0456\u0441\u044f \u0446\u0443\u0434\u044b \u041c\u0430\u0435 \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0436\u0430 \u0456 \u0410\u0430\u0440\u043e\u043d \u0443\u0447\u044b\u043d\u0456\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0446\u0443\u0434\u0430\u045e, \u0430\u043b\u0435 \u041f\u0430\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0456 \u0442\u043e\u0439 \u043d\u0435 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0434\u0440 18, 4; 17, 20; 18, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u043b\u0456, \u043a\u0430\u0431 \u0456\u0445 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u043b\u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u0431\u043e \u044f\u043d\u044b \u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u043d\u044f\u0432\u043e\u043b\u0456 \u0422\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0440\u0430\u0437 \u044f\u043a\u0456\u0445 \u0441\u0432\u0435\u0442 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0417\u0430\u043a\u043e\u043d\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0434 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c\u0456 \u0430\u043f\u0443\u0441\u0446\u0456\u043b\u0430\u0441\u044f \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u044f \u043d\u043e\u0447, \u0430 \u043d\u0430\u0434 \u0422\u0432\u0430\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0437\u0437\u044f\u043b\u0430 \u043d\u0430\u0439\u044f\u0440\u0447\u044d\u0439\u0448\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u044f\u043a\u0456\u0445 \u0441\u0432\u0435\u0442 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"515","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">12, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0441\u0445\u0430 \u0456 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e \u0456 \u0410\u0430\u0440\u043e\u043d\u0443 \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439: &laquo;\u041c\u0435\u0441\u044f\u0446 \u0433\u044d\u0442\u044b \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043c\u0435\u0441\u044f\u0446\u0430\u045e. \u0401\u043d \u0434\u043b\u044f \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0448\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u043c\u0435\u0441\u044f\u0446\u0430\u045e \u0433\u043e\u0434\u0430. \u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u045e\u0441\u0451\u0439 \u0433\u0440\u0430\u043c\u0430\u0434\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0436\u044b\u0446\u0435: \u0423 \u0434\u0437\u0435\u0441\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u043d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u0441\u0430\u0431\u0435 \u043a\u043e\u0436\u043d\u044b \u044f\u0433\u043d\u044f \u0434\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0441\u044f\u043c&rsquo;\u0456, \u044f\u0433\u043d\u044f \u0434\u043b\u044f \u0434\u043e\u043c\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0441\u044f\u043c&rsquo;\u044f \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u043b\u0430\u044f, \u043a\u0430\u0431 \u0437&rsquo;\u0435\u0441\u0446\u0456 \u044f\u0433\u043d\u044f, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u043b\u0456\u0436\u044d\u0439\u0448\u044b\u043c \u0434\u0430 \u044f\u0433\u043e \u0434\u043e\u043c\u0443 \u0441\u0443\u0441\u0435\u0434\u0430\u043c \u0432\u043e\u0437\u044c\u043c\u0435 \u044f\u0433\u043d\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043b\u044e\u0434\u0437\u0435\u0439. \u0420\u0430\u0437\u043b\u0456\u0447\u044b\u0446\u0435 \u0433\u044d\u0442\u0430\u0435 \u044f\u0433\u043d\u044f \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u0430 \u0437&rsquo;\u0435\u0441\u0446\u0456. \u042f\u0433\u043d\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u0430\u045e, \u0441\u0430\u043c\u0435\u0446, \u0430\u0434\u043d\u0430\u0433\u0430\u0434\u043e\u0432\u044b. \u0412\u044b\u0431\u0440\u0430\u0446\u044c \u043c\u043e\u0436\u0430\u0446\u0435 \u044f\u0433\u043e \u0437 \u044f\u0433\u043d\u044f\u0442 \u0430\u0431\u043e \u043a\u0430\u0437\u043b\u044f\u043d\u044f\u0442. \u0406 \u0431\u0443\u0434\u0437\u0435 \u044f\u043d\u043e \u045e \u0432\u0430\u0441 \u0434\u0430 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430. \u0410 \u043f\u0430\u0441\u043b\u044f \u045e\u0441\u044f \u0433\u0440\u0430\u043c\u0430\u0434\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437\u0430\u0440\u044d\u0436\u0430 \u044f\u0433\u043e \u043d\u0430 \u0437\u043c\u044f\u0440\u043a\u0430\u043d\u043d\u0456. \u0406 \u0432\u043e\u0437\u044c\u043c\u0443\u0446\u044c \u044f\u0433\u043e\u043d\u0443\u044e \u043a\u0440\u043e\u045e, \u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0451\u0439 \u0430\u0431\u043e\u0434\u0432\u0430 \u0432\u0443\u0448\u0430\u043a\u0456 \u0456 \u0431\u044d\u043b\u044c\u043a\u0443 \u043d\u0430\u0434 \u0434\u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u045e \u0434\u0430\u043c\u0430\u0445, \u0434\u0437\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456 \u044f\u0433\u043e. \u041d\u044f\u0445\u0430\u0439 \u0443 \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447 \u0437&rsquo;\u044f\u0434\u0443\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u0435 \u043c\u044f\u0441\u0430, \u0441\u043f\u0435\u0447\u0430\u043d\u0430\u0435 \u043d\u0430 \u0430\u0433\u043d\u0456; \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u0437 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0430\u043c\u0456 \u0456 \u0433\u043e\u0440\u043a\u0456\u043c\u0456 \u0442\u0440\u0430\u0432\u0430\u043c\u0456. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u0437 \u044f\u0433\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u044b\u0440\u043e\u0433\u0430 \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0437\u0432\u0430\u0440\u0430\u043d\u0430\u0433\u0430 \u045e \u0432\u0430\u0434\u0437\u0435, \u0430\u043b\u0435 \u0437&rsquo;\u044f\u0441\u0446\u0435 \u0441\u043f\u0435\u0447\u0430\u043d\u0430\u0435 \u043d\u0430 \u0430\u0433\u043d\u0456 \u0437 \u0433\u0430\u043b\u0430\u0432\u043e\u044e, \u043d\u0430\u0433\u0430\u043c\u0456 \u0456 \u043d\u0443\u0442\u0440\u043e\u043c. \u0406 \u0434\u0430 \u0440\u0430\u043d\u0456\u0446\u044b \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u044f\u0433\u043e \u043d\u0456\u0447\u043e\u0433\u0430, \u0430 \u043a\u0430\u043b\u0456 \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0441\u043f\u0430\u043b\u0456\u0446\u0435 \u043d\u0430 \u0430\u0433\u043d\u0456. \u0422\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u044f\u0433\u043e: \u0441\u0446\u0451\u0433\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u043f\u0430\u044f\u0441\u0430\u043d\u044b\u044f, \u0441\u0430\u043d\u0434\u0430\u043b\u0456 \u043d\u0430 \u043d\u0430\u0433\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0456 \u043a\u0456\u0439 \u0432\u0430\u0448 \u0443 \u0440\u0443\u043a\u0430\u0445 \u0432\u0430\u0448\u044b\u0445. \u0415\u0441\u0446\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0430\u0441\u043f\u0435\u0448\u043b\u0456\u0432\u0430, \u0431\u043e \u0433\u044d\u0442\u0430 \u041f\u0430\u0441\u0445\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447 \u042f \u043f\u0440\u0430\u0439\u0434\u0443 \u043f\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0456 \u0437\u0430\u0431&rsquo;\u044e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0436 \u0434\u0430 \u0436\u044b\u0432\u0451\u043b\u044b, \u0456 \u045e\u0447\u044b\u043d\u044e \u0441\u0443\u0434 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456 \u0415\u0433\u0456\u043f\u0442\u0430. \u042f &ndash; \u041f\u0430\u043d. \u0406 \u0431\u0443\u0434\u0437\u0435 \u043a\u0440\u043e\u045e \u0437\u043d\u0430\u043a\u0430\u043c \u043d\u0430 \u0432\u0430\u0448\u044b\u0445 \u0434\u0430\u043c\u0430\u0445, \u0434\u0437\u0435 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435. \u0406 \u043a\u0430\u043b\u0456 \u042f \u045e\u0431\u0430\u0447\u0443 \u043a\u0440\u043e\u045e, \u0430\u0431\u043c\u0456\u043d\u0443 \u0432\u0430\u0441, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0437\u0433\u0443\u0431\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0443, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u043a\u0430\u0440\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0443\u044e. \u0413\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u043d\u0430 \u045e\u0441\u043f\u0430\u043c\u0456\u043d, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u044f\u043a \u0441\u0432\u044f\u0442\u0430 \u041f\u0430\u043d\u0430 \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0432\u0430\u0448\u044b\u044f. \u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0430\u0433\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u044f\u043c\u0456 \u0434\u0437\u0451\u043d \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u043f\u0440\u044d\u0441\u043d\u044b \u0445\u043b\u0435\u0431. \u0423\u0436\u043e \u045e \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u0431\u044f\u0440\u044d\u0446\u0435 \u045e\u0441\u044f\u043a\u0443\u044e \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0443 \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u043c\u043e\u045e, \u0431\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u043a\u0430\u0448\u0442\u0443\u0435 \u0437\u0430\u043a\u0432\u0430\u0448\u0430\u043d\u0430\u0439 \u0435\u0436\u044b \u0430\u0434 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u0430 \u0441\u0451\u043c\u0430\u0433\u0430 \u0434\u043d\u044f, \u0442\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b \u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b \u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u044b, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0441\u0432\u044f\u0442\u0430\u043c. \u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u0435\u0436\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430 \u041f\u0440\u0430\u0441\u043d\u0430\u043a\u043e\u045e, \u0431\u043e \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u042f \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0448\u044b \u043c\u0430\u0433\u0443\u0446\u0446\u0456 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u0428\u0430\u043d\u0443\u0439\u0446\u0435 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u044f\u043a \u0432\u0435\u0447\u043d\u044b \u043d\u0430\u043a\u0430\u0437, \u0443 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u0445 \u0432\u0430\u0448\u044b\u0445. \u0423 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u0430\u0434 \u0432\u0435\u0447\u0430\u0440\u0430 \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u044d\u0441\u043d\u044b \u0445\u043b\u0435\u0431 \u0430\u0436 \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u043d\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u044f\u043c\u0456 \u0434\u0437\u0451\u043d \u043d\u044f\u0445\u0430\u0439 \u0443 \u0432\u0430\u0448\u044b\u043c \u0434\u043e\u043c\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0456, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u043a\u0430\u0448\u0442\u0443\u0435 \u043d\u0435\u0448\u0442\u0430 \u0437\u0430\u043a\u0432\u0430\u0448\u0430\u043d\u0430\u0435, \u0442\u043e\u0439 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b \u0430\u0434 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a \u0447\u0443\u0436\u044b\u043d\u0435\u0446, \u0442\u0430\u043a \u0456 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u045e \u043a\u0440\u0430\u0456. \u041d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439\u0446\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0437\u0430\u043a\u0432\u0430\u0448\u0430\u043d\u0430\u0433\u0430, \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u044f\u0434\u0437\u0456\u0431\u0430\u0445 \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0435\u0441\u0446\u0456 \u043f\u0440\u044d\u0441\u043d\u044b \u0445\u043b\u0435\u0431&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 5, 8. 9; \u043f\u0430\u0440. 1 \u041f 1, 18. 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0442\u0430\u0440\u0446\u044b \u045e\u043f\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c \u0456 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u043d\u0435 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0446\u0456 \u0441\u0440\u044d\u0431\u0440\u0430\u043c, \u0430\u043b\u0435 \u043d\u0430\u0439\u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u0439 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"516","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">12, 21-36<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0440\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u0441\u0456\u0445 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0410\u0434\u043d\u0456\u043c\u0456\u0446\u0435 \u0456 \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u044f\u0433\u043d\u044f \u0434\u043b\u044f \u0441\u044f\u043c\u0435\u0439 \u0432\u0430\u0448\u044b\u0445, \u0456 \u0437\u0430\u0440\u044d\u0436\u0446\u0435 \u044f\u0433\u043e \u043d\u0430 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443. \u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0432\u044f\u0437\u043a\u0443 \u0456\u0441\u043e\u043f\u0443 \u0456 \u0430\u0431\u043c\u0430\u043a\u043d\u0456\u0446\u0435 \u044f\u0435 \u045e \u043a\u0440\u043e\u045e, \u0448\u0442\u043e \u045e \u043d\u0430\u0447\u044b\u043d\u043d\u0456, \u0456 \u0430\u043a\u0440\u0430\u043f\u0456\u0446\u0435 \u0431\u044d\u043b\u044c\u043a\u0443 \u043d\u0430\u0434 \u0434\u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u0456 \u0430\u0431\u043e\u0434\u0432\u0430 \u0432\u0443\u0448\u0430\u043a\u0456 \u043a\u0440\u044b\u0432\u0451\u044e \u0437 \u043d\u0430\u0447\u044b\u043d\u043d\u044f. \u041d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0430 \u0441\u0430\u043c\u0430\u0439 \u0440\u0430\u043d\u0456\u0446\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u0434\u0437\u0432\u0435\u0440\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443. \u041f\u0430\u043d \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e; \u0430 \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043a\u0440\u043e\u045e \u043d\u0430 \u0431\u044d\u043b\u044c\u0446\u044b \u043d\u0430\u0434 \u0434\u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u0456 \u043d\u0430 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0432\u0443\u0448\u0430\u043a\u0430\u0445, \u0442\u043e \u0430\u0431\u043c\u0456\u043d\u0435 \u041f\u0430\u043d \u0442\u044b\u044f \u0434\u0437\u0432\u0435\u0440\u044b \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0443 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0432\u0430\u0448\u044b\u044f \u0434\u0430\u043c\u044b, \u043a\u0430\u0431 \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c. \u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0430 \u044f\u043a \u043d\u0430\u043a\u0430\u0437 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0456 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0432\u0430\u0448\u044b\u0445. \u041a\u0430\u043b\u0456 \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c, \u044f\u043a \u0430\u0431\u044f\u0446\u0430\u045e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u044b \u0437\u0432\u044b\u0447\u0430\u0439. \u0422\u0430\u0434\u044b \u0441\u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u0434\u0437\u0435\u0446\u0456 \u0432\u0430\u0448\u044b\u044f: &ldquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0437\u0432\u044b\u0447\u0430\u0439 \u0443 \u0432\u0430\u0441?&rdquo; \u0410 \u0432\u044b \u0430\u0434\u043a\u0430\u0436\u0430\u0446\u0435 \u0456\u043c: &ldquo;\u0413\u044d\u0442\u0430 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043c\u0456\u043c\u0430 \u0434\u0430\u043c\u043e\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u0437\u043d\u0456\u0448\u0447\u0430\u044e\u0447\u044b \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u0456 \u0431\u0430\u0440\u043e\u043d\u044f\u0447\u044b \u043d\u0430\u0448\u044b \u0434\u0430\u043c\u044b&rdquo;&raquo;. \u0422\u0430\u0434\u044b \u0441\u0445\u0456\u043b\u0456\u045e\u0441\u044f \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f. \u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u044f\u043a \u041f\u0430\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e \u0456 \u0410\u0430\u0440\u043e\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043d\u043e\u0447\u044b \u041f\u0430\u043d \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0443\u0441\u0456\u0445 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0442\u0440\u043e\u043d\u0435, \u0434\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u043f\u0430\u043b\u043e\u043d\u043d\u0430\u0433\u0430, \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u0430\u0433\u0430 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u0456 \u045e\u0441\u044f\u043a\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0431\u044b\u0434\u043b\u0430. \u0422\u0430\u0434\u044b \u045e\u0441\u0442\u0430\u045e \u0443\u043d\u0430\u0447\u044b \u0444\u0430\u0440\u0430\u043e\u043d, \u0456 \u045e\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u044f\u0433\u043e, \u0456 \u045e\u0441\u0435 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0456 \u045e\u0437\u043d\u044f\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u043b\u0430\u0447 \u0443 \u0415\u0433\u0456\u043f\u0446\u0435, \u0431\u043e \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u0434\u043e\u043c\u0430, \u0434\u0437\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430. \u0406 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u043d\u0430\u0447\u044b \u0444\u0430\u0440\u0430\u043e\u043d \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0456 \u0456\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u043c\u0430\u0439\u0433\u043e, \u0432\u044b \u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f; \u0456\u0434\u0437\u0456\u0446\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443, \u044f\u043a \u043a\u0430\u0436\u0430\u0446\u0435. \u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u0442\u043a\u0456 \u0441\u0432\u0430\u0435 \u0456 \u0447\u0430\u0440\u043e\u0434\u044b, \u044f\u043a \u043f\u0440\u0430\u0441\u0456\u043b\u0456, \u0456 \u0456\u0434\u0437\u0456\u0446\u0435, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u043c\u044f\u043d\u0435&raquo;. \u0406 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u0432\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u0445\u0443\u0442\u043a\u0430 \u0432\u044b\u0439\u0441\u0446\u0456 \u0437 \u043a\u0440\u0430\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041c\u044b \u045e\u0441\u0435 \u043f\u0430\u043c\u0440\u043e\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0437\u044f\u045e \u043d\u0430\u0440\u043e\u0434 \u0446\u0435\u0441\u0442\u0430, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u044f\u043d\u043e \u0437\u0430\u043a\u0456\u0441\u043b\u0430, \u0434\u0437\u0435\u0436\u043a\u0456 \u0441\u0432\u0430\u0435, \u0430\u0431\u043a\u0440\u0443\u0447\u0430\u043d\u044b\u044f \u045e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0456 \u043f\u0430\u043d\u0451\u0441 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u043b\u044f\u0447\u0430\u0445. \u0417\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u043c \u041c\u0430\u0439\u0441\u0435\u0439, \u0456 \u043f\u0430\u0437\u044b\u0447\u0430\u043b\u0456 \u045e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u0441\u0440\u044d\u0431\u043d\u044b \u0456 \u0437\u0430\u043b\u0430\u0442\u044b \u043f\u043e\u0441\u0443\u0434, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u0437\u0435\u043d\u043d\u0435. \u0410 \u041f\u0430\u043d \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u045e \u0432\u0430\u0447\u0430\u0445 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u0456 \u044f\u043d\u044b \u043f\u0430\u0437\u044b\u0447\u0430\u043b\u0456 \u0456\u043c. \u0422\u0430\u043a \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0431\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0417\u044b\u0445 12, 7. 13; \u043f\u0430\u0440. 1 \u041f 1, 18. 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u043a\u0440\u044b\u0432\u0451\u044e \u044f\u0433\u043d\u044f\u0446\u0456 \u0432\u0443\u0448\u0430\u043a\u0456 \u0456 \u0431\u044d\u043b\u044c\u043a\u0443 \u043d\u0430\u0434 \u0434\u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u045e \u0434\u0430\u043c\u0430\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043a\u0440\u043e\u045e \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0430\u043a\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043a\u0440\u043e\u045e \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0430\u043a\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"517","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">12, 37-49; 13, 11-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u044b\u0439\u0441\u0446\u0435 \u0433\u0430\u0431\u0440\u044d\u044f\u045e\u041d\u0430\u043a\u0430\u0437\u044b \u043f\u0440\u0430 \u041f\u0430\u0441\u0445\u0443 \u0456 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0412\u044b\u043f\u0440\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u043b\u044f \u0448\u0430\u0441\u0446\u0456\u0441\u0442\u0430 \u0442\u044b\u0441\u044f\u0447 \u043f\u0435\u0448\u044b\u0445 \u043c\u0443\u0436\u0447\u044b\u043d, \u0430\u043a\u0440\u0430\u043c\u044f \u0434\u0437\u044f\u0446\u0435\u0439, \u0437 \u0420\u0430\u043c\u0437\u044d\u0441\u0430 \u045e \u0421\u0443\u043a\u043e\u0442. \u0406 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u044b\u0439\u0448\u043b\u0430 \u0437 \u0456\u043c\u0456, \u0456 \u0430\u0432\u0435\u0447\u043a\u0456, \u0456 \u0432\u0430\u043b\u044b, \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0442\u0430\u0442\u0430\u043a. \u042f\u043d\u044b \u0441\u043f\u044f\u043a\u043b\u0456 \u0437 \u0446\u0435\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u0432\u044b\u043d\u0435\u0441\u043b\u0456 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456, \u0431\u043e \u044f\u043d\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0437\u0430\u043a\u0456\u0441\u043b\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u044b\u044f \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c, \u0430 \u0435\u0436\u044b \u043d\u0435 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043b\u0456 \u0441\u0430\u0431\u0435 \u0456 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0437\u0430\u043f\u0430\u0441\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u043e\u0431\u044b\u0442 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e \u0415\u0433\u0456\u043f\u0446\u0435 \u0442\u0440\u044b\u0432\u0430\u045e \u0447\u0430\u0442\u044b\u0440\u044b\u0441\u0442\u0430 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e. \u041f\u0430\u0441\u043b\u044f \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u0441\u043e\u0442 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u0456 \u0433\u0430\u0434\u043e\u045e, \u0443 \u0433\u044d\u0442\u044b \u0441\u0430\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0439\u0448\u043b\u0430 \u045e\u0441\u0451 \u0432\u043e\u0439\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0413\u044d\u0442\u0430\u0439 \u043d\u043e\u0447\u0447\u0443 \u0447\u0443\u0432\u0430\u045e \u041f\u0430\u043d \u043d\u0430\u0434 \u0432\u044b\u0439\u0441\u0446\u0435\u043c \u0456\u0445 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0413\u044d\u0442\u0430\u044f \u043d\u043e\u0447 &ndash; \u0433\u044d\u0442\u0430 \u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u0430 \u045e\u0441\u0456\u0445 \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e \u0456 \u0410\u0430\u0440\u043e\u043d\u0443: &laquo;\u0412\u043e\u0441\u044c \u0437\u0430\u0433\u0430\u0434 \u043d\u0430\u043a\u043e\u043d\u0442 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b: \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0441\u044b\u043d \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u044f\u0435. \u0410\u0434\u043d\u0430\u043a \u043a\u043e\u0436\u043d\u044b \u043d\u0430\u0431\u044b\u0442\u044b \u0437\u0430 \u0433\u0440\u043e\u0448\u044b \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a, \u043a\u0430\u043b\u0456 \u0430\u0431\u0440\u044d\u0436\u0430\u0448 \u044f\u0433\u043e, \u043c\u043e\u0436\u0430 \u0435\u0441\u0446\u0456 \u044f\u0435. \u0427\u0443\u0436\u0430\u0437\u0435\u043c\u0435\u0446 \u0456 \u043d\u0430\u0439\u043c\u0456\u0442 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u044f\u0435. \u042f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u0446\u0430 \u045e \u0430\u0434\u043d\u044b\u043c \u0434\u043e\u043c\u0435, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0437 \u0434\u043e\u043c\u0443 \u043c\u044f\u0441\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u043b\u0430\u043c\u0430\u0446\u044c \u043a\u043e\u0441\u0442\u0430\u043a. \u0423\u0432\u0435\u0441\u044c \u0441\u0445\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u0430\u043a. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0435\u0439\u043a\u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435 \u0456 \u0437\u0430\u0445\u043e\u0447\u0430 \u0430\u0434\u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u0441\u0445\u0443 \u045e \u0433\u043e\u043d\u0430\u0440 \u041f\u0430\u043d\u0430, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u045e\u0441\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u044f\u0433\u043e \u0434\u043e\u043c\u0443. \u0406 \u0442\u0430\u0434\u044b \u0451\u043d \u043c\u043e\u0436\u0430 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u044f\u0435, \u0431\u043e \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0442\u0443\u0442\u044d\u0439\u0448\u044b \u0436\u044b\u0445\u0430\u0440 \u0437\u044f\u043c\u043b\u0456. \u0410\u0434\u043d\u0430\u043a \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443. \u0410\u0434\u0437\u0456\u043d \u0437\u0430\u043a\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0442\u0443\u0442\u044d\u0439\u0448\u0430\u0433\u0430 \u0456 \u0434\u043b\u044f \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0446\u044f\u0431\u0435 \u045e \u0437\u044f\u043c\u043b\u044e \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0443\u044e, \u044f\u043a \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0442\u0430\u0431\u0435 \u0456 \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c, \u0456 \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u044f\u0435 \u0442\u0430\u0431\u0435, \u0442\u0430\u0434\u044b \u0430\u0434\u0434\u0430\u0441\u0456 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u045e\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0456 \u043a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043f\u043b\u043e\u0434 \u0431\u044b\u0434\u043b\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u0423\u0441\u0451, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0434\u043b\u044f \u041f\u0430\u043d\u0430. \u041a\u043e\u0436\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0430\u0441\u043b\u044f\u043d\u044f \u0437\u0430\u043c\u0435\u043d\u0456\u0448 \u043d\u0430 \u044f\u0433\u043d\u044f, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0432\u044b\u043a\u0443\u043f\u0456\u0448 \u044f\u0433\u043e, \u0437\u043b\u0430\u043c\u0456 \u044f\u043c\u0443 \u043a\u0430\u0440\u0430\u043a. \u0406 \u043a\u043e\u0436\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u044f \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u043a\u0443\u043f\u043b\u044f\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0441\u044b\u043d \u0442\u0432\u043e\u0439 \u0441\u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435: &ldquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c?&rdquo;, \u0430\u0434\u043a\u0430\u0436\u0430\u0448 \u044f\u043c\u0443: &ldquo;\u041f\u0430\u043d \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456&rdquo;. \u0410 \u043a\u0430\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d \u0441\u0442\u0430\u045e \u0443\u043f\u0430\u0440\u0442\u044b\u043c \u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u043d\u0430\u0441, \u0442\u043e \u041f\u0430\u043d \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0431\u044b\u0434\u043b\u0430. \u0422\u0430\u043c\u0443 \u044f \u043f\u0440\u044b\u043d\u043e\u0448\u0443 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443 \u045e\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443, \u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0441\u044b\u043d\u043e\u045e \u043c\u0430\u0456\u0445 \u0432\u044b\u043a\u0443\u043f\u043b\u044f\u044e. \u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u044f\u043a \u0437\u043d\u0430\u043a \u043d\u0430 \u0440\u0443\u0446\u044d \u0456 \u044f\u043a \u0430\u0437\u0434\u043e\u0431\u0430 \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u0447\u044d\u0439, \u0448\u0442\u043e \u041f\u0430\u043d \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439 \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 2, 22. 23. 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0430\u0446\u044c\u043a\u0456 \u0415\u0437\u0443\u0441\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u042f\u0433\u043e \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0417\u0430\u043a\u043e\u043d\u0435 \u041f\u0430\u043d\u0430, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u0430 \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0437\u0430 \u042f\u0433\u043e \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443 \u043f\u0430\u0440\u0443 \u0442\u0443\u0440\u043a\u0430\u0432\u0430\u043a \u0430\u0431\u043e \u0434\u0432\u0430 \u0433\u0430\u043b\u0443\u0431\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0417\u0430\u043a\u043e\u043d\u0435 \u041f\u0430\u043d\u0430, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u0430 \u041f\u0430\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"521","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">13, 17-14, 9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0428\u043b\u044f\u0445 \u0434\u0430 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u043d\u0430\u0440\u043e\u0434, \u0411\u043e\u0433 \u043d\u0435 \u043f\u0430\u0432\u0451\u045e \u044f\u0433\u043e \u0448\u043b\u044f\u0445\u0430\u043c \u043f\u0440\u0430\u0437 \u0437\u044f\u043c\u043b\u044e \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0431\u043b\u0456\u0437\u043a\u0430, \u0431\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433: &laquo;\u041a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0432\u043e\u0439\u043d\u044b, \u0456 \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0415\u0433\u0456\u043f\u0435\u0442&raquo;. \u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u043f\u0430\u0432\u0451\u045e \u043d\u0430\u0440\u043e\u0434 \u0448\u043b\u044f\u0445\u0430\u043c \u043f\u0440\u0430\u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0434\u0430 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430. \u0421\u044b\u043d\u044b \u0436 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0439\u0448\u043b\u0456 \u045e\u0437\u0431\u0440\u043e\u0435\u043d\u044b\u044f \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u0410 \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u044f\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u043a\u043e\u0441\u0442\u043a\u0456 \u042e\u0437\u0430\u0444\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u042e\u0437\u0430\u0444 \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430\u0432\u0435\u0434\u0430\u0435 \u0432\u0430\u0441 \u0411\u043e\u0433, \u0456 \u0432\u044b \u0437\u0430\u0431\u044f\u0440\u044d\u0446\u0435 \u0437 \u0441\u0430\u0431\u043e\u044e \u043a\u043e\u0441\u0442\u043a\u0456 \u043c\u0430\u0435 \u0430\u0434\u0441\u044e\u043b\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u0437 \u0421\u0443\u043a\u043e\u0442\u0430 \u0456 \u0440\u0430\u0441\u043a\u0456\u043d\u0443\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u0443 \u042d\u0442\u0430\u043c\u0435, \u043d\u0430 \u043a\u0440\u0430\u0456 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0410 \u041f\u0430\u043d \u0456\u0448\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u045e \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435, \u043a\u0430\u0431 \u0443\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u043d\u0451\u043c, \u0430 \u043d\u043e\u0447\u0447\u0443 &ndash; \u0443 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435, \u043a\u0430\u0431 \u0432\u0435\u0441\u0446\u0456 \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0456\u0441\u0446\u0456 \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443. \u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0448\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b \u0441\u043b\u0443\u043f \u0443\u0434\u0437\u0435\u043d\u044c, \u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b &ndash; \u0443\u043d\u0430\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u041f\u0430\u043d \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u043a\u0430\u0436\u044b \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0456 \u0440\u0430\u0441\u043a\u0456\u043d\u0443\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043f\u0435\u0440\u0430\u0434 \u041f\u0456-\u0425\u0430\u0445\u0456\u0440\u043e\u0442\u0430\u043c, \u043f\u0430\u043c\u0456\u0436 \u041c\u0456\u0433\u0434\u043e\u043b\u0430\u043c \u0456 \u043c\u043e\u0440\u0430\u043c, \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u0430\u0430\u043b-\u0426\u044d\u0444\u043e\u043d\u0430. \u041f\u0435\u0440\u0430\u0434 \u0456\u043c \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u0435 \u043b\u0430\u0433\u0435\u0440 \u043a\u0430\u043b\u044f \u043c\u043e\u0440\u0430. \u0406 \u0444\u0430\u0440\u0430\u043e\u043d \u0441\u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &ldquo;\u042f\u043d\u044b \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0456 \u045e \u043a\u0440\u0430\u0456, \u043f\u0443\u0441\u0442\u044b\u043d\u044f \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0430 \u0456\u0445&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0436 \u0437\u0440\u0430\u0431\u043b\u044e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0456 \u0451\u043d \u043f\u0430\u0433\u043e\u043d\u0456\u0446\u0446\u0430 \u0437\u0430 \u0456\u043c\u0456, \u0456 \u042f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0444\u0430\u0440\u0430\u043e\u043d\u0443 \u0456 \u045e\u0441\u044f\u043c\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443 \u0432\u043e\u0439\u0441\u043a\u0443, \u0456 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d&raquo;. \u0406 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u043a\u0430\u0440\u0430\u043b\u044e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434 \u0443\u0446\u0451\u043a. \u0406 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u0441\u043b\u0443\u0433\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043d\u044b: &laquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u043c\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u043b\u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u043d\u0430 \u043d\u0430\u0441?&raquo; \u0424\u0430\u0440\u0430\u043e\u043d \u0437\u0430\u043f\u0440\u043e\u0433 \u0441\u0432\u0430\u044e \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443 \u0456 \u045e\u0437\u044f\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434. \u0423\u0437\u044f\u045e \u0448\u044d\u0441\u0446\u044c\u0441\u043e\u0442 \u043b\u0435\u043f\u0448\u044b\u0445 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446, \u0456 \u045e\u0441\u0435 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u044f \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b, \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0433\u0430, \u0456 \u0451\u043d \u043f\u0430\u0433\u043d\u0430\u045e\u0441\u044f \u0437\u0430 \u0441\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0421\u044b\u043d\u044b \u0436 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u0443\u0437\u043d\u044f\u0442\u0430\u044e \u0440\u0443\u043a\u043e\u044e. \u0406 \u043f\u0430\u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u0456\u043c\u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 &ndash; \u0443\u0441\u0435 \u043a\u043e\u043d\u0456, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456, \u0456 \u045e\u0441\u0451 \u0432\u043e\u0439\u0441\u043a\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 &ndash; \u0456 \u0434\u0430\u0433\u043d\u0430\u043b\u0456 \u0456\u0445 \u043a\u0430\u043b\u044f \u041f\u0456-\u0425\u0430\u0445\u0456\u0440\u043e\u0442\u0430, \u043f\u0435\u0440\u0430\u0434 \u0411\u0430\u0430\u043b-\u0426\u044d\u0444\u043e\u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u043a\u0430\u043b\u044f \u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 114 (113), 1. 2; \u0417\u044b\u0445 13, 21\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0434\u043e\u043c \u042f\u043a\u0443\u0431\u0430 \u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0447\u0443\u0436\u043e\u0433\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u042e\u0434\u0430 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c &ndash; \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0456\u0448\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u045e \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435, \u043a\u0430\u0431 \u0443\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042e\u0434\u0430 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c &ndash; \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"522","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">14, 10-31<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u0445\u043e\u0434 \u043f\u0440\u0430\u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0424\u0430\u0440\u0430\u043e\u043d \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f, \u0430 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0443\u0437\u043d\u044f\u045e\u0448\u044b \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435, \u0443\u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0456\u043c\u0456. \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0456 \u0434\u0430 \u041f\u0430\u043d\u0430. \u042f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0426\u0456 \u0436 \u043d\u044f\u043c\u0430 \u0433\u0440\u0430\u0431\u043d\u0456\u0446 \u0443 \u0415\u0433\u0456\u043f\u0446\u0435, \u0448\u0442\u043e \u0442\u044b \u043f\u0440\u044b\u0432\u0451\u045e \u043d\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456? \u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0442\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u043c, \u0448\u0442\u043e \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430? \u0426\u0456 \u0436 \u043d\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u043c\u044b \u0442\u0430\u0431\u0435 \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u041f\u0430\u043a\u0456\u043d\u044c \u043d\u0430\u0441, \u043d\u044f\u0445\u0430\u0439 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u0431\u043e \u043b\u0435\u043f\u0448 \u043d\u0430\u043c \u0431\u044b\u0446\u044c \u0443 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u0456, \u0447\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456&raquo;. \u0410\u043b\u0435 \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f, \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435\u0441\u044f &ndash; \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430, \u044f\u043a\u043e\u0435 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0432\u0430\u043c \u0441\u0451\u043d\u043d\u044f, \u0431\u043e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u044f\u043a\u0456\u0445 \u0432\u044b \u0431\u0430\u0447\u044b\u0446\u0435 \u0441\u0451\u043d\u043d\u044f, \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u043d\u0456\u043a\u043e\u043b\u0456. \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437\u0430 \u0432\u0430\u0441, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u0448 \u0434\u0430 \u041c\u044f\u043d\u0435? \u0421\u043a\u0430\u0436\u044b \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c. \u0410 \u0442\u044b \u043f\u0430\u0434\u044b\u043c\u0456 \u043a\u0456\u0439 \u0441\u0432\u043e\u0439 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043c\u043e\u0440\u0430, \u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u0456 \u044f\u0433\u043e, \u0456 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430 \u043f\u0430 \u0441\u0443\u0448\u044b. \u042f \u0436 \u0437\u0440\u0430\u0431\u043b\u044e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u045e\u0441\u043b\u0435\u0434 \u0437\u0430 \u0456\u043c\u0456. \u0406 \u043f\u0430\u043a\u0430\u0436\u0443 \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e \u043d\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0435 \u0456 \u045e\u0441\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c, \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u0445 \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445. \u0406 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0430\u0436\u0443 \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e \u043d\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0435 \u0456 \u045e\u0441\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c, \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u0445 \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0440\u0443\u0448\u044b\u045e\u0441\u044f \u0430\u043d\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0456\u0448\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0456\u043c, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u043b\u0443\u043f \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u0443\u043d\u0443\u045e\u0441\u044f \u0441\u043f\u0435\u0440\u0430\u0434\u0443 \u043d\u0430\u0437\u0430\u0434; \u0441\u0442\u0430\u045e \u043f\u0430\u043c\u0456\u0436 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u043c \u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u043c; \u0456 \u0431\u044b\u043b\u0430 \u0445\u043c\u0430\u0440\u0430 \u0446\u0451\u043c\u043d\u0430\u044f \u0434\u043b\u044f \u0430\u0434\u043d\u044b\u0445, \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u043b\u0430 \u043d\u043e\u0447 \u0434\u0440\u0443\u0433\u0456\u043c \u0442\u0430\u043a, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u045e\u0441\u044e \u043d\u043e\u0447 \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0434\u0430 \u043c\u043e\u0440\u0430, \u041f\u0430\u043d \u0433\u043d\u0430\u045e \u043c\u043e\u0440\u0430 \u043c\u043e\u0446\u043d\u044b\u043c \u0443\u0441\u0445\u043e\u0434\u043d\u0456\u043c \u0432\u0435\u0442\u0440\u0430\u043c \u0443\u0441\u044e \u043d\u043e\u0447 \u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0443 \u0441\u0443\u0448\u0443, \u0456 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0432\u0430\u0434\u0430. \u0422\u0430\u0434\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430 \u043f\u0430 \u0441\u0443\u0448\u044b; \u0432\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u0456\u0445 \u0441\u0446\u044f\u043d\u043e\u044e \u0437 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0456 \u0437 \u043b\u0435\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443. \u0406 \u043f\u0430\u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u0437\u0430 \u0456\u043c\u0456 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430 \u045e\u0441\u044f \u043a\u043e\u043d\u043d\u0456\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f. \u0406 \u0432\u043e\u0441\u044c \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u041f\u0430\u043d \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u0441\u0430 \u0441\u043b\u0443\u043f\u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0433\u0430 \u0456 \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u0430\u0433\u0430, \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456\u0445\u043d\u044f\u0435. \u0406 \u043f\u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e \u043a\u043e\u043b\u044b \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u045e, \u0448\u0442\u043e \u0456\u043c \u0446\u044f\u0436\u043a\u0430 \u0431\u044b\u043b\u043e \u0440\u0443\u0445\u0430\u0446\u0446\u0430. \u0406 \u043a\u0430\u0437\u0430\u043b\u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435: &laquo;\u0423\u0446\u044f\u043a\u0430\u0439\u043c\u0430 \u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0431\u043e \u041f\u0430\u043d \u0432\u0430\u044e\u0435 \u0437\u0430 \u0456\u0445 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043c\u043e\u0440\u0430, \u043a\u0430\u0431 \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0432\u043e\u0434\u044b \u0434\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445&raquo;. \u0406 \u043a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0434\u0430 \u043c\u043e\u0440\u0430, \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u044f\u043d\u043e \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430, \u0456 \u0431\u0435\u0433\u043b\u0430 \u0432\u0430\u0434\u0430 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c, \u044f\u043a\u0456\u044f \u045e\u0446\u044f\u043a\u0430\u043b\u0456, \u0456 \u043f\u0430\u0442\u0430\u043f\u0456\u045e \u0456\u0445 \u041f\u0430\u043d \u0441\u044f\u0440\u043e\u0434 \u0445\u0432\u0430\u043b\u044f\u045e. \u0412\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0432\u0430\u0434\u0430 \u0456 \u043d\u0430\u043a\u0440\u044b\u043b\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u0443\u0441\u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u044f\u043a\u043e\u0435 \u045e\u0432\u0430\u0439\u0448\u043b\u043e \u0437\u0430 \u0456\u043c\u0456 \u045e \u043c\u043e\u0440\u0430, \u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0437 \u0456\u0445. \u0410 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430 \u043f\u0430 \u0441\u0443\u0448\u044b, \u0456 \u0432\u0430\u0434\u0430 \u0441\u0442\u0430\u044f\u043b\u0430 \u043a\u0430\u043b\u044f \u0456\u0445 \u0441\u0446\u044f\u043d\u043e\u044e \u0437 \u043b\u0435\u0432\u0430\u0433\u0430 \u0456 \u0437 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u041f\u0430\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0437 \u0440\u0443\u043a \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u0445. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u043c\u043e\u0440\u0430. \u0423\u0431\u0430\u0447\u044b\u043b\u0456 \u043c\u043e\u0446\u043d\u0443\u044e \u0440\u0443\u043a\u0443, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0443\u0437\u043d\u044f\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e. \u0421\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043d\u0430\u0440\u043e\u0434 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u041f\u0430\u043d\u0443 \u0456 \u041c\u0430\u0439\u0441\u0435\u044e, \u0441\u043b\u0443\u0433\u0443 \u042f\u0433\u043e\u043d\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0417\u044b\u0445 15, 1. 2. 3.<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u044f\u0432\u0430\u044e \u041f\u0430\u043d\u0443, \u0431\u043e \u0401\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f, \u043a\u0430\u043d\u044f \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430 \u0441\u043a\u0456\u043d\u0443\u045e \u0443 \u043c\u043e\u0440\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d \u043c\u0430\u044f \u0441\u0456\u043b\u0430 \u0456 \u043c\u0430\u044f \u043f\u0435\u0441\u043d\u044f, \u0401\u043d \u0441\u0442\u0430\u045e \u043c\u0430\u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435, \u042f\u0433\u043e \u0456\u043c\u044f &ndash; \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043c\u0430\u044f \u0441\u0456\u043b\u0430 \u0456 \u043c\u0430\u044f \u043f\u0435\u0441\u043d\u044f, \u0401\u043d \u0441\u0442\u0430\u045e \u043c\u0430\u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"523","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">16, 1-18. 35<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0414\u043e\u0436\u0434\u0436 \u043c\u0430\u043d\u043d\u044b \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u0437 \u042d\u043b\u0456\u043c\u0430. \u0406 \u045e \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u0430\u0441\u043b\u044f \u0437\u044b\u0445\u043e\u0434\u0443 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u044b\u0431\u044b\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0421\u0456\u043d, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u042d\u043b\u0456\u043c\u0430\u043c \u0456 \u0421\u0456\u043d\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0447\u0430\u043b\u0430 \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430: &laquo;\u041b\u0435\u043f\u0448 \u0431\u044b \u043c\u044b \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u0430\u0434 \u0440\u0443\u043a\u0456 \u041f\u0430\u043d\u0430 \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u043a\u0430\u043b\u0456 \u0441\u044f\u0434\u0437\u0435\u043b\u0456 \u043f\u0440\u044b \u043a\u0430\u0442\u043b\u0435 \u0437 \u043c\u044f\u0441\u0430\u043c \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u045e\u0434\u043e\u0441\u0442\u0430\u043b\u044c \u0445\u043b\u0435\u0431\u0430. \u0412\u044b \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u0443\u044e \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u043a\u0430\u0431 \u0437\u0430\u043c\u0430\u0440\u044b\u0446\u044c \u0433\u043e\u043b\u0430\u0434\u0430\u043c \u0443\u0432\u0435\u0441\u044c \u0441\u0445\u043e\u0434?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0412\u043e\u0441\u044c \u042f \u043f\u0440\u0430\u043b\u044c\u044e \u043d\u0430 \u0432\u0430\u0441 \u0445\u043b\u0435\u0431 \u0437 \u043d\u0435\u0431\u0430. \u0406 \u0448\u0442\u043e\u0434\u043d\u044f \u043d\u0430\u0440\u043e\u0434 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0437\u0431\u0456\u0440\u0430\u0446\u044c, \u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u044d\u0431\u0430 \u043d\u0430 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u0431 \u041c\u043d\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e, \u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0443, \u0446\u0456 \u043d\u0435. \u0410 \u045e \u0448\u043e\u0441\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0440\u044b\u0445\u0442\u0443\u044e\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c, \u0456 \u0431\u0443\u0434\u0437\u0435 \u045e\u0434\u0432\u0430\u044f \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u044b \u0456\u043d\u0448\u044b \u0434\u0437\u0435\u043d\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0437 \u0410\u0430\u0440\u043e\u043d\u0430\u043c \u0443\u0441\u0456\u043c \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u0423\u0432\u0435\u0447\u0430\u0440\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439; \u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u0443\u0431\u0430\u0447\u044b\u0446\u0435 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430, \u0431\u043e \u0401\u043d \u043f\u0430\u0447\u0443\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430 \u043d\u0430 \u041f\u0430\u043d\u0430. \u0410\u0434\u043d\u0430\u043a, \u0445\u0442\u043e \u043c\u044b \u0442\u0430\u043a\u0456\u044f, \u0448\u0442\u043e \u0432\u044b \u043d\u0430\u0440\u0430\u043a\u0430\u0435\u0446\u0435 \u043d\u0430 \u043d\u0430\u0441?&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u0423\u0432\u0435\u0447\u0430\u0440\u044b \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u043c\u044f\u0441\u0430 \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 &ndash; \u0445\u043b\u0435\u0431\u0430 \u045e\u0434\u043e\u0441\u0442\u0430\u043b\u044c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u043d \u043f\u0430\u0447\u0443\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0456 \u0432\u0430\u0448\u044b, \u044f\u043a\u0456\u043c\u0456 \u0432\u044b \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0433\u043e. \u0411\u043e \u0445\u0442\u043e \u043c\u044b \u0442\u0430\u043a\u0456\u044f? \u041d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435, \u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0410\u0430\u0440\u043e\u043d\u0443: &laquo;\u0421\u043a\u0430\u0436\u044b \u045e\u0441\u0451\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u043d\u0430\u0431\u043b\u0456\u0437\u044c\u0446\u0435\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0431\u043e \u0401\u043d \u043f\u0430\u0447\u0443\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0456 \u0432\u0430\u0448\u044b\u044f&raquo;. \u0410 \u043a\u0430\u043b\u0456 \u0410\u0430\u0440\u043e\u043d \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0445\u043e\u0434\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043d\u044b \u0430\u0437\u0456\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044e. \u0406 \u0432\u043e\u0441\u044c \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0432\u043e\u0431\u043b\u0430\u043a\u0443. \u0406 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u041f\u0430\u043d \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u043f\u0430\u0447\u0443\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0421\u043a\u0430\u0436\u044b \u0456\u043c: \u0412\u0435\u0447\u0430\u0440\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u043c\u044f\u0441\u0430, \u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b \u0445\u043b\u0435\u0431\u0430\u043c \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0435\u0447\u0430\u0440\u044b \u043d\u0430\u043b\u044f\u0446\u0435\u043b\u0456 \u043f\u0435\u0440\u0430\u043f\u0451\u043b\u043a\u0456 \u0456 \u043f\u0430\u043a\u0440\u044b\u043b\u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u043d, \u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u0440\u0430\u0441\u0430 \u043b\u044f\u0433\u043b\u0430 \u0432\u0430\u043a\u043e\u043b \u043b\u0430\u0433\u0435\u0440\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0440\u0430\u0441\u0430 \u0437\u043d\u0456\u043a\u043b\u0430, \u043d\u0430 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u0456 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0435\u0448\u0442\u0430 \u0434\u0440\u043e\u0431\u043d\u0430\u0435 \u0456 \u0437\u044f\u0440\u043d\u0456\u0441\u0442\u0430\u0435, \u043d\u0456\u0431\u044b \u0456\u043d\u0435\u0439 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043a\u0430\u0437\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443: &laquo;\u041c\u0430\u043d\u0445\u0443?&raquo; (\u0428\u0442\u043e \u0433\u044d\u0442\u0430?). \u0411\u043e \u044f\u043d\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u0433\u044d\u0442\u0430. \u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0413\u044d\u0442\u0430 \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u041f\u0430\u043d \u0434\u0430\u045e \u0432\u0430\u043c \u0434\u043b\u044f \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443. \u0412\u043e\u0441\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u0435, \u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u0435\u0436\u044b; \u0433\u0430\u043c\u044d\u0440 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u0430\u0441\u043e\u0431, \u044f\u043a\u0456\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u044f\u0433\u043e \u0448\u0430\u0442\u0440\u0430, \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0431\u0456\u0440\u0430\u0446\u044c&rdquo;&raquo;. \u0406 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0437\u0431\u0456\u0440\u0430\u043b\u0456; \u0430\u0434\u0437\u0456\u043d \u0431\u043e\u043b\u044c\u0448, \u0434\u0440\u0443\u0433\u0456 \u043c\u0435\u043d\u0448. \u0406 \u043c\u0435\u0440\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u043a\u0456 \u0433\u0430\u043c\u044d\u0440\u0430, \u0456 \u0445\u0442\u043e \u0441\u0430\u0431\u0440\u0430\u045e \u0431\u043e\u043b\u044c\u0448, \u043d\u0435 \u043c\u0435\u045e \u043b\u0456\u0448\u043a\u0443, \u0430 \u0445\u0442\u043e \u043c\u0435\u043d\u0448, \u043d\u0435 \u043c\u0435\u045e \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 &ndash; \u043a\u043e\u0436\u043d\u044b \u043d\u0430\u0437\u0431\u0456\u0440\u0430\u045e \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0433 \u0437&rsquo;\u0435\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0435\u043b\u0456 \u0433\u044d\u0442\u0443\u044e \u043c\u0430\u043d\u043d\u0443 \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0445\u0430\u0440\u0447\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043c\u0430\u043d\u043d\u0430\u0439, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456 \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0434\u0440 16, 20; \u042f\u043d 6, 32b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043d\u0430\u043a\u0430\u0440\u043c\u0456\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0456\u043c \u0437 \u043d\u0435\u0431\u0430 \u0445\u043b\u0435\u0431, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u0443\u0441\u044f\u043a\u0443\u044e \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0431\u044b\u0446\u044c \u0434\u0430 \u0441\u043c\u0430\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u041c\u0430\u0439\u0441\u0435\u0439 \u0434\u0430\u045e \u0432\u0430\u043c \u0445\u043b\u0435\u0431 \u0437 \u043d\u0435\u0431\u0430, \u0430\u043b\u0435 \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439 \u0434\u0430\u0435 \u0432\u0430\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0445\u043b\u0435\u0431 \u0437 \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u0443\u0441\u044f\u043a\u0443\u044e \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0431\u044b\u0446\u044c \u0434\u0430 \u0441\u043c\u0430\u043a\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"524","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">17, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u0430\u0434\u0430 \u0441\u0430 \u0441\u043a\u0430\u043b\u044b. \u0411\u0456\u0442\u0432\u0430 \u0437 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0430 \u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0421\u0456\u043d \u0443 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430. \u0420\u0430\u0437\u043c\u044f\u0441\u0446\u0456\u043b\u0456 \u0441\u0442\u0430\u043d \u0443 \u0420\u044d\u0444\u0456\u0434\u044b\u043c\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u043c \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u043d\u0430\u0440\u043e\u0434 \u043c\u043e\u0433 \u043f\u0456\u0446\u044c. \u0422\u0430\u0434\u044b \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0447\u0430\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c \u043d\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0430\u0439 \u043d\u0430\u043c \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u043c\u044b \u043f\u0456\u043b\u0456&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0427\u0430\u0433\u043e \u043d\u0430\u0440\u0430\u043a\u0430\u0435\u0446\u0435 \u043d\u0430 \u043c\u044f\u043d\u0435? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435\u0446\u0435 \u041f\u0430\u043d\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0432\u0430\u0434\u044b \u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u045e \u043d\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u044b \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430? \u041a\u0430\u0431 \u0437\u0430\u043c\u0443\u0447\u044b\u0446\u044c \u0441\u043c\u0430\u0433\u0430\u044e \u043d\u0430\u0441, \u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u043d\u0430\u0448\u044b\u0445, \u0456 \u0441\u0442\u0430\u0442\u043a\u0456 \u043d\u0430\u0448\u044b\u044f?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0434\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0428\u0442\u043e \u0437\u0440\u0430\u0431\u043b\u044e \u044f \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u043c\u0443? \u042f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443, \u0456 \u045e\u043a\u0430\u043c\u044f\u043d\u0443\u044e\u0446\u044c \u043c\u044f\u043d\u0435&raquo;. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0440\u0430\u0439\u0434\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u0432\u0430\u0437\u044c\u043c\u0456 \u0437 \u0441\u0430\u0431\u043e\u044e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043a\u0456\u0439 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456\u043c \u0443\u0434\u0430\u0440\u044b\u045e \u0442\u044b \u0440\u0430\u043a\u0443, \u0432\u0430\u0437\u044c\u043c\u0456 \u045e \u0440\u0443\u043a\u0443 \u0442\u0432\u0430\u044e, \u0456 \u0456\u0434\u0437\u0456. \u0412\u043e\u0441\u044c \u042f \u0441\u0442\u0430\u043d\u0443 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u043d\u0430 \u0441\u043a\u0430\u043b\u0435 \u045e \u0413\u0430\u0440\u044d\u0431\u0435, \u0456 \u0442\u044b \u045e\u0434\u0430\u0440\u044b\u0448 \u0443 \u0441\u043a\u0430\u043b\u0443 &ndash; \u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u044f\u0435 \u0432\u0430\u0434\u0430, \u0456 \u043d\u0430\u0440\u043e\u0434 \u0431\u0443\u0434\u0437\u0435 \u043f\u0456\u0446\u044c&raquo;. \u0417\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u043d\u0430\u0437\u0432\u0430\u045e \u0442\u043e\u0435 \u043c\u0435\u0441\u0446\u0430 \u041c\u0430\u0441\u0430 \u0456 \u041c\u044d\u0440\u044b\u0431\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0440\u043a\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f \u0456\u043c\u0456 \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0426\u0456 \u0451\u0441\u0446\u044c \u041f\u0430\u043d \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441, \u0446\u0456 \u043d\u044f\u043c\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u044b \u0456 \u0432\u0430\u044f\u0432\u0430\u043b\u0456 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0443 \u0420\u044d\u0444\u0456\u0434\u044b\u043c\u0435. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0415\u0437\u0443\u0441\u0443 \u041d\u0430\u0432\u0456\u043d\u0443: &laquo;\u0412\u044b\u0431\u0435\u0440\u044b \u043d\u0430\u043c \u043c\u0443\u0436\u043e\u045e \u0456 \u0456\u0434\u0437\u0456 \u0431\u0456\u0446\u0446\u0430 \u0437 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u0430\u043c\u0456; \u0437\u0430\u045e\u0442\u0440\u0430 \u044f \u0441\u0442\u0430\u043d\u0443 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u043f\u0430\u0433\u043e\u0440\u043a\u0430, \u0430 \u0436\u0430\u0437\u043b\u043e \u0411\u043e\u0436\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0440\u0443\u0446\u044d \u043c\u0430\u0451\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041c\u0430\u0439\u0441\u0435\u0439, \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0431\u0456\u0446\u0446\u0430 \u0437 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u0430\u043c\u0456. \u0410 \u041c\u0430\u0439\u0441\u0435\u0439, \u0456 \u0410\u0430\u0440\u043e\u043d, \u0456 \u0425\u0443\u0440 \u0443\u0437\u044b\u0448\u043b\u0456 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044e \u043f\u0430\u0433\u043e\u0440\u043a\u0430. \u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0434\u044b\u043c\u0430\u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0430 \u043a\u0430\u043b\u0456 \u0430\u043f\u0443\u0441\u043a\u0430\u045e \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0410\u043c\u0430\u043b\u0435\u043a. \u041a\u0430\u043b\u0456 \u0440\u0443\u043a\u0456 \u041c\u0430\u0439\u0441\u0435\u0435\u0432\u044b \u0430\u0446\u044f\u0436\u044d\u043b\u0456, \u0442\u0430\u0434\u044b \u045e\u0437\u044f\u043b\u0456 \u043a\u0430\u043c\u0435\u043d\u044c \u0456 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u044f\u043c\u0443, \u0456 \u0451\u043d \u0441\u0435\u045e \u043d\u0430 \u0456\u043c, \u0430 \u0410\u0430\u0440\u043e\u043d \u0456 \u0425\u0443\u0440 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0440\u0443\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0430\u0434\u0437\u0456\u043d \u0437 \u0430\u0434\u043d\u0430\u0433\u043e, \u0430 \u0434\u0440\u0443\u0433\u0456 \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443. \u0406 \u0431\u044b\u043b\u0456 \u0440\u0443\u043a\u0456 \u044f\u0433\u043e \u043f\u0430\u0434\u043d\u044f\u0442\u044b\u044f \u0430\u0436 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0410\u043c\u0430\u043b\u0435\u043a\u0430 \u0456 \u043d\u0430\u0440\u043e\u0434 \u044f\u0433\u043e\u043d\u044b \u0432\u044b\u0441\u0442\u0440\u044b\u0451\u043c \u043c\u044f\u0447\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0417\u0430\u043f\u0456\u0448\u044b \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430 \u043f\u0430\u043c\u044f\u0446\u044c \u0443 \u043a\u043d\u0456\u0437\u0435 \u0456 \u045e\u043a\u043b\u0430\u0434\u0437\u0456 \u045e \u0432\u0443\u0448\u044b \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430, \u0448\u0442\u043e \u042f \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043d\u0456\u0448\u0447\u0443 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0410\u043c\u0430\u043b\u0435\u043a\u0430 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c!&raquo; \u0422\u0430\u0434\u044b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u043b\u0442\u0430\u0440 \u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e \u041f\u0430\u043d-\u041d\u0456\u0441\u0456 (\u041f\u0430\u043d &ndash; \u043c\u0430\u044f \u0445\u0430\u0440\u0443\u0433\u0432\u0430), \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u043f\u0430\u0434\u043d\u044f\u045e \u0440\u0443\u043a\u0443 \u043d\u0430 \u0442\u0440\u043e\u043d \u041f\u0430\u043d\u0430, \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0410\u043c\u0430\u043b\u0435\u043a\u0430\u043c \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 12, 3. 4; \u043f\u0430\u0440. \u042f\u043d 4, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0432\u0430\u0434\u0443 \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0441\u043a\u0430\u0436\u0430\u0446\u0435: \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u041f\u0430\u043d\u0430, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u0432\u0430\u043c, \u0441\u0442\u0430\u043d\u0435 \u045e \u0432\u0430\u0441 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0441\u043a\u0430\u0436\u0430\u0446\u0435: \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u041f\u0430\u043d\u0430, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"525","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">18, 13-27<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u0435 \u0441\u0443\u0434\u0434\u0437\u044f\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0421\u0435\u045e \u041c\u0430\u0439\u0441\u0435\u0439, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434. \u0406 \u0441\u0442\u0430\u044f\u045e \u043d\u0430\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0430\u0434 \u0440\u0430\u043d\u0456\u0446\u044b \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430. \u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0435\u045e \u0446\u0435\u0441\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0451\u043d \u0440\u0430\u0431\u0456\u045e \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0442\u044b \u0440\u043e\u0431\u0456\u0448 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c? \u0427\u0430\u043c\u0443 \u0430\u0434\u0437\u0456\u043d \u0442\u044b \u0441\u044f\u0434\u0437\u0456\u0448, \u0430 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u0442\u0430i\u0446\u044c \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u0437 \u0440\u0430\u043d\u0456\u0446\u044b \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430?&raquo; \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0439\u043c\u0443 \u0446\u0435\u0441\u0446\u044e: &laquo;\u041d\u0430\u0440\u043e\u0434 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043c\u044f\u043d\u0435 \u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u043f\u0430\u0440\u0430\u0434\u044b \u045e \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u0436 \u0456\u043c\u0456 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u043d\u0435\u0439\u043a\u0430\u044f \u0441\u043f\u0440\u044d\u0447\u043a\u0430, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u0456\u0445 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u045e \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043d\u0430\u043a\u0430\u0437\u044b \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u043a\u043e\u043d\u044b \u042f\u0433\u043e\u043d\u044b\u044f&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0435\u045e \u0446\u0435\u0441\u0446\u044c: &laquo;\u041d\u044f\u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0442\u044b \u0440\u043e\u0431\u0456\u0448. \u0421\u0442\u043e\u043c\u0456\u0448\u0441\u044f \u0442\u044b \u0456 \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b, \u0448\u0442\u043e \u0437 \u0442\u0430\u0431\u043e\u044e; \u0431\u043e \u043d\u0435\u043f\u0430\u0441\u0456\u043b\u044c\u043d\u044b \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0433\u044d\u0442\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u0456 \u0442\u044b \u0430\u0434\u0437\u0456\u043d \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0448 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u044f\u0433\u043e. \u0426\u044f\u043f\u0435\u0440 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u043b\u043e\u0432\u044b \u043c\u0430\u0451\u0439 \u043f\u0430\u0440\u0430\u0434\u044b, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u044e. \u0421\u0442\u0430\u043d\u044c \u043d\u0430 \u043c\u0435\u0441\u0446\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0437\u0430\u043d\u043e\u0441\u044c \u0434\u0430 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044b \u0456\u0445\u043d\u0456\u044f. \u0422\u043b\u0443\u043c\u0430\u0447 \u0456\u043c \u043d\u0430\u043a\u0430\u0437\u044b, \u0437\u0430\u043a\u043e\u043d\u044b \u0456 \u0448\u043b\u044f\u0445, \u043f\u0430 \u044f\u043a\u0456\u043c \u044f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u0441\u0446\u0456, \u0456 \u0441\u043f\u0440\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0431\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u0437\u043d\u0430\u0439\u0434\u0437\u0456 \u0441\u0430\u0431\u0435 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u0445, \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u0445 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043c\u0443\u0436\u043e\u045e, \u044f\u043a\u0456\u044f \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044f\u0446\u044c \u043d\u0430\u0436\u044b\u0432\u0443. \u041f\u0430\u0441\u0442\u0430\u045e \u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0434 \u0442\u044b\u0441\u044f\u0447\u0447\u0443, \u0441\u043e\u0442\u043d\u044f\u044e, \u043f\u044f\u0446\u0446\u044e\u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e \u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e. \u041d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u0441\u0443\u0434\u0437\u044f\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441. \u0410 \u043a\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0436\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u043d\u044f\u0445\u0430\u0439 \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0430 \u0441\u0430\u043c\u0456 \u0432\u044b\u0440\u0430\u0448\u0430\u044e\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u044b\u044f. \u0422\u0430\u0431\u0435 \u0431\u0443\u0434\u0437\u0435 \u043b\u044f\u0433\u0447\u044d\u0439, \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u0437\u0435\u043b\u0456\u0448\u0441\u044f \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0437 \u0456\u043c\u0456. \u041a\u0430\u043b\u0456 \u0437\u0440\u043e\u0431\u0456\u0448 \u0442\u0430\u043a \u0456 \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u0431\u0435 \u0433\u044d\u0442\u0430 \u0437\u0430\u0433\u0430\u0434\u0430\u0435, \u0437\u043c\u043e\u0436\u0430\u0448 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c, \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b \u043d\u0430 \u043c\u0435\u0441\u0446\u044b \u0441\u0432\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0440\u0430\u0434\u044b \u0446\u0435\u0441\u0446\u044f \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0451\u043d \u044f\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e. \u0412\u044b\u0431\u0440\u0430\u045e\u0448\u044b \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u0437 \u0443\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0443, \u0442\u044b\u0441\u044f\u0447\u043d\u0456\u043a\u0430\u043c\u0456, \u0441\u043e\u0442\u043d\u0456\u043a\u0430\u043c\u0456, \u043f\u044f\u0446\u0456\u0434\u0437\u044f\u0441\u044f\u0442\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0434\u0437\u044f\u0441\u044f\u0442\u043d\u0456\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u0443 \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441. \u0417 \u0431\u043e\u043b\u044c\u0448 \u0441\u0443\u0440&rsquo;\u0451\u0437\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430 \u0441\u0430\u043c\u0456 \u0432\u044b\u0440\u0430\u0448\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0435 \u043c\u0435\u043d\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0406 \u0430\u0434\u0430\u0441\u043b\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u0441\u0446\u044f, \u044f\u043a\u0456 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0441\u0432\u0430\u044e \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u0456\u0447 11, 25; \u0417\u044b\u0445 18, 25\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u044b\u0448\u043e\u045e \u041f\u0430\u043d \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c. \u0423\u0437\u044f\u045e \u0430\u0434 \u0434\u0443\u0445\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u043d\u0430 \u0456\u043c, \u0456 \u0434\u0430\u045e \u0441\u044f\u043c\u0456\u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0456\u0445 \u0434\u0443\u0445, \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u043f\u043e\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u0431\u0440\u0430\u045e\u0448\u044b \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u0437 \u0443\u0441\u044f\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0443. <span style=\"color: #ff0000;\">\u041d.<\/span>&nbsp;\u041a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0456\u0445 \u0434\u0443\u0445, \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u043f\u043e\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"526","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">19, 1-19; 20, 18-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u043d\u0430 \u0421\u0456\u043d\u0430\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0442\u0440\u044d\u0446\u0456 \u043c\u0435\u0441\u044f\u0446 \u043f\u0430\u0441\u043b\u044f \u0437\u044b\u0445\u043e\u0434\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0443 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u0431\u044b\u043b\u0456 \u044f\u043d\u044b \u045e \u0421\u0456\u043d\u0430\u0439\u0441\u043a\u0443\u044e \u043f\u0443\u0441\u0442\u044b\u043d\u044e. \u0412\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u0437 \u0420\u044d\u0444\u0456\u0434\u044b\u043c\u0430 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e\u0448\u044b \u0430\u0436 \u0434\u0430 \u0421\u0456\u043d\u0430\u0439\u0441\u043a\u0430\u0439 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0440\u0430\u0437\u0431\u0456\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u041b\u0430\u0433\u0435\u0440 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043c \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u044b\u0448\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430, \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u041f\u0430\u043d \u0437 \u0433\u0430\u0440\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430 \u0456 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0448 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u0412\u044b \u0441\u0430\u043c\u0456 \u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c \u0456 \u044f\u043a \u043d\u0430\u0441\u0456\u045e \u0432\u0430\u0441 \u043d\u0430 \u0430\u0440\u043b\u0456\u043d\u044b\u0445 \u043a\u0440\u044b\u043b\u0430\u0445, \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0432\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435. \u0426\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u041c\u0430\u0439\u0433\u043e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u041c\u043e\u0439, \u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u041c\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0431\u043e \u041c\u0430\u044f \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f. \u0406 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u043c. \u0412\u043e\u0441\u044c \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0442\u044b \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0456, \u0441\u043a\u043b\u0456\u043a\u0430\u045e\u0448\u044b \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443, \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0448\u0442\u043e \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u044f\u043c\u0443 \u041f\u0430\u043d. \u0406 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u0437\u0440\u043e\u0431\u0456\u043c&raquo;. \u0406 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u041f\u0430\u043d\u0443 \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0412\u043e\u0441\u044c \u042f \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0446\u044f\u0431\u0435 \u045e \u0433\u0443\u0441\u0442\u044b\u043c \u0432\u043e\u0431\u043b\u0430\u043a\u0443, \u043a\u0430\u0431 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0447\u0443\u045e, \u044f\u043a \u042f \u0433\u0430\u0432\u0430\u0440\u0443 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0456 \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0442\u0430\u0431\u0435 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u041f\u0430\u043d\u0443 \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u0440\u043e\u0434\u0443. \u0406 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0406\u0434\u0437\u0456 \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0430\u0441\u0432\u044f\u0446\u0456 \u0456\u0445 \u0441\u0451\u043d\u043d\u044f \u0456 \u0437\u0430\u045e\u0442\u0440\u0430. \u041d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u044b\u044e\u0446\u044c \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u0434\u043d\u044f, \u0431\u043e \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0441\u044b\u0434\u0437\u0435 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0421\u0456\u043d\u0430\u0439. \u0422\u044b \u043f\u0440\u0430\u0432\u044f\u0434\u0437\u0435\u0448 \u043c\u044f\u0436\u0443 \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443 \u0432\u0430\u043a\u043e\u043b \u0456 \u0441\u043a\u0430\u0436\u0430\u0448: \u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043d\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u0456 \u043d\u0435 \u043a\u0440\u0430\u043d\u0430\u0439\u0446\u0435 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u044f\u0435, \u0431\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u0430\u0440\u044b, \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b. \u041d\u044f\u0445\u0430\u0439 \u044f\u0435 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0440\u0443\u043a\u0430, \u0431\u043e \u043a\u0430\u0440\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0431\u043e \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430 \u0441\u0442\u0440\u0430\u043b\u043e\u044e, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0446\u0456 \u0436\u044b\u0432\u0451\u043b\u0430, \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u0437\u0430\u0433\u0443\u0447\u044b\u0446\u044c \u0440\u043e\u0433, \u0442\u0430\u0434\u044b \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u043d\u0430 \u0433\u0430\u0440\u0443&raquo;. \u0406 \u0441\u043f\u0443\u0441\u0446\u0456\u045e\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u0437 \u0433\u0430\u0440\u044b, \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u043d\u0430\u0440\u043e\u0434, \u0456 \u044f\u043d\u044b \u0432\u044b\u043c\u044b\u043b\u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u0434\u043d\u044f \u0456 \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0436\u0430\u043d\u0447\u044b\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c, \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456, \u043f\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0433\u0440\u044b\u043c\u043e\u0442\u044b \u0456 \u043c\u0430\u043b\u0430\u043d\u043a\u0456, \u0456 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0433\u0443\u0441\u0442\u043e\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u043d\u0430\u0434 \u0433\u0430\u0440\u043e\u044e, \u0456 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u043c\u043e\u0446\u043d\u044b \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b, \u0456 \u0437\u0430\u0442\u0440\u044b\u043c\u0446\u0435\u045e \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443 \u043b\u0430\u0433\u0435\u0440\u044b. \u0422\u0430\u0434\u044b \u0432\u044b\u0432\u0435\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u043b\u0430\u0433\u0435\u0440\u0430 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0411\u043e\u0433\u0443, \u0456 \u0441\u0442\u0430\u043b\u0456 \u044f\u043d\u044b \u043a\u0430\u043b\u044f \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u0433\u0430\u0440\u044b. \u0413\u0430\u0440\u0430 \u0436 \u0421\u0456\u043d\u0430\u0439 \u0443\u0441\u044f \u0434\u044b\u043c\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u041f\u0430\u043d \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u044f\u0435 \u045e \u0430\u0433\u043d\u0456, \u0456 \u0434\u044b\u043c \u043f\u0430\u0434\u044b\u043c\u0430\u045e\u0441\u044f \u0437 \u044f\u0435, \u044f\u043a \u0437 \u043f\u0435\u0447\u044b. \u0423\u0441\u044f \u0433\u0430\u0440\u0430 \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044d\u0441\u043b\u0430\u0441\u044f, \u0430 \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b \u0440\u0430\u0431\u0456\u045e\u0441\u044f \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u043c\u043e\u0446\u043d\u044b\u043c. \u041c\u0430\u0439\u0441\u0435\u0439 \u0433\u0430\u0432\u0430\u0440\u044b\u045e, \u0456 \u0411\u043e\u0433 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u044f\u043c\u0443 \u0441\u044f\u0440\u043e\u0434 \u0433\u0440\u044b\u043c\u043e\u0442\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0431\u0430\u0447\u044b\u045e \u0433\u0440\u044b\u043c\u043e\u0442\u044b, \u0456 \u043f\u043e\u043b\u044b\u043c\u044f, \u0456 \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b, \u0456 \u0433\u0430\u0440\u0443 \u045e \u0434\u044b\u043c\u0435. \u0423\u0431\u0430\u0447\u044b\u045e \u043d\u0430\u0440\u043e\u0434 \u0456 \u0437\u0430\u0434\u0440\u044b\u0436\u0430\u045e \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443, \u0456 \u0441\u0442\u0430\u045e \u0437\u0434\u0430\u043b\u0451\u043a, \u043a\u0430\u0436\u0443\u0447\u044b \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0413\u0430\u0432\u0430\u0440\u044b \u0437 \u043d\u0430\u043c\u0456 \u0442\u044b, \u0456 \u043c\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c; \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437 \u043d\u0430\u043c\u0456 \u0411\u043e\u0433, \u043a\u0430\u0431 \u043d\u0430\u043c \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f, \u0411\u043e\u0433 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0441, \u043a\u0430\u0431 \u0431\u043e\u044f\u0437\u044c \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0431\u044b\u043b\u0430 \u043d\u0430 \u0432\u0430\u0448\u044b\u0445 \u0442\u0432\u0430\u0440\u0430\u0445 \u0456 \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u043b\u0456&raquo;. \u0406 \u0441\u0442\u0430\u044f\u045e \u043d\u0430\u0440\u043e\u0434 \u0437\u0434\u0430\u043b\u0451\u043a, \u0430 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u0434\u0430 \u0433\u0443\u0441\u0442\u043e\u0433\u0430 \u0432\u043e\u0431\u043b\u0430\u043a\u0443, \u0443 \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0417\u044b\u0445 19, 5\u0430. 6; 1 \u041f 2, 9\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u041c\u0430\u0439\u0433\u043e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u041c\u043e\u0439, \u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u041c\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0436 &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"527","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">20, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u043d\u0430 \u0421\u0456\u043d\u0430\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0421\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433 \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;\u042f &ndash; \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456. \u041d\u0435 \u043c\u0430\u0439 \u0456\u043d\u0448\u044b\u0445 \u0431\u0430\u0433\u043e\u045e, \u0430\u043f\u0440\u043e\u0447 \u041c\u044f\u043d\u0435. \u041d\u0435 \u0440\u0430\u0431\u0456 \u0441\u0430\u0431\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0432\u044b\u044f\u0432\u044b \u0456\u0434\u0430\u043b\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0432\u0435\u0440\u0441\u0435 \u043d\u0430 \u043d\u0435\u0431\u0435, \u0448\u0442\u043e \u045e\u043d\u0456\u0437\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0448\u0442\u043e \u045e \u0432\u043e\u0434\u0430\u0445 \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e. \u041d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0439\u0441\u044f \u0456\u043c \u0456 \u043d\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0439 \u0456\u0445. \u0411\u043e \u042f \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0411\u043e\u0433 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u043d\u044b, \u044f\u043a\u0456 \u043a\u0430\u0440\u0430\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u0456 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u041c\u044f\u043d\u0435. \u0410\u043b\u0435 \u042f \u0432\u044b\u044f\u045e\u043b\u044f\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0442\u044b\u0441\u044f\u0447 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u041c\u044f\u043d\u0435 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041c\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u045e\u0436\u044b\u0432\u0430\u0439 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u0440\u044d\u043c\u043d\u0430, \u0431\u043e \u041f\u0430\u043d \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0431\u0435\u0437 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0436\u044b\u0432\u0430\u0435 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0434\u0437\u0435\u043d\u044c \u0448\u0430\u0431\u0430\u0442\u0443, \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0447\u0430\u0446\u044c \u044f\u0433\u043e. \u0428\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u0435 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0435, \u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c, \u0448\u0430\u0431\u0430\u0442, &ndash; \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e; \u043d\u0435 \u0440\u0430\u0431\u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u043d\u0456 \u0442\u044b, \u043d\u0456 \u0441\u044b\u043d \u0442\u0432\u043e\u0439, \u043d\u0456 \u0434\u0430\u0447\u043a\u0430 \u0442\u0432\u0430\u044f, \u043d\u0456 \u0442\u0432\u043e\u0439 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a, \u043d\u0456 \u0442\u0432\u0430\u044f \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u0430, \u043d\u0456 \u0436\u044b\u0432\u0451\u043b\u0430 \u0442\u0432\u0430\u044f, \u043d\u0456 \u0447\u0443\u0436\u044b\u043d\u0435\u0446, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0431\u0440\u0430\u043c\u0430\u0445 \u0442\u0432\u0430\u0456\u0445. \u0411\u043e \u0437\u0430 \u0448\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u041f\u0430\u043d \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u0456 \u043c\u043e\u0440\u0430, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0456\u0445, \u0456 \u043d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u045e. \u0422\u0430\u043c\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u0434\u0437\u0435\u043d\u044c \u0448\u0430\u0431\u0430\u0442\u0443 \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0430\u043d\u0443\u0439 \u0431\u0430\u0446\u044c\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456 \u0441\u0432\u0430\u044e, \u043a\u0430\u0431 \u0434\u043e\u045e\u0433\u0430 \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0434\u0430\u0441\u0446\u044c \u0442\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0447\u0443\u0436\u0430\u043b\u043e\u0436.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043a\u0440\u0430\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0441\u0432\u0435\u0434\u0447\u044b \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u0439 \u0434\u043e\u043c\u0443 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e; \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u0439 \u043d\u0456 \u0436\u043e\u043d\u043a\u0456 \u044f\u0433\u043e, \u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430, \u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u044b, \u043d\u0456 \u0432\u0430\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u043d\u0456 \u0430\u0441\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 &ndash; \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u044f\u043c\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 19 (18), 8. 9b; \u0420\u044b\u043c 13, 8b. 10b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u041f\u0430\u043d\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0434\u0443\u0448\u0443; \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u0432\u0435\u0440\u043d\u0430\u0435, \u044f\u043d\u043e \u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c; <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430 \u044f\u0441\u043d\u044b, \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u043e\u0447\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0417\u0430\u043a\u043e\u043d; \u043b\u044e\u0431\u043e\u045e \u0451\u0441\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0417\u0430\u043a\u043e\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430 \u044f\u0441\u043d\u044b, \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u043e\u0447\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"531","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">22, 19 &ndash; 23, 9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0430 \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u0430\u045e \u0456 \u045e\u0431\u043e\u0433\u0456\u0445 (\u041a\u043e\u0434\u044d\u043a\u0441 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443)<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: &laquo;\u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0431\u0430\u0433\u0430\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430 \u043d\u0435 \u045e\u0446\u0456\u0441\u043a\u0430\u0439\u0446\u0435 \u0456 \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0439\u0446\u0435 \u044f\u0433\u043e, \u0431\u043e \u0432\u044b \u0441\u0430\u043c\u0456 \u0431\u044b\u043b\u0456 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u043c\u0456 \u045e \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0432\u043e\u0434\u043d\u0430\u0439 \u0443\u0434\u0430\u0432\u044b \u0456 \u0441\u0456\u0440\u0430\u0442\u044b \u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u0435. \u041a\u0430\u043b\u0456 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u0435 \u0456\u0445, \u0442\u043e \u042f, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u043f\u0430\u0447\u0443\u044e \u0456\u0445\u043d\u0456 \u043a\u0440\u044b\u043a; \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u0446\u0446\u0430 \u0433\u043d\u0435\u045e \u041c\u043e\u0439, \u0456 \u0437\u0430\u0431&rsquo;\u044e \u0432\u0430\u0441 \u043c\u044f\u0447\u043e\u043c, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u043e\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u045e\u0434\u043e\u0432\u0430\u043c\u0456, \u0430 \u0441\u044b\u043d\u044b \u0432\u0430\u0448\u044b\u044f &ndash; \u0441\u0456\u0440\u043e\u0442\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u0437\u044b\u0447\u044b\u0448 \u0433\u0440\u043e\u0448\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u043c\u0443, \u0431\u0435\u0434\u043d\u0430\u043c\u0443, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e, \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u0434\u043b\u044f \u044f\u0433\u043e \u044f\u043a \u043b\u0456\u0445\u0432\u044f\u0440; \u043d\u0435 \u0432\u044b\u043c\u0430\u0433\u0430\u0439 \u0430\u0434 \u044f\u0433\u043e \u043f\u0440\u0430\u0446\u044d\u043d\u0442\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u043e\u0437\u044c\u043c\u0435\u0448 \u0443 \u0437\u0430\u043a\u043b\u0430\u0434 \u043f\u043b\u0430\u0448\u0447 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 \u0430\u0434\u0434\u0430\u0439 \u044f\u0433\u043e, \u0431\u043e \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u044f\u0433\u043e\u043d\u0430\u0435 \u045e\u0431\u0440\u0430\u043d\u043d\u0435, \u0433\u044d\u0442\u0430 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430 \u0434\u043b\u044f \u0446\u0435\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430. \u041d\u0430 \u0447\u044b\u043c \u0451\u043d \u044f\u0448\u0447\u044d \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0446\u044c? \u0406 \u043a\u0430\u043b\u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u042f \u043f\u0430\u0447\u0443\u044e \u044f\u0433\u043e, \u0431\u043e \u042f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u043b\u044e\u0437\u043d\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u043d\u0435 \u043f\u0440\u0430\u043a\u043b\u0456\u043d\u0430\u0439 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0442\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u0433\u0430 \u0442\u043e\u043a\u0443 \u0456 \u0434\u0430\u0432\u0456\u043b\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u041f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0437 \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0430\u0434\u0434\u0430\u0441\u0456 \u041c\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435 \u0436 \u0437\u0440\u043e\u0431\u0456\u0448 \u0437 \u0432\u0430\u043b\u043e\u043c \u0442\u0432\u0430\u0456\u043c \u0456 \u0437 \u0430\u0432\u0435\u0447\u043a\u0430\u0439 \u0442\u0432\u0430\u0451\u0439: \u0441\u0435\u043c \u0434\u0437\u0451\u043d \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456, \u0430 \u043d\u0430 \u0432\u043e\u0441\u044c\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u0434\u0430\u0441\u0456 \u044f\u0433\u043e \u041c\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456; \u043c\u044f\u0441\u0430 \u0437\u0432\u0435\u0440\u0430, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043d\u0430\u0433\u0430 \u045e \u043f\u043e\u043b\u0456, \u043d\u0435 \u0435\u0448\u0446\u0435, \u0430\u043b\u0435 \u043a\u0456\u043d\u044c\u0446\u0435 \u044f\u0433\u043e \u0441\u0430\u0431\u0430\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0440\u0430\u0437\u043d\u043e\u0441\u044c \u0456\u043b\u0436\u044b\u0432\u044b\u0445 \u0447\u0443\u0442\u0430\u043a \u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0432\u0430\u0439 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0442\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0456\u0434\u0437\u0456 \u0437\u0430 \u043d\u0430\u0442\u043e\u045e\u043f\u0430\u043c, \u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u0456 \u043d\u0430 \u0441\u0443\u0434\u0437\u0435 \u043d\u0435 \u0441\u0445\u0456\u043b\u044f\u0439\u0441\u044f \u0434\u0430 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0441\u043a\u0430\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0448\u043a\u0430\u0434\u0443\u0439 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u045e \u0441\u0443\u0434\u0437\u0435 \u044f\u0433\u043e\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0442\u0440\u0430\u043f\u0456\u0448 \u043d\u0430 \u0432\u0430\u043b\u0430 \u0432\u043e\u0440\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0456 \u043d\u0430 \u0430\u0441\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u0432\u044f\u0440\u043d\u0456 \u044f\u0433\u043e \u044f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u0430\u0441\u0451\u043b \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u0456\u043a\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u043b\u044f\u0436\u044b\u0446\u044c \u043f\u0430\u0434 \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u044f\u0433\u043e, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0437 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0441\u043a\u0430\u0436\u0430\u0439 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f \u0434\u0437\u0435\u043b\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u043d\u0430 \u0441\u0443\u0434\u0437\u0435 \u044f\u0433\u043e\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0446\u044f\u043a\u0430\u0439 \u0430\u0434 \u0445\u043b\u0443\u0441\u043d\u0456. \u0411\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0433\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u043d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0439, \u0431\u043e \u042f \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u044e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u044f\u0440\u044b \u0445\u0430\u0431\u0430\u0440\u0443, \u0431\u043e \u0451\u043d \u0430\u0441\u043b\u044f\u043f\u043b\u044f\u0435 \u043c\u0443\u0434\u0440\u044b\u0445 \u0456 \u0441\u043a\u0430\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0439 \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u0430; \u0431\u043e \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u0436\u044b\u0446\u0446\u0451 \u0447\u0443\u0436\u044b\u043d\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0456 \u0441\u0430\u043c\u0456 \u0431\u044b\u043b\u0456 \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u0430\u043c\u0456 \u045e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 82 (81), 3-4; \u043f\u0430\u0440. \u042f\u043a 2, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u0446\u0435 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0456 \u0441\u0456\u0440\u0430\u0442\u0443, \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0439\u0446\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u0430\u0433\u0430 \u0456 \u045e\u0431\u043e\u0433\u0430\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b\u0437\u0432\u0430\u043b\u044f\u0439\u0446\u0435 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0456 \u045e\u0431\u043e\u0433\u0430\u0433\u0430, \u0432\u044b\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0456\u0445 \u0437 \u0440\u0443\u043a \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u0445 \u0441\u0432\u0435\u0442\u0443 \u0431\u0430\u0433\u0430\u0442\u044b\u043c\u0456 \u0432\u0435\u0440\u0430\u044e \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0437\u0432\u0430\u043b\u044f\u0439\u0446\u0435 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0456 \u045e\u0431\u043e\u0433\u0430\u0433\u0430, \u0432\u044b\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0456\u0445 \u0437 \u0440\u0443\u043a \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"532","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">24, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u0430\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u0442\u044b \u0456 \u0410\u0430\u0440\u043e\u043d, \u041d\u0430\u0434\u0430\u0431 \u0456 \u0410\u0431\u0456\u0445\u0443, \u0456 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f; \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u0446\u0435\u0441\u044f \u0437\u0434\u0430\u043b\u0451\u043a. \u0422\u043e\u043b\u044c\u043a\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0430 \u044f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0446\u0446\u0430, \u0456 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u044b\u0448\u043e\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0437 \u0433\u0430\u0440\u044b \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u0456 \u045e\u0441\u0435 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b. \u0423\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0430\u0434\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430: &laquo;\u0423\u0441\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u043c&raquo;. \u0406 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430. \u0410 \u045e\u0441\u0442\u0430\u045e\u0448\u044b \u0440\u0430\u043d\u0430, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u043f\u0430\u0434 \u0433\u0430\u0440\u043e\u044e \u0456 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0441\u043b\u0443\u043f\u043e\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u043f\u0430\u0441\u043b\u0430\u045e \u044e\u043d\u0430\u043a\u043e\u045e, \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u041f\u0430\u043d\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u043c\u0456\u0440\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0431\u044b\u043a\u043e\u045e. \u041f\u0430\u0441\u043b\u044f \u045e\u0437\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u043b\u043e\u0432\u0443 \u043a\u0440\u044b\u0432\u0456 \u0456 \u043d\u0430\u043b\u0456\u045e \u044f\u0435 \u045e \u043c\u0456\u0441\u044b, \u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u043f\u0430\u043b\u043e\u0432\u0443 \u043a\u0440\u044b\u0432\u0456 \u0432\u044b\u043b\u0456\u045e \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a. \u041f\u043e\u0442\u044b\u043c \u0443\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e \u0443\u0433\u043e\u043b\u0430\u0441 \u043b\u044e\u0434\u0437\u044f\u043c, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043d\u044b: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u0437\u0440\u043e\u0431\u0456\u043c, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u044f\u045e \u043a\u0440\u043e\u045e, \u0430\u043a\u0440\u0430\u043f\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u043a\u0440\u043e\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u041f\u0430\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0432\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0434\u043d\u044f\u043b\u0456\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d, \u041d\u0430\u0434\u0430\u0431 \u0456 \u0410\u0431\u0456\u0445\u0443, \u0456 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u043f\u0430\u0434 \u043d\u0430\u0433\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u043d\u0456\u0431\u044b \u0442\u0432\u043e\u0440 \u0437 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0441\u0430\u043f\u0444\u0456\u0440\u0443, \u043f\u0440\u0430\u0437\u0440\u044b\u0441\u0442\u044b, \u044f\u043a \u0441\u0430\u043c\u043e \u043d\u0435\u0431\u0430. \u0414\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0401\u043d \u043d\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456, \u0430 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430, \u0456 \u0435\u043b\u0456, \u0456 \u043f\u0456\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0442\u0430\u043c; \u042f \u0434\u0430\u043c \u0422\u0430\u0431\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u044f \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0437 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e, \u043a\u0430\u0431 \u0442\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0456\u0445&raquo;. \u0406 \u045e\u0441\u0442\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d, \u0441\u043b\u0443\u0433\u0430 \u044f\u0433\u043e\u043d\u044b. \u0406 \u045e\u0437\u044b\u0448\u043e\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0411\u043e\u0436\u0443\u044e, \u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u0447\u0430\u043a\u0430\u0439\u0446\u0435 \u0442\u0443\u0442, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0432\u0430\u0441. \u041d\u044f\u0445\u0430\u0439 \u0410\u0430\u0440\u043e\u043d \u0456 \u0425\u0443\u0440 \u0431\u0443\u0434\u0443\u0446\u044c \u0437 \u0432\u0430\u043c\u0456; \u043a\u0430\u043b\u0456 \u045e\u0437\u043d\u0456\u043a\u043d\u0435 \u044f\u043a\u043e\u0435 \u043f\u044b\u0442\u0430\u043d\u043d\u0435, \u0437\u0432\u044f\u0440\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443, \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u044f\u0435. \u0406 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439. \u0412\u043e\u0431\u043b\u0430\u043a\u0430 \u043f\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0430 \u044f\u0435 \u0448\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d, \u0430 \u043d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044f \u0437 \u0432\u043e\u0431\u043b\u0430\u043a\u0430. \u0410 \u0441\u043b\u0430\u0432\u0430 \u0411\u043e\u0436\u0430\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0441\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0433\u043e\u043d\u044c, \u0448\u0442\u043e \u043f\u0430\u043b\u0430\u0435 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b. \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0456 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443; \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 45, 5. 6; \u0414\u0437 7, 38\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u041c\u0430\u0439\u0441\u0435\u044e \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u045e\u0432\u0451\u045e \u044f\u0433\u043e \u045e \u0446\u0451\u043c\u043d\u044b\u044f \u0445\u043c\u0430\u0440\u044b; <span style=\"color: #ff0000;\">*<\/span> \u0441\u0430\u043c-\u043d\u0430\u0441\u0430\u043c \u0434\u0430\u045e \u044f\u043c\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0437\u0430\u043a\u043e\u043d \u0436\u044b\u0446\u0446\u044f \u0456 \u0432\u0435\u0434\u0430\u045e, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u042f\u043a\u0443\u0431\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u043f\u0440\u044b\u0441\u0443\u0434\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439 \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0431\u044b\u045e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c, \u044f\u043a\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u044f\u0433\u043e \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430\u043c-\u043d\u0430\u0441\u0430\u043c \u0434\u0430\u045e \u044f\u043c\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0437\u0430\u043a\u043e\u043d \u0436\u044b\u0446\u0446\u044f \u0456 \u0432\u0435\u0434\u0430\u045e, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u042f\u043a\u0443\u0431\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u043f\u0440\u044b\u0441\u0443\u0434\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"533","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">32, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u0430\u043b\u0430\u0442\u044b \u0446\u044f\u043b\u0435\u0446<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0435 \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0437 \u0433\u0430\u0440\u044b, \u043d\u0430\u0440\u043e\u0434 \u0441\u0430\u0431\u0440\u0430\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0410\u0430\u0440\u043e\u043d\u0430\u043c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u0456 \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u043c \u0431\u0430\u0433\u043e\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0456\u0448\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430 \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0442\u044b\u043c \u043c\u0443\u0436\u0430\u043c, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456&raquo;. \u0410\u0430\u0440\u043e\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u041f\u0430\u0437\u0434\u044b\u043c\u0430\u0439\u0446\u0435 \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u0437\u0430\u0432\u0443\u0448\u043d\u0456\u0446\u044b \u0437 \u0432\u0443\u0448\u044d\u0439 \u0436\u043e\u043d\u0430\u043a, \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0447\u043e\u043a \u0432\u0430\u0448\u044b\u0445 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0456\u0446\u0435 \u043c\u043d\u0435&raquo;. \u0406 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0437\u0434\u044b\u043c\u0430\u045e \u0437\u0430\u0432\u0443\u0448\u043d\u0456\u0446\u044b \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0456\u0445 \u0410\u0430\u0440\u043e\u043d\u0443. \u0401\u043d \u0443\u0437\u044f\u045e \u0456\u0445 \u0456, \u043d\u0430\u043a\u0440\u044d\u0441\u043b\u0456\u045e\u0448\u044b \u043f\u0456\u0441\u0430\u043b\u0430\u043c \u0432\u043e\u0431\u0440\u0430\u0437, \u0430\u0434\u043b\u0456\u045e \u0437 \u0456\u0445 \u0446\u044f\u043b\u044c\u0446\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043d\u044b: &laquo;\u0412\u043e\u0441\u044c \u0431\u043e\u0433 \u0442\u0432\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456\u044f \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456!&raquo; \u041a\u0430\u043b\u0456 \u0410\u0430\u0440\u043e\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u0430, \u0451\u043d \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0430\u043b\u0442\u0430\u0440. \u0413\u0443\u0447\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e\u0448\u044b, \u0410\u0430\u0440\u043e\u043d \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e: &laquo;\u0417\u0430\u045e\u0442\u0440\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u0430 \u041f\u0430\u043d\u0430&raquo;. \u041d\u0430\u0437\u0430\u045e\u0442\u0440\u0430 \u044f\u043d\u044b \u043f\u0430\u0434\u043d\u044f\u043b\u0456\u0441\u044f \u0440\u0430\u043d\u0430 \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u043c\u0456\u0440\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u0456 \u0441\u0435\u045e \u043d\u0430\u0440\u043e\u0434 \u0435\u0441\u0446\u0456 \u0456 \u043f\u0456\u0446\u044c, \u0430 \u043f\u0430\u0441\u043b\u044f \u045e\u0441\u0442\u0430\u045e, \u043a\u0430\u0431 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0425\u0443\u0442\u0447\u044d\u0439 \u0456\u0434\u0437\u0456 \u045e\u043d\u0456\u0437, \u0431\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0442\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0442\u044b \u0432\u044b\u0432\u0435\u045e \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0425\u0443\u0442\u043a\u0430 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u044f\u043d\u044b \u0430\u0434 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a\u0456 \u042f \u0456\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u045e, \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u0430\u0431\u0435 \u0430\u0434\u043b\u0456\u0442\u0430\u0433\u0430 \u0446\u044f\u043b\u044c\u0446\u0430, \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u044f\u043c\u0443, \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u044f\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0412\u043e\u0441\u044c \u0431\u043e\u0433 \u0442\u0432\u043e\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u043d\u043e\u045e \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u042f \u0431\u0430\u0447\u0443 \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b: \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434 \u0437 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u043a\u0430\u0440\u043a\u0430\u043c. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u043a\u0456\u043d\u044c \u041c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0433\u043d\u0435\u045e \u041c\u043e\u0439 \u043d\u0430 \u0456\u0445 \u0456 \u043a\u0430\u0431 \u042f \u043f\u0430\u0432\u044b\u043d\u0456\u0448\u0447\u0430\u045e \u0456\u0445. \u0417 \u0446\u044f\u0431\u0435 \u0436 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0440\u043e\u0434&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0447\u0430\u045e \u043c\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0427\u0430\u043c\u0443 \u0440\u0430\u0437\u0433\u0430\u0440\u044d\u045e\u0441\u044f \u0422\u0432\u043e\u0439 \u0433\u043d\u0435\u045e \u043d\u0430 \u0422\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0422\u044b \u0432\u044b\u0432\u0435\u045e \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044e \u043c\u043e\u0446\u0430\u0439 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e? \u041d\u0430\u0432\u043e\u0448\u0442\u0430, \u043a\u0430\u0431 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u043a\u0430\u0437\u0430\u043b\u0456: &ldquo;\u041d\u0430 \u0437\u043b\u043e \u0432\u044b\u0432\u0435\u045e \u0456\u0445, \u043a\u0430\u0431 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0443 \u0433\u0430\u0440\u0430\u0445 \u0456 \u0441\u0446\u0435\u0440\u0446\u0456 \u0437 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u044f\u043c\u043b\u0456&rdquo;. \u0410\u0434\u0445\u0456\u043b\u0456 \u043f\u043e\u043b\u044b\u043c\u044f \u0433\u043d\u0435\u0432\u0443 \u0422\u0432\u0430\u0439\u0433\u043e, \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0439 \u0456 \u043d\u0435 \u0440\u0430\u0431\u0456 \u0437\u043b\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u043c\u0443. \u0423\u0441\u043f\u043e\u043c\u043d\u0456 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0406\u0441\u0430\u0430\u043a\u0430 \u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0441\u043b\u0443\u0433\u0430\u045e \u0422\u0432\u0430\u0456\u0445, \u044f\u043a\u0456\u043c \u0422\u044b \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041f\u0430\u043c\u043d\u043e\u0436\u0443 \u0432\u0430\u0448\u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a \u0437\u043e\u0440\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f; \u0456 \u045e\u0441\u044e \u0433\u044d\u0442\u0443 \u0437\u044f\u043c\u043b\u044e, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u043a\u0430\u0437\u0430\u045e \u042f, \u0434\u0430\u043c \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u0432\u0430\u0448\u044b\u043c \u0443 \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u041f\u0430\u043d \u0430\u0434 \u0437\u043b\u0430, \u044f\u043a\u043e\u0435 \u0434\u0443\u043c\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437 \u0433\u0430\u0440\u044b, \u043d\u0435\u0441\u0443\u0447\u044b \u045e \u0440\u0443\u043a\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u0432\u0435 \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0421\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u043d\u0430 \u044f\u043a\u0456\u0445 \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0437 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0431\u0430\u043a\u043e\u045e. \u041d\u0430 \u0430\u0434\u043d\u044b\u043c \u0456 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u0431\u0430\u043a\u0443 \u0431\u044b\u043b\u043e \u043d\u0430 \u0456\u0445 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430. \u0410 \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0411\u043e\u0433\u0430, \u0456 \u043f\u0456\u0441\u044c\u043c\u0451\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0456\u0441\u044c\u043c\u0451\u043d\u0430\u043c\u0456 \u0411\u043e\u0433\u0430, \u0432\u044b\u0441\u0435\u0447\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u043f\u0430\u0447\u0443\u045e \u0448\u0443\u043c \u0456 \u043a\u0440\u044b\u043a \u043d\u0430\u0440\u043e\u0434\u0443, \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0423 \u043b\u0430\u0433\u0435\u0440\u044b \u0447\u0443\u0442\u043d\u044b \u0448\u0443\u043c \u0431\u0456\u0442\u0432\u044b&raquo;. \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u043d\u0435 \u0433\u0443\u043b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430\u0433\u0430 \u0432\u043e\u043a\u043b\u0456\u0447\u0443 \u0456 \u043d\u0435 \u0433\u0443\u043b \u043f\u0430\u0440\u0430\u0436\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u044f \u0447\u0443\u044e \u0433\u043e\u043b\u0430\u0441 \u0441\u043f\u0435\u0432\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0451\u043d \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0430 \u043b\u0430\u0433\u0435\u0440\u0430, \u0443\u0431\u0430\u0447\u044b\u045e \u0446\u044f\u043b\u044c\u0446\u0430 \u0456 \u043f\u043b\u044f\u0441\u043a\u0456. \u0406 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u045e\u0441\u044f \u0433\u043d\u0435\u045e \u041c\u0430\u0439\u0441\u0435\u044f, \u0456 \u0451\u043d \u0432\u044b\u043a\u0456\u043d\u0443\u045e \u0442\u0430\u0431\u043b\u0456\u0446\u044b \u0437 \u0440\u0443\u043a \u0441\u0432\u0430\u0456\u0445, \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0456\u0445 \u043a\u0430\u043b\u044f \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u0442\u043e\u0439 \u0433\u0430\u0440\u044b. \u0423\u0437\u044f\u045e \u0446\u044f\u043b\u044c\u0446\u0430, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u0456 \u0441\u043f\u0430\u043b\u0456\u045e \u044f\u0433\u043e \u045e \u0430\u0433\u043d\u0456. \u0421\u0446\u0451\u0440 \u044f\u0433\u043e \u045e \u043f\u044b\u043b, \u0432\u044b\u0441\u044b\u043f\u0430\u045e \u0443 \u0432\u0430\u0434\u0443 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0456\u0446\u044c \u044f\u0435 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 106 (105), 20. 21. 22; \u043f\u0430\u0440. \u0420\u044b\u043c 1, 21. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043c\u044f\u043d\u0456\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u043d\u0430 \u0432\u044b\u044f\u0432\u0443 \u0446\u044f\u043b\u044c\u0446\u0430, \u044f\u043a\u0456 \u0435\u0441\u0446\u044c \u0442\u0440\u0430\u0432\u0443.<span style=\"color: #ff0000;\"> *<\/span> \u0417\u0430\u0431\u044b\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0417\u0431\u0430\u045e\u0446\u0443, \u044f\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0443 \u0415\u0433\u0456\u043f\u0446\u0435, \u0433\u0440\u043e\u0437\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u043a\u0430\u043b\u044f \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u0446\u044f\u043c\u043d\u0456\u043b\u0430\u0441\u044f \u0456\u0445 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430; \u0441\u043b\u0430\u0432\u0443 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0437\u0430\u043c\u044f\u043d\u0456\u043b\u0456 \u043d\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u0431\u044b\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0417\u0431\u0430\u045e\u0446\u0443, \u044f\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0443 \u0415\u0433\u0456\u043f\u0446\u0435, \u0433\u0440\u043e\u0437\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u043a\u0430\u043b\u044f \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"534","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">33, 7-11. 18-23; 34, 5-9. 29-35<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u043e\u045e\u043d\u0430\u0435 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u041c\u0430\u0439\u0441\u0435\u044e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u044f\u045e \u0448\u0430\u0446\u0451\u0440 \u0456 \u0440\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u045e \u044f\u0433\u043e \u043f\u0430-\u0437\u0430 \u043b\u0430\u0433\u0435\u0440\u0430\u043c, \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u0442\u0430\u043d\u0430, \u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e \u0448\u0430\u0442\u0440\u043e\u043c \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f. \u0406 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u045e \u041f\u0430\u043d\u0430, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0434\u0430 \u0448\u0430\u0442\u0440\u0430 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u043f\u0430-\u0437\u0430 \u043b\u0430\u0433\u0435\u0440\u0430\u043c. \u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0434\u0430 \u0448\u0430\u0442\u0440\u0430, \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u045e\u0441\u0442\u0430\u0432\u0430\u043b\u0456, \u0456 \u043a\u043e\u0436\u043d\u044b, \u0441\u0442\u043e\u044f\u0447\u044b \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u043c\u0451\u0442, \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u0443\u0441\u043b\u0435\u0434 \u041c\u0430\u0439\u0441\u0435\u044e, \u043f\u0430\u043a\u0443\u043b\u044c \u0451\u043d \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0448\u0430\u0446\u0451\u0440. \u041a\u0430\u043b\u0456 \u0436 \u0451\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0443 \u0448\u0430\u0446\u0451\u0440, \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b \u0441\u043b\u0443\u043f \u0456 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e\u0441\u044f \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435. \u041f\u0430\u043d \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0430 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b \u0441\u043b\u0443\u043f, \u0448\u0442\u043e \u0441\u0442\u0430\u044f\u045e \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0448\u0430\u0446\u0451\u0440. \u0422\u0430\u0434\u044b \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0443\u0441\u0442\u0430\u0432\u0430\u045e, \u0456 \u043a\u043e\u0436\u043d\u044b \u043a\u043b\u0430\u043d\u044f\u045e\u0441\u044f \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u043c\u0451\u0442. \u0410 \u041f\u0430\u043d \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440, \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435 \u0437 \u0441\u044f\u0431\u0440\u0430\u043c \u0441\u0432\u0430\u0456\u043c. \u041f\u0430\u0441\u043b\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u045e \u043b\u0430\u0433\u0435\u0440, \u0430 \u044f\u0433\u043e\u043d\u044b \u0441\u043b\u0443\u0433\u0430 \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u043d\u0435 \u0430\u0434\u043b\u0443\u0447\u0430\u045e\u0441\u044f \u0437 \u0448\u0430\u0442\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u041f\u0430\u043d\u0443: &laquo;\u041f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u043f\u0440\u0430\u0448\u0443, \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443&raquo;. \u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &laquo;\u042f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u045e\u0441\u044e \u0441\u0432\u0430\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0443 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0456\u043c\u044f \u041f\u0430\u043d\u0430; \u0456 \u0431\u0443\u0434\u0443 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0434\u0430 \u0442\u0430\u0433\u043e, \u0434\u0430 \u043a\u0430\u0433\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u044e, \u0456 \u0431\u0443\u0434\u0443 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u044e&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0434\u0430\u043b\u0435\u0439: &laquo;\u0422\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041c\u0430\u0439\u0433\u043e, \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u041c\u044f\u043d\u0435 \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c&raquo;. \u0406 \u044f\u0448\u0447\u044d \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &laquo;\u0412\u043e\u0441\u044c \u043c\u0435\u0441\u0446\u0430 \u043a\u0430\u043b\u044f \u041c\u044f\u043d\u0435, \u0441\u0442\u0430\u043d\u044c \u043a\u0430\u043b\u044f \u0441\u043a\u0430\u043b\u044b; \u043a\u0430\u043b\u0456 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u041c\u0430\u044f \u0441\u043b\u0430\u0432\u0430, \u042f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435 \u045e \u0448\u0447\u044b\u043b\u0456\u043d\u0435 \u0441\u043a\u0430\u043b\u044b, \u0456 \u0434\u0430\u043b\u043e\u043d\u044c \u041c\u0430\u044f \u0437\u0430\u043a\u0440\u044b\u0435 \u0446\u044f\u0431\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u043c\u0443 \u0434\u0430\u043b\u043e\u043d\u044c \u0441\u0432\u0430\u044e, \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u041c\u044f\u043d\u0435 \u0437\u0437\u0430\u0434\u0443, \u0430\u043b\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041c\u0430\u0439\u0433\u043e \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0448 \u0443\u0431\u0430\u0447\u044b\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0441\u044b\u0448\u043e\u045e \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0443, \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0442\u0430\u045e \u043f\u0430\u0431\u043b\u0456\u0437\u0443 \u042f\u0433\u043e \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u0406 \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0434 \u0456\u043c, \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e: &laquo;\u041f\u0430\u043d, \u041f\u0430\u043d \u0411\u043e\u0433 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u043b\u0456\u0442\u0430\u0441\u0446\u0456\u0432\u044b, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0456 \u0448\u043c\u0430\u0442\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b, \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430 \u0442\u044b\u0441\u044f\u0447\u044b \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u044f\u043a\u0456 \u0434\u0430\u0440\u0443\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430 \u0456 \u0433\u0440\u044d\u0445, \u0430\u043b\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0431\u0435\u0437 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0456 \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0430\u0439\u0446\u043e\u045e \u043a\u0430\u0440\u0430\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0456 \u045e\u043d\u0443\u043a\u0430\u045e \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u0456 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0434\u0440\u0430\u0437\u0443 \u045e\u043f\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u045e\u0441\u044f \u0411\u043e\u0433\u0443, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445, \u041f\u0430\u043d\u0435, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u041f\u0430\u043d \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441, \u0431\u043e \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b \u0437 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u043a\u0430\u0440\u043a\u0430\u043c. \u0414\u0430\u0440\u0443\u0439 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430\u0439 \u0441\u0432\u0430\u0451\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u045e \u0440\u0443\u043a\u0430\u0445 \u0441\u043a\u0440\u044b\u0436\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u0451\u043d \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0430\u0434 \u0440\u0430\u0437\u043c\u043e\u0432\u044b \u0437 \u041f\u0430\u043d\u0430\u043c \u0437\u0437\u044f\u043b\u0430 \u0441\u043a\u0443\u0440\u0430 \u0442\u0432\u0430\u0440\u0443 \u044f\u0433\u043e\u043d\u0430\u0433\u0430. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0410\u0430\u0440\u043e\u043d \u0456 \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u041c\u0430\u0439\u0441\u0435\u044f. \u0412\u043e\u0441\u044c \u0441\u043a\u0443\u0440\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0442\u0432\u0430\u0440\u0443 \u0437\u0437\u044f\u043b\u0430, \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0434\u0430 \u044f\u0433\u043e. \u0410\u043b\u0435 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456\u0445, \u0456 \u0410\u0430\u0440\u043e\u043d \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u0445\u043e\u0434\u0443 \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u044f\u0433\u043e, \u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u0456\u043c\u0456. \u0410 \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0434\u044b\u0448\u043b\u0456 \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0451\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d \u043d\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e \u0437 \u0456\u043c\u0456 \u0440\u0430\u0437\u043c\u043e\u0432\u0443, \u0437\u0430\u0441\u043b\u0430\u043d\u0456\u045e \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439. \u0406 \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0434\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0406\u043c, \u0451\u043d \u0437\u0434\u044b\u043c\u0430\u045e \u043f\u043e\u043a\u0440\u044b\u0432\u0430 \u0430\u0436 \u0434\u0430 \u0432\u044b\u0439\u0441\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e, \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u045e \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e\u0441\u0451, \u0448\u0442\u043e \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u043d\u0430. \u0406 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u044f\u043a \u0437\u0437\u044f\u0435 \u0441\u043a\u0443\u0440\u0430 \u041c\u0430\u0439\u0441\u0435\u0435\u0432\u0430\u0433\u0430 \u0442\u0432\u0430\u0440\u0443, \u0430\u043b\u0435 \u0451\u043d \u0437\u0430\u0441\u043b\u0430\u043d\u044f\u045e \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u041a\u0430\u0440 3, 13. 18. 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u045e \u0441\u0430\u0431\u0435 \u0442\u0432\u0430\u0440, \u043a\u0430\u0431 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u044f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u043c\u044b \u045e\u0441\u0435 \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f, \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u0440\u0430, \u0443 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443, \u044f\u043a \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0436\u043d\u043e \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f \u043f\u043e\u043a\u0440\u044b\u0432\u0430 \u043b\u044f\u0436\u044b\u0446\u044c \u043d\u0430 \u0456\u0445 \u0441\u044d\u0440\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043c\u044b \u045e\u0441\u0435 \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f, \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u0440\u0430, \u0443 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443, \u044f\u043a \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"535","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">34, 10-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u0456 \u041a\u043e\u0434\u044d\u043a\u0441 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 <\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0412\u043e\u0441\u044c \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0447\u044b\u043d\u044e \u0446\u0443\u0434\u044b, \u044f\u043a\u0456\u0445 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u043d\u0456 \u045e \u044f\u043a\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0423\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f, \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0443 \u041f\u0430\u043d\u0430, \u0431\u043e \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0437 \u0442\u0430\u0431\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u043a\u043e\u043d\u0432\u0430\u0439 \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0442\u0430\u0431\u0435. \u042f \u0441\u0430\u043c \u043f\u0440\u0430\u0433\u0430\u043d\u044e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0430\u043c\u0430\u0440\u044d\u044f\u045e, \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430\u045e \u0456 \u0445\u0435\u0442\u0430\u045e, \u0444\u044d\u0440\u044d\u0437\u0435\u044f\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0435\u0432\u0456\u0442\u0430\u045e \u0456 \u0435\u0431\u0443\u0441\u0435\u044f\u045e. \u0410\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u0446\u044c \u0434\u0430\u043c\u043e\u0432\u0443 \u0437 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456 \u0442\u043e\u0439 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0430\u0441\u0442\u043a\u0430\u044e \u0434\u043b\u044f \u0446\u044f\u0431\u0435. \u0417\u0440\u0443\u0439\u043d\u0443\u0439\u0446\u0435 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0456 \u0456\u0445\u043d\u0456\u044f, \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u0435 \u0456\u0434\u0430\u043b\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u0456 c\u0441\u044f\u0447\u044b\u0446\u0435 \u0456\u0445\u043d\u0456\u044f \u043a\u0443\u043b\u044c\u0442\u0430\u0432\u044b\u044f \u0434\u0443\u0431\u0440\u043e\u0432\u044b.<br \/>\u041d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0439\u0441\u044f \u0456\u043d\u0448\u0430\u043c\u0443 \u0431\u043e\u0433\u0443, \u0431\u043e \u041f\u0430\u043d, \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u0417\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u043d\u044b, \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u043d\u044b\u043c. \u041d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0439 \u0434\u0430\u043c\u043e\u0432\u044b \u0437 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0437 \u0431\u0430\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0456\u043c \u0430\u0445\u0432\u044f\u0440\u044b, \u0446\u044f\u0431\u0435 \u043d\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0456\u0445\u043d\u044f\u0439 \u0430\u0445\u0432\u044f\u0440\u044b. \u041d\u0435 \u0431\u044f\u0440\u044b \u0434\u0430\u0447\u043e\u043a \u0456\u0445\u043d\u0456\u0445 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456, \u043d\u0435 \u0441\u0445\u0456\u043b\u0456\u043b\u0456 \u0456 \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0440\u0430\u0431\u0456 \u0441\u0430\u0431\u0435 \u0430\u0434\u043b\u0456\u0442\u044b\u0445 \u0431\u0430\u0433\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u0430 \u041f\u0440\u0430\u0441\u043d\u0430\u043a\u043e\u045e: \u0441\u0435\u043c \u0434\u0437\u0451\u043d \u0431\u0443\u0434\u0437\u0435\u0448 \u0435\u0441\u0446\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0435\u0441\u044f\u0446\u0430 \u0410\u0431\u0456\u0431 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456, \u044f\u043a \u042f \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435, \u0431\u043e \u045e \u0447\u0430\u0441 \u043c\u0435\u0441\u044f\u0446\u0430 \u0410\u0431\u0456\u0431 \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 &ndash; \u041c\u0430\u0451: \u043a\u043e\u0436\u043d\u0430\u044f \u0436\u044b\u0432\u0451\u043b\u0430 \u0442\u0432\u0430\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0430\u0434 \u0432\u0430\u043b\u0430 \u0456 \u0430\u0432\u0435\u0447\u043a\u0456. \u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0430\u0434 \u0430\u0441\u043b\u0430 \u0430\u0434\u043a\u0443\u043f\u0456 \u044f\u0433\u043d\u0451\u043c, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u043a\u0443\u043f\u0456\u0448, \u0437\u043b\u0430\u043c\u0430\u0439 \u044f\u043c\u0443 \u043a\u0430\u0440\u0430\u043a. \u0423\u0441\u0456\u0445 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u0441\u044b\u043d\u043e\u045e \u0441\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u043a\u0443\u043f\u0430\u0446\u044c, \u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0439\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0437 \u043f\u0443\u0441\u0442\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u043f\u0440\u0430\u0446\u0443\u0439, \u0430 \u043d\u0430 \u0441\u0451\u043c\u044b, \u044f\u043a \u0443 \u0447\u0430\u0441 \u0432\u043e\u0440\u044b\u0432\u0430, \u0442\u0430\u043a \u0456 \u045e \u0447\u0430\u0441 \u0436\u043d\u0456\u0432\u0430, \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043a\u0443\u0439 \u0441\u0432\u044f\u0442\u0430 \u0422\u044b\u0434\u043d\u044f\u045e, \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u043b\u0451\u043d\u0443 \u0436\u043d\u0456\u0432\u0430 \u043f\u0448\u0430\u043d\u0456\u0446\u044b \u0456 \u0441\u0432\u044f\u0442\u0430 \u0423\u0440\u0430\u0434\u0436\u0430\u044e \u045e \u043a\u0430\u043d\u0446\u044b \u0433\u043e\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u043e\u0439\u0447\u044b \u045e \u0433\u043e\u0434 \u0443\u0441\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u043f\u0440\u0430\u0433\u0430\u043d\u044e \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u0439 \u0456 \u043f\u0430\u0448\u044b\u0440\u0443 \u043c\u0435\u0436\u044b \u0442\u0432\u0430\u0435, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0437\u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0442\u0432\u0430\u044e \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u043b\u0456 \u0442\u044b \u0442\u0440\u043e\u0439\u0447\u044b \u045e \u0433\u043e\u0434 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0439 \u043d\u0430\u0434 \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u041c\u0430\u0451\u0439. \u0406 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043b\u044f\u0436\u0430\u0446\u044c \u0434\u0430 \u0440\u0430\u043d\u0456\u0446\u044b \u0430\u0445\u0432\u044f\u0440\u0430 \u043d\u0430 \u0441\u0432\u044f\u0442\u0430 \u041f\u0430\u0441\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u044b \u043f\u043b\u0451\u043d \u0437\u044f\u043c\u043b\u0456 \u0442\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u0448 \u0443 \u0434\u043e\u043c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043a\u0430\u0437\u043b\u044f\u043d\u044f \u045e \u043c\u0430\u043b\u0430\u043a\u0443 \u044f\u0433\u043e \u043c\u0430\u0446\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0417\u0430\u043f\u0456\u0448\u044b \u0441\u0430\u0431\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0442\u0430\u0431\u043e\u0439 \u0456 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043c \u0437 \u041f\u0430\u043d\u0430\u043c \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439. \u041d\u0435 \u0435\u045e \u0445\u043b\u0435\u0431\u0430 \u0456 \u043d\u0435 \u043f\u0456\u045e \u0432\u0430\u0434\u044b. \u0406 \u0437\u0430\u043f\u0456\u0441\u0430\u045e \u043d\u0430 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445 \u0441\u043b\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 &ndash; \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0441\u043b\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 17. 18; 2 \u041a\u0430\u0440 3, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430 \u043b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0431&rsquo;\u0432\u044f\u0441\u0446\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u045e\u0441\u0435 \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f, \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u0440\u0430, \u0443 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0431&rsquo;\u0432\u044f\u0441\u0446\u0456\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"536","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">35, 30 &ndash; 36, 1; 37, 1-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0431\u0443\u0434\u043e\u0432\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u043a\u0430\u045e\u0447\u044d\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0432\u043e\u0441\u044c \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0411\u044d\u0441\u0430\u043b\u0435\u044d\u043b\u044f, \u0441\u044b\u043d\u0430 \u0423\u0440\u044b\u0456, \u0441\u044b\u043d\u0430 \u0425\u0443\u0440\u0430, \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u042e\u0434\u044b, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u044f\u0433\u043e \u0434\u0443\u0445\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0443\u043c\u0435\u043b\u0430\u0441\u0446\u044e \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0440\u0430\u043c\u044f\u0441\u0442\u0432\u0435, \u043a\u0430\u0431 \u0451\u043d \u0430\u0431\u0434\u0443\u043c\u0430\u045e \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0446\u044b \u045e \u0437\u043e\u043b\u0430\u0446\u0435, \u0441\u0440\u044d\u0431\u0440\u044b \u0456 \u0431\u0440\u043e\u043d\u0437\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u043a\u0443 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0434\u043b\u044f \u0430\u043f\u0440\u0430\u045e, \u0440\u0430\u0437\u044c\u0431\u0443 \u0434\u0440\u0430\u045e\u043d\u0456\u043d\u044b, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0443\u0441\u044f\u043a\u0443\u044e \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u0443\u044e \u043f\u0440\u0430\u0446\u0443. \u041f\u0430\u043d \u0443\u043a\u043b\u0430\u045e \u0443 \u044f\u0433\u043e\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0441\u044d\u0440\u0446\u0430 \u0410\u0445\u0430\u043b\u0456\u044f\u0431\u0430, \u0441\u044b\u043d\u0430 \u0410\u0445\u0456\u0437\u0430\u043c\u0430\u0445\u0430 \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0414\u0430\u043d\u0430, \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0432\u0443\u0447\u044b\u0446\u044c \u0456\u043d\u0448\u044b\u0445. \u0410\u0431\u043e\u0434\u0432\u0443\u0445 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430 \u0434\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u045e\u0441\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0440\u0430\u0437\u044c\u0431\u044f\u0440\u0430 \u0456 \u043c\u0430\u0441\u0442\u0430\u043a\u0430, \u0433\u0430\u0444\u0442\u0430\u0440\u0430 \u043f\u0430 \u0444\u0456\u044f\u043b\u0435\u0442\u0430\u0432\u0430\u0439, \u043f\u0443\u0440\u043f\u0443\u0440\u043d\u0430\u0439, \u043f\u0443\u043d\u0441\u043e\u0432\u0430\u0439 \u0442\u043a\u0430\u043d\u0456\u043d\u0435 \u0456 \u043f\u0430 \u0432\u0456\u0441\u043e\u043d\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043a\u0430\u0447\u0430 &ndash; \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043f\u0440\u0430\u0446\u0443 \u0456 \u043f\u0440\u044b\u0434\u0443\u043c\u0432\u0430\u0435 \u043d\u043e\u0432\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044d\u0441\u0430\u043b\u0435\u044d\u043b\u044c, \u0456 \u0410\u0445\u0430\u043b\u0456\u044f\u0431, \u0456 \u043a\u043e\u0436\u043d\u044b \u045e\u043c\u0435\u043b\u044b \u043c\u0443\u0436, \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u0430\u0434\u0430\u0440\u044b\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0437\u0440\u043e\u0431\u044f\u0446\u044c \u0443\u0441\u0451 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0435 \u0434\u043b\u044f \u045e\u0436\u044b\u0442\u043a\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u0411\u044d\u0441\u0430\u043b\u0435\u044d\u043b\u044c \u043a\u0430\u045e\u0447\u044d\u0433 \u0437 \u0434\u0440\u044d\u0432\u0430 \u0430\u043a\u0430\u0446\u044b\u0456, \u0434\u0430\u045e\u0436\u044b\u043d\u044f \u044f\u043a\u043e\u0433\u0430 \u0441\u043a\u043b\u0430\u0434\u0430\u043b\u0430 \u0434\u0432\u0430 \u0437 \u043f\u0430\u043b\u043e\u0432\u0430\u0439 \u043b\u043e\u043a\u0446\u0456, \u0448\u044b\u0440\u044b\u043d\u044f \u043d\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u0430 \u043b\u043e\u043a\u0446\u044f \u0456 \u0432\u044b\u0448\u044b\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u0430 \u043b\u043e\u043a\u0446\u044f. \u0406 \u043f\u0430\u043a\u0440\u044b\u045e \u044f\u0433\u043e \u0447\u044b\u0441\u0442\u044b\u043c \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0437\u043d\u0443\u0442\u0440\u044b \u0456 \u0437\u0432\u043e\u043d\u043a\u0443. \u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e \u0437\u0430\u043b\u0430\u0442\u044b \u0432\u044f\u043d\u0435\u0446. \u0406 \u0430\u0434\u043b\u0456\u045e \u0434\u043b\u044f \u044f\u0433\u043e \u0447\u0430\u0442\u044b\u0440\u044b \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u043a\u0430\u043b\u044c\u0446\u044b \u0434\u043b\u044f \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0432\u0443\u0433\u043b\u043e\u045e \u044f\u0433\u043e: \u0434\u0432\u0430 \u043a\u0430\u043b\u044c\u0446\u044b \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443 \u0456 \u0434\u0432\u0430 \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443. \u0417\u0440\u0430\u0431\u0456\u045e \u0440\u043e\u045e\u043d\u044b\u044f \u0436\u044d\u0440\u0434\u043a\u0456 \u0437 \u0434\u0440\u044d\u0432\u0430 \u0430\u043a\u0430\u0446\u044b\u0456 \u0456 \u043f\u0430\u043a\u0440\u044b\u045e \u0456\u0445 \u0437\u043e\u043b\u0430\u0442\u0430\u043c. \u0406 \u045e\u043a\u043b\u0430\u045e \u0433\u044d\u0442\u044b\u044f \u0436\u044d\u0440\u0434\u043a\u0456 \u045e \u043a\u043e\u043b\u044c\u0446\u044b \u043d\u0430 \u0431\u0430\u043a\u0430\u0445 \u043a\u0430\u045e\u0447\u044d\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430\u0441\u0456\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u0432\u0435\u043a\u0430 \u0437 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u0434\u0430\u045e\u0436\u044b\u043d\u0451\u044e \u043d\u0430 \u0434\u0432\u0430 \u0437 \u043f\u0430\u043b\u043e\u0432\u0430\u044e \u043b\u043e\u043a\u0446\u0456, \u0430 \u0448\u044b\u0440\u044b\u043d\u0451\u044e \u043d\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u0430. \u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u0432\u0443\u0445 \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u045e, \u0432\u044b\u0447\u0430\u043a\u0430\u043d\u0456\u045e \u0456\u0445 \u043d\u0430 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u043a\u0430\u043d\u0446\u0430\u0445 \u0432\u0435\u043a\u0430: \u0430\u0434\u043d\u0430\u0433\u043e \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430 \u043d\u0430 \u0430\u0434\u043d\u044b\u043c \u043a\u0430\u043d\u0446\u044b, \u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c. \u0417\u0440\u0430\u0431\u0456\u045e \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u045e \u043d\u0430 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0431\u0430\u043a\u0430\u0445 \u0432\u0435\u043a\u0430. \u0425\u0435\u0440\u0443\u0431\u0456\u043c\u044b \u0431\u044b\u043b\u0456 \u0437 \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440\u0442\u044b\u043c\u0456 \u045e\u0433\u043e\u0440\u0443 \u043a\u0440\u044b\u043b\u0430\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u0432\u0435\u043a\u0430. \u042f\u043d\u044b \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u043d\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u0430 \u0442\u0432\u0430\u0440\u044b \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u045e \u0431\u044b\u043b\u0456 \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u044f \u0434\u0430 \u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 84 (83), 2. 3; \u041f\u0441 46 (45), 5b. 6\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456\u044f \u043c\u0456\u043b\u044b\u044f \u0422\u0432\u0430\u0435 \u0448\u0430\u0442\u0440\u044b, \u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0417\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u0456 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0434\u0432\u0430\u0440\u044b \u041f\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0421\u044d\u0440\u0446\u0430 \u043c\u0430\u0451 \u0456 \u0446\u0435\u043b\u0430 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0432\u044f\u0442\u044b\u044f \u0448\u0430\u0442\u0440\u044b \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430: \u0411\u043e\u0433 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0443\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u044d\u0440\u0446\u0430 \u043c\u0430\u0451 \u0456 \u0446\u0435\u043b\u0430 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"537","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">40, 16-38<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0423\u0437\u0432\u044f\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0412\u043e\u0431\u043b\u0430\u043a\u0430 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451 \u0442\u0430\u043a, \u044f\u043a \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d. \u0423 \u043f\u0435\u0440\u0448\u044b \u043c\u0435\u0441\u044f\u0446 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0433\u043e\u0434\u0430, \u0443 \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430 \u0441\u043a\u0456\u043d\u0456\u044f. \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u043d\u0451\u0441 \u0441\u043a\u0456\u043d\u0456\u044e, \u0437\u0430\u043a\u043b\u0430\u045e \u044f\u0435 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0431\u044f\u0440\u0432\u0451\u043d\u044b, \u043f\u0430\u043a\u043b\u0430\u045e \u0436\u044d\u0440\u0434\u043a\u0456 \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0441\u043b\u0443\u043f\u044b. \u0420\u0430\u0441\u0446\u044f\u0433\u043d\u0443\u045e \u043d\u0430\u0434 \u0441\u043a\u0456\u043d\u0456\u044f\u0439 \u0448\u0430\u0446\u0451\u0440 \u0456 \u0440\u0430\u0437\u043c\u044f\u0441\u0446\u0456\u045e \u043f\u043e\u043a\u0440\u044b\u0432\u0430 \u0448\u0430\u0442\u0440\u0430 \u043d\u0430\u0434 \u044f\u0435 \u0432\u0435\u0440\u0445\u0430\u043c, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d. \u041f\u0430\u0441\u043b\u044f \u045e\u0437\u044f\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u043f\u0430\u043a\u043b\u0430\u045e \u044f\u0433\u043e \u045e \u043a\u0430\u045e\u0447\u044d\u0433 \u0456 \u045e\u0441\u0442\u0430\u0432\u0456\u045e \u0448\u0430\u0441\u0442\u044b \u045e \u043a\u043e\u043b\u044c\u0446\u044b \u043a\u0430\u045e\u0447\u044d\u0433\u0430, \u0430 \u0437\u0432\u0435\u0440\u0445\u0443 \u043d\u0430\u0434 \u0456\u043c \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u0432\u0435\u043a\u0430. \u0423\u043d\u0451\u0441 \u043a\u0430\u045e\u0447\u044d\u0433 \u0443 \u0441\u043a\u0456\u043d\u0456\u044e \u0456 \u043f\u0430\u0432\u0435\u0441\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u0456 \u0437\u0430\u043a\u0440\u044b\u045e \u043a\u0430\u045e\u0447\u044d\u0433 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u043e\u043b \u0443 \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u043f\u0430\u045e\u043d\u043e\u0447\u043d\u044b\u043c \u0431\u0430\u043a\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u0437\u0430\u0441\u043b\u043e\u043d\u0430\u0439, \u0430 \u043d\u0430 \u0456\u043c \u0440\u0430\u0441\u043a\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u0445\u043b\u044f\u0431\u044b, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u044f\u0446\u0456\u043b\u044c\u043d\u0456\u043a \u0443 \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0442\u0430\u043b\u0430 \u045e \u043f\u0430\u045e\u0434\u043d\u0451\u0432\u044b\u043c \u0431\u0430\u043a\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u043d\u0430 \u0456\u043c \u0437\u0430\u043f\u0430\u043b\u0456\u045e \u043b\u044f\u043c\u043f\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0437\u0430\u043b\u0430\u0442\u044b \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u0443 \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u0434 \u0437\u0430\u0441\u043b\u043e\u043d\u0430\u0439 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0437\u0430\u043f\u0430\u043b\u0456\u0446\u044c \u043d\u0430 \u0456\u043c \u043f\u0430\u0445\u0443\u0447\u0430\u0435 \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e. \u0417\u0430\u0432\u0435\u0441\u0456\u045e \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0443\u0432\u0430\u0445\u043e\u0434 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u0406 \u0430\u043b\u0442\u0430\u0440 \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0443\u0432\u0430\u0445\u043e\u0434\u0430\u043c \u0443 \u0441\u043a\u0456\u043d\u0456\u044e, \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u043d\u0430 \u0456\u043c \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u0445\u043b\u044f\u0431\u043e\u045e, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0434\u0437\u044c \u043f\u0430\u043c\u0456\u0436 \u0448\u0430\u0442\u0440\u043e\u043c \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c \u0456 \u043d\u0430\u043b\u0456\u045e \u0443 \u044f\u0435 \u0432\u0430\u0434\u044b \u0434\u043b\u044f \u0430\u0431\u043c\u044b\u0446\u0446\u044f. \u0410 \u041c\u0430\u0439\u0441\u0435\u0439, \u0410\u0430\u0440\u043e\u043d \u0456 \u044f\u0433\u043e \u0441\u044b\u043d\u044b, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u0456 \u043a\u0430\u043b\u0456 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430, \u043c\u044b\u043b\u0456 \u045e \u0451\u0439 \u0440\u0443\u043a\u0456 \u0456 \u043d\u043e\u0433\u0456, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e. \u0417\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446 \u0432\u0430\u043a\u043e\u043b \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a, \u0430 \u0431\u0440\u0430\u043c\u0443 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u0430 \u0437\u0430\u0432\u0435\u0441\u0456\u045e \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c. \u0422\u0430\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u045e \u043f\u0440\u0430\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u043a\u0456\u043d\u0456\u044e. \u0410 \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0435 \u043c\u043e\u0433 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u0431\u043e \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u043b\u0430 \u043d\u0430\u0434 \u0456\u043c \u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0430 \u0441\u043a\u0456\u043d\u0456\u044e. \u0410 \u043a\u0430\u043b\u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u043f\u0430\u0434\u044b\u043c\u0430\u043b\u0430\u0441\u044f \u0430\u0434 \u0441\u043a\u0456\u043d\u0456\u0456, \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044b\u0440\u0443\u0448\u0432\u0430\u043b\u0456 \u045e \u0434\u0430\u043b\u0435\u0439\u0448\u0430\u0435 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u043d\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u043b\u0430\u0441\u044f, \u0442\u043e \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0430\u0436 \u0434\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u043f\u0430\u0434\u044b\u043c\u0430\u043b\u0430\u0441\u044f. \u0412\u043e\u0431\u043b\u0430\u043a\u0430 \u0436 \u041f\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0434 \u0441\u043a\u0456\u043d\u0456\u044f\u0439 \u0434\u043d\u0451\u043c, \u0430 \u043d\u043e\u0447\u0447\u0443 \u0431\u044b\u045e \u043d\u0430\u0434 \u0451\u0439 \u0430\u0433\u043e\u043d\u044c \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u044f\u0433\u043e \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u045e\u0441\u044f\u0433\u043e \u0456\u0445 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 10, 1b. 2\u0430; \u0417\u044b\u0445 40, 34<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u045e\u0441\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0434 \u0432\u043e\u0431\u043b\u0430\u043a\u0430\u043c, \u0443\u0441\u0435 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0441\u0435 \u045e \u041c\u0430\u0439\u0441\u0435\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f \u045e \u0432\u043e\u0431\u043b\u0430\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0431\u043b\u0430\u043a\u0430 \u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u043a\u0456\u043d\u0456\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u045e \u041c\u0430\u0439\u0441\u0435\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f \u045e \u0432\u043e\u0431\u043b\u0430\u043a\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"541","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0435\u0432\u0456\u0442\u0430 <span style=\"color: #ff0000;\">8, 1-17; 9, 22-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u0410\u0430\u0440\u043e\u043d\u0430 \u0456 \u044f\u0433\u043e \u0441\u044b\u043d\u043e\u045e, \u0456 \u0448\u0430\u0442\u044b, \u0456 \u0430\u043b\u0435\u0439 \u0434\u043b\u044f \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f, \u0456 \u0446\u044f\u043b\u044c\u0446\u0430 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445, \u0456 \u0434\u0432\u0443\u0445 \u0431\u0430\u0440\u0430\u043d\u043e\u045e, \u0456 \u043a\u043e\u0448 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u043e\u045e. \u0406 \u0437\u0431\u044f\u0440\u044b \u045e\u0441\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u044f\u043c\u0443 \u041f\u0430\u043d. \u0406 \u0441\u0430\u0431\u0440\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456: &laquo;\u0412\u043e\u0441\u044c \u0441\u043f\u0440\u0430\u0432\u0430, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0410\u0430\u0440\u043e\u043d\u0443 \u0456 \u0441\u044b\u043d\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c, \u0456 \u0430\u0431\u043c\u044b\u045e \u0456\u0445 \u0432\u0430\u0434\u043e\u044e. \u0406 \u045e\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u044f\u0433\u043e \u0442\u0443\u043d\u0456\u043a\u0443, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e \u044f\u0433\u043e \u043f\u0430\u0441\u0430\u043c \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u0448\u0430\u0442\u0443, \u0443\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u044f\u0435 \u044d\u0444\u043e\u0434 \u0456 \u0430\u043f\u0435\u0440\u0430\u0437\u0430\u045e \u044f\u0433\u043e \u043f\u0430\u0441\u0430\u043c \u044d\u0444\u043e\u0434\u0443, \u0456 \u043f\u0440\u044b\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0456\u043c \u044d\u0444\u043e\u0434 \u0434\u0430 \u044f\u0433\u043e. \u0406 \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u043d\u0430 \u0456\u043c \u043f\u0435\u043a\u0442\u0430\u0440\u0430\u043b, \u0456 \u045e\u043a\u043b\u0430\u045e \u0443 \u043f\u0435\u043a\u0442\u0430\u0440\u0430\u043b \u0443\u0440\u044b\u043c \u0456 \u0442\u0443\u043c\u0456\u043c. \u041d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u044f\u0433\u043e \u043d\u0430\u0434\u0437\u0435\u045e \u0442\u0443\u0440\u0431\u0430\u043d, \u0430 \u0441\u043f\u0435\u0440\u0430\u0434\u0443 \u043d\u0430 \u0442\u0443\u0440\u0431\u0430\u043d\u0435 \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u0437\u0430\u043b\u0430\u0442\u0443\u044e \u0442\u0430\u0431\u043b\u0456\u0447\u043a\u0443, \u0434\u044b\u044f\u0434\u044d\u043c\u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0437\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u043b\u0435\u0439 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f, \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0441\u043a\u0456\u043d\u0456\u044e \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0451\u0439 \u0431\u044b\u043b\u043e, \u0456 \u043f\u0430\u0441\u0432\u044f\u0446\u0456\u045e \u044f\u0435. \u0410\u043a\u0440\u0430\u043f\u0456\u045e \u0430\u043b\u0435\u0435\u043c \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u0456 \u045e\u0441\u0451 \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u043d\u0430 \u0456\u043c, \u0456 \u045e\u043c\u044b\u0432\u0430\u043b\u044c\u043d\u0456\u043a, \u0456 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0443 \u044f\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0456\u0445. \u0406 \u0432\u044b\u043b\u0456\u045e \u0430\u043b\u0435\u0439 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0410\u0430\u0440\u043e\u043d\u0430, \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u0434\u0437\u0435\u043b\u044f \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f. \u041f\u0430\u0441\u043b\u044f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0441\u044b\u043d\u0430\u043c \u0410\u0430\u0440\u043e\u043d\u0430 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0456\u0445 \u0443 \u0442\u0443\u043d\u0456\u043a\u0456, \u0456 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e \u0456\u0445 \u043f\u0430\u0441\u0430\u043c\u0456, \u0456 \u043d\u0430\u0434\u0437\u0435\u045e \u043d\u0430 \u0456\u0445 \u0442\u0443\u0440\u0431\u0430\u043d\u044b, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0432\u0451\u045e \u0446\u044f\u043b\u044c\u0446\u0430 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445, \u0456 \u0410\u0430\u0440\u043e\u043d \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u044b\u043d\u0430\u043c\u0456 \u044f\u0433\u043e \u045e\u0441\u043a\u043b\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0446\u044f\u043b\u044c\u0446\u0430, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456. \u0406 \u0437\u0430\u0440\u044d\u0437\u0430\u045e \u044f\u0433\u043e, \u0456 \u045e\u0437\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043a\u0440\u043e\u045e, \u0456 \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u043f\u0430\u043c\u0430\u0437\u0430\u045e \u0451\u044e \u0440\u0430\u0433\u0456 \u0430\u043b\u0442\u0430\u0440\u0430 \u0437 \u0443\u0441\u0456\u0445 \u0431\u0430\u043a\u043e\u045e, \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a. \u0417\u0430\u0442\u044b\u043c \u0432\u044b\u043b\u0456\u045e \u043a\u0440\u043e\u045e \u0434\u0430 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u044f\u0433\u043e, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u043d\u0430 \u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f. \u041f\u0430\u0441\u043b\u044f \u045e\u0437\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0432\u0435\u0441\u044c \u043b\u043e\u0439 \u0437 \u043d\u0443\u0442\u0440\u0430 \u0456 \u0441\u0430\u043b\u044c\u043d\u0456\u043a \u0437 \u043f\u044f\u0447\u043e\u043d\u043a\u0456, \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u043d\u044b\u0440\u043a\u0456 \u0437 \u0456\u0445\u043d\u0456\u043c \u043b\u043e\u0435\u043c \u0456 \u0441\u043f\u0430\u043b\u0456\u045e \u0456\u0445 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0443. \u0410 \u0446\u044f\u043b\u044c\u0446\u0430, \u0448\u043a\u0443\u0440\u0443 \u044f\u0433\u043e, \u043c\u044f\u0441\u0430 \u0456 \u0440\u044d\u0448\u0442\u043a\u0456 \u044f\u0433\u043e \u0441\u043f\u0430\u043b\u0456\u045e \u0443 \u0430\u0433\u043d\u0456 \u0437\u0430 \u043b\u0430\u0433\u0435\u0440\u0430\u043c, \u044f\u043a \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0410\u0430\u0440\u043e\u043d \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u044f\u0433\u043e. \u041f\u0430\u0441\u043b\u044f \u0441\u043f\u0443\u0441\u0446\u0456\u045e\u0441\u044f, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e\u0448\u044b \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u0433\u0440\u044d\u0445 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f, \u0456 \u043c\u0456\u0440\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443. \u0406 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d \u0443 \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u0456 \u0432\u044b\u0439\u0448\u043b\u0456, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u043d\u0430\u0440\u043e\u0434. \u0410 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443. \u0410\u0433\u043e\u043d\u044c \u0436\u0430 \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u0442\u043b\u0443\u0448\u0447, \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0456, \u0456 \u045e\u043f\u0430\u043b\u0456 \u043d\u0456\u0446\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 7, 23. 24; \u0421\u0456\u0440 45, 7\u0430. 8b\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u043c\u0430\u0442 \u0431\u044b\u043b\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0431\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u043b\u0430 \u0456\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0421\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u0435, \u0431\u043e \u0401\u043d \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0410\u0430\u0440\u043e\u043d\u0430 \u0456 \u0434\u0430\u045e \u044f\u043c\u0443 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u045e \u0441\u043b\u0430\u0432\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u0435, \u0431\u043e \u0401\u043d \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"542","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0435\u0432\u0456\u0442\u0430 <span style=\"color: #ff0000;\">16, 2-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0414\u0437\u0435\u043d\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0421\u043a\u0430\u0436\u044b \u0410\u0430\u0440\u043e\u043d\u0443, \u0431\u0440\u0430\u0442\u0443 \u0442\u0432\u0430\u0439\u043c\u0443, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u045e \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0443\u043d\u0443\u0442\u0440 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0437\u0430 \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u043f\u0435\u0440\u0430\u0434 \u0432\u0435\u043a\u0430\u043c \u043d\u0430 \u043a\u0430\u045e\u0447\u044d\u0433\u0443, \u0431\u043e \u043c\u043e\u0436\u0430 \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u043b\u0456 \u042f \u0431\u0443\u0434\u0443 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0446\u0446\u0430 \u045e \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u043d\u0430\u0434 \u0432\u0435\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0410\u0430\u0440\u043e\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0437 \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0446\u044f\u043b\u044c\u0446\u043e\u043c, \u0437 \u0432\u0430\u043b\u043e\u043c \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u0433\u0440\u044d\u0445 \u0456 \u0431\u0430\u0440\u0430\u043d\u043e\u043c \u0434\u043b\u044f \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f. \u041d\u044f\u0445\u0430\u0439 \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u044b \u043b\u044c\u043d\u044f\u043d\u044b \u0445\u0456\u0442\u043e\u043d, \u043b\u044c\u043d\u044f\u043d\u044b\u044f \u0441\u043f\u043e\u0434\u043d\u0456, \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0436\u0430\u0446\u0446\u0430 \u043b\u044c\u043d\u044f\u043d\u044b\u043c \u043f\u0430\u0441\u0430\u043c, \u0437\u0430\u0432\u0456\u043d\u0435 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u043b\u044c\u043d\u044f\u043d\u044b \u0442\u0443\u0440\u0431\u0430\u043d. \u0413\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u044b\u044f \u0448\u0430\u0442\u044b, \u0443 \u044f\u043a\u0456\u044f \u0451\u043d \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430, \u0430\u0431\u043c\u044b\u045e\u0448\u044b \u0432\u0430\u0434\u043e\u044e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u0434\u0432\u0443\u0445 \u043a\u0430\u0437\u043b\u043e\u045e \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u0430\u0440\u0430\u043d\u0430 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0410\u0430\u0440\u043e\u043d \u0446\u044f\u043b\u044c\u0446\u0430 \u0434\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c. \u041d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u0434\u0432\u0443\u0445 \u043a\u0430\u0437\u043b\u043e\u045e \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f. \u041f\u0430\u0441\u043b\u044f \u043d\u044f\u0445\u0430\u0439 \u043a\u0456\u043d\u0435 \u0410\u0430\u0440\u043e\u043d \u043b\u0451\u0441\u044b \u043d\u0430\u043a\u043e\u043d\u0442 \u0434\u0432\u0443\u0445 \u043a\u0430\u0437\u043b\u043e\u045e: \u0430\u0434\u0437\u0456\u043d \u043b\u0451\u0441 \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0430 \u0434\u0440\u0443\u0433\u0456\u044f &ndash; \u0434\u043b\u044f \u0410\u0437\u0430\u0437\u044d\u043b\u044f. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0410\u0430\u0440\u043e\u043d \u0442\u0430\u0433\u043e \u043a\u0430\u0437\u043b\u0430, \u043d\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u043f\u0430\u0434\u0437\u0435 \u043b\u0451\u0441 \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u0433\u0440\u044d\u0445. \u0410 \u043a\u0430\u0437\u043b\u0430, \u043d\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u043f\u0430\u0434\u0437\u0435 \u043b\u0451\u0441 \u0434\u043b\u044f \u0410\u0437\u0430\u0437\u044d\u043b\u044f, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0436\u044b\u0432\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0434 \u0456\u043c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0432\u044b\u0433\u043d\u0430\u0446\u044c \u044f\u0433\u043e \u0434\u0430 \u0410\u0437\u0430\u0437\u044d\u043b\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e.<br \/>\u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0410\u0430\u0440\u043e\u043d \u0446\u044f\u043b\u044c\u0446\u0430 \u0434\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0434\u043e\u043c \u0441\u0432\u043e\u0439, \u0456 \u0437\u0430\u0440\u044d\u0436\u0430 \u0446\u044f\u043b\u044c\u0446\u0430 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0441\u0432\u043e\u0439 \u0433\u0440\u044d\u0445. \u041d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u043f\u043e\u045e\u043d\u0443\u044e \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u0443 \u0433\u0430\u0440\u0430\u0447\u044b\u0445 \u0432\u0443\u0433\u043b\u0451\u045e \u0437 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0456 \u043f\u043e\u045e\u043d\u044b\u044f \u043f\u0440\u044b\u0433\u0430\u0440\u0448\u0447\u044b \u0441\u0432\u0430\u0435 \u0442\u0430\u045e\u0447\u043e\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0433\u0430 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0456 \u0437\u0430\u043d\u044f\u0441\u0435 \u045e\u043d\u0443\u0442\u0440, \u0437\u0430 \u0437\u0430\u0441\u043b\u043e\u043d\u0443. \u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441\u044b\u043f\u0435 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u043d\u0430 \u0430\u0433\u043e\u043d\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 &ndash; \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0430\u0434 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u043f\u0430\u043a\u0440\u044b\u0435 \u0432\u0435\u043a\u0430, \u0448\u0442\u043e \u043d\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c c\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u044f\u043c\u0443. \u041d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u043e\u045e \u0446\u044f\u043b\u044c\u0446\u0430 \u0456 \u043f\u0430\u043a\u0440\u0430\u043f\u0456\u0446\u044c \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0434 \u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043c \u0431\u043e\u043a\u0430\u043c \u0432\u0435\u043a\u0430 \u0437 \u0443\u0441\u0445\u043e\u0434\u0443, \u0456 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e \u043f\u0430\u043a\u0440\u0430\u043f\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0435\u043a\u0430\u043c \u043f\u0430\u043b\u044c\u0446\u0430\u043c, \u043f\u0430\u043c\u0430\u0447\u044b\u045e\u0448\u044b \u044f\u0433\u043e \u045e \u043a\u0440\u044b\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0440\u044d\u0436\u0430 \u043a\u0430\u0437\u043b\u0430 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u044f\u0433\u043e \u043a\u0440\u043e\u045e \u0443\u043d\u0443\u0442\u0440, \u0437\u0430 \u0437\u0430\u0441\u043b\u043e\u043d\u0443. \u041d\u044f\u0445\u0430\u0439 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0437 \u044f\u0433\u043e \u043a\u0440\u044b\u0432\u0451\u0439, \u044f\u043a \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u043a\u0440\u044b\u0432\u0451\u044e \u0446\u044f\u043b\u044c\u0446\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u0440\u0430\u043f\u0456\u0446\u044c \u0451\u044e \u043d\u0430\u0434 \u0432\u0435\u043a\u0430\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0432\u0435\u043a\u0430\u043c. \u041d\u044f\u0445\u0430\u0439 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0430\u0431\u0440\u0430\u0434 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e \u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u0456\u0445\u043d\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0456 \u0437 \u0448\u0430\u0442\u0440\u043e\u043c \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456\u0445\u043d\u044f\u0439. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0410\u0430\u0440\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0430\u0436 \u043f\u0430\u043a\u0443\u043b\u044c \u0451\u043d \u043d\u0435 \u0432\u044b\u0439\u0434\u0437\u0435 \u0456 \u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u0441\u044f\u0431\u0435, \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0441\u0432\u043e\u0439 \u0456 \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0445\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041d\u044f\u0445\u0430\u0439 \u0432\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0430\u043b\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0434 \u0456\u043c, \u0456 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u043e\u045e \u0442\u0430\u0433\u043e \u0446\u044f\u043b\u044c\u0446\u0430 \u0456 \u0442\u0430\u0433\u043e \u043a\u0430\u0437\u043b\u0430, \u0456 \u043f\u0430\u043c\u0430\u0436\u0430 \u0451\u044e \u045e\u0441\u0435 \u0440\u0430\u0433\u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u0430\u043a\u0440\u0430\u043f\u0456\u0446\u044c \u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e, \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u044f\u0433\u043e, \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u0430\u0431\u0440\u0430\u0434 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0434 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439, \u0448\u0430\u0442\u0440\u043e\u043c \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0436\u044b\u0432\u043e\u0433\u0430 \u043a\u0430\u0437\u043b\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435 \u0410\u0430\u0440\u043e\u043d \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0436\u044b\u0432\u043e\u0433\u0430 \u043a\u0430\u0437\u043b\u0430 \u0456 \u0432\u044b\u0437\u043d\u0430\u0435 \u043d\u0430\u0434 \u0456\u043c \u0443\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u045e\u0441\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0456\u0445\u043d\u0456\u0445, \u0456 \u045e\u0441\u043a\u043b\u0430\u0434\u0437\u0435 \u0456\u0445 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u043a\u0430\u0437\u043b\u0430, \u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u044b\u0433\u0430\u043d\u0456\u0446\u044c \u044f\u0433\u043e \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e. \u0406 \u0433\u044d\u0442\u044b \u043a\u0430\u0437\u0451\u043b \u043f\u0430\u043d\u044f\u0441\u0435 \u043d\u0430 \u0441\u0430\u0431\u0435 \u045e\u0441\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0456\u0445 \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u041d\u044f\u0445\u0430\u0439 \u0432\u044b\u0433\u0430\u043d\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0430\u0437\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u043d\u044f\u0445\u0430\u0439 \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u0410\u0430\u0440\u043e\u043d \u0443 \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u0456 \u0437\u0434\u044b\u043c\u0435 \u0437 \u0441\u044f\u0431\u0435 \u043b\u044c\u043d\u044f\u043d\u044b\u044f \u0448\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0434\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0441\u0432\u044f\u0442\u043e\u0435 \u043c\u0435\u0441\u0446\u0430, \u0456 \u043f\u0430\u043a\u0456\u043d\u0435 \u0456\u0445 \u0442\u0430\u043c. \u041d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u044b\u0435 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0432\u0430\u0434\u043e\u044e \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0456 \u0430\u043f\u0440\u0430\u043d\u0435 \u0441\u0432\u0430\u0435 \u0448\u0430\u0442\u044b, \u0456 \u0432\u044b\u0439\u0434\u0437\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0441\u0432\u0430\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0437\u0430 \u043d\u0430\u0440\u043e\u0434. \u041b\u043e\u0439 \u0437 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0430\u043b\u0456\u0446\u044c \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0443. \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0433\u0430\u043d\u044f\u045e \u043a\u0430\u0437\u043b\u0430 \u0434\u043b\u044f \u0410\u0437\u0430\u0437\u044d\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u043c\u044b\u0435 \u0441\u0432\u0430\u0435 \u0448\u0430\u0442\u044b \u0456 \u0430\u0431\u043c\u044b\u0435 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u045e \u0432\u0430\u0434\u0437\u0435, \u0430 \u043f\u043e\u0442\u044b\u043c \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u043b\u0430\u0433\u0435\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0433\u0430\u0434\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u043d\u0435\u0441\u0446\u0456 \u0437\u0430 \u043b\u0430\u0433\u0435\u0440 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0433\u0430 \u0446\u044f\u043b\u044c\u0446\u0430 \u0437\u0430 \u0433\u0440\u044d\u0445 \u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0433\u0430 \u043a\u0430\u0437\u043b\u0430 \u0437\u0430 \u0433\u0440\u044d\u0445, \u0447\u044b\u044f \u043a\u0440\u043e\u045e \u0431\u044b\u043b\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u043b\u044f \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0456 \u0441\u043f\u0430\u043b\u0456\u0446\u044c \u043d\u0430 \u0430\u0433\u043d\u0456 \u0456\u0445 \u0448\u043a\u0443\u0440\u044b, \u043c\u044f\u0441\u0430 \u0456\u0445 \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456\u0445\u043d\u0456\u044f. \u0422\u043e\u0439, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0446\u044c \u0456\u0445, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u043c\u044b\u0435 \u0441\u0432\u0430\u0435 \u0448\u0430\u0442\u044b \u0456 \u0430\u0431\u043c\u044b\u0435 \u0432\u0430\u0434\u043e\u044e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u0430 \u043f\u043e\u0442\u044b\u043c \u043d\u044f\u0445\u0430\u0439 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u043b\u0430\u0433\u0435\u0440&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 9, 11. 12. 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u044f\u043a \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043d\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u043a\u0430\u0437\u043b\u043e\u045e \u0456 \u0446\u044f\u043b\u044c\u0446\u043e\u045e, \u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b <span style=\"color: #ff0000;\">*<\/span> \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0437\u0434\u0430\u0431\u044b\u045e\u0448\u044b \u0432\u0435\u0447\u043d\u0430\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u043d\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0443\u044e \u0440\u0443\u043a\u0430\u043c\u0456, \u0430\u043b\u0435 \u045e \u0441\u0430\u043c\u043e \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0437\u0434\u0430\u0431\u044b\u045e\u0448\u044b \u0432\u0435\u0447\u043d\u0430\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"543","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0435\u0432\u0456\u0442\u0430 <span style=\"color: #ff0000;\">19, 1-18. 31-37<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0445\u043e\u0434\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0441\u043a\u0430\u0436\u044b \u0456\u043c: \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u044f\u043a \u0441\u0432\u044f\u0442\u044b \u042f, \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u0448\u0430\u043d\u0443\u0435 \u0441\u0432\u0430\u044e \u043c\u0430\u0446\u0456 \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0443. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u041c\u0430\u0435 \u0448\u0430\u0431\u0430\u0442\u044b. \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0456\u0434\u0430\u043b\u0430\u045e \u0456 \u0431\u0430\u0433\u043e\u045e, \u0430\u0434\u043b\u0456\u0442\u044b\u0445 \u0437 \u043c\u0435\u0442\u0430\u043b\u0443, \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0441\u0430\u0431\u0435. \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u041f\u0430\u043d\u0443 \u043c\u0456\u0440\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443, \u043f\u0440\u044b\u043d\u043e\u0441\u044c\u0446\u0435 \u044f\u0435 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0441\u0430\u0431\u0435 \u042f\u0433\u043e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c. \u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u044f\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u0432\u0430\u0448\u0430\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f \u0456 \u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u043b\u0435\u043d\u0430 \u045e \u0430\u0433\u043d\u0456. \u041a\u0430\u043b\u0456 \u0431 \u044f\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c, \u0433\u044d\u0442\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u044f \u0435\u0436\u0430, \u044f\u043a\u0430\u044f \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456. \u0406 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u0435\u0441\u0446\u044c, \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0432\u0456\u043d\u0443, \u0431\u043e \u0433\u044d\u0442\u044b\u043c \u0430\u0431\u0440\u0430\u0437\u0456\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430. \u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u043d\u044b \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u043d\u0456\u0432\u0430, \u0436\u043d\u0456\u0432\u0430 \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u043d\u0435 \u0436\u043di \u0437\u0431\u043e\u0436\u0436\u0430 \u043d\u0430 \u045e\u0441\u043a\u0440\u0430\u0439\u043a\u0443 \u043f\u043e\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0435 \u0437\u0431\u0456\u0440\u0430\u0439 \u043a\u0430\u043b\u0430\u0441\u044b, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u043f\u043e\u043b\u0456. \u041d\u0435 \u0430\u0431\u0456\u0440\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0441\u0432\u043e\u0439 \u0434\u0430\u0447\u044b\u0441\u0442\u0430 \u0456 \u043d\u0435 \u0437\u0431\u0456\u0440\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u043f\u0430\u043b\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u041f\u0430\u043a\u0456\u043d\u044c \u0433\u044d\u0442\u0430 \u0431\u0435\u0434\u043d\u0430\u043c\u0443 \u0456 \u043f\u0440\u044b\u0445\u0430\u0434\u043d\u044e. \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043a\u0440\u0430\u0434\u0437\u0456\u0446\u0435, \u043d\u0435 \u0445\u043b\u0443\u0441\u0456\u0446\u0435 \u0456 \u043d\u0435 \u0430\u0448\u0443\u043a\u0432\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043a\u043b\u044f\u043d\u0456\u0446\u0435\u0441\u044f \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430 \u0456\u043c\u0435\u043c \u041c\u0430\u0456\u043c, \u043a\u0430\u0431 \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u0446\u044c \u0456\u043c\u044f \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430. \u042f &ndash; \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0439 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0435 \u0440\u0430\u0431\u0443\u0439. \u041d\u044f\u0445\u0430\u0439 \u043f\u043b\u0430\u0442\u0430 \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435 \u0430\u0436 \u0434\u0430 \u0440\u0430\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u0430\u043a\u043b\u0456\u043d\u0430\u0439 \u0433\u043b\u0443\u0445\u043e\u0433\u0430 \u0456 \u043d\u0435 \u043a\u043b\u0430\u0434\u0437\u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b \u043f\u0435\u0440\u0430\u0434 \u0441\u043b\u044f\u043f\u044b\u043c, \u0430\u043b\u0435 \u0431\u043e\u0439\u0441\u044f \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u042f &ndash; \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0447\u044b\u043d\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0430 \u0441\u0443\u0434\u0437\u0435. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0434\u0443\u0437\u044f\u0442\u044b\u043c \u0434\u0430 \u0431\u0435\u0434\u043d\u0430\u0433\u0430 \u0456 \u0437\u0430\u043c\u043e\u0436\u043d\u0430\u0433\u0430. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u0443\u0434\u0437\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u041d\u0435 \u0445\u0430\u0434\u0437\u0456 \u044f\u043a \u043f\u043b\u044f\u0442\u043a\u0430\u0440 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0442\u0432\u0430\u0439\u0433\u043e. \u041d\u0435 \u043f\u0430\u045e\u0441\u0442\u0430\u0432\u0430\u0439 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0440\u044b\u0432\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u042f &ndash; \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043c\u0430\u0439 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446i \u0434\u0430 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c. \u041d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439 \u044f\u0433\u043e, \u043a\u0430\u0431 \u043d\u0435 \u043c\u0435\u0446\u044c \u0433\u0440\u0430\u0445\u0443 \u0437-\u0437\u0430 \u044f\u0433\u043e. \u041d\u0435 \u0448\u0443\u043a\u0430\u0439 \u043f\u043e\u043c\u0441\u0442\u044b \u0456 \u043d\u0435 \u0437\u043b\u0443\u0439\u0441\u044f \u043d\u0430 \u0441\u044b\u043d\u043e\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u0433\u043e. \u041b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u042f &ndash; \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0434\u0443\u0445\u0430\u045e \u0456 \u0434\u0430 \u0432\u0430\u0440\u0430\u0436\u0431\u0456\u0442\u043e\u045e. \u041d\u0435 \u0432\u044b\u043f\u044b\u0442\u0432\u0430\u0439\u0446\u0435 \u0456\u0445, \u0431\u043e \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u0430\u0437 \u0456\u0445. \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0441\u0456\u0432\u043e\u0433\u0430 \u045e\u0441\u0442\u0430\u0432\u0430\u0439 \u0456 \u0448\u0430\u043d\u0443\u0439 \u0441\u0442\u0430\u0440\u043e\u0433\u0430. \u0411\u043e\u0439\u0441\u044f \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u042f &ndash; \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u043f\u043e\u0431\u0430\u0447 \u0437 \u0442\u0430\u0431\u043e\u044e \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0435\u0446 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0442\u0432\u0430\u0451\u0439, \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0439 \u044f\u0433\u043e. \u042f\u043a \u0442\u0443\u0442\u044d\u0439\u0448\u044b \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0435\u0446, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0437 \u0432\u0430\u043c\u0456. \u041b\u044e\u0431\u0456 \u044f\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0431\u043e \u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439. \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448.\u041d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u043a\u0440\u044b\u045e\u0434\u044b \u045e \u0441\u0443\u0434\u0437\u0435, \u0443 \u043c\u0435\u0440\u044b, \u0443 \u0432\u0430\u0437\u0435 \u0456 \u045e \u0430\u0431&rsquo;\u0451\u043c\u0435. \u0412\u0430\u0433\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u045e \u0432\u0430\u0441, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0433\u0456\u0440\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u044d\u0444\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0433\u0456\u043d \u0432\u0430\u0448. \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0432\u0430\u0448, \u044f\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u0437 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u041c\u0430\u0435 \u0437\u0430\u043a\u043e\u043d\u044b \u0456 \u045e\u0441\u0435 \u043c\u0430\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b. \u042f &ndash; \u041f\u0430\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 5, 14. 13b; \u042f\u043d 13, 34<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0430\u0434\u043d\u044b\u043c \u043d\u0430\u043a\u0430\u0437\u0435: \u043b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435.<span style=\"color: #ff0000;\"> *<\/span> \u0423 \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"544","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0456\u0447\u0431\u0430\u045e <span style=\"color: #ff0000;\">11, 4-6. 10-30 <\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u043d\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0456 \u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0417\u0431\u043e\u0440\u044b\u0448\u0447\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443, \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c. \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u044f\u0434\u0437\u0435\u043b\u0456 \u0456 \u043f\u043b\u0430\u043a\u0430\u043b\u0456 \u0437 \u0456\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0442\u043e \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u043c\u044f\u0441\u0430 \u043f\u0430\u0434&rsquo;\u0435\u0441\u0446\u0456? \u041c\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u043c \u0440\u044b\u0431\u0443, \u0448\u0442\u043e \u0435\u043b\u0456 \u045e \u0415\u0433\u0456\u043f\u0446\u0435 \u0437\u0430\u0434\u0430\u0440\u043c\u0430, \u0430\u0433\u0443\u0440\u043a\u0456 \u0456 \u0434\u044b\u043d\u0456, \u043f\u0435\u0440&rsquo;\u0435 \u0456 \u0433\u0430\u043b\u043e\u045e\u043a\u0456 \u0446\u044b\u0431\u0443\u043b\u0456, \u0456 \u0447\u0430\u0441\u043d\u043e\u043a. \u0410 \u0446\u044f\u043f\u0435\u0440 \u0441\u0430\u0441\u043c\u0430\u0433\u043b\u0430 \u0434\u0443\u0448\u0430 \u043d\u0430\u0448\u0430, \u0456 \u0432\u043e\u0447\u044b \u043d\u0430\u0448\u044b \u043d\u0435 \u0431\u0430\u0447\u0430\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043f\u0440\u043e\u0447 \u043c\u0430\u043d\u043d\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0447\u0443\u045e \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a \u043d\u0430\u0440\u0430\u043a\u0430\u0435 \u043d\u0430\u0440\u043e\u0434 \u0443 \u0441\u0435\u043c&rsquo;\u044f\u0445 \u0441\u0432\u0430\u0456\u0445, \u043a\u043e\u0436\u043d\u044b \u043a\u0430\u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u043c\u0451\u0442. \u0406 \u043c\u043e\u0446\u043d\u0430 \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0433\u043d\u0435\u045e \u041f\u0430\u043d\u0430, \u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e\u0441\u044f, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0443: &laquo;\u0427\u0430\u043c\u0443 \u0422\u044b \u043a\u0435\u043f\u0441\u043a\u0430 \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u043e\u044e? \u0427\u0430\u043c\u0443 \u044f \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u045e \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445? \u0427\u0430\u043c\u0443 \u0422\u044b \u045e\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u0446\u044f\u0436\u0430\u0440 \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u0433\u0430? \u0425\u0456\u0431\u0430 \u044f \u0437\u0430\u0447\u0430\u045e \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u044f\u0433\u043e, \u0448\u0442\u043e \u0422\u044b \u043a\u0430\u0436\u0430\u0448 \u043c\u043d\u0435, \u043a\u0430\u0431 \u044f, \u044f\u043a \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044c\u043a\u0430 \u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f, \u043d\u0451\u0441 \u044f\u0433\u043e \u043d\u0430 \u0440\u0443\u043a\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0443 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0422\u044b \u0430\u0431\u044f\u0446\u0430\u045e \u044f\u0433\u043e \u043f\u0440\u043e\u0434\u043a\u0430\u043c? \u0410\u0434\u043a\u0443\u043b\u044c \u0443 \u043c\u044f\u043d\u0435 \u043c\u044f\u0441\u0430, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0443\u0441\u044f\u043c\u0443 \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443? \u042f\u043d\u044b \u043f\u043b\u0430\u0447\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0414\u0430\u0439 \u043d\u0430\u043c \u043c\u044f\u0441\u0430 \u043f\u0430\u0434&rsquo;\u0435\u0441\u0446\u0456&rdquo;. \u042f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0430\u0434\u0437\u0456\u043d \u043d\u0435\u0441\u0446\u0456 \u045e\u0432\u0435\u0441\u044c \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434, \u0431\u043e \u0451\u043d \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0446\u044f\u0436\u043a\u0456 \u0434\u043b\u044f \u043c\u044f\u043d\u0435. \u041a\u0430\u043b\u0456 \u0422\u044b \u0440\u043e\u0431\u0456\u0448 \u0433\u044d\u0442\u0430\u043a \u0441\u0430 \u043c\u043d\u043e\u044e, \u0442\u043e \u043b\u0435\u043f\u0448 \u0437\u0430\u0431\u0456 \u043c\u044f\u043d\u0435; \u0437\u0430\u0431\u0456 \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u043c\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u044f\u0434\u043e\u043b\u0456 \u0441\u0432\u0430\u0451\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0417\u0431\u044f\u0440\u044b \u041c\u043d\u0435 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u043c\u0443\u0436\u043e\u045e \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0440\u0430 \u044f\u043a\u0456\u0445 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u044f\u043d\u044b \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0456\u0445 \u0434\u0430 \u0448\u0430\u0442\u0440\u0430 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0442\u0430\u043c \u0437 \u0442\u0430\u0431\u043e\u044e. \u042f \u0441\u044b\u0434\u0443 \u0456 \u0431\u0443\u0434\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e \u0442\u0430\u043c. \u0412\u0430\u0437\u044c\u043c\u0443 \u0447\u0430\u0441\u0442\u043a\u0443 \u0437 \u0434\u0443\u0445\u0443 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u043c \u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435\u0441\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u0430\u0431\u043e\u044e \u0446\u044f\u0436\u0430\u0440 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0442\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043d\u0430\u0441\u0456\u045e \u044f\u0433\u043e \u0430\u0434\u0437\u0456\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u043a\u0430\u0436\u0430\u0448: \u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435\u0441\u044f \u043d\u0430 \u0437\u0430\u045e\u0442\u0440\u0430, \u0431\u043e \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u043c\u044f\u0441\u0430. \u042f \u043f\u0430\u0447\u0443\u045e, \u044f\u043a \u0432\u044b \u043f\u043b\u0430\u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0425\u0442\u043e \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u043f\u0430\u0435\u0441\u0446\u0456 \u043c\u044f\u0441\u0430? \u0414\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0431\u044b\u043b\u043e \u045e \u0415\u0433\u0456\u043f\u0446\u0435&rdquo;. \u0426\u044f\u043f\u0435\u0440 \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u043c\u044f\u0441\u0430, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u0446\u0456 \u0434\u0432\u0430, \u043d\u0456 \u043f\u044f\u0446\u044c \u0446\u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c, \u0430\u0431\u043e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c, \u0430 \u0446\u044d\u043b\u044b \u043c\u0435\u0441\u044f\u0446, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u043b\u0435\u0437\u0435 \u043d\u0430\u0437\u0430\u0434 \u043f\u0440\u0430\u0437 \u043d\u043e\u0437\u0434\u0440\u044b \u0456 \u0432\u0430\u043c \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u043c\u043e\u0442\u0430\u0448\u043d\u0430 \u0430\u0434 \u044f\u0433\u043e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0456 \u043f\u043b\u0430\u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043c\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430?&rdquo;&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u0413\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u043d\u0430\u043b\u0456\u0447\u0432\u0430\u0435 \u0448\u044d\u0441\u0446\u044c\u0441\u043e\u0442 \u0442\u044b\u0441\u044f\u0447 \u043f\u0435\u0448\u044b\u0445, \u0430 \u0442\u044b \u043a\u0430\u0436\u0430\u0448: &ldquo;\u0414\u0430\u043c \u0456\u043c \u0435\u0441\u0446\u0456 \u043c\u044f\u0441\u0430 \u0446\u044d\u043b\u044b \u043c\u0435\u0441\u044f\u0446&rdquo;. \u041a\u0430\u043b\u0456 \u0437\u0430\u0440\u044d\u0437\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u0431\u044b\u043a\u043e\u045e, \u0446\u0456 \u0445\u0430\u043f\u0456\u043b\u0430 \u0431 \u0434\u043b\u044f \u0456\u0445 \u0435\u0436\u044b? \u041a\u0430\u043b\u0456 \u0431 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0443\u0441\u044e \u0440\u044b\u0431\u0443 \u0437 \u043c\u043e\u0440\u0430 \u045e \u0430\u0434\u043d\u043e, \u0446\u0456 \u0436 \u0431\u044b\u043b\u043e \u0431 \u0456\u043c \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430?&raquo; \u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0425\u0456\u0431\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u044f \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430? \u041d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u045e\u0431\u0430\u0447\u044b\u0448, \u0446\u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u041c\u0430\u0451 \u0441\u043b\u043e\u0432\u0430, \u0446\u0456 \u043d\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u044b\u0439\u0448\u0430\u045e \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430, \u0456 \u0441\u0430\u0431\u0440\u0430\u045e \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u043c\u0443\u0436\u043e\u045e \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0456\u0445 \u043a\u0430\u043b\u044f \u0448\u0430\u0442\u0440\u0430. \u0421\u044b\u0448\u043e\u045e \u041f\u0430\u043d \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u0456 \u045e\u0437\u044f\u045e \u0430\u0434 \u0434\u0443\u0445\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u043d\u0430 \u0456\u043c, \u0456 \u0434\u0430\u045e \u0441\u044f\u043c\u0456\u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c. \u041a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0456\u0445 \u0434\u0443\u0445, \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u043f\u043e\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0432\u043e\u0435 \u0436 \u043c\u0443\u0436\u0447\u044b\u043d \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u045e \u043b\u0430\u0433\u0435\u0440\u044b. \u0406\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u042d\u043b\u0434\u0430\u0434, \u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u041c\u044d\u0434\u0430\u0434. \u0406 \u043d\u0430 \u0456\u0445 \u0441\u044b\u0448\u043e\u045e \u0434\u0443\u0445, \u0431\u043e \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f, \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0448\u0430\u0446\u0451\u0440, \u0430 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043b\u0456 \u045e \u043b\u0430\u0433\u0435\u0440\u044b. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0431\u0435\u0433 \u044e\u043d\u0430\u043a, \u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u045e \u041c\u0430\u0439\u0441\u0435\u044e: \u042d\u043b\u0434\u0430\u0434 \u0456 \u041c\u044d\u0434\u0430\u0434 \u043f\u0440\u0430\u0440\u043e\u0447\u0430\u0446\u044c \u0443 \u043b\u0430\u0433\u0435\u0440\u044b. \u0423 \u0430\u0434\u043a\u0430\u0437 \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u0441\u043b\u0443\u0433\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0430\u0434 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u0430\u0439\u0441\u0435\u0439, \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043c\u043e\u0439, \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456 \u0456\u043c&raquo;. \u0410\u043b\u0435 \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u0456 \u043d\u0435 \u0440\u0430\u045e\u043d\u0443\u0435\u0448 \u0442\u044b \u0437-\u0437\u0430 \u043c\u044f\u043d\u0435? \u041e, \u043a\u0430\u0431 \u0443\u0441\u0435 \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u041f\u0430\u043d\u0430 \u0431\u044b\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u041f\u0430\u043d \u0434\u0430\u045e \u0456\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0430&raquo;. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u043b\u0430\u0433\u0435\u0440.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u044d\u043b 3, 1b\u0441. 2b; \u0414\u0437 1, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u043b\u044c\u044e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u045e\u0441\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u0441\u044b\u043d\u044b \u0432\u0430\u0448\u044b \u0456 \u0434\u043e\u0447\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u043b\u044c\u044e \u043d\u0430 \u0432\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043c\u0435\u0446\u0435 \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430 \u0432\u0430\u0441 \u0441\u044b\u0434\u0437\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0430\u0436\u043d\u043e \u0434\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u043b\u044c\u044e \u043d\u0430 \u0432\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"545","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0456\u0447\u0431\u0430\u045e <span style=\"color: #ff0000;\">12, 16 13, 1-3\u0430. 17-33<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u044b\u043f\u0440\u0430\u0432\u0430 \u0432\u044b\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0443 \u041a\u0430\u043d\u0430\u0430\u043d<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041d\u0430\u0440\u043e\u0434 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0425\u0430\u0446\u044d\u0440\u043e\u0442 \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u043b\u0430\u0433\u0435\u0440 \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0424\u0430\u0440\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u0448\u043b\u0456 \u043c\u0443\u0436\u043e\u045e \u0440\u0430\u0437\u0432\u0435\u0434\u0430\u0446\u044c \u043a\u0430\u043d\u0430\u0430\u043d\u0441\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u043c \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041f\u0430\u0448\u043b\u0456 \u043c\u0443\u0436\u043e\u045e \u0430\u0434\u043d\u0430\u0433\u043e \u0437\u0430 \u0430\u0434\u043d\u044b\u043c \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0430\u0439\u0446\u043e\u045e \u0456\u0445\u043d\u0456\u0445, \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0456\u0445\u043d\u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0456\u0445 \u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0424\u0430\u0440\u0430\u043d \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u043a\u0430\u0437\u0443 \u0432\u0443\u0441\u043d\u0430\u045e \u041f\u0430\u043d\u0430, \u0430 \u0431\u044b\u043b\u0456 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u043c\u0443\u0436\u044b \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430\u043c\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0440\u0430\u0437\u0432\u0435\u0434\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u041a\u0430\u043d\u0430\u0430\u043d \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c \u043d\u0430 \u041d\u044d\u0433\u0435\u0431 \u0456 \u043f\u0430\u0434\u044b\u043c\u0456\u0446\u0435\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u044f\u043d\u0430, \u0456 \u043d\u0430 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u044f\u0435 \u043d\u0430\u0441\u044f\u043b\u044f\u0435, &ndash; \u043c\u043e\u0446\u043d\u044b \u0451\u043d \u0446\u0456 \u0441\u043b\u0430\u0431\u044b, \u043c\u0430\u043b\u044b \u0446\u0456 \u0432\u044f\u043b\u0456\u043a\u0456? \u0406 \u044f\u043a\u0430\u044f \u0437\u044f\u043c\u043b\u044f, \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0430\u044f \u0456\u043c, &ndash; \u0434\u043e\u0431\u0440\u0430\u044f \u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u044f, \u0456 \u045e \u044f\u043a\u0456\u0445 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430\u0445 \u0451\u043d \u0436\u044b\u0432\u0435, &ndash; \u0443 \u043b\u0430\u0433\u0435\u0440\u0430\u0445 \u0446\u0456 \u0432\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445? \u0406 \u0446\u0456 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0433\u044d\u0442\u0430\u044f \u0430\u0431\u043e \u043d\u0435, \u0451\u0441\u0446\u044c \u043d\u0430 \u0451\u0439 \u0434\u0440\u044d\u0432\u044b \u0446\u0456 \u043d\u0435? \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u044f \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0456\u0446\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u043f\u043b\u0430\u0434\u043e\u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456&raquo;. \u0410 \u0431\u044b\u043b\u0456 \u0442\u0430\u0434\u044b \u0434\u043d\u0456 \u043f\u0430\u0441\u043f\u044f\u0432\u0430\u043d\u043d\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u0440\u0430\u0437\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u0430\u0434 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0421\u0456\u043d \u0430\u0436 \u0434\u0430 \u0420\u044d\u0445\u043e\u0431\u0430, \u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0425\u0430\u043c\u0430\u0442. \u0406\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u041d\u044d\u0433\u0435\u0431 \u0456 \u043f\u0440\u044b\u0431\u044b\u043b\u0456 \u0430\u0436 \u0443 \u0413\u0435\u0431\u0440\u043e\u043d, \u0430 \u0431\u044b\u043b\u0456 \u0442\u0430\u043c \u0410\u0445\u0456\u043c\u0430\u043d, \u0428\u044d\u0448\u0430\u0439 \u0456 \u0422\u0430\u043b\u043c\u0430\u0439, \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u0410\u043d\u0430\u043a\u0430. \u0413\u0435\u0431\u0440\u043e\u043d \u0436\u0430 \u0431\u044b\u045e \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0448\u044d\u0441\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u0440\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0426\u0430\u0430\u043d \u0443 \u0415\u0433\u0456\u043f\u0446\u0435. \u042f\u043d\u044b \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0434\u0430\u043b\u0456\u043d\u0443 \u042d\u0448\u043a\u043e\u043b \u0456 \u0430\u0434\u0440\u044d\u0437\u0430\u043b\u0456 \u0442\u0430\u043c \u0433\u0430\u043b\u0456\u043d\u0443 \u0437 \u0433\u0440\u043e\u043d\u043a\u0430\u043c\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443, \u0456 \u043d\u0435\u0441\u043b\u0456 \u044f\u0435 \u045e\u0434\u0432\u0430\u0456\u0445 \u043d\u0430 \u0436\u0430\u0440\u0434\u0437\u0456\u043d\u0430\u0445. \u0423\u0437\u044f\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0440\u044b\u0445\u0443 \u0433\u0440\u0430\u043d\u0430\u0442\u0430\u045e \u0456 \u0444\u0456\u0433. \u0410 \u043c\u0435\u0441\u0446\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0437\u0432\u0430\u043b\u0456 \u0434\u0430\u043b\u0456\u043d\u0430\u044e \u042d\u0448\u043a\u043e\u043b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u0430\u043b\u0456\u043d\u044b \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443, \u044f\u043a\u0443\u044e \u0442\u0430\u043c \u0430\u0434\u0440\u044d\u0437\u0430\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u044f\u043d\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f, \u0440\u0430\u0437\u0432\u0435\u0434\u0430\u045e\u0448\u044b \u0437\u044f\u043c\u043b\u044e. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430, \u0456 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0445\u043e\u0434\u0443 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0424\u0430\u0440\u0430\u043d, \u0448\u0442\u043e \u045e \u041a\u0430\u0434\u044d\u0448. \u042f\u043d\u044b \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0456\u043c \u0456 \u045e\u0441\u044f\u043c\u0443 \u0441\u0445\u043e\u0434\u0443, \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u043b\u0430\u0434\u044b \u0437\u044f\u043c\u043b\u0456. \u0410 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0437\u044f\u043c\u043b\u044e, \u0443 \u044f\u043a\u0443\u044e \u0442\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430\u0441. \u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c, \u0430 \u0433\u044d\u0442\u0430 &ndash; \u043f\u043b\u0430\u0434\u044b \u044f\u0435. \u0410\u0434\u043d\u0430\u043a \u043b\u044e\u0434\u0437\u0456, \u0448\u0442\u043e \u043d\u0430\u0441\u044f\u043b\u044f\u044e\u0446\u044c \u044f\u0435, \u043c\u043e\u0446\u043d\u044b\u044f, \u0430 \u0433\u0430\u0440\u0430\u0434\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f. \u041c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0442\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0410\u043d\u0430\u043a\u0430. \u0410\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0437\u044f\u043c\u043b\u0456 \u041d\u044d\u0433\u0435\u0431, \u0445\u0435\u0442\u044b, \u0435\u0431\u0443\u0441\u0435\u0456 \u0456 \u0430\u043c\u0430\u0440\u044d\u0456 \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u045e\u0437\u0433\u043e\u0440&rsquo;\u044f\u0445, \u0430 \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u043a\u0430\u043b\u044f \u043c\u043e\u0440\u0430 \u0456 \u045e\u0437\u0434\u043e\u045e\u0436 \u042f\u0440\u0434\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0456\u0436 \u0442\u044b\u043c \u041a\u0430\u043b\u0435\u0431 \u0441\u0443\u0446\u0456\u0448\u044b\u045e \u043d\u0430\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u043e\u0439\u0434\u0437\u0435\u043c \u0456 \u0437\u043e\u0439\u043c\u0435\u043c \u0437\u044f\u043c\u043b\u044e, \u0431\u043e \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u0451\u044e&raquo;. \u0410\u043b\u0435 \u0456\u043d\u0448\u044b\u044f \u043c\u0443\u0436\u044b, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u0456\u043c, \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043f\u0430\u045e\u0441\u0442\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u043e \u044f\u043d\u044b \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u044f \u0437\u0430 \u043d\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0434\u0440\u044d\u043d\u043d\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0440\u0430\u0437\u0432\u0435\u0434\u0430\u043b\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417\u044f\u043c\u043b\u044f, \u043f\u0430 \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0440\u0430\u0439\u0448\u043b\u0456, \u0430\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u044b \u044f\u0435, \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0441\u0432\u0430\u0456\u0445, \u0430 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u0445 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0432\u044b\u0441\u043e\u043a\u0456\u044f \u0440\u043e\u0441\u0442\u0430\u043c. \u041c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0442\u0430\u043c \u0432\u0435\u043b\u0456\u043a\u0430\u043d\u0430\u045e &ndash; \u0441\u044b\u043d\u043e\u045e \u0410\u043d\u0430\u043a\u0430, \u044f\u043a\u0456\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437 \u0440\u043e\u0434\u0443 \u0432\u0435\u043b\u0456\u043a\u0430\u043d\u0430\u045e. \u0423 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0456\u043c\u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u044f\u043a \u0441\u0430\u0440\u0430\u043d\u0447\u0430 \u0456 \u0442\u0430\u043a\u0456\u043c\u0456 \u0456\u043c \u0437\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 1, 31\u0430. 32. 26. 27\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u043d\u0451\u0441 \u0446\u044f\u0431\u0435, \u044f\u043a \u0431\u0430\u0446\u044c\u043a\u0430 \u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0410\u043b\u0435 \u0432\u044b \u043d\u0435 \u0432\u0435\u0440\u044b\u043b\u0456 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u0430\u043c\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u043d\u0435 \u0445\u0430\u0446\u0435\u043b\u0456 \u0456\u0441\u0446\u0456 \u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456, \u043d\u0435 \u0432\u0435\u0440\u0430\u0447\u044b \u045e \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043b\u0435 \u0432\u044b \u043d\u0435 \u0432\u0435\u0440\u044b\u043b\u0456 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u0430\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"546","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0456\u0447\u0431\u0430\u045e <span style=\"color: #ff0000;\">14, 1-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u041c\u0430\u0439\u0441\u0435\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0423\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0437\u043d\u044f\u043b\u0430 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0456 \u043f\u043b\u0430\u043a\u0430\u045e \u043d\u0430\u0440\u043e\u0434 \u0443 \u0442\u0443\u044e \u0442\u043e\u0447. \u0406 \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456 \u043d\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430 \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u043a\u0430\u0437\u0430\u043b\u0430 \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c: &laquo;\u041b\u0435\u043f\u0448 \u0431\u044b \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0430\u0431\u043e \u045e \u0433\u044d\u0442\u0430\u0439 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u041f\u0430\u043d \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456 \u0433\u044d\u0442\u0430\u0439, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043b\u0435\u0433\u043b\u0456 \u0430\u0434 \u043c\u044f\u0447\u0430, \u0430 \u0436\u043e\u043d\u043a\u0456 \u043d\u0430\u0448\u044b \u0456 \u0434\u0437\u0435\u0446\u0456 \u0441\u0442\u0430\u043b\u0456 \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439. \u0426\u0456 \u043d\u0435 \u043b\u0435\u043f\u0448 \u043d\u0430\u043c \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0415\u0433\u0456\u043f\u0435\u0442?&raquo; \u0406 \u043a\u0430\u0437\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443: &laquo;\u0412\u044b\u0431\u0435\u0440\u0430\u043c \u0441\u0430\u0431\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e \u0456 \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u045e \u0415\u0433\u0456\u043f\u0435\u0442&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u045e\u043f\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d \u043d\u0456\u0446\u043c\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0441\u0445\u043e\u0434\u0430\u043c \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0410 \u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u0456 \u041a\u0430\u043b\u0435\u0431, \u0441\u044b\u043d \u0415\u0444\u0443\u043d\u0456, \u044f\u043a\u0456\u044f \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u0440\u0430\u0437\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043b\u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451. \u042f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u045e\u0441\u0451\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f: &laquo;\u0417\u044f\u043c\u043b\u044f, \u044f\u043a\u0443\u044e \u043c\u044b \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u0440\u0430\u0437\u0432\u0435\u0434\u0432\u0430\u0446\u044c, &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u044f \u0437\u044f\u043c\u043b\u044f. \u041a\u0430\u043b\u0456 \u043d\u0430\u043c \u0441\u043f\u0440\u044b\u044f\u0435 \u041f\u0430\u043d, \u0442\u043e \u0401\u043d \u0443\u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e \u0456 \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c. \u0422\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0431\u0443\u043d\u0442\u0443\u0439\u0446\u0435\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0442\u043e\u0439 \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043f\u0430\u0436\u044b\u0432\u0430\u0439, \u0456\u0445\u043d\u0456 \u0446\u0435\u043d\u044c \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f \u0430\u0434 \u0456\u0445, \u0430 \u0437 \u043d\u0430\u043c\u0456 \u041f\u0430\u043d. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043a\u0430\u0437\u0430\u043b\u0430, \u043a\u0430\u0431 \u0456\u0445 \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043b\u0456, \u0430\u043b\u0435 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0448\u0430\u0442\u0440\u044b \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u045e\u0441\u0456\u043c \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0414\u0430\u043a\u0443\u043b\u044c \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0431\u0443\u0434\u0437\u0435 \u041c\u044f\u043d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0446\u044c \u0456 \u0434\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0435\u0440\u044b\u0446\u044c \u041c\u043d\u0435 \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0437\u043d\u0430\u043a\u0456, \u0448\u0442\u043e \u042f \u045e\u0447\u044b\u043d\u0456\u045e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445? \u0423\u0434\u0430\u0440\u0443 \u044f\u0433\u043e \u043f\u0430\u043c\u043e\u0440\u043a\u0430\u043c \u0456 \u0437\u043d\u0456\u0448\u0447\u0443 \u044f\u0433\u043e, \u0430 \u0437 \u0446\u044f\u0431\u0435 \u0432\u044b\u0432\u0435\u0434\u0443 \u0431\u043e\u043b\u044c\u0448\u044b \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0435\u0439\u0448\u044b \u0437\u0430 \u0456\u0445 \u043d\u0430\u0440\u043e\u0434&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u041f\u0430\u043d\u0443: &laquo;\u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u043f\u0430\u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0441\u0432\u0430\u0451\u044e \u043c\u043e\u0446\u0430\u0439 \u0422\u044b \u0432\u044b\u0432\u0435\u045e \u0430\u0434 \u0456\u0445 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434, \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u044b \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0422\u044b, \u041f\u0430\u043d\u0435, \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u0433\u0430, \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448\u0441\u044f \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440; \u0448\u0442\u043e \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0422\u0432\u0430\u0451 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456 \u0456 \u045e \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435 \u0422\u044b \u0456\u0434\u0437\u0435\u0448 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u0430 \u045e \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435 &ndash; \u0443\u043d\u0430\u0447\u044b. \u041a\u0430\u043b\u0456 \u0422\u044b \u0437\u043d\u0456\u0448\u0447\u044b\u0448 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u043f\u0430\u0447\u0443\u045e\u0448\u044b \u043f\u0440\u0430 \u0433\u044d\u0442\u0430: &ldquo;\u041f\u0430\u043d \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u045e \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0442\u0430\u043c\u0443 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0456\u0445 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456&rdquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0448\u0443, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0422\u0432\u0430\u044f \u043c\u043e\u0446, \u041f\u0430\u043d\u0435, \u044f\u043a \u0430\u0431\u044f\u0446\u0430\u045e \u0422\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041f\u0430\u043d \u043d\u044f\u0441\u043a\u043e\u0440\u044b \u0434\u0430 \u0433\u043d\u0435\u0432\u0443 \u0456 \u0448\u043c\u0430\u0442\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b, \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0435 \u0433\u0440\u044d\u0445 \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0430\u0434 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0431\u0435\u0441\u043f\u0430\u043a\u0430\u0440\u0430\u043d\u0430, \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u043a\u0430\u0440\u0430\u0435 \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u0456 \u0434\u0430 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f&rdquo;. \u041f\u0440\u0430\u0448\u0443 \u0426\u044f\u0431\u0435, \u0430\u0434\u043f\u0443\u0441\u0446\u0456 \u0433\u0440\u044d\u0445 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u0433\u0430, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u044f, \u0431\u043e \u0422\u044b \u0446\u044f\u0440\u043f\u0435\u045e \u043d\u0430\u0440\u043e\u0434 \u0433\u044d\u0442\u044b \u0430\u0434 \u0415\u0433\u0456\u043f\u0442\u0430 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: &laquo;\u0410\u0434\u043f\u0443\u0441\u043a\u0430\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0442\u0432\u0430\u0451\u0439. \u042f \u0436\u044b\u0432\u044b, \u0456 \u0445\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u0423\u0441\u0435, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u045e \u041c\u0430\u044e \u0441\u043b\u0430\u0432\u0443 \u0456 \u041c\u0430\u0435 \u0446\u0443\u0434\u044b, \u0443\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u045e \u0415\u0433\u0456\u043f\u0446\u0435 \u0456 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0430\u043b\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0437\u043e\u045e \u0456 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0433\u043e\u043b\u0430\u0441\u0443 \u041c\u0430\u0439\u0433\u043e, \u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u042f \u0430\u0431\u044f\u0446\u0430\u045e \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u0456\u0445\u043d\u0456\u043c. \u0406 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u041c\u043d\u043e\u0439, \u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u044f\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u041c\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u041a\u0430\u043b\u0435\u0431\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u0431\u044b\u045e \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0456\u043d\u0448\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c \u041c\u043d\u0435, \u042f \u045e\u0432\u044f\u0434\u0443 \u045e \u0437\u044f\u043c\u043b\u044e, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0451\u043d \u0456\u0448\u043e\u045e, \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u044f\u0435. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u043c\u0430\u043b\u0435\u043a\u0456\u0442\u044b \u0456 \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0434\u0430\u043b\u0456\u043d\u0435, \u0437\u0430\u045e\u0442\u0440\u0430 \u043f\u0430\u0432\u0435\u0440\u043d\u0435\u0446\u0435\u0441\u044f \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u045e \u043d\u0430\u043f\u0440\u0430\u043c\u043a\u0443 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 103 (102), 8. 9. 13. 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0451\u0441\u0446\u044c \u041f\u0430\u043d \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u044b, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0456 \u0448\u043c\u0430\u0442\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b. \u041d\u0435 \u0437\u043b\u0443\u0435\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043b\u0430\u0435 \u0433\u043d\u0435\u0432\u0430\u043c \u043d\u0430\u0432\u0435\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043a \u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u0431\u0430\u0446\u044c\u043a\u0430 \u043d\u0430\u0434 \u0441\u044b\u043d\u0430\u043c\u0456, \u0442\u0430\u043a \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u041f\u0430\u043d \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0432\u0435\u0434\u0430\u0435, \u0437 \u0447\u0430\u0433\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043c\u044b; \u043f\u0430\u043c\u044f\u0442\u0430\u0435, \u0448\u0442\u043e \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043f\u044b\u043b\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u0431\u0430\u0446\u044c\u043a\u0430 \u043d\u0430\u0434 \u0441\u044b\u043d\u0430\u043c\u0456, \u0442\u0430\u043a \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u041f\u0430\u043d \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"547","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041b\u0456\u0447\u0431\u0430\u045e <span style=\"color: #ff0000;\">20, 1-13; 21, 4-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u043e\u0434\u044b \u041c\u044d\u0440\u044b\u0431\u044b. \u041c\u044f\u0434\u0437\u044f\u043d\u044b \u0437\u043c\u0435\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0445\u043e\u0434 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0421\u0456\u043d \u0443 \u043f\u0435\u0440\u0448\u044b\u043c \u043c\u0435\u0441\u044f\u0446\u044b, \u0456 \u043d\u0430\u0440\u043e\u0434 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u041a\u0430\u0434\u044d\u0448. \u0422\u0430\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u041c\u0456\u0440\u044b\u044f\u043c, \u0456 \u0442\u0430\u043c \u0431\u044b\u043b\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u0430.\u0406 \u043d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u043c \u0432\u0430\u0434\u044b \u0434\u043b\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0410\u0430\u0440\u043e\u043d\u0430. \u041b\u044e\u0434\u0437\u0456 \u0441\u0432\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u043d\u0430\u0448\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u044b \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u041f\u0430\u043d\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0436\u044b\u0432\u0451\u043b\u0430\u043c\u0456 \u043d\u0430\u0448\u044b\u043c\u0456? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u044b \u043f\u0440\u044b\u043c\u0443\u0441\u0456\u043b\u0456 \u043d\u0430\u0441 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0415\u0433\u0456\u043f\u0435\u0442, \u043a\u0430\u0431 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u045e \u0433\u044d\u0442\u0430\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0441\u0435\u044f\u0446\u044c, \u0434\u0437\u0435 \u043d\u0435 \u0440\u0430\u0441\u0442\u0443\u0446\u044c \u043d\u0456 \u0441\u043c\u043e\u043a\u0432\u044b, \u043d\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434, \u043d\u0456 \u044f\u0431\u043b\u044b\u043a\u0456 \u0433\u0440\u0430\u043d\u0430\u0442\u0443, \u0442\u0443\u0442 \u043d\u044f\u043c\u0430 \u043d\u0430\u0432\u0430\u0442 \u0432\u0430\u0434\u044b \u0434\u043b\u044f \u043f\u0456\u0446\u0446\u044f?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u041c\u0430\u0439\u0441\u0435\u0439 \u0437 \u0410\u0430\u0440\u043e\u043d\u0430\u043c \u0430\u0434\u044b\u0448\u043b\u0456 \u0434\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f \u0456 \u045e\u043f\u0430\u043b\u0456 \u043d\u0456\u0446\u043c\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430. \u0406 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u0436\u0430\u0437\u043b\u043e \u0456 \u0437\u0431\u044f\u0440\u044b \u045e\u0441\u0456\u0445, \u0442\u044b \u0456 \u0410\u0430\u0440\u043e\u043d, \u0431\u0440\u0430\u0442 \u0442\u0432\u043e\u0439, \u0456 \u045e \u0456\u0445 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u043a\u0430\u0436\u044b\u0446\u0435 \u0441\u043a\u0430\u043b\u0435, \u0456 \u044f\u043d\u0430 \u0432\u044b\u0434\u0430\u0441\u0446\u044c \u0437 \u0441\u044f\u0431\u0435 \u0432\u0430\u0434\u0443. \u0422\u0430\u043a \u0442\u044b \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0448 \u0456\u043c \u0432\u0430\u0434\u0443 \u0456 \u0434\u0430\u0441\u0456 \u043f\u0456\u0446\u044c \u0441\u0445\u043e\u0434\u0443 \u0456 \u0436\u044b\u0432\u0451\u043b\u0430\u043c \u0456\u0445\u043d\u0456\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0437\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0436\u0430\u0437\u043b\u043e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u044f\u043a \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u044f\u043c\u0443. \u0421\u0430\u0431\u0440\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0437 \u0410\u0430\u0440\u043e\u043d\u0430\u043c \u043d\u0430\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0434 \u0441\u043a\u0430\u043b\u043e\u044e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0431\u0443\u043d\u0442\u0430\u045e\u043d\u0456\u043a\u0456! \u0426\u0456 \u043c\u044b \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u043c \u0434\u043b\u044f \u0432\u0430\u0441 \u0432\u0430\u0434\u0443 \u0441\u0430 \u0441\u043a\u0430\u043b\u044b \u0433\u044d\u0442\u0430\u0439?&raquo; \u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u043d\u044f\u045e \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0456 \u0434\u0432\u043e\u0439\u0447\u044b \u045e\u0434\u0430\u0440\u044b\u045e \u0443 \u0441\u043a\u0430\u043b\u0443 \u0436\u0430\u0437\u043b\u043e\u043c. \u0406 \u043f\u0430\u0446\u044f\u043a\u043b\u043e \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u0430\u0434\u044b, \u0456 \u043d\u0430\u043f\u0456\u043b\u0430\u0441\u044f \u045e\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u0436\u044b\u0432\u0451\u043b\u0430 \u0456\u0445\u043d\u044f\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e \u0456 \u0410\u0430\u0440\u043e\u043d\u0443: &laquo;\u0417\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u041c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u041c\u044f\u043d\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043d\u0435 \u0432\u044b \u045e\u0432\u0435\u0434\u0437\u044f\u0446\u0435 \u0433\u044d\u0442\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u0456\u043c. \u0413\u044d\u0442\u0430 \u0432\u043e\u0434\u044b \u041c\u044d\u0440\u044b\u0431\u044b, \u0434\u0437\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u043f\u0440\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0437 \u041f\u0430\u043d\u0430\u043c, \u0456 \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0430\u0431\u0440\u044d\u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u043b\u0456 \u0430\u0434 \u0433\u0430\u0440\u044b \u0413\u043e\u0440 \u043f\u0430 \u0448\u043b\u044f\u0445\u0443 \u0434\u0430 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430, \u043a\u0430\u0431 \u0430\u0431\u044b\u0441\u0446\u0456 \u0437\u044f\u043c\u043b\u044e \u042d\u0434\u043e\u043c. \u041b\u044e\u0434\u0437\u0456 \u045e \u0434\u0430\u0440\u043e\u0437\u0435 \u043f\u0430\u0447\u0430\u043b\u0456 \u0433\u0443\u0431\u043b\u044f\u0446\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u042f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u044b\u0432\u0435\u043b\u0456 \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456? \u0411\u043e \u043d\u044f\u043c\u0430 \u0445\u043b\u0435\u0431\u0430, \u043d\u044f\u043c\u0430 \u0432\u0430\u0434\u044b, \u0456 \u043d\u0430\u0434\u0430\u043a\u0443\u0447\u044b\u043b\u0430 \u043d\u0430\u043c \u0433\u044d\u0442\u0430\u044f \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u044f \u0435\u0436\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u041f\u0430\u043d \u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u0434\u0430\u0432\u0456\u0442\u044b\u0445 \u0437\u043c\u0435\u044f\u045e, \u044f\u043a\u0456\u044f \u043a\u0443\u0441\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434, \u0456 \u0448\u043c\u0430\u0442 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430. \u041f\u0440\u044b\u0439\u0448\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0417\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u043c\u044b, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435. \u041f\u0430\u043c\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0401\u043d \u0430\u0434\u0434\u0430\u043b\u0456\u045e \u0430\u0434 \u043d\u0430\u0441 \u0437\u043c\u0435\u044f\u045e&raquo;. \u0406 \u043f\u0430\u043c\u0430\u043b\u0456\u045e\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0430 \u043d\u0430\u0440\u043e\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0417\u0440\u0430\u0431\u0456 \u0441\u0430\u0431\u0435 \u0437\u043c\u0435\u044f \u0456 \u043f\u0430\u0432\u0435\u0441\u044c \u044f\u0433\u043e \u043d\u0430 \u0436\u044d\u0440\u0434\u0437\u0456. \u0422\u0430\u0434\u044b \u043a\u043e\u0436\u043d\u044b \u045e\u043a\u0443\u0448\u0430\u043d\u044b, \u043a\u0430\u043b\u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u044f\u0433\u043e, \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u044c&raquo;. \u0406 \u0437\u0440\u0430\u0431\u0456\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043c\u044f\u0434\u0437\u044f\u043d\u0430\u0433\u0430 \u0437\u043c\u0435\u044f, \u0456 \u045e\u0437\u043d\u044f\u045e \u044f\u0433\u043e \u043d\u0430 \u0436\u044d\u0440\u0434\u0437\u0456. \u0410 \u043a\u0430\u043b\u0456 \u044f\u0434\u0430\u0432\u0456\u0442\u0430\u044f \u0437\u043c\u044f\u044f \u043a\u0443\u0441\u0430\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0451\u043d \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u043c\u044f\u0434\u0437\u044f\u043d\u0430\u0433\u0430 \u0437\u043c\u0435\u044f \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0436\u044b\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 3, 14. 15. 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u043d\u044f\u045e \u0437\u043c\u0435\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0442\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0443\u0437\u043d\u044f\u0442\u044b \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043c\u0435\u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u0432\u0435\u0442 \u0431\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u042f\u0433\u043e. <span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043c\u0435\u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"551","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">1, 1 &ndash; 2, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u044b\u043d &ndash; \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430 \u045e\u0441\u044f\u0433\u043e, \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0411\u043e\u0433 \u0434\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0443 \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430, \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0443\u0441\u044f\u0433\u043e, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u0443\u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u0451 \u0441\u043b\u043e\u0432\u0430\u043c \u043c\u043e\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e, \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0412\u0435\u043b\u0456\u0447\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0456 \u0441\u0442\u0430\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0430\u045e\u043d\u0430\u0435, \u0447\u044b\u043c \u044f\u043d\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043a\u0430\u043b\u0456 \u0456 \u043a\u0430\u043c\u0443 \u0437 \u0430\u043d\u0451\u043b\u0430\u045e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b &ndash; \u0421\u044b\u043d \u041c\u043e\u0439, \u042f \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0426\u044f\u0431\u0435?&raquo; \u0406 \u044f\u0448\u0447\u044d: &laquo;\u042f \u0431\u0443\u0434\u0443 \u042f\u043c\u0443 \u0410\u0439\u0446\u043e\u043c, \u0430 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0421\u044b\u043d\u0430\u043c&raquo;. \u041a\u0430\u043b\u0456 \u0436 \u0437\u043d\u043e\u045e \u0443\u0432\u044f\u0434\u0437\u0435 \u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u045e \u0441\u0432\u0435\u0442, \u0441\u043a\u0430\u0436\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u042f\u043c\u0443 \u045e\u0441\u0435 \u0430\u043d\u0451\u043b\u044b \u0411\u043e\u0436\u044b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u0436\u0430 \u0430\u043d\u0451\u043b\u0430\u043c: &laquo;\u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0430\u043d\u0451\u043b\u0430\u045e \u0432\u044f\u0442\u0440\u0430\u043c\u0456, \u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0441\u0432\u0430\u0456\u0445 &ndash; \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u0430\u0433\u043d\u044e&raquo;. \u0410 \u0421\u044b\u043d\u0443: &laquo;\u0422\u0440\u043e\u043d \u0422\u0432\u043e\u0439, \u0411\u043e\u0436\u0430, \u043d\u0430\u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, \u0456 \u0436\u0430\u0437\u043b\u043e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 &ndash; \u0436\u0430\u0437\u043b\u043e \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0442\u0430\u043c\u0443 \u0422\u0432\u043e\u0439 \u0411\u043e\u0433 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430, \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0422\u0432\u0430\u0456\u0445&raquo;. \u0410 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0422\u044b, \u041f\u0430\u043d\u0435, \u0443 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0437\u044f\u043c\u043b\u044e, \u0456 \u043d\u044f\u0431\u0451\u0441\u044b &ndash; \u0441\u043f\u0440\u0430\u0432\u0430 \u0422\u0432\u0430\u0456\u0445 \u0440\u0443\u043a. \u042f\u043d\u044b \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u0446\u044c, \u0430 \u0422\u044b \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0448\u0441\u044f; \u0456 \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u044e\u0446\u044c \u0443\u0441\u0435, \u044f\u043a \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430, \u0430 \u0422\u044b \u0441\u043a\u0440\u0443\u0446\u0456\u0448 \u0456\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0456 \u044f\u043d\u044b \u0437\u043c\u0435\u043d\u044f\u0446\u0446\u0430. \u0422\u044b \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430, \u0456 \u043d\u0435 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u0446\u0430 \u0422\u0432\u0430\u0435 \u0433\u0430\u0434\u044b&raquo;. \u041a\u0430\u043c\u0443 \u0437 \u0430\u043d\u0451\u043b\u0430\u045e \u0422\u044b \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u044f\u0434\u0437\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u041c\u044f\u043d\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u042f \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u0434\u0443 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e \u0422\u0432\u0430\u0456\u0445 \u0434\u0430 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u043d\u043e\u0433 \u0422\u0432\u0430\u0456\u0445?&raquo; \u0426\u0456 \u0436 \u043d\u0435 \u045e\u0441\u0435 \u044f\u043d\u044b \u0441\u043b\u0443\u0436\u0431\u043e\u0432\u044b\u044f \u0434\u0443\u0445\u0456, \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0456\u043b\u044c\u043d\u0435\u0439 \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430 \u043f\u0430\u0447\u0443\u0442\u0430\u0435, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u0434\u043a\u0430\u043c \u043d\u0435 \u043f\u0440\u0430\u043f\u043b\u044b\u0446\u044c \u043c\u0456\u043c\u0430. \u0411\u043e \u043a\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u0431\u044b\u043b\u043e \u043c\u043e\u0446\u043d\u044b\u043c, \u0456 \u043a\u043e\u0436\u043d\u0430\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430 \u0456 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0437\u0430\u043a\u043e\u043d\u043d\u0443\u044e \u0430\u0434\u043f\u043b\u0430\u0442\u0443, \u0442\u043e \u0456 \u043c\u044b \u043d\u0435 \u045e\u0440\u0430\u0442\u0443\u0435\u043c\u0441\u044f, \u043a\u0430\u043b\u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u0435\u043c \u0442\u0430\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u041f\u0430\u043d\u0430\u043c \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u0447\u0443\u045e. \u0410 \u0411\u043e\u0433 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u044f\u0433\u043e \u0437\u043d\u0430\u043a\u0430\u043c\u0456 \u0456 \u0446\u0443\u0434\u0430\u043c\u0456, \u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u043c\u0456 \u043c\u043e\u0446\u0430\u043c\u0456, \u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0432\u043e\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 1, 3; 12, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430 \u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u0451 \u0441\u043b\u043e\u0432\u0430\u043c \u043c\u043e\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0412\u0435\u043b\u0456\u0447\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u044c\u043d\u0456\u043a \u0432\u0435\u0440\u044b \u043d\u0430\u0448\u0430\u0439 \u0437\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043a\u0440\u044b\u0436.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0412\u0435\u043b\u0456\u0447\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"552","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">2, 5-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0415\u0437\u0443\u0441 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0430\u043d\u0451\u043b\u0430\u043c \u0411\u043e\u0433 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u0432\u0435\u0442, \u043f\u0440\u0430 \u044f\u043a\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043d\u0435\u0434\u0437\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0427\u044b\u043c \u0451\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0448\u0442\u043e \u0422\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u0435\u0448 \u043f\u0440\u0430 \u044f\u0433\u043e, \u0430\u0431\u043e \u0441\u044b\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0448\u0442\u043e \u0422\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0448\u0441\u044f \u0430\u0431 \u0456\u043c? \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u044f\u0433\u043e \u043c\u0430\u043b\u0430 \u043c\u0435\u043d\u0448\u044b\u043c \u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u045e; \u0441\u043b\u0430\u0432\u0430\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0443\u0432\u044f\u043d\u0447\u0430\u045e \u044f\u0433\u043e, \u0443\u0441\u0451 \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0430\u0434 \u044f\u0433\u043e\u043d\u044b\u044f \u043d\u043e\u0433\u0456&raquo;. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u042f\u043c\u0443 \u045e\u0441\u0451, \u0442\u043e \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435\u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u043c \u042f\u043c\u0443. \u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u0430\u0447\u044b\u043c, \u043a\u0430\u0431 \u0443\u0441\u0451 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u042f\u043c\u0443, \u0430\u043b\u0435 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u043c\u0430\u043b\u0430 \u043c\u0435\u043d\u0448\u044b \u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u045e, \u0443\u0432\u0435\u043d\u0447\u0430\u043d\u044b \u0441\u043b\u0430\u0432\u0430\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e, \u0431\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u0437 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u0456 \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451, \u044f\u043a\u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456\u0445\u043d\u044f\u0433\u0430. \u0411\u043e \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u0435, \u0456 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c, &ndash; \u0443\u0441\u0435 \u0430\u0434 \u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430. \u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0401\u043d \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0456\u0445 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u0431\u0432\u044f\u0448\u0447\u0443 \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u0431\u0440\u0430\u0442\u0430\u043c \u043c\u0430\u0456\u043c, \u0441\u044f\u0440\u043e\u0434 \u0441\u0445\u043e\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e \u0426\u044f\u0431\u0435&raquo;. \u0406 \u044f\u0448\u0447\u044d: &laquo;\u042f \u0431\u0443\u0434\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e&raquo;. \u0406 \u0437\u043d\u043e\u045e: &laquo;\u0412\u043e\u0441\u044c \u044f \u0456 \u0434\u0437\u0435\u0446\u0456, \u044f\u043a\u0456\u0445 \u0434\u0430\u045e \u043c\u043d\u0435 \u0411\u043e\u0433&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u0446\u0456 \u043c\u0430\u044e\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0446\u0435\u043b\u0435 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0442\u0430\u043c\u0443 \u045e \u0456\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u045e \u0443\u0434\u0437\u0435\u043b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0415\u0437\u0443\u0441, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0456\u0437\u0440\u044b\u043d\u0443\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434&rsquo;\u044f\u0431\u043b\u0430; \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u045e \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e. \u0411\u043e, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0401\u043d \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0435 \u0430\u043d\u0451\u043b\u0430\u043c, \u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u0422\u0430\u043c\u0443 \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0411\u043e\u0436\u044b\u0445 \u0434\u043b\u044f \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0440\u043e\u0434\u0443. \u0411\u043e, \u044f\u043a \u0401\u043d \u0446\u044f\u0440\u043f\u0435\u045e, \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043f\u0440\u0430\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0442\u0430\u043a \u043c\u043e\u0436\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 2, 11\u0430. 17\u0430; \u043f\u0430\u0440. \u0411\u0430\u0440 3, 38<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u0435, \u0456 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c, &ndash; \u0443\u0441\u0435 \u0430\u0434 \u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u043c\u0456\u0436 \u043b\u044e\u0434\u0437\u0435\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c.<\/p>\r\n"}, {"GCH_CH_1_ID":"553","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">3, 1-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0415\u0437\u0443\u0441 &ndash; \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b \u0441\u0432\u044f\u0442\u044b\u044f, \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439\u0446\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f, \u0415\u0437\u0443\u0441\u0430, \u0431\u043e \u0401\u043d \u0432\u0435\u0440\u043d\u044b \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u042f\u0433\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u044f\u043a \u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u0430 \u045e\u0441\u0456\u043c \u0434\u043e\u043c\u0435 \u042f\u0433\u043e. \u0401\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0440\u0442\u044b \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u044b, \u0447\u044b\u043c \u041c\u0430\u0439\u0441\u0435\u0439, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0430\u0448\u0430\u043d\u0443, \u0447\u044b\u043c \u0434\u043e\u043c, \u043c\u0430\u0435 \u0441\u0430\u043c \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a \u044f\u0433\u043e. \u041a\u043e\u0436\u043d\u044b \u0434\u043e\u043c \u043d\u0435\u0445\u0442\u0430 \u0431\u0443\u0434\u0443\u0435, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0443\u0441\u0451, &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0433. \u0406 \u041c\u0430\u0439\u0441\u0435\u0439 \u0431\u044b\u045e \u0432\u0435\u0440\u043d\u044b\u043c \u0432\u0430 \u045e\u0441\u0456\u043c \u0434\u043e\u043c\u0435 \u042f\u0433\u043e \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0431\u044b\u0446\u044c \u0441\u043a\u0430\u0437\u0430\u043d\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u0430 \u044f\u043a \u0421\u044b\u043d \u0431\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u042f\u0433\u043e, \u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043c\u044b, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0443 \u0456 \u0441\u043b\u0430\u045e\u043d\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u044f\u043a \u043a\u0430\u0436\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b: &laquo;\u0421\u0451\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f, \u044f\u043a \u0443 \u0447\u0430\u0441 \u0441\u043c\u0443\u0442\u044b, \u0443 \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0434\u0437\u0435, \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u044e\u0447\u044b, \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044b \u041c\u0430\u0435 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u0430\u0440\u0430\u043a\u0430 \u0433\u0430\u0434\u043e\u045e. \u0422\u0430\u043c\u0443 \u042f \u0456 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u0442\u043e\u0435, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u042f\u043d\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b, \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0448\u043b\u044f\u0445\u043e\u045e \u041c\u0430\u0456\u0445. \u0422\u0430\u043c\u0443 \u042f \u043f\u0440\u044b\u0441\u044f\u0433\u043d\u0443\u045e \u0443 \u0433\u043d\u0435\u0432\u0435 \u041c\u0430\u0456\u043c, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u041c\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u043a\u0430\u0433\u043e \u0437 \u0432\u0430\u0441 \u043b\u0456\u0445\u043e\u0433\u0430 \u0441\u044d\u0440\u0446\u0430 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u044f, \u044f\u043a\u043e\u0435 \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430. \u0410\u043b\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0448\u0442\u043e\u0434\u043d\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u043e\u0436\u043d\u0430 \u043a\u0430\u0437\u0430\u0446\u044c &laquo;\u0441\u0451\u043d\u043d\u044f&raquo;, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0441\u0442\u0430\u045e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u0434\u043c\u0430\u043d \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043c\u044b \u0441\u0442\u0430\u043d\u0435\u043c\u0441\u044f \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u043c \u043c\u043e\u0446\u043d\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u044f\u043a\u0443\u044e \u043c\u0435\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u0421\u0451\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e\u043d\u044b, \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f, \u044f\u043a \u043f\u0430\u0434\u0447\u0430\u0441 \u0431\u0443\u043d\u0442\u0443&raquo;. \u0414\u044b\u043a \u0445\u0442\u043e \u0436 \u0442\u044b\u044f, \u0445\u0442\u043e, \u043f\u0430\u0447\u0443\u045e\u0448\u044b, \u0443\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u045e\u0441\u044f? \u0413\u044d\u0442\u0430 \u0436 \u043d\u0435 \u045e\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430? \u041d\u0430 \u043a\u0430\u0433\u043e \u0401\u043d \u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u0441\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e? \u0426\u0456 \u043d\u0435 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0456 \u0447\u044b\u0435 \u0442\u0440\u0443\u043f\u044b \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456? \u041a\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f, \u0448\u0442\u043e \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u042f\u0433\u043e\u043d\u044b \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f? \u0406 \u043c\u044b \u0431\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 3, 6\u0430; \u042d\u0444 2, 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u044f\u043a \u0421\u044b\u043d \u0443 \u0434\u043e\u043c\u0435 \u0410\u0439\u0446\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043c\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u043a\u043e\u0436\u043d\u044b \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0431\u0443\u0434\u044b\u043d\u0430\u043a \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 \u044f\u043a \u0441\u0432\u044f\u0442\u0430\u044f \u045e \u041f\u0430\u043d\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u042f\u0433\u043e\u043d\u044b\u043c \u0434\u043e\u043c\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043c\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"554","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">6, 9-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430 &ndash; \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u043d\u0430 \u0432\u0430\u0441, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0432\u044b \u043b\u0435\u043f\u0448\u044b\u044f \u0456 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435\u0441\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0445\u043e\u0446\u044c \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u043a\u0430\u0431 \u0437\u0430\u0431\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u043f\u0440\u0430\u0446\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u0432\u044b \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u045e \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0456\u043d\u0443\u043b\u0430\u0433\u0430 \u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u043c. \u0422\u0430\u043c\u0443 \u0436\u0430\u0434\u0430\u0435\u043c, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0442\u0430\u043a\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043d\u0430\u0434\u0437\u0435\u0456, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0440\u0430\u0437\u043b\u0435\u043d\u0430\u0432\u0430\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456. \u0414\u0430\u045e\u0448\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0411\u043e\u0433 \u043d\u0435 \u043c\u043e\u0433 \u043f\u0430\u043a\u043b\u044f\u0441\u0446\u0456\u0441\u044f \u043d\u0456\u043a\u0456\u043c \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0456 \u0442\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435 \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u0443 \u0446\u044f\u0431\u0435&raquo;. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0447\u0430\u043a\u0430\u045e, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435. \u0411\u043e \u043b\u044e\u0434\u0437\u0456 \u043a\u043b\u044f\u043d\u0443\u0446\u0446\u0430 \u043d\u0435\u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u044b\u043c, \u0456 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u044f\u043d\u044b \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043a\u043b\u044f\u0442\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0411\u043e\u0433, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456, \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e \u044f\u0433\u043e \u043a\u043b\u044f\u0442\u0432\u0430\u0439, \u043a\u0430\u0431 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0437\u0432\u044e\u043c \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u043c \u0440\u044d\u0447\u0430\u043c, \u0443 \u044f\u043a\u0456\u0445 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0411\u043e\u0433 \u0437\u043c\u0430\u043d\u0456\u0446\u044c, \u043c\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0431\u0435\u0433\u043b\u0456 \u0441\u0445\u0430\u043f\u0456\u0446\u0446\u0430 \u0437\u0430 \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u043c\u0435\u043b\u0456 \u0446\u0432\u0451\u0440\u0434\u0443\u044e \u0437\u0430\u0430\u0445\u0432\u043e\u0442\u0443. \u0413\u044d\u0442\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0456\u0431\u044b \u044f\u043a\u0430\u0440 \u0434\u0443\u0448\u044b, \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u044b \u0456 \u043c\u043e\u0446\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e\u043d\u0443\u0442\u0440 \u043f\u0430-\u0437\u0430 \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u043a\u0443\u0434\u044b \u044f\u043a \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u043d\u0430\u0441 \u0415\u0437\u0443\u0441, \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 6, 19. 20; 7, 24. 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u044f\u043a \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430; <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430 \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u0435, \u0442\u0430\u043c\u0443 \u0401\u043d \u043c\u043e\u0436\u0430 \u0432\u0430 \u045e\u0441\u0435 \u0447\u0430\u0441\u044b \u0437\u0431\u0430\u045e\u043b\u044f\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0434\u0430 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"555","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">7, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a &ndash; \u0443\u0437\u043e\u0440 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a, \u043a\u0430\u0440\u043e\u043b\u044c \u0421\u0430\u043b\u0435\u043c\u0430, \u0441\u0432\u044f\u0442\u0430\u0440 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u044f\u043a\u0456 \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0440\u0430\u0437\u044b \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u044f\u0433\u043e. \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u044f\u043c\u0443 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443 \u0437 \u0443\u0441\u044f\u0433\u043e. \u0406\u043c\u044f \u0436 \u044f\u0433\u043e\u043d\u0430\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 &laquo;\u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo;, \u0430 \u043f\u043e\u0442\u044b\u043c &ndash; &laquo;\u043a\u0430\u0440\u043e\u043b\u044c \u0421\u0430\u043b\u0435\u043c\u0430&raquo;, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c &laquo;\u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0430\u043a\u043e\u044e&raquo;. \u0411\u0435\u0437 \u0431\u0430\u0446\u044c\u043a\u0456, \u0431\u0435\u0437 \u043c\u0430\u0446\u0456, \u0431\u0435\u0437 \u0440\u0430\u0434\u0430\u0432\u043e\u0434\u0443, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u043d\u0456 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0434\u0437\u0451\u043d, \u043d\u0456 \u043a\u0430\u043d\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0435\u043d\u044b \u0434\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0451\u043d \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u044f\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445 \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0434\u0430\u0432\u0430\u045e \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443 \u0437 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u043b\u0451\u043d\u0443. \u0406 \u0442\u044b\u044f \u0441\u044b\u043d\u044b \u041b\u0435\u0432\u0456\u044f, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043c\u0430\u044e\u0446\u044c \u043d\u0430\u043a\u0430\u0437 \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443 \u0437 \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0445\u043e\u0446\u044c \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0456\u0445 \u0440\u043e\u0434\u0443, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443 \u0430\u0434 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0435\u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435. \u0411\u0435\u0437 \u043d\u0456\u044f\u043a\u0456\u0445 \u0441\u043f\u0440\u044d\u0447\u0430\u043a, \u043c\u0435\u043d\u0448\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0437\u043d\u0430\u0447\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0443\u0442 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044f\u0440\u0443\u0446\u044c \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443 \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0430 \u0442\u0430\u043c &ndash; \u0442\u043e\u0439, \u0447\u044b\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u0430. \u0406 \u043a\u0430\u043b\u0456 \u043c\u043e\u0436\u043d\u0430 \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u043f\u0440\u0430\u0437 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0456 \u041b\u0435\u0432\u0456\u0439, \u044f\u043a\u0456 \u0437\u0431\u0456\u0440\u0430\u0435 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443, \u0441\u0430\u043c \u0434\u0430\u045e \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u045e \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0456\u0445 \u0441\u0446\u0451\u0433\u043d\u0430\u0445, \u043a\u0430\u043b\u0456 \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0432\u044b\u0439\u0448\u0430\u045e \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0411\u044b\u0446 14, 18; \u0413\u0431\u0440 7, 3; \u043f\u0430\u0440. \u041f\u0441 110 (109), 4; \u0413\u0431\u0440 7, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a, \u043a\u0430\u0440\u043e\u043b\u044c \u0421\u0430\u043b\u0435\u043c\u0430, \u0432\u044b\u043d\u0435\u0441 \u0445\u043b\u0435\u0431 \u0456 \u0432\u0456\u043d\u043e \u044f\u043a \u0441\u0432\u044f\u0442\u0430\u0440 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430; \u0401\u043d \u0431\u044b\u045e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u041f\u0430\u043d: \u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0441\u0442\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0456\u043b\u044b \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u041f\u0430\u043d: \u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"556","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">7, 11-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u045e\u0434\u0430\u043b\u043e\u0441\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043f\u0440\u0430\u0437 \u043b\u0435\u0432\u0456\u0446\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 (\u0431\u043e \u043d\u0430\u0440\u043e\u0434 \u0437 \u0456\u0445 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0417\u0430\u043a\u043e\u043d), \u0446\u0456 \u0431\u044b\u043b\u0430 \u0431 \u043f\u0430\u0442\u0440\u044d\u0431\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0446\u044c \u044f\u0448\u0447\u044d \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430, \u0430 \u043d\u0435 \u043d\u0430 \u045e\u0437\u043e\u0440 \u0410\u0430\u0440\u043e\u043d\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0437\u043c\u0435\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043f\u0440\u0430\u0432\u0435\u0441\u0446\u0456 \u0456 \u0437\u043c\u0435\u043d\u0443 \u0417\u0430\u043a\u043e\u043d\u0443. \u0422\u043e\u0439 \u0436\u0430, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u043d\u0430\u043b\u0435\u0436\u0430\u045e \u0434\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u0437 \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u045e \u0430\u043b\u0442\u0430\u0440\u0443. \u0412\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u043d\u0430\u0448 \u041f\u0430\u043d \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u042e\u0434\u044b, \u0430 \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u043b\u0435\u043c\u0435\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430 \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0456\u043d\u0448\u044b \u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u043a\u0430\u0437\u0443, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u043e\u0446\u044b \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0411\u043e \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e: &laquo;\u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0441\u043a\u0430\u0441\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u044f\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0446\u0456 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0441\u0446\u0456. \u0417\u0430\u043a\u043e\u043d \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0430\u043b\u0435 \u0434\u0430\u045e \u043b\u0435\u043f\u0448\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u043c\u044b \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0436\u0430\u043d\u0430 \u043a\u043b\u044f\u0442\u0432\u0430\u0439, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0456\u043d\u0448\u044b\u044f \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0431\u0435\u0437 \u043a\u043b\u044f\u0442\u0432\u044b, \u0430 \u0401\u043d \u0437 \u043a\u043b\u044f\u0442\u0432\u0430\u044e, \u0431\u043e \u043f\u0440\u0430 \u042f\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u041f\u0430\u043d \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u0446\u044c: \u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456&raquo;, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0415\u0437\u0443\u0441 \u0441\u0442\u0430\u045e \u0437\u0430\u0440\u0443\u043a\u0430\u0439 \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u043c\u0430\u0442 \u0431\u044b\u043b\u043e \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e\u0441\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0431\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u043b\u0430 \u0456\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c. \u0410\u043b\u0435 \u0433\u044d\u0442\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u0432\u0435\u0447\u043d\u0430, \u043c\u0430\u0435 \u043d\u0435\u043f\u0440\u0430\u043c\u0456\u043d\u0430\u043b\u044c\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430. \u0422\u0430\u043c\u0443 \u0456 \u043c\u043e\u0436\u0430 \u0401\u043d \u0432\u0430 \u045e\u0441\u0435 \u0447\u0430\u0441\u044b \u0437\u0431\u0430\u045e\u043b\u044f\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0434\u0430 \u0411\u043e\u0433\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b\u043c, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u0446\u0430 \u0437\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456 \u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0443 \u043d\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440: \u0441\u0432\u044f\u0442\u044b, \u043d\u044f\u0432\u0456\u043d\u043d\u044b, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b \u0430\u0434 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0456 \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043d\u044f\u0431\u0451\u0441\u044b. \u0401\u043d \u043d\u0435 \u043c\u0430\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u044b, \u044f\u043a \u0442\u044b\u044f \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0448\u0442\u043e\u0434\u043d\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0437\u0430 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456, \u0430 \u043f\u043e\u0442\u044b\u043c \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0440\u043e\u0434\u0443. \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0440\u0430\u0437 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e\u0448\u044b \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0411\u043e \u0417\u0430\u043a\u043e\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043c\u0430\u044e\u0446\u044c \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u0430 \u0441\u043b\u043e\u0432\u0430 \u043a\u043b\u044f\u0442\u0432\u044b, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043f\u0430\u0441\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443, \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0435 \u0421\u044b\u043d\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 5, 5\u0430. 6b; 7, 20b. 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0430\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406\u043d\u0448\u044b\u044f \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0431\u0435\u0437 \u043a\u043b\u044f\u0442\u0432\u044b, \u0430 \u0415\u0437\u0443\u0441 &ndash; \u0437 \u043a\u043b\u044f\u0442\u0432\u0430\u044e, \u0431\u043e \u043f\u0440\u0430 \u042f\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430:<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"557","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">8, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u043d\u043e\u0432\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0413\u0430\u043b\u043e\u045e\u043d\u0430\u0435 \u045e \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u043c \u0433\u044d\u0442\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0442\u0440\u043e\u043d\u0430 \u0412\u0435\u043b\u0456\u0447\u044b \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0441\u043a\u0456\u043d\u0456\u0456, \u0443\u0437\u0432\u0435\u0434\u0437\u0435\u043d\u0430\u0439 \u041f\u0430\u043d\u0430\u043c, \u0430 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0411\u043e \u043a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430\u0440\u044b \u0456 \u0430\u0445\u0432\u044f\u0440\u044b. \u0422\u0430\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u0456 \u0401\u043d \u043c\u0435\u045e, \u0448\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u0431 \u0401\u043d \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0443\u0442 \u0451\u0441\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0434\u0430\u0440\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443. \u042f\u043d\u044b \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0443\u0437\u043e\u0440\u0443 \u0456 \u0446\u0435\u043d\u044e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u044f\u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u041c\u0430\u0439\u0441\u0435\u044e, \u043a\u0430\u043b\u0456 \u0451\u043d \u0437\u0431\u0456\u0440\u0430\u045e\u0441\u044f \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u0446\u044c \u0441\u043a\u0456\u043d\u0456\u044e. \u0411\u043e \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0437\u043e\u0440\u0443, \u043f\u0430\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u0442\u0430\u0431\u0435 \u043d\u0430 \u0433\u0430\u0440\u044b&raquo;. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u0401\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u043d\u0430 \u043b\u0435\u043f\u0448\u044b\u0445 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u043f\u0435\u0440\u0448\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0431\u044b\u045e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456 \u0431 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u0434\u0440\u0443\u0433\u043e\u0433\u0430. \u0411\u043e \u044f\u043a \u0434\u0430\u043a\u043e\u0440 \u0456\u043c \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u0412\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u043d\u0456, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u043a\u0430\u043b\u0456 \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u041d\u0435 \u0442\u0430\u043a\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u042f \u0437 \u0430\u0439\u0446\u0430\u043c\u0456 \u0456\u0445\u043d\u0456\u043c\u0456 \u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u045e\u0437\u044f\u045e \u0456\u0445 \u0437\u0430 \u0440\u0443\u043a\u0443, \u043a\u0430\u0431 \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u041c\u0430\u0456\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435, \u0456 \u042f \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0456\u0445&raquo;, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u043e\u0441\u044c \u0442\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0451\u043d, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u042f \u045e\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d\u044b \u041c\u0430\u0435 \u045e \u0440\u043e\u0437\u0443\u043c \u0456\u0445\u043d\u0456 \u0456 \u043d\u0430 \u0441\u044d\u0440\u0446\u0430\u0445 \u0456\u0445\u043d\u0456\u0445 \u043d\u0430\u043f\u0456\u0448\u0443 \u0456\u0445, \u0456 \u0431\u0443\u0434\u0443 \u0434\u043b\u044f \u0456\u0445 \u0411\u043e\u0433\u0430\u043c, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0406 \u043d\u0456\u0445\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u043d\u0456\u0445\u0442\u043e &ndash; \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041f\u0430\u0437\u043d\u0430\u0439 \u041f\u0430\u043d\u0430&rdquo;, \u0431\u043e \u045e\u0441\u0435 \u044f\u043d\u044b, \u0430\u0434 \u043c\u0430\u043b\u043e\u0433\u0430 \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0435\u0434\u0430\u0446\u044c \u041c\u044f\u043d\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0443\u0434\u0443 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u0434\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u045e \u0456\u0445\u043d\u0456\u0445 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u0456\u0445\u043d\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430 \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0401\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u043b\u044b\u043c \u043f\u0435\u0440\u0448\u044b; \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0430\u045e\u043d\u0456\u043c \u0456 \u0441\u0442\u0430\u0440\u044d\u0435, \u0431\u043b\u0456\u0437\u043a\u0430\u0435 \u0434\u0430 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 8, 1b. 2\u0430; 9, 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0435\u043c \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0442\u0440\u043e\u043d\u0430 \u0412\u0435\u043b\u0456\u0447\u044b \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0441\u043a\u0456\u043d\u0456\u0456, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u043d\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0443\u044e \u0440\u0443\u043a\u0430\u043c\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439, \u0430\u043b\u0435 \u045e \u0441\u0430\u043c\u043e \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"561","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">10, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u0430\u0448\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0443 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0437\u0430\u043a\u043e\u043d \u043c\u0430\u0435 \u0446\u0435\u043d\u044c \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0430\u043b\u0435 \u043d\u0435 \u0441\u0430\u043c \u0432\u043e\u0431\u0440\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u0430\u045e. \u0422\u0430\u043c\u0443 \u0430\u0434\u043d\u044b\u044f \u0456 \u0442\u044b\u044f \u0436 \u0430\u0445\u0432\u044f\u0440\u044b, \u044f\u043a\u0456\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0448\u0442\u043e\u0433\u043e\u0434, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0456\u043c\u0456. \u0411\u043e \u0446\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b, \u043a\u0430\u043b\u0456 \u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0443\u0435, \u0431\u044b\u043b\u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u043d\u0435 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0456\u044f\u043a\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. \u0410\u043b\u0435 \u045e \u0433\u044d\u0442\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u0445 &ndash; \u0448\u0442\u043e\u0433\u0430\u0434\u043e\u0432\u044b \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0433\u0440\u0430\u0445\u0456, \u0431\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u043a\u0440\u043e\u045e \u0431\u044b\u043a\u043e\u045e \u0434\u044b \u043a\u0430\u0437\u043b\u043e\u045e \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u0430 \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0410\u0445\u0432\u044f\u0440\u044b \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f \u0422\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e, \u0430\u043b\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u041c\u043d\u0435. \u0423\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u043d\u0435 \u0434\u0430\u0441\u043f\u0430\u0434\u043e\u0431\u044b \u0422\u0430\u0431\u0435. \u0422\u0430\u0434\u044b \u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u0412\u043e\u0441\u044c \u0456\u0434\u0443, \u044f\u043a \u0443 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043a\u043d\u0456\u0433\u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u043f\u0440\u0430 \u041c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0432\u043e\u043b\u044e \u0422\u0432\u0430\u044e, \u0411\u043e\u0436\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0410\u0445\u0432\u044f\u0440\u0430\u045e \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u045e, \u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u0437\u0430 \u0433\u0440\u044d\u0445 \u0422\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0456 \u043d\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e, \u0445\u043e\u0446\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u044f\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443&raquo;. \u041f\u0430\u0441\u043b\u044f \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u043e\u0441\u044c \u0456\u0434\u0443, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0432\u043e\u043b\u044e \u0422\u0432\u0430\u044e&raquo;. \u0410\u0434\u043c\u044f\u043d\u044f\u0435 \u043f\u0435\u0440\u0448\u0430\u0435, \u043a\u0430\u0431 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u044c \u0434\u0440\u0443\u0433\u043e\u0435. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u044d\u0442\u0430\u0439 \u0432\u043e\u043b\u0456 \u043c\u044b \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u0430\u044e \u0446\u0435\u043b\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0441\u0442\u0430\u0456\u0446\u044c \u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0456 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0434\u043d\u044b \u0456 \u0442\u044b\u044f \u0436 \u0430\u0445\u0432\u044f\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u043d\u0451\u0441\u0448\u044b \u0430\u0434\u043d\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456, \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u0434\u0430 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u043d\u043e\u0433 \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0401\u043d \u0430\u0434\u043d\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043d\u0430\u043c \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0431\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0412\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0456\u043c\u0456 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0451\u043d, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0456 \u045e\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d\u044b \u041c\u0430\u0435 \u045e \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b, \u0456 \u0437\u0430\u043f\u0456\u0448\u0443 \u0456\u0445 \u0443 \u0440\u043e\u0437\u0443\u043c\u0435 \u0456\u0445\u043d\u0456\u043c, \u0430 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f\u045e \u0456\u0445 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0441\u043f\u043e\u043c\u043d\u044e&raquo;. \u0410 \u0434\u0437\u0435 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e, \u0442\u0430\u043c \u0443\u0436\u043e \u043d\u044f\u043c\u0430 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 10, 5-7. 4 (\u041f\u0441 40 [39], 7-8)<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0445\u0432\u044f\u0440\u044b \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f \u0422\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e, \u0430\u043b\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u041c\u043d\u0435. \u0423\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u043d\u0435 \u0434\u0430\u0441\u043f\u0430\u0434\u043e\u0431\u044b \u0422\u0430\u0431\u0435. \u0422\u0430\u0434\u044b \u042f \u0441\u043a\u0430\u0437\u0430\u045e: <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u0456\u0434\u0443, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0432\u043e\u043b\u044e \u0422\u0432\u0430\u044e, \u0411\u043e\u0436\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u043a\u0440\u043e\u045e \u0431\u044b\u043a\u043e\u045e \u0434\u044b \u043a\u0430\u0437\u043b\u043e\u045e \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u0430 \u0433\u0440\u0430\u0445\u0456. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043a\u0430\u0436\u0430:<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0456\u0434\u0443, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0432\u043e\u043b\u044e \u0422\u0432\u0430\u044e, \u0411\u043e\u0436\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"562","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">10, 19-39<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0426\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0432\u0435\u0440\u044b. \u0427\u0430\u043a\u0430\u043d\u043d\u0435 \u0441\u0443\u0434\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043c\u0430\u044e\u0447\u044b \u0430\u0434\u0432\u0430\u0433\u0443 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u045e \u0421\u0432\u044f\u0442\u043e\u0435 \u041c\u0435\u0441\u0446\u0430 \u043d\u043e\u0432\u044b\u043c \u0456 \u0436\u044b\u0432\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u044f\u043a\u0456 \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0440\u0430\u0437 \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0451; \u043c\u0430\u044e\u0447\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043d\u0430\u0434 \u0411\u043e\u0436\u044b\u043c \u0434\u043e\u043c\u0430\u043c, \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u045e \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0432\u0435\u0440\u044b, \u0430\u043a\u0440\u0430\u043f\u0456\u045e\u0448\u044b \u0441\u044d\u0440\u0446\u044b \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0431\u043c\u044b\u045e\u0448\u044b \u0446\u0435\u043b\u044b \u0447\u044b\u0441\u0442\u0430\u044e \u0432\u0430\u0434\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0434\u0437\u0435\u0456, \u0431\u043e \u0432\u0435\u0440\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e. \u0411\u0443\u0434\u0437\u0435\u043c \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u043d\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e. \u0406 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u043c\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u0445\u043e\u0434\u0443, \u044f\u043a \u0441\u0442\u0430\u043b\u0430 \u0437\u0432\u044b\u0447\u0430\u0435\u043c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0456 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u0447\u044b\u0446\u0435, \u044f\u043a \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0433\u0440\u0430\u0448\u044b\u043c, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u043e \u045e\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456, \u0430\u043b\u0435 \u043d\u0435\u0439\u043a\u0430\u0435 \u0436\u0430\u0445\u043b\u0456\u0432\u0430\u0435 \u0447\u0430\u043a\u0430\u043d\u043d\u0435 \u0441\u0443\u0434\u0430 \u0456 \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u0430\u0433\u043d\u044e, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u0440\u0443\u0448\u0430\u0435 \u0417\u0430\u043a\u043e\u043d \u041c\u0430\u0439\u0441\u0435\u044f, \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u0435\u0437 \u043b\u0456\u0442\u0430\u0441\u0446\u0456 \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0434\u0432\u0443\u0445 \u0446\u0456 \u0442\u0440\u043e\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e. \u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0456 \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u045e \u043a\u0440\u043e\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u043e\u0439 \u0431\u044b\u045e \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b, \u0456 \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u045e \u0414\u0443\u0445\u0430 \u043b\u0430\u0441\u043a\u0456? \u041c\u044b \u0436 \u0432\u0435\u0434\u0430\u0435\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u043e\u043c\u0441\u0442\u0430 \u0437\u0430 \u041c\u043d\u043e\u044e, \u042f \u0430\u0434\u043f\u043b\u0430\u0447\u0443&raquo;. \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0421\u0430\u043c \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434&raquo;. \u0421\u0442\u0440\u0430\u0448\u043d\u0430\u044f \u0440\u044d\u0447 &ndash; \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u0440\u0443\u043a\u0456 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u0432\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0440\u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u043c\u0456, \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0446\u044f\u0436\u043a\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f. \u0422\u043e \u0432\u0430\u0441 \u0432\u044b\u0441\u0442\u0430\u045e\u043b\u044f\u043b\u0456 \u044f\u043a \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430 \u043d\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0456 \u045e\u0446\u0456\u0441\u043a, \u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0442\u044b\u0445, \u0437 \u043a\u0456\u043c \u0442\u0430\u043a \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456\u0441\u044f. \u0411\u043e \u0432\u044b \u0441\u0443\u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445, \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e\u0441\u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0439 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u0432\u0430\u0441 \u043b\u0435\u043f\u0448\u0430\u044f \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456 \u0432\u0430\u0448\u0430\u0439, \u044f\u043a\u0430\u044f \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0410 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0432\u0430\u043c, \u043a\u0430\u0431, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0411\u043e\u0436\u0443\u044e, \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443, \u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u0456 \u043d\u0435 \u0441\u043f\u043e\u0437\u043d\u0456\u0446\u0446\u0430. \u0410 \u043c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b, \u0456, \u043a\u0430\u043b\u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430, \u043d\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u0435 \u044f\u0433\u043e \u0434\u0443\u0448\u0430 \u043c\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043c\u044b \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0430\u043b\u0435 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 10, 35\u0430. 36; \u041b\u043a 21, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456 \u0432\u0430\u0448\u0430\u0439, \u044f\u043a\u0430\u044f \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0432\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0411\u043e\u0436\u0443\u044e, \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0426\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c \u0441\u0432\u0430\u0456\u043c \u0443\u0440\u0430\u0442\u0443\u0435\u0446\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0411\u043e\u0436\u0443\u044e, \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"563","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">12, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u0430 \u045e\u0437\u043e\u0440 \u0425\u0440\u044b\u0441\u0442\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u0435\u0433\u0447\u044b \u045e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u0430\u044e\u0447\u044b \u0432\u0430\u043a\u043e\u043b \u0441\u044f\u0431\u0435 \u0431\u0435\u0437\u043b\u0456\u0447 \u0441\u0432\u0435\u0434\u043a\u0430\u045e, \u0441\u043a\u0456\u043d\u0435\u043c \u0437 \u0441\u044f\u0431\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0446\u044f\u0436\u0430\u0440 \u0456 \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u043b\u0451\u0433\u043a\u0430 \u0430\u0431\u043b\u044b\u0442\u0432\u0430\u0435 \u043d\u0430\u0441, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b. \u0417\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0401\u043d, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0433\u0430\u043d\u044c\u0431\u0443, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043a\u0440\u044b\u0436 \u0456 \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0436\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u045e \u0442\u0430\u043a\u0456 \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0437\u0434\u0437\u0435\u043a \u0430\u0434 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0435\u043c\u0430\u0433\u043b\u0456\u0441\u044f \u0432\u044b \u045e \u0434\u0443\u0448\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0456 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u043b\u0456. \u0412\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0430\u0436 \u0434\u0430 \u043a\u0440\u044b\u0432\u0456, \u0432\u0430\u044e\u044e\u0447\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0443, \u0456 \u0437\u0430\u0431\u044b\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0436\u0430 \u0432\u0430\u043c, \u044f\u043a \u0441\u044b\u043d\u0430\u043c: &laquo;\u0421\u044b\u043d\u0435 \u043c\u043e\u0439, \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0439 \u0434\u0443\u0445\u0430\u043c, \u043a\u0430\u043b\u0456 \u0401\u043d \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0446\u044f\u0431\u0435. \u0411\u043e \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u0430\u0433\u043e \u0456 \u043a\u0430\u0440\u0430\u0435, \u0456 \u0431&rsquo;\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u043a \u0441\u044b\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u044f \u0434\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f\u045e. \u0411\u043e\u0433 \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441, \u044f\u043a \u0434\u0430 \u0441\u044b\u043d\u043e\u045e. \u0426\u0456 \u0436 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u0441\u044b\u043d, \u044f\u043a\u043e\u0433\u0430 \u0431 \u043d\u0435 \u043a\u0430\u0440\u0430\u045e \u0431\u0430\u0446\u044c\u043a\u0430? \u0410 \u043a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430-\u0437\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c, \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u044f\u043a\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0456 \u045e\u0441\u0435, \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0432\u044b \u043d\u0435 \u0441\u044b\u043d\u044b, \u0430 \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u044f \u0434\u0437\u0435\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443 \u043d\u0430\u0441 \u0431\u044b\u043b\u0456 \u0437\u044f\u043c\u043d\u044b\u044f \u0431\u0430\u0446\u044c\u043a\u0456, \u043a\u0430\u0431 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430\u0441, \u0456 \u043c\u044b \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0456\u0445. \u0426\u0456 \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0410\u0439\u0446\u0443 \u0434\u0443\u0445\u0430\u045e, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c? \u0422\u044b\u044f \u043a\u0430\u0440a\u043b\u0456 \u043d\u0430\u0441 \u043f\u0430 \u0441\u0432\u0430\u0456\u043c \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0456 \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441. \u0410 \u0433\u044d\u0442\u044b \u043a\u0430\u0440\u0430\u0435 \u043d\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430, \u043a\u0430\u0431 \u043c\u044b \u043c\u0435\u043b\u0456 \u045e\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0430 \u0441\u043c\u0443\u0442\u043a\u0430\u043c. \u0410\u043b\u0435 \u043f\u0430\u0437\u043d\u0435\u0439 \u044f\u043d\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043c\u0456\u0440\u043d\u044b \u043f\u043b\u0451\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u043b\u0430. \u0422\u0430\u043c\u0443 \u0432\u044b\u043f\u0440\u0430\u0441\u0442\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b \u0430\u043f\u0430\u045e\u0448\u044b\u044f \u0440\u0443\u043a\u0456 \u0456 \u0430\u0441\u043b\u0430\u0431\u043b\u044b\u044f \u043a\u0430\u043b\u0435\u043d\u0456. \u0420\u0430\u0431\u0456\u0446\u0435 \u043f\u0440\u043e\u0441\u0442\u044b\u044f \u0441\u0446\u0435\u0436\u043a\u0456 \u043d\u0430\u0433\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456, \u043a\u0430\u0431 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b \u043d\u0435 \u0437\u0431\u043e\u0447\u044b\u045e, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b\u0437\u0434\u0430\u0440\u0430\u0432\u0435\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 12, 2; \u0424\u043b\u043f 2, 8\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0435 \u0432\u0435\u0440\u044b, \u0437\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0433\u0430\u043d\u044c\u0431\u0443, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043a\u0440\u044b\u0436 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0436\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0436\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"564","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">12, 14-29<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041c\u044b \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0433\u0430\u0440\u044b \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0406\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0437 \u0443\u0441\u0456\u043c\u0456 \u0456 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0431\u0435\u0437 \u044f\u043a\u043e\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u041f\u0430\u043d\u0430. \u0421\u0430\u0447\u044b\u0446\u0435, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u0431 \u044f\u043a\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0433\u043e\u0440\u043a\u0456 \u043a\u043e\u0440\u0430\u043d\u044c, \u0448\u0442\u043e \u0440\u0430\u0441\u0446\u0435 \u045e\u0432\u0435\u0440\u0445, \u043d\u0435 \u0440\u0430\u0437\u0440\u043e\u0441\u0441\u044f \u0456 \u043d\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u0456\u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043di\u044f\u043a\u0430\u0433\u0430 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u043a\u0430 \u0446\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u0431, \u044f\u043a \u042d\u0437\u0430\u045e, \u0437\u0430 \u0430\u0434\u0437\u0456\u043d \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u0441\u0442\u0432\u0430. \u0412\u044b \u0436 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043f\u0430\u0437\u043d\u0435\u0439, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0451\u043d \u0431\u044b\u045e \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0456 \u043d\u0435 \u0437\u043c\u043e\u0433 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435, \u0445\u043e\u0446\u044c \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u0430\u0431 \u0433\u044d\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u043d\u0435 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u043d\u0456 \u0434\u0430 \u043d\u0430\u043c\u0430\u0446\u0430\u043b\u044c\u043d\u0430\u0433\u0430, \u043d\u0456 \u0434\u0430 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0433\u0430 \u0430\u0433\u043d\u044e, \u043d\u0456 \u0434\u0430 \u0437\u043c\u0440\u043e\u043a\u0443, \u0446\u0435\u043c\u0440\u044b \u0456 \u0431\u0443\u0440\u044b, \u043d\u0456 \u0434\u0430 \u0433\u0443\u043b\u0443 \u0442\u0440\u0443\u0431\u044b \u0456 \u0442\u0430\u043a\u043e\u0433\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u0441\u043b\u043e\u045e, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u0447\u0443\u045e, \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445 \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0430. \u042f\u043d\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u043a\u0430\u0437\u0443: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0436\u044b\u0432\u0451\u043b\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u0430\u0440\u044b, \u0431\u0443\u0434\u0437\u0435 \u045e\u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043d\u0430&raquo;. \u0410 \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0435, \u0448\u0442\u043e \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u0456 \u0434\u0440\u044b\u0436\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0436 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d \u0456 \u0434\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0434\u0430 \u0431\u0435\u0437\u043b\u0456\u0447\u044b \u0430\u043d\u0451\u043b\u0430\u045e, \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u0430\u0433\u0430 \u0441\u0445\u043e\u0434\u0443, \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u0445 \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 &ndash; \u0421\u0443\u0434\u0434\u0437\u0456 \u045e\u0441\u0456\u0445, \u0434\u0430 \u0434\u0443\u0445\u0430\u045e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0434\u0430 \u0415\u0437\u0443\u0441\u0430 &ndash; \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0434\u0430 \u0430\u043a\u0440\u0430\u043f\u043b\u0435\u043d\u043d\u044f \u043a\u0440\u044b\u0432\u0451\u044e, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043a\u0440\u043e\u045e \u0410\u0431\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u0431\u0435\u0433\u043b\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f, \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u045e \u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e \u043c\u044b \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0435\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0456\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0435 \u043d\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430. \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0442\u0430\u0434\u044b \u045e\u0441\u0442\u0440\u0430\u0441\u044f\u043d\u0443\u045e \u0437\u044f\u043c\u043b\u044e, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0401\u043d \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f\u0448\u0447\u044d \u0440\u0430\u0437 \u0443\u0441\u0442\u0440\u0430\u0441\u044f\u043d\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u044f\u043c\u043b\u044e, \u0430\u043b\u0435 \u0456 \u043d\u0435\u0431\u0430&raquo;. \u0421\u043b\u043e\u0432\u044b &laquo;\u044f\u0448\u0447\u044d \u0440\u0430\u0437&raquo; \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0435, \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0435, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0442\u0440\u044b\u0432\u0430\u0439 \u0443 \u043b\u0430\u0441\u0446\u044b, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0411\u043e\u0433\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e. \u0411\u043e \u043d\u0430\u0448 \u0411\u043e\u0433 &ndash; \u0433\u044d\u0442\u0430 \u045e\u0441\u0435\u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0433\u043e\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 5, 23. 24\u0430; \u043f\u0430\u0440. \u0413\u0431\u0440 12, 22\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0433\u043e\u043b\u0430\u0441 \u0441\u044f\u0440\u043e\u0434 \u0446\u0435\u043c\u0440\u044b, \u0430 \u0433\u0430\u0440\u0430 \u0421\u0456\u043d\u0430\u0439 \u043f\u0430\u043b\u0430\u043b\u0430 \u045e \u0430\u0433\u043d\u0456, \u0432\u044b \u043f\u0430\u0434\u044b\u0448\u043b\u0456 \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443 \u0456 \u0432\u0435\u043b\u0456\u0447. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0426\u044f\u043f\u0435\u0440 \u0432\u044b \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d \u0456 \u0434\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443 \u0456 \u0432\u0435\u043b\u0456\u0447.<\/p>\r\n"}, {"GCH_CH_1_ID":"565","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">4, 14 &ndash; 5, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0421\u0432\u044f\u0442\u0430\u0440<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043d\u044f\u0431\u0451\u0441\u044b, \u0415\u0437\u0443\u0441\u0430, \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0446\u0432\u0451\u0440\u0434\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430. \u0411\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u043d\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c \u043d\u0430\u0448\u044b\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u043e\u0433\u0430, \u044f\u043a\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430, \u0437\u0432\u0435\u0434\u0430\u045e \u0443\u0441\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u0440\u044d\u0445\u0443. \u0422\u0430\u043c\u0443 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0434\u0430 \u0442\u0440\u043e\u043d\u0430 \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043b\u0430\u0441\u043a\u0443 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0447\u0430\u0441\u043e\u0432\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0437 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0411\u043e\u0436\u044b\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430\u0440\u044b \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456. \u0401\u043d \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0456 \u0431\u043b\u0443\u043a\u0430\u0435, \u0431\u043e \u0456 \u0441\u0430\u043c \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u044f\u043a \u0437\u0430 \u043d\u0430\u0440\u043e\u0434, \u0442\u0430\u043a \u0456 \u0437\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u0441\u0430\u043c \u043d\u0435 \u0431\u044f\u0440\u044d \u0441\u0430\u0431\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u043d\u0430\u0440\u0443, \u0430\u043f\u0440\u043e\u0447 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a \u0456 \u0410\u0430\u0440\u043e\u043d. \u0422\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0430\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &laquo;\u0422\u044b \u0421\u044b\u043d \u041c\u043e\u0439, \u042f \u0426\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e&raquo;; \u044f\u043a \u0456 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0434\u043d\u0456 \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0437 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0456 \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u045e\u0437\u043d\u0451\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u0431\u044b\u045e \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b \u0437\u0430 \u0441\u0432\u0430\u044e \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0425\u043e\u0446\u044c \u0431\u044b\u045e \u0421\u044b\u043d\u0430\u043c, \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e. \u0406, \u0431\u0443\u0434\u0443\u0447\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b, \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f; \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u045e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 5, 8. 9. 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0421\u044b\u043d\u0430\u043c, \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b, \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0434\u043d\u0456 \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0437 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0456 \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u045e\u0437\u043d\u0451\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0456 \u0431\u044b\u045e \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b \u0437\u0430 \u0441\u0432\u0430\u044e \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b, \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"566","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">9, 11-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u044f\u043a \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043f\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u0439\u0448\u0443\u044e \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u0443\u044e \u0441\u043a\u0456\u043d\u0456\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0456 \u043d\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u043a\u0430\u0437\u043b\u043e\u045e \u0456 \u0431\u044b\u043a\u043e\u045e, \u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0437\u0434\u0430\u0431\u044b\u045e\u0448\u044b \u0432\u0435\u0447\u043d\u0430\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e, \u043a\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u043a\u0430\u0437\u043b\u043e\u045e \u0456 \u0431\u044b\u043a\u043e\u045e, \u0456 \u043f\u043e\u043f\u0435\u043b \u044f\u043b\u0430\u045e\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u044b\u043f\u0430\u043d\u043d\u0435 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u044b\u0445, \u043a\u0430\u0431 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0442\u0430\u043b\u0430 \u0446\u0435\u043b\u0430, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u043a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0443, \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0436\u044b\u0432\u043e\u043c\u0443 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u0430\u043c\u0443 \u0401\u043d \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u0430\u0434 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e, \u0443\u0447\u044b\u043d\u0435\u043d\u044b\u0445 \u0443 \u043f\u0435\u0440\u0448\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b. \u0414\u0437\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0442\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456 \u044f\u0433\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u043b\u044c\u043d\u0456\u043a\u0430, \u0431\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043d\u0430\u0431\u044b\u0432\u0430\u0435 \u043c\u043e\u0446 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043c\u0430\u0435 \u043c\u043e\u0446\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u0436\u044b\u0432\u0435 \u044f\u0433\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u043b\u044c\u043d\u0456\u043a. \u0422\u0430\u043c\u0443 \u0456 \u043f\u0435\u0440\u0448\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043d\u0435 \u0431\u044b\u045e \u0437\u0430\u0446\u0432\u0435\u0440\u0434\u0436\u0430\u043d\u044b \u0431\u0435\u0437 \u043a\u0440\u044b\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u043a\u043e\u0436\u043d\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0451\u043d \u0443\u0437\u044f\u045e \u043a\u0440\u043e\u045e \u0446\u044f\u043b\u044f\u0442 \u0456 \u043a\u0430\u0437\u043b\u043e\u045e \u0437 \u0432\u0430\u0434\u043e\u044e, \u043f\u0443\u043d\u0441\u043e\u0432\u0443\u044e \u0432\u043e\u045e\u043d\u0443 \u0434\u044b \u0456\u0441\u043e\u043f\u0430\u043c \u0430\u043a\u0440\u0430\u043f\u0456\u045e \u0441\u0430\u043c\u0443 \u043a\u043d\u0456\u0433\u0443 \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0413\u044d\u0442\u0430 \u043a\u0440\u043e\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0411\u043e\u0433 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c&raquo;. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u043a\u0456\u043d\u0456\u044e, \u0456 \u045e\u0432\u0435\u0441\u044c \u043f\u043e\u0441\u0443\u0434 \u0434\u043b\u044f \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0430\u043a\u0440\u0430\u043f\u0456\u045e \u043a\u0440\u044b\u0432\u0451\u044e. \u0414\u044b\u0439 \u0430\u043c\u0430\u043b\u044c \u0443\u0441\u0451 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0430\u0447\u044b\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u0432\u0451\u044e, \u0430 \u0431\u0435\u0437 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u044f \u043a\u0440\u044b\u0432\u0456 \u043d\u0435 \u0431\u044b\u0432\u0430\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0431\u044b\u043b\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u0432\u043e\u0431\u0440\u0430\u0437\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0430\u0447\u044b\u0448\u0447\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043a, \u0430 \u0441\u0430\u043c\u043e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0430 \u044f\u0448\u0447\u044d \u043b\u0435\u043f\u0448\u044b\u0445 \u0430\u0445\u0432\u044f\u0440, \u0447\u044b\u043c \u0433\u044d\u0442\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u043d\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0443\u044e \u0440\u0443\u043a\u0430\u043c\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u0445, \u0430\u043b\u0435 \u045e \u0441\u0430\u043c\u043e \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440 \u0437\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430; \u0456 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0448\u043c\u0430\u0442\u0440\u0430\u0437\u043e\u0432\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u0448\u0442\u043e\u0433\u043e\u0434 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445 \u0437 \u0447\u0443\u0436\u043e\u044e \u043a\u0440\u044b\u0432\u0451\u044e, \u0431\u043e \u042f\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u043d\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0456 \u0432\u044f\u043a\u043e\u045e \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u0443 \u0441\u0432\u0430\u0451\u044e \u0430\u0445\u0432\u044f\u0440\u0430\u044e. \u0406 \u044f\u043a \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0440\u0430\u0437 \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 &ndash; \u0441\u0443\u0434, \u0442\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e\u0448\u044b \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u043f\u0430\u043d\u0435\u0441\u0446\u0456 \u0433\u0440\u0430\u0445\u0456 \u043c\u043d\u043e\u0433\u0456\u0445, \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 53, 7. 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0430\u0432\u0435\u0447\u043a\u0430, \u044f\u043a\u0443\u044e \u0432\u044f\u0434\u0443\u0446\u044c \u043d\u0430 \u0437\u0430\u0431\u043e\u0439, \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0437\u0434\u0437\u0435\u043a \u0456 \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e. \u0401\u043d \u0431\u044b\u045e \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0456 \u0431\u044b\u045e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"567","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">4, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041f\u0430\u043a\u0443\u043b\u044c \u044f\u0448\u0447\u044d \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u0430\u044f\u0446\u0446\u0430, \u043a\u0430\u0431 \u043d\u0435\u0445\u0442\u0430 \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u044f\u0433\u043e. \u0411\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0442\u0430\u043a, \u044f\u043a \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u0410\u043b\u0435 \u043f\u0430\u0447\u0443\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0456\u043c \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0431\u043e \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u045e \u0432\u0435\u0440\u044b \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0447\u0443\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043c\u044b, \u044f\u043a\u0456\u044f \u0432\u0435\u0440\u044b\u043c, \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u0406\u043c: &laquo;\u042f \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u045e \u0433\u043d\u0435\u0432\u0435 \u041c\u0430\u0456\u043c, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u041c\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a&raquo;, \u0445\u043e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043d\u044b \u0430\u0434 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443. \u0411\u043e \u0442\u0430\u043a \u043d\u0435\u0434\u0437\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c: &laquo;\u0406 \u043d\u0430 \u0441\u0451\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u045e \u0411\u043e\u0433 \u0430\u0434 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439&raquo;. \u0406 \u045e \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0437\u043d\u043e\u045e: &laquo;\u042f\u043d\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u041c\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u043c\u0443 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u044f\u0433\u043e, \u0430 \u0442\u044b\u044f, \u043a\u0430\u043c\u0443 \u0440\u0430\u043d\u0435\u0439 \u0431\u044b\u043b\u0430 \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430, \u043d\u0435 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u044f\u0433\u043e \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u0411\u043e\u0433 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u0435\u0439\u043a\u0456 \u0434\u0437\u0435\u043d\u044c, &laquo;\u0441\u0451\u043d\u043d\u044f&raquo;, \u043a\u0430\u0436\u0443\u0447\u044b, \u044f\u043a \u0440\u0430\u043d\u0435\u0439 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u043f\u0440\u0430\u0437 \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u043a\u043e\u0433\u0430 \u0434\u043e\u045e\u0433\u0430\u0433\u0430 \u0447\u0430\u0441\u0443: &laquo;\u0421\u0451\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f&raquo;. \u0411\u043e \u043a\u0430\u043b\u0456 \u0431 \u0415\u0437\u0443\u0441 \u041d\u0430\u0432\u0456\u043d \u0434\u0430\u045e \u0456\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u0451\u043d \u043d\u0435 \u043a\u0430\u0437\u0430\u045e \u0431\u044b \u043f\u0430\u0441\u043b\u044f \u043f\u0440\u0430 \u0456\u043d\u0448\u044b \u0434\u0437\u0435\u043d\u044c. \u0422\u0430\u043c\u0443 \u0448\u0430\u0431\u0430\u0442 \u0443\u0441\u0451 \u044f\u0448\u0447\u044d \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443 \u0411\u043e\u0436\u0430\u0433\u0430. \u0406 \u0445\u0442\u043e \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u042f\u0433\u043e, \u0442\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u044f\u043a \u0456 \u0411\u043e\u0433 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0433\u044d\u0442\u044b \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0436\u044b\u0432\u043e\u0435 \u0456 \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0435, \u0432\u0430\u0441\u0442\u0440\u044d\u0439\u0448\u0430\u0435 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u043c\u0435\u0447 \u0434\u0432\u0443\u0441\u0435\u0447\u043d\u044b. \u042f\u043d\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0430\u0436\u043d\u043e \u0434\u0430 \u043f\u0430\u0434\u0437\u0435\u043b\u0443 \u0434\u0443\u0448\u044b \u0456 \u0434\u0443\u0445\u0430, \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u045e \u0456 \u0448\u043f\u0456\u043a\u0443 \u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0434\u0443\u043c\u043a\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u044b \u0441\u044d\u0440\u0446\u0430. \u0406 \u043d\u044f\u043c\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u042f\u0433\u043e, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0430\u0433\u043e\u043b\u0435\u043d\u0430 \u0456 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0442\u0430\u0433\u043e, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c \u043c\u044b \u0430\u0434\u043a\u0430\u0436\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 27, 66. 60. 62<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0432\u0443\u0447\u043d\u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u041f\u0430\u043d\u0430, \u0437\u0430\u043a\u0440\u044b\u043b\u0456 \u045e\u0432\u0430\u0445\u043e\u0434 \u0443 \u043c\u0430\u0433\u0456\u043b\u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043a\u0430\u043c\u043d\u0435\u043c, \u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043b\u0456 \u044f\u0433\u043e <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u0446\u044c \u043c\u0430\u0433\u0456\u043b\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u044b \u043f\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u041f\u0456\u043b\u0430\u0442\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u044f\u0433\u043e \u0437\u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u043c\u0430\u0433\u0456\u043b\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u0446\u044c \u043c\u0430\u0433\u0456\u043b\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"601","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 18 &ndash; 2, 5<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043a\u0440\u044b\u0436<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0441\u043b\u043e\u0432\u0430 \u0430\u0431 \u043a\u0440\u044b\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u042f \u0437\u043d\u0456\u0448\u0447\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0456 \u0430\u0434\u043a\u0456\u043d\u0443 \u0440\u043e\u0437\u0443\u043c \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445&raquo;. \u0414\u0437\u0435 \u043c\u0443\u0434\u0440\u044d\u0446? \u0414\u0437\u0435 \u043a\u043d\u0456\u0436\u043d\u0456\u043a? \u0414\u0437\u0435 \u0434\u0430\u0441\u043b\u0435\u0434\u0447\u044b\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0435\u043a\u0443? \u0426\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0411\u043e\u0433 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0441\u0432\u0435\u0442\u0443 \u045e \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0451\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u0411\u043e \u044e\u0434\u044d\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0437\u043d\u0430\u043a\u0430\u045e, \u0430 \u0433\u0440\u044d\u043a\u0456 \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u041c\u044b \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e &ndash; \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u043f\u0430\u0434\u043a\u0443, \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0456 \u044e\u0434\u044d\u044f\u045e, \u0456 \u0433\u0440\u044d\u043a\u0430\u045e, \u0401\u043d &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0456 \u0411\u043e\u0436\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u0411\u043e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u045e \u0411\u043e\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0441\u043b\u0430\u0431\u043e\u0435 \u045e \u0411\u043e\u0433\u0430 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435. \u041d\u044f\u0448\u043c\u0430\u0442 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043c\u0443\u0434\u0440\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u043d\u044f\u0448\u043c\u0430\u0442 \u043c\u043e\u0446\u043d\u044b\u0445, \u043d\u044f\u0448\u043c\u0430\u0442 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u0445. \u0410\u043b\u0435 \u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u0445, \u0456 \u0441\u043b\u0430\u0431\u043e\u0435 \u0441\u0432\u0435\u0442\u0443 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u0445; \u0456 \u0431\u044f\u0437\u0440\u043e\u0434\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u0430\u0435, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430, \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0441\u043d\u0430\u0435, \u043a\u0430\u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u0456 \u0432\u044b \u0456\u0441\u043d\u0443\u0435\u0446\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435\u043c, \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u044f \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0435 \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0411\u043e \u044f \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u043d\u0435 \u0432\u0435\u0434\u0430\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u043c\u0456\u0436 \u0432\u0430\u0441, \u0430\u043f\u0440\u043e\u0447 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0442\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u0406 \u044f \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0456 \u045e \u0441\u0442\u0440\u0430\u0445\u0443, \u0456 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0456. \u0410 \u0441\u043b\u043e\u0432\u0430 \u043c\u0430\u0451 \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0430\u0451 \u043d\u0435 \u045e \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0447\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u045e \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0456 \u0434\u0443\u0445\u0430 \u0456 \u0441\u0456\u043b\u044b, \u043a\u0430\u0431 \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430\u044f \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u043b\u0430\u0441\u044f \u043d\u0435 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u043d\u0430 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 4, 18. 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043a\u0430\u043b\u044f \u0413\u0430\u043b\u0456\u043b\u0435\u0439\u0441\u043a\u0430\u0433\u0430 \u043c\u043e\u0440\u0430, \u0443\u0431\u0430\u0447\u044b\u045e \u041f\u044f\u0442\u0440\u0430 \u0456 \u0410\u043d\u0434\u0440\u044d\u044f, \u044f\u043a\u0456\u044f \u0437\u0430\u043a\u0456\u0434\u0432\u0430\u043b\u0456 \u0441\u0435\u0442\u043a\u0456 \u045e \u043c\u043e\u0440\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: <span style=\"color: #ff0000;\">*<\/span> \u0406\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u041c\u043d\u043e\u0439, \u0456 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0432\u0430\u0441 \u0440\u044b\u0431\u0430\u043a\u0430\u043c\u0456 \u043b\u044e\u0434\u0437\u0435\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u0440\u044b\u0431\u0430\u043a\u0430\u043c\u0456, \u0442\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u041c\u043d\u043e\u0439, \u0456 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0432\u0430\u0441 \u0440\u044b\u0431\u0430\u043a\u0430\u043c\u0456 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"607","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">\u0420\u044b\u043c 5, 12-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0437\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e\u0441\u044f \u0433\u0440\u044d\u0445, <\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u0442\u0430\u043c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u043b\u0430\u0441\u043a\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u042f\u043a \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0433\u0440\u044d\u0445 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 &ndash; \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0430 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u043e \u045e\u0441\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456. \u0411\u043e \u0456 \u043f\u0435\u0440\u0430\u0434 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0433\u0440\u044d\u0445 \u0431\u044b\u045e \u0443 \u0441\u0432\u0435\u0446\u0435; \u0430\u043b\u0435 \u0433\u0440\u044d\u0445 \u043d\u0435 \u0437\u0430\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u044f\u043c\u0430 \u0437\u0430\u043a\u043e\u043d\u0443. \u0410\u0434\u043d\u0430\u043a \u0441\u043c\u0435\u0440\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0430 \u0430\u0434 \u0410\u0434\u0430\u043c\u0430 \u0430\u0436 \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0443 \u0410\u0434\u0430\u043c\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0437 \u0434\u0430\u0440\u0430\u043c \u043b\u0430\u0441\u043a\u0456 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u0437 \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0430\u043c. \u0411\u043e \u043a\u0430\u043b\u0456 \u0437&shy;\u0437\u0430 \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0443 \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u043c\u043d\u043e\u0433\u0456\u044f, \u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u0430\u0434\u043d\u0430\u0433\u043e \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u0434\u0430\u0440\u0443 \u0441\u044b\u0448\u043b\u043e \u0448\u0447\u043e\u0434\u0440\u0430 \u043d\u0430 \u043c\u043d\u043e\u0433\u0456\u0445. \u0406 \u0437 \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0440\u0430\u043c \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u0437 \u0432\u044b\u043d\u0456\u043a\u0430\u043c \u0433\u0440\u0430\u0445\u0443 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0431\u043e \u0437\u0430 \u0430\u0434\u0437\u0456\u043d \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u0430\u043a &ndash; \u0441\u0443\u0434 \u0434\u043b\u044f \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f, \u0430 \u0437\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0456 &ndash; \u043b\u0430\u0441\u043a\u0430 \u0434\u043b\u044f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f. \u041a\u0430\u043b\u0456 \u0437&shy;\u0437\u0430 \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0443 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u0433\u043e, \u0442\u043e \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u043b\u0430\u0441\u043a\u0456 \u0456 \u0434\u0430\u0440\u044b \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0436\u044b\u0446\u0446\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u043c\u0443 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u0430\u043a \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c. \u0411\u043e \u044f\u043a \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430&shy;\u043b\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c\u0456, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043a\u043e\u043d \u0436\u0430 \u045e\u0432\u0430\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430. \u0410 \u0434\u0437\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e\u0441\u044f \u0433\u0440\u044d\u0445, \u0442\u0430\u043c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u043b\u0430\u0441\u043a\u0430, \u043a\u0430\u0431, \u044f\u043a \u0433\u0440\u044d\u0445 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043a \u0456 \u043b\u0430\u0441\u043a\u0430 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 5, 12; \u041b\u043a 1, 30; \u043f\u0430\u0440. \u041f\u0441 116 (114), 8; 17 (18), 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0433\u0440\u044d\u0445 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442, \u0431\u043e \u045e \u0456\u043c \u0443\u0441\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456. <span style=\"color: #ff0000;\">* <\/span>\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u041c\u0430\u0440\u044b\u044f, \u0431\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0422\u044b \u043b\u0430\u0441\u043a\u0443 \u045e \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0422\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0441\u0442\u0430\u045e \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430\u043c \u0430\u0434 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u041c\u0430\u0440\u044b\u044f, \u0431\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0422\u044b \u043b\u0430\u0441\u043a\u0443 \u045e \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"613","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0414\u0437\u0435\u044f\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">6, 8 &ndash; 7, 2\u0430; 7, 44 &ndash; 8, 1<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\"><em><span style=\"color: #ff0000;\"><\/span><\/em>\u0421\u0442\u044d\u0444\u0430\u043d, \u043f\u043e\u045e\u043d\u044b \u043b\u0430\u0441\u043a\u0456 \u0456 \u043c\u043e\u0446\u044b, \u0447\u044b\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b \u0456 \u0437\u043d\u0430\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0441\u0456\u043d\u0430\u0433\u043e\u0433\u0456, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u0430\u0439 \u043b\u0456\u0431\u0435\u0440\u0442\u044b\u043d\u0441\u043a\u0430\u0439 \u0456 \u043a\u0456\u0440\u044b\u043d\u044d\u0439\u0441\u043a\u0430\u0439, \u0456 \u0430\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0439, \u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u041a\u0456\u043b\u0456\u043a\u0456\u0456 \u0456 \u0410\u0437\u0456\u0456 \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0456 \u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0447\u0430\u0446\u0446\u0430 \u0441\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430\u043c. \u0410\u043b\u0435 \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0414\u0443\u0445\u0443, \u0437 \u044f\u043a\u0456\u043c\u0456 \u0451\u043d \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u044f\u043d\u044b \u043f\u0430\u0434\u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0442\u044b\u044f \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041c\u044b \u0447\u0443\u043b\u0456, \u044f\u043a \u0451\u043d \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0411\u043e\u0433\u0430&raquo;. \u0406 \u043f\u0430\u0434\u0431\u0443\u0445\u0442\u043e\u0440\u044b\u043b\u0456 \u043d\u0430\u0440\u043e\u0434, \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0456 \u043a\u043d\u0456\u0436\u043d\u0456\u043a\u0430\u045e, \u0456, \u043d\u0430\u043f\u0430\u045e\u0448\u044b, \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u044f\u0433\u043e, \u0456 \u043f\u0430\u0432\u044f\u043b\u0456 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u0441\u044f\u0434\u0436\u044d\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u0456\u043b\u0436\u044b\u0432\u044b\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0413\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043c\u0435\u0441\u0446\u0430 \u0456 \u0437\u0430\u043a\u043e\u043d\u0443. \u041c\u044b \u0447\u0443\u043b\u0456, \u044f\u043a \u0451\u043d \u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0415\u0437\u0443\u0441 \u0437 \u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430 \u0437\u0440\u0443\u0439\u043d\u0443\u0435 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u0456 \u0437\u043c\u0435\u043d\u0456\u0446\u044c \u0437\u0432\u044b\u0447\u0430\u0456, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0441\u0435, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u0443 \u0412\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0437\u0435, \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u044f\u0433\u043e \u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u044f\u0433\u043e\u043d\u0430\u0435, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0430\u043d\u0451\u043b\u0430. \u0422\u0430\u0434\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u0456 \u0433\u044d\u0442\u0430 \u0442\u0430\u043a?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0421\u0442\u044d\u0444\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u0440\u0430\u0442\u044b \u0456 \u0430\u0439\u0446\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435. \u0423 \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e \u0431\u044b\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0441\u043a\u0456\u043d\u0456\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u044f\u043a \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u044f\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0437\u043e\u0440\u0443, \u044f\u043a\u0456 \u0431\u0430\u0447\u044b\u045e. \u0406 \u043d\u0430\u0448\u044b\u044f \u0430\u0439\u0446\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u044f\u0435, \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u044f\u0435 \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u041d\u0430\u0432\u0456\u043d\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u0445 \u0411\u043e\u0433 \u043f\u0440\u044b\u0431\u0440\u0430\u045e \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445. \u0406 \u0442\u0430\u043a \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0436 \u0434\u0430 \u0434\u0437\u0451\u043d \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u043a\u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043b\u0430\u0441\u043a\u0443 \u045e \u0432\u0430\u0447\u0430\u0445 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430. \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0436\u0430 \u043f\u0430&not;\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u042f\u043c\u0443 \u0434\u043e\u043c. \u0410\u0434\u043d\u0430\u043a \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u043d\u0435 \u0436\u044b\u0432\u0435 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0440\u0443\u043a\u0430\u043c\u0456, \u044f\u043a \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a: &ldquo;\u041d\u0435\u0431\u0430 &ndash; \u041c\u043e\u0439 \u0442\u0440\u043e\u043d, \u0430 \u0437\u044f\u043c\u043b\u044f &ndash; \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u041c\u0430\u0456\u0445 \u043d\u043e\u0433. \u042f\u043a\u0456 \u0436 \u0434\u043e\u043c \u043f\u0430\u0431\u0443\u0434\u0443\u0435\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0430\u0431\u043e \u044f\u043a\u043e\u0435 \u043c\u0435\u0441\u0446\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u041c\u0430\u0439\u0433\u043e? \u0426\u0456 \u0436 \u043d\u0435 \u041c\u0430\u044f \u0440\u0443\u043a\u0430 \u0441\u0442\u0432\u0430\u0440\u044b\u043b\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430?&rdquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0434\u0437\u0456 \u0437 \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u043a\u0430\u0440\u043a\u0430\u043c, \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0432\u0443\u0448\u0430\u043c\u0456, \u0432\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0446\u0456\u0432\u0456\u043b\u0456\u0441\u044f \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443; \u044f\u043a \u0430\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f, \u0442\u0430\u043a \u0456 \u0432\u044b. \u041a\u0430\u0433\u043e \u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u0430\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f? \u0406 \u0437\u0430\u0431\u0456\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0437\u0434\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0437\u0430\u0431\u043e\u0439\u0446\u0430\u043c\u0456 \u044f\u043a\u043e\u0433\u0430 \u0446\u044f\u043f\u0435\u0440 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0432\u044b, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u044f\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u044f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0433\u044d\u0442\u0430, \u0437\u0430\u043f\u0430\u043b\u0430\u043b\u0456 \u0433\u043d\u0435\u0432\u0430\u043c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u0456 \u0441\u043a\u0440\u044b\u0433\u0430\u0442\u0430\u043b\u0456 \u043d\u0430 \u044f\u0433\u043e \u0437\u0443\u0431\u0430\u043c\u0456. \u0421\u0442\u044d\u0444\u0430\u043d \u0436\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u043d\u0435\u0431\u0430 \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0441\u043b\u0430\u0432\u0443 \u0411\u043e\u0436\u0443\u044e \u0456 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u043e\u0441\u044c \u0431\u0430\u0447\u0443 \u043d\u044f\u0431\u0451\u0441\u044b \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044b\u044f \u0456 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430&raquo;. \u0410\u043b\u0435 \u044f\u043d\u044b, \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e\u0448\u044b \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0437\u0430\u0442\u043a\u043d\u0443\u043b\u0456 \u0432\u0443\u0448\u044b \u0441\u0432\u0430\u0435 \u0456 \u043a\u0456\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0430 \u044f\u0433\u043e \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c. \u0406 \u0432\u044b\u0432\u0435\u045e\u0448\u044b \u0437\u0430 \u0433\u043e\u0440\u0430\u0434, \u043f\u0430\u0447\u0430\u043b\u0456 \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u0446\u044c. \u0410 \u0441\u0432\u0435\u0434\u043a\u0456 \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u0430\u0434\u0437\u0435\u0436\u0443 \u0441\u0432\u0430\u044e \u043a\u0430\u043b\u044f \u043d\u043e\u0433 \u044e\u043d\u0430\u043a\u0430, \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u0430\u043b\u0456 \u0421\u0430\u045e\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043b\u0456 \u0421\u0442\u044d\u0444\u0430\u043d\u0430, \u044f\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u043f\u0440\u044b\u043c\u0456 \u0434\u0443\u0445 \u043c\u043e\u0439&raquo;. \u0406, \u0443\u043f\u0430\u045e\u0448\u044b \u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u0456, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: &laquo;\u041f\u0430\u043d\u0435, \u043d\u0435 \u043b\u0456\u0447\u044b \u0456\u043c \u0433\u0440\u0430\u0445\u0443 \u0433\u044d\u0442\u0430\u0433\u0430&raquo;. \u0406, \u0441\u043a\u0430\u0437\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u043f\u0430\u043c\u0451\u0440. \u0410 \u0421\u0430\u045e\u043b \u0431\u044b\u045e \u0437\u0433\u043e\u0434\u043d\u044b \u0437 \u044f\u0433\u043e\u043d\u044b\u043c \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0442\u044d\u0444\u0430\u043d, \u0441\u043b\u0443\u0433\u0430 \u0411\u043e\u0436\u044b, \u044f\u043a\u043e\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043b\u0456 \u044e\u0434\u044d\u0456, \u0443\u0431\u0430\u0447\u044b\u045e \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u043d\u044f\u0431\u0451\u0441\u044b, \u0443\u0431\u0430\u0447\u044b\u045e \u0456 \u045e\u0432\u0430\u0439\u0448\u043e\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0434\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u043d\u044f\u0431\u0451\u0441\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0421\u0442\u044d\u0444\u0430\u043d \u043f\u0440\u044b\u043c\u0430\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0430\u0434 \u0433\u0440\u0430\u0434\u0430\u043c \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0443 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u043f\u0430\u043b\u0430\u0446\u0443 \u044f\u043c\u0443 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0411\u043e\u0436\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0434\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u043d\u044f\u0431\u0451\u0441\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"614","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">1, 1 &ndash; 2, 3<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0411\u043e\u0436\u0430\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0448\u0442\u043e \u043c\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u043d\u0430 \u0448\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0456 \u0434\u0430 \u0447\u0430\u0433\u043e \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456, &ndash; \u0431\u043e \u0436\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c, &ndash; \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456 \u0447\u0443\u043b\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0456 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0456 \u0432\u044b \u043c\u0435\u043b\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u043d\u0430\u043c\u0456. \u0410 \u043d\u0430\u0448\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0451\u0441\u0446\u044c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c, \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0413\u044d\u0442\u0430 \u043f\u0456\u0448\u0430\u043c \u043c\u044b, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439. \u041d\u0430\u0432\u0456\u043d\u0443, \u044f\u043a\u0443\u044e \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0421\u0432\u044f\u0442\u043b\u043e \u0456 \u043d\u044f\u043c\u0430 \u045e \u0406\u043c \u043d\u0456\u044f\u043a\u0430\u0439 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043c\u0430\u0435\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0406\u043c, \u0430 \u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0442\u043e \u043c\u044b \u0445\u043b\u0443\u0441\u0456\u043c \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043d\u0435 \u043f\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a \u0401\u043d \u0451\u0441\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u0442\u043e \u043c\u0430\u0435\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e, \u0456 \u043a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430, \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443, \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0456 \u043d\u044f\u043c\u0430 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u045e\u0434\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0401\u043d, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456 \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u0442\u043e \u0440\u043e\u0431\u0456\u043c \u042f\u0433\u043e \u0456\u043b\u0433\u0443\u043d\u043e\u043c, \u0456 \u043d\u044f\u043c\u0430 \u045e \u043d\u0430\u0441 \u0441\u043b\u043e\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u0433\u044d\u0442\u0430 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0442\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430. \u0401\u043d \u0451\u0441\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430 \u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 1, 2. 4; \u042f\u043d 20, 31<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c; \u043f\u0456\u0448\u0430\u043c \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u0432\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0436 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0451\u0441\u0446\u044c \u041c\u0435\u0441\u0456\u044f, \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u0456 \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0432\u044b \u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u045e \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"615","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443&nbsp;<span style=\"color: #ff0000;\">1, 8-16. 22<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0417\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430 \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0456\u0445 \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u045e \u0443 \u0415\u0433\u0456\u043f\u0446\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041d\u0430\u0434 \u0415\u0433\u0456\u043f\u0442\u0430\u043c \u043f\u0430\u0447\u0430\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u043e\u0432\u044b \u043a\u0430\u0440\u043e\u043b\u044c, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u042e\u0437\u0430\u0444\u0430. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u043c\u0443: &laquo;\u0412\u043e\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0437\u0430 \u043d\u0430\u0441. \u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u043c \u0437 \u0456\u043c \u043c\u0443\u0434\u0440\u0430, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u045e\u0441\u044f. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0439\u043d\u0430, \u0451\u043d \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0448\u044b\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u0448\u0430\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u043f\u0430\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044f\u045e, \u043a\u0430\u0431 \u0442\u044b\u044f \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u0456 \u044f\u0433\u043e \u0446\u044f\u0436\u043a\u0456\u043c\u0456 \u043f\u0440\u0430\u0446\u0430\u043c\u0456. \u0406 \u0451\u043d \u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0433\u0430\u0440\u0430\u0434\u044b \u0434\u043b\u044f \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430\u045e &ndash; \u041f\u0456\u0442\u043e\u043c \u0456 \u0420\u0430\u043c\u0437\u044d\u0441. \u0410\u043b\u0435 \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u0456, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0451\u043d \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u045e\u0441\u044f \u0456 \u0440\u043e\u0441. \u0422\u0430\u043c\u0443 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u0442\u0430\u043c\u0443 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0456 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c. \u0420\u0430\u0431\u0456\u043b\u0456 \u0456\u0445 \u0436\u044b\u0446\u0446\u0451 \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u043d\u044b\u043c \u0430\u0434 \u0446\u044f\u0436\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u044b \u0437 \u0433\u043b\u0456\u043d\u0430\u0439 \u0456 \u0437 \u0446\u044d\u0433\u043b\u0430\u0439, \u0456 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u043d\u0430 \u043f\u043e\u043b\u0456, \u0456 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u044f\u043a\u0443\u044e \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0456 \u0456\u0445 \u0440\u0430\u0431\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043a\u0430\u0440\u043e\u043b\u044c \u0415\u0433\u0456\u043f\u0442\u0430 \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0456\u043c \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0430\u043c, \u0437 \u044f\u043a\u0456\u0445 \u0430\u0434\u043d\u0443 \u0437\u0432\u0430\u043b\u0456 \u0428\u044b\u0444\u0440\u0430, \u0430 \u0434\u0440\u0443\u0433\u0443\u044e &ndash; \u041f\u0443\u0430, \u043a\u0430\u0436\u0443\u0447\u044b \u0456\u043c: &laquo;\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0430\u0432\u0456\u0442\u0443\u0445\u0430\u043c\u0456 \u045e \u0433\u0430\u0431\u0440\u044d\u0435\u043a \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u043f\u0440\u044b \u0440\u043e\u0434\u0430\u0445, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0445\u043b\u043e\u043f\u0435\u0446, \u0437\u0430\u0431\u0456\u0432\u0430\u0439\u0446\u0435 \u044f\u0433\u043e, \u0430 \u043a\u0430\u043b\u0456 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430 &ndash; \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0436\u044b\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0444\u0430\u0440\u0430\u043e\u043d \u0443\u0441\u044f\u043c\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u044b\u043d\u0430, \u044f\u043a\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u045e \u041d\u0456\u043b, \u0430 \u045e\u0441\u0456\u0445 \u0434\u0437\u044f\u045e\u0447\u0430\u0442 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0436\u044b\u0432\u044b\u043c\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 65, 19; \u0410\u043f 21, 4. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c \u0447\u0443\u0442\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u043f\u043b\u0430\u0447\u0443 \u0456 \u0433\u043e\u043b\u0430\u0441 \u043a\u0440\u044b\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u0456 \u0441\u043c\u0443\u0442\u043a\u0443, \u043d\u0456 \u043f\u043b\u0430\u0447\u0443, \u043d\u0456 \u0431\u043e\u043b\u044e. \u0412\u043e\u0441\u044c \u0447\u044b\u043d\u044e \u045e\u0441\u0451 \u043d\u043e\u0432\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c \u0447\u0443\u0442\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u043f\u043b\u0430\u0447\u0443 \u0456 \u0433\u043e\u043b\u0430\u0441 \u043a\u0440\u044b\u043a\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"627","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 11-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u0443\u0432\u0430 \u043c\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u044f \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u0435\u0434\u0447\u0443 \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e, \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0411\u043e \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0412\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u043c\u0430\u0451 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u044e\u0434\u0430\u0456\u0437\u043c\u0435, \u044f\u043a \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u044f \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b \u0456 \u043d\u0456\u0448\u0447\u044b\u045e \u044f\u0433\u043e, \u044f\u043a \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u045e \u0443 \u044e\u0434\u0430\u0456\u0437\u043c\u0435 \u043c\u043d\u043e\u0433\u0456\u0445 \u0430\u0434\u043d\u0430\u0433\u043e\u0434\u043a\u0430\u045e \u0437 \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0437\u0430\u0446\u044f\u0442\u044b\u043c \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0439 \u043c\u0430\u0456\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0436 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043b\u0430\u0441\u043a\u0430\u044e \u0441\u0432\u0430\u0451\u044e, \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u044f \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f \u043d\u0435 \u043f\u0430\u0447\u0430\u045e \u0430\u0434\u0440\u0430\u0437\u0443 \u0440\u0430\u0456\u0446\u0446\u0430 \u0437 \u0446\u0435\u043b\u0430\u043c \u0456 \u043a\u0440\u044b\u0432\u0451\u044e \u0456 \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0434\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043c\u0430\u0456\u0445 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0410\u0440\u0430\u0431\u0456\u044e \u0456 \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0414\u0430\u043c\u0430\u0441\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f, \u043f\u0440\u0430\u0437 \u0442\u0440\u044b \u0433\u0430\u0434\u044b, \u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u041a\u0435\u0444\u0430\u0441\u0430 \u0456 \u043f\u0440\u0430\u0431\u044b\u045e \u0443 \u044f\u0433\u043e \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0434\u0437\u0451\u043d. \u041d\u0456\u043a\u043e\u0433\u0430 \u0436 \u0456\u043d\u0448\u0430\u0433\u0430 \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u044f \u043d\u0435 \u0431\u0430\u0447\u044b\u045e, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u043a\u0443\u0431\u0430, \u0431\u0440\u0430\u0442\u0430 \u041f\u0430\u043d\u0430. \u0423 \u0442\u044b\u043c, \u0448\u0442\u043e \u044f \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u0411\u043e\u0433 \u043c\u043d\u0435 \u0441\u0432\u0435\u0434\u043a\u0430, \u043d\u044f\u043c\u0430 \u043c\u0430\u043d\u044b. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0434\u044b\u0448\u043e\u045e \u044f \u045e \u0437\u0435\u043c\u043b\u0456 \u0421\u0456\u0440\u044b\u0456 \u0456 \u041a\u0456\u043b\u0456\u043a\u0456\u0456. \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0443 \u042e\u0434\u044d\u0456 \u044f \u043d\u0435 \u0431\u044b\u045e \u0432\u044f\u0434\u043e\u043c\u044b \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430, \u044f\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0456\u0445 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0435\u043c, \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435 \u0432\u0435\u0440\u0443, \u044f\u043a\u0443\u044e \u043d\u0435\u043a\u0430\u043b\u0456 \u043d\u0456\u0448\u0447\u044b\u045e. \u0406 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0411\u043e\u0433\u0430 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 1, 11b. 12; 2 \u041a\u0430\u0440 11, 10\u0430. 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e, \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u0441\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u044f, \u0431\u043e \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"634","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443&nbsp;<span style=\"color: #ff0000;\">13, 1-3\u0430. 11-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><em>\u041f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430<\/em><\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0430\u0441\u0432\u044f\u0446\u0456 \u041c\u043d\u0435 \u045e\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435. \u0421\u044f\u0440\u043e\u0434 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u041c\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 &ndash; \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0442\u0430\u043a \u0456 \u0436\u044b\u0432\u0451\u043b\u0430, \u0431\u043e \u045e\u0441\u0451 \u041c\u0430\u0451&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0446\u044f\u0431\u0435 \u045e \u0437\u044f\u043c\u043b\u044e \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430\u045e, \u044f\u043a \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0442\u0430\u0431\u0435 \u0456 \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c, \u0456 \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0442\u0430\u0431\u0435 \u044f\u0435, \u0442\u0430\u0434\u044b \u0430\u0434\u0434\u0430\u0441\u0456 \u041f\u0430\u043d\u0443 \u045e\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0456 \u043a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043f\u043b\u043e\u0434 \u0431\u044b\u0434\u043b\u0430 \u0442\u0432\u0430\u0439\u0433\u043e. \u0423\u0441\u0451, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0434\u043b\u044f \u041f\u0430\u043d\u0430. \u041a\u043e\u0436\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0430\u0441\u043b\u044f\u043d\u044f \u0437\u0430\u043c\u0435\u043d\u0456\u0448 \u043d\u0430 \u044f\u0433\u043d\u044f, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0432\u044b\u043a\u0443\u043f\u0456\u0448 \u044f\u0433\u043e, \u0437\u043b\u0430\u043c\u0456 \u044f\u043c\u0443 \u043a\u0430\u0440\u0430\u043a. \u0406 \u043a\u043e\u0436\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u044f \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u043a\u0443\u043f\u043b\u044f\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0441\u044b\u043d \u0442\u0432\u043e\u0439 \u0441\u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u044f\u0431\u0435: &ldquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c?&rdquo;, \u0430\u0434\u043a\u0430\u0436\u0430\u0448 \u044f\u043c\u0443: &ldquo;\u041f\u0430\u043d \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456. \u0410 \u043a\u0430\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d \u0441\u0442\u0430\u045e \u0443\u043f\u0430\u0440\u0442\u044b\u043c \u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u043d\u0430\u0441, \u0442\u043e \u041f\u0430\u043d \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439, \u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0431\u044b\u0434\u043b\u0430. \u0422\u0430\u043c\u0443 \u044f \u043f\u0440\u044b\u043d\u043e\u0448\u0443 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u041f\u0430\u043d\u0443 \u045e\u0441\u0451 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u0443, \u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0441\u044b\u043d\u043e\u045e \u043c\u0430\u0456\u0445 \u0432\u044b\u043a\u0443\u043f\u043b\u044f\u044e&rdquo;. \u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u044f\u043a \u0437\u043d\u0430\u043a \u043d\u0430 \u0440\u0443\u0446\u044d \u0456 \u044f\u043a \u0430\u0437\u0434\u043e\u0431\u0430 \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u0447\u044d\u0439, \u0448\u0442\u043e \u041f\u0430\u043d \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439 \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 2, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0442\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0421\u0456\u0451\u043d\u0435, \u0456 \u043f\u0440\u044b\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u041a\u0430\u0440\u0430\u043b\u044f, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u043e\u0433\u0430 \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u0430\u043b\u0430, \u0414\u0437\u0435\u0432\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0456, \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u042f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0456\u043c\u044f\u043e\u043d \u0443\u0437\u044f\u045e \u0414\u0437\u0456\u0446\u044f \u043d\u0430 \u0440\u0443\u043a\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u043e\u0433\u0430 \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u0430\u043b\u0430, \u0414\u0437\u0435\u0432\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0456, \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u042f\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"645","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">11, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><em>\u041f\u0451\u0442\u0440 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0435 \u043f\u0440\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e<\/em><\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0456 \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u042e\u0434\u044d\u0456, \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. \u041a\u0430\u043b\u0456 \u041f\u0451\u0442\u0440 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u0434\u0430\u043a\u0430\u0440\u0430\u043b\u0456 \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0430 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 \u0442\u044b \u0445\u0430\u0434\u0437\u0456\u045e \u0456 \u0435\u045e \u0437 \u0456\u043c\u0456!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0451\u0442\u0440 \u043f\u0430\u0447\u0430\u045e \u0456\u043c \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043f\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u0431\u044b\u045e \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u042f\u0444\u0435 \u0456 \u043c\u0430\u043b\u0456\u045e\u0441\u044f. \u0406 \u045e \u0432\u0456\u0437\u0456\u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435: \u043d\u0435\u0439\u043a\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435, \u043d\u0456\u0431\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u043f\u0430\u043b\u0430\u0442\u043d\u043e, \u0447\u0430\u0442\u044b\u0440\u043c\u0430 \u043a\u0430\u043d\u0446\u0430\u043c\u0456 \u0441\u043f\u0443\u0441\u043a\u0430\u043b\u0430\u0441\u044f \u0437 \u043d\u0435\u0431\u0430. \u0406 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0430\u0441\u044f \u0430\u0436 \u0434\u0430 \u043c\u044f\u043d\u0435. \u042f \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0435\u045e\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0447\u0430\u0446\u0432\u0435\u0440\u0430\u043d\u043e\u0433\u0456\u0445 \u0437\u044f\u043c\u043d\u044b\u0445 \u0437\u0432\u044f\u0440\u043e\u045e, \u043f\u0430\u045e\u0437\u0443\u043d\u043e\u045e \u0456 \u043f\u0442\u0443\u0448\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445. \u0406 \u043f\u0430\u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u0423\u0441\u0442\u0430\u0432\u0430\u0439, \u041f\u0451\u0442\u0440, \u0437\u0430\u0431\u0456\u0432\u0430\u0439 \u0434\u044b \u0435\u0448!&rdquo; \u0410\u043b\u0435 \u044f \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u041d\u0456 \u045e \u044f\u043a\u0456\u043c \u0440\u0430\u0437\u0435, \u041f\u0430\u043d\u0435, \u0431\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0456\u0448\u0442\u043e \u0430\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0430\u0435 \u0446\u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u043d\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u045e \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u0435!&rdquo; \u0413\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &ldquo;\u0428\u0442\u043e \u0411\u043e\u0433 \u0430\u0447\u044b\u0441\u0446\u0456\u045e, \u0442\u0430\u0433\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0439 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c&rdquo;. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0442\u0440\u043e\u0439\u0447\u044b, \u0456 \u0437\u043d\u043e\u045e \u0443\u0441\u0451 \u0431\u044b\u043b\u043e \u0437\u0430\u0431\u0440\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0430. \u0406 \u0432\u043e\u0441\u044c, \u0443 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0442\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0456, \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0434\u0430 \u043c\u044f\u043d\u0435 \u0437 \u0426\u044d\u0437\u0430\u0440\u044d\u0456, \u0437&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043a\u0430\u043b\u044f \u0434\u043e\u043c\u0443, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u0431\u044b\u043b\u0456. \u0414\u0443\u0445 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0456\u0441\u0446\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e. \u041f\u0430\u0439\u0448\u043b\u0456 \u0441\u0430 \u043c\u043d\u043e\u044e \u0456 \u0433\u044d\u0442\u044b\u044f \u0448\u044d\u0441\u0446\u044c \u0431\u0440\u0430\u0442\u043e\u045e. \u0406 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u043c\u044b \u045e \u0434\u043e\u043c \u0442\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0401\u043d \u043d\u0430\u043c \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &ldquo;\u041f\u0430\u0448\u043b\u0456 \u045e \u042f\u0444\u0443 \u0456 \u043f\u0430\u043a\u043b\u0456\u0447 \u0421\u044b\u043c\u043e\u043d\u0430, \u044f\u043a\u043e\u0433\u0430 \u0437\u0430\u0432\u0443\u0446\u044c \u041f\u0451\u0442\u0440. \u0401\u043d \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u0437\u0431\u0430\u0432\u0456\u0448\u0441\u044f \u0442\u044b \u0456 \u045e\u0432\u0435\u0441\u044c \u0442\u0432\u043e\u0439 \u0434\u043e\u043c&rdquo;. \u0410 \u043a\u0430\u043b\u0456 \u044f \u043f\u0430\u0447\u0430\u045e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c, \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u0456\u0445 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a \u0456 \u043d\u0430 \u043d\u0430\u0441 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0422\u0430\u0434\u044b \u044f \u045e\u0441\u043f\u043e\u043c\u043d\u0456\u045e \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a \u0401\u043d \u043a\u0430\u0437\u0430\u045e: &ldquo;\u042f\u043d \u0445\u0440\u044b\u0441\u0446\u0456\u045e \u0432\u0430\u0434\u043e\u044e, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c&rdquo;. \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0434\u0430\u045e \u0456\u043c \u0442\u0430\u043a\u0456 \u0441\u0430\u043c\u044b \u0434\u0430\u0440, \u044f\u043a \u0456 \u043d\u0430\u043c, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e \u0445\u0442\u043e \u044f \u0442\u0430\u043a\u0456, \u043a\u0430\u0431 \u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0443?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u043b\u0456 \u0433\u044d\u0442\u0430, \u0441\u0443\u043f\u0430\u043a\u043e\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u0411\u043e\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u043e\u0441\u044c \u0436\u0430 \u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c \u0434\u0430\u045e \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 22, 32; \u041c\u0446 16, 17b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0437\u0430 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0456\u043a\u043b\u0430 \u0442\u0432\u0430\u044f \u0432\u0435\u0440\u0430; <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0442\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f, \u0443\u043c\u0430\u0446\u0443\u0439 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u043e\u045e \u0430\u0434\u043a\u0440\u044b\u043b\u0456 \u0442\u0430\u0431\u0435 \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0442\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f, \u0443\u043c\u0430\u0446\u0443\u0439 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"655","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 1-7. 11-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u0434\u0437\u0456\u043d \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0437 \u0443\u0441\u0451\u044e \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0437 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u0410\u0434\u0437\u0456\u043d \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0456\u0445, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441. \u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0430\u0434\u043d\u044b\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0434\u0440\u0443\u0433\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430 \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0445\u0456\u0441\u0442\u0430\u0435 \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0446\u0435\u0440 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c \u043b\u044e\u0434\u0441\u043a\u0456\u043c, \u0445\u0456\u0442\u0440\u044b\u043c \u0448\u0442\u0443\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0435\u0441\u0446\u0456 \u045e \u0437\u043c\u0430\u043d. \u0410\u043b\u0435, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0443\u0441\u0451 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, &ndash; \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0417 \u042f\u0433\u043e \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0456 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0440\u043e\u0437\u043d\u044b\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u044f \u0441\u0443\u0432\u044f\u0437\u0456, \u0443 \u043c\u0435\u0440\u0443 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u043d\u0430\u0439 \u0447\u0430\u0441\u0442\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0446\u0435\u043b\u0430 \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0456 \u0441\u0432\u0435\u0434\u0447\u0443 \u045e \u041f\u0430\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u044b\u043b\u0456, \u044f\u043a \u0436\u044b\u0432\u0443\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u0437 \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u043c \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u0456\u0445, \u043f\u0440\u0430\u0437 \u0443\u043f\u0430\u0440\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430\u045e \u0456\u0445\u043d\u0456\u0445. \u042f\u043d\u044b, \u0441\u0442\u0430\u045e\u0448\u044b \u043d\u044f\u0447\u0443\u043b\u044b\u043c\u0456, \u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435, \u0440\u043e\u0431\u044f\u0447\u044b \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0433\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u042f\u0433\u043e \u0456 \u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u045e \u0406\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0415\u0437\u0443\u0441\u0435, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0448\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0437\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u043c\u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u043c\u0456; \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0434\u0443\u0445 \u0432\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0433\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 10; \u042d\u0444 4, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0432\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0440\u0430\u0441\u043a\u043e\u043b\u0443, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u0432\u044b \u045e \u0430\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u0443 \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0441\u0442\u0432\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0456 \u0441\u0432\u0435\u0434\u0447\u0443 \u045e \u041f\u0430\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u044b\u043b\u0456, \u044f\u043a \u0436\u044b\u0432\u0443\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0440\u0430\u0441\u043a\u043e\u043b\u0443, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u0432\u044b \u045e \u0430\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u0443 \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0441\u0442\u0432\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"663","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0441\u043d\u044f \u043f\u0435\u0441\u043d\u044f\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">2, 8-14; 8, 6-7<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0439\u0441\u0446\u0435 \u043a\u0430\u0445\u0430\u043d\u0430\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u043b\u0430\u0441 \u043a\u0430\u0445\u0430\u043d\u0430\u0433\u0430 \u043c\u0430\u0439\u0433\u043e! \u0412\u043e\u0441\u044c \u0451\u043d \u0456\u0434\u0437\u0435, \u0441\u043a\u0430\u0447\u0430 \u043f\u0430 \u0433\u0430\u0440\u0430\u0445, \u043f\u0435\u0440\u0430\u0441\u043a\u043e\u043a\u0432\u0430\u0435 \u043f\u0430\u0433\u043e\u0440\u043a\u0456. \u041b\u044e\u0431\u044b \u043c\u043e\u0439 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0441\u0430\u0440\u043d\u044b, \u0434\u0430 \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u0430\u043b\u0435\u043d\u044f. \u0412\u043e\u0441\u044c \u0451\u043d \u0441\u0442\u0430\u0456\u0446\u044c \u0437\u0430 \u043d\u0430\u0448\u0430\u0439 \u0441\u0446\u044f\u043d\u043e\u044e, \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u043a\u043d\u043e, \u0437\u0430\u0433\u043b\u044f\u0434\u0432\u0430\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u0430\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0433\u0443\u043a\u043d\u0443\u045e\u0441\u044f \u043a\u0430\u0445\u0430\u043d\u044b \u043c\u043e\u0439 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u043b\u044e\u0431\u0430\u044f \u043c\u0430\u044f, \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f \u043c\u0430\u044f, \u0456 \u0432\u044b\u0439\u0434\u0437\u0456! \u0412\u043e\u0441\u044c \u0437\u0456\u043c\u0430 \u045e\u0436\u043e \u043c\u0456\u043d\u0443\u043b\u0430; \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u0434\u043e\u0436\u0434\u0436 \u0456 \u0441\u0446\u0456\u0445. \u041a\u0432\u0435\u0442\u043a\u0456 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456; \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0447\u0430\u0441 \u0441\u043f\u0435\u0432\u0430\u045e, \u0456 \u0433\u043e\u043b\u0430\u0441 \u0433\u0430\u043b\u0443\u0431\u043a\u0456 \u0447\u0443\u0442\u043d\u044b \u045e \u043d\u0430\u0448\u0430\u0439 \u043a\u0440\u0430\u0456\u043d\u0435. \u0421\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u0430 \u045e\u0436\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u043e\u043a\u0430\u043c \u0441\u0432\u0430\u0435 \u043f\u043b\u0430\u0434\u044b, \u0456 \u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0447\u044b\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b\u044f \u043b\u043e\u0437\u044b \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u043f\u0430\u0445\u043d\u0443\u0446\u044c. \u0423\u0441\u0442\u0430\u043d\u044c, \u043a\u0430\u0445\u0430\u043d\u0430\u044f \u043c\u0430\u044f, \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f \u043c\u0430\u044f, \u0456 \u0432\u044b\u0439\u0434\u0437\u0456! \u0413\u0430\u043b\u0443\u0431\u043a\u0430 \u043c\u0430\u044f, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u045e \u0440\u0430\u0441\u043a\u043e\u043b\u0456\u043d\u0435 \u0441\u043a\u0430\u043b\u044b, \u043f\u0430\u0434 \u0430\u0445\u043e\u0432\u0430\u044e \u045e\u0446\u0451\u0441\u0430, \u043f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0451, \u0434\u0430\u0439 \u043c\u043d\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u0442\u0432\u043e\u0439, \u0431\u043e \u0433\u043e\u043b\u0430\u0441 \u0442\u0432\u043e\u0439 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0442\u0432\u0430\u0451 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u0430\u045e \u043c\u044f\u043d\u0435, \u044f\u043a \u043f\u044f\u0447\u0430\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u044f\u043a \u043f\u044f\u0447\u0430\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443, \u0431\u043e \u043a\u0430\u0445\u0430\u043d\u043d\u0435 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435, \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c, \u0440\u044d\u045e\u043d\u0430\u0441\u0446\u044c \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430\u044f, \u044f\u043a \u0430\u0434\u0445\u043b\u0430\u043d\u044c. \u042f\u0433\u043e \u043f\u043e\u043b\u044b\u043c\u044f &ndash; \u0433\u044d\u0442\u0430 \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e, \u044f\u043a \u0411\u043e\u0436\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u044f. \u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u043a\u0430\u0445\u0430\u043d\u043d\u044f, \u0456 \u0440\u044d\u043a\u0456 \u043d\u0435 \u0437\u0430\u0442\u043e\u043f\u044f\u0446\u044c \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0431 \u0445\u0442\u043e \u045e\u0437\u0430\u043c\u0435\u043d \u0437\u0430 \u043a\u0430\u0445\u0430\u043d\u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u0443\u0441\u0451 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443, \u0456\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 41b-43. 44<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0430 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e; <span style=\"color: #ff0000;\">*<\/span> \u0430\u0434\u043a\u0443\u043b\u044c \u043c\u043d\u0435 \u0433\u044d\u0442\u0430, \u0448\u0442\u043e \u041c\u0430\u0446\u0456 \u041f\u0430\u043d\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435?<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0437\u0430\u0433\u0443\u0447\u0430\u045e \u0443 \u0432\u0443\u0448\u0430\u0445 \u043c\u0430\u0456\u0445, \u0443\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u043b\u0430\u0441\u044f \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0434\u0437\u0456\u0446\u044f\u0442\u043a\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u043a\u0443\u043b\u044c \u043c\u043d\u0435 \u0433\u044d\u0442\u0430, \u0448\u0442\u043e \u041c\u0430\u0446\u0456 \u041f\u0430\u043d\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435?<\/p>\r\n"}, {"GCH_CH_1_ID":"678","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456&nbsp;<span style=\"color: #ff0000;\">1, 4-10. 17-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">C\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u041f\u0430\u043d \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0420\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456, \u042f \u043f\u0430\u0437\u043d\u0430\u045e \u0446\u044f\u0431\u0435, \u0456 \u0440\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f, \u042f \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0446\u044f\u0431\u0435, \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f: &laquo;\u041e \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u044f \u043d\u0435 \u045e\u043c\u0435\u044e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0431\u043e \u044f \u044f\u0448\u0447\u044d \u0434\u0437\u0456\u0446\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u041d\u0435 \u043a\u0430\u0436\u044b &ldquo;\u044f \u0434\u0437\u0456\u0446\u044f&rdquo;, \u0431\u043e \u0434\u0430 \u045e\u0441\u0456\u0445, \u0434\u0430 \u043a\u0430\u0433\u043e \u042f \u043f\u0430\u0448\u043b\u044e \u0446\u044f\u0431\u0435, \u043f\u043e\u0439\u0434\u0437\u0435\u0448, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u0442\u0430\u0431\u0435, \u0441\u043a\u0430\u0436\u0430\u0448. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445, \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0430\u0431 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435&raquo;, &ndash; \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u041f\u0430\u043d \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u0456 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0432\u0443\u0441\u043d\u0430\u045e \u043c\u0430\u0456\u0445, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u041f\u0430\u043d: &laquo;\u0412\u043e\u0441\u044c \u042f \u045e\u043a\u043b\u0430\u045e \u0441\u043b\u043e\u0432\u044b \u041c\u0430\u0435 \u045e \u0432\u0443\u0441\u043d\u044b \u0442\u0432\u0430\u0435. \u0413\u043b\u044f\u0434\u0437\u0456, \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b\u0440\u044b\u0432\u0430\u0446\u044c \u0456 \u0431\u0443\u0440\u044b\u0446\u044c, \u0437\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u0456 \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u0446\u044c, \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0456 \u0441\u0430\u0434\u0437\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0436\u0430\u0448 \u0441\u0432\u0430\u0435 \u0441\u0446\u0451\u0433\u043d\u044b, \u0443\u0441\u0442\u0430\u043d\u0435\u0448 \u0456 \u0441\u043a\u0430\u0436\u0430\u0448 \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0442\u0430\u0431\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u044e. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0456\u0445, \u0456\u043d\u0430\u043a\u0448 \u042f \u043d\u0430\u043f\u043e\u045e\u043d\u044e \u0446\u044f\u0431\u0435 \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456. \u0412\u043e\u0441\u044c \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0446\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0430\u043c, \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u043e\u043c \u0456 \u043c\u0435\u0434\u043d\u044b\u043c\u0456 \u043c\u0443\u0440\u0430\u043c\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e \u0456\u0445\u043d\u0456\u0445, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u0446\u044f\u0431\u0435, \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u043a\u0430\u0431 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0415\u0440 1, 5. 9b-10a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0446\u044f\u0431\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456, \u042f \u043f\u0430\u0437\u043d\u0430\u045e \u0446\u044f\u0431\u0435; \u0440\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u0442\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f, \u042f \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0446\u044f\u0431\u0435,<span style=\"color: #ff0000;\">*<\/span> \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u042f \u045e\u043a\u043b\u0430\u045e \u0441\u043b\u043e\u0432\u044b \u041c\u0430\u0435 \u045e \u0432\u0443\u0441\u043d\u044b \u0442\u0432\u0430\u0435, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"681","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 15 &ndash; 2, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u0443\u0441\u0442\u0440\u044d\u0447\u0430 \u041f\u044f\u0442\u0440\u0430 \u0456 \u041f\u0430\u045e\u043b\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u0436 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u043c\u0430\u0446\u0456 \u043c\u0430\u0451\u0439 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043b\u0430\u0441\u043a\u0430\u044e \u0441\u0432\u0430\u0451\u044e, \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u044f \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f \u043d\u0435 \u043f\u0430\u0447\u0430\u045e \u0430\u0434\u0440\u0430\u0437\u0443 \u0440\u0430\u0456\u0446\u0446\u0430 \u0437 \u0446\u0435\u043b\u0430\u043c \u0456 \u043a\u0440\u044b\u0432\u0451\u044e \u0456 \u043d\u0435 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0434\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043c\u0430\u0456\u0445 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0410\u0440\u0430\u0431\u0456\u044e \u0456 \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0414\u0430\u043c\u0430\u0441\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f, \u043f\u0440\u0430\u0437 \u0442\u0440\u044b \u0433\u0430\u0434\u044b, \u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u041a\u0435\u0444\u0430\u0441\u0430 \u0456 \u043f\u0440\u0430\u0431\u044b\u045e \u0443 \u044f\u0433\u043e \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0434\u0437\u0451\u043d. \u041d\u0456\u043a\u043e\u0433\u0430 \u0436 \u0456\u043d\u0448\u0430\u0433\u0430 \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u044f \u043d\u0435 \u0431\u0430\u0447\u044b\u045e, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u043a\u0443\u0431\u0430, \u0431\u0440\u0430\u0442\u0430 \u041f\u0430\u043d\u0430. \u0423 \u0442\u044b\u043c, \u0448\u0442\u043e \u044f \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u0411\u043e\u0433 \u043c\u043d\u0435 \u0441\u0432\u0435\u0434\u043a\u0430, \u043d\u044f\u043c\u0430 \u043c\u0430\u043d\u044b. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0434\u044b\u0448\u043e\u045e \u044f \u045e \u0437\u0435\u043c\u043b\u0456 \u0421\u0456\u0440\u044b\u0456 \u0456 \u041a\u0456\u043b\u0456\u043a\u0456\u0456. \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0443 \u042e\u0434\u044d\u0456 \u044f \u043d\u0435 \u0431\u044b\u045e \u0432\u044f\u0434\u043e\u043c\u044b \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430, \u044f\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0456\u0445 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0435\u043c, \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435 \u0432\u0435\u0440\u0443, \u044f\u043a\u0443\u044e \u043d\u0435\u043a\u0430\u043b\u0456 \u043d\u0456\u0448\u0447\u044b\u045e. \u0406 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0411\u043e\u0433\u0430 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c, \u043f\u0440\u0430\u0437 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u044f \u0437\u043d\u043e\u045e \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0437 \u0411\u0430\u0440\u043d\u0430\u0431\u0430\u043c, \u0443\u0437\u044f\u045e\u0448\u044b \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u0426\u0456\u0442\u0430. \u0410 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u044f \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f. \u0406 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u045e \u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c; \u0430\u0441\u043e\u0431\u043d\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f \u0431\u0435\u0433\u0430\u044e \u0446\u0456 \u0431\u0435\u0433\u0430\u045e \u0434\u0430\u0440\u044d\u043c\u043d\u0430. \u0410\u043b\u0435 \u043d\u0430\u0432\u0430\u0442 \u0426\u0456\u0442, \u0448\u0442\u043e \u0431\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0433\u0440\u044d\u043a\u0430\u043c, \u043d\u0435 \u0431\u044b\u045e \u0437\u043c\u0443\u0448\u0430\u043d\u044b \u0434\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f. \u0424\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c \u0436\u0430 \u0431\u0440\u0430\u0442\u0430\u043c, \u044f\u043a\u0456\u044f \u0437\u0430\u043a\u0440\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u043f\u0430\u0440\u0443\u0448\u044b\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u043d\u0430\u0448\u0443\u044e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u043c \u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u043a\u0430\u0431 \u043c\u044b \u0442\u0440\u0430\u043f\u0456\u043b\u0456 \u0437\u043d\u043e\u045e \u0443 \u043d\u044f\u0432\u043e\u043b\u044e, \u043c\u044b \u043d\u0435 \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u043d\u0456 \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443, \u043a\u0430\u0431 \u043f\u0440\u0430\u045e\u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, &ndash; \u0430 \u043a\u0456\u043c \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456, \u043c\u044f\u043d\u0435 \u043d\u0435 \u0446\u0456\u043a\u0430\u0432\u0456\u0446\u044c, \u0431\u043e \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u0411\u043e\u0433 \u043d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, &ndash; \u0434\u044b\u043a \u0442\u044b\u044f, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0443, \u043c\u043d\u0435 \u043d\u0435 \u043f\u044f\u0440\u044d\u0447\u044b\u043b\u0456. \u0410\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u043c\u043d\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u044f\u043a \u041f\u044f\u0442\u0440\u0443 &ndash; \u0441\u044f\u0440\u043e\u0434 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 (\u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u041f\u044f\u0442\u0440\u0443 \u045e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0435 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u0456 \u043c\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e), \u0456 \u043a\u0430\u043b\u0456 \u042f\u043a\u0443\u0431, \u041a\u0435\u0444\u0430\u0441 \u0456 \u042f\u043d, \u044f\u043a\u0456\u0445 \u043b\u0456\u0447\u0430\u0446\u044c \u0441\u0442\u0430\u045e\u043f\u0430\u043c\u0456, \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u043c\u043d\u0435 \u043b\u0430\u0441\u043a\u0443, \u044f\u043d\u044b \u043f\u0430\u0434\u0430\u043b\u0456 \u043c\u043d\u0435 \u0456 \u0411\u0430\u0440\u043d\u0430\u0431\u0435 \u043f\u0440\u0430\u0432\u0456\u0446\u0443 \u043d\u0430 \u0437\u043d\u0430\u043a \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043d\u0430\u043c \u0456\u0441\u0446\u0456 \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430 \u0456\u043c &ndash; \u0434\u0430 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u043e\u043c\u043d\u0456\u043b\u0456 \u043f\u0440\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u044f \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0440\u0430\u0431\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 16, 18-19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b &ndash; \u041f\u0451\u0442\u0440, \u0441\u043a\u0430\u043b\u0430, \u0456 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439, \u0456 \u0431\u0440\u0430\u043c\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0442\u043e \u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435, \u0430 \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"714","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e <span style=\"color: #ff0000;\">11, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u0435\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0430\u0439\u0446\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0412\u0435\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0437\u0430\u0440\u0443\u043a\u0430 \u0442\u0430\u0433\u043e, \u043d\u0430 \u0448\u0442\u043e \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f, \u0456 \u0434\u043e\u043a\u0430\u0437 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043c\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043c. \u041f\u0440\u0430\u0437 \u044f\u0435 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435. \u041f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u0448\u0442\u043e \u0432\u044f\u043a\u0456 \u0431\u044b\u043b\u0456 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u0442\u0430\u043a \u0448\u0442\u043e \u0437 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u045e\u0437\u043d\u0456\u043a\u043b\u0430 \u0431\u0430\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0440\u0430\u044e \u0410\u0431\u044d\u043b\u044c \u043f\u0440\u044b\u043d\u0451\u0441 \u0411\u043e\u0433\u0443 \u043b\u0435\u043f\u0448\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443, \u0447\u044b\u043c \u041a\u0430\u0456\u043d, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0451\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0434\u0430\u0440\u044b \u044f\u0433\u043e\u043d\u044b\u044f, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0440\u0430\u044e \u042d\u043d\u043e\u0445 \u0431\u044b\u045e \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0435\u043d\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u044f\u0433\u043e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0435\u0440\u0430\u043d\u0451\u0441 \u044f\u0433\u043e. \u0411\u043e \u043f\u0435\u0440\u0430\u0434 \u043f\u0435\u0440\u0430\u043d\u044f\u0441\u0435\u043d\u043d\u0435\u043c \u0431\u044b\u043b\u043e \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u0430 \u044f\u043c\u0443, \u0448\u0442\u043e \u0451\u043d \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u0411\u043e\u0433\u0443. \u0410 \u0431\u0435\u0437 \u0432\u0435\u0440\u044b \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u0456\u0441\u043d\u0443\u0435 \u0456 \u0434\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0440\u0430\u044e \u041d\u043e\u0439 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0435\u0440\u0430\u0441\u0446\u044f\u0440\u043e\u0433\u0443 \u043d\u0430\u043a\u043e\u043d\u0442 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u043d\u044b\u043c, \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u043a\u0430\u045e\u0447\u044d\u0433, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u043e\u0439 \u0434\u043e\u043c. \u041f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0451\u043d \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u0441\u0432\u0435\u0442 \u0456 \u0441\u0442\u0430\u045e \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0456 \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0430 \u043c\u0435\u0441\u0446\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0401\u043d \u0432\u044b\u0439\u0448\u0430\u045e, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u043a\u0443\u0434\u044b \u0456\u0434\u0437\u0435. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u0451\u043d \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u043d\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a \u043d\u0430 \u0447\u0443\u0436\u044b\u043d\u0435, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0448\u0430\u0442\u0440\u0430\u0445 \u0437 \u0406\u0441\u0430\u0430\u043a\u0430\u043c \u0456 \u042f\u043a\u0443\u0431\u0430\u043c, \u0441\u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f. \u0411\u043e \u0451\u043d \u0447\u0430\u043a\u0430\u045e \u0433\u043e\u0440\u0430\u0434\u0430, \u0437\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043d\u0430 \u043c\u043e\u0446\u043d\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443, \u0434\u043e\u0439\u043b\u0456\u0434\u0430\u043c \u0456 \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u044f\u043a\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u0456 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0421\u0430\u0440\u0430, \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u045e\u0437\u0440\u043e\u0441\u0442\u0443, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0441\u0456\u043b\u0443 \u0437\u0430\u0447\u0430\u0446\u044c \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043b\u0456\u0447\u044b\u043b\u0430 \u0433\u043e\u0434\u043d\u044b\u043c \u0434\u0430\u0432\u0435\u0440\u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u0430\u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u0433\u044d\u0442\u0430 \u0430\u0434 \u0430\u043c\u044f\u0440\u0446\u0432\u0435\u043b\u0430\u0433\u0430, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0442\u0430\u043a \u0448\u043c\u0430\u0442, \u044f\u043a \u0437\u043e\u0440\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0456 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u0445 \u043f\u044f\u0441\u0447\u044b\u043d\u0430\u043a \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0442\u044b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u045e \u0432\u0435\u0440\u044b, \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u045e\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0456\u0445 \u0437\u0434\u0430\u043b\u0451\u043a \u0456 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u045e\u0448\u044b, \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456, \u0448\u0442\u043e \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0456 \u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0411\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0430\u0439\u0447\u044b\u043d\u0443. \u041a\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u0430\u0431 \u0442\u043e\u0439, \u0437 \u044f\u043a\u043e\u0439 \u0432\u044b\u0439\u0448\u043b\u0456, \u0442\u043e \u043c\u0435\u043b\u0456 \u0431 \u043d\u0430\u0433\u043e\u0434\u0443 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u044f\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u043b\u0435\u043f\u0448\u0430\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b. \u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u0431\u043e \u0401\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0456\u043c \u0433\u043e\u0440\u0430\u0434.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 4, 20. 22; \u042f\u043a 2, 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u045e\u0441\u044f \u043f\u0440\u0430\u0437 \u043d\u044f\u0432\u0435\u0440&rsquo;\u0435 \u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u0445 \u0411\u043e\u0436\u044b\u0445, \u0430\u043b\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u0432\u0435\u0440\u044b, \u0430\u0434\u0434\u0430\u044e\u0447\u044b \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0456 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u044f\u043a \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0440\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0447\u0430\u043b\u0430 \u0437 \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0447\u044b\u043d\u043a\u0430\u043c \u0432\u0435\u0440\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u043b\u0430\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.&nbsp;<span style=\"text-align: justify;\"><span style=\"color: #000000;\">\u0413\u044d\u0442\u0430 \u0456 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u044f\u043a \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c.<\/span>&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;<span style=\"color: #000000;\">\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><\/span><span style=\"text-align: justify; color: #ff0000;\">).<\/span><span style=\"text-align: justify;\"><br \/><\/span><\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"716","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041a\u0440\u043e\u043d\u0456\u043a <span style=\"color: #ff0000;\">17, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u0441\u044b\u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0436\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u0441\u0432\u0430\u0456\u043c, \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0443 \u041d\u0430\u0442\u0430\u043d\u0443: &laquo;\u0412\u043e\u0441\u044c \u044f \u0436\u044b\u0432\u0443 \u045e \u043a\u0435\u0434\u0440\u0430\u0432\u044b\u043c \u0434\u043e\u043c\u0435, \u0430 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430 \u045e \u0441\u043a\u0456\u043d\u0456\u0456&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041d\u0430\u0442\u0430\u043d \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u045e \u0446\u044f\u0431\u0435 \u043d\u0430 \u0441\u044d\u0440\u0446\u044b, \u0440\u0430\u0431\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0437 \u0422\u0430\u0431\u043e\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u0443\u044e \u0436 \u043d\u043e\u0447 \u0434\u0430 \u041d\u0430\u0442\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0441\u043a\u0430\u0436\u044b \u0414\u0430\u0432\u0456\u0434\u0443, \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u043c\u0443: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u043d\u0435 \u0442\u044b \u0437\u0431\u0443\u0434\u0443\u0435\u0448 \u041c\u043d\u0435 \u0434\u043e\u043c \u0434\u043b\u044f \u0436\u044b\u043b\u043b\u044f; \u0431\u043e \u042f \u043d\u0435 \u0436\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u0437 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0430\u0436\u043d\u043e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0445\u0430\u0434\u0437\u0456\u045e \u0430\u0434 \u0448\u0430\u0442\u0440\u0430 \u0434\u0430 \u0448\u0430\u0442\u0440\u0430 \u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u041a\u0443\u0434\u044b \u0431 \u042f \u043d\u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0446\u0456 \u0436 \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0445\u043e\u0446\u044c \u0440\u0430\u0437 \u043a\u0430\u043c\u0443-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437 \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u0445, \u044f\u043a\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439: \u0427\u0430\u043c\u0443 \u0432\u044b \u043d\u0435 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u041c\u043d\u0435 \u043a\u0435\u0434\u0440\u0430\u0432\u0430\u0433\u0430 \u0434\u043e\u043c\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0442\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0443: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f \u0437\u0430\u0431\u0440\u0430\u045e \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u0448\u044b \u0430\u0434 \u0441\u0442\u0430\u0442\u043a\u0443 \u0430\u0432\u0435\u0447\u0430\u043a, \u043a\u0430\u0431 \u0442\u044b \u0441\u0442\u0430\u045e \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u0431\u044b\u045e \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0443\u0434\u044b \u0431 \u0442\u044b \u043d\u0456 \u0445\u0430\u0434\u0437\u0456\u045e, \u0456 \u042f \u043f\u0430\u0437\u043d\u0456\u0448\u0447\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u045e\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445. \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0432\u0430\u0451 \u0456\u043c\u044f, \u044f\u043a \u0456\u043c\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u042f \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043c\u0435\u0441\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043c\u0430\u0439\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044e, \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e \u044f\u0433\u043e, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u044f\u0446\u0446\u0430. \u0406 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0446\u044c \u044f\u0433\u043e, \u044f\u043a \u0440\u0430\u043d\u0435\u0439, \u0443 \u0442\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u041c\u0430\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u042f \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0443\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u0437\u0431\u0443\u0434\u0443\u0435 \u0442\u0430\u0431\u0435 \u0434\u043e\u043c. \u041a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u0446\u0430 \u0434\u043d\u0456 \u0442\u0432\u0430\u0435, \u0456 \u0442\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u042f \u0430\u0434\u043d\u0430\u045e\u043b\u044e \u0442\u0432\u0430\u0451 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435, \u044f\u043a\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0456 \u045e\u043c\u0430\u0446\u0443\u044e \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041d\u0430\u0448\u0447\u0430\u0434\u0430\u043a \u0442\u0432\u043e\u0439 \u043f\u0430\u0431\u0443\u0434\u0443\u0435 \u043c\u043d\u0435 \u0434\u043e\u043c, \u0430 \u042f \u045e\u043c\u0430\u0446\u0443\u044e \u0442\u0440\u043e\u043d \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456. \u042f \u0431\u0443\u0434\u0443 \u044f\u043c\u0443 \u0430\u0439\u0446\u043e\u043c, \u0430 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0441\u044b\u043d\u0430\u043c. \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435 \u0437\u0430\u0431\u044f\u0440\u0443 \u0430\u0434 \u044f\u0433\u043e, \u044f\u043a \u0437\u0430\u0431\u0440\u0430\u045e \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. \u0406 \u042f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u044f\u0433\u043e \u045e \u041c\u0430\u0456\u043c \u0434\u043e\u043c\u0435 \u0456 \u045e \u041c\u0430\u0456\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u0456 \u044f\u0433\u043e\u043d\u044b \u0442\u0440\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u043e\u0446\u043d\u0430 \u0441\u0442\u0430\u044f\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u041d\u0430\u0442\u0430\u043d \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 26-32<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0430 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456, \u0437\u0430\u0440\u0443\u0447\u043d\u0430\u0439 \u0437 \u042e\u0437\u0430\u0444\u0430\u043c, \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u0451\u0439 \u0441\u043b\u043e\u0432\u0430. \u0406 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0430\u0441\u044f \u0414\u0437\u0435\u0432\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u041c\u0430\u0440\u044b\u044f, \u0431\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0422\u044b \u043b\u0430\u0441\u043a\u0443 \u045e \u041f\u0430\u043d\u0430; <span style=\"color: #ff0000;\">*<\/span> \u0432\u043e\u0441\u044c \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430, \u0456 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0421\u044b\u043d\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0456\u0442\u0430\u0439 \u041c\u0430\u0440\u044b\u044f, \u043f\u043e\u045e\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0456, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0437\u0430\u0447\u043d\u0435\u0448<span style=\"text-align: justify;\">\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430, \u0456 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0421\u044b\u043d\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"727","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span>&nbsp;<br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e<span style=\"text-align: justify;\">&nbsp;<span style=\"color: #ff0000;\">4, 1-6<\/span><\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0420\u0430\u0437\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u043b\u0430\u0441\u043a\u0430\u045e \u0443 \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0437 \u0443\u0441\u0451\u044e \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0437 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u0410\u0434\u0437\u0456\u043d \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0456\u0445, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0423\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u043f\u0430\u043b\u0430\u043d\u0456\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445 \u0456 \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b&raquo;. \u0410 \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u045e\u0437\u044b\u0448\u043e\u045e\u0448\u044b&raquo;, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0439\u043d\u0456\u0436\u044d\u0439\u0448\u044b\u0445 \u0447\u0430\u0441\u0442\u0430\u043a \u0437\u044f\u043c\u043b\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u044b\u0448\u043e\u045e, \u0451\u0441\u0446\u044c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u0437\u044b\u0448\u043e\u045e \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u0435 \u043d\u044f\u0431\u0451\u0441\u044b, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0451. \u0401\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0430\u0434\u043d\u044b\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0434\u0440\u0443\u0433\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430 \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0445\u0456\u0441\u0442\u0430\u0435 \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0446\u0435\u0440 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c \u043b\u044e\u0434\u0441\u043a\u0456\u043c, \u0445\u0456\u0442\u0440\u044b\u043c \u0448\u0442\u0443\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0435\u0441\u0446\u0456 \u045e \u0437\u043c\u0430\u043d. \u0410\u043b\u0435, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0443\u0441\u0451 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, &ndash; \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0417 \u042f\u0433\u043e \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0456 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0440\u043e\u0437\u043d\u044b\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u044f \u0441\u0443\u0432\u044f\u0437\u0456, \u0443 \u043c\u0435\u0440\u0443 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u043d\u0430\u0439 \u0447\u0430\u0441\u0442\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0446\u0435\u043b\u0430 \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u041f 1, 21; \u041f\u0440\u044b\u043f 2, 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0437 \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u0432\u043e\u043b\u0456 \u0431\u044b\u043b\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430; <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0411\u043e\u0436\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0437 \u042f\u0433\u043e\u043d\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f&nbsp;<span style=\"text-align: justify;\">\u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0411\u043e\u0436\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>"}, {"GCH_CH_1_ID":"736","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e <\/span><span style=\"color: #ff0000;\">3, 7 \u2013 4, 6<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0432\u0430\u043b\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u0436 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456, \u0432\u044b\u0440\u0430\u0437\u0430\u043d\u0430\u0435 \u043b\u0456\u0442\u0430\u0440\u0430\u043c\u0456 \u043d\u0430 \u043a\u0430\u043c\u044f\u043d\u044f\u0445, \u043c\u0435\u043b\u0430 \u0442\u0430\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0443, \u0448\u0442\u043e \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0447\u0430\u0441\u043e\u0432\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u045e \u0441\u043b\u0430\u0432\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0414\u0443\u0445\u0430? \u041a\u0430\u043b\u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044e \u2013 \u0433\u044d\u0442\u0430 \u0441\u043b\u0430\u0432\u0430, \u0442\u043e \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043b\u0430\u0432\u0430\u044e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0411\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u043d\u0435 \u043c\u0430\u0435 \u0441\u043b\u0430\u0432\u044b \u045e \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0439 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439. \u041a\u0430\u043b\u0456 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u0441\u043b\u0430\u045e\u043d\u0430\u0435, \u0442\u043e \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0430\u0434\u0432\u0430\u0433\u0430\u044e. \u0410\u043b\u0435 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u0442\u0432\u0430\u0440, \u043a\u0430\u0431 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u0432\u044b \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u0456\u043d\u0430\u0435. \u0410\u0434\u043d\u0430\u043a \u0437\u0430\u0446\u044c\u043c\u0456\u045e\u0441\u044f \u0456\u0445\u043d\u0456 \u0440\u043e\u0437\u0443\u043c, \u0431\u043e \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f \u0442\u0430\u044f \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u044f\u0437\u043d\u044f\u0442\u0430\u0439 \u043f\u0440\u044b \u0447\u044b\u0442\u0430\u043d\u043d\u0456 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0430 \u043c\u0456\u043d\u0430\u0435 \u044f\u043d\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0410\u0436\u043d\u043e \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0447\u044b\u0442\u0430\u044e\u0446\u044c \u041c\u0430\u0439\u0441\u0435\u044f, \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u043b\u044f\u0436\u044b\u0446\u044c \u043d\u0430 \u0456\u0445 \u0441\u044d\u0440\u0446\u044b. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435\u0445\u0442\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0437\u0430\u0441\u043b\u043e\u043d\u0430 \u0437\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430. \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c, \u0430 \u0434\u0437\u0435 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0442\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0430. \u041c\u044b \u0436 \u0443\u0441\u0435 \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f, \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u0440\u0430, \u0443 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443, \u044f\u043a \u043f\u0440\u0430\u0437 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043c\u0430\u044e\u0447\u044b \u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439 \u0442\u0430\u043a\u043e\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u043c\u044b \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0456. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043c\u044b \u0430\u0434\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0430\u0434 \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u044b\u0445 \u0441\u043a\u0440\u044b\u0442\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043c \u0441\u044f\u0431\u0435 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430 \u0456 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430\u0435\u043c \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0432\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u043c \u0441\u044f\u0431\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436 \u0456 \u0437\u0430\u043a\u0440\u044b\u0442\u0430 \u043d\u0430\u0448\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0442\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0434\u043b\u044f \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u044f\u043a\u0456\u043c \u0431\u043e\u0433 \u0432\u0435\u043a\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u0446\u044c\u043c\u0456\u045e \u0440\u043e\u0437\u0443\u043c, \u043a\u0430\u0431 \u0456\u043c \u043d\u0435 \u0437\u0437\u044f\u043b\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0411\u043e\u0433\u0430. \u0411\u043e \u043c\u044b \u043d\u0435 \u0441\u044f\u0431\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430, \u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u2013 \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0437 \u0446\u0435\u043c\u0440\u044b \u0437\u0430\u0437\u0437\u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u00bb, \u0437\u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0443 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u045e \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n\r\n\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u042f\u043d 3, 1. 2b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u045e \u043d\u0430\u043c \u0410\u0439\u0446\u0435\u0446, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0456 \u043c\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041a\u0430\u0431 \u043c\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"741","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e <\/span><span style=\"color: #ff0000;\">6, 1-6; 8, 1. 4-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0432\u044b\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0441\u0435\u043c \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u043b\u0430\u0441\u044f, \u044d\u043b\u0456\u043d\u0456\u0441\u0442\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c \u043d\u0430 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0456\u0445\u043d\u0456\u0445 \u0443\u0434\u043e\u0432\u0430\u045e \u0443 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456. \u0422\u0430\u0434\u044b \u0414\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u045e\u0441\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u041d\u044f\u0433\u043e\u0436\u0430, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043f\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0445. \u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0432\u044b\u0431\u0435\u0440\u044b\u0446\u0435 \u0437 \u0432\u0430\u0448\u0430\u0433\u0430 \u043b\u0456\u043a\u0443 \u0441\u0435\u043c \u043c\u0443\u0436\u043e\u045e \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u043f\u043e\u045e\u043d\u044b\u0445 \u0414\u0443\u0445\u0430 \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u043c \u0434\u0430\u0440\u0443\u0447\u044b\u043c \u0433\u044d\u0442\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443. \u0410 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0456 \u045e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0441\u043b\u043e\u0432\u0430\u00bb. \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430 \u045e\u0441\u0451\u0439 \u0433\u0440\u0430\u043c\u0430\u0434\u0437\u0435, \u0456 \u0430\u0431\u0440\u0430\u043b\u0456 \u0421\u0442\u044d\u0444\u0430\u043d\u0430, \u043c\u0443\u0436\u0430 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0432\u0435\u0440\u044b \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0424\u0456\u043b\u0456\u043f\u0430 \u0456 \u041f\u0440\u043e\u0445\u0430\u0440\u0430, \u041c\u0456\u043a\u0430\u043d\u043e\u0440\u0430 \u0456 \u0422\u044b\u043c\u043e\u043d\u0430, \u041f\u0430\u0440\u043c\u044d\u043d\u0430 \u0456 \u041c\u0456\u043a\u0430\u043b\u0430\u044f, \u043f\u0440\u0430\u0437\u0435\u043b\u0456\u0442\u0430 \u0437 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u0456, \u044f\u043a\u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456. \u042f\u043d\u044b, \u043f\u0430\u043c\u0430\u043b\u0456\u045e\u0448\u044b\u0441\u044f, \u0443\u0441\u043a\u043b\u0430\u043b\u0456 \u043d\u0430 \u0456\u0445 \u0440\u0443\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0447\u0430\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0423\u0441\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0440\u0430\u0437\u044b\u0448\u043b\u0456\u0441\u044f \u043f\u0430 \u043a\u0440\u0430\u0456\u043d\u0430\u0445 \u042e\u0434\u044d\u0456 \u0456 \u0421\u0430\u043c\u0430\u0440\u044b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u045e\u0441\u044f, \u0445\u0430\u0434\u0437\u0456\u043b\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0424\u0456\u043b\u0456\u043f \u0436\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0430\u043c\u0430\u0440\u044b\u0439\u0441\u043a\u0456 \u0433\u043e\u0440\u0430\u0434 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0442\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0410 \u043b\u044e\u0434\u0437\u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0456 \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u045e \u0424\u0456\u043b\u0456\u043f, \u0431\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u0456\u043c \u0437\u043d\u0430\u043a\u0456. \u0417 \u043c\u043d\u043e\u0433\u0456\u0445 \u0430\u043f\u0430\u043d\u0442\u0430\u043d\u044b\u0445 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043a\u0440\u044b\u043a\u0430\u043c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u0434\u0443\u0445\u0456, \u0448\u043c\u0430\u0442 \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u044b\u0445 \u0456 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u0445 \u0431\u044b\u043b\u043e \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u0430. \u0406 \u0431\u044b\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u0442\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 10, 32; \u042f\u043d 12, 26\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u041c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u042f \u043f\u0440\u044b\u0437\u043d\u0430\u044e \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c \u041c\u0430\u0456\u043c, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041c\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0437\u0435 \u041c\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c; \u0456 \u0434\u0437\u0435 \u042f, \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0456 \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u042f \u043f\u0440\u044b\u0437\u043d\u0430\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"746","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e <\/span><span style=\"color: #ff0000;\">1, 16 \u2013 2, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u043e\u0433 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b: \u041d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u044e \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0437\u0430 \u0432\u0430\u0441, \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u044e\u0447\u044b \u0432\u0430\u0441 \u0443 \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445, \u043a\u0430\u0431 \u0411\u043e\u0433 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0410\u0439\u0446\u0435\u0446 \u0441\u043b\u0430\u0432\u044b, \u0434\u0430\u045e \u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u044f \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0432\u043e\u0447\u044b \u0441\u044d\u0440\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0443 \u0447\u044b\u043c \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u044f\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u044f\u043a\u0430\u044f \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0443 \u043d\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u043f\u0440\u0430\u0437 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0441\u0456\u043b\u044b \u042f\u0433\u043e\u043d\u0430\u0439, \u044f\u043a\u0443\u044e \u0401\u043d \u0432\u044b\u044f\u0432\u0456\u045e \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0441\u044f\u0431\u0435 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043a\u043d\u044f\u0436\u0430\u043d\u043d\u0435, \u0456 \u045e\u043b\u0430\u0434\u0443, \u0456 \u0441\u0456\u043b\u0443, \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435, \u0456 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0456\u043c\u044f, \u044f\u043a\u043e\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u0435\u043a\u0443, \u0430\u043b\u0435 \u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c. \u0423\u0441\u0451 \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u042f\u0433\u043e \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0446\u0435\u043b\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c, \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u045e\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0432\u044b \u0431\u044b\u043b\u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u043c\u0456 \u0437-\u0437\u0430 \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0430\u045e \u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u0443 \u044f\u043a\u0456\u0445 \u0432\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0436\u044b\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0437\u0432\u044b\u0447\u0430\u044f\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043f\u0430 \u0432\u043e\u043b\u0456 \u043a\u043d\u044f\u0437\u044f, \u044f\u043a\u0456 \u045e\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u043f\u0430\u0432\u0435\u0442\u0440\u044b, \u0434\u0443\u0445\u0430, \u044f\u043a\u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u0446\u044f\u043f\u0435\u0440 \u0443 \u0441\u044b\u043d\u0430\u0445 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u043c\u044b \u045e\u0441\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0436\u044b\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u043c\u0430\u043a, \u0456 \u0431\u044b\u043b\u0456 \u043f\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0433\u043d\u0435\u0432\u0443, \u044f\u043a \u0456 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f. \u0410 \u0411\u043e\u0433, \u0431\u0443\u0434\u0443\u0447\u044b \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0443 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0456 \u043d\u0430\u0441, \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437-\u0437\u0430 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430\u0436\u044b\u0432\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0412\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u044e. \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0432\u044f\u043a\u0430\u0445 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456 \u043f\u0440\u0430\u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0434\u0430 \u043d\u0430\u0441 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u0412\u044b \u0436 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u044e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. \u0406 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0430\u0434 \u0432\u0430\u0441, \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u044b \u0434\u0430\u0440. \u0406 \u043d\u0435 \u0430\u0434 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u045e\u0441\u044f. \u041c\u044b \u2013 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u0430, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u0434\u043b\u044f \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0411\u043e\u0433 \u0437\u0430\u0433\u0430\u0434\u0437\u044f \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0456\u043c\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span>  \u042f\u043a\u0430\u044f \u0422\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f, \u041f\u0430\u043d\u043d\u0430 \u041c\u0430\u0440\u044b\u044f, \u0422\u044b \u0430\u0434\u044b\u0448\u043b\u0430 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0421\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445 \u0422\u044b \u0437\u0437\u044f\u0435\u0448 \u044f\u043a \u0441\u043e\u043d\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0410\u043d\u0451\u043b\u044b \u0456 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u044b \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0422\u0432\u0430\u0439\u043c\u0443 \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u044e, \u041f\u0430\u043d\u043d\u0430 \u041c\u0430\u0440\u044b\u044f. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"762","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u0411\u044b\u0446\u0446\u044f <\/span><span style=\"color: #ff0000;\">3, 9-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u0441\u0443\u0434 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0443 \u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c: \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u0410\u0434\u0430\u043c\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u0414\u0437\u0435 \u0442\u044b?\u00bb \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u043f\u0430\u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u0442\u0432\u043e\u0439 \u0443 \u0440\u0430\u0456 \u0456 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f, \u0431\u043e \u0433\u043e\u043b\u044b \u044f, \u0442\u0430\u043c\u0443 \u0441\u0445\u0430\u0432\u0430\u045e\u0441\u044f\u00bb. \u0421\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433: \u00ab\u0425\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0442\u044b \u0433\u043e\u043b\u044b? \u041c\u043e\u0436\u0430 \u0435\u045e \u0442\u044b \u0437 \u0434\u0440\u044d\u0432\u0430, \u0437 \u044f\u043a\u043e\u0433\u0430 \u042f \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u0442\u0430\u0431\u0435 \u0435\u0441\u0446\u0456?\u00bb \u0410\u0434\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0416\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u043c\u043d\u0435, \u044f\u043d\u0430 \u0434\u0430\u043b\u0430 \u043c\u043d\u0435, \u0456 \u0435\u045e \u044f\u00bb. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u0436\u0430\u043d\u0447\u044b\u043d\u0435: \u00ab\u0427\u0430\u043c\u0443 \u0442\u044b \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430?\u00bb \u042f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0417\u043c\u0435\u0439 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u045e \u043c\u044f\u043d\u0435, \u0456 \u0435\u043b\u0430 \u044f\u00bb. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u0437\u043c\u0435\u044e: \u00ab\u0417\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430, \u0442\u044b \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u043f\u0430\u043c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u0436\u044b\u0432\u0451\u043b\u0430\u043c\u0456 \u0456 \u043f\u0430\u043c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u043f\u0430\u043b\u044f\u0432\u044b\u043c\u0456. \u041d\u0430 \u0436\u044b\u0432\u0430\u0446\u0435 \u0441\u0432\u0430\u0456\u043c \u043f\u043e\u045e\u0437\u0430\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u0448 \u0456 \u043f\u044b\u043b \u0431\u0443\u0434\u0437\u0435\u0448 \u0435\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e. \u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0442\u0430\u0431\u043e\u044e \u0456 \u043f\u0430\u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u044e, \u0456 \u043f\u0430\u043c\u0456\u0436 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u043f\u0430\u043c\u0456\u0436 \u044f\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430\u043c. \u042f\u043d\u043e \u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c \u0442\u0430\u0431\u0435 \u0433\u0430\u043b\u0430\u0432\u0443, \u0430 \u0442\u044b \u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0448 \u044f\u0433\u043e \u043f\u044f\u0442\u0443\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043c\u043d\u043e\u0436\u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0442\u0432\u0430\u0435 \u045e \u0442\u0432\u0430\u0451\u0439 \u0446\u044f\u0436\u0430\u0440\u043d\u0430\u0441\u0446\u0456, \u0443 \u043c\u0443\u043a\u0430\u0445 \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u044c \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u0434\u0430 \u043c\u0443\u0436\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435 \u0442\u0432\u0430\u0451, \u0430 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u0434\u0430\u043c\u0443 \u0436 \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0417\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u0436\u043e\u043d\u043a\u0456 \u0456 \u0435\u045e \u0437 \u0442\u0430\u0433\u043e \u0434\u0440\u044d\u0432\u0430, \u0437 \u044f\u043a\u043e\u0433\u0430 \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u043d\u0435 \u0435\u0441\u0446\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: \u043d\u0435 \u0435\u0448 \u0437 \u044f\u0433\u043e, \u2013 \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u0437\u044f\u043c\u043b\u044f \u043f\u0440\u0430\u0437 \u0446\u044f\u0431\u0435, \u0443 \u0446\u044f\u0436\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0446\u044c \u0435\u0436\u0443 \u0437 \u044f\u0435 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e. \u0426\u0435\u0440\u043d\u0456 \u0456 \u0430\u0441\u043e\u0442 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0431\u0435 \u0440\u0430\u0441\u0446\u0456\u0446\u044c, \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0435\u0441\u0446\u0456 \u043f\u0430\u043b\u044f\u0432\u044b\u044f \u0442\u0440\u0430\u0432\u044b. \u0423 \u043f\u043e\u0446\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0445\u043b\u0435\u0431, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u045e \u0437\u044f\u043c\u043b\u044e, \u0437 \u044f\u043a\u043e\u0439 \u0442\u044b \u045e\u0437\u044f\u0442\u044b, \u0431\u043e \u0442\u044b \u043f\u044b\u043b\u0430\u043c \u0451\u0441\u0446\u044c \u0456 \u045e \u043f\u044b\u043b \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0406 \u043d\u0430\u0437\u0432\u0430\u045e \u0410\u0434\u0430\u043c \u0436\u043e\u043d\u043a\u0443 \u0441\u0432\u0430\u044e \u0415\u0432\u0430\u0439, \u0431\u043e \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u043c\u0430\u0446\u0456 \u045e\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0451\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u041f\u0430\u043d\u043d\u0430 \u041c\u0430\u0440\u044b\u044f \u0437 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430. <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u041f\u0440\u0430\u0437 \u042f\u0435 \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0413\u043e\u0434\u043d\u0430 \u045e\u0448\u0430\u043d\u0443\u0435\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u0430\u0437.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"767","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e <\/span><span style=\"color: #ff0000;\">2, 19 \u2013 3, 7. 13-14; 6, 14-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0432\u0430\u043b\u0430 \u043a\u0440\u044b\u0436\u0430<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b: \u042f, \u041f\u0430\u0432\u0435\u043b, \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430. \u042f \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0406 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410 \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0432\u0443 \u045e \u0446\u0435\u043b\u0435, \u0442\u043e \u0436\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435. \u041d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u044e \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439. \u0410 \u043a\u0430\u043b\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d, \u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0434\u0430\u0440\u044d\u043c\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0433\u0430\u043b\u0430\u0442\u044b, \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u044f\u043a\u0456\u0445 \u0431\u044b\u045e \u043d\u0430\u043a\u0440\u044d\u0441\u043b\u0435\u043d\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0445\u0442\u043e \u0437\u0430\u0447\u0430\u0440\u0430\u0432\u0430\u045e \u0432\u0430\u0441? \u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0430\u0434\u043d\u043e \u0445\u0430\u0447\u0443 \u0430\u0434 \u0432\u0430\u0441 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430: \u0446\u0456 \u043f\u0440\u0430\u0437 \u0443\u0447\u044b\u043d\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0414\u0443\u0445\u0430, \u0446\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0432\u0435\u0440\u044b? \u0426\u0456 \u0432\u044b \u0442\u0430\u043a\u0456\u044f \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043a\u0430\u0431 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0442\u0430\u0435 \u0414\u0443\u0445\u0430\u043c \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u0446\u044c \u0446\u044f\u043f\u0435\u0440 \u0446\u0435\u043b\u0430\u043c? \u041d\u044f\u045e\u0436\u043e \u043c\u0430\u0440\u043d\u0430 \u0432\u044b \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0446\u044f\u0440\u043f\u0435\u043b\u0456? \u041c\u043e\u0436\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043c\u0430\u0440\u043d\u0430! \u0426\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0435 \u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0437\u043d\u0430\u043a\u0456, \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u0437 \u0443\u0447\u044b\u043d\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0430\u0431\u043e \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b?&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a, \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0411\u043e\u0433\u0443, \u0456 \u0433\u044d\u0442\u0430 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0414\u044b\u043a \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0433\u044d\u0442\u0430 \u0441\u044b\u043d\u044b \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443 \u0417\u0430\u043a\u043e\u043d\u0443, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c \u0437\u0430 \u043d\u0430\u0441, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0456\u0441\u0456\u0446\u044c \u043d\u0430 \u0434\u0440\u044d\u0432\u0435\u00bb, \u043a\u0430\u0431 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430 \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0430\u0441\u044f \u043d\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u043d\u0435 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f \u2013 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0411\u043e \u043d\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0456 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u043d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u0406 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u0430, \u2013 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c \u0411\u043e\u0436\u044b\u043c.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440.<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b<\/span><span style=\"color: #ff0000;\"> 6, 1<\/span><span style=\"color: #ff0000;\">4\u0430; \u043f\u0430\u0440. \u0413\u0431\u0440 2, 9b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0432\u0430\u043b\u0456\u043c\u0441\u044f \u043a\u0440\u044b\u0436\u0430\u043c \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u044f\u043a\u0456\u043c \u043d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0417\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u044b\u045e \u0443\u0432\u0435\u043d\u0447\u0430\u043d\u044b \u0441\u043b\u0430\u0432\u0430\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041f\u0440\u0430\u0437 \u042f\u0433\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"774","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">4, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0430\u0434\u043d\u044b\u043c \u0426\u0435\u043b\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b: \u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u0443 \u041f\u0430\u043d\u0443, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0437 \u0443\u0441\u0451\u044e \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0437 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. \u0410\u0434\u043d\u043e \u0451\u0441\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0456\u0445, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0423\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u043f\u0430\u043b\u0430\u043d\u0456\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0456 \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u00ab\u045e\u0437\u044b\u0448\u043e\u045e\u0448\u044b\u00bb, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u043d\u0456\u0436\u044d\u0439\u0448\u044b\u0445 \u0447\u0430\u0441\u0442\u0430\u043a \u0437\u044f\u043c\u043b\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u044b\u0448\u043e\u045e, \u0451\u0441\u0446\u044c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u0437\u044b\u0448\u043e\u045e \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u0435 \u043d\u044f\u0431\u0451\u0441\u044b, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0451.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0430\u0434\u043d\u044b\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0434\u0440\u0443\u0433\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430 \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b. \u041a\u0430\u0431 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u044f\u043a\u0456\u0445 \u0445\u0456\u0441\u0442\u0430\u0435 \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0446\u0435\u0440 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043b\u044e\u0434\u0441\u043a\u0456\u043c \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c, \u0445\u0456\u0442\u0440\u044b\u043c \u0448\u0442\u0443\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0435\u0441\u0446\u0456 \u045e \u0437\u043c\u0430\u043d. \u0411\u0443\u0434\u0443\u0447\u044b \u0448\u0447\u044b\u0440\u044b\u043c\u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0432\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, \u2013 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0417 \u042f\u0433\u043e \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0456 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0440\u043e\u0437\u043d\u044b\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u044f \u0441\u0443\u0432\u044f\u0437\u0456, \u0443 \u043c\u0435\u0440\u0443 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0430\u0441\u043e\u0431\u043d\u0430\u0433\u0430 \u0447\u043b\u0435\u043d\u0430, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440.<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">2 \u041f 1, 21; \u041f\u0440\u044b\u043f 2, 6<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u0432\u043e\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0421\u0432\u044f\u0442\u044b\u043c \u0414\u0443\u0445\u0430\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u043b\u044e\u0434\u0437\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0437 \u042f\u0433\u043e\u043d\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u2013 \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"780","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441 \u0441\u0432. \u042f\u043d\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 <\/span><span style=\"color: #ff0000;\">12, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0456\u0442\u0432\u0430 \u041c\u0456\u0445\u0430\u043b\u0430 \u0437 \u0446\u043c\u043e\u043a\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0412\u044f\u043b\u0456\u043a\u0456 \u0437\u043d\u0430\u043a \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u043d\u0435\u0431\u0435: \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u044f \u045e \u0441\u043e\u043d\u0446\u0430, \u0456 \u043c\u0435\u0441\u044f\u0446 \u043f\u0430\u0434 \u044f\u0435 \u043d\u0430\u0433\u0430\u043c\u0456, \u0430 \u043d\u0430\u0434 \u044f\u0435 \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u044f\u043d\u043e\u043a \u0437 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0437\u043e\u0440\u0430\u043a. \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0446\u044f\u0436\u0430\u0440\u043d\u0430\u044f \u0456 \u043a\u0440\u044b\u0447\u0430\u043b\u0430 \u0430\u0434 \u0431\u043e\u043b\u044e \u0456 \u0440\u043e\u0434\u0430\u0432\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u045e. \u0417\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0440\u0443\u0433\u0456 \u0437\u043d\u0430\u043a \u043d\u0430 \u043d\u0435\u0431\u0435: \u0432\u043e\u0441\u044c \u0432\u044f\u043b\u0456\u043a\u0456 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b \u0446\u043c\u043e\u043a \u0437 \u0441\u044f\u043c\u044e \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e \u0440\u0430\u0433\u0430\u043c\u0456, \u0430 \u043d\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u044f\u0433\u043e \u0441\u0435\u043c \u0434\u044b\u044f\u0434\u044d\u043c. \u0425\u0432\u043e\u0441\u0442 \u044f\u0433\u043e\u043d\u044b \u0437\u043c\u044f\u0442\u0430\u0435 \u0442\u0440\u0430\u0446\u0456\u043d\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0437\u043e\u0440\u0430\u043a \u0456 \u043a\u0456\u0434\u0430\u0435 \u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0426\u043c\u043e\u043a \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0436\u044d\u0440\u0446\u0456 \u0434\u0437\u0456\u0446\u044f, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c. \u0406 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043d\u0430 \u0441\u044b\u043d\u0430, \u043c\u0443\u0436\u0447\u044b\u043d\u0443, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c \u043a\u0456\u0435\u043c. \u042f\u0435 \u0434\u0437\u0456\u0446\u044f \u0431\u044b\u043b\u043e \u0437\u0430\u0431\u0440\u0430\u043d\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430. \u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u045e\u0446\u044f\u043a\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u0434\u0437\u0435 \u0451\u0439 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u0431 \u044f\u0435 \u043a\u0430\u0440\u043c\u0456\u043b\u0456 \u0442\u0430\u043c \u0442\u044b\u0441\u044f\u0447\u0443 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u044f\u0441\u044f\u0442 \u0434\u0437\u0451\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u0431\u0456\u0442\u0432\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435. \u041c\u0456\u0445\u0430\u043b \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0437 \u0446\u043c\u043e\u043a\u0430\u043c. \u0412\u0430\u044f\u0432\u0430\u045e \u0446\u043c\u043e\u043a \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456, \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u045e\u0436\u043e \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u0456\u0445 \u043d\u0430 \u043d\u0435\u0431\u0435. \u0422\u0430\u043c\u0443 \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0446\u043c\u043e\u043a, \u0437\u043c\u0435\u0439 \u0441\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u0456, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u044b \u0434\u2019\u044f\u0431\u043b\u0430\u043c \u0456 \u0441\u0430\u0442\u0430\u043d\u043e\u044e. \u0422\u043e\u0439, \u044f\u043a\u0456 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0431\u044b\u045e \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0431\u044b\u043b\u0456 \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u043c\u043e\u0446\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0437 \u043d\u0435\u0431\u0430:&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u00ab\u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u0456\u043b\u0430, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u045e\u043b\u0430\u0434\u0430 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0431\u043e \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u044f\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u043e\u0447 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u045e \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c. \u042f\u043d\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u044f\u0433\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u0443 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e; \u0456 \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430\u0441\u044f\u043b\u044f\u0435 \u0456\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043c\u043e\u0440\u0443, \u0431\u043e \u0441\u044b\u0448\u043e\u045e \u0434\u2019\u044f\u0431\u0430\u043b \u0434\u0430 \u0432\u0430\u0441 \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u043d\u0435\u0432\u0435, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u044f\u0433\u043e \u0447\u0430\u0441!\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0446\u043c\u043e\u043a \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0451\u043d \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043f\u0430\u0447\u0430\u045e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u0443. \u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0434\u0432\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0430\u0440\u043b\u0456\u043d\u044b\u044f \u043a\u0440\u044b\u043b\u044b, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043b\u044f\u0446\u0435\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u043d\u0430 \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u044f\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0447\u0430\u0441, \u0456 \u0447\u0430\u0441\u044b, \u0456 \u043f\u0430\u043b\u043e\u0432\u0443 \u0447\u0430\u0441\u0443 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0446\u043c\u043e\u043a\u0430. \u0422\u0430\u0434\u044b \u043f\u0443\u0441\u0446\u0456\u045e \u0437\u043c\u0435\u0439 \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0437\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439 \u0432\u0430\u0434\u0443, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u0430\u043a\u0443, \u043a\u0430\u0431 \u044f\u0435 \u043f\u0430\u043d\u0435\u0441\u043b\u0430 \u0440\u0430\u043a\u0430. \u0410\u043b\u0435 \u0437\u044f\u043c\u043b\u044f \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0435. \u0410\u0434\u043a\u0440\u044b\u043b\u0430 \u0437\u044f\u043c\u043b\u044f \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0440\u0430\u043a\u0443, \u044f\u043a\u0443\u044e \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u045e \u0446\u043c\u043e\u043a \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u0446\u043c\u043e\u043a \u043d\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0443 \u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0431\u0456\u0442\u0432\u0443 \u0437 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c\u0456 \u044f\u0435 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0411\u043e\u0433\u0430 \u0456 \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430.<\/span><\/p>\r\n\r\n\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0410\u043f 12, 7. 10<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0446\u0456\u0448\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435, \u043a\u0430\u043b\u0456 \u041c\u0456\u0445\u0430\u043b \u0430\u0440\u0445\u0430\u043d\u0451\u043b \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0437 \u0446\u043c\u043e\u043a\u0430\u043c.<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0406 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u043c\u043e\u0446\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: \u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u0441\u0456\u043b\u0430 \u0411\u043e\u0433\u0443 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u0456\u043b\u0430, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u045e\u043b\u0430\u0434\u0430 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u043f\u0430\u0447\u0443\u045e\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"795","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e <\/span><span style=\"color: #ff0000;\">9, 27-31; 11, 19-26<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"line-height: 2.4; text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0411\u0430\u0440\u043d\u0430\u0431\u0430 \u045e\u0437\u044f\u045e \u0421\u0430\u045e\u043b\u0430 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c, \u044f\u043a \u0443 \u0434\u0430\u0440\u043e\u0437\u0435 \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u041f\u0430\u043d\u0430, \u0456 \u0448\u0442\u043e \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443, \u0456 \u044f\u043a \u0443 \u0414\u0430\u043c\u0430\u0441\u043a\u0443 \u0430\u0434\u0432\u0430\u0436\u043d\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0443 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430. \u042f\u043a \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u0451\u043d \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0456 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0456 \u0430\u0434\u0432\u0430\u0436\u043d\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0456 \u0441\u043f\u0440\u0430\u0447\u0430\u045e\u0441\u044f \u0437 \u044d\u043b\u0456\u043d\u0456\u0441\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0445\u0430\u0446\u0435\u043b\u0456 \u0437\u0430\u0431\u0456\u0446\u044c \u044f\u0433\u043e. \u0414\u0430\u0432\u0435\u0434\u0430\u045e\u0448\u044b\u0441\u044f \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0431\u0440\u0430\u0442\u044b \u0430\u0434\u0432\u044f\u043b\u0456 \u044f\u0433\u043e \u045e \u0426\u044d\u0437\u0430\u0440\u044d\u044e \u0456 \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u045e \u0422\u0430\u0440\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0430 \u045e\u0441\u0451\u0439 \u042e\u0434\u044d\u0456, \u0413\u0430\u043b\u0456\u043b\u0435\u0456 \u0456 \u0421\u0430\u043c\u0430\u0440\u044b\u0456 \u043c\u0435\u045e \u0441\u043f\u0430\u043a\u043e\u0439, \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u045e\u0441\u044f \u0456 \u0436\u044b\u045e \u0443 \u0431\u043e\u044f\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u045e\u0441\u044f \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0441\u0441\u0435\u044f\u045e\u0441\u044f \u0437-\u0437\u0430 \u0433\u0430\u043d\u0435\u043d\u043d\u044f\u045e, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u0421\u0442\u044d\u0444\u0430\u043d\u0430, \u0434\u0430\u0439\u0448\u043b\u0456 \u0430\u0436 \u0434\u0430 \u0424\u0435\u043d\u0456\u0446\u044b\u0456, \u041a\u0456\u043f\u0440\u0430 \u0456 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u0456, \u0456 \u043d\u0456\u043a\u043e\u043c\u0443, \u0430\u043f\u0440\u043e\u0447 \u044e\u0434\u044d\u044f\u045e, \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u0430. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0456\u0445 \u0431\u044b\u043b\u0456 \u0437 \u041a\u0456\u043f\u0440\u0430 \u0456 \u041a\u0456\u0440\u044d\u043d\u044d\u0456. \u042f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u044e \u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0433\u0440\u044d\u043a\u0430\u045e, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430. \u0410 \u0440\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437 \u0456\u043c\u0456, \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430 \u0456 \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0412\u0435\u0441\u0442\u043a\u0430 \u043f\u0440\u0430 \u0456\u0445 \u0434\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0422\u0430\u0434\u044b \u045e \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u044e \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0411\u0430\u0440\u043d\u0430\u0431\u0443. \u041a\u0430\u043b\u0456 \u0451\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0443\u0441\u0456\u0445, \u043a\u0430\u0431 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u041f\u0430\u043d\u0443. \u0401\u043d \u0431\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0434\u043e\u0431\u0440\u044b, \u043f\u043e\u045e\u043d\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0432\u0435\u0440\u044b, \u0442\u0430\u043c\u0443 \u0448\u043c\u0430\u0442 \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0440\u044b\u0445\u0456\u043b\u0456\u043b\u0430\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430. \u041f\u043e\u0442\u044b\u043c \u0411\u0430\u0440\u043d\u0430\u0431\u0430 \u043f\u0430\u0439\u0448\u043e\u045e \u0443 \u0422\u0430\u0440\u0441 \u0448\u0443\u043a\u0430\u0446\u044c \u0421\u0430\u045e\u043b\u0430 \u0456, \u043a\u0430\u043b\u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u044f\u0433\u043e, \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u044e. \u0423\u0432\u0435\u0441\u044c \u0433\u043e\u0434 \u044f\u043d\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439. \u0423 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u0456 \u045e\u043f\u0435\u0440\u0448\u044b\u043d\u044e \u0432\u0443\u0447\u043d\u0456 \u0431\u044b\u043b\u0456 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0437 12, 24; 13, 48b. 52\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0421\u043b\u043e\u0432\u0430 \u0436 \u0411\u043e\u0436\u0430\u0435 \u0440\u0430\u0441\u043b\u043e \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u043b\u0430\u0441\u044f.&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0423\u0441\u0435, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0410 \u0432\u0443\u0447\u043d\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0456\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_1_ID":"803","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441 \u0441\u0432. \u042f\u043d\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 <\/span><span style=\"color: #ff0000;\">5, 1-14<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0411\u043e\u0433 \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0456 \u043c\u043e\u0432\u044b, \u0456 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u0456 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0443 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u043a\u043d\u0456\u0433\u0443, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u0443\u044e \u045e\u043d\u0443\u0442\u0440\u044b \u0456 \u0437\u0432\u043e\u043d\u043a\u0443, \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u0443\u044e \u0441\u044f\u043c\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u043c\u0456. \u042f \u0431\u0430\u0447\u044b\u045e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: \u00ab\u0425\u0442\u043e \u0433\u043e\u0434\u043d\u044b \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u043f\u044f\u0447\u0430\u0442\u043a\u0456?\u00bb \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0456 \u043d\u0430 \u043d\u0435\u0431\u0435, \u043d\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0456 \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e \u043d\u0435 \u043c\u043e\u0433 \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443, \u043d\u0456 \u0437\u0430\u0437\u0456\u0440\u043d\u0443\u0446\u044c \u0443 \u044f\u0435. \u0406 \u044f \u043c\u043e\u0446\u043d\u0430 \u043f\u043b\u0430\u043a\u0430\u045e, \u0431\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0433\u043e\u0434\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u0430\u0437\u0456\u0440\u043d\u0443\u0446\u044c \u0443 \u044f\u0435. \u0422\u0430\u0434\u044b \u0430\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u00ab\u041d\u0435 \u043f\u043b\u0430\u0447, \u0432\u043e\u0441\u044c \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043b\u0435\u045e \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u042e\u0434\u044b, \u043a\u043e\u0440\u0430\u043d\u044c \u0414\u0430\u0432\u0456\u0434\u0430, \u043a\u0430\u0431 \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u0441\u0435\u043c \u043f\u044f\u0447\u0430\u0442\u0430\u043a\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0442\u0440\u043e\u043d\u0430 \u0456 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0441\u0442\u0430\u044f\u045e \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u043d\u0456\u0431\u044b \u0437\u0430\u0431\u0456\u0442\u044b, \u044f\u043a\u0456 \u043c\u0435\u045e \u0441\u0435\u043c \u0440\u0430\u0433\u043e\u045e \u0456 \u0441\u0435\u043c \u0432\u0430\u0447\u044d\u0439, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u044f\u043c\u044e \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0443\u0445\u0430\u043c\u0456, \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u045e\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443 \u0437 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0442\u0440\u043e\u043d\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0401\u043d \u0443\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443, \u0442\u0430\u0434\u044b \u0447\u0430\u0442\u044b\u0440\u044b \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u045e\u043f\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c; \u043a\u043e\u0436\u043d\u044b \u043c\u0435\u045e \u0433\u0443\u0441\u043b\u0456 \u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u0447\u0430\u0448\u044b, \u043f\u043e\u045e\u043d\u044b\u044f \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u0445. \u042f\u043d\u044b \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0422\u044b \u0433\u043e\u0434\u043d\u044b \u045e\u0437\u044f\u0446\u044c \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u043f\u044f\u0447\u0430\u0442\u043a\u0456, \u0431\u043e \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0456 \u043c\u043e\u0432\u044b, \u0456 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u0456 \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430; \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0431\u0430\u0447\u044b\u045e \u0456 \u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0430\u043d\u0451\u043b\u0430\u045e \u0432\u0430\u043a\u043e\u043b \u0442\u0440\u043e\u043d\u0430 \u0456 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u0456 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d. \u041a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0456\u0445 \u0431\u044b\u043b\u0430 \u043c\u0456\u0440\u044b\u044f\u0434\u044b \u043c\u0456\u0440\u044b\u044f\u0434 \u0456 \u0442\u044b\u0441\u044f\u0447\u044b \u0442\u044b\u0441\u044f\u0447. \u042f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: \u00ab\u0417\u0430\u0431\u0456\u0442\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0433\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043c\u043e\u0446, \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0441\u0456\u043b\u0443, \u0456 \u043f\u0430\u0448\u0430\u043d\u0443, \u0456 \u0445\u0432\u0430\u043b\u0443, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u044f \u0447\u0443\u045e, \u044f\u043a \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e \u0456 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0456\u0445, \u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443 \u2014 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u0445\u0432\u0430\u043b\u0430, \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0410 \u0447\u0430\u0442\u044b\u0440\u044b \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0410\u043c\u044d\u043d\u00bb. \u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u044b \u0436 \u0443\u043f\u0430\u043b\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 11, 17; 1, 4; \u043f\u0430\u0440. 11, 18; \u041f\u0441 145 (144), 10<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0456 \u044f\u043a\u0456 \u0431\u044b\u045e, \u0456 \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c,&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0431\u043e \u0422\u044b \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0447\u0430\u0441, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0441\u043b\u0443\u0433\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u0456 \u0441\u0432\u044f\u0442\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0443\u0441\u0435 \u0422\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u0456 \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0422\u0432\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0426\u044f\u0431\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e.<\/span><\/p>"}, {"GCH_CH_1_ID":"816","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u0431\u0440\u044d\u044f\u045e&nbsp;<span style=\"color: #ff0000;\">4, 14-16; 5, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043d\u044f\u0431\u0451\u0441\u044b, \u0415\u0437\u0443\u0441\u0430, \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0446\u0432\u0451\u0440\u0434\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430. \u0411\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u043d\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c \u043d\u0430\u0448\u044b\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u043e\u0433\u0430, \u044f\u043a\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430, \u0437\u0432\u0435\u0434\u0430\u045e \u0443\u0441\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u0440\u044d\u0445\u0443. \u0422\u0430\u043c\u0443 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0434\u0430 \u0442\u0440\u043e\u043d\u0430 \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043b\u0430\u0441\u043a\u0443 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0447\u0430\u0441\u043e\u0432\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0437 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0411\u043e\u0436\u044b\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430\u0440\u044b \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456. \u0401\u043d \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0456 \u0431\u043b\u0443\u043a\u0430\u0435, \u0431\u043e \u0456 \u0441\u0430\u043c \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u044f\u043a \u0437\u0430 \u043d\u0430\u0440\u043e\u0434, \u0442\u0430\u043a \u0456 \u0437\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u0441\u0430\u043c \u043d\u0435 \u0431\u044f\u0440\u044d \u0441\u0430\u0431\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u043d\u0430\u0440\u0443, \u0430\u043f\u0440\u043e\u0447 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a \u0456 \u0410\u0430\u0440\u043e\u043d. \u0422\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0430\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &laquo;\u0422\u044b \u0421\u044b\u043d \u041c\u043e\u0439, \u042f \u0426\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e&raquo;; \u044f\u043a \u0456 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0434\u043d\u0456 \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0437 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0456 \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u045e\u0437\u043d\u0451\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u0431\u044b\u045e \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b \u0437\u0430 \u0441\u0432\u0430\u044e \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0425\u043e\u0446\u044c \u0431\u044b\u045e \u0421\u044b\u043d\u0430\u043c, \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e. \u0406, \u0431\u0443\u0434\u0443\u0447\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b, \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f; \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u045e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 2, 8; \u0406\u0441 53, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b, \u0431\u043e \u0441\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"817","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><em>\u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456<\/em><\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0411\u043e\u0436\u0443\u044e \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0411\u043e \u044f \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u043d\u0435 \u0432\u0435\u0434\u0430\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u043c\u0456\u0436 \u0432\u0430\u0441, \u0430\u043f\u0440\u043e\u0447 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0442\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u0406 \u044f \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0456 \u045e \u0441\u0442\u0440\u0430\u0445\u0443, \u0456 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0456. \u0410 \u0441\u043b\u043e\u0432\u0430 \u043c\u0430\u0451 \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0435 \u045e \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0447\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u045e \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0456 \u0414\u0443\u0445\u0430 \u0456 \u043c\u043e\u0446\u044b, \u043a\u0430\u0431 \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430\u044f \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u043b\u0430\u0441\u044f \u043d\u0435 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u043d\u0430 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u0445, \u0430 \u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0446\u0456 \u0437\u043d\u0456\u043a\u043e\u043c\u044b\u0445 \u043a\u043d\u044f\u0437\u0451\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e, \u0441\u0445\u0430\u0432\u0430\u043d\u0443\u044e \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456 \u0434\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u043d\u0430\u0448\u0430\u0439. \u041d\u0456\u0445\u0442\u043e \u0437 \u043a\u043d\u044f\u0437\u0451\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u044f\u0435; \u0431\u043e, \u043a\u0430\u043b\u0456 \u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u043d\u0435 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0431 \u041f\u0430\u043d\u0430 \u0441\u043b\u0430\u0432\u044b. \u0410\u043b\u0435, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u0447\u0430\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0442\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043c \u0436\u0430 \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430, \u0431\u043e \u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0411\u043e\u0436\u044b\u044f. \u0411\u043e \u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0434\u0443\u0445\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u045e \u0456\u043c \u0441\u0430\u043c\u0456\u043c? \u0422\u0430\u043a \u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0445\u0442\u043e, \u0430\u043a\u0440\u0430\u043c\u044f \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u041c\u044b \u0436 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0435 \u0434\u0443\u0445\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u043f\u0430\u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c. \u0406 \u043c\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c, \u0456 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430. \u0426\u044f\u043b\u0435c\u043d\u044b \u0436 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0434 \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u0411\u043e \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u044f\u0433\u043e \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0456 \u0451\u043d \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u0430. \u0410 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0436\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u045e\u0441\u0451, \u043f\u0440\u0430 \u044f\u0433\u043e \u0436 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0456\u0445\u0442\u043e. \u0411\u043e \u0445\u0442\u043e \u043f\u0430\u0437\u043d\u0430\u045e \u0440\u043e\u0437\u0443\u043c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u043f\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u042f\u0433\u043e? \u041c\u044b \u0436 \u043c\u0430\u0435\u043c \u0440\u043e\u0437\u0443\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u0444 1, 17. 18; 1 \u041a\u0430\u0440 2, 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0410\u0439\u0446\u0435\u0446 \u0441\u043b\u0430\u0432\u044b, \u0434\u0430\u045e \u043d\u0430\u043c \u0414\u0443\u0445\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u044f \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0432\u043e\u0447\u044b \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043c\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0443 \u0447\u044b\u043c \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u044f\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u0445. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0436 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0435 \u0434\u0443\u0445\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043c\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0443 \u0447\u044b\u043c \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u044f\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"818","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443&nbsp;<span style=\"color: #ff0000;\">24, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430, \u0456 \u0435\u043b\u0456, \u0456 \u043f\u0456\u043b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u0442\u044b \u0456 \u0410\u0430\u0440\u043e\u043d, \u041d\u0430\u0434\u0430\u0431 \u0456 \u0410\u0431\u0456\u0445\u0443, \u0456 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0437\u0434\u0430\u043b\u0451\u043a. \u0422\u043e\u043b\u044c\u043a\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0430 \u044f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0446\u0446\u0430, \u0456 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0437 \u0433\u0430\u0440\u044b \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u0456 \u045e\u0441\u0435 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b. \u0410 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0430\u0434\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430: &laquo;\u0423\u0441\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u043c&raquo;. \u0406 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430. \u0410 \u045e\u0441\u0442\u0430\u045e\u0448\u044b \u0440\u0430\u043d\u0430, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a \u043f\u0430\u0434 \u0433\u0430\u0440\u043e\u044e \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0441\u043b\u0443\u043f\u043e\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0417\u0430\u0442\u044b\u043c \u043f\u0430\u0441\u043b\u0430\u045e \u044e\u043d\u0430\u043a\u043e\u045e, \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u041f\u0430\u043d\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u043c\u0456\u0440\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0431\u044b\u043a\u043e\u045e. \u041f\u0430\u0441\u043b\u044f \u045e\u0437\u044f\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0430\u043b\u043e\u0432\u0443 \u043a\u0440\u044b\u0432\u0456 \u0456 \u043d\u0430\u043b\u0456\u045e \u044f\u0435 \u045e \u043c\u0456\u0441\u044b, \u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u043f\u0430\u043b\u043e\u0432\u0443 \u043a\u0440\u044b\u0432\u0456 \u0432\u044b\u043b\u0456\u045e \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a. \u041f\u043e\u0442\u044b\u043c \u0443\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e \u0443\u0433\u043e\u043b\u0430\u0441 \u043b\u044e\u0434\u0437\u044f\u043c, \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u044f\u043d\u044b: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u0437\u0440\u043e\u0431\u0456\u043c, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456&raquo;. \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u044f\u045e \u043a\u0440\u043e\u045e, \u0430\u043a\u0440\u0430\u043f\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u043a\u0440\u043e\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u041f\u0430\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0432\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0456\u0445 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043f\u0430\u0434\u043d\u044f\u043b\u0456\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0410\u0430\u0440\u043e\u043d, \u041d\u0430\u0434\u0430\u0431 \u0456 \u0410\u0431\u0456\u0445\u0443, \u0456 \u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u043f\u0430\u0434 \u043d\u0430\u0433\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u043d\u0456\u0431\u044b \u0442\u0432\u043e\u0440 \u0437 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0441\u0430\u043f\u0444\u0456\u0440\u0443, \u043f\u0440\u0430\u0437\u0440\u044b\u0441\u0442\u044b, \u044f\u043a \u0441\u0430\u043c\u043e \u043d\u0435\u0431\u0430. \u0406 \u043d\u0435 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0401\u043d \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430, \u0456 \u0435\u043b\u0456, \u0456 \u043f\u0456\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 6, 48-50. 51\u0430b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0445\u043b\u0435\u0431 \u0436\u044b\u0446\u0446\u044f. \u0410\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0435\u043b\u0456 \u043c\u0430\u043d\u043d\u0443 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 &ndash; \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u0435\u0441\u0446\u044c \u044f\u0433\u043e, \u043d\u0435 \u043f\u0430\u043c\u0451\u0440. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u0445\u043b\u0435\u0431 \u0436\u044b\u0432\u044b, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 &ndash; \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u0435\u0441\u0446\u044c \u044f\u0433\u043e, \u043d\u0435 \u043f\u0430\u043c\u0451\u0440.<\/p>\r\n"}, {"GCH_CH_1_ID":"819","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">8, 28-39<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u045e\u0441\u0451 \u0456\u0434\u0437\u0435 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u043f\u0430 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0435. \u0411\u043e, \u043a\u0430\u0433\u043e \u0401\u043d \u043d\u0430\u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0437\u043d\u0430\u045e, \u0442\u0430\u0433\u043e \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0431\u044b\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0431 \u0401\u043d \u0431\u044b\u045e \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u043c\u0456\u0436 \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456. \u041a\u0430\u0433\u043e \u0436 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e, \u0442\u0430\u0433\u043e \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e, \u0430 \u043a\u0430\u0433\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e, \u0442\u0430\u0433\u043e \u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u045e; \u0430 \u043a\u0430\u0433\u043e \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u045e, \u0442\u0430\u0433\u043e \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0441\u043a\u0430\u0436\u0430\u043c \u043d\u0430 \u0433\u044d\u0442\u0430? \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0437\u0430 \u043d\u0430\u0441, \u0445\u0442\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441? \u0422\u043e\u0439, \u044f\u043a\u0456 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441, \u044f\u043a \u0436\u0430 \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u044f\u0433\u043e? \u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0432i\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0446\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0411\u043e\u0433\u0430\u043c? \u0426\u0456 \u0436 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435? \u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c \u0456\u0445? \u0426\u0456 \u0436 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430? \u041d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0446\u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442, \u0446\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0446\u0456 \u0433\u043e\u043b\u0430\u0434, \u0446\u0456 \u0433\u0430\u043b\u0435\u0447\u0430, \u0446\u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430, \u0446\u0456 \u043c\u0435\u0447? \u042f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0417\u0430 \u0446\u044f\u0431\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0443\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c, \u043b\u0456\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u043e\u045e\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441. \u0411\u043e \u044f \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u044c, \u043d\u0456 \u0436\u044b\u0446\u0446\u0451, \u043d\u0456 \u0430\u043d\u0451\u043b\u044b, \u043d\u0456 \u045e\u043b\u0430\u0434\u044b, \u043d\u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0435, \u043d\u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0435, \u043d\u0456 \u0441\u0456\u043b\u044b, \u043d\u0456 \u0432\u044b\u0448\u044b\u043d\u044f, \u043d\u0456 \u0433\u043b\u044b\u0431\u0456\u043d\u044f, \u043d\u0456 \u0456\u043d\u0448\u0430\u0435 \u044f\u043a\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0439, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u041f\u0430\u043d\u0443 \u043d\u0430\u0448\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 2, 5. 4b. 7\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043d\u0430\u0441, \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437-\u0437\u0430 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430\u0436\u044b\u0432\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0432\u044f\u043a\u0430\u0445 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_1_ID":"900","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">21, 9-27<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0411\u0430\u0447\u0430\u043d\u043d\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0437 \u0441\u044f\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0441\u0435\u043c \u043a\u0435\u043b\u0456\u0445\u0430\u045e, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u0445 \u0441\u044f\u043c\u044e \u0430\u043f\u043e\u0448\u043d\u0456\u043c\u0456 \u043a\u0430\u0440\u0430\u043c\u0456, \u0456 \u0437\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0430\u0434\u0437\u0456, \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u043d\u044f\u0432\u0435\u0441\u0442\u0443, \u0436\u043e\u043d\u043a\u0443 \u0411\u0430\u0440\u0430\u043d\u043a\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0437\u043d\u0451\u0441 \u043c\u044f\u043d\u0435 \u045e \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456 \u0430\u043d\u0451\u043b \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0456 \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0433\u0430\u0440\u0443, \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0441\u0432\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u043c\u0435\u045e \u0411\u043e\u0436\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u0417\u0437\u044f\u043d\u043d\u0435 \u044f\u0433\u043e\u043d\u0430\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u044f\u0448\u043c\u0430, \u043a\u0430\u043c\u0435\u043d\u044f, \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u044f\u043a \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c. \u041c\u0435\u045e \u0451\u043d \u043c\u0443\u0440 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0432\u044b\u0441\u043e\u043a\u0456, \u043c\u0435\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0431\u0440\u0430\u043c\u0430\u045e, \u0430 \u043d\u0430 \u0431\u0440\u0430\u043c\u0430\u0445 &ndash; \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u0456\u043c\u0451\u043d\u044b \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0417 \u0443\u0441\u0445\u043e\u0434\u0443 \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b \u0456 \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b, \u0456 \u0437 \u043f\u043e\u045e\u0434\u043d\u044f \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b, \u0456 \u0437 \u0437\u0430\u0445\u0430\u0434\u0443 \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b. \u0406 \u043c\u0443\u0440 \u0433\u043e\u0440\u0430\u0434\u0430 \u043c\u0435\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0430\u045e, \u0430 \u043d\u0430 \u0456\u0445 &ndash; \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0456\u043c\u0451\u043d\u0430\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u043e\u0439, \u044f\u043a\u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u043c\u0435\u045e \u0437\u0430\u043b\u0430\u0442\u0443\u044e \u043c\u0435\u0440\u043d\u0443\u044e \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0443, \u043a\u0430\u0431 \u043f\u0430\u043c\u0435\u0440\u0430\u0446\u044c \u0433\u043e\u0440\u0430\u0434, \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0440\u0430\u043c\u044b \u0456 \u043c\u0443\u0440. \u0413\u043e\u0440\u0430\u0434 \u0431\u044b\u045e \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u0432\u0443\u0433\u043e\u043b\u044c\u043d\u044b, \u0456 \u0434\u0430\u045e\u0436\u044b\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u044f \u0431\u044b\u043b\u0430 \u0440\u043e\u045e\u043d\u0430\u044f \u0448\u044b\u0440\u044b\u043d\u0456. \u0406 \u0451\u043d \u043f\u0430\u043c\u0435\u0440\u0430\u045e \u0433\u043e\u0440\u0430\u0434 \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0430\u044e, \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0441\u0442\u0430\u0434\u044b\u044f\u045e. \u042f\u0433\u043e \u0434\u0430\u045e\u0436\u044b\u043d\u044f, \u0448\u044b\u0440\u044b\u043d\u044f \u0456 \u0432\u044b\u0448\u044b\u043d\u044f \u0440\u043e\u045e\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u043c\u0435\u0440\u0430\u045e \u044f\u0433\u043e\u043d\u044b \u043c\u0443\u0440, \u0451\u043d \u0431\u044b\u045e \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0447\u0430\u0442\u044b\u0440\u044b \u043b\u043e\u043a\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0435\u0440\u044b, \u044f\u043a\u043e\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e\u0441\u044f \u0430\u043d\u0451\u043b. \u041c\u0443\u0440 \u0431\u044b\u045e \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0437 \u044f\u0448\u043c\u044b, \u0430 \u0433\u043e\u0440\u0430\u0434 &ndash; \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0448\u043a\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u044b \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0456\u0445 \u043c\u0443\u0440\u043e\u045e \u0431\u044b\u043b\u0456 \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c: \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u0431\u044b\u045e \u0437 \u044f\u0448\u043c\u044b, \u0434\u0440\u0443\u0433\u0456 &ndash; \u0437 \u0441\u0430\u043f\u0444\u0456\u0440\u0443, \u0442\u0440\u044d\u0446\u0456 &ndash; \u0437 \u0445\u0430\u043b\u0446\u044d\u0434\u043e\u043d\u0443, \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b &ndash; \u0441\u0430 \u0441\u043c\u0430\u0440\u0430\u0433\u0434\u0443, \u043f\u044f\u0442\u044b &ndash; \u0437 \u0441\u0430\u0440\u0434\u0430\u043d\u0456\u043a\u0441\u0443, \u0448\u043e\u0441&shy;\u0442\u044b &ndash; \u0437 \u0441\u0435\u0440\u0434\u0430\u043b\u0456\u043a\u0443, \u0441\u0451\u043c\u044b &ndash; \u0437 \u0445\u0440\u044b\u0437\u0430\u043b\u0456\u0442\u0443, \u0432\u043e\u0441\u044c\u043c\u044b &ndash; \u0437 \u0431\u044d\u0440\u044b\u043b\u0443, \u0434\u0437\u0435\u0432\u044f\u0442\u044b &ndash; \u0437 \u0442\u0430\u043f\u0430\u0437\u0443, \u0434\u0437\u0435\u0441\u044f\u0442\u044b &ndash; \u0437 \u0445\u0440\u044b&shy;\u0437\u0430&not;\u043f\u0440\u0430\u0441\u0443, \u0430\u0434\u0437\u0456\u043d\u0430\u0446\u0446\u0430\u0442\u044b &ndash; \u0437 \u0433\u0456\u044f\u0446\u044b\u043d\u0442\u0443, \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u044b &ndash; \u0437 \u0430\u043c\u0435\u0442\u044b\u0441\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0431\u0440\u0430\u043c\u0430\u045e \u0431\u044b\u043b\u0456 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0446\u044e \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u043c\u0456, \u043a\u043e\u0436\u043d\u0430\u044f \u0431\u0440\u0430\u043c\u0430 \u0431\u044b\u043b\u0430 \u0437 \u0430\u0441\u043e\u0431\u043d\u0430\u0439 \u043f\u044f\u0440\u043b\u0456\u043d\u044b. \u0410 \u043f\u043b\u043e\u0448\u0447\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a \u043f\u0440\u0430\u0437\u0440\u044b\u0441\u0442\u0430\u0435 \u0448\u043a\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e \u0456\u043c \u044f \u043d\u0435 \u0431\u0430\u0447\u044b\u045e, \u0431\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u0411\u0430\u0440\u0430\u043d\u0430\u043a. \u0406 \u0433\u043e\u0440\u0430\u0434\u0443 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u043d\u0456 \u0441\u043e\u043d\u0446\u0430, \u043d\u0456 \u043c\u0435\u0441\u044f\u0446, \u043a\u0430\u0431 \u044f\u043c\u0443 \u0441\u0432\u044f\u0446\u0456\u043b\u0456, \u0431\u043e \u0441\u043b\u0430&shy;\u0432\u0430 \u0411\u043e\u0436\u0430\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u043b\u0430 \u044f\u0433\u043e, \u0430 \u0441\u0432\u0435\u0442\u0430\u0447 \u044f\u0433\u043e\u043d\u044b &ndash; \u0411\u0430\u0440\u0430\u043d\u0430\u043a. \u0406 \u045e \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u044f\u043c\u0443 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443. \u0406 \u0431\u0440\u0430\u043c\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043d\u044c, \u0430 \u043d\u043e\u0447\u044b \u0442\u0430\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u0442\u0443\u0434\u044b \u0441\u043b\u0430\u0432\u0443 \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0406 \u043d\u0456\u0448\u0442\u043e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u0442\u0443\u0434\u044b, \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0430\u0433\u0456\u0434\u0443 \u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u043a\u043d\u0456\u0437\u0435 \u0436\u044b\u0446\u0446\u044f \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 21, 21; \u0422\u043e\u0431 13, 17. 18. 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0443\u043b\u0456\u0446\u044b \u0422\u0432\u0430\u0435, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u0440\u044b\u0442\u044b\u044f \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0447\u044b\u0441\u0442\u044b\u043c \u0456 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u0431\u0435 \u0440\u0430\u0434\u0430\u0441\u043d\u0443\u044e \u043f\u0435\u0441\u043d\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0437 \u0443\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u0432\u0430\u043a\u043e\u043b\u0456\u0446 \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0442\u043d\u0430: \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u0430\u0437\u0437\u044f\u0435\u0448 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u045e\u0441\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u043c\u0435\u0436\u044b \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437 \u0443\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u0432\u0430\u043a\u043e\u043b\u0456\u0446 \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0442\u043d\u0430: \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"901","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041a\u0440\u043e\u043d\u0456\u043a\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">17, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u0421\u044b\u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0436\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u0441\u0432\u0430\u0456\u043c, \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0443 \u041d\u0430\u0442\u0430\u043d\u0443: &laquo;\u0412\u043e\u0441\u044c \u044f \u0436\u044b\u0432\u0443 \u045e \u043a\u0435\u0434\u0440\u0430\u0432\u044b\u043c \u0434\u043e\u043c\u0435, \u0430 \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041f\u0430\u043d\u0430 \u045e \u0441\u043a\u0456\u043d\u0456\u0456&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u041d\u0430\u0442\u0430\u043d \u0414\u0430\u0432\u0456\u0434\u0443: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u045e \u0446\u044f\u0431\u0435 \u043d\u0430 \u0441\u044d\u0440\u0446\u044b, \u0440\u0430\u0431\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0437 \u0422\u0430\u0431\u043e\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u0443\u044e \u0436 \u043d\u043e\u0447 \u0434\u0430 \u041d\u0430\u0442\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0441\u043a\u0430\u0436\u044b \u0414\u0430\u0432\u0456\u0434\u0443, \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u043c\u0443: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u043d\u0435 \u0442\u044b \u0437\u0431\u0443\u0434\u0443\u0435\u0448 \u041c\u043d\u0435 \u0434\u043e\u043c \u0434\u043b\u044f \u0436\u044b\u043b\u043b\u044f; \u0431\u043e \u042f \u043d\u0435 \u0436\u044b\u045e \u0443 \u0434\u043e\u043c\u0435 \u0437 \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0430\u0436\u043d\u043e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0445\u0430\u0434\u0437\u0456\u045e \u0430\u0434 \u0448\u0430\u0442\u0440\u0430 \u0434\u0430 \u0448\u0430\u0442\u0440\u0430 \u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u041a\u0443\u0434\u044b \u0431 \u042f \u043d\u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0446\u0456 \u0436 \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0445\u043e\u0446\u044c \u0440\u0430\u0437 \u043a\u0430\u043c\u0443-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437 \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u0445, \u044f\u043a\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439: \u0447\u0430\u043c\u0443 \u0432\u044b \u043d\u0435 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u041c\u043d\u0435 \u043a\u0435\u0434\u0440\u0430\u0432\u0430\u0433\u0430 \u0434\u043e\u043c\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0442\u0430\u043a \u0441\u043a\u0430\u0436\u0430\u0448 \u0441\u043b\u0443\u0433\u0443 \u041c\u0430\u0439\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0443: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f \u0437\u0430\u0431\u0440\u0430\u045e \u0446\u044f\u0431\u0435 \u0437 \u043f\u0430\u0448\u044b \u0430\u0434 \u0441\u0442\u0430\u0442\u043a\u0443 \u0430\u0432\u0435\u0447\u0430\u043a, \u043a\u0430\u0431 \u0442\u044b \u0441\u0442\u0430\u045e \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u0431\u044b\u045e \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0443\u0434\u044b \u0431 \u0442\u044b \u043d\u0456 \u0445\u0430\u0434\u0437\u0456\u045e, \u0456 \u042f \u043f\u0430\u0437\u043d\u0456\u0448\u0447\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u045e\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445. \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0432\u0430\u0451 \u0456\u043c\u044f, \u044f\u043a \u0456\u043c\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u042f \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043c\u0435\u0441\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043c\u0430\u0439\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044e, \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e \u044f\u0433\u043e, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u044f\u0446\u0446\u0430. \u0406 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0446\u044c \u044f\u0433\u043e, \u044f\u043a \u0440\u0430\u043d\u0435\u0439, \u0443 \u0442\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u041c\u0430\u0456\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u042f \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0443\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u0437\u0431\u0443\u0434\u0443\u0435 \u0442\u0430\u0431\u0435 \u0434\u043e\u043c. \u041a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u0446\u0430 \u0434\u043d\u0456 \u0442\u0432\u0430\u0435, \u0456 \u0442\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445, \u042f \u0430\u0434\u043d\u0430\u045e\u043b\u044e \u0442\u0432\u0430\u0451 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435, \u044f\u043a\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0456 \u045e\u043c\u0430\u0446\u0443\u044e \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041d\u0430\u0448\u0447\u0430\u0434\u0430\u043a \u0442\u0432\u043e\u0439 \u043f\u0430\u0431\u0443\u0434\u0443\u0435 \u043c\u043d\u0435 \u0434\u043e\u043c, \u0430 \u042f \u045e\u043c\u0430\u0446\u0443\u044e \u0442\u0440\u043e\u043d \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456. \u042f \u0431\u0443\u0434\u0443 \u044f\u043c\u0443 \u0430\u0439\u0446\u043e\u043c, \u0430 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0441\u044b\u043d\u0430\u043c. \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435 \u0437\u0430\u0431\u044f\u0440\u0443 \u0430\u0434 \u044f\u0433\u043e, \u044f\u043a \u0437\u0430\u0431\u0440\u0430\u045e \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e. \u0406 \u042f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u044f\u0433\u043e \u045e \u041c\u0430\u0456\u043c \u0434\u043e\u043c\u0435 \u0456 \u045e \u041c\u0430\u0456\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u0456 \u044f\u0433\u043e\u043d\u044b \u0442\u0440\u043e\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u043e\u0446\u043d\u0430 \u0441\u0442\u0430\u044f\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u041d\u0430\u0442\u0430\u043d \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b, \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f, \u044f\u043a\u0430\u044f \u043d\u0430\u0441\u0456\u043b\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0441\u0432\u0435\u0442\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0426\u044f\u0431\u0435, \u0456 \u043d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0456\u0442\u0430\u0439, \u041c\u0430\u0440\u044b\u044f, \u043f\u043e\u045e\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0456, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0426\u044f\u0431\u0435, \u0456 \u043d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"902","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 18 &ndash; 2, 5<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043a\u0440\u044b\u0436<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\"><em><span style=\"color: #ff0000;\"><\/span><\/em>\u0411\u0440\u0430\u0442\u044b: \u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0441\u043b\u043e\u0432\u0430 \u0430\u0431 \u043a\u0440\u044b\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u042f \u0437\u043d\u0456\u0448\u0447\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0456 \u0430\u0434\u043a\u0456\u043d\u0443 \u0440\u043e\u0437\u0443\u043c \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445. \u0414\u0437\u0435 \u043c\u0443\u0434\u0440\u044d\u0446? \u0414\u0437\u0435 \u043a\u043d\u0456\u0436\u043d\u0456\u043a? \u0414\u0437\u0435 \u0434\u0430\u0441\u043b\u0435\u0434\u0447\u044b\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0435\u043a\u0443? \u0426\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0411\u043e\u0433 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443 \u045e \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0451\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u0411\u043e \u044e\u0434\u044d\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0437\u043d\u0430\u043a\u0430\u045e, \u0430 \u0433\u0440\u044d\u043a\u0456 \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u041c\u044b \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e &ndash; \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u043f\u0430\u0434\u043a\u0443, \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0456 \u044e\u0434\u044d\u044f\u045e, \u0456 \u0433\u0440\u044d\u043a\u0430\u045e, \u0401\u043d &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0456 \u0411\u043e\u0436\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u0411\u043e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u045e \u0411\u043e\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0441\u043b\u0430\u0431\u043e\u0435 \u045e \u0411\u043e\u0433\u0430 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435. \u041d\u044f\u0448\u043c\u0430\u0442 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043c\u0443\u0434\u0440\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u043d\u044f\u0448\u043c\u0430\u0442 \u043c\u043e\u0446&shy;\u043d\u044b\u0445, \u043d\u044f\u0448\u043c\u0430\u0442 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u0445, \u0456 \u0441\u043b\u0430\u0431\u043e\u0435 \u0441\u0432\u0435\u0442\u0443 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u0445, \u0456 \u0431\u044f\u0437\u0440\u043e\u0434\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u0430\u0435, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0441\u043d\u0430\u0435, \u043a\u0430\u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u0456 \u0432\u044b \u0456\u0441\u043d\u0443\u0435\u0446\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435\u043c, \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u044f \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0435 \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0411\u043e \u044f \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u043d\u0435 \u0432\u0435\u0434\u0430\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u043c\u0456\u0436 \u0432\u0430\u0441, \u0430\u043f\u0440\u043e\u0447 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0442\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0456 \u045e \u0441\u0442\u0440\u0430\u0445\u0443, \u0456 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0456. \u0410 \u0441\u043b\u043e\u0432\u0430 \u043c\u0430\u0451 \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0430\u0451 \u043d\u0435 \u045e \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0447\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u045e \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0456 \u0434\u0443\u0445\u0430 \u0456 \u0441\u0456\u043b\u044b, \u043a\u0430\u0431 \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430\u044f \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u043b\u0430\u0441\u044f \u043d\u0435 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430 \u043d\u0430 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 10, 18. 19-20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0432\u0430\u0441 \u043f\u0430\u0441\u0442\u0430\u0432\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f, \u044f\u043a \u0430\u0431\u043e \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0443 \u0442\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u043d\u0435 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0430 \u0414\u0443\u0445 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0443 \u0442\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"903","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456&nbsp;<span style=\"color: #ff0000;\">3, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0414\u0443\u0448\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0443 \u0411\u043e\u0436\u044b\u0445 \u0440\u0443\u043a\u0430\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0448\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0443 \u0440\u0443\u043a\u0430\u0445 \u0411\u043e\u0433\u0430, \u0456 \u043d\u0435 \u0434\u0430\u043a\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445 \u043d\u0456\u044f\u043a\u0430\u044f \u043f\u0430\u043a\u0443\u0442\u0430. \u0423 \u0432\u0430\u0447\u0430\u0445 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0430 \u0456\u0445 \u0441\u043c\u0435\u0440\u0446\u044c \u043b\u0456\u0447\u044b\u043b\u0430\u0441\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435\u043c, \u0456\u0445 \u0430\u0434\u044b\u0445\u043e\u0434 \u0430\u0434 \u043d\u0430\u0441 \u043b\u0456\u0447\u044b\u045e\u0441\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435\u043c, \u0430 \u044f\u043d\u044b \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u043a\u043e\u0456. \u0425\u043e\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u043d\u044b \u0437\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c\u0456, \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u0441\u043b\u044f \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0441\u044f\u0431\u0435. \u0412\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445, \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430 \u045e \u043f\u0435\u0447\u044b, \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0456\u0445, \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f. \u041f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u044f \u044f\u043d\u044b \u0437\u0430\u0441\u0432\u0435\u0446\u044f\u0446\u044c \u0456 \u0440\u0430\u0437\u044b\u0434\u0443\u0446\u0446\u0430, \u044f\u043a \u0456\u0441\u043a\u0440\u044b \u045e \u0442\u0440\u044b\u0441\u043d\u044f\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0443\u0446\u044c \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456. \u0425\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e, \u0442\u043e\u0439 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043f\u0440\u0430\u045e\u0434\u0443, \u0430 \u0432\u0435\u0440\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u044b \u0406\u043c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u043b\u0430\u0441\u043a\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u042f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b \u0437\u0430 \u0441\u0432\u0430\u0435 \u0437\u0430\u0434\u0443\u043c\u044b, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u041f\u0430\u043d\u0430. \u041d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c. \u041c\u0430\u0440\u043d\u0430\u044f \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f, \u0431\u044f\u0441\u043f\u043b\u0451\u043d\u043d\u044b\u044f \u0456\u0445 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u044b. \u0406\u0445 \u0436\u043e\u043d\u043a\u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u0456\u0445 \u0434\u0437\u0435\u0446\u0456 \u043b\u0456\u0445\u0456\u044f, \u0430 \u0456\u0445\u043d\u0456 \u0440\u043e\u0434 &ndash; \u043f\u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u0456 \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u043b\u0430 \u0433\u0440\u044d\u0448\u043d\u0430\u0433\u0430 \u043b\u043e\u0436\u0430, \u0431\u043e \u045e \u0447\u0430\u0441 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u044f \u0434\u0443\u0448 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u0451\u043d. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0456 \u0435\u045e\u043d\u0443\u0445, \u044f\u043a\u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0440\u0443\u043a\u0430\u043c\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u043d\u0435 \u043f\u0430\u0434\u0443\u043c\u0430\u045e \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0431\u043e \u0437\u0430 \u044f\u0433\u043e\u043d\u0443\u044e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u044f\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0456 \u0441\u0430\u043c\u044b \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430. \u0411\u043e \u043f\u043b\u0451\u043d \u0434\u043e\u0431\u0440\u044b\u0445 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0441\u043b\u0430\u045e\u043d\u044b, \u0456 \u043a\u043e\u0440\u0430\u043d\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u043d\u0435 \u0432\u044b\u0441\u0430\u0445\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u0444 4, 4. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0436\u044b \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u045e\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u0437\u0430 \u041f\u0430\u043d\u0430. \u042f\u043d\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u044f\u043d\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043a\u0430\u0440\u043e\u043d\u0443 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0456\u0445 \u0431\u044b\u045e \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445 \u0456 \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u044f\u043d\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043a\u0430\u0440\u043e\u043d\u0443 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_1_ID":"904","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0456\u0440\u0430\u0445\u0430&nbsp;<span style=\"color: #ff0000;\">51, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0437\u044f\u043a\u0430 \u0411\u043e\u0433\u0443 \u0437\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0434 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u0411\u043e\u0433 \u043c\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u0431\u043e \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u0439 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439. \u0422\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043c\u0430\u0451 \u0446\u0435\u043b\u0430 \u0430\u0434 \u0437\u0433\u0443\u0431\u044b, \u0430\u0434 \u0441\u0435\u0442\u043a\u0456 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u044f\u0437\u044b\u043a\u0430 \u0456 \u0430\u0434 \u0432\u0443\u0441\u043d\u0430\u045e, \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u043f\u0430\u0434\u043c\u0430\u043d. \u041f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043c\u0430\u0456\u0445 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e, \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f \u0422\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u044b\u043a\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u043c\u044f\u043d\u0435; \u0430\u0434 \u0440\u0443\u043a \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043b\u044f\u0432\u0430\u045e \u043d\u0430 \u043c\u0430\u044e \u0434\u0443\u0448\u0443; \u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e, \u044f\u043a\u0456\u044f \u043c\u044f\u043d\u0435 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0456, \u0430\u0434 \u0437\u0430\u0434\u0443\u0448\u044d\u043d\u043d\u044f \u045e \u0430\u0433\u043d\u0456, \u044f\u043a\u0456 \u043c\u044f\u043d\u0435 \u0430\u0431\u043a\u0440\u0443\u0436\u044b\u045e, \u0456 \u0437 \u0430\u0433\u043d\u044f, \u044f\u043a\u0456 \u043d\u0435 \u044f \u0437\u0430\u043f\u0430\u043b\u0456\u045e; \u0430\u0434 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u0456; \u0430\u0434 \u044f\u0437\u044b\u043a\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430 &ndash; \u0430\u0434 \u043f\u0430\u043a\u043b\u0451\u043f\u0430\u045e \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u044f\u0437\u044b\u043a\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044f \u0434\u0443\u0448\u0430 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0430\u0441\u044f \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430 \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 \u0431\u044b\u043b\u043e \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u0443 \u043f\u0430\u0434\u0437\u044f\u043c\u0435\u043b\u043b\u0456. \u0417 \u0443\u0441\u0456\u0445 \u0431\u0430\u043a\u043e\u045e \u0430\u0431\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u043c\u044f\u043d\u0435, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0430\u043c\u0443 \u043c\u044f\u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c; \u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u044f\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u044f \u0437\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u044e, \u041f\u0430\u043d\u0435, \u0456 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u0432\u0430\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u044f\u043a \u0422\u044b \u0440\u0430\u0442\u0443\u0435\u0448 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0447\u0430\u043a\u0430\u0435 \u0426\u044f\u0431\u0435, \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u0448 \u0456\u0445 \u0430\u0434 \u0440\u0443\u043a \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e. \u042f \u045e\u0437\u043d\u044f\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u043c\u0430\u0451 \u043c\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u0443\u0446\u044f\u0447\u044b \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456. \u042f \u043a\u043b\u0456\u043a\u0430\u045e \u041f\u0430\u043d\u0430: &laquo;\u0422\u044b \u0410\u0439\u0446\u0435\u0446 \u043c\u043e\u0439, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u043c\u044f\u043d\u0435 \u045e \u0434\u043d\u0456 \u043d\u044f\u0434\u043e\u043b\u0456, \u0456 \u045e \u0434\u043d\u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u0445, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456. \u042f \u0431\u0443\u0434\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f \u0456 \u0430\u043f\u044f\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043c\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0447\u0443\u0442\u0430, \u0431\u043e \u0422\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0437\u0433\u0443\u0431\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0430\u0434 \u043b\u0456\u0445\u043e\u0439 \u043f\u0430\u0440\u044b. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435, \u0456 \u0430\u043f\u044f\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 51, 2; \u041f\u0441 31 (30), 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u0439 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0441\u044f\u043b\u044e\u0441\u044f \u0456 \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u0439 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_1_ID":"906","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">7, 7-16. 22-30<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0428\u0447\u0430\u0441\u0446\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u045e \u0411\u043e\u0433\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043c\u0430\u043b\u0456\u045e\u0441\u044f &ndash; \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435; \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e &ndash; \u0456 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u0434\u0443\u0445 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u042f \u0430\u0434\u0434\u0430\u045e \u0451\u0439 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0441\u043a\u0456\u043f\u0435\u0442\u0440\u0430\u043c\u0456 \u0456 \u0442\u0440\u043e\u043d\u0430\u043c\u0456, \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043d\u0456\u0447\u044b\u043c \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0443 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0451\u044e. \u042f \u043d\u0435 \u043f\u0430\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u045e \u0437 \u0451\u044e \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0431\u043e \u045e\u0441\u0451 \u0437\u043e\u043b\u0430\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0451\u044e &ndash; \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b \u043f\u044f\u0441\u043e\u043a, \u0430 \u0441\u0440\u044d\u0431\u0440\u0430 \u043f\u0435\u0440\u0430\u0434 \u0451\u0439 &ndash; \u044f\u043a \u0431\u0440\u0443\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0437\u0434\u0430\u0440\u043e\u045e\u0435 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0456 \u0431\u043e\u043b\u044c\u0448 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u043c\u0435\u0446\u044c \u044f\u0435 \u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u043b\u044f\u0441\u043a \u044f\u0435 &ndash; \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u044b. \u0410 \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u044e \u0434\u0430 \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e\u0441\u0435 \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0456 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u045e \u044f\u0435 \u0440\u0443\u043a\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u045e\u0441\u0446\u0435\u0448\u044b\u045e\u0441\u044f \u045e\u0441\u044f\u043c\u0443, \u0431\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u0432\u044f\u043b\u0430 \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0456\u0445 \u043c\u0430\u0446\u0456. \u042f \u0448\u0447\u044b\u0440\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u045e, \u0431\u0435\u0437 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u044e \u0456 \u043d\u0435 \u0445\u0430\u0432\u0430\u044e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u044f\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0431\u043e \u0433\u044d\u0442\u0430 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u044b \u0441\u043a\u0430\u0440\u0431 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439. \u0422\u044b\u044f, \u0445\u0442\u043e \u044f\u0433\u043e \u0437\u0434\u0430\u0431\u044b\u045e, \u043d\u0430\u0431\u044b\u043b\u0456 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0434\u0430\u0440\u0430\u043c\u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u0434\u0430\u045e \u043c\u043d\u0435 \u0411\u043e\u0433 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435\u043c, \u0430 \u0434\u0443\u043c\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u0442\u0430\u0433\u043e, \u0447\u044b\u043c \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0401\u043d &ndash; \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0435 \u043c\u0443\u0434\u0440\u044b\u0445. \u0411\u043e \u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u0440\u0443\u043a\u0430\u0445 \u0456 \u043c\u044b, \u0456 \u043d\u0430\u0448\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u043a\u0442\u044b\u0447\u043d\u0430\u0435 \u045e\u043c\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0434\u0443\u0445 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0456 \u0441\u0432\u044f\u0442\u044b, \u0430\u0434\u0437\u0456\u043d\u044b, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b, \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u044b, \u0440\u0443\u0445\u043b\u0456\u0432\u044b, \u044f\u0441\u043d\u044b, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u044b, \u043d\u044f\u0448\u043a\u043e\u0434\u043d\u044b, \u0434\u0430\u0431\u0440\u0430\u043b\u044e\u0431\u043d\u044b, \u0432\u043e\u0441\u0442\u0440\u044b, \u043d\u044f\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b, \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u044b, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043b\u044e\u0431\u043d\u044b, \u043f\u044d\u045e\u043d\u044b, \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b, \u0431\u0435\u0441\u043a\u043b\u0430\u043f\u043e\u0442\u043d\u044b, \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u045e\u0441\u0451\u0431\u0430\u0447\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0435 \u0434\u0443\u0445\u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u043d\u0430\u0439\u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0435\u0439\u0448\u044b\u044f. \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0440\u0443\u0445\u043b\u0456\u0432\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u045e\u0441\u044f\u043a\u0456 \u0440\u0443\u0445; \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451 \u0434\u0437\u0435\u043b\u044f \u0447\u044b\u0441\u0446\u0456\u043d\u0456 \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b, \u0447\u044b\u0441\u0442\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u043c\u0435\u043d\u044c\u0432\u0430\u043d\u043d\u0435 \u0441\u043b\u0430\u0432\u044b \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u0456 \u0442\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u0440\u0443\u0434\u043d\u0430\u0433\u0430 \u045e \u044f\u0435 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c. \u0413\u044d\u0442\u0430 \u0437\u0437\u044f\u043d\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u043b\u044e\u0441\u0442\u0440\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u0437\u0435\u044f\u043d\u043d\u044f, \u0432\u043e\u0431\u0440\u0430\u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u042f\u0433\u043e\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0430\u0434\u043d\u0430, \u0430\u043b\u0435 \u045e\u0441\u0451 \u043c\u043e\u0436\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u043e\u0439, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435, \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0443\u0448\u044b \u0441\u0432\u044f\u0442\u044b\u0445, \u0440\u044b\u0445\u0442\u0443\u0435 \u0441\u044f\u0431\u0440\u043e\u045e \u0411\u043e\u0436\u044b\u0445 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e. \u0411\u043e\u0433 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u042f\u043d\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u0430\u044f \u0430\u0434 \u0441\u043e\u043d\u0446\u0430 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0441\u0443\u0437\u043e\u0440&rsquo;\u044f. \u0423 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u044f\u043d\u0430 \u0437\u043e\u0439\u043c\u0435 \u043f\u0435\u0440\u0448\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u0431\u043e \u0437\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u043e\u0447, \u0430 \u0437\u043b\u043e \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0434\u0440 7, 7-8; \u042f\u043a 1, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043c\u0430\u043b\u0456\u045e\u0441\u044f &ndash; \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435; <span style=\"color: #ff0000;\">*<\/span> \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e &ndash; \u0456 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u0434\u0443\u0445 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u042f \u0430\u0434\u0434\u0430\u045e \u0451\u0439 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0441\u043a\u0456\u043f\u0435\u0442\u0440\u0430\u043c\u0456 \u0456 \u0442\u0440\u043e\u043d\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u043c\u0443 \u0437 \u0432\u0430\u0441 \u043d\u0435\u0441\u0442\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0443 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u0456 \u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e &ndash; \u0456 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u0434\u0443\u0445 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u042f \u0430\u0434\u0434\u0430\u045e \u0451\u0439 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0441\u043a\u0456\u043f\u0435\u0442\u0440\u0430\u043c\u0456 \u0456 \u0442\u0440\u043e\u043d\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"907","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">7, 25-40<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0410\u0434\u043d\u043e\u0441\u043d\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430 \u044f \u043d\u0435 \u043c\u0430\u044e \u043d\u0430\u043a\u0430\u0437\u0443 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e \u0441\u0432\u0430\u0451 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u044f\u043a \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u0432\u0430\u0440\u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0440\u0443. \u0422\u0430\u043c\u0443 \u0437&shy;\u0437\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u044f \u043b\u0456\u0447\u0443 \u0441\u043b\u0443\u0448\u043d\u044b\u043c, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043b\u0435\u043f\u0448 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c. \u0422\u044b \u0437\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0437 \u0436\u043e\u043d\u043a\u0430\u044e? \u041d\u0435 \u0448\u0443\u043a\u0430\u0439 \u0440\u0430\u0437\u0432\u043e\u0434\u0443. \u0422\u044b \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u0436\u043e\u043d\u043a\u0456? \u041d\u0435 \u0448\u0443\u043a\u0430\u0439 \u0436\u043e\u043d\u043a\u0456. \u041a\u0430\u043b\u0456 \u0442\u044b \u0456 \u0430\u0436\u0430\u043d\u0456\u045e\u0441\u044f, \u0442\u043e \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u0456 \u043a\u0430\u043b\u0456 \u0434\u0437\u0435\u0432\u0430 \u0432\u044b\u0439\u0448\u043b\u0430 \u0437\u0430\u043c\u0443\u0436, \u0442\u043e \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0430. \u0410\u043b\u0435 \u0442\u0430\u043a\u0456\u044f \u0437\u0432\u0435\u0434\u0430\u044e\u0446\u044c \u043d\u044f\u0434\u043e\u043b\u044e \u045e \u0446\u0435\u043b\u0435, \u0430 \u044f \u0436 \u0448\u043a\u0430\u0434\u0443\u044e \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0447\u0430\u0441. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0436\u043e\u043d\u0430\u043a, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435; \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043f\u043b\u0430\u0447\u0430; \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430; \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0443\u043f\u043b\u044f\u0435, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0431\u044b\u0432\u0430\u0435; \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0430\u043c, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u0431\u043e \u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<br \/>\u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0431\u0435\u0441\u043a\u043b\u0430\u043f\u043e\u0442\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0436\u0430\u043d\u0430\u0442\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u044f\u043a \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u041f\u0430\u043d\u0443. \u0410 \u0436\u0430\u043d\u0430\u0442\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0436\u043e\u043d\u0446\u044b, \u0456 \u0451\u043d \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u044b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0437\u0430\u043c\u0443\u0436\u043d\u044f\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0456 \u0434\u0437\u0435\u0432\u0430 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u044e \u0456 \u0446\u0435\u043b\u0430\u043c, \u0456 \u0434\u0443\u0445\u0430\u043c, \u0430 \u0437\u0430\u043c\u0443\u0436\u043d\u044f\u044f \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u043c\u0443\u0436\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u0432\u0430\u0448\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0430 \u0432\u0430\u0441 \u043f\u0443\u0442\u044b, \u0430\u043b\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0432\u044b \u0434\u043e\u0431\u0440\u0430\u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430 \u0456 \u043d\u0435\u0430\u0434\u0440\u044b\u045e\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e&shy;\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0437\u0435\u0432\u0430\u0439, \u0431\u043e \u043c\u0456\u043d\u0430\u044e\u0446\u044c \u0443\u0436\u043e \u0433\u0430\u0434\u044b \u044f\u0435 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435, \u044f\u043a \u0445\u043e\u0447\u0430, \u0451\u043d \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0436\u044d\u043d\u044f\u0446\u0446\u0430. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043f\u0440\u044b\u043c\u0443\u0441\u0443, \u043f\u0430\u043d\u0443\u044e\u0447\u044b \u043d\u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u044f\u0439, \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430, \u0442\u043e\u0439 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u043e\u0431\u0440\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044d\u043d\u0456\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430\u0439, \u0430\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0436\u044d\u043d\u0456\u0446\u0446\u0430, \u0440\u043e\u0431\u0456\u0446\u044c \u044f\u0448\u0447\u044d \u043b\u0435\u043f\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u043e\u043d\u043a\u0430 \u0437\u0432\u044f\u0437\u0430\u043d\u0430\u044f \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u0441\u0443, \u043a\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u0435 \u044f\u0435 \u043c\u0443\u0436; \u0430\u0434\u043d\u0430\u043a \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0451\u0440 \u044f\u0435 \u043c\u0443\u0436, \u044f\u043d\u0430 \u043c\u043e\u0436\u0430 \u0432\u044b\u0439\u0441\u0446\u0456 \u0437\u0430\u043c\u0443\u0436 \u0437\u0430 \u043a\u0430\u0433\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u0435, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u041f\u0430\u043d\u0443. \u0410\u0434\u043d\u0430\u043a \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u0431\u044b\u043b\u0430 \u0431, \u043a\u0430\u043b\u0456 \u0431 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0442\u0430\u043a, \u044f\u043a \u044f \u0440\u0430\u044e. \u0414\u0443\u043c\u0430\u044e, \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u044e \u0411\u043e\u0436\u0430\u0433\u0430 \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0422\u0432\u0430\u0451\u0439 \u043a\u0440\u0430\u0441\u044b, \u044f\u043a\u0443\u044e \u0441\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e. \u0401\u043d \u0442\u0432\u043e\u0439 \u0411\u043e\u0433 \u0456 \u0442\u0432\u043e\u0439 \u0412\u0430\u043b\u0430\u0434\u0430\u0440. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0442\u0432\u043e\u0439 \u041a\u0430\u0440\u043e\u043b\u044c \u0456 \u0442\u0432\u043e\u0439 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0431\u044f\u0440\u044d\u0448 \u0448\u043b\u044e\u0431 \u0437 \u041a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u043f\u0430\u0441\u0430\u0433, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0446\u044f\u0431\u0435, \u0430\u0434\u0443\u043a\u0443\u043f\u0456\u045e \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0442\u0432\u043e\u0439 \u041a\u0430\u0440\u043e\u043b\u044c \u0456 \u0442\u0432\u043e\u0439 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a.<\/p>\r\n"}, {"GCH_CH_1_ID":"5011","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0432\u0456\u0433\u0456\u043b\u0456\u044f \u0437\u0430\u043c\u044f\u043d\u044f\u0435 \u0413\u0430\u0434\u0437\u0456\u043d\u0443 \u0447\u044b\u0442\u0430\u043d\u043d\u044f\u045e. \u0422\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u0432\u0430 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0439 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0432\u0456\u0433\u0456\u043b\u0456\u0456, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0446\u044c \u0437 \u044f\u0435 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0447\u0430\u0442\u044b\u0440\u044b \u0447\u044b\u0442\u0430\u043d\u043d\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0435\u0441\u043d\u044f\u043c\u0456 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456. \u041f\u0430\u0436\u0430\u0434\u0430\u043d\u0430 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0456\u0436\u044d\u0439 \u0447\u044b\u0442\u0430\u043d\u043d\u0456.<\/span><br \/><span style=\"color: #ff0000;\">\u0413\u044d\u0442\u044b \u0410\u0444\u0456\u0446\u044b\u0439 \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0430 \u0437 \u0447\u044b\u0442\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0417\u044b\u0445\u043e\u0434\u0443 <span style=\"color: #ff0000;\">14, 15 &ndash; 15,1\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0430 \u0441\u0443\u0448\u044b \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u0421\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u0448 \u0434\u0430 \u041c\u044f\u043d\u0435? \u0421\u043a\u0430\u0436\u044b \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c. \u0410 \u0442\u044b \u043f\u0430\u0434\u044b\u043c\u0456 \u043a\u0456\u0439 \u0441\u0432\u043e\u0439 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043c\u043e\u0440\u0430, \u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u0456 \u044f\u0433\u043e, \u0456 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u044f\u0440\u043e\u0434 \u043c\u043e\u0440\u0430 \u043f\u0430 \u0441\u0443\u0448\u044b. \u042f \u0436 \u0437\u0440\u0430\u0431\u043b\u044e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u045e\u0441\u043b\u0435\u0434 \u0437\u0430 \u0456\u043c\u0456. \u0406 \u043f\u0430\u043a\u0430\u0436\u0443 \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e \u043d\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0435 \u0456 \u045e\u0441\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c, \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u0445 \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445. \u0406 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0430\u0436\u0443 \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e \u043d\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0435 \u0456 \u045e\u0441\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0443 \u044f\u0433\u043e\u043d\u044b\u043c, \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u0445 \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0440\u0443\u0448\u044b\u045e\u0441\u044f \u0430\u043d\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0456\u0448\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0437\u0430\u0434\u0443, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0456 \u0441\u043b\u0443\u043f \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u0443\u043d\u0443\u045e\u0441\u044f \u0441\u043f\u0435\u0440\u0430\u0434\u0443 \u043d\u0430\u0437\u0430\u0434. \u0421\u0442\u0430\u045e \u043f\u0430\u043c\u0456\u0436 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u043c \u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456\u043c; \u0456 \u0431\u044b\u043b\u0430 \u0445\u043c\u0430\u0440\u0430 \u0446\u0451\u043c\u043d\u0430\u044f \u0434\u043b\u044f \u0430\u0434\u043d\u044b\u0445, \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u043b\u0430 \u043d\u043e\u0447 \u0434\u0440\u0443\u0433\u0456\u043c \u0442\u0430\u043a, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u045e\u0441\u044e \u043d\u043e\u0447 \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0434\u0430 \u043c\u043e\u0440\u0430, \u041f\u0430\u043d \u0433\u043d\u0430\u045e \u043c\u043e\u0440\u0430 \u043c\u043e\u0446\u043d\u044b\u043c \u0443\u0441\u0445\u043e\u0434\u043d\u0456\u043c \u0432\u0435\u0442\u0440\u0430\u043c \u0443\u0441\u044e \u043d\u043e\u0447 \u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0443 \u0441\u0443\u0448\u0443, \u0456 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0432\u0430\u0434\u0430. \u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430 \u043f\u0430 \u0441\u0443\u0448\u044b; \u0432\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u0456\u0445 \u0441\u0446\u044f\u043d\u043e\u044e \u0437 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0456 \u0437 \u043b\u0435\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443. \u0406 \u043f\u0430\u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u0437\u0430 \u0456\u043c\u0456 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430 \u045e\u0441\u044f \u043a\u043e\u043d\u043d\u0456\u0446\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f. \u0406 \u0432\u043e\u0441\u044c \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u041f\u0430\u043d \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u0441\u0430 \u0441\u043b\u0443\u043f\u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0433\u0430 \u0456 \u0432\u043e\u0431\u043b\u0430\u0447\u043d\u0430\u0433\u0430, \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0435 \u0432\u043e\u0439\u0441\u043a\u0430 \u0456\u0445\u043d\u044f\u0435. \u0406 \u043f\u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e \u043a\u043e\u043b\u044b \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0430\u045e, \u0448\u0442\u043e \u0456\u043c \u0446\u044f\u0436\u043a\u0430 \u0431\u044b\u043b\u043e \u0440\u0443\u0445\u0430\u0446\u0446\u0430. \u0406 \u043a\u0430\u0437\u0430\u043b\u0456 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435: &laquo;\u0423\u0446\u044f\u043a\u0430\u0439\u043c\u0430 \u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0431\u043e \u041f\u0430\u043d \u0432\u0430\u044e\u0435 \u0437\u0430 \u0456\u0445 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u041f\u0440\u0430\u0446\u044f\u0433\u043d\u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043c\u043e\u0440\u0430, \u043a\u0430\u0431 \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0432\u043e\u0434\u044b \u0434\u0430 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e, \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445&raquo;. \u0406 \u043a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0440\u0443\u043a\u0443 \u0434\u0430 \u043c\u043e\u0440\u0430, \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u044f\u043d\u043e \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430, \u0456 \u0431\u0435\u0433\u043b\u0430 \u0432\u0430\u0434\u0430 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u043c, \u044f\u043a\u0456\u044f \u045e\u0446\u044f\u043a\u0430\u043b\u0456; \u0456 \u043f\u0430\u0442\u0430\u043f\u0456\u045e \u0456\u0445 \u041f\u0430\u043d \u0441\u044f\u0440\u043e\u0434 \u0445\u0432\u0430\u043b\u044f\u045e. \u0412\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0432\u0430\u0434\u0430 \u0456 \u043d\u0430\u043a\u0440\u044b\u043b\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u0443\u0441\u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u044f\u043a\u043e\u0435 \u045e\u0432\u0430\u0439\u0448\u043b\u043e \u0437\u0430 \u0456\u043c\u0456 \u045e \u043c\u043e\u0440\u0430, \u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0437 \u0456\u0445. \u0410 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0430 \u0441\u0443\u0448\u044b \u043f\u0440\u0430\u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0443 \u043c\u043e\u0440\u0430, \u0456 \u0432\u0430\u0434\u0430 \u0441\u0442\u0430\u044f\u043b\u0430 \u043a\u0430\u043b\u044f \u0456\u0445 \u0441\u0446\u044f\u043d\u043e\u044e \u0437 \u043b\u0435\u0432\u0430\u0433\u0430 \u0456 \u0437 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u041f\u0430\u043d \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0437 \u0440\u0443\u043a \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u0445. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u043c\u043e\u0440\u0430. \u0423\u0431\u0430\u0447\u044b\u043b\u0456 \u043c\u043e\u0446\u043d\u0443\u044e \u0440\u0443\u043a\u0443, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0443\u0437\u043d\u044f\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0430\u045e. \u0421\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043d\u0430\u0440\u043e\u0434 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u041f\u0430\u043d\u0443 \u0456 \u041c\u0430\u0439\u0441\u0435\u044e, \u0441\u043b\u0443\u0433\u0443 \u042f\u0433\u043e\u043d\u0430\u043c\u0443.<br \/>\u0422\u0430\u0434\u044b \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u043f\u0435\u0441\u043d\u044e \u041f\u0430\u043d\u0443:<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u0421\u043f\u044f\u0432\u0430\u044e \u041f\u0430\u043d\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0401\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0441\u043d\u044f (\u0417\u044b\u0445 15, 1b-6. 17-18)<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u044f\u0432\u0430\u044e \u041f\u0430\u043d\u0443, \u0431\u043e \u0401\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f, *<br \/>\u043a\u0430\u043d\u044f \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430 \u0441\u043a\u0456\u043d\u0443\u045e \u0443 \u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043c\u0430\u044f \u0441\u0456\u043b\u0430 \u0456 \u043c\u0430\u044f \u043f\u0435\u0441\u043d\u044f, *<br \/>\u0401\u043d \u0441\u0442\u0430\u045e \u043c\u0430\u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043c\u043e\u0439 \u0411\u043e\u0433, \u042f\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e. *<br \/>\u0401\u043d \u0411\u043e\u0433 \u0430\u0439\u0446\u0430 \u043c\u0430\u0439\u0433\u043e, \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0443 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435, *<br \/>\u041f\u0430\u043d \u042f\u0433\u043e \u0456\u043c\u044f!<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u044b \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430 *<br \/>\u0401\u043d \u043a\u0456\u043d\u0443\u045e \u0443 \u043c\u043e\u0440\u0430,<\/p>\r\n<p style=\"text-align: justify;\">\u043b\u0435\u043f\u0448\u044b\u044f \u0432\u0430\u044f\u0440\u044b \u044f\u0433\u043e\u043d\u044b\u044f *<br \/>\u043f\u0430\u0442\u0430\u043d\u0443\u043b\u0456 \u045e \u0427\u044b\u0440\u0432\u043e\u043d\u044b\u043c \u043c\u043e\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0435\u0437\u0434\u0430\u043d\u044c \u0456\u0445 \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430, *<br \/>\u044f\u043d\u044b \u0441\u044b\u0448\u043b\u0456 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0432\u0456\u0446\u0430 \u0422\u0432\u0430\u044f, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u043c\u043e\u0446\u0430\u044e, *<br \/>\u043f\u0440\u0430\u0432\u0456\u0446\u0430 \u0422\u0432\u0430\u044f, \u041f\u0430\u043d\u0435, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0430 \u0432\u043e\u0440\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 &dagger;<br \/>\u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u044f\u0433\u043e \u043d\u0430 \u0433\u0430\u0440\u044b \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439, *<br \/>\u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u043b\u043b\u0451\u043c, \u041f\u0430\u043d\u0435,<\/p>\r\n<p style=\"text-align: justify;\">\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0443\u044e \u045e\u0437\u0432\u044f\u043b\u0456 \u0422\u0432\u0430\u0435 \u0440\u0443\u043a\u0456. *<br \/>\u041f\u0430\u043d &ndash; \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u0421\u043f\u044f\u0432\u0430\u044e \u041f\u0430\u043d\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0401\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041c\u0410\u041b\u0406\u0422\u0412\u0410<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0440\u0430\u0441\u043a\u0440\u044b\u045e \u043d\u0430\u043c \u0441\u044d\u043d\u0441 \u0441\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u0456\u0445 \u0446\u0443\u0434\u0430\u045e; \u043c\u043e\u0440\u0430 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u043d\u0430\u0439 \u043a\u0443\u043f\u0435\u043b\u0456, \u0430 \u043b\u044e\u0434, \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0437 \u043d\u044f\u0432\u043e\u043b\u0456, &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u044f\u0432\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443; \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0437\u0434\u0430\u0431\u044b\u045e\u0448\u044b \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0431\u044b\u043b\u0456 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u0421\u0432\u044f\u0442\u044b\u043c \u0414\u0443\u0445\u0430\u043c. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f <span style=\"color: #ff0000;\">36, 16-28<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0410\u043a\u0440\u0430\u043f\u043b\u044e \u0432\u0430\u0441 \u0432\u0430\u0434\u043e\u044e \u0447\u044b\u0441\u0442\u0430\u044e \u0456 \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430 \u043d\u043e\u0432\u0430\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435: &laquo;\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0436\u044b\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u0432\u0430\u0451\u0439 \u0456 \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u045e \u044f\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456; \u0456\u0445\u043d\u044f\u044f \u0434\u0430\u0440\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u0434\u0430 \u041c\u043d\u043e\u044e \u044f\u043a \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u045e \u0447\u0430\u0441 \u044f\u0435 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u042f \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0456\u0445 \u0433\u043d\u0435\u045e \u041c\u043e\u0439 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0456 \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u044f\u0435 \u0456\u0434\u0430\u043b\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456. I \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u045e \u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u044f\u043d\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u043f\u0430 \u0437\u0435\u043c\u043b\u044f\u0445. \u042f \u0441\u0443\u0434\u0437\u0456\u045e \u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u045e. I \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u043f\u0430\u0439\u0448\u043b\u0456, \u0456 \u0433\u0430\u043d\u044c\u0431\u0456\u043b\u0456 \u0456\u043c\u044f \u041c\u0430\u0451, \u0431\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u0456\u0445, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434 \u041f\u0430\u043d\u0430 \u0456 \u0448\u0442\u043e \u0437 \u0437\u044f\u043c\u043b\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u044b\u0439\u0448\u043b\u0456 \u044f\u043d\u044b. \u042f \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f \u0441\u0432\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u043d\u044f\u0441\u043b\u0430\u0432\u0456\u045e \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u0439\u0448\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0436\u044b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0448\u0442\u043e \u0442\u0430\u043a \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d \u0411\u043e\u0433: \u041d\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430, \u0430 \u0434\u0437\u0435\u043b\u044f \u041c\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0456\u043c\u044f, \u044f\u043a\u043e\u0435 \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u043b\u0456 \u0432\u044b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u0439\u0448\u043b\u0456. \u042f \u0430\u0441\u0432\u044f\u0447\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f \u041c\u0430\u0451, \u0437\u043d\u044f\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0443 \u044f\u043a\u0456\u0445 \u0432\u044b \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u043b\u0456 \u044f\u0433\u043e, \u0456 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u043d\u0430\u0440\u043e\u0434\u044b, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, &ndash; \u043a\u0430\u043b\u0456 \u041c\u0430\u044f \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0456\u0445\u043d\u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">I \u0432\u0430\u0437\u044c\u043c\u0443 \u0432\u0430\u0441 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u0437\u0431\u044f\u0440\u0443 \u0437 \u0443\u0441\u0456\u0445 \u0437\u0435\u043c\u043b\u044f\u045e, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0432\u0430\u0441 \u0443 \u0437\u044f\u043c\u043b\u044e \u0432\u0430\u0448\u0443\u044e. \u0410\u043a\u0440\u0430\u043f\u043b\u044e \u0432\u0430\u0441 \u0432\u0430\u0434\u043e\u044e \u0447\u044b\u0441\u0442\u0430\u044e, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0431\u0440\u0443\u0434\u0443 \u0432\u0430\u0448\u0430\u0433\u0430, \u0456 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u042f \u0430\u0447\u044b\u0448\u0447\u0443 \u0432\u0430\u0441. I \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0434\u0443\u0445 \u043d\u043e\u0432\u044b \u045e \u043d\u0443\u0442\u0440\u043e \u0432\u0430\u0448\u0430\u0435; \u0456 \u0437\u0430\u0431\u044f\u0440\u0443 \u0441\u044d\u0440\u0446\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0435 \u0437 \u0446\u0435\u043b\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0456 \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430 \u0437 \u043f\u043b\u043e\u0446\u0456. \u0414\u0443\u0445 \u041c\u043e\u0439 \u0443\u0434\u044b\u0445\u043d\u0443 \u045e \u043d\u0443\u0442\u0440\u043e \u0432\u0430\u0448\u0430\u0435 \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0442\u0430\u043a, \u0448\u0442\u043e \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0417\u0430\u043a\u043e\u043d\u0435 \u041c\u0430\u0456\u043c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u041c\u0430\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445. \u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u045e \u0430\u0439\u0446\u0430\u043c \u0432\u0430\u0448\u044b\u043c, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u041c\u0430\u0456\u043c, \u0430 \u042f \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u042f\u043a \u043b\u0430\u043d\u044c \u043f\u0440\u0430\u0433\u043d\u0435 \u0432\u0430\u0434\u044b \u0437 \u043f\u0430\u0442\u043e\u043a\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043a \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430. <span style=\"color: #ff0000;\">&dagger;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0441\u0430\u043b\u044c\u043c 42 (41), 2-3. 5b\u0441d; 43 (42), 3-4<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043b\u0430\u043d\u044c \u043f\u0440\u0430\u0433\u043d\u0435 \u0432\u0430\u0434\u044b \u0437 \u043f\u0430\u0442\u043e\u043a\u0443, *<br \/>\u0442\u0430\u043a \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">&dagger;<\/span> \u0414\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0411\u043e\u0433\u0430, *<br \/>\u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0439\u0434\u0443 *<br \/>\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0436\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0441\u0430 \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u0430\u0439 \u0433\u0440\u0430\u043c\u0430\u0434\u043e\u0439&nbsp;\u0443 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0448\u0430\u0446\u0451\u0440, \u0443 \u0414\u043e\u043c \u0411\u043e\u0436\u044b *<br \/>\u0441\u044f\u0440\u043e\u0434 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u045e\u0434\u0443; &dagger;<br \/>\u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u043c\u043d\u043e\u0439 *<br \/>\u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443\u0446\u044c \u043c\u044f\u043d\u0435 \u043d\u0430 \u0433\u0430\u0440\u0443 \u0422\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u0443\u044e \u0456 \u045e \u0422\u0432\u0430\u0435 \u0448\u0430\u0442\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u043f\u0430\u0434\u044b\u0434\u0443 \u0434\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u0411\u043e\u0433\u0430, &dagger;<br \/>\u0434\u0430 \u0411\u043e\u0433\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439. *<br \/>\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e \u0426\u044f\u0431\u0435 \u043d\u0430 \u0430\u0440\u0444\u0435, \u0411\u043e\u0436\u0430, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u042f\u043a \u043b\u0430\u043d\u044c \u043f\u0440\u0430\u0433\u043d\u0435 \u0432\u0430\u0434\u044b \u0437 \u043f\u0430\u0442\u043e\u043a\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043a \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041c\u0410\u041b\u0406\u0422\u0412\u0410<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u0430\u044f \u043c\u043e\u0446 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0433\u043b\u044f\u043d\u044c \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043d\u0430 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u044f\u0442\u044b \u0456, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u0430\u0434\u0432\u0435\u0447\u043d\u044b \u043d\u0430\u043c\u0435\u0440 \u0422\u0432\u043e\u0439, \u0443 \u0441\u0443\u043f\u0430\u043a\u043e\u0456 \u0441\u043f\u0430\u045e\u043d\u044f\u0439 \u0441\u043f\u0440\u0430\u0432\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f; \u043d\u044f\u0445\u0430\u0439 \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0422\u044b \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u0430\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u0448, \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u043b\u0430\u0435 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0448 \u0456 \u045e\u0441\u0451 \u0432\u044f\u0440\u0442\u0430\u0435\u0448 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u0446\u044d\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u045e\u0437\u044f\u043b\u043e \u043f\u0430\u0447\u0430\u0442\u0430\u043a. \u042f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c\u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_CH_1_ID":"5012","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <span style=\"color: #ff0000;\">1, 1-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0451\u0442\u0440, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u044b\u0445\u0430\u0434\u043d\u044f\u043c \u0434\u044b\u044f\u0441\u043f\u0430\u0440\u044b \u041f\u043e\u043d\u0442\u0430, \u0413\u0430\u043b\u0430\u0442\u044b\u0456, \u041a\u0430\u043f\u0430\u0434\u043e\u043a\u0456\u0456, \u0410\u0437\u0456\u0456 \u0456 \u0411\u0456\u0442\u044b\u043d\u0456\u0456, \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u043c \u0443 \u0414\u0443\u0445\u0443 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u043a\u0440\u0430\u043f\u043b\u0435\u043d\u043d\u044f \u043a\u0440\u044b\u0432\u0451\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u043b\u0430\u0441\u043a\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u0434\u0430 \u0436\u044b\u0432\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0439, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0456 \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u0430\u0439, \u044f\u043a\u0430\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0434\u043b\u044f \u0432\u0430\u0441, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u0445 \u0441\u0456\u043b\u0430\u044e \u0411\u043e\u0436\u0430\u0439 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0433\u0430\u0442\u043e\u0432\u0430\u0433\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0430\u043f\u043e\u0448\u043d\u0456 \u0447\u0430\u0441. \u0413\u044d\u0442\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u0456 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0442\u0440\u043e\u0445\u0456 \u043f\u0430\u0441\u0443\u043c\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0434\u0447\u0430\u0441 \u0440\u043e\u0437\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043f\u0440\u0430\u0432\u0435\u0440\u0430\u043d\u0430\u044f \u0432\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u043d\u0430\u0448\u043c\u0430\u0442 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0439 \u0437\u0430 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a\u043e\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0430\u0433\u043d\u0451\u043c, \u043d\u0430 \u0441\u043b\u0430\u0432\u0443, \u0456 \u0445\u0432\u0430\u043b\u0443, \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u043f\u0430\u0434\u0447\u0430\u0441 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0425\u043e\u0446\u044c \u0432\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u043b\u044e\u0431\u0456\u0446\u0435 \u042f\u0433\u043e \u0456, \u0445\u043e\u0446\u044c \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u0435 \u042f\u0433\u043e, \u0432\u0435\u0440\u044b\u0446\u0435 \u045e \u042f\u0433\u043e. \u0412\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044e \u0456 \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u044e, \u0434\u0430\u0441\u044f\u0433\u0430\u044e\u0447\u044b \u043c\u044d\u0442\u044b \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439 &ndash; \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0443\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0448\u0443\u043a\u0430\u043b\u0456 \u0456 \u0434\u0430\u043f\u044b\u0442\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0443\u044e \u0432\u0430\u043c \u043b\u0430\u0441\u043a\u0443. \u042f\u043d\u044b \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456, \u043d\u0430 \u043a\u0430\u043b\u0456 \u0456 \u043d\u0430 \u044f\u043a\u0456 \u0447\u0430\u0441 \u0443\u043a\u0430\u0437\u0432\u0430\u045e \u0414\u0443\u0445 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443 \u0456\u0445 \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u043b\u0430\u0432\u0443 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430. \u0414\u043b\u044f \u0456\u0445 \u0431\u044b\u043b\u043e \u0430\u0434\u043a\u0440\u044b\u0442\u0430, \u0448\u0442\u043e \u043d\u0435 \u0456\u043c, \u0430 \u0432\u0430\u043c \u0441\u043b\u0443\u0436\u044b\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b\u043c \u0437 \u043d\u0435\u0431\u0430 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0443 \u0448\u0442\u043e \u0445\u043e\u0447\u0443\u0446\u044c \u0437\u0430\u0437\u0456\u0440\u043d\u0443\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0430\u043d\u0451\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0440\u043e\u0437\u0443\u043c\u0443 \u0432\u0430\u0448\u0430\u0433\u0430, \u0447\u0443\u0432\u0430\u0439\u0446\u0435 \u0456 \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u043d\u0430 \u043b\u0430\u0441\u043a\u0443, \u044f\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430 \u0432\u0430\u043c \u0443 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043a \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0434\u0437\u0435\u0446\u0456, \u043d\u0435 \u0434\u0430\u0441\u0442\u0430\u0441\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u045e, \u044f\u043a\u0456\u044f \u0432\u044b \u043c\u0435\u043b\u0456 \u0440\u0430\u043d\u0435\u0439, \u0443 \u0447\u0430\u0441 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u043d\u0430 \u045e\u0437\u043e\u0440 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441, \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u0432\u0430\u0448\u044b\u0445. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u042f \u0441\u0432\u044f\u0442\u044b&raquo;. \u041a\u0430\u043b\u0456 \u0432\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0435 \u0410\u0439\u0446\u043e\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0435\u043f\u0440\u0430\u0434\u0443\u0437\u044f\u0442\u0430 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445, \u0442\u043e \u0441\u0430 \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0447\u0430\u0441 \u0432\u0430\u0448\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u043d\u043d\u044f, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043d\u0435 \u0442\u043b\u0435\u043d\u043d\u044b\u043c \u0441\u0435\u0440\u0430\u0431\u0440\u043e\u043c \u0446\u0456 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0432\u044b \u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u0432\u0430\u043c \u0430\u0439\u0446\u0430\u043c\u0456, \u0430\u043b\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044e \u043a\u0440\u044b\u0432\u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0456 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430. \u0401\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u044f\u0448\u0447\u044d \u0434\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441, \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0456 \u0430\u0434\u0430\u0440\u044b\u045e \u0445\u0432\u0430\u043b\u043e\u044e, \u043a\u0430\u0431 \u0432\u044b \u043c\u0435\u043b\u0456 \u0432\u0435\u0440\u0443 \u0456 \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 1, 3. 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u0434\u0430 \u0436\u044b\u0432\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 <span style=\"color: #ff0000;\">*<\/span> \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0440\u043e\u0437\u0443\u043c\u0443 \u0432\u0430\u0448\u0430\u0433\u0430, \u0447\u0443\u0432\u0430\u0439\u0446\u0435 \u0456 \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u043d\u0430 \u043b\u0430\u0441\u043a\u0443, \u044f\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430 \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5013","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <span style=\"color: #ff0000;\">1, 22 &ndash; 2, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0416\u044b\u0446\u0446\u0451 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0447\u044b\u0441\u0446\u0456\u045e\u0448\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0434\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f \u0434\u043b\u044f \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0439 \u0431\u0440\u0430\u0442\u043d\u044f\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0448\u0447\u044b\u0440\u0430 \u043b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0431\u043e \u0432\u044b \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0437\u043d\u043e\u045e \u043d\u0435 \u0437 \u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430 \u043d\u0430\u0441\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0437 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430, \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0436\u044b\u0432\u0435 \u0456 \u0442\u0440\u044b\u0432\u0430\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 &ndash; \u0431\u044b\u0446\u0446\u0430\u043c \u0442\u0440\u0430\u0432\u0430, \u0430 \u045e\u0441\u044f \u0441\u043b\u0430\u0432\u0430 \u044f\u0433\u043e &ndash; \u0431\u044b\u0446\u0446\u0430\u043c \u0446\u0432\u0435\u0442 \u0442\u0440\u0430\u0432\u044b: \u0442\u0440\u0430\u0432\u0430 \u0437\u0430\u0432\u044f\u043b\u0430 &ndash; \u0456 \u0430\u043f\u0430\u045e \u0446\u0432\u0435\u0442. \u0410 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u0406 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0451\u0441\u0446\u044c \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u044f \u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0430\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u045e\u0441\u044f\u043a\u0443\u044e \u0437\u043b\u043e\u0441\u0446\u044c \u0456 \u045e\u0441\u044f\u043a\u0456 \u043f\u043e\u0434\u0441\u0442\u0443\u043f, \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c \u0434\u044b \u045e\u0441\u044f\u043a\u0430\u0435 \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u0435, \u044f\u043a \u043d\u043e\u0432\u0430\u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u044b, \u0436\u0430\u0434\u0430\u0439\u0446\u0435 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u043c\u0430\u043b\u0430\u043a\u0430 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0431\u043e \u0432\u044b \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043b\u0456, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u0451\u0441\u0446\u044c \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b \u0434\u0430 \u042f\u0433\u043e, \u0436\u044b\u0432\u043e\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u044f, \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u0430\u0433\u0430 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0430\u043b\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430, \u0456 \u0432\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0411\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u0456: &laquo;\u0412\u043e\u0441\u044c \u044f \u043a\u043b\u0430\u0434\u0443 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435 \u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0432\u044b\u0431\u0440\u0430\u043d\u044b, \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b, \u0456 \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043d\u0435 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u0446\u0430&raquo;. \u0422\u0430\u043c\u0443, \u0434\u043b\u044f \u0432\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u0401\u043d &ndash; \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c, \u0430 \u0434\u043b\u044f \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 &ndash; &laquo;\u043a\u0430\u043c\u0435\u043d\u044c, \u044f\u043a\u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0456. \u0401\u043d \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430&raquo;, \u0456 &laquo;\u043a\u0430\u043c\u0435\u043d\u0435\u043c \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0435\u043d\u043d\u044f \u0456 \u0441\u043a\u0430\u043b\u043e\u0439 \u0441\u043f\u0430\u043a\u0443\u0441\u044b&raquo;. \u042f\u043d\u044b \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u044e\u0446\u0446\u0430 \u0430\u0431 \u044f\u0433\u043e, \u0431\u043e \u043d\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0443, \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f\u043d\u044b \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0436 &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0446\u043d\u043e\u0442\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 5. 9\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0436 &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5014","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <span style=\"color: #ff0000;\">2, 11-25<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 &ndash; \u0447\u0443\u0436\u044b\u043d\u0446\u044b \u045e \u0441\u0432\u0435\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0432\u0430\u0441 \u044f\u043a \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e \u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e \u0443\u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u045e, \u0448\u0442\u043e \u0432\u0430\u044e\u044e\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0443\u0448\u044b. \u0421\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0441\u044f\u0431\u0435 \u0434\u043e\u0431\u0440\u0430, \u043a\u0430\u0431, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u044f\u043a \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u044f\u043d\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u0411\u043e\u0433\u0430 \u045e \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0432\u0435\u0434\u0437\u0456\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u0439 \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u0443\u043b\u0430\u0434\u0437\u0435 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043d\u0430: \u0446\u0456 \u0442\u043e \u043a\u0430\u0440\u0430\u043b\u044e, \u044f\u043a \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u043c\u0443 \u045e\u043b\u0430\u0434\u0430\u0440\u0443, \u0446\u0456 \u0442\u043e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0456\u043c \u0434\u043b\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e \u0456 \u0434\u043b\u044f \u043f\u0430\u0445\u0432\u0430\u043b\u044b \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u0430\u045e. \u0411\u043e \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0442\u044b\u043c, \u043a\u0430\u0431, \u0440\u043e\u0431\u044f\u0447\u044b \u0434\u0430\u0431\u0440\u043e, \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0456 \u0437\u0430\u043c\u0430\u045e\u0447\u0430\u0446\u044c \u043d\u0435\u0432\u0443\u0446\u0442\u0432\u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u041f\u0430\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u044b\u044f \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u0430 \u043d\u0435 \u044f\u043a \u0442\u044b\u044f, \u0448\u0442\u043e \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0434\u043b\u044f \u043f\u0440\u044b\u043a\u0440\u044b\u0446\u0446\u044f \u0437\u043b\u0430. \u041f\u0430\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u045e\u0441\u0456\u0445, \u043b\u044e\u0431\u0456\u0446\u0435 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430, \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0411\u043e\u0433\u0430, \u0448\u0430\u043d\u0443\u0439\u0446\u0435 \u043a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0433\u0456, \u0437 \u0443\u0441\u0451\u0439 \u0431\u043e\u044f\u0437\u0437\u044e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430\u043c, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c, \u0430\u043b\u0435 \u0456 \u0441\u0443\u0440\u043e\u0432\u044b\u043c. \u0411\u043e \u0433\u044d\u0442\u0430 \u043b\u0430\u0441\u043a\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0437 \u0434\u0443\u043c\u043a\u0430\u044e \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u042f\u043a\u0430\u044f \u0432\u0430\u043c \u043f\u0430\u0445\u0432\u0430\u043b\u0430, \u043a\u0430\u043b\u0456 \u0431&rsquo;\u044e\u0446\u044c \u0432\u0430\u0441 \u0437\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u044b? \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0447\u044b\u043d\u0456\u0446\u0435 \u0434\u0430\u0431\u0440\u043e \u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u0435, \u0442\u043e \u043c\u0430\u0435\u0446\u0435 \u043b\u0430\u0441\u043a\u0443 \u045e \u0411\u043e\u0433\u0430. \u0412\u044b \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b; \u0431\u043e \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u0432\u0430\u0441, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0432\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0433\u0440\u0430\u0445\u0443, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445. \u0401\u043d, \u043a\u0430\u043b\u0456 \u042f\u043c\u0443 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u043b\u0456, \u043d\u0435 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u045e \u0443 \u0430\u0434\u043a\u0430\u0437, \u043a\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u045e, \u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e, \u0430\u043b\u0435 \u0434\u0430\u0432\u044f\u0440\u0430\u045e \u0441\u044f\u0431\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0401\u043d \u0441\u0430\u043c, \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0436\u044b\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0420\u0430\u043d\u0430\u043c\u0456 \u042f\u0433\u043e \u0432\u044b \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u044b\u044f. \u0411\u043e \u0432\u044b \u0431\u044b\u043b\u0456, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0456, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u0410\u0445\u043e\u045e\u043d\u0456\u043a\u0430 \u0434\u0443\u0448 \u0432\u0430\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 21. 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0441\u0430\u043c, \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0436\u044b\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5015","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <span style=\"color: #ff0000;\">3, 1-17 <\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b, \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u0432\u0430\u0456\u043c \u043c\u0443\u0436\u0430\u043c, \u043a\u0430\u0431, \u0442\u044b\u044f \u0437 \u0456\u0445, \u044f\u043a\u0456\u044f \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u0443, \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u0431\u044b\u043b\u0456 \u0437\u0434\u0430\u0431\u044b\u0442\u044b\u044f \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b. \u041d\u044f\u0445\u0430\u0439 \u0430\u0437\u0434\u043e\u0431\u0430\u044e \u0432\u0430\u0448\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435 \u0432\u043e\u043d\u043a\u0430\u0432\u0430\u0435 \u0437\u0430\u043f\u043b\u044f\u0442\u0430\u043d\u043d\u0435 \u0432\u0430\u043b\u0430\u0441\u043e\u045e, \u043d\u0435 \u0437\u0430\u043b\u0430\u0442\u043e\u0435 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0435 \u0446\u0456 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u045e\u043a\u0440\u044b\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u044d\u0440\u0446\u0430 \u045e \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0456 \u0440\u0430\u0445\u043c\u0430\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u0443, \u044f\u043a\u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u0411\u043e \u0433\u044d\u0442\u0430\u043a \u043d\u0435\u043a\u0430\u043b\u0456 \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u0436\u043e\u043d\u043a\u0456, \u044f\u043a\u0456\u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043b\u0456 \u0441\u044f\u0431\u0435, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0441\u0432\u0430\u0456\u043c \u043c\u0443\u0436\u0430\u043c. \u0413\u044d\u0442\u0430\u043a \u0421\u0430\u0440\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0439 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u044f\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c. \u0412\u044b \u0441\u0442\u0430\u043b\u0456 \u044f\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0431\u043e \u0440\u043e\u0431\u0456\u0446\u0435 \u0434\u0430\u0431\u0440\u043e \u0456 \u043d\u0435 \u0431\u0430\u0456\u0446\u0435\u0441\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b, \u043c\u0443\u0436\u044b, \u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u0436\u044b\u0432\u0443\u0447\u044b \u0437 \u0456\u043c\u0456, \u044f\u043a \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u0430\u043c\u0443 \u0436\u0430\u043d\u043e\u0447\u0430\u043c\u0443 \u043d\u0430\u0447\u044b\u043d\u043d\u044e \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u043b\u0430\u0441\u043a\u0456 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0432\u0430\u0448\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0447\u0443\u043b\u044b\u043c\u0456, \u043b\u044e\u0431\u044f\u0447\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u043e\u045e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456. \u041d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0437\u043b\u043e\u043c \u0437\u0430 \u0437\u043b\u043e \u0446\u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439 \u0437\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0443, \u0430\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435, \u0431\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0434\u043d\u0456, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0437\u044b\u043a \u0430\u0434 \u0437\u043b\u0430, \u0430 \u0432\u0443\u0441\u043d\u044b &ndash; \u0430\u0434 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443. \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u043d\u044f\u0445\u0430\u0439 \u0448\u0443\u043a\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0456\u043c. \u0411\u043e \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0456 \u0432\u0443\u0448\u044b \u042f\u0433\u043e &ndash; \u043d\u0430 \u0456\u0445\u043d\u0456\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0430\u043b\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0443\u043f\u043b\u0456\u045e\u0446\u0430\u043c\u0456 \u0434\u0430\u0431\u0440\u0430, \u0442\u043e \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u0435 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f! \u0410 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f. \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u0434\u0430\u0446\u044c \u0430\u0434\u043a\u0430\u0437 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0432\u0430\u0441 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443 \u043d\u0430\u0434\u0437\u0435\u044e. \u0410\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430, \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0411\u043e\u0436\u0430\u0439 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0443 \u0442\u044b\u043c, \u0437\u0430 \u0448\u0442\u043e \u0430\u0431\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u044f\u043a \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0431\u044b\u043b\u0456 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u0430\u043d\u0456\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u0435\u043f\u0435\u0439, \u043a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0447\u044b\u043c \u0437\u0430 \u0431\u043b\u0430\u0433\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 6, 22. 23\u0430; 1 \u041f 3, 14\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043b\u0456 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u0441 \u043b\u044e\u0434\u0437\u0456 \u0456 \u0437-\u0437\u0430 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0456\u043c\u044f \u0432\u0430\u0448\u0430\u0435, \u044f\u043a \u0437\u043b\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0432\u0430\u0448\u0430\u044f \u045e \u043d\u0435\u0431\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u0435 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0432\u0430\u0448\u0430\u044f \u045e \u043d\u0435\u0431\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5016","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <span style=\"color: #ff0000;\">3, 18 &ndash; 4, 11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0427\u0430\u043a\u0430\u043d\u043d\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0440\u0430\u0437 \u043f\u0430\u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u0433\u0440\u0430\u0445\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0437\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0432\u0430\u0441 \u0434\u0430 \u0411\u043e\u0433\u0430. \u0417\u0430\u0431\u0456\u0442\u044b \u045e \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u045e \u0414\u0443\u0445\u0443. \u0423 \u0406\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0442\u044b\u043c \u0434\u0443\u0445\u0430\u043c, \u0448\u0442\u043e \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u044f\u043a\u0456\u044f \u043d\u0435\u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456, \u043a\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u044f \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0447\u0430\u043a\u0430\u043b\u0430 \u045e \u0434\u043d\u0456 \u041d\u043e\u044f, \u0443 \u0447\u0430\u0441 \u043f\u0430\u0431\u0443\u0434\u043e\u0432\u044b \u043a\u0430\u045e\u0447\u044d\u0433\u0430, \u043d\u0430 \u044f\u043a\u0456\u043c \u043d\u044f\u043c\u043d\u043e\u0433\u0456\u044f, \u0443\u0441\u044f\u0433\u043e \u0432\u043e\u0441\u0435\u043c \u0434\u0443\u0448, \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0430\u0434 \u0432\u0430\u0434\u044b. \u042f\u043d\u0430 \u0456 \u0432\u0430\u0441 \u0441\u0451\u043d\u043d\u044f, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0437\u043e\u0440\u0443, \u0440\u0430\u0442\u0443\u0435 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442, \u043d\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431\u043c\u044b\u0446\u0446\u0451 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0443 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456, \u0443\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u043d\u0435\u0431\u0430, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430, \u0456 \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u0430\u043d\u0451\u043b\u044b \u0456 \u045e\u043b\u0430\u0434\u044b, \u0456 \u043c\u043e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441 \u0443 \u0446\u0435\u043b\u0435, \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u0431\u0440\u043e\u0439\u0446\u0435\u0441\u044f \u0442\u043e\u0439 \u0436\u0430 \u0434\u0443\u043c\u043a\u0430\u0439, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043f\u0430\u043a\u0443\u0442\u044b \u0446\u0435\u043b\u0430, \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0437 \u0433\u0440\u0430\u0445\u043e\u043c, \u043a\u0430\u0431 \u0430\u0441\u0442\u0430\u0442\u043d\u0456 \u0447\u0430\u0441 \u0443 \u0446\u0435\u043b\u0435 \u0436\u044b\u0446\u044c \u0443\u0436\u043e \u043d\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0434\u043b\u044f \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439. \u0425\u043e\u043f\u0456\u0446\u044c \u0456 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0432\u044b \u0441\u043f\u0430\u045e\u043d\u044f\u043b\u0456 \u0432\u043e\u043b\u044e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0436\u044b\u043b\u0456 \u045e \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435, \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f&rsquo;\u044f\u043d\u0441\u0442\u0432\u0435, \u0433\u0443\u043b\u044f\u043d\u043a\u0430\u0445 \u0456 \u043f&rsquo;\u044f\u043d\u043a\u0430\u0445, \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0435. \u042f\u043d\u044b \u0456 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0446\u0446\u0430, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u0437\u0430\u043d\u0443\u0440\u0430\u0435\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u045e \u0430\u0434\u043d\u0443 \u043f\u043b\u044b\u043d\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b, \u0456 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u0432\u0430\u0441. \u042f\u043d\u044b \u0437\u0434\u0430\u0434\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0430\u0437\u0434\u0430\u0447\u0443 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0433\u0430\u0442\u043e\u0432\u044b \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0436\u044b\u0432\u044b\u0445 \u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. \u0411\u043e \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u0456 \u0441\u0443\u0434\u0443 \u044f\u043a \u043b\u044e\u0434\u0437\u0456 \u045e \u0446\u0435\u043b\u0435, \u0430 \u0436\u044b\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u0443\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u043a\u0430\u043d\u0435\u0446 \u0443\u0441\u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0456 \u0447\u0443\u0432\u0430\u0439\u0446\u0435 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u043c\u0430\u0439\u0446\u0435 \u0448\u0447\u044b\u0440\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u044b\u044f \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u0435\u0437 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f\u045e. \u042f\u043a \u0434\u043e\u0431\u0440\u044b\u044f \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439, \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0442\u044b\u043c \u0434\u0430\u0440\u0430\u043c, \u044f\u043a\u0456 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u0430\u0442\u0440\u044b\u043c\u0430\u045e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435, \u044f\u043a \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0436\u044b\u044f; \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043e\u0446\u044b, \u044f\u043a\u043e\u044e \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u044f\u0433\u043e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u043c\u0443 \u0441\u043b\u0430\u0432\u0430 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 3, 18. 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u0433\u0440\u0430\u0445\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0437\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0432\u0430\u0441 \u0434\u0430 \u0411\u043e\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0417\u0430\u0431\u0456\u0442\u044b \u0443 \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u045e \u0414\u0443\u0445\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d, \u0443\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u043d\u0435\u0431\u0430, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430, \u0456 \u042f\u043c\u0443 \u043f\u0430\u043a\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u0430\u043d\u0451\u043b\u044b \u0456 \u045e\u043b\u0430\u0434\u044b, \u0456 \u043c\u043e\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u0431\u0456\u0442\u044b \u0443 \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u045e \u0414\u0443\u0445\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5017","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430 <span style=\"color: #ff0000;\">4, 12 &ndash; 5, 14<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u043d\u043d\u0435 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0435 \u0434\u0437\u0456\u0432\u0456\u0446\u0435\u0441\u044f \u0430\u0433\u043d\u044e, \u044f\u043a\u0456 \u043f\u0430\u043b\u0430\u0435 \u045e \u0432\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0430\u0433\u0430, \u043d\u0456\u0431\u044b \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0432\u0430\u043c\u0456 \u043d\u0435\u0448\u0442\u0430 \u0434\u0437\u0456\u045e\u043d\u0430\u0435. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u043c\u0443\u043a\u0430\u0445 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0456 \u045e \u0447\u0430\u0441 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e \u0432\u044b \u045e\u0441\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f. \u041a\u0430\u043b\u0456 \u0433\u0430\u043d\u044f\u0446\u044c \u0432\u0430\u0441 \u0437\u0430 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e \u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0431\u043e \u0414\u0443\u0445 \u0441\u043b\u0430\u0432\u044b \u0456 \u0414\u0443\u0445 \u0411\u043e\u0436\u044b \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u043d\u0430 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u044f\u043a \u0437\u0430\u0431\u043e\u0439\u0446\u0430 \u0430\u0431\u043e \u0437\u043b\u043e\u0434\u0437\u0435\u0439, \u0430\u0431\u043e \u044f\u043a \u0437\u043b\u0430\u0447\u044b\u043d\u0435\u0446, \u0430\u0431\u043e \u044f\u043a \u0441\u043a\u0432\u0430\u043f\u043d\u044b \u0434\u0430 \u0447\u0443\u0436\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435\u0445\u0442\u0430 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u044f\u043a \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0411\u043e\u0433\u0430 \u0437\u0430 \u0433\u044d\u0442\u0430 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u045e\u0436\u043e \u0447\u0430\u0441, \u043a\u0430\u0431 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e\u0441\u044f \u0441\u0443\u0434 \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u0434\u043e\u043c\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0451\u043d \u0440\u0430\u0441\u043f\u0430\u0447\u043d\u0435\u0446\u0446\u0430 \u0437 \u043d\u0430\u0441, \u0434\u044b\u043a \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043d\u0435\u0446 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430? &laquo;\u0406 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u0437 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044e \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0434\u0437\u0435 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a \u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a?&raquo; \u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0442\u044b\u044f, \u0445\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0437 \u0432\u043e\u043b\u0456 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0443\u0446\u044c \u042f\u043c\u0443 \u044f\u043a \u0432\u0435\u0440\u043d\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u0441\u0432\u0430\u0435 \u0434\u0443\u0448\u044b, \u0440\u043e\u0431\u044f\u0447\u044b \u0434\u0430\u0431\u0440\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u044f\u043a \u0430\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445, \u044f\u043a \u0441\u0432\u0435\u0434\u043a\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a \u0441\u043b\u0430\u0432\u044b, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0432\u0456\u0446\u0435 \u0441\u0442\u0430\u0442\u0430\u043a \u0411\u043e\u0436\u044b, \u0448\u0442\u043e \u043f\u0440\u044b \u0432\u0430\u0441, \u043d\u0430\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u044b \u0437\u0430 \u0456\u043c \u043d\u0435 \u043f\u0430\u0434 \u043f\u0440\u044b\u043c\u0443\u0441\u0430\u043c, \u0430\u043b\u0435 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0432\u043e\u043b\u044f\u0439 \u0411\u043e\u0436\u0430\u0439, \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0430\u0433\u0456\u0434\u043d\u0430\u0439 \u043d\u0430\u0436\u044b\u0432\u044b, \u0430\u043b\u0435 \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c. \u041d\u0435 \u0437\u043b\u043e\u045e\u0436\u044b\u0432\u0430\u0439\u0446\u0435 \u045e\u043b\u0430\u0434\u0430\u044e \u043d\u0430\u0434 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456, \u0430\u043b\u0435 \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0434\u043b\u044f \u0441\u0442\u0430\u0442\u043a\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u0432\u044b \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u044b \u0432\u044f\u043d\u043e\u043a \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b, \u043c\u0430\u043b\u043e\u0434\u0448\u044b\u044f, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043c. \u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e\u0441\u0435 \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0443\u044e \u043f\u0430\u043a\u043e\u0440\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u043c, \u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0434\u0430\u0435 \u043b\u0430\u0441\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456 \u043f\u0430\u0434 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0411\u043e\u0436\u0430\u044e, \u043a\u0430\u0431 \u0401\u043d \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0432\u0430\u0441 \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441. \u0423\u0441\u044f\u043b\u044f\u043a\u0456 \u0441\u0432\u043e\u0439 \u043a\u043b\u043e\u043f\u0430\u0442 \u0443\u0441\u043a\u043b\u0430\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u042f\u0433\u043e, \u0431\u043e \u0401\u043d \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0432\u0430\u0441. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c\u0456, \u0447\u0443\u0432\u0430\u0439\u0446\u0435. \u041f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a \u0432\u0430\u0448, \u0434&rsquo;\u044f\u0431\u0430\u043b, \u044f\u043a \u043b\u0435\u045e \u043a\u0440\u0443\u0436\u044b\u0446\u044c \u0437 \u0440\u044b\u043a\u0430\u043c, \u0448\u0443\u043a\u0430\u044e\u0447\u044b, \u043a\u0430\u0433\u043e \u043f\u0430\u0436\u044d\u0440\u0446\u0456. \u041c\u043e\u0446\u043d\u044b\u044f \u045e \u0432\u0435\u0440\u044b, \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0442\u0430\u043a\u0456\u044f \u0436 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u045e \u0441\u0432\u0435\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0411\u043e\u0433 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e \u044f\u043a \u043a\u0440\u044b\u0445\u0443 \u043f\u0430\u0446\u0435\u0440\u043f\u0456\u0446\u0435, \u0441\u0430\u043c \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c, \u0437\u0430\u0433\u0430\u0440\u0442\u0443\u0435, \u0443\u043c\u0430\u0446\u0443\u0435 \u0456 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0432\u0430\u0441 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c\u0456. \u042f\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0421\u0456\u043b\u044c\u0432\u0430\u043d\u0430, \u044f\u043a\u0456 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u0435\u0440\u043d\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u044f \u043a\u043e\u0440\u0430\u0442\u043a\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0447\u044b \u0456 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0442\u0430\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0436\u0430\u044f, \u0443 \u044f\u043a\u043e\u0439 \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435. \u0412\u0456\u0442\u0430\u0435 \u0432\u0430\u0441 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u044f, \u044f\u043a \u0456 \u0432\u044b, \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u041c\u0430\u0440\u043a, \u0441\u044b\u043d \u043c\u043e\u0439. \u041f\u0440\u044b\u0432\u0456\u0442\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u043a\u043e\u0439 \u0443\u0441\u0456\u043c \u0432\u0430\u043c, \u044f\u043a\u0456\u044f \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 4, 13; \u041b\u043a 6, 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u043c\u0443\u043a\u0430\u0445 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0443 \u0447\u0430\u0441 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e \u0432\u044b \u045e\u0441\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043b\u0456 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u0441 \u043b\u044e\u0434\u0437\u0456 \u0437-\u0437\u0430 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0443 \u0447\u0430\u0441 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u042f\u0433\u043e \u0432\u044b \u045e\u0441\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5021","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u045e <span style=\"color: #ff0000;\">3, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430; \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0431\u043e \u0432\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0440\u0430\u0431\u0456\u0446\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435 \u045e \u0446\u0435\u043b\u0435 \u0432\u0430\u0448\u044b\u043c: \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u043c\u043e\u0446\u043d\u0430\u0435 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0435, \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0456 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430\u043c. \u0417-\u0437\u0430 \u0433\u044d\u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0433\u043d\u0435\u045e \u0411\u043e\u0436\u044b \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u044b\u043d\u043e\u045e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u0456 \u0432\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0445\u0430\u0434\u0437\u0456\u043b\u0456, \u043a\u0430\u043b\u0456 \u0436\u044b\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u0456 \u0432\u044b \u0430\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0433\u044d\u0442\u0430 \u045e\u0441\u0451: \u0433\u043d\u0435\u045e, \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435, \u0437\u043b\u043e\u0441\u0446\u044c, \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430, \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u0435 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0432\u0430\u0448\u044b\u0445. \u041d\u0435 \u0445\u043b\u0443\u0441\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u0431\u043e \u0432\u044b \u0437\u043d\u044f\u043b\u0456 \u0437 \u0441\u044f\u0431\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u043d\u043e\u0432\u0430\u0433\u0430, \u044f\u043a\u0456 \u0430\u0431\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e. \u0406 \u0442\u0443\u0442 \u0443\u0436\u043e \u043d\u044f\u043c\u0430 \u043d\u0456 \u0433\u0440\u044d\u043a\u0430, \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u043d\u0456 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f, \u043d\u0456 \u0432\u0430\u0440\u0432\u0430\u0440\u0430, \u043d\u0456 \u0441\u043a\u0456\u0444\u0430, \u043d\u0456 \u0440\u0430\u0431\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0436 \u044f\u043a \u0432\u044b\u0431\u0440\u0430\u043d\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u0432\u044f\u0442\u044b\u044f \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0443 \u0448\u0447\u044b\u0440\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u043f\u0430\u043a\u043e\u0440\u0443, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0434\u0430\u0440\u0443\u044e\u0447\u044b \u0441\u0430\u0431\u0435 \u045e\u0437\u0430\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0430 \u043a\u0430\u0433\u043e \u043c\u0430\u0435 \u043a\u0440\u044b\u045e\u0434\u0443; \u044f\u043a \u041f\u0430\u043d \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0432\u0430\u043c, \u0442\u0430\u043a \u0456 \u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0430\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0406 \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0441\u043f\u0430\u043a\u043e\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0406 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441 \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0446\u0435, \u0437 \u0443\u0441\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u043c\u0456, \u0433\u0456\u043c\u043d\u0430\u043c\u0456 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u043f\u0435\u0441\u043d\u044f\u043c\u0456, \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0411\u043e\u0433\u0443. \u0406 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0456 \u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c, \u0443\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 1. 2. 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5022","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">1, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0430\u0447\u0430\u043d\u043d\u0435 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u0434\u0430\u045e \u042f\u043c\u0443 \u0411\u043e\u0433, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u0448\u0442\u043e \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430. \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430, \u043f\u0430\u0441\u043b\u0430\u045e\u0448\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043d\u0451\u043b\u0430 \u0434\u0430 \u0441\u043b\u0443\u0433\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u042f\u043d\u0430, \u044f\u043a\u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u043f\u0440\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u045e. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0445\u0442\u043e \u0447\u044b\u0442\u0430\u0435, \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u045e \u0456\u043c, \u0431\u043e \u0447\u0430\u0441 \u0431\u043b\u0456\u0437\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d &ndash; \u0441\u044f\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0443 \u0410\u0437\u0456\u0456: \u043b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c, \u0456 \u0431\u044b\u045e, \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0456 \u0430\u0434 \u0441\u044f\u043c\u0456 \u0414\u0443\u0445\u0430\u045e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u043c \u0442\u0440\u043e\u043d\u0430\u043c, \u0456 \u0430\u0434 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0434\u043a\u0456, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0456 \u0423\u043b\u0430\u0434\u0430\u0440\u0430 \u0437\u044f\u043c\u043d\u044b\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u043d\u0430\u0441 \u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0401\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0430\u0431\u043b\u043e\u043a\u0430\u043c\u0456, \u0456 \u043a\u043e\u0436\u043d\u0430\u0435 \u0432\u043e\u043a\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e, \u0456 \u045e\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u0446\u044f\u045e \u042f\u0433\u043e. \u0406 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u045e\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043a, \u0430\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u042f &ndash; \u0410\u043b\u044c\u0444\u0430 \u0456 \u0410\u043c\u0435\u0433\u0430, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433, &ndash; \u044f\u043a\u0456 \u0451\u0441\u0446\u044c, \u044f\u043a\u0456 \u0431\u044b\u045e \u0456 \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0431\u0440\u0430\u0442 \u0432\u0430\u0448 \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456 \u045e \u0415\u0437\u0443\u0441\u0435, \u0431\u044b\u045e \u043d\u0430 \u0432\u043e\u0441\u0442\u0440\u0430\u0432\u0435, \u0437\u0432\u0430\u043d\u044b\u043c \u041f\u0430\u0442\u043c\u0430\u0441, \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u043f\u0440\u0430 \u0415\u0437\u0443\u0441\u0430. \u042f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u0443 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0447\u0443\u045e \u0437\u0430 \u0441\u0430\u0431\u043e\u044e \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u0431\u044b\u0446\u0446\u0430\u043c \u0442\u0440\u0443\u0431\u044b, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0428\u0442\u043e \u0431\u0430\u0447\u044b\u0448, \u0437\u0430\u043f\u0456\u0448\u044b \u045e \u043a\u043d\u0456\u0437\u0435 \u0456 \u043f\u0430\u0448\u043b\u0456 \u0441\u044f\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c: \u0443 \u042d\u0444\u0435\u0441, \u0443 \u0421\u043c\u0456\u0440\u043d\u0443, \u0443 \u041f\u044d\u0440\u0433\u0430\u043c, \u0443 \u0422\u044b\u044f\u0442\u044b\u0440\u0443, \u0443 \u0421\u0430\u0440\u0434\u044b, \u0443 \u0424\u0456\u043b\u0430\u0434\u044d\u043b\u044c\u0444\u0456\u044e \u0456 \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u044e&raquo;. \u042f \u0430\u0431\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u043a\u0430\u0431 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c, \u0447\u044b\u0439 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u043c\u044f\u043d\u0435. \u0406 \u043a\u0430\u043b\u0456 \u0430\u0431\u044f\u0440\u043d\u0443\u045e\u0441\u044f, \u0442\u043e \u045e\u0431\u0430\u0447\u044b\u045e \u0441\u0435\u043c \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e, \u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u0433\u0430 \u045e \u0434\u043e\u045e\u0433\u0456\u044f \u0448\u0430\u0442\u044b \u0456 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437a\u043d\u0430\u0433\u0430 \u043d\u0430 \u0433\u0440\u0443\u0434\u0437\u044f\u0445 \u0437\u0430\u043b\u0430\u0442\u044b\u043c \u043f\u0430\u0441\u0430\u043c. \u0410 \u042f\u0433\u043e \u0433\u0430\u043b\u0430\u0432\u0430 \u0456 \u0432\u0430\u043b\u0430\u0441\u044b \u0431\u044b\u043b\u0456 \u0431\u0435\u043b\u044b\u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u0435\u043b\u0430\u044f \u0432\u043e\u045e\u043d\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u043d\u0435\u0433, \u0430 \u0432\u043e\u0447\u044b \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u044f\u043a \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e. \u041d\u043e\u0433\u0456 \u0436 \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0431\u0440\u043e\u043d\u0437\u044b, \u043d\u0456\u0431\u044b \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0439 \u0443 \u043f\u0435\u0447\u044b, \u0430 \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e &mdash; \u044f\u043a \u0448\u0443\u043c \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0432\u0430\u0434\u044b. \u0423 \u043f\u0440\u0430\u0432\u0430\u0439 \u0440\u0443\u0446\u044d \u0441\u0432\u0430\u0451\u0439 \u0401\u043d \u043c\u0435\u045e \u0441\u0435\u043c \u0437\u043e\u0440\u0430\u043a, \u0430 \u0437 \u042f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u045e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0432\u043e\u0441\u0442\u0440\u044b \u0434\u0432\u0443\u0445\u0431\u0430\u043a\u043e\u0432\u044b \u043c\u0435\u0447, \u0456 \u0442\u0432\u0430\u0440 \u042f\u0433\u043e \u0431\u044b\u045e \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0448\u0442\u043e \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u042f\u0433\u043e, \u0443\u043f\u0430\u045e \u0434\u0430 \u043d\u043e\u0433 \u042f\u0433\u043e\u043d\u044b\u0445, \u043d\u0456\u0431\u044b \u043c\u0451\u0440\u0442\u0432\u044b. \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u0446\u0443 \u0441\u0432\u0430\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0441\u044f! \u042f &mdash; \u043f\u0435\u0440\u0448\u044b \u0456 \u0430\u043f\u043e\u0448\u043d\u0456, \u0456 \u0436\u044b\u0432\u044b; \u0456 \u0431\u044b\u045e \u043c\u0451\u0440\u0442\u0432\u044b, \u0456 \u0432\u043e\u0441\u044c \u0436\u044b\u0432\u044b \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f; \u0456 \u043c\u0430\u044e \u043a\u043b\u044e\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u0456. \u0422\u0430\u043c\u0443 \u043d\u0430\u043f\u0456\u0448\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u045e, \u0456 \u0448\u0442\u043e \u0451\u0441\u0446\u044c, \u0456 \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u0442\u0430\u0446\u0446\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430. \u0428\u0442\u043e \u0434\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0441\u044f\u043c\u0456 \u0437\u043e\u0440\u0430\u043a, \u044f\u043a\u0456\u044f \u0442\u044b \u0431\u0430\u0447\u044b\u045e \u0443 \u041c\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u044b, \u0456 \u0441\u044f\u043c\u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e, \u0442\u043e \u0441\u0435\u043c \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0437\u043e\u0440\u0430\u043a &ndash; \u0433\u044d\u0442\u0430 \u0430\u043d\u0451\u043b\u044b \u0441\u044f\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e, \u0430 \u0441\u0435\u043c \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e &ndash; \u0433\u044d\u0442\u0430 \u0441\u0435\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 1, 5. 6b; \u041a\u043b\u0441 1, 18b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5023","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430<span style=\"color: #ff0000;\"> 2, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u042d\u0444\u0435\u0441\u0430 \u0456 \u0421\u043c\u0456\u0440\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u043f\u0430\u0447\u0443\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u042d\u0444\u0435\u0437\u0435 \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435 \u0441\u0435\u043c \u0437\u043e\u0440\u0430\u043a \u0443 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u044b, \u0445\u0442\u043e \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u044f\u043c\u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u045e. \u0412\u0435\u0434\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044b \u0442\u0432\u0430\u0435, \u0456 \u043f\u0440\u0430\u0446\u0443 \u0442\u0432\u0430\u044e, \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044e, \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u043b\u044b\u0445, \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0430\u043b\u0435 \u0456\u043c\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430, \u0456 \u0432\u044b\u043a\u0440\u044b\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0448\u0443\u043a\u0430\u043d\u0446\u044b. \u0422\u044b \u043c\u0430\u0435\u0448 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u041c\u0430\u0439\u0433\u043e, \u0456 \u043d\u0435 \u0437\u043d\u044f\u043c\u043e\u0433\u0441\u044f. \u0410\u043b\u0435 \u043c\u0430\u044e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043f\u0435\u0440\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e. \u0422\u0430\u043c\u0443 \u0437\u0433\u0430\u0434\u0430\u0439, \u0430\u0434\u043a\u0443\u043b\u044c \u0442\u044b \u045e\u043f\u0430\u045e, \u0456 \u043f\u0430\u043a\u0430\u0439\u0441\u044f, \u0456 \u0440\u0430\u0431\u0456 \u0442\u0430\u043a, \u044f\u043a \u0442\u044b \u0440\u0430\u0431\u0456\u045e \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u041a\u0430\u043b\u0456 \u043d\u0435, \u0442\u043e \u042f \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0456 \u0437\u0440\u0443\u0448\u0443 \u0441\u0432\u0435\u0447\u043d\u0456\u043a \u0442\u0432\u043e\u0439 \u0437 \u044f\u0433\u043e \u043c\u0435\u0441\u0446\u0430, \u043a\u0430\u043b\u0456 \u0442\u044b \u043d\u0435 \u043f\u0430\u043a\u0430\u0435\u0448\u0441\u044f. \u0410\u043b\u0435 \u0434\u043e\u0431\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0448 \u0443\u0447\u044b\u043d\u043a\u0456 \u043d\u0456\u043a\u0430\u043b\u0430\u0456\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0456 \u042f \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c. \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0434\u0430\u043c \u0435\u0441\u0446\u0456 \u0437 \u0434\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u045e \u0440\u0430\u0456 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0421\u043c\u0456\u0440\u043d\u0435 \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0435\u0440\u0448\u044b \u0456 \u0410\u043f\u043e\u0448\u043d\u0456, \u044f\u043a\u0456 \u0431\u044b\u045e \u043c\u0451\u0440\u0442\u0432\u044b, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e: \u042f \u0432\u0435\u0434\u0430\u044e \u043f\u0440\u0430 \u0442\u0432\u043e\u0439 \u0443\u0446\u0456\u0441\u043a \u0456 \u045e\u0431\u043e\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0442\u044b \u0431\u0430\u0433\u0430\u0442\u044b; \u0432\u0435\u0434\u0430\u044e \u043f\u0440\u0430 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u044e\u0434\u044d\u044f\u043c\u0456, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0456\u043c\u0456, \u0430\u043b\u0435 \u0441\u0456\u043d\u0430\u0433\u043e\u0433\u0430\u044e \u0441\u0430\u0442\u0430\u043d\u044b. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u0446\u044c. \u0412\u043e\u0441\u044c \u0434&rsquo;\u044f\u0431\u0430\u043b \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0437 \u0432\u0430\u0441 \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u0443, \u043a\u0430\u0431 \u0432\u044b \u0437\u0432\u0435\u0434\u0430\u043b\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435. \u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0446\u0456\u0441\u043a \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0434\u0437\u0451\u043d. \u0411\u0443\u0434\u0437\u044c \u0432\u0435\u0440\u043d\u044b \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0432\u044f\u043d\u043e\u043a \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c. \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0448\u043a\u043e\u0434\u044b \u0430\u0434 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 2, 10\u0441. 11b; \u0421\u0456\u0440 4, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c \u0432\u0435\u0440\u043d\u044b \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0432\u044f\u043d\u0435\u0446 \u0436\u044b\u0446\u0446\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0448\u043a\u043e\u0434\u044b \u0430\u0434 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437\u0430 \u0446\u044f\u0431\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u0432\u0430\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0448\u043a\u043e\u0434\u044b \u0430\u0434 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5024","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430<span style=\"color: #ff0000;\"> 2, 12-29<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u041f\u044d\u0440\u0433\u0430\u043c\u0443 \u0456 \u0422\u044b\u044f\u0442\u044b\u0440\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u043f\u0430\u0447\u0443\u045e \u0430\u043d\u0451\u043b\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u041f\u044d\u0440\u0433\u0430\u043c\u0435 \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u0432\u043e\u0441\u0442\u0440\u044b \u0434\u0432\u0443\u0445\u0431\u0430\u043a\u043e\u0432\u044b \u043c\u0435\u0447. \u042f \u0432\u0435\u0434\u0430\u044e, \u0434\u0437\u0435 \u0442\u044b \u0436\u044b\u0432\u0435\u0448: \u0442\u0430\u043c, \u0434\u0437\u0435 \u0442\u0440\u043e\u043d \u0441\u0430\u0442\u0430\u043d\u044b, \u0445\u043e\u0446\u044c \u0442\u0440\u044b\u043c\u0430\u0435\u0448\u0441\u044f \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u0433\u043e \u0456 \u043d\u0435 \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f \u0430\u0434 \u0432\u0435\u0440\u044b \u045e \u041c\u044f\u043d\u0435, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u041c\u043e\u0439 \u0432\u0435\u0440\u043d\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0410\u043d\u0442\u044b\u043f\u0430\u0441 \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u045e \u0432\u0430\u0441, \u0434\u0437\u0435 \u0436\u044b\u0432\u0435 \u0441\u0430\u0442\u0430\u043d\u0430. \u0410\u043b\u0435 \u042f \u043c\u0430\u044e \u043a\u0440\u044b\u0445\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0431\u043e \u0442\u0430\u043c \u0451\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0411\u0430\u043b\u0430\u0430\u043c\u0430, \u044f\u043a\u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0411\u0430\u043b\u0430\u0430\u043a\u0430 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0441\u043f\u0430\u043a\u0443\u0441\u0443 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0456 \u0456\u0434\u0430\u043b\u0430\u043c \u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0447\u0430\u043b\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0446\u044f\u0431\u0435 \u0451\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u043d\u0456\u043a\u0430\u043b\u0430\u0456\u0442\u0430\u045e. \u0422\u0430\u043c\u0443 \u0430\u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0441\u044f. \u0423 \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u042f \u0445\u0443\u0442\u043a\u0430 \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0456\u043c\u0456 \u043c\u044f\u0447\u043e\u043c \u041c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c. \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0434\u0430\u043c \u0443\u043a\u0440\u044b\u0442\u0443\u044e \u043c\u0430\u043d\u043d\u0443 \u0456 \u0431\u0435\u043b\u044b \u043a\u0430\u043c\u0435\u043d\u044c\u0447\u044b\u043a, \u0430 \u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u044c\u0447\u044b\u043a\u0443 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u043d\u043e\u0432\u0430\u0435 \u0456\u043c\u044f, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0445\u0442\u043e, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u044f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0422\u044b\u044f\u0442\u044b\u0440\u044b \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043c\u0430\u0435 \u0432\u043e\u0447\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e, \u0430 \u043d\u043e\u0433\u0456 \u042f\u0433\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u0439 \u0431\u0440\u043e\u043d\u0437\u044b. \u042f \u0432\u0435\u0434\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044b \u0442\u0432\u0430\u0435, \u0456 \u043b\u044e\u0431\u043e\u045e, \u0456 \u0432\u0435\u0440\u0443, \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044e, \u0456 \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0442\u0432\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0437\u0430 \u043f\u0435\u0440\u0448\u044b\u044f. \u0410\u043b\u0435 \u042f \u043c\u0430\u044e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0448 \u0436\u0430\u043d\u0447\u044b\u043d\u0443 \u0415\u0437\u0430\u0431\u044d\u043b\u044c, \u044f\u043a\u0430\u044f \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u0430\u0439, \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0456 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u041c\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443 \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0456 \u0456\u0434\u0430\u043b\u0430\u043c. \u042f \u0434\u0430\u045e \u0451\u0439 \u0447\u0430\u0441 \u0430\u043f\u0430\u043c\u044f\u0442\u0430\u0446\u0446\u0430, \u0430\u043b\u0435 \u044f\u043d\u0430 \u043d\u0435 \u0445\u043e\u0447\u0430 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b. \u0412\u043e\u0441\u044c \u043a\u0456\u043d\u0443 \u044f\u0435 \u043d\u0430 \u043b\u043e\u0436\u0430, \u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0447\u0430\u0435 \u0437 \u0451\u0439, \u0430\u0434\u0434\u0430\u043c \u043f\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0456 \u045e\u0446\u0456\u0441\u043a, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e. \u0406 \u0434\u0437\u044f\u0446\u0435\u0439 \u044f\u0435 \u0437\u043d\u0456\u0448\u0447\u0443 \u0441\u043c\u0435\u0440\u0446\u044e. \u0406 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0443\u0441\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u0448\u0442\u043e \u042f \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u043d\u0443\u0442\u0440\u043e \u0456 \u0441\u044d\u0440\u0446\u044b, \u0456 \u0430\u0434\u043f\u043b\u0430\u0447\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u0432\u0430\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443 \u045e\u0441\u0456\u043c \u0432\u0430\u043c, \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c \u0443 \u0422\u044b\u044f\u0442\u044b\u0440\u044b, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0456 \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e, \u044f\u043a \u043a\u0430\u0436\u0443\u0446\u044c, \u0433\u043b\u044b\u0431\u0456\u043d\u044f\u045e \u0441\u0430\u0442\u0430\u043d\u044b, \u0448\u0442\u043e \u042f \u043d\u0435 \u045e\u0441\u043a\u043b\u0430\u0434\u0443 \u043d\u0430 \u0432\u0430\u0441 \u0456\u043d\u0448\u0430\u0433\u0430 \u0446\u044f\u0436\u0430\u0440\u0443. \u0410\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0435\u0446\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0443. \u0425\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u045e\u0447\u044b\u043d\u043a\u0456 \u041c\u0430\u0435, \u0442\u0430\u043c\u0443 \u0434\u0430\u043c \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c \u043a\u0456\u0435\u043c; \u044f\u043a \u0433\u043b\u0456\u043d\u044f\u043d\u044b \u043f\u043e\u0441\u0443\u0434 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0431\u0456\u0442\u044b\u044f. \u0406 \u044f\u043a \u0443\u0437\u044f\u045e \u042f \u0430\u0434 \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u0442\u0430\u043a \u0456 \u044f\u043c\u0443 \u0434\u0430\u043c \u0440\u0430\u043d\u0456\u0448\u043d\u044e\u044e \u0437\u043e\u0440\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 2, 18b. 23b; 22, 12a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043c\u0430\u0435 \u0432\u043e\u0447\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e: \u042f \u0442\u043e\u0439, \u044f\u043a\u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u043d\u0443\u0442\u0440\u043e \u0456 \u0441\u044d\u0440\u0446\u044b, <span style=\"color: #ff0000;\">*<\/span> \u042f \u0430\u0434\u043f\u043b\u0430\u0447\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u0432\u0430\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0434\u0443 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435, \u0456 \u0430\u0434\u043f\u043b\u0430\u0442\u0430 \u041c\u0430\u044f \u0441\u0430 \u041c\u043d\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0430\u0434\u043f\u043b\u0430\u0447\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u0432\u0430\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5025","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">3, 1-22<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0421\u0430\u0440\u0434\u0430\u045e, \u0424\u0456\u043b\u0430\u0434\u044d\u043b\u044c\u0444\u0456\u0456 \u0456 \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u043f\u0430\u0447\u0443\u045e \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0421\u0430\u0440\u0434\u0430\u0445 \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u0441\u0435\u043c \u0434\u0443\u0445\u0430\u045e \u0411\u043e\u0436\u044b\u0445 \u0456 \u0441\u0435\u043c \u0437\u043e\u0440\u0430\u043a. \u0412\u0435\u0434\u0430\u044e \u0442\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b. \u0422\u044b \u043d\u043e\u0441\u0456\u0448 \u0456\u043c\u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u0436\u044b\u0432\u044b, \u0430\u043b\u0435 \u0442\u044b \u043c\u0451\u0440\u0442\u0432\u044b. \u0427\u0443\u0432\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0440\u044d\u0448\u0442\u0443, \u0431\u043b\u0456\u0437\u043a\u0443\u044e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0431\u043e \u042f \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0442\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u041c\u0430\u0456\u043c. \u0417\u0433\u0430\u0434\u0430\u0439, \u0448\u0442\u043e \u0442\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0456 \u043f\u0430\u0447\u0443\u045e, \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439, \u0456 \u043f\u0430\u043a\u0430\u0439\u0441\u044f. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0447\u0443\u0432\u0430\u0446\u044c, \u0442\u043e \u042f \u043f\u0440\u044b\u0439\u0434\u0443, \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u0435\u0434\u0430\u0446\u044c, \u0443 \u044f\u043a\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0446\u044f\u0431\u0435. \u0410\u043b\u0435 \u0442\u044b \u043c\u0430\u0435\u0448 \u0443 \u0421\u0430\u0440\u0434\u0430\u0445 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437\u0430\u043f\u043b\u044f\u043c\u0456\u043b\u0456 \u0448\u0430\u0442\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u041c\u043d\u043e\u044e \u045e \u0431\u0435\u043b\u0456, \u0431\u043e \u044f\u043d\u044b \u0433\u043e\u0434\u043d\u044b\u044f. \u0422\u0430\u043a \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430, \u0456 \u042f \u043d\u0435 \u0441\u0430\u0442\u0440\u0443 \u0456\u043c\u0435\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0437 \u043a\u043d\u0456\u0433\u0456 \u0436\u044b\u0446\u0446\u044f, \u0456 \u0432\u044b\u0437\u043d\u0430\u044e \u0456\u043c\u044f \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c \u041c\u0430\u0456\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0424\u0456\u043b\u0430\u0434\u044d\u043b\u044c\u0444\u0456\u0456 \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u044b, \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043a\u043b\u044e\u0447 \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u043a\u0456 \u0430\u0434\u043c\u044b\u043a\u0430\u0435 &mdash; \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u043c\u043a\u043d\u0435, \u0437\u0430\u043c\u044b\u043a\u0430\u0435 &mdash; \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0430\u043c\u043a\u043d\u0435. \u0412\u0435\u0434\u0430\u044e \u0422\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u0432\u043e\u0441\u044c \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b\u043c\u0456 \u0434\u0437\u0432\u044f\u0440\u044b\u043c\u0430, \u044f\u043a\u0456\u0445 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0447\u044b\u043d\u0456\u0446\u044c, \u0431\u043e \u045e \u0446\u044f\u0431\u0435 \u043c\u0430\u043b\u0430 \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0442\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u041c\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0456 \u043d\u0435 \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f \u0430\u0434 \u0456\u043c\u0435\u043d\u0456 \u041c\u0430\u0439\u0433\u043e. \u0412\u043e\u0441\u044c \u0434\u0430\u044e \u0442\u044b\u0445 \u0437 \u0441\u0456\u043d\u0430\u0433\u043e\u0433\u0456 \u0441\u0430\u0442\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u043a\u0430\u0436\u0443\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u044e\u0434\u044d\u0456, \u0445\u043e\u0446\u044c \u0456\u043c\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430, \u0456 \u0445\u043b\u0443\u0441\u044f\u0446\u044c. \u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u045e \u043d\u043e\u0433\u0456 \u0442\u0430\u0431\u0435, \u0456 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0446\u044f\u0431\u0435. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u043c\u043e\u0439 \u043d\u0430\u043a\u0430\u0437 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u044e \u0446\u044f\u0431\u0435 \u0430\u0434 \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u045e \u0446\u044d\u043b\u044b \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456. \u042f \u0445\u0443\u0442\u043a\u0430 \u043f\u0440\u044b\u0439\u0434\u0443. \u0422\u0440\u044b\u043c\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0435\u0448, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0431\u0440\u0430\u045e \u0442\u0432\u0430\u0439\u0433\u043e \u0432\u044f\u043d\u043a\u0430. \u0410 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0437\u0440\u0430\u0431\u043b\u044e \u043a\u0430\u043b\u043e\u043d\u0430\u0439 \u0443 \u0441\u0432\u044f\u0442\u043d\u0456 \u041c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0432\u044b\u0439\u0434\u0437\u0435 \u0432\u043e\u043d\u043a\u0456, \u0456 \u043d\u0430\u043f\u0456\u0448\u0443 \u043d\u0430 \u0456\u043c \u0456\u043c\u044f \u041c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430 \u0456 \u0456\u043c\u044f \u0433\u043e\u0440\u0430\u0434\u0430 \u0411\u043e\u0433\u0430 \u041c\u0430\u0439\u0433\u043e, \u043d\u043e\u0432\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u044f\u043a\u0456 \u0441\u043f\u0443\u0441\u043a\u0430\u0435\u0446\u0446\u0430 \u0437 \u043d\u0435\u0431\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430 \u041c\u0430\u0439\u0433\u043e, \u0456 \u0441\u0432\u0430\u0451 \u043d\u043e\u0432\u0430\u0435 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u041b\u0430\u0430\u0434\u044b\u043a\u0435\u0456 \u043d\u0430\u043f\u0456\u0448\u044b: \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0410\u043c\u044d\u043d, \u0441\u0432\u0435\u0434\u043a\u0430 \u0432\u0435\u0440\u043d\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430. \u0412\u0435\u0434\u0430\u044e \u0442\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b: \u0442\u044b \u043d\u0456 \u0445\u0430\u043b\u043e\u0434\u043d\u044b, \u043d\u0456 \u0433\u0430\u0440\u0430\u0447\u044b. \u041e, \u043a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0431\u044b\u045e \u0445\u0430\u043b\u043e\u0434\u043d\u044b \u0446\u0456 \u0433\u0430\u0440\u0430\u0447\u044b! \u0410\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0442\u044b \u0446\u0451\u043f\u043b\u044b, \u0430 \u043d\u0435 \u0433\u0430\u0440\u0430\u0447\u044b \u0456 \u043d\u0435 \u0445\u0430\u043b\u043e\u0434\u043d\u044b, \u0432\u044b\u043f\u043b\u044e\u043d\u0443 \u0446\u044f\u0431\u0435 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041c\u0430\u0456\u0445. \u0411\u043e \u0442\u044b \u043a\u0430\u0436\u0430\u0448: &ldquo;\u042f \u0431\u0430\u0433\u0430\u0442\u044b \u0456 \u0440\u0430\u0437\u0431\u0430\u0433\u0430\u0446\u0435\u045e, \u0456 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043c\u0430\u044e \u043f\u0430\u0442\u0440\u044d\u0431\u044b&rdquo;, \u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0442\u044b \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b, \u0456 \u0432\u0430\u0440\u0442\u044b \u0436\u0430\u043b\u044e, \u0456 \u045e\u0431\u043e\u0433\u0456, \u0456 \u0441\u043b\u044f\u043f\u044b, \u0456 \u0433\u043e\u043b\u044b. \u0420\u0430\u044e \u0442\u0430\u0431\u0435 \u043a\u0443\u043f\u0456\u0446\u044c \u0443 \u041c\u044f\u043d\u0435 \u0437\u043e\u043b\u0430\u0442\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u0435 \u0430\u0433\u043d\u0451\u043c, \u043a\u0430\u0431 \u0442\u044b \u0440\u0430\u0437\u0431\u0430\u0433\u0430\u0446\u0435\u045e, \u0456 \u0431\u0435\u043b\u0443\u044e \u0448\u0430\u0442\u0443, \u043a\u0430\u0431 \u0442\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u045e \u0431\u0430\u0447\u043d\u044b \u0441\u043e\u0440\u0430\u043c \u0433\u0430\u043b\u0435\u0447\u044b \u0442\u0432\u0430\u0451\u0439. \u0411\u0430\u043b\u044c\u0437\u0430\u043c\u0430\u043c \u043f\u0430\u043c\u0430\u0436 \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c. \u041a\u0430\u0433\u043e \u042f \u043b\u044e\u0431\u043b\u044e, \u0442\u044b\u0445 \u0434\u0430\u043a\u0430\u0440\u0430\u044e \u0456 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u044e. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c \u0440\u0443\u043f\u043b\u0456\u0432\u044b \u0456 \u043f\u0430\u043a\u0430\u0439\u0441\u044f. \u0412\u043e\u0441\u044c \u0441\u0442\u0430\u044e \u043a\u0430\u043b\u044f \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0456 \u0441\u0442\u0443\u043a\u0430\u044e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u0435 \u041c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0437\u0432\u0435\u0440\u044b, \u0443\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e. \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0434\u0430\u043c \u0441\u0435\u0441\u0446\u0456 \u0441\u0430 \u041c\u043d\u043e\u044e \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u041c\u0430\u0456\u043c, \u044f\u043a \u0456 \u042f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0456 \u0441\u0435\u045e \u0437 \u0410\u0439\u0446\u043e\u043c \u041c\u0430\u0456\u043c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 3, 20b; 2, 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u0435 \u041c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0437\u0432\u0435\u0440\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0434\u0430\u043c \u0435\u0441\u0446\u0456 \u0437 \u0434\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u045e \u0440\u0430\u0456 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5026","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">4, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0430\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c \u0434\u0437\u0432\u0435\u0440\u044b \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u045e \u043d\u0435\u0431\u0435, \u0456 \u0440\u0430\u043d\u0435\u0439\u0448\u044b \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u044f \u0447\u0443\u045e, \u044f\u043a \u0431\u044b \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b, \u0448\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423\u0437\u044b\u0434\u0437\u0456 \u0441\u044e\u0434\u044b, \u0456 \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430&raquo;. \u042f \u0430\u0434\u0440\u0430\u0437\u0443 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0414\u0443\u0445\u0430\u043c. \u0406 \u0432\u043e\u0441\u044c \u0442\u0440\u043e\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u043d\u0435\u0431\u0435, \u0430 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u043d\u0435\u0445\u0442\u0430 \u0441\u044f\u0434\u0437\u0435\u045e. \u0422\u043e\u0439, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0435\u045e, \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0431\u044b\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043a\u0430\u043c\u0435\u043d\u044f \u044f\u0448\u043c\u044b \u0456 \u0441\u0435\u0440\u0434\u0430\u043b\u0456\u043a\u0443, \u0456 \u0432\u044f\u0441\u0451\u043b\u043a\u0430 \u0431\u044b\u043b\u0430 \u0432\u0430\u043a\u043e\u043b \u0442\u0440\u043e\u043d\u0430, \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u0441\u043c\u0430\u0440\u0430\u0433\u0434\u0443. \u0406 \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u0442\u0440\u043e\u043d\u0430 \u0431\u044b\u043b\u043e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0442\u0440\u043e\u043d\u044b. \u0410 \u043d\u0430 \u0442\u0440\u043e\u043d\u0430\u0445 \u0441\u044f\u0434\u0437\u0435\u043b\u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0441\u0442\u0430\u0440\u0446\u044b, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b. \u0406 \u043d\u0430 \u0433\u0430\u043b\u043e\u0432\u0430\u0445 \u0456\u0445\u043d\u0456\u0445 &mdash; \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u0432\u044f\u043d\u043a\u0456. \u0406 \u0437 \u0442\u0440\u043e\u043d\u0430 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043c\u0430\u043b\u0430\u043d\u043a\u0456, \u0456 \u0433\u0430\u043b\u0430\u0441\u044b, \u0456 \u0433\u0440\u044b\u043c\u043e\u0442\u044b. \u0406 \u0441\u0435\u043c \u043f\u0430\u0445\u043e\u0434\u043d\u044f\u045e \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u0451\u0441\u0446\u044c \u0441\u044f\u043c\u044e \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0443\u0445\u0430\u043c\u0456, \u0433\u0430\u0440\u044d\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c. \u0406 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0431\u044b\u043b\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u043c\u043e\u0440\u0430 \u0448\u043a\u043b\u044f\u043d\u043e\u0435, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044e. \u0410 \u043f\u0430\u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u0442\u0440\u043e\u043d\u0430 \u0456 \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u0442\u0440\u043e\u043d\u0430 \u0431\u044b\u043b\u0456 \u0447\u0430\u0442\u044b\u0440\u044b \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b, \u043f\u043e\u045e\u043d\u044b\u044f \u0432\u0430\u0447\u044d\u0439 \u0441\u043f\u0435\u0440\u0430\u0434\u0443 \u0456 \u0437\u0437\u0430\u0434\u0443. \u041f\u0435\u0440\u0448\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u043b\u044c\u0432\u0430, \u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430 &mdash; \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u0432\u0430\u043b\u0430, \u0442\u0440\u044d\u0446\u044f\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430 \u043c\u0435\u043b\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u044f\u043a \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u0430\u0440\u043b\u0430, \u044f\u043a\u0456 \u043b\u044f\u0446\u0456\u0446\u044c. \u0406 \u043a\u043e\u0436\u043d\u0430\u044f \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442 \u043c\u0435\u043b\u0430 \u043f\u0430 \u0448\u044d\u0441\u0446\u044c \u043a\u0440\u044b\u043b\u0430\u045e, \u0430 \u0432\u0430\u043a\u043e\u043b \u0456 \u045e\u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u044f\u043d\u044b \u043f\u043e\u045e\u043d\u044b\u044f \u0432\u0430\u0447\u044d\u0439. \u0406 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u044f\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u043d\u0456 \u045e\u043d\u0430\u0447\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u044f\u043a\u0456 \u0431\u044b\u045e, \u0451\u0441\u0446\u044c \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u043b\u0456 \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u0430\u0434\u0434\u0430\u0434\u0443\u0446\u044c \u0441\u043b\u0430\u0432\u0443, \u0456 \u043f\u0430\u0448\u0430\u043d\u0443, \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0443 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0442\u0430\u0434\u044b \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0441\u0442\u0430\u0440\u0446\u044b \u045e\u043f\u0430\u0434\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0456 \u043a\u0456\u043d\u0443\u0446\u044c \u0432\u044f\u043d\u043a\u0456 \u0441\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u044b, \u041f\u0430\u043d\u0435 \u0456 \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u0433\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u0456 \u043f\u0430\u0448\u0430\u043d\u0443, \u0456 \u0441\u0456\u043b\u0443, \u0431\u043e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451, \u0456 \u0437 \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0456 \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 4, 8\u0441; \u0406\u0441 6, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u044f\u043a\u0456 \u0431\u044b\u045e, \u0451\u0441\u0446\u044c \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c.<span style=\"color: #ff0000;\"> *<\/span> \u0423\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0435\u0440\u0430\u0444\u0456\u043c\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e: \u0421\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u0441\u0432\u044f\u0442\u044b, \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5027","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">5, 1-14<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u0456\u0437\u0456\u044f \u0411\u0430\u0440\u0430\u043d\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0443 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u043a\u043d\u0456\u0433\u0443, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u0443\u044e \u045e\u043d\u0443\u0442\u0440\u044b \u0456 \u0437\u0432\u043e\u043d\u043a\u0443, \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u0443\u044e \u0441\u044f\u043c\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u043c\u0456. \u0406 \u0431\u0430\u0447\u044b\u045e \u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: &laquo;\u0425\u0442\u043e \u0433\u043e\u0434\u043d\u044b \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u043f\u044f\u0447\u0430\u0442\u043a\u0456 \u0437 \u044f\u0435?&raquo; \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u043d\u0456 \u043d\u0430 \u043d\u0435\u0431\u0435, \u043d\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0456 \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443, \u043d\u0456 \u0437\u0430\u0437\u0456\u0440\u043d\u0443\u0446\u044c \u0443 \u044f\u0435. \u0406 \u044f \u043c\u043e\u0446\u043d\u0430 \u043f\u043b\u0430\u043a\u0430\u045e \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0433\u043e\u0434\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u0430\u0437\u0456\u0440\u043d\u0443\u0446\u044c \u0443 \u044f\u0435. \u0422\u0430\u0434\u044b \u0430\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u0442\u0430\u0440\u0446\u0430\u045e \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u041d\u0435 \u043f\u043b\u0430\u0447, \u0432\u043e\u0441\u044c \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043b\u0435\u045e \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u042e\u0434\u044b, \u043a\u043e\u0440\u0430\u043d\u044c \u0414\u0430\u0432\u0456\u0434\u0430, \u043a\u0430\u0431 \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u0441\u0435\u043c \u043f\u044f\u0447\u0430\u0442\u0430\u043a&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0442\u0440\u043e\u043d\u0430 \u0456 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0430\u0440\u0446\u0430\u045e \u0441\u0442\u0430\u044f\u045e \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u043d\u0456\u0431\u044b \u0437\u0430\u0431\u0456\u0442\u044b, \u0456 \u043c\u0435\u045e \u0441\u0435\u043c \u0440\u0430\u0433\u043e\u045e \u0456 \u0441\u0435\u043c \u0432\u0430\u0447\u044d\u0439, \u044f\u043a\u0456\u044f \u0451\u0441\u0446\u044c \u0441\u044f\u043c\u044e \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0443\u0445\u0430\u043c\u0456, \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u045e\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443 \u0437 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0442\u0440\u043e\u043d\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0401\u043d \u0443\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443, \u0442\u0430\u0434\u044b \u0447\u0430\u0442\u044b\u0440\u044b \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0441\u0442\u0430\u0440\u0446\u044b \u045e\u043f\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c; \u043a\u043e\u0436\u043d\u044b \u043c\u0435\u045e \u0433\u0443\u0441\u043b\u0456 \u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u0447\u0430\u0448\u044b, \u043f\u043e\u045e\u043d\u044b\u044f \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u0445. \u0406 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u044b \u0433\u043e\u0434\u043d\u044b \u045e\u0437\u044f\u0446\u044c \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u043f\u044f\u0447\u0430\u0442\u043a\u0456, \u0431\u043e \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0456 \u043c\u043e\u0432\u044b, \u0456 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u0456 \u043d\u0430\u0440\u043e\u0434\u0443, \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430; \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0431\u0430\u0447\u044b\u045e \u0456 \u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0430\u043d\u0451\u043b\u0430\u045e \u0432\u0430\u043a\u043e\u043b \u0442\u0440\u043e\u043d\u0430 \u0456 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u0456 \u0441\u0442\u0430\u0440\u0446\u0430\u045e, \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0456\u0445 \u0431\u044b\u043b\u0430 \u043c\u0456\u0440\u044b\u044f\u0434\u044b \u043c\u0456\u0440\u044b\u044f\u0434 \u0456 \u0442\u044b\u0441\u044f\u0447\u044b \u0442\u044b\u0441\u044f\u0447. \u042f\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c: &laquo;\u0417\u0430\u0431\u0456\u0442\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0433\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043c\u043e\u0446, \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0441\u0456\u043b\u0443, \u0456 \u043f\u0430\u0448\u0430\u043d\u0443, \u0456 \u0445\u0432\u0430\u043b\u0443, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u0447\u0443\u045e, \u044f\u043a \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0456 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0456\u0445, \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443 &mdash; \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u0445\u0432\u0430\u043b\u0430, \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f&raquo;. \u0410 \u0447\u0430\u0442\u044b\u0440\u044b \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0410\u043c\u044d\u043d&raquo;. \u0421\u0442\u0430\u0440\u0446\u044b \u0436 \u0443\u043f\u0430\u043b\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 5, 9bcd. 10a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u0433\u043e\u0434\u043d\u044b, \u041f\u0430\u043d\u0435, \u0443\u0437\u044f\u0446\u044c \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u043f\u044f\u0447\u0430\u0442\u043a\u0456; \u0431\u043e \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5031","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">6, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u043a\u043d\u0456\u0433\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0430\u0434\u043a\u0440\u044b\u045e \u0430\u0434\u043d\u0443 \u0437 \u0441\u044f\u043c\u0456 \u043f\u044f\u0447\u0430\u0442\u0430\u043a, \u0456 \u043f\u0430\u0447\u0443\u045e \u044f \u0430\u0434\u043d\u0443 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u044f\u043a\u0430\u044f \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430 \u044f\u043a \u0431\u044b \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0433\u0440\u043e\u043c\u0443: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456&raquo;. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c, \u0431\u0435\u043b\u044b \u043a\u043e\u043d\u044c, \u0430 \u0432\u0435\u0440\u0448\u043d\u0456\u043a \u043d\u0430 \u0456\u043c \u043c\u0435\u045e \u043b\u0443\u043a, \u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u044f\u043c\u0443 \u0431\u044b\u045e \u0432\u044f\u043d\u043e\u043a, \u0456 \u0451\u043d \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0434\u0440\u0443\u0433\u0443\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443, \u044f \u043f\u0430\u0447\u0443\u045e \u044f\u043a \u0434\u0440\u0443\u0433\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430 \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456&raquo;. \u0406 \u0432\u044b\u0439\u0448\u0430\u045e \u0456\u043d\u0448\u044b \u043a\u043e\u043d\u044c, \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b, \u0430 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0443 \u044f\u0433\u043e \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439 \u0437 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u043b\u044e\u0434\u0437\u0456 \u0432\u044b\u0440\u0430\u0437\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0431\u044b\u045e \u044f\u043c\u0443 \u0432\u044f\u043b\u0456\u043a\u0456 \u043c\u0435\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0442\u0440\u044d\u0446\u044e\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443, \u044f \u043f\u0430\u0447\u0443\u045e \u0442\u0440\u044d\u0446\u044e\u044e \u0436\u044b\u0432\u0443\u044e \u0456\u0441\u0442\u043e\u0442\u0443, \u044f\u043a\u0430\u044f \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456&raquo;. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c, \u0447\u043e\u0440\u043d\u044b \u043a\u043e\u043d\u044c, \u0430 \u0432\u0435\u0440\u0448\u043d\u0456\u043a \u043d\u0430 \u0456\u043c \u043c\u0435\u045e \u0432\u0430\u0433\u0456 \u045e \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445. \u0406 \u044f \u043f\u0430\u0447\u0443\u045e \u044f\u0433\u043e \u0433\u043e\u043b\u0430\u0441 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0432\u0430\u0440\u0442\u0430 \u0437\u0431\u043e\u0436\u0436\u0430 \u0437\u0430 \u0434\u044b\u043d\u0430\u0440 \u0456 \u0442\u0440\u044b \u043a\u0432\u0430\u0440\u0442\u044b \u044f\u0447\u043c\u0435\u043d\u044e \u0437\u0430 \u0434\u044b\u043d\u0430\u0440. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u043c\u0430\u0440\u043d\u0443\u0439 \u0430\u043b\u0435\u044e \u0456 \u0432\u0456\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0443\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443, \u044f \u043f\u0430\u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0439 \u0436\u044b\u0432\u043e\u0439 \u0456\u0441\u0442\u043e\u0442\u044b, \u044f\u043a\u0430\u044f \u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456&raquo;. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c \u043a\u043e\u043d\u044c \u0431\u043b\u0435\u0434\u043d\u0430-\u0437\u044f\u043b\u0451\u043d\u044b, \u0430 \u0432\u0435\u0440\u0448\u043d\u0456\u043a \u043d\u0430 \u0456\u043c \u043c\u0435\u045e \u0456\u043c\u044f \u0421\u043c\u0435\u0440\u0446\u044c, \u0456 \u0410\u0434\u0445\u043b\u0430\u043d\u044c \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0430 \u044f\u043c\u0443. \u0406 \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u045e\u043b\u0430\u0434\u0430 \u043d\u0430\u0434 \u0447\u0432\u044d\u0440\u0446\u044e \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u043c\u044f\u0447\u043e\u043c \u0456 \u0433\u043e\u043b\u0430\u0434\u0430\u043c, \u0456 \u0441\u043c\u0435\u0440\u0446\u044e, \u0456 \u0434\u0437\u0456\u043a\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u044f\u0442\u0443\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443, \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u043f\u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u043e\u043c \u0434\u0443\u0448\u044b \u0437\u0430\u0431\u0456\u0442\u044b\u0445 \u0437\u0430 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0437\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043c\u0435\u043b\u0456. \u0406 \u044f\u043d\u044b \u0433\u0443\u0447\u043d\u0430 \u045e\u0441\u043a\u0440\u044b\u043a\u043d\u0443\u043b\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0430\u043a\u0443\u043b\u044c \u0436\u0430, \u0441\u0432\u044f\u0442\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443, \u0422\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0456 \u0441\u043f\u0430\u0433\u0430\u043d\u044f\u0446\u044c \u0437\u0430 \u043d\u0430\u0448\u0443 \u043a\u0440\u043e\u045e \u0437 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u0456\u0445 \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b, \u0456 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0456\u043c, \u043a\u0430\u0431 \u0430\u0434\u043f\u0430\u0447\u044b\u043b\u0456 \u044f\u0448\u0447\u044d \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043b\u0456\u043a \u0456\u0445\u043d\u0456\u0445 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e-\u0441\u043b\u0443\u0433\u0430\u045e \u0456 \u0431\u0440\u0430\u0442\u043e\u045e \u0456\u0445\u043d\u0456\u0445, \u0448\u0442\u043e, \u044f\u043a \u0456 \u044f\u043d\u044b, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0437\u0430\u0431\u0456\u0442\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0448\u043e\u0441\u0442\u0443\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443, \u044f \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0441\u0442\u0430\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441 \u0456 \u0441\u043e\u043d\u0446\u0430 \u0441\u0442\u0430\u043b\u0430 \u0447\u043e\u0440\u043d\u0430\u0435, \u044f\u043a \u0432\u0430\u043b\u0430\u0441\u044f\u043d\u044b \u043c\u044f\u0448\u043e\u043a, \u0456 \u045e\u0432\u0435\u0441\u044c \u043c\u0435\u0441\u044f\u0446 \u0441\u0442\u0430\u045e \u044f\u043a \u043a\u0440\u043e\u045e, \u0456 \u0437\u043e\u0440\u043a\u0456 \u043d\u0435\u0431\u0430 \u045e\u043f\u0430\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a \u043d\u0435\u0434\u0430\u0441\u043f\u0435\u043b\u044b\u044f \u0441\u043c\u043e\u043a\u0432\u044b, \u0448\u0442\u043e \u0441\u043a\u0456\u0434\u0430\u0435 \u045e\u0437\u0440\u0443\u0448\u0430\u043d\u0430\u044f \u043c\u043e\u0446\u043d\u044b\u043c \u0432\u0435\u0442\u0440\u0430\u043c \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u0430. \u0406 \u043d\u0435\u0431\u0430 \u0431\u044b\u043b\u043e \u0430\u0434\u0434\u0437\u0435\u043b\u0435\u043d\u0430, \u044f\u043a \u0441\u043a\u0440\u0443\u0442\u0430\u043a \u043a\u043d\u0456\u0433\u0456, \u0430 \u043a\u043e\u0436\u043d\u0430\u044f \u0433\u0430\u0440\u0430 \u0456 \u0432\u044b\u0441\u043f\u0430 \u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u043b\u0456\u0441\u044f \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u045e. \u0406 \u043a\u0430\u0440\u0430\u043b\u0456 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u044b, \u0456 \u0442\u044b\u0441\u044f\u0447\u043d\u0456\u043a\u0456, \u0456 \u0431\u0430\u0433\u0430\u0447\u044b, \u0456 \u043c\u043e\u0446\u043d\u044b\u044f, \u0456 \u043a\u043e\u0436\u043d\u044b \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a, \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0441\u0445\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u043f\u044f\u0447\u043e\u0440\u0430\u0445 \u0456 \u045e \u0433\u043e\u0440\u043d\u044b\u0445 \u0441\u043a\u0430\u043b\u0430\u0445. \u0406 \u043a\u0430\u0436\u0443\u0446\u044c \u0433\u043e\u0440\u0430\u043c \u0456 \u0441\u043a\u0430\u043b\u0430\u043c: &laquo;\u0423\u043f\u0430\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u043d\u0430\u0441 \u0456 \u0441\u0445\u0430\u0432\u0430\u0439\u0446\u0435 \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0430\u0434 \u0433\u043d\u0435\u0432\u0443 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0431\u043e \u043d\u0430\u0441\u0442\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u0433\u043d\u0435\u0432\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0456 \u0445\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c?&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 6. 9. 10. 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u0447\u0443\u045e \u043f\u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u043e\u043c \u0411\u043e\u0436\u044b\u043c \u0433\u0430\u043b\u0430\u0441\u044b \u0437\u0430\u0431\u0456\u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u043b\u0456: \u0427\u0430\u043c\u0443 \u0422\u044b \u043d\u0435 \u0431\u0430\u0440\u043e\u043d\u0456\u0448 \u043d\u0430\u0448\u0430\u0439 \u043a\u0440\u044b\u0432\u0456? \u0406 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434\u043a\u0430\u0437: <span style=\"color: #ff0000;\">*<\/span> \u042f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443 \u043f\u0430\u0446\u044f\u0440\u043f\u0456\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043b\u0456\u043a \u0431\u0440\u0430\u0442\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0456\u043c \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b, \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443 \u043f\u0430\u0446\u044f\u0440\u043f\u0456\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043b\u0456\u043a \u0431\u0440\u0430\u0442\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5032","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430<span style=\"color: #ff0000;\"> 7, 1-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u044f\u043b\u0456\u043a\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u0411\u043e\u0436\u0430\u0439 \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u044f\u043b\u0456 \u043d\u0430 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0432\u0443\u0433\u043b\u0430\u0445 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0447\u0430\u0442\u044b\u0440\u044b \u0432\u044f\u0442\u0440\u044b \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0432\u0435\u0446\u0435\u0440 \u043d\u0435 \u0434\u0437\u044c\u043c\u0443\u045e \u043d\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043d\u0456 \u043d\u0430 \u043c\u043e\u0440\u0430, \u043d\u0456 \u043d\u0430 \u044f\u043a\u043e\u0435 \u0434\u0440\u044d\u0432\u0430. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0456\u043d\u0448\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0443\u0441\u0445\u043e\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 \u0456 \u043c\u0435\u045e \u043f\u044f\u0447\u0430\u0442\u043a\u0443 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430. \u0406 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0451\u043d \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0434\u0430 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u043c \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e \u0437\u044f\u043c\u043b\u0456 \u0456 \u043c\u043e\u0440\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0435 \u0447\u044b\u043d\u0456\u0446\u0435 \u0437\u043b\u043e \u043d\u0456 \u0437\u044f\u043c\u043b\u0456, \u043d\u0456 \u043c\u043e\u0440\u0443, \u043d\u0456 \u0434\u0440\u044d\u0432\u0430\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u043d\u0435 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043c \u043f\u044f\u0447\u0430\u0442\u043a\u0456 \u0441\u043b\u0443\u0433\u0430\u043c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430 \u0447\u043e\u043b\u0430\u0445 \u0456\u0445\u043d\u0456\u0445&raquo;. \u0406 \u044f \u043f\u0430\u0447\u0443\u045e \u043b\u0456\u0447\u0431\u0443 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u044e: \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0447\u0430\u0442\u044b\u0440\u044b \u0442\u044b\u0441\u044f\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u044e \u0437 \u0443\u0441\u0456\u0445 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0417 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u042e\u0434\u044b \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u044b\u0445, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0420\u0443\u0431\u044d\u043d\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0413\u0430\u0434\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0410\u0441\u044d\u0440\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u041d\u044d\u0444\u0442\u0430\u043b\u0456\u043c\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u041c\u0430\u043d\u0430\u0441\u044d\u0441\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0421\u0456\u043c\u044f\u043e\u043d\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u041b\u0435\u0432\u0456 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0406\u0441\u0430\u0445\u0430\u0440\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0417\u0430\u0431\u0443\u043b\u043e\u043d\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u042e\u0437\u0430\u0444\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447, \u0437 \u043f\u043b\u0435\u043c\u0435\u043d\u0456 \u0411\u044d\u043d\u044c\u044f\u043c\u0456\u043d\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0442\u043e\u045e\u043f, \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c, \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e, \u0440\u043e\u0434\u0430\u045e \u0456 \u043c\u043e\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u044f\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b \u0456 \u0437 \u043f\u0430\u043b\u044c\u043c\u043e\u0432\u044b\u043c\u0456 \u0433\u0430\u043b\u0456\u043d\u043a\u0430\u043c\u0456 \u045e \u0440\u0443\u043a\u0430\u0445 \u0441\u0432\u0430\u0456\u0445. \u0406 \u044f\u043d\u044b \u043a\u0440\u044b\u0447\u0430\u043b\u0456 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0441\u0435 \u0430\u043d\u0451\u043b\u044b \u0441\u0442\u0430\u044f\u043b\u0456 \u0432\u0430\u043a\u043e\u043b \u0442\u0440\u043e\u043d\u0430 \u0456 \u0441\u0442\u0430\u0440\u0446\u0430\u045e, \u0456 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442. \u0406 \u045e\u043f\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u0430 \u0442\u0432\u0430\u0440\u044b \u0441\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c, \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0411\u043e\u0433\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u043c\u044d\u043d! \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u043b\u0430\u0432\u0430, \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0456 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u0441\u0456\u043b\u0430, \u0456 \u043c\u043e\u0446 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0410\u043c\u044d\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u0434\u0437\u0456\u043d \u0441\u0430 \u0441\u0442\u0430\u0440\u0446\u0430\u045e \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0442\u043e \u0433\u044d\u0442\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b, \u0456 \u0430\u0434\u043a\u0443\u043b\u044c \u044f\u043d\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c?&raquo; \u0406 \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u041c\u043e\u0439 \u043f\u0430\u043d\u0435, \u0442\u044b \u0432\u0435\u0434\u0430\u0435\u0448&raquo;. \u0410 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0456 \u0430\u0431\u043c\u044b\u045e \u0448\u0430\u0442\u044b \u0441\u0432\u0430\u0435, \u0456 \u0432\u044b\u0431\u0435\u043b\u0456\u045e \u0456\u0445 \u0443 \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430. \u0422\u0430\u043c\u0443 \u044f\u043d\u044b &mdash; \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u042f\u043c\u0443 \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0440\u0430\u0441\u043a\u0456\u043d\u0435 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u0432\u043e\u0439 \u0448\u0430\u0446\u0451\u0440. \u042f\u043d\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0456 \u0433\u0430\u043b\u0430\u0434\u0430\u0446\u044c, \u043d\u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043b\u0456\u0446\u044c \u0456\u0445 \u0441\u043e\u043d\u0446\u0430 \u0456 \u043d\u0456\u044f\u043a\u0430\u044f \u0441\u043f\u0451\u043a\u0430, \u0431\u043e \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u044f\u043a\u0456 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0442\u0440\u043e\u043d\u0430, \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u0456 \u0432\u0430\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b. \u0406 \u0432\u044b\u0442\u0440\u0430 \u0411\u043e\u0433 \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043b\u044f\u0437\u0443 \u0437 \u0456\u0445\u043d\u0456\u0445 \u0432\u0430\u0447\u044d\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 7, 13. 14; 6, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0433\u044d\u0442\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b, \u0456 \u0430\u0434\u043a\u0443\u043b\u044c \u044f\u043d\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c? \u0406 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0456 \u0430\u0431\u043c\u044b\u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451, \u0456 \u0432\u044b\u0431\u0435\u043b\u0456\u045e \u044f\u0433\u043e \u045e \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u043f\u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u043e\u043c \u0434\u0443\u0448\u044b \u0437\u0430\u0431\u0456\u0442\u044b\u0445 \u0437\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0437\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043c\u0435\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0456 \u0430\u0431\u043c\u044b\u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451, \u0456 \u0432\u044b\u0431\u0435\u043b\u0456\u045e \u044f\u0433\u043e \u045e \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5033","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">8, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u0435\u043c \u0430\u043d\u0451\u043b\u0430\u045e \u043a\u0430\u0440\u0430\u044e\u0446\u044c \u0441\u0432\u0435\u0442<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u0451\u043c\u0443\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443, \u0443 \u043d\u0435\u0431\u0435 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0446\u0456\u0448\u0430 \u0434\u0437\u0435\u0441\u044c\u0446\u0456 \u043d\u0430 \u043f\u0430\u045e\u0433\u0430\u0434\u0437\u0456\u043d\u044b. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0441\u0435\u043c \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u044f\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0456\u043c \u0441\u0435\u043c \u0442\u0440\u0443\u0431\u0430\u045e. \u0406 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456\u043d\u0448\u044b \u0430\u043d\u0451\u043b, \u0456 \u0441\u0442\u0430\u045e \u043f\u0440\u044b \u0430\u043b\u0442\u0430\u0440\u044b, \u043c\u0430\u044e\u0447\u044b \u0437\u0430\u043b\u0430\u0442\u0443\u044e \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u0443, \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0448\u043c\u0430\u0442 \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u043a\u0430\u0431 \u0451\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u0433\u043e \u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u043d\u0430 \u0437\u0430\u043b\u0430\u0442\u044b \u0430\u043b\u0442\u0430\u0440 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c. \u0406 \u045e\u0437\u044b\u0448\u043e\u045e \u0434\u044b\u043c \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0437 \u0440\u0443\u043a\u0456 \u0430\u043d\u0451\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u0406 \u045e\u0437\u044f\u045e \u0430\u043d\u0451\u043b \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u0443, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u044f\u0435 \u0430\u0433\u043d\u0451\u043c \u0437 \u0430\u043b\u0442\u0430\u0440\u0430, \u0456 \u043a\u0456\u043d\u0443\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u043f\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0433\u0440\u043e\u043c, \u0456 \u0433\u0430\u043b\u0430\u0441\u044b, \u0456 \u043c\u0430\u043b\u0430\u043d\u043a\u0456, \u0456 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u0435\u043c \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0441\u0435\u043c \u0442\u0440\u0443\u0431\u0430\u045e, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u043f\u0435\u0440\u0448\u044b. \u0406 \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u0433\u0440\u0430\u0434 \u0456 \u0430\u0433\u043e\u043d\u044c, \u0437\u043c\u044f\u0448\u0430\u043d\u044b \u0437 \u043a\u0440\u044b\u0432\u0451\u0439, \u0456 \u0431\u044b\u045e \u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0406 \u0431\u044b\u043b\u0430 \u0441\u043f\u0430\u043b\u0435\u043d\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0431\u044b\u043b\u0430 \u0441\u043f\u0430\u043b\u0435\u043d\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u0434\u0440\u044d\u045e, \u0456 \u045e\u0441\u044f \u0437\u044f\u043b\u0451\u043d\u0430\u044f \u0442\u0440\u0430\u0432\u0430 \u0431\u044b\u043b\u0430 \u0441\u043f\u0430\u043b\u0435\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0434\u0440\u0443\u0433\u0456 \u0430\u043d\u0451\u043b. \u0406 \u044f\u043a \u0431\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0433\u0430\u0440\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u043b\u0430\u0435 \u045e \u0430\u0433\u043d\u0456, \u0431\u044b\u043b\u0430 \u043a\u0456\u043d\u0443\u0442\u0430\u044f \u045e \u043c\u043e\u0440\u0430. \u0406 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u043c\u043e\u0440\u0430 \u0441\u0442\u0430\u043b\u0430 \u043a\u0440\u044b\u0432\u0451\u0439, \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u043c\u0430\u0440\u0441\u043a\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u0448\u0442\u043e \u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451, \u0456 \u0431\u044b\u043b\u0430 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u043a\u0430\u0440\u0430\u0431\u043b\u0451\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0442\u0440\u044d\u0446\u0456 \u0430\u043d\u0451\u043b. \u0406 \u045e\u043f\u0430\u043b\u0430 \u0437 \u043d\u0435\u0431\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0437\u043e\u0440\u043a\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u043b\u0430\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u043b\u044f\u043c\u043f\u0430, \u0456 \u045e\u043f\u0430\u043b\u0430 \u043d\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0443 \u0440\u044d\u043a \u0456 \u043d\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u0430\u0434\u044b. \u0410 \u0456\u043c\u044f \u0437\u043e\u0440\u043a\u0456 \u0433\u044d\u0442\u0430\u0439 &ndash; \u041f\u0430\u043b\u044b\u043d. \u0406 \u0441\u0442\u0430\u043b\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u0432\u0430\u0434\u044b \u043f\u0430\u043b\u044b\u043d\u043e\u043c, \u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u043b\u044e\u0434\u0437\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u043b\u0456 \u0430\u0434 \u0432\u0430\u0434\u044b, \u0431\u043e \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0433\u043e\u0440\u043a\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0430\u043d\u0451\u043b. \u0406 \u045e\u0434\u0430\u0440\u0430\u043d\u0430\u044f \u0431\u044b\u043b\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u0441\u043e\u043d\u0446\u0430, \u0456 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u043c\u0435\u0441\u044f\u0446\u0430, \u0456 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u0437\u043e\u0440\u0430\u043a, \u0442\u0430\u043a \u0448\u0442\u043e \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u0456\u0445 \u0437\u0430\u0446\u044c\u043c\u0456\u043b\u0430\u0441\u044f \u0456 \u0434\u0437\u0435\u043d\u044c \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u045e\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u044e \u0442\u0440\u0430\u0446\u0456\u043d\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043d\u043e\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e, \u0456 \u043f\u0430\u0447\u0443\u045e \u0430\u0434\u043d\u0430\u0433\u043e \u0430\u0440\u043b\u0430, \u044f\u043a\u0456 \u043b\u044f\u0446\u0435\u045e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0431\u0430 \u0456 \u0433\u0443\u0447\u043d\u0430 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u044f\u0434\u0430, \u0431\u044f\u0434\u0430, \u0431\u044f\u0434\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0430\u0434 \u0442\u0440\u0443\u0431\u043d\u044b\u0445 \u0433\u0430\u043b\u0430\u0441\u043e\u045e \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u0442\u0440\u043e\u0445 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u0446\u044c!&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 8, 3-4; 5, 8b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b \u0441\u0442\u0430\u045e \u043f\u0440\u044b \u0430\u043b\u0442\u0430\u0440\u044b, \u043c\u0430\u044e\u0447\u044b \u0437\u0430\u043b\u0430\u0442\u0443\u044e \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u0443, \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0448\u043c\u0430\u0442 \u043a\u0430\u0434\u0437\u0456\u043b\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u045e\u0437\u044b\u0448\u043e\u045e \u0434\u044b\u043c \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u043e\u0436\u043d\u044b \u0430\u043d\u0451\u043b \u043c\u0435\u045e \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u0443, \u043f\u043e\u045e\u043d\u0443\u044e \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0437\u044b\u0448\u043e\u045e \u0434\u044b\u043c \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5034","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">9, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u0430\u0448\u044d\u0441\u0446\u0435 \u0441\u0430\u0440\u0430\u043d\u0447\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u043f\u044f\u0442\u044b \u0430\u043d\u0451\u043b. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0437\u043e\u0440\u043a\u0443, \u044f\u043a\u0430\u044f \u045e\u043f\u0430\u043b\u0430 \u0437 \u043d\u0435\u0431\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0431\u044b\u045e \u0434\u0430\u0437\u0435\u043d\u044b \u0451\u0439 \u043a\u043b\u044e\u0447 \u0430\u0434 \u0441\u0442\u0443\u0434\u043d\u0456 \u0431\u0435\u0437\u0434\u0430\u043d\u0456. \u0406 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u0441\u0442\u0443\u0434\u043d\u044f \u0431\u0435\u0437\u0434\u0430\u043d\u0456, \u0456 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u0434\u044b\u043c \u0441\u0430 \u0441\u0442\u0443\u0434\u043d\u0456, \u044f\u043a \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0435\u0447\u044b, \u0456 \u0437\u0430\u0446\u044c\u043c\u0456\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430 \u0456 \u043f\u0430\u0432\u0435\u0442\u0440\u0430 \u0430\u0434 \u0434\u044b\u043c\u0443 \u0441\u0430 \u0441\u0442\u0443\u0434\u043d\u0456. \u0406 \u0437 \u0434\u044b\u043c\u0443 \u0432\u044b\u0439\u0448\u043b\u0430 \u0441\u0430\u0440\u0430\u043d\u0447\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0451\u0439 \u0443\u043b\u0430\u0434\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0443\u044e \u043c\u0430\u044e\u0446\u044c \u0437\u044f\u043c\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u043f\u0456\u0451\u043d\u044b. \u0406 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0451\u0439, \u043a\u0430\u0431 \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0430 \u0448\u043a\u043e\u0434\u044b \u0437\u044f\u043c\u043d\u043e\u0439 \u0442\u0440\u0430\u0432\u0435, \u043d\u0456\u044f\u043a\u0430\u0439 \u0437\u0435\u043b\u044f\u043d\u0456\u043d\u0435 \u0456 \u043d\u0456\u044f\u043a\u0430\u043c\u0443 \u0434\u0440\u044d\u0432\u0443, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043f\u044f\u0447\u0430\u0442\u043a\u0456 \u0411\u043e\u0433\u0430 \u043d\u0430 \u0447\u043e\u043b\u0430\u0445. \u0406 \u0431\u044b\u043b\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u043d\u0430 \u0451\u0439 \u043d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0456\u0445, \u0430\u043b\u0435 \u043c\u0443\u0447\u044b\u0446\u044c \u043f\u044f\u0446\u044c \u043c\u0435\u0441\u044f\u0446\u0430\u045e. \u0406 \u043f\u0430\u043a\u0443\u0442\u044b \u0456\u0445 \u0431\u044b\u043b\u0456 \u044f\u043a \u043f\u0430\u043a\u0443\u0442\u044b \u0430\u0434 \u0441\u043a\u0430\u0440\u043f\u0456\u0451\u043d\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u043a\u0443\u0441\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0406 \u045e \u0442\u044b\u044f \u0434\u043d\u0456 \u043b\u044e\u0434\u0437\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u044f\u0435, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u0430\u0434\u0430\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u0430\u043b\u0435 \u0441\u043c\u0435\u0440\u0446\u044c \u0443\u0446\u044f\u0447\u044d \u0430\u0434 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0432\u044b\u0433\u043b\u044f\u0434 \u0441\u0430\u0440\u0430\u043d\u0447\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043a\u043e\u043d\u0435\u0439, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0430 \u0431\u043e\u044e, \u0456 \u043d\u0430 \u0433\u0430\u043b\u043e\u0432\u0430\u0445 \u0456\u0445 \u044f\u043a \u0431\u044b \u0432\u044f\u043d\u043a\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u0456 \u0442\u0432\u0430\u0440\u044b \u0456\u0445 &ndash; \u044f\u043a \u0442\u0432\u0430\u0440\u044b \u043b\u044e\u0434\u0437\u0435\u0439. \u0406 \u0432\u0430\u043b\u0430\u0441\u044b \u044f\u0435 &ndash; \u044f\u043a \u0432\u0430\u043b\u0430\u0441\u044b \u0436\u0430\u043d\u0447\u044b\u043d, \u0430 \u0437\u0443\u0431\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043b\u044c\u0432\u043e\u045e. \u0406 \u043c\u0435\u043b\u0430 \u044f\u043d\u0430 \u043f\u0430\u043d\u0446\u044b\u0440\u044b, \u044f\u043a \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f \u043f\u0430\u043d\u0446\u044b\u0440\u044b, \u0456 \u0433\u043e\u043b\u0430\u0441 \u043a\u0440\u044b\u043b\u0430\u045e \u044f\u0435 &ndash; \u044f\u043a \u0433\u0443\u043b \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u043a\u043e\u043d\u0435\u0439, \u044f\u043a\u0456\u044f \u0431\u044f\u0433\u0443\u0446\u044c \u043d\u0430 \u0431\u0456\u0442\u0432\u0443. \u0406 \u043c\u0430\u0435 \u044f\u043d\u0430 \u0445\u0432\u0430\u0441\u0442\u044b, \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0441\u043a\u0430\u0440\u043f\u0456\u0451\u043d\u0430\u0432\u044b\u0445, \u0456 \u0434\u0436\u0430\u043b\u044b, \u0430 \u045e \u0445\u0432\u0430\u0441\u0446\u0435 &ndash; \u043c\u043e\u0446 \u0434\u043b\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u0435\u043d\u043d\u044f \u0448\u043a\u043e\u0434\u044b \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u043f\u044f\u0446\u0456 \u043c\u0435\u0441\u044f\u0446\u0430\u045e. \u042f\u043d\u0430 \u043c\u0430\u0435 \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u0439 \u043a\u0430\u0440\u0430\u043b\u044f &ndash; \u0430\u043d\u0451\u043b\u0430 \u0431\u0435\u0437\u0434\u0430\u043d\u0456. \u0406\u043c\u044f \u044f\u043c\u0443 \u043f\u0430-\u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0443 \u0410\u0431\u0430\u0434\u043e\u043d, \u0430 \u043f\u0430-\u0433\u0440\u044d\u0446\u043a\u0443 &ndash; \u0410\u043f\u0430\u043b\u0456\u0451\u043d, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0417\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0456\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0456\u043d\u0443\u043b\u0430 \u0430\u0434\u043d\u0430 \u0431\u044f\u0434\u0430. \u0412\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u044f\u0448\u0447\u044d \u0434\u0437\u0432\u0435 \u0431\u044f\u0434\u044b \u0437\u0430 \u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u044d\u043b 3, 3. 5\u0430; \u041c\u043a 13, 33<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0447\u044b\u043d\u044e \u0437\u043d\u0430\u043a\u0456 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0440\u043e\u045e \u0456 \u0430\u0433\u043e\u043d\u044c, \u0456 \u0441\u043b\u0443\u043f\u044b \u0434\u044b\u043c\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0431\u0443\u0434\u0437\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0447\u0443\u0432\u0430\u0439\u0446\u0435, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0442\u043e\u0439 \u0447\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0431\u0443\u0434\u0437\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5035","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">9, 13-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0435\u0434\u0441\u0442\u0432\u0430 \u0432\u0430\u0439\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0448\u043e\u0441\u0442\u044b \u0430\u043d\u0451\u043b. \u0406 \u044f \u043f\u0430\u0447\u0443\u045e \u0430\u0434\u0437\u0456\u043d \u0433\u043e\u043b\u0430\u0441 \u0430\u0434 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0440\u0430\u0433\u043e\u045e \u0437\u0430\u043b\u0430\u0442\u043e\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0448\u043e\u0441\u0442\u0430\u043c\u0443 \u0430\u043d\u0451\u043b\u0443, \u0448\u0442\u043e \u043c\u0435\u045e \u0442\u0440\u0443\u0431\u0443: &laquo;\u0412\u044b\u0437\u0432\u0430\u043b\u0456 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0430\u043d\u0451\u043b\u0430\u045e, \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u0445 \u043d\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u043a\u043e\u044e \u0415\u045e\u0444\u0440\u0430\u0442&raquo;. \u0406 \u0431\u044b\u043b\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0447\u0430\u0442\u044b\u0440\u044b \u0430\u043d\u0451\u043b\u044b, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u0433\u044d\u0442\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443, \u0434\u0437\u0435\u043d\u044c \u0456 \u043c\u0435\u0441\u044f\u0446, \u043a\u0430\u0431 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0442\u0440\u0430\u0446\u0456\u043d\u0443 \u043b\u044e\u0434\u0437\u0435\u0439. \u0406 \u043b\u0456\u043a \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u043a\u043e\u043d\u043d\u0456\u0446\u044b &ndash; \u0434\u0437\u0432\u0435 \u043c\u0456\u0440\u044b\u044f\u0434\u044b \u043c\u0456\u0440\u044b\u044f\u0434. \u042f \u043f\u0430\u0447\u0443\u045e \u0456\u0445 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c. \u0406 \u0442\u0430\u043a \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0443 \u0432\u0456\u0437\u0456\u0456 \u043a\u043e\u043d\u0435\u0439 \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u043f\u0430\u043d\u0446\u044b\u0440\u044b \u043a\u043e\u043b\u0435\u0440\u0443 \u0430\u0433\u043d\u044e, \u0433\u0456\u044f\u0446\u044b\u043d\u0442\u0443 \u0456 \u0441\u0435\u0440\u044b. \u0410 \u0433\u0430\u043b\u043e\u0432\u044b \u043a\u043e\u043d\u0435\u0439 &ndash; \u044f\u043a \u0433\u0430\u043b\u043e\u0432\u044b \u043b\u044c\u0432\u043e\u045e, \u0430 \u0437 \u043f\u044b\u0441\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0433\u043e\u043d\u044c, \u0434\u044b\u043c \u0456 \u0441\u0435\u0440\u0430. \u0410\u0434 \u0442\u0440\u043e\u0445 \u0433\u044d\u0442\u044b\u0445 \u0443\u0434\u0430\u0440\u0430\u045e \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u0456\u0442\u0430 \u0442\u0440\u0430\u0446\u0456\u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0434 \u0430\u0433\u043d\u044e, \u0434\u044b\u043c\u0443 \u0456 \u0441\u0435\u0440\u044b, \u0448\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u0456\u0445\u043d\u0456\u0445 \u043f\u044b\u0441\u0430\u045e. \u041c\u043e\u0446 \u043a\u043e\u043d\u0435\u0439 \u0431\u044b\u043b\u0430 \u045e \u0456\u0445 \u043f\u044b\u0441\u0430\u0445 \u0456 \u0445\u0432\u0430\u0441\u0442\u0430\u0445, \u0431\u043e \u0445\u0432\u0430\u0441\u0442\u044b \u0456\u0445 \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0437\u043c\u0435\u0439 \u0456 \u043c\u0435\u043b\u0456 \u0433\u0430\u043b\u043e\u0432\u044b, \u0456 \u0456\u043c\u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u043b\u0456 \u0448\u043a\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0440\u044d\u0448\u0442\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u0456\u0442\u0430 \u0430\u0434 \u0433\u044d\u0442\u044b\u0445 \u0443\u0434\u0430\u0440\u0430\u045e, \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0430\u0434 \u0441\u043f\u0440\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0434\u044d\u043c\u0430\u043d\u0430\u043c, \u0437\u0430\u043b\u0430\u0442\u044b\u043c, \u0441\u0440\u044d\u0431\u043d\u044b\u043c \u0456 \u0431\u0440\u043e\u043d\u0437\u0430\u0432\u044b\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u043c \u0456 \u0434\u0440\u0430\u045e\u043b\u044f\u043d\u044b\u043c \u0456\u0434\u0430\u043b\u0430\u043c, \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043d\u0456 \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0456 \u0447\u0443\u0446\u044c, \u043d\u0456 \u0445\u0430\u0434\u0437\u0456\u0446\u044c. \u0406 \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0456 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430\u045e, \u043d\u0456 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0447\u0430\u0440\u0430\u045e, \u043d\u0456 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b, \u043d\u0456 \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0440\u0430\u0434\u0437\u044f\u0436\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 17, 30b. 31a; \u043f\u0430\u0440. \u0401\u044d\u043b 1, 13. 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0456 \u043f\u0430\u045e\u0441\u044e\u043b\u044c \u043a\u0430\u044e\u0446\u0446\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0436\u044b\u044f \u0441\u043b\u0443\u0433\u0456, \u0437\u0431\u044f\u0440\u044b\u0446\u0435 \u045e\u0441\u0456\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5036","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">10, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0446\u0432\u0435\u0440\u0434\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0456\u043d\u0448\u0430\u0433\u0430 \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0445\u043c\u0430\u0440\u0443, \u0430 \u0432\u044f\u0441\u0451\u043b\u043a\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u044f\u0433\u043e. \u0422\u0432\u0430\u0440 \u044f\u0433\u043e &ndash; \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u043e\u043d\u0446\u0430, \u0430 \u043d\u043e\u0433\u0456 \u044f\u0433\u043e &ndash; \u044f\u043a \u043a\u0430\u043b\u043e\u043d\u043d\u044b \u0430\u0433\u043d\u044e. \u0401\u043d \u043c\u0435\u045e \u0443 \u0440\u0443\u0446\u044d \u0440\u0430\u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443. \u0406 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0451\u043d \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0432\u0443\u044e \u043d\u0430\u0433\u0443 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0430 \u043b\u0435\u0432\u0443\u044e &ndash; \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0406 \u0433\u0443\u0447\u043d\u0430 \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u044b\u043a\u0430\u0435 \u043b\u0435\u045e. \u0410 \u043a\u0430\u043b\u0456 \u043a\u0440\u044b\u043a\u043d\u0443\u045e, \u0441\u0435\u043c \u0433\u0440\u043e\u043c\u0430\u045e \u0437\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0433\u0430\u043b\u0430\u0441\u0430\u043c\u0456. \u0406 \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0441\u0435\u043c \u0433\u0440\u043e\u043c\u0430\u045e, \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0456\u0441\u0430\u0446\u044c. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a\u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e: &laquo;\u0417\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0441\u0435\u043c \u0433\u0440\u043e\u043c\u0430\u045e, \u0456 \u043d\u0435 \u043f\u0456\u0448\u044b \u0433\u044d\u0442\u0430\u0433\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0430\u043d\u0451\u043b, \u044f\u043a\u043e\u0433\u0430 \u044f \u0431\u0430\u0447\u044b\u045e \u0441\u0442\u043e\u044f\u0447\u044b\u043c \u043d\u0430 \u043c\u043e\u0440\u044b \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043f\u0430\u0434\u043d\u044f\u045e \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0432\u0443\u044e \u0440\u0443\u043a\u0443 \u0434\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0416\u044b\u0432\u044b\u043c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0456\u043c, \u0437\u044f\u043c\u043b\u044e \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439, \u0456 \u043c\u043e\u0440\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u045e \u0456\u043c: &laquo;\u0423\u0436\u043e \u043d\u044f\u043c\u0430 \u0447\u0430\u0441\u0443, \u0430\u043b\u0435 \u045e \u0434\u043d\u0456 \u0433\u043e\u043b\u0430\u0441\u0443 \u0441\u0451\u043c\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u0446\u044c, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0411\u043e\u0433\u0430, \u0442\u0430\u043a \u044f\u043a \u0401\u043d \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u044f \u043f\u0430\u0447\u0443\u045e \u0437 \u043d\u0435\u0431\u0430, \u0437\u043d\u043e\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e \u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0434\u0437\u0456, \u0432\u0430\u0437\u044c\u043c\u0456 \u0440\u0430\u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0443\u044e \u043a\u043d\u0456\u0433\u0443 \u0437 \u0440\u0443\u043a\u0456 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u043c\u043e\u0440\u044b \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456&raquo;. \u0406 \u044f \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0430\u043d\u0451\u043b\u0430, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443, \u043a\u0430\u0431 \u0451\u043d \u0434\u0430\u045e \u043c\u043d\u0435 \u043a\u043d\u0456\u0433\u0443. \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456 \u0456 \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0456 \u044f\u0435. \u042f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0433\u043e\u0440\u043a\u0430\u044f \u0434\u043b\u044f \u0436\u044b\u0432\u0430\u0442\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0430\u043b\u0435 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u0442\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u044f, \u044f\u043a \u043c\u0451\u0434&raquo;. \u0406 \u045e\u0437\u044f\u045e \u044f \u043a\u043d\u0456\u0433\u0443 \u0437 \u0440\u0443\u043a\u0456 \u0430\u043d\u0451\u043b\u0430, \u0456 \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u044f\u0435. \u0406 \u0431\u044b\u043b\u0430 \u044f\u043d\u0430 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u043c\u0430\u0456\u0445 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u044f, \u044f\u043a \u043c\u0451\u0434. \u0410 \u043a\u0430\u043b\u0456 \u0437&rsquo;\u0435\u045e \u044f\u0435, \u0442\u043e \u0433\u043e\u0440\u043a\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430\u0441\u044f \u045e \u0436\u044b\u0432\u0430\u0446\u0435 \u043c\u0430\u0456\u043c. \u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043c\u043d\u0435: &laquo;\u0422\u044b \u0437\u043d\u043e\u045e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u043f\u043b\u044f\u043c\u0451\u043d\u044b, \u0456 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043c\u043e\u0432\u044b, \u0456 \u043f\u0440\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 19, 7; \u041c\u0446 24, 30<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0437\u0430\u0433\u0443\u0447\u044b\u0446\u044c \u0442\u0440\u0443\u0431\u0430, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0411\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043a \u044f\u043a \u0401\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u0434\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0437\u043d\u0430\u043a \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u043e\u0446\u044b \u0456 \u0441\u043b\u0430\u0432\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u044f\u043a \u0401\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5037","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">11, 1-19<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0414\u0432\u0430 \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u044b\u044f \u0441\u0432\u0435\u0434\u043a\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0431\u0430\u0447\u044b\u045e, \u0456 \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u043a\u0456\u044f. \u0406 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u043c\u043d\u0435: &laquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0456 \u043f\u0430\u043c\u0435\u0440\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0411\u043e\u0433\u0430 \u0456 \u0430\u043b\u0442\u0430\u0440, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0451\u0439. \u0412\u043e\u043d\u043a\u0430\u0432\u044b \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0435\u0446 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u043f\u0430\u043a\u0456\u043d\u044c \u0437\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0443 \u0456 \u043d\u0435 \u043c\u0435\u0440\u0430\u0439 \u044f\u0433\u043e, \u0431\u043e \u0451\u043d \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c, \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u041c\u043e\u0439 \u0441\u0432\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0441\u043e\u0440\u0430\u043a \u0434\u0432\u0430 \u043c\u0435\u0441\u044f\u0446\u044b. \u0406 \u0434\u0430\u043c \u0434\u0432\u0443\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u043c \u0443 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443, \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u0442\u044b\u0441\u044f\u0447\u0430 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u0434\u0437\u0451\u043d&raquo;. \u042f\u043d\u044b \u044f\u043a \u0434\u0432\u0430 \u0434\u0440\u044d\u0432\u044b \u0430\u043b\u0456\u045e\u043d\u044b\u044f \u0456 \u0434\u0432\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0456, \u0448\u0442\u043e \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0437\u044f\u043c\u043b\u0456. \u0406 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0456\u0445 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c, \u0442\u043e \u0430\u0433\u043e\u043d\u044c \u0432\u044b\u0439\u0434\u0437\u0435 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456\u0445\u043d\u0456\u0445. \u0422\u043e\u0439, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0456\u0445 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c, \u0442\u043e\u0439 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0437\u0430\u0431\u0456\u0442\u044b \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c. \u042f\u043d\u044b \u043c\u0430\u044e\u0446\u044c \u0443\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u0440\u044b\u0446\u044c \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0456\u0448\u043e\u045e \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u045e \u0434\u043d\u0456 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0456\u0445\u043d\u044f\u0433\u0430, \u0456 \u043c\u0430\u044e\u0446\u044c \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0456\u0445 \u0443 \u043a\u0440\u043e\u045e \u0456 \u045e\u0434\u0430\u0440\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u045e\u0441\u044f\u043a\u0456\u043c \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u043c, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0445\u043e\u0447\u0443\u0446\u044c. \u0406 \u043a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u0430\u0446\u044c \u044f\u043d\u044b \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0451, \u0437\u0432\u0435\u0440, \u044f\u043a\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0431\u0435\u0437\u0434\u0430\u043d\u0456, \u043f\u0430\u0447\u043d\u0435 \u0432\u0430\u0439\u043d\u0443 \u0437 \u0456\u043c\u0456, \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0456\u0445, \u0456 \u0437\u0430\u0431&rsquo;\u0435 \u0456\u0445. \u0406 \u0442\u0440\u0443\u043f\u044b \u0456\u0445\u043d\u0456\u044f \u043f\u0430\u043a\u0456\u043d\u0435 \u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430, \u044f\u043a\u0456 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0421\u0430\u0434\u043e\u043c \u0456 \u0415\u0433\u0456\u043f\u0435\u0442, \u0434\u0437\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0456\u0445 \u041f\u0430\u043d. \u0406 \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e, \u0456 \u0440\u043e\u0434\u0430\u045e, \u0456 \u043c\u043e\u0432\u0430\u045e, \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0456\u0445 \u0442\u0440\u0443\u043f\u044b \u0442\u0440\u044b \u0437 \u043f\u0430\u043b\u043e\u0432\u0430\u044e \u0434\u043d\u0456 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u044f\u0446\u044c \u0456\u0445 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u045e \u043c\u0430\u0433\u0456\u043b\u0443. \u0416\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0430\u0446\u044c \u043f\u0430\u0434\u0430\u0440\u0443\u043d\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u0431\u043e \u0434\u0432\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0433\u044d\u0442\u044b\u044f \u043c\u0443\u0447\u044b\u043b\u0456 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0440\u0430\u0437 \u0442\u0440\u044b \u0441 \u043f\u0430\u043b\u043e\u0432\u0430\u044e \u0434\u043d\u0456 \u0434\u0443\u0445 \u0436\u044b\u0446\u0446\u044f \u0430\u0434 \u0411\u043e\u0433\u0430 \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0456\u0445, \u0456 \u044f\u043d\u044b \u045e\u0441\u0442\u0430\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u043d\u043e\u0433\u0456. \u0406 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0442\u0440\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430 \u0456\u0445 \u0433\u043b\u044f\u0434\u0437\u0435\u045e. \u0406 \u043f\u0430\u0447\u0443\u043b\u0456 \u044f\u043d\u044b \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0423\u0437\u044b\u0434\u0437\u0456\u0446\u0435 \u0441\u044e\u0434\u044b&raquo;. \u0406 \u044f\u043d\u044b \u045e\u0437\u044b\u0448\u043b\u0456 \u043d\u0430 \u043d\u0435\u0431\u0430 \u045e \u0432\u043e\u0431\u043b\u0430\u043a\u0443, \u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0456 \u0456\u0445\u043d\u0456\u044f. \u0406 \u045e \u0433\u044d\u0442\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0430\u0434\u0431\u044b\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441, \u0456 \u0430\u0434\u043d\u0430 \u0434\u0437\u044f\u0441\u044f\u0442\u0430\u044f \u0433\u043e\u0440\u0430\u0434\u0430 \u045e\u043f\u0430\u043b\u0430, \u0456 \u0431\u044b\u043b\u0456 \u0437\u0430\u0431\u0456\u0442\u044b\u044f \u043f\u0430\u0434\u0447\u0430\u0441 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441\u0443 \u0442\u044b\u0441\u044f\u0447\u0430 \u0441\u0435\u043c \u0430\u0441\u043e\u0431 \u043b\u044e\u0434\u0441\u043a\u0456\u0445, \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u0436 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f \u0456 \u045e\u0437\u043d\u0435\u0441\u043b\u0456 \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0443 \u043d\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0456\u043d\u0443\u043b\u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u0431\u044f\u0434\u0430, \u0432\u043e\u0441\u044c \u0445\u0443\u0442\u043a\u0430 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0440\u044d\u0446\u044f\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u0442\u0440\u0443\u0431\u0456\u045e \u0441\u0451\u043c\u044b \u0430\u043d\u0451\u043b. \u0406 \u043f\u0430\u0447\u0443\u043b\u0456\u0441\u044f \u045e \u043d\u0435\u0431\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0433\u0430\u043b\u0430\u0441\u044b, \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e, \u0456 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0441\u0442\u0430\u0440\u0446\u044b, \u0448\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0442\u0440\u043e\u043d\u0430\u0445 \u0441\u0432\u0430\u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0443\u043f\u0430\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0442\u0432\u0430\u0440\u044b \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0411\u043e\u0433\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0456 \u044f\u043a\u0456 \u0431\u044b\u045e, \u0431\u043e \u0422\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u0432\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u043e\u0446 \u0456 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e. \u0406 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0422\u0432\u043e\u0439 \u0433\u043d\u0435\u045e \u0456 \u0447\u0430\u0441 \u0441\u0443\u0434\u0430 \u043d\u0430\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0441\u043b\u0443\u0433\u0430\u043c \u0422\u0432\u0430\u0456\u043c, \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u044b\u043c, \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f, \u043c\u0430\u043b\u044b\u043c \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0437\u044f\u043c\u043b\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0430\u0434\u0447\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u045e \u043d\u0435\u0431\u0435, \u0456 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043a\u0430\u045e\u0447\u044d\u0433 \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u042f\u0433\u043e\u043d\u0430\u0439. \u0406 \u043f\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0431\u043b\u0456\u0441\u043a\u0430\u0432\u0456\u0446\u044b, \u0433\u0443\u043b \u0456 \u0433\u0440\u044b\u043c\u043e\u0442\u044b, \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441 \u0456 \u0432\u044f\u043b\u0456\u0437\u043d\u044b \u0433\u0440\u0430\u0434.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 11, 15b; \u0414\u0430\u043d 7, 27c<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e;<span style=\"color: #ff0000;\"> *<\/span> \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u042f\u0433\u043e &ndash; \u0432\u0435\u0447\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0456 \u045e\u0441\u0435 \u043a\u0430\u0440\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5041","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">12, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u043d\u0430\u043a \u0436\u0430\u043d\u0447\u044b\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043b\u0456\u043a\u0456 \u0437\u043d\u0430\u043a \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u043d\u0435\u0431\u0435: \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u044f \u045e \u0441\u043e\u043d\u0446\u0430, \u0456 \u043c\u0435\u0441\u044f\u0446 \u043f\u0430\u0434 \u043d\u0430\u0433\u0430\u043c\u0456 \u044f\u0435, \u0430 \u043d\u0430\u0434 \u044f\u0435 \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u044f\u043d\u043e\u043a \u0437 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0437\u043e\u0440\u0430\u043a. \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0446\u044f\u0436\u0430\u0440\u043d\u0430\u044f \u0456 \u043a\u0440\u044b\u0447\u0430\u043b\u0430 \u0430\u0434 \u0431\u043e\u043b\u044e \u0456 \u0440\u043e\u0434\u0430\u0432\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u045e. \u0406 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0434\u0440\u0443\u0433\u0456 \u0437\u043d\u0430\u043a \u043d\u0430 \u043d\u0435\u0431\u0435: \u0432\u043e\u0441\u044c \u0432\u044f\u043b\u0456\u043a\u0456 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b \u0446\u043c\u043e\u043a \u0437 \u0441\u044f\u043c\u044e \u0433\u0430\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e \u0440\u0430\u0433\u0430\u043c\u0456, \u0430 \u043d\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u044f\u0433\u043e \u0441\u0435\u043c \u0434\u044b\u044f\u0434\u044d\u043c. \u0425\u0432\u043e\u0441\u0442 \u044f\u0433\u043e\u043d\u044b \u0437\u043c\u044f\u0442\u0430\u0435 \u0442\u0440\u0430\u0446\u0456\u043d\u0443 \u0437\u043e\u0440\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0456 \u043a\u0456\u0434\u0430\u0435 \u0456\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0426\u043c\u043e\u043a \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0436\u044d\u0440\u0446\u0456 \u0434\u0437\u0456\u0446\u044f, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c. \u0406 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u043d\u0430 \u0441\u044b\u043d\u0430, \u043c\u0443\u0436\u0447\u044b\u043d\u0443, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c \u043a\u0456\u0435\u043c. \u0406 \u0434\u0437\u0456\u0446\u0451 \u0431\u044b\u043b\u043e \u0437\u0430\u0431\u0440\u0430\u043d\u0430 \u0430\u0434 \u044f\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430. \u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u045e\u0446\u044f\u043a\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u0434\u0437\u0435 \u0451\u0439 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u0431 \u044f\u0435 \u043a\u0430\u0440\u043c\u0456\u043b\u0456 \u0442\u0430\u043c \u0442\u044b\u0441\u044f\u0447\u0443 \u0434\u0437\u0432\u0435\u0441\u0446\u0435 \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u0434\u0437\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u0432\u0430\u0439\u043d\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435: \u041c\u0456\u0445\u0430\u043b \u0456 \u0430\u043d\u0451\u043b\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0432\u0430\u044f\u0432\u0430\u043b\u0456 \u0437 \u0446\u043c\u043e\u043a\u0430\u043c. \u0406 \u0446\u043c\u043e\u043a \u0432\u0430\u044f\u0432\u0430\u045e, \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b. \u0410\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u0456\u0445 \u043d\u0430 \u043d\u0435\u0431\u0435. \u0406 \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u044b\u045e \u0446\u043c\u043e\u043a \u0432\u044f\u043b\u0456\u043a\u0456, \u0437\u043c\u0435\u0439 \u0441\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u0456, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430\u043c \u0456 \u0441\u0430\u0442\u0430\u043d\u043e\u044e, \u0448\u0442\u043e \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442. \u0401\u043d \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u044b\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0437 \u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0430\u043d\u0451\u043b\u044b \u044f\u0433\u043e\u043d\u044b\u044f. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u043e\u043b\u0430\u0441 \u043c\u043e\u0446\u043d\u044b, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0437 \u043d\u0435\u0431\u0430: &laquo;\u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u0456\u043b\u0430, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u045e\u043b\u0430\u0434\u0430 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0431\u043e \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u044f\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u043e\u0447 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u045e \u0456\u0445 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c. \u042f\u043d\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u044f\u0433\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u0443 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e; \u0456 \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430\u0441\u044f\u043b\u044f\u0435 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0440\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043c\u043e\u0440\u0443, \u0431\u043e \u0441\u044b\u0448\u043e\u045e \u0434&rsquo;\u044f\u0431\u0430\u043b \u0434\u0430 \u0432\u0430\u0441 \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u043d\u0435\u0432\u0435, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u044f\u0433\u043e!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0446\u043c\u043e\u043a \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0451\u043d \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043f\u0430\u0447\u0430\u045e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u0443. \u0406 \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0436\u0430\u043d\u0447\u044b\u043d\u0435 \u0434\u0432\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0430\u0440\u043b\u0456\u043d\u044b\u044f \u043a\u0440\u044b\u043b\u044b, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043b\u044f\u0446\u0435\u043b\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u0441\u0432\u0430\u0451, \u0434\u0437\u0435 \u044f\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0447\u0430\u0441, \u0456 \u0447\u0430\u0441\u044b, \u0456 \u043f\u0430\u043b\u043e\u0432\u0443 \u0447\u0430\u0441\u0443 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0446\u043c\u043e\u043a\u0430. \u0406 \u043f\u0443\u0441\u0446\u0456\u045e \u0437\u043c\u0435\u0439 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0437\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439 \u0432\u0430\u0434\u0443, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u0430\u043a\u0443, \u043a\u0430\u0431 \u044f\u0435 \u043f\u0430\u043d\u0435\u0441\u043b\u0430 \u0440\u0430\u043a\u0430. \u0410\u043b\u0435 \u0437\u044f\u043c\u043b\u044f \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0435, \u0456 \u0430\u0434\u043a\u0440\u044b\u043b\u0430 \u0437\u044f\u043c\u043b\u044f \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435, \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0440\u0430\u043a\u0443, \u044f\u043a\u0443\u044e \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u045e \u0446\u043c\u043e\u043a \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u0446\u043c\u043e\u043a \u043d\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0443 \u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0432\u0430\u0439\u043d\u0443 \u0437 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c\u0456 \u044f\u0435 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0411\u043e\u0433\u0430 \u0456 \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430. \u0406 \u0441\u0442\u0430\u045e \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 12, 11. 12\u0430; 2 \u041c\u0430\u043a 7, 36\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u0443 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e; \u0456 \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430\u0441\u044f\u043b\u044f\u0435 \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u045e \u0447\u0430\u0441\u043e\u0432\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u0442\u0430\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430\u0441\u044f\u043b\u044f\u0435 \u0456\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"5042","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">13, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0414\u0432\u0430 \u0437\u0432\u044f\u0440\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0437\u0432\u0435\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043c\u043e\u0440\u0430 \u0456 \u043c\u0435\u045e \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0433\u043e\u045e \u0456 \u0441\u0435\u043c \u0433\u0430\u043b\u043e\u045e, \u0430 \u043d\u0430 \u0440\u0430\u0433\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0434\u044b\u044f\u0434\u044d\u043c, \u0456 \u043d\u0430 \u0433\u0430\u043b\u043e\u0432\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445 \u0456\u043c\u044f \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430. \u0417\u0432\u0435\u0440, \u044f\u043a\u043e\u0433\u0430 \u044f \u045e\u0431\u0430\u0447\u044b\u045e, \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u045e \u043f\u0430\u043d\u0442\u044d\u0440\u0443, \u0430 \u043b\u0430\u043f\u044b \u044f\u0433\u043e \u044f\u043a \u0443 \u043c\u044f\u0434\u0437\u0432\u0435\u0434\u0437\u044f, \u0430 \u043f\u0430\u0448\u0447\u0430 \u044f\u0433\u043e \u044f\u043a \u0443 \u043b\u044c\u0432\u0430. \u0406 \u0434\u0430\u045e \u044f\u043c\u0443 \u0446\u043c\u043e\u043a \u0441\u0432\u0430\u044e \u043c\u043e\u0446, \u0456 \u0442\u0440\u043e\u043d \u0441\u0432\u043e\u0439, \u0456 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443. \u0406 \u0430\u0434\u043d\u0430 \u0437 \u0433\u0430\u043b\u043e\u045e \u044f\u0433\u043e &ndash; \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430 \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430\u044f, \u0430 \u044f\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u0440\u0430\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u043b\u0435\u0447\u0430\u043d\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u0434\u0437\u0456\u0432\u0456\u043b\u0430\u0441\u044f, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0437\u0432\u0435\u0440\u0430\u043c; \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0446\u043c\u043e\u043a\u0443, \u0431\u043e \u0451\u043d \u0434\u0430\u045e \u0443\u043b\u0430\u0434\u0443 \u0437\u0432\u0435\u0440\u0443; \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0437\u0432\u0435\u0440\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0437\u0432\u0435\u0440\u0430, \u0456 \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u043f\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u0439\u043d\u0443 \u0437 \u0456\u043c?&raquo;<br \/>\u0406 \u0431\u044b\u043b\u0456 \u044f\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u0440\u044d\u0447\u044b, \u044f\u043a\u0456\u044f \u0433\u0443\u0447\u0430\u043b\u0456 \u044f\u043a \u0432\u044f\u043b\u0456\u043a\u0456\u044f, \u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u044b, \u0456 \u0431\u044b\u043b\u0430 \u044f\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u043b\u0430\u0434\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u0441\u043e\u0440\u0430\u043a \u0434\u0432\u0430 \u043c\u0435\u0441\u044f\u0446\u044b. \u0406 \u0430\u0434\u043a\u0440\u044b\u045e \u0451\u043d \u0441\u0432\u0430\u044e \u043f\u044b\u0441\u0443 \u0434\u043b\u044f \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0431\u043b\u044e\u0437\u043d\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u042f\u0433\u043e, \u0456 \u0441\u043a\u0456\u043d\u0456\u0456 \u042f\u0433\u043e, \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e. \u0414\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0432\u0430\u0439\u043d\u0443 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0456\u0445, \u0456 \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u045e\u043b\u0430\u0434\u0430 \u043d\u0430\u0434 \u043a\u043e\u0436\u043d\u044b\u043c \u043f\u043b\u0435\u043c\u0435\u043c, \u0456 \u0440\u043e\u0434\u0430\u043c, \u0456 \u043c\u043e\u0432\u0430\u0439, \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0406 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u044f\u043c\u0443 \u045e\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456, \u0447\u044b\u0451 \u0456\u043c\u044f \u043d\u0435 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0430\u0434 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u045e \u043a\u043d\u0456\u0437\u0435 \u0436\u044b\u0446\u0446\u044f \u0437\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435. \u041a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u043c\u0443 \u043d\u0430\u043a\u0430\u043d\u0430\u0432\u0430\u043d\u0430 \u043d\u044f\u0432\u043e\u043b\u044f, \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0437\u0435 \u045e \u043d\u044f\u0432\u043e\u043b\u044e. \u041a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u043c\u0443 \u043d\u0430\u043a\u0430\u043d\u0430\u0432\u0430\u043d\u0430 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0430\u0434 \u043c\u044f\u0447\u0430, \u0442\u043e\u0439 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0437\u0430\u0431\u0456\u0442\u044b \u043c\u044f\u0447\u043e\u043c. \u0423 \u0433\u044d\u0442\u044b\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u0456\u043d\u0448\u0430\u0433\u0430 \u0437\u0432\u0435\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043c\u0435\u045e \u0434\u0432\u0430 \u0440\u043e\u0433\u0456, \u044f\u043a \u0443 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0430\u043b\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u044f\u043a \u0446\u043c\u043e\u043a. \u0406 \u0451\u043d \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u043c \u0437\u0432\u0435\u0440\u0430\u043c \u0437 \u0443\u0441\u0451\u0439 \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u0439 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u043a, \u043a\u0430\u0431 \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u0456 \u044f\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0448\u0430\u043c\u0443 \u0437\u0432\u0435\u0440\u0443, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u0440\u0430\u043d\u0430 \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u043b\u0435\u0447\u0430\u043d\u0430. \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0437\u043d\u0430\u043a\u0456, \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u044e\u0447\u044b \u043d\u0430\u0432\u0430\u0442 \u0430\u0433\u043e\u043d\u044c \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0410\u0448\u0443\u043a\u0432\u0430\u0435 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0437\u044f\u043c\u043b\u0456 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0437\u043d\u0430\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0437\u0432\u0435\u0440\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u0432\u0435\u0440\u0430, \u044f\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0434\u0430\u0440 \u043c\u044f\u0447\u043e\u043c \u0456 \u0430\u0436\u044b\u045e. \u0406 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0434\u0443\u0445\u0430\u043c \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u0432\u0435\u0440\u0430, \u043a\u0430\u0431 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u0432\u0435\u0440\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u0442\u0430\u043a, \u043a\u0430\u0431 \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u0437\u0432\u0435\u0440\u0430. \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u045e\u0441\u0435, \u043c\u0430\u043b\u044b\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f, \u0431\u0430\u0433\u0430\u0442\u044b\u044f \u0456 \u0431\u0435\u0434\u043d\u044b\u044f, \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u044f \u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u043a\u043b\u044f\u0439\u043c\u043e \u043d\u0430 \u043f\u0440\u0430\u0432\u0443\u044e \u0440\u0443\u043a\u0443 \u0430\u0431\u043e \u043d\u0430 \u0441\u0432\u0430\u0451 \u0447\u0430\u043b\u043e; \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0456 \u043a\u0443\u043f\u0456\u0446\u044c, \u043d\u0456 \u043f\u0440\u0430\u0434\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043c\u0430\u0435 \u0437\u043d\u0430\u043a\u0443, \u0456\u043c\u0435\u043d\u0456 \u0437\u0432\u0435\u0440\u0430 \u0430\u0431\u043e \u043b\u0456\u0447\u0431\u044b \u0456\u043c\u0435\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430. \u0422\u0443\u0442 \u0451\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u0425\u0442\u043e \u043c\u0430\u0435 \u0440\u043e\u0437\u0443\u043c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u043b\u0456\u0447\u044b\u0446\u044c \u043b\u0456\u0447\u0431\u0443 \u0437\u0432\u0435\u0440\u0430, \u0431\u043e \u0433\u044d\u0442\u0430 \u043b\u0456\u0447\u0431\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0410 \u043b\u0456\u0447\u0431\u0430 \u044f\u0433\u043e \u0448\u044d\u0441\u0446\u044c\u0441\u043e\u0442 \u0448\u044d\u0441\u0446\u044c\u0434\u0437\u0435\u0441\u044f\u0442 \u0448\u044d\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 3, 5; \u041c\u0446 10, 22b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430, \u0456 \u042f \u043d\u0435 \u0441\u0430\u0442\u0440\u0443 \u0456\u043c\u0435\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0437 \u043a\u043d\u0456\u0433\u0456 \u0436\u044b\u0446\u0446\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0432\u044b\u0437\u043d\u0430\u044e \u044f\u0433\u043e \u0456\u043c\u044f \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c \u041c\u0430\u0456\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0436 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u044b\u0437\u043d\u0430\u044e \u044f\u0433\u043e \u0456\u043c\u044f \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c \u041c\u0430\u0456\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5043","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">14, 1-13<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0421\u0456\u0451\u043d\u0441\u043a\u0430\u0439 \u0433\u0430\u0440\u044b, \u0430 \u0437 \u0406\u043c \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0447\u0430\u0442\u044b\u0440\u044b \u0442\u044b\u0441\u044f\u0447\u044b, \u0443 \u044f\u043a\u0456\u0445 \u0456\u043c\u044f \u042f\u0433\u043e \u0456 \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u043d\u0430 \u0447\u043e\u043b\u0430\u0445. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a \u0448\u0443\u043c \u0430\u0434 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u043e\u0434\u0430\u045e \u0456 \u044f\u043a \u0433\u0443\u043a \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0433\u0440\u043e\u043c\u0443. \u0410 \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043f\u0430\u0447\u0443\u045e, \u0431\u044b\u045e \u043d\u0456\u0431\u044b \u0433\u043e\u043b\u0430\u0441 \u0433\u0443\u0441\u043b\u044f\u0440\u043e\u045e, \u0448\u0442\u043e \u0433\u0440\u0430\u043b\u0456 \u043d\u0430 \u0433\u0443\u0441\u043b\u044f\u0445 \u0441\u0432\u0430\u0456\u0445. \u042f\u043d\u044b \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u044f\u043a \u0431\u044b \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0456 \u043f\u0435\u0440\u0430\u0434 \u0447\u0430\u0442\u044b\u0440\u043c\u0430 \u0436\u044b\u0432\u044b\u043c\u0456 \u0456\u0441\u0442\u043e\u0442\u0430\u043c\u0456 \u0456 \u0441\u0442\u0430\u0440\u0446\u0430\u043c\u0456. \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0435\u0441\u043d\u0456, \u0430\u043a\u0440\u0430\u043c\u044f \u0441\u0442\u0430 \u0441\u0430\u0440\u0430\u043a\u0430 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0442\u044b\u0441\u044f\u0447, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u0445 \u0437 \u0437\u044f\u043c\u043b\u0456. \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0437\u0433\u0430\u043d\u044c\u0431\u0456\u045e \u0441\u044f\u0431\u0435 \u0437 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u0431\u043e \u0433\u044d\u0442\u0430 \u0446\u043d\u0430\u0442\u043b\u0456\u045e\u0446\u044b. \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0456\u0434\u0443\u0446\u044c \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c, \u043a\u0443\u0434\u044b \u0431 \u0401\u043d \u043d\u0456 \u043f\u0430\u0439\u0448\u043e\u045e. \u042f\u043d\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0437 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a \u043f\u0430\u0447\u0430\u0442\u043a\u0456 \u0411\u043e\u0433\u0443 \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443. \u0423 \u0432\u0443\u0441\u043d\u0430\u0445 \u0456\u0445\u043d\u0456\u0445 \u043d\u044f\u043c\u0430 \u043f\u0430\u0434\u043c\u0430\u043d\u0443. \u042f\u043d\u044b \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0456\u043d\u0448\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u043b\u044f\u0446\u0435\u045e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0437\u044f\u043c\u043b\u0456 \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0440\u043e\u0434\u0443, \u0456 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u0456 \u043c\u043e\u0432\u0435, \u0456 \u043d\u0430\u0440\u043e\u0434\u0443, \u0433\u043e\u043b\u0430\u0441\u043d\u0430 \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0411\u043e\u0433\u0430 \u0456 \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0443, \u0431\u043e \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u0443\u0434\u0430; \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u0456 \u043c\u043e\u0440\u0430, \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u043e\u0434\u0430\u045e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u043d\u0448\u044b, \u0434\u0440\u0443\u0433\u0456 \u0430\u043d\u0451\u043b \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0423\u043f\u0430\u045e, \u0443\u043f\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u0430\u0431\u0456\u043b\u0451\u043d, \u044f\u043a\u0456 \u043d\u0430\u043f\u0430\u0456\u045e \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0432\u0456\u043d\u043e\u043c \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0442\u0430\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0456\u043d\u0448\u044b \u0430\u043d\u0451\u043b, \u0442\u0440\u044d\u0446\u0456, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0430\u0441\u043b\u044f \u0456\u0445, \u0433\u0443\u0447\u043d\u0430 \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u0437\u0432\u0435\u0440\u0443 \u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443 \u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u043a\u043b\u044f\u0439\u043c\u043e \u044f\u0433\u043e \u043d\u0430 \u0447\u0430\u043b\u043e \u0441\u0432\u0430\u0451 \u0446\u0456 \u043d\u0430 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u0441\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u043f&rsquo;\u0435\u0446\u0446\u0430 \u0432\u0456\u043d\u0430 \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0431\u0435\u0437 \u0434\u0430\u043c\u0435\u0448\u043a\u0443 \u045e \u043a\u0435\u043b\u0456\u0445\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443, \u0456 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u044b \u0430\u0433\u043d\u0451\u043c \u0456 \u0441\u0435\u0440\u0430\u0439 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c. \u0414\u044b\u043c \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u0456\u0445\u043d\u044f\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u043d\u0456 \u0434\u043d\u0451\u043c, \u043d\u0456 \u043d\u043e\u0447\u0447\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u0437\u0432\u0435\u0440\u0443 \u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u044f\u0433\u043e, \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u043a\u043b\u044f\u0439\u043c\u043e \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456\u043c\u0435\u043d\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u043f\u0456\u0448\u044b: \u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c \u0443 \u041f\u0430\u043d\u0443. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, &ndash; \u043a\u0430\u0436\u0430 \u0414\u0443\u0445, &ndash; \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043f\u0430\u0447\u043d\u0443\u0446\u044c \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0446, \u0431\u043e \u0456\u0445\u043d\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0456\u043c\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 14, 7. 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u0447\u0443\u045e \u0437 \u043d\u0435\u0431\u0430 \u0433\u043e\u043b\u0430\u0441 \u043c\u043d\u043e\u0433\u0456\u0445 \u0430\u043d\u0451\u043b\u0430\u045e: <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u0431\u043e\u0439\u0446\u0435\u0441\u044f \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u0446\u0435 \u042f\u0433\u043e, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u043c\u043e\u0440\u0430 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u043e\u0434\u0430\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0431\u0430\u0447\u044b\u045e \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456 \u043b\u044f\u0446\u0435\u045e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0431\u0430 \u0456 \u0433\u0443\u0447\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0431\u043e\u0439\u0446\u0435\u0441\u044f \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u0446\u0435 \u042f\u0433\u043e, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u043c\u043e\u0440\u0430 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u043e\u0434\u0430\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5044","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">14, 14 &ndash; 15, 4<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0416\u043d\u0456\u0432\u043e \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0431\u0430\u0447\u044b\u045e: \u0432\u043e\u0441\u044c \u0431\u0435\u043b\u0430\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430, \u0430 \u043d\u0430 \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430. \u041d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u042f\u0433\u043e \u0437\u0430\u043b\u0430\u0442\u044b \u0432\u044f\u043d\u043e\u043a, \u0430 \u045e \u0440\u0443\u0446\u044d \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u043e\u0441\u0442\u0440\u044b \u0441\u0435\u0440\u043f. \u0406 \u0432\u044b\u0439\u0448\u0430\u045e \u0434\u0440\u0443\u0433\u0456 \u0430\u043d\u0451\u043b \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0432\u043e\u0431\u043b\u0430\u043a\u0443: &laquo;\u041f\u0430\u0448\u043b\u0456 \u0441\u0435\u0440\u043f \u0422\u0432\u043e\u0439 \u0456 \u043f\u0430\u0447\u044b\u043d\u0430\u0439 \u0436\u0430\u0446\u044c, \u0431\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0447\u0430\u0441 \u0436\u043d\u0456\u0432\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0436\u043d\u0456\u0432\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u0430\u0441\u043f\u0435\u043b\u0430. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0432\u043e\u0431\u043b\u0430\u043a\u0443, \u043a\u0456\u043d\u0443\u045e \u0441\u0435\u0440\u043f \u0441\u0432\u043e\u0439 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0437\u044f\u043c\u043b\u044f \u0431\u044b\u043b\u0430 \u043f\u0430\u0436\u0430\u0442\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0440\u0443\u0433\u0456 \u0430\u043d\u0451\u043b \u0432\u044b\u0439\u0448\u0430\u045e \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435, \u0456 \u0451\u043d \u043c\u0435\u045e \u0432\u043e\u0441\u0442\u0440\u044b \u0441\u0435\u0440\u043f. \u0406 \u0456\u043d\u0448\u044b \u0430\u043d\u0451\u043b, \u044f\u043a\u0456 \u043c\u0435\u045e \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0430\u0433\u043d\u0451\u043c, \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0456 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043a\u0440\u044b\u043a\u043d\u0443\u045e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0435\u045e \u0432\u043e\u0441\u0442\u0440\u044b \u0441\u0435\u0440\u043f: &laquo;\u041f\u0430\u0448\u043b\u0456 \u0432\u043e\u0441\u0442\u0440\u044b \u0441\u0435\u0440\u043f \u0442\u0432\u043e\u0439 \u0456 \u0437\u0431\u044f\u0440\u044b \u0433\u0440\u043e\u043d\u043a\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u0441\u0430\u0441\u043f\u0435\u043b\u0456 \u044f\u0433\u043e \u044f\u0433\u0430\u0434\u044b&raquo;. \u0406 \u043a\u0456\u043d\u0443\u045e \u0430\u043d\u0451\u043b \u0441\u0435\u0440\u043f \u0441\u0432\u043e\u0439 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0456 \u0441\u0430\u0431\u0440\u0430\u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u043a\u0456\u043d\u0443\u045e \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0434\u0430\u0432\u0456\u043b\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043b\u0456 \u0434\u0430\u0432\u0456\u043b\u0430 \u0437\u0430 \u0433\u043e\u0440\u0430\u0434\u0430\u043c, \u0430 \u0437 \u0434\u0430\u0432\u0456\u043b\u0430 \u043f\u0430\u0446\u044f\u043a\u043b\u0430 \u043a\u0440\u043e\u045e \u0430\u0436 \u043f\u0430 \u0432\u0443\u0437\u0434\u044d\u0447\u043a\u0456 \u043a\u043e\u043d\u0435\u0439, \u043d\u0430 \u0442\u044b\u0441\u044f\u0447\u0443 \u0448\u044d\u0441\u0446\u044c\u0441\u043e\u0442 \u0441\u0442\u0430\u0434\u044b\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u0456\u043d\u0448\u044b \u0437\u043d\u0430\u043a \u0443 \u043d\u0435\u0431\u0435, \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0434\u0437\u0456\u0432\u043e\u0441\u043d\u044b: \u0441\u0435\u043c \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0441\u0435\u043c \u0430\u043f\u043e\u0448\u043d\u0456\u0445 \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0456\u043c\u0456 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u0446\u0430 \u0433\u043d\u0435\u045e \u0411\u043e\u0436\u044b. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u043d\u0456\u0431\u044b\u0442\u0430 \u0448\u043a\u043b\u044f\u043d\u043e\u0435 \u043c\u043e\u0440\u0430, \u0437\u043c\u044f\u0448\u0430\u043d\u0430\u0435 \u0437 \u0430\u0433\u043d\u0451\u043c, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0437\u0432\u0435\u0440\u0430, \u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u044f\u0433\u043e\u043d\u044b, \u0456 \u043b\u0456\u0447\u0431\u0443 \u0456\u043c\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u0441\u0442\u0430\u044f\u043b\u0456 \u043d\u0430\u0434 \u0448\u043a\u043b\u044f\u043d\u044b\u043c \u043c\u043e\u0440\u0430\u043c, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0433\u0443\u0441\u043b\u0456 \u0411\u043e\u0436\u044b\u044f. \u0406 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0435\u0441\u043d\u044e \u041c\u0430\u0439\u0441\u0435\u044f, \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u0430\u0433\u0430, \u0456 \u043f\u0435\u0441\u043d\u044e \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u0432\u0430\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0422\u0432\u0430\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e! \u0425\u0442\u043e \u0436 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u044f\u0446\u0446\u0430, \u041f\u0430\u043d\u0435, \u0456 \u043d\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e? \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0422\u044b \u0430\u0434\u0437\u0456\u043d \u0421\u0432\u044f\u0442\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u0431\u043e \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0422\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 15, 3; \u0417\u044b\u0445 15, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0435\u0441\u043d\u044e \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u0432\u0430\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0422\u0432\u0430\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e! \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0422\u0430\u0431\u0435 \u043c\u0456\u0436 \u0431\u0430\u0433\u0430\u043c\u0456, \u041f\u0430\u043d\u0435? \u0425\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0422\u0430\u0431\u0435, \u0432\u0435\u043b\u0456\u0447\u043d\u044b \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0433\u0440\u043e\u0437\u043d\u044b \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b, \u044f\u043a\u0456 \u0447\u044b\u043d\u0456\u0448 \u0446\u0443\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0422\u0432\u0430\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e! \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5045","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">15, 5 &ndash; 16, 21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u0435\u043c \u0447\u0430\u0448\u0430\u045e \u0433\u043d\u0435\u0432\u0443 \u0411\u043e\u0436\u0430\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0430\u0434\u0447\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0441\u043a\u0456\u043d\u0456\u0456 \u0421\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u045e \u043d\u0435\u0431\u0435. \u0406 \u0432\u044b\u0439\u0448\u043b\u0430 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0441\u044f\u043c\u0451\u0440\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0441\u0435\u043c \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u045e. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0447\u044b\u0441\u0442\u044b \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b \u043b\u0451\u043d \u0456 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u043d\u044b\u044f \u0432\u0430\u043a\u043e\u043b \u0433\u0440\u0443\u0434\u0437\u0435\u0439 \u0437\u0430\u043b\u0430\u0442\u044b\u043c\u0456 \u043f\u0430\u0441\u0430\u043c\u0456. \u0410\u0434\u043d\u0430 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442 \u0434\u0430\u043b\u0430 \u0441\u044f\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u043c \u0441\u0435\u043c \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u0447\u0430\u0448, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u0445 \u0433\u043d\u0435\u0432\u0430\u043c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0406 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0434\u044b\u043c\u0430\u043c \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0456 \u0430\u0434 \u043c\u043e\u0446\u044b \u042f\u0433\u043e, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u0435\u043c \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u045e \u0441\u044f\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u043f\u0430\u0447\u0443\u045e, \u044f\u043a \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u043a\u0430\u0437\u0430\u045e \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0441\u044f\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u043c: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u0432\u044b\u043b\u0456\u0432\u0430\u0439\u0446\u0435 \u0441\u0435\u043c \u0447\u0430\u0448\u0430\u045e \u0433\u043d\u0435\u0432\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0439\u0448\u043e\u045e \u043f\u0435\u0440\u0448\u044b, \u0456 \u0432\u044b\u043b\u0456\u045e \u0447\u0430\u0448\u0443 \u0441\u0432\u0430\u044e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0406 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0437\u043b\u0430\u044f\u043a\u0430\u0441\u043d\u0430\u044f \u0456 \u0431\u0430\u043b\u044e\u0447\u0430\u044f \u044f\u0437\u0432\u0430 \u043d\u0430 \u043b\u044e\u0434\u0437\u044f\u0445, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u043a\u043b\u044f\u0439\u043c\u043e \u0437\u0432\u0435\u0440\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0440\u0443\u0433\u0456 \u0432\u044b\u043b\u0456\u045e \u0447\u0430\u0448\u0443 \u0441\u0432\u0430\u044e \u045e \u043c\u043e\u0440\u0430. \u0406 \u0441\u0442\u0430\u043b\u0430 \u044f\u043d\u043e \u044f\u043a \u0431\u044b \u043a\u0440\u044b\u0432\u0451\u044e \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430, \u0456 \u043a\u043e\u0436\u043d\u0430\u044f \u0436\u044b\u0432\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430 \u045e \u043c\u043e\u0440\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044d\u0446\u0456 \u0432\u044b\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u0447\u0430\u0448\u0443 \u045e \u0440\u044d\u043a\u0456 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u043e\u0434\u0430\u045e. \u0406 \u0441\u0442\u0430\u043b\u0456 \u044f\u043d\u044b \u043a\u0440\u044b\u0432\u0451\u044e. \u0406 \u044f \u043f\u0430\u0447\u0443\u045e \u0430\u043d\u0451\u043b\u0430 \u0432\u043e\u0434\u0430\u045e, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0422\u044b, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0456 \u044f\u043a\u0456 \u0431\u044b\u045e, \u0421\u0432\u044f\u0442\u044b, \u0448\u0442\u043e \u0442\u0430\u043a \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u045e, \u0431\u043e \u044f\u043d\u044b \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u043a\u0440\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0456 \u0422\u044b \u0434\u0430\u045e \u0456\u043c \u043f\u0456\u0446\u044c \u043a\u0440\u043e\u045e. \u042f\u043d\u044b \u0432\u0430\u0440\u0442\u044b\u044f \u0433\u044d\u0442\u0430\u0433\u0430!&raquo; \u0406 \u044f \u043f\u0430\u0447\u0443\u045e, \u044f\u043a \u043a\u0430\u0437\u0430\u045e \u0430\u043b\u0442\u0430\u0440: &laquo;\u0422\u0430\u043a, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0422\u0432\u0430\u0435 \u043f\u0440\u044b\u0441\u0443\u0434\u044b!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0432\u044b\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u0447\u0430\u0448\u0443 \u043d\u0430 \u0441\u043e\u043d\u0446\u0430. \u0406 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0441\u043f\u0430\u043b\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0433\u043d\u0451\u043c. \u0406 \u043b\u044e\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u043f\u0451\u043a\u0430\u0439, \u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0456\u043c\u044f \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c\u0456 \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0456, \u0456 \u043d\u0435 \u0430\u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u044f\u0442\u044b \u0432\u044b\u043b\u0456\u045e \u0447\u0430\u0448\u0443 \u0441\u0432\u0430\u044e \u043d\u0430 \u0442\u0440\u043e\u043d \u0437\u0432\u0435\u0440\u0430, \u0456 \u0437\u0430\u0446\u044c\u043c\u0456\u043b\u0430\u0441\u044f \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u044f\u0433\u043e, \u0430 \u043b\u044e\u0434\u0437\u0456 \u0430\u0434 \u0431\u043e\u043b\u044e \u0433\u0440\u044b\u0437\u043b\u0456 \u044f\u0437\u044b\u043a\u0456 \u0441\u0432\u0430\u0435, \u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0435\u0431\u0430 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0431\u043e\u043b\u044c \u0456 \u0437\u0430 \u0441\u0432\u0430\u0435 \u044f\u0437\u0432\u044b, \u0456 \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u043e\u0441\u0442\u044b \u0432\u044b\u043b\u0456\u045e \u0447\u0430\u0448\u0443 \u0441\u0432\u0430\u044e \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0440\u0430\u043a\u0443 \u0415\u045e\u0444\u0440\u0430\u0442. \u0406 \u0432\u044b\u0441\u0430\u0445\u043b\u0430 \u0432\u0430\u0434\u0430 \u044f\u0435, \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0430 \u0434\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0437 \u0443\u0441\u0445\u043e\u0434\u0443 \u0441\u043e\u043d\u0446\u0430. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0437 \u043f\u0430\u0448\u0447\u044b \u0446\u043c\u043e\u043a\u0430, \u0456 \u0437 \u043f\u0430\u0448\u0447\u044b \u0437\u0432\u0435\u0440\u0430, \u0456 \u0437 \u043f\u0430\u0448\u0447\u044b \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0442\u0440\u044b \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u0434\u0443\u0445\u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0436\u0430\u0431\u044b. \u0411\u044b\u043b\u0456 \u0433\u044d\u0442\u0430 \u0434\u0443\u0445\u0456 \u0434\u044d\u043c\u0430\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u0440\u0430\u0431\u0456\u043b\u0456 \u0437\u043d\u0430\u043a\u0456. \u042f\u043d\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0432\u0430\u0439\u043d\u0443 \u045e \u0433\u044d\u0442\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443 \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0441\u043f\u0456\u0446\u044c \u0456 \u043f\u0456\u043b\u044c\u043d\u0443\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451, \u043a\u0430\u0431 \u043d\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0433\u043e\u043b\u0430\u043c\u0443 \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043e\u0440\u0430\u043c\u0443 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u0430\u0431\u0440\u0430\u043b\u0456 \u0456\u0445 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430-\u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0443 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0410\u0440\u043c\u0430\u0433\u0435\u0434\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043c\u044b \u0430\u043d\u0451\u043b \u0432\u044b\u043b\u0456\u045e \u0447\u0430\u0448\u0443 \u0441\u0432\u0430\u044e \u045e \u043f\u0430\u0432\u0435\u0442\u0440\u0430. \u0406 \u0432\u044b\u0439\u0448\u0430\u045e \u0433\u043e\u043b\u0430\u0441 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0430\u0434 \u0442\u0440\u043e\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u0442\u0430\u043b\u0430\u0441\u044f!&raquo; \u0406 \u043f\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u043c\u0430\u043b\u0430\u043d\u043a\u0456, \u0456 \u0448\u0443\u043c, \u0456 \u0433\u0440\u044b\u043c\u043e\u0442\u044b, \u0456 \u0430\u0434\u0431\u044b\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0434 \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043a\u0456 \u043c\u043e\u0446\u043d\u044b, \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441. \u0406 \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434 \u043d\u0430 \u0442\u0440\u044b \u0447\u0430\u0441\u0442\u043a\u0456, \u0456 \u045e\u043f\u0430\u043b\u0456 \u0433\u0430\u0440\u0430\u0434\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. \u0406 \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u0430\u0431\u0456\u043b\u0451\u043d \u0431\u044b\u045e \u0437\u0433\u0430\u0434\u0430\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u043a\u0435\u043b\u0456\u0445 \u0432\u0456\u043d\u0430 \u043b\u044e\u0442\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u042f\u0433\u043e. \u0406 \u0437\u043d\u0456\u043a\u043b\u0430 \u043a\u043e\u0436\u043d\u0430\u044f \u0432\u044b\u0441\u043f\u0430, \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0433\u043e\u0440. \u0406 \u0432\u044f\u043b\u0456\u0437\u043d\u044b \u0433\u0440\u0430\u0434 \u0432\u0430\u0433\u043e\u044e \u0437 \u0442\u0430\u043b\u0430\u043d\u0442 \u043f\u0430\u0441\u044b\u043f\u0430\u045e\u0441\u044f \u0437 \u043d\u0435\u0431\u0430 \u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0406 \u043f\u0430\u0447\u0430\u043b\u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u043b\u044e\u0434\u0437\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0437\u0430 \u0431\u0435\u0434\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0434\u0443, \u0431\u043e \u0433\u044d\u0442\u0430\u0435 \u0431\u0435\u0434\u0441\u0442\u0432\u0430 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 24, 43\u0430; \u0410\u043f 16, 15\u0430; 1 \u0422\u044d\u0441 5, 3\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0431 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0434\u043e\u043c\u0443 \u0432\u0435\u0434\u0430\u045e, \u0443 \u044f\u043a\u0443\u044e \u0432\u0430\u0440\u0442\u0443 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437\u043b\u043e\u0434\u0437\u0435\u0439, \u0442\u043e \u043d\u0435 \u0441\u043f\u0430\u045e \u0431\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c, \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443 \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0441\u043f\u0456\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c: \u0421\u043f\u0430\u043a\u043e\u0439 \u0456 \u0431\u044f\u0441\u043f\u0435\u043a\u0430, &ndash; \u0442\u0430\u0434\u044b \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c \u043d\u0435\u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u0430\u044f \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0456\u0445. \u041d. \u0412\u043e\u0441\u044c, \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443 \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0441\u043f\u0456\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5046","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">17, 1-18<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0412\u044f\u043b\u0456\u043a\u0456 \u0411\u0430\u0431\u0456\u043b\u0451\u043d<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0437 \u0441\u044f\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0441\u0435\u043c \u0447\u0430\u0448, \u0456 \u043f\u0430\u0447\u0430\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0430\u0434\u0437\u0435\u043c, \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u0441\u0443\u0434 \u043d\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446\u0430\u0439, \u044f\u043a\u0430\u044f \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u0432\u043e\u0434\u0430\u043c\u0456, \u0437 \u044f\u043a\u043e\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0447\u0430\u043b\u0456 \u0437\u044f\u043c\u043d\u044b\u044f \u043a\u0430\u0440\u0430\u043b\u0456, \u0430 \u0437\u044f\u043c\u043d\u044b\u044f \u0436\u044b\u0445\u0430\u0440\u044b \u043d\u0430\u043f\u0456\u043b\u0456\u0441\u044f \u0432\u0456\u043d\u043e\u043c \u044f\u0435 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b&raquo;. \u0406 \u0437\u0430\u043d\u0451\u0441 \u0451\u043d \u043c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u045e \u0434\u0443\u0445\u0443, \u0456 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u044f\u043a\u0430\u044f \u0441\u044f\u0434\u0437\u0435\u043b\u0430 \u043d\u0430 \u043f\u0443\u043d\u0441\u043e\u0432\u044b\u043c \u0437\u0432\u0435\u0440\u044b, \u043f\u043e\u045e\u043d\u044b\u043c \u0456\u043c\u0451\u043d\u0430\u045e \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430, \u044f\u043a\u0456 \u043c\u0435\u045e \u0441\u0435\u043c \u0433\u0430\u043b\u043e\u045e \u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0433\u043e\u045e. \u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0431\u044b\u043b\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u044f \u045e \u043f\u0443\u0440\u043f\u0443\u0440\u043e\u0432\u0430\u0435 \u0456 \u043f\u0443\u043d\u0441\u043e\u0432\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u0430\u044f \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u043d\u0435\u043c, \u0456 \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u043c\u0456. \u042f\u043d\u0430 \u043c\u0435\u043b\u0430 \u045e \u0440\u0443\u0446\u044d \u0441\u0432\u0430\u0451\u0439 \u0437\u0430\u043b\u0430\u0442\u044b \u043a\u0435\u043b\u0456\u0445, \u043f\u043e\u045e\u043d\u044b \u0430\u0433\u0456\u0434\u044b \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b \u0441\u0432\u0430\u0451\u0439. \u0410 \u043d\u0430 \u0447\u0430\u043b\u0435 \u044f\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0456\u043c\u044f, \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430: &laquo;\u0412\u044f\u043b\u0456\u043a\u0456 \u0411\u0430\u0431\u0456\u043b\u0456\u0451\u043d &ndash; \u043c\u0430\u0446\u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446 \u0456 \u0430\u0433\u0456\u0434\u044b \u0437\u044f\u043c\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u043f&rsquo;\u044f\u043d\u0443\u044e \u0430\u0434 \u043a\u0440\u044b\u0432\u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456 \u0441\u0432\u0435\u0434\u0430\u043a \u0415\u0437\u0443\u0441\u0430. \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u044f\u0435, \u044f \u0430\u0441\u043b\u0443\u043f\u044f\u043d\u0435\u045e \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0456. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0430\u043d\u0451\u043b: &laquo;\u0427\u0430\u043c\u0443 \u0442\u044b \u0437\u0434\u0437\u0456\u0432\u0456\u045e\u0441\u044f? \u042f \u0440\u0430\u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0456 \u0437\u0432\u0435\u0440\u0430, \u0448\u0442\u043e \u043d\u043e\u0441\u0456\u0446\u044c \u044f\u0435 \u0456 \u043c\u0430\u0435 \u0441\u0435\u043c \u0433\u0430\u043b\u043e\u045e \u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0433\u043e\u045e. \u0417\u0432\u0435\u0440, \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u045e, \u0431\u044b\u045e, \u0456 \u043d\u044f\u043c\u0430 \u044f\u0433\u043e, \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0432\u044b\u0439\u0441\u0446\u0456 \u0437 \u0431\u0435\u0437\u0434\u0430\u043d\u0456 \u0456 \u0456\u0434\u0437\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443. \u0416\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456, \u0456\u043c\u0451\u043d\u044b \u044f\u043a\u0456\u0445 \u043d\u0435 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e \u043a\u043d\u0456\u0433\u0443 \u0436\u044b\u0446\u0446\u044f \u0430\u0434 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443, \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0437\u0456\u0432\u0456\u0446\u0446\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u044b\u045e \u0437\u0432\u0435\u0440, \u0456 \u043d\u044f\u043c\u0430 \u044f\u0433\u043e, \u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430. \u0422\u0443\u0442 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0440\u043e\u0437\u0443\u043c, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u0421\u0435\u043c \u0433\u0430\u043b\u043e\u045e &ndash; \u0433\u044d\u0442\u0430 \u0441\u0435\u043c \u0433\u043e\u0440, \u0434\u0437\u0435 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0430. \u0401\u0441\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0435\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u045e: \u043f\u044f\u0446\u044c \u0443\u043f\u0430\u043b\u0430, \u0430\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c, \u044f\u0448\u0447\u044d \u0430\u0434\u0437\u0456\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043a\u0440\u044b\u0445\u0443 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430. \u0410 \u0437\u0432\u0435\u0440, \u044f\u043a\u0456 \u0431\u044b\u045e \u0456 \u044f\u043a\u043e\u0433\u0430 \u043d\u044f\u043c\u0430, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0441\u044c\u043c\u044b\u043c. \u041d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0441\u0435\u043c\u044f\u0440\u044b\u0445 \u0456 \u043f\u043e\u0439\u0434\u0437\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443. \u0410 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0433\u043e\u045e, \u044f\u043a\u0456\u044f \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u045e, &ndash; \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u044f\u043a\u0456\u044f \u044f\u0448\u0447\u044d \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u044f\u043a \u043a\u0430\u0440\u0430\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443\u043b\u0430\u0434\u0443 \u043d\u0430 \u0430\u0434\u043d\u0443 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0437\u0432\u0435\u0440\u0430\u043c. \u042f\u043d\u044b \u0437 \u0456\u043c \u0430\u0434\u043d\u043e\u0439 \u0434\u0443\u043c\u043a\u0456, \u0430 \u0441\u0432\u0430\u044e \u043c\u043e\u0446 \u0456 \u045e\u043b\u0430\u0434\u0443 \u0434\u0430\u044e\u0446\u044c \u0437\u0432\u0435\u0440\u0443. \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c, \u0456 \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0456\u0445, \u0431\u043e \u0401\u043d \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0456 \u041a\u0430\u0440\u043e\u043b\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437 \u0406\u043c, &mdash; \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f, \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0456 \u0432\u0435\u0440\u043d\u044b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u0436\u0430 \u043c\u043d\u0435: &laquo;\u0412\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u0442\u044b \u0431\u0430\u0447\u044b\u045e \u0456 \u043d\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446\u0430, \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u043d\u0430\u0442\u043e\u045e\u043f\u044b, \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0456 \u043c\u043e\u0432\u044b. \u0410 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0440\u0430\u0433\u043e\u045e, \u044f\u043a\u0456\u044f \u0442\u044b \u0431\u0430\u0447\u044b\u045e, \u0456 \u0437\u0432\u0435\u0440 \u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044f\u0446\u044c \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446\u0443, \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u0446\u044c \u0456 \u0430\u0433\u0430\u043b\u044f\u0446\u044c \u044f\u0435, \u0456 \u0437&rsquo;\u044f\u0434\u0443\u0446\u044c \u044f\u0435 \u0446\u0435\u043b\u0430 \u0456 \u0441\u043f\u0430\u043b\u044f\u0446\u044c \u0430\u0433\u043d\u0451\u043c. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u043d\u0430\u0442\u0445\u043d\u0456\u045e \u0456\u0445 \u0441\u044d\u0440\u0446\u044b, \u043a\u0430\u0431 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u043d\u0430\u043c\u0435\u0440, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043d\u043e\u0439 \u0434\u0443\u043c\u043a\u0456 \u0437 \u0406\u043c, \u0456 \u043a\u0430\u0431 \u0430\u0434\u0434\u0430\u043b\u0456 \u0437\u0432\u0435\u0440\u0443 \u0441\u0432\u0430\u044e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043b\u043e\u0432\u044b. \u0410 \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0443\u044e \u0442\u044b \u0431\u0430\u0447\u044b\u045e, &ndash; \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0437\u044f\u043c\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 17, 14; 6, 2b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0440\u0430\u043b\u0456 \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c, \u0456 \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0456\u0445 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0401\u043d \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0456 \u041a\u0430\u0440\u043e\u043b\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043c\u0443 \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0432\u044f\u043d\u043e\u043a, \u0456 \u0401\u043d \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0401\u043d \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0456 \u041a\u0430\u0440\u043e\u043b\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5047","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">18, 1-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430 \u0456 \u043c\u0435\u045e \u0443\u043b\u0430\u0434\u0443 \u0432\u044f\u043b\u0456\u043a\u0443\u044e, \u0430 \u0437\u044f\u043c\u043b\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u044f\u0433\u043e\u043d\u0430\u0439. \u0406 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0451\u043d \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0423\u043f\u0430\u045e, \u0443\u043f\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u0430\u0431\u0456\u043b\u0451\u043d \u0456 \u0441\u0442\u0430\u045e \u0436\u044b\u043b\u043b\u0451\u043c \u0434\u044d\u043c\u0430\u043d\u0430\u045e \u0456 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430\u043c \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0434\u0443\u0445\u0430, \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430\u043c \u0443\u0441\u044f\u043a\u0430\u0439 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0439 \u043f\u0442\u0443\u0448\u043a\u0456 \u0456 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430\u043c \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u0432\u0435\u0440\u0430, \u0448\u0442\u043e \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0430\u0433\u0456\u0434\u0443, \u0431\u043e \u0432\u0456\u043d\u043e\u043c \u043b\u044e\u0442\u0430\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u044b \u044f\u0433\u043e \u043d\u0430\u043f\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0430 \u043a\u0430\u0440\u0430\u043b\u0456 \u0437\u044f\u043c\u043b\u0456 \u0447\u044b\u043d\u0456\u043b\u0456 \u0437 \u0456\u043c \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0443, \u0456 \u043a\u0443\u043f\u0446\u044b \u0437\u044f\u043c\u043b\u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u0437 \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u0439 \u0440\u0430\u0441\u043a\u043e\u0448\u044b \u044f\u0433\u043e!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0456\u043d\u0448\u044b \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0437 \u043d\u0435\u0431\u0430: &laquo;\u0412\u044b\u0439\u0434\u0437\u0456, \u043d\u0430\u0440\u043e\u0434 \u043c\u043e\u0439, \u0437 \u044f\u0433\u043e, \u043a\u0430\u0431 \u0432\u0430\u043c \u043d\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0433\u0440\u0430\u0445\u0430\u0445 \u044f\u0433\u043e \u0456 \u043d\u0435 \u043f\u0430\u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434 \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u045e \u044f\u0433\u043e. \u0411\u043e \u045e\u0437\u044b\u0448\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u044f\u0433\u043e \u0430\u0436 \u0434\u0430 \u043d\u0435\u0431\u0430 \u0456 \u0437\u0433\u0430\u0434\u0430\u045e \u0411\u043e\u0433 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u044f\u0433\u043e. \u0410\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u0435 \u044f\u043c\u0443, \u044f\u043a \u0456 \u0451\u043d \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u045e, \u0456 \u045e\u0434\u0432\u0430\u044f \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u0437\u0430 \u045e\u0447\u044b\u043d\u043a\u0456 \u044f\u0433\u043e. \u0423 \u043a\u0435\u043b\u0456\u0445\u0443, \u0443 \u044f\u043a\u0456\u043c \u0451\u043d \u0433\u0430\u0442\u0430\u0432\u0430\u045e \u0432\u0430\u043c \u0432\u0456\u043d\u043e, \u043f\u0440\u044b\u0433\u0430\u0442\u0443\u0439\u0446\u0435 \u044f\u043c\u0443 \u045e\u0434\u0432\u0430\u044f. \u041a\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u0441\u043b\u0430\u0432\u0456\u045e \u0441\u044f\u0431\u0435 \u0456 \u0436\u044b\u045e \u0443 \u0440\u0430\u0441\u043a\u043e\u0448\u044b, \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0439\u0446\u0435 \u044f\u043c\u0443 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0456 \u0441\u043c\u0443\u0442\u043a\u0443. \u0411\u043e \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c \u0451\u043d \u043a\u0430\u0436\u0430: &ldquo;\u042f \u0441\u044f\u0434\u0436\u0443 \u044f\u043a \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0456 \u044f \u043d\u0435 \u045e\u0434\u0430\u0432\u0430, \u0456 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u044e \u0441\u043c\u0443\u0442\u043a\u0443&rdquo;. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u045e \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0431\u0435\u0434\u0441\u0442\u0432\u044b \u044f\u0433\u043e: \u0441\u043c\u0435\u0440\u0446\u044c, \u0441\u043c\u0443\u0442\u0430\u043a \u0456 \u0433\u043e\u043b\u0430\u0434, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0441\u043f\u0430\u043b\u0435\u043d\u044b \u0430\u0433\u043d\u0451\u043c, \u0431\u043e \u043c\u043e\u0446\u043d\u044b \u041f\u0430\u043d \u0411\u043e\u0433, \u044f\u043a\u0456 \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u044f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437\u0430\u043f\u043b\u0430\u0447\u0443\u0446\u044c, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u044f\u043c\u0430\u043d\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0456 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456\u044f \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0447\u0430\u043b\u0456 \u0437 \u0456\u043c \u0456 \u0436\u044b\u043b\u0456 \u045e \u0440\u0430\u0441\u043a\u043e\u0448\u044b, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0434\u044b\u043c \u0430\u0434 \u043f\u0430\u0436\u0430\u0440\u0443 \u044f\u0433\u043e. \u0421\u0442\u0430\u045e\u0448\u044b \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u043a\u0443\u0442\u0430\u043c\u0456 \u044f\u0433\u043e, \u0441\u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u0413\u043e\u0440\u0430, \u0433\u043e\u0440\u0430, \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434 \u0411\u0430\u0431\u0456\u043b\u0451\u043d, \u043c\u043e\u0446\u043d\u044b \u0433\u043e\u0440\u0430\u0434, \u0431\u043e \u045e \u0430\u0434\u043d\u0443 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u044b\u0441\u0443\u0434 \u0442\u0432\u043e\u0439!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0443\u043f\u0446\u044b \u0437\u044f\u043c\u043b\u0456 \u043f\u043b\u0430\u0447\u0443\u0446\u044c \u0456 \u0441\u043c\u0443\u0442\u043a\u0443\u044e\u0446\u044c \u043d\u0430\u0434 \u0456\u043c, \u0431\u043e \u0456\u0445 \u0442\u0430\u0432\u0430\u0440\u0443 \u045e\u0436\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043a\u0443\u043f\u043b\u044f\u0435, \u0442\u0430\u0432\u0430\u0440\u0443 \u0437\u043e\u043b\u0430\u0442\u0430, \u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0456 \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u045e, \u0456 \u0442\u043e\u043d\u043a\u0430\u0433\u0430 \u043b\u0451\u043d\u0443, \u0456 \u043f\u0443\u0440\u043f\u0443\u0440\u044b, \u0456 \u0448\u043e\u045e\u043a\u0443, \u0456 \u043f\u0443\u043d\u0441\u043e\u0432\u0430\u0439 \u0442\u043a\u0430\u043d\u0456\u043d\u044b, \u0456 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0446\u044b\u0442\u0440\u0443\u0441\u0430\u0432\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430, \u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u0440\u044d\u0447\u044b \u0441\u0430 \u0441\u043b\u0430\u043d\u043e\u0432\u0430\u0439 \u043a\u043e\u0441\u0442\u043a\u0456, \u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u0440\u044d\u0447\u044b \u0437 \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430, \u0456 \u043c\u0435\u0434\u0437\u0456, \u0456 \u0436\u0430\u043b\u0435\u0437\u0430, \u0456 \u043c\u0430\u0440\u043c\u0443\u0440\u0443, \u0456 \u043a\u0430\u0440\u044b\u0446\u044b, \u0456 \u0430\u043c\u043e\u043c\u0443, \u0456 \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044f\u045e, \u0456 \u043c\u0456\u0440\u0430, \u0456 \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u0456 \u0432\u0456\u043d\u0430, \u0456 \u0430\u043b\u0435\u044e, \u0456 \u0447\u044b\u0441\u0442\u0430\u0439 \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0439 \u043c\u0443\u043a\u0456, \u0456 \u0437\u0431\u043e\u0436\u0436\u0430, \u0456 \u0436\u044b\u0432\u0451\u043b, \u0456 \u0430\u0432\u0435\u0447\u0430\u043a, \u0456 \u043a\u043e\u043d\u0435\u0439, \u0456 \u043f\u0430\u0432\u043e\u0437\u0430\u043a, \u0456 \u0446\u0435\u043b\u0430\u045e, \u0456 \u0434\u0443\u0448 \u043b\u044e\u0434\u0441\u043a\u0456\u0445. \u0406 \u043f\u043b\u043e\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0434\u0443\u0448\u044b \u0442\u0432\u0430\u0451\u0439 \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u0446\u044f\u0431\u0435, \u0456 \u045e\u0441\u0451 \u0441\u044b\u0442\u0430\u0435 \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u043f\u0440\u0430\u043f\u0430\u043b\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0456 \u0442\u044b \u045e\u0436\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0456\u043a\u043e\u043b\u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0443\u043f\u0446\u044b, \u044f\u043a\u0456\u044f \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0437 \u044f\u0433\u043e, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b \u0437 \u043f\u043b\u0430\u0447\u0430\u043c \u0456 \u0441\u043c\u0443\u0442\u043a\u0430\u043c: &laquo;\u0413\u043e\u0440\u0430, \u0433\u043e\u0440\u0430, \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0442\u043e\u043d\u043a\u0456 \u043b\u0451\u043d, \u043f\u0443\u0440\u043f\u0443\u0440\u0443 \u0456 \u043f\u0443\u043d\u0441\u043e\u0432\u044b\u044f \u0448\u0430\u0442\u044b, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u043c\u043d\u0435\u043c \u0456 \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u043c\u0456, \u0431\u043e \u045e \u0430\u0434\u043d\u0443 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0431\u044b\u043b\u043e \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430 \u0442\u0430\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u043e\u0436\u043d\u044b \u0441\u0442\u044b\u0440\u043d\u0430\u0432\u044b, \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u043b\u044b\u0432\u0435 \u043d\u0430 \u043a\u0430\u0440\u0430\u0431\u043b\u0456, \u0456 \u043a\u043e\u0436\u043d\u044b \u043c\u0430\u0440\u0430\u043a, \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0440\u0430\u0446\u0443\u0435 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0441\u0442\u0430\u043b\u0456 \u0437\u0434\u0430\u043b\u0451\u043a \u0456 \u043a\u0440\u044b\u0447\u0430\u043b\u0456, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0434\u044b\u043c \u043f\u0430\u0436\u0430\u0440\u0443 \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f\u043a\u0456 \u0433\u043e\u0440\u0430\u0434 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430?&raquo; \u0406 \u043a\u0456\u043d\u0443\u043b\u0456 \u043f\u044b\u043b \u043d\u0430 \u0433\u0430\u043b\u043e\u0432\u044b \u0441\u0432\u0430\u0435, \u0456 \u043a\u0440\u044b\u0447\u0430\u043b\u0456 \u045e \u043f\u043b\u0430\u0447\u044b \u0456 \u0441\u043c\u0443\u0442\u043a\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0413\u043e\u0440\u0430, \u0433\u043e\u0440\u0430, \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434, \u0437 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443 \u044f\u043a\u043e\u0433\u0430 \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u0435, \u0445\u0442\u043e \u043c\u0430\u0435 \u043a\u0430\u0440\u0430\u0431\u043b\u0456 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0431\u043e \u0437\u0430 \u0430\u0434\u043d\u0443 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0451\u043d \u0430\u043f\u0443\u0441\u0446\u0435\u045e! \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u043d\u0430\u0434 \u0456\u043c, \u043d\u0435\u0431\u0430 \u0456 \u0441\u0432\u044f\u0442\u044b\u044f, \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u0431\u043e \u041f\u0430\u043d \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u0434\u0430!&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 52, 11b. 12b; \u0415\u0440 51, 45 (\u043f\u0430\u0440. \u0410\u043f 18, 4)<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0437 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430, \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u0435\u0441\u044f \u0432\u044b, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u044f\u0446\u0435 \u043f\u043e\u0441\u0443\u0434 \u041f\u0430\u043d\u0430, \u0431\u043e \u041f\u0430\u043d \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456,<span style=\"color: #ff0000;\"> *<\/span> \u0456 \u0437\u0431\u044f\u0440\u044d \u0432\u0430\u0441 \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u0439\u0434\u0437\u0456 \u0437 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430, \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0442\u0443\u0435 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0430\u0434 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u0411\u043e\u0436\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437\u0431\u044f\u0440\u044d \u0432\u0430\u0441 \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5051","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">18, 21 &ndash; 19, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0432\u044f\u0441\u0435\u043b\u043b\u044f \u0411\u0430\u0440\u0430\u043d\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0430\u043d\u0451\u043b \u0443\u0437\u044f\u045e \u043a\u0430\u043c\u0435\u043d\u044c, \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0436\u043e\u0440\u043d\u0430\u045e, \u0456 \u045e\u043a\u0456\u043d\u0443\u045e \u0443 \u043c\u043e\u0440\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417 \u0442\u0430\u043a\u043e\u044e \u0441\u0456\u043b\u0430\u044e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0432\u0430\u043b\u0435\u043d\u044b \u0411\u0430\u0431\u0456\u043b\u0451\u043d, \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u044f\u0433\u043e. \u0406 \u0433\u043e\u043b\u0430\u0441\u0443 \u0433\u0443\u0441\u043b\u044f\u0440\u043e\u045e \u0456 \u043f\u0435\u0441\u043d\u044f\u0440\u043e\u045e, \u0456 \u0444\u043b\u0435\u0439\u0442\u044b\u0441\u0442\u0430\u045e, \u0456 \u0442\u0440\u0443\u0431\u0430\u0447\u043e\u045e \u0443 \u0442\u0430\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0442\u043d\u0430. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0436\u043e \u045e \u0442\u0430\u0431\u0435 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u043c\u0430\u0441\u0442\u0430\u043a\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043c\u0430\u0441\u0442\u0430\u0446\u0442\u0432\u0430, \u0456 \u0448\u0443\u043c\u0443 \u0430\u0434 \u0436\u043e\u0440\u043d\u0430\u045e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0436\u043e \u0447\u0443\u0442\u043d\u0430 \u045e \u0442\u0430\u0431\u0435. \u0406 \u0441\u0432\u044f\u0442\u043b\u043e \u043b\u044f\u043c\u043f\u044b \u045e\u0436\u043e \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0442\u0430\u0431\u0435. \u0406 \u0433\u043e\u043b\u0430\u0441\u0443 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0436\u043e \u0447\u0443\u0442\u043d\u0430 \u045e \u0442\u0430\u0431\u0435. \u0411\u043e \u043a\u0443\u043f\u0446\u044b \u0442\u0432\u0430\u0435 \u0431\u044b\u043b\u0456 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456, \u0431\u043e \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c \u0442\u0432\u0430\u0456\u043c \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b. \u0406 \u045e \u0446\u044f\u0431\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430\u0441\u044f \u043a\u0440\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0456 \u0441\u0432\u044f\u0442\u044b\u0445, \u0456 \u045e\u0441\u0456\u0445 \u0437\u0430\u0431\u0456\u0442\u044b\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f \u043f\u0430\u0447\u0443\u045e \u0443 \u043d\u0435\u0431\u0435 \u043c\u043e\u0446\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u044f\u043a \u0431\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0410\u043b\u043b\u0435\u043b\u044e\u044f! \u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u043b\u0430\u0432\u0430, \u0456 \u043c\u043e\u0446 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u0431\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u042f\u0433\u043e\u043d\u044b\u044f; \u0431\u043e \u0401\u043d \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u0446\u0443, \u044f\u043a\u0430\u044f \u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u0437\u044f\u043c\u043b\u044e \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0441\u043f\u0443\u0441\u0442\u0430\u0439, \u0456 \u0441\u043f\u0430\u0433\u043d\u0430\u045e \u043a\u0440\u043e\u045e \u0441\u043b\u0443\u0433\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0437 \u044f\u0435 \u0440\u0443\u043a\u0456!&raquo; \u0406 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0410\u043b\u043b\u0435\u043b\u044e\u044f! \u0406 \u0434\u044b\u043c \u044f\u0435 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f!&raquo; \u0406 \u045e\u043f\u0430\u043b\u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0447\u0430\u0442\u044b\u0440\u044b \u0441\u0442\u0430\u0440\u0446\u044b \u0456 \u0447\u0430\u0442\u044b\u0440\u044b \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b, \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u043c\u044d\u043d. \u0410\u043b\u043b\u0435\u043b\u044e\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434 \u0442\u0440\u043e\u043d\u0430 \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0443\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430, \u043c\u0430\u043b\u044b\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f!&raquo; \u0406 \u044f \u043f\u0430\u0447\u0443\u045e \u044f\u043a \u0431\u044b \u0448\u0443\u043c \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043d\u0430\u0442\u043e\u045e\u043f\u0443, \u044f\u043a \u0431\u044b \u0433\u0443\u043b \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0432\u043e\u0434\u0430\u045e, \u044f\u043a \u0431\u044b \u0433\u043e\u043b\u0430\u0441 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0433\u0440\u044b\u043c\u043e\u0442\u0430\u045e, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0410\u043b\u043b\u0435\u043b\u044e\u044f, \u0431\u043e \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u043d\u0430\u0448 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b. \u0411\u0443\u0434\u0437\u0435\u043c \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0456 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u044f\u0441\u0435\u043b\u043b\u0435 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0436\u043e\u043d\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u044f. \u0406 \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u0451\u0439 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b \u0447\u044b\u0441\u0442\u044b \u0442\u043e\u043d\u043a\u0456 \u043b\u0451\u043d, \u0431\u043e \u0442\u043e\u043d\u043a\u0456 \u043b\u0451\u043d &ndash; \u0433\u044d\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0441\u0432\u044f\u0442\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0430\u043d\u0451\u043b: &laquo;\u041d\u0430\u043f\u0456\u0448\u044b: \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u043d\u0430 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0443\u044e \u0432\u044f\u0447\u044d\u0440\u0443 \u0411\u0430\u0440\u0430\u043d\u043a\u0430!&raquo; \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0433\u0430&raquo;. \u042f \u045e\u043f\u0430\u045e \u0434\u0430 \u043d\u043e\u0433 \u044f\u0433\u043e\u043d\u044b\u0445, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u044f\u043c\u0443, \u0430\u043b\u0435 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u041d\u0435 \u0440\u0430\u0431\u0456 \u0433\u044d\u0442\u0430\u0433\u0430! \u042f \u0442\u0430\u043a\u0456 \u0436 \u0441\u043b\u0443\u0433\u0430, \u044f\u043a \u0442\u044b \u0456 \u0431\u0440\u0430\u0442\u044b \u0442\u0432\u0430\u0435, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430. \u0411\u043e\u0433\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0441\u044f, \u0431\u043e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 &ndash; \u0434\u0443\u0445 \u043f\u0440\u0430\u0440\u043e\u0447\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 14, 2; 19, 6; 12, 10; 19, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a \u0448\u0443\u043c \u0430\u0434 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u043e\u0434\u0430\u045e \u0456 \u044f\u043a \u0433\u0443\u043a \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0433\u0440\u043e\u043c\u0443: \u0417\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u043d\u0430\u0448 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0456 \u0441\u0456\u043b\u0430, \u0456 \u045e\u043b\u0430\u0434\u0430 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434 \u0442\u0440\u043e\u043d\u0430 \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: \u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0443\u0441\u0435 \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u0443\u0433\u0456 \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430, \u043c\u0430\u043b\u044b\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0456 \u0441\u0456\u043b\u0430, \u0456 \u045e\u043b\u0430\u0434\u0430 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5052","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">19, 11-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0435 \u043d\u0435\u0431\u0430: \u0456 \u0432\u043e\u0441\u044c, \u0431\u0435\u043b\u044b \u043a\u043e\u043d\u044c, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0456\u043c, \u0437\u0430\u0432\u0435\u0446\u0446\u0430 \u0412\u0435\u0440\u043d\u044b\u043c \u0456 \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c, \u0456 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0401\u043d \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0456 \u0432\u0430\u044e\u0435. \u0412\u043e\u0447\u044b \u0436 \u042f\u0433\u043e &mdash; \u044f\u043a \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e, \u0430 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u042f\u0433\u043e \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0434\u044b\u044f\u0434\u044d\u043c\u044b. \u0401\u043d \u043c\u0430\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0456\u043c\u044f, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0445\u0442\u043e, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u0433\u043e. \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u043f\u043b\u0430\u0448\u0447, \u0430\u0431\u043c\u044b\u0442\u044b \u045e \u043a\u0440\u044b\u0432\u0456, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e &mdash; \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430. \u0406 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0456 \u042f\u043c\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u043e\u0439\u0441\u043a\u0456 \u043d\u0430 \u0431\u0435\u043b\u044b\u0445 \u043a\u043e\u043d\u044f\u0445, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0447\u044b\u0441\u0442\u044b \u0431\u0435\u043b\u044b \u0442\u043e\u043d\u043a\u0456 \u043b\u0451\u043d. \u0406 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u043e\u0441\u0442\u0440\u044b \u043c\u0435\u0447, \u043a\u0430\u0431 \u0443\u0434\u0430\u0440\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b. \u0401\u043d \u0441\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u043c \u043a\u0456\u0435\u043c. \u0401\u043d \u0441\u0430\u043c \u0442\u043e\u043f\u0447\u0430 \u0434\u0430\u0432\u0456\u043b\u0430 \u0437 \u0432\u0456\u043d\u043e\u043c \u043b\u044e\u0442\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443 \u0411\u043e\u0433\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430. \u0410 \u043d\u0430 \u043f\u043b\u0430\u0448\u0447\u044b \u0456 \u043d\u0430 \u0441\u0446\u044f\u0433\u043d\u0435 \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u041a\u0430\u0440\u043e\u043b\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u0443 \u0441\u043e\u043d\u0446\u044b \u0456 \u0433\u0443\u0447\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u0441\u0456\u043c \u043f\u0442\u0443\u0448\u043a\u0430\u043c, \u044f\u043a\u0456\u044f \u043b\u0451\u0442\u0430\u044e\u0446\u044c \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0431\u0430: &laquo;\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u0437\u0431\u044f\u0440\u044b\u0446\u0435\u0441\u044f \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0432\u044f\u0447\u044d\u0440\u0443 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0437&rsquo;\u0435\u0441\u0446\u0456 \u0446\u0435\u043b\u044b \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0456 \u0446\u0435\u043b\u044b \u0442\u044b\u0441\u044f\u0447\u043d\u0456\u043a\u0430\u045e, \u0456 \u0446\u0435\u043b\u044b \u043c\u043e\u0446\u043d\u044b\u0445, \u0456 \u0446\u0435\u043b\u044b \u043a\u043e\u043d\u0435\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u043c\u0456 \u0456\u0445, \u0456 \u0446\u0435\u043b\u044b \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u0445 \u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u0456 \u043c\u0430\u043b\u044b\u0445, \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u0445&raquo;. \u0406 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0437\u0432\u0435\u0440\u0430, \u0456 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0437\u044f\u043c\u043b\u0456, \u0456 \u0456\u0445 \u0432\u043e\u0439\u0441\u043a\u0456, \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u044f, \u043a\u0430\u0431 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u0439\u043d\u0443 \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043a\u0430\u043d\u0456, \u0456 \u0437 \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c. \u0406 \u0431\u044b\u045e \u0441\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0437\u0432\u0435\u0440, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a\u0456 \u0447\u044b\u043d\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0437\u043d\u0430\u043a\u0456, \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u044f\u043a\u0456\u0445 \u0437\u0432\u043e\u0434\u0437\u0456\u045e \u0442\u044b\u0445, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043a\u043b\u044f\u0439\u043c\u043e \u0437\u0432\u0435\u0440\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u044f\u0433\u043e. \u0410\u0431\u043e\u0434\u0432\u0430 \u0431\u044b\u043b\u0456 \u0436\u044b\u045e\u0446\u043e\u043c \u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0435 \u0432\u043e\u0437\u0435\u0440\u0430 \u0437 \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0439 \u0441\u0435\u0440\u0430\u0439. \u0410\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u0436 \u0431\u044b\u043b\u0456 \u0437\u0430\u0431\u0456\u0442\u044b\u044f \u043c\u044f\u0447\u043e\u043c, \u044f\u043a\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u043a\u0430\u043d\u0456, \u0456 \u045e\u0441\u0435 \u043f\u0442\u0443\u0448\u043a\u0456 \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0456\u0441\u044f \u0456\u0445\u043d\u0456\u043c\u0456 \u0446\u0435\u043b\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 19, 13. 15\u0441. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u043f\u043b\u0430\u0448\u0447, \u0430\u043a\u0443\u043d\u0443\u0442\u044b \u045e \u043a\u0440\u044b\u0432\u0456, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e &ndash; \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0442\u043e\u043f\u0447\u0430 \u0434\u0430\u0432\u0456\u043b\u0430 \u0437 \u0432\u0456\u043d\u043e\u043c \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u0433\u043d\u0435\u0432\u0443 \u0411\u043e\u0433\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u043f\u043b\u0430\u0448\u0447\u044b \u0456 \u043d\u0430 \u0441\u0446\u044f\u0433\u043d\u0435 \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u041a\u0430\u0440\u043e\u043b\u044c \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0442\u043e\u043f\u0447\u0430 \u0434\u0430\u0432\u0456\u043b\u0430 \u0437 \u0432\u0456\u043d\u043e\u043c \u043b\u044e\u0442\u0430\u0441\u0446\u0456 \u0433\u043d\u0435\u0432\u0443 \u0411\u043e\u0433\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5053","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">20, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0448\u043d\u044f\u044f \u0431\u0456\u0442\u0432\u0430 \u0446\u043c\u043e\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u0430\u043d\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430 \u0456 \u043c\u0435\u045e \u043a\u043b\u044e\u0447 \u0430\u0434 \u0431\u0435\u0437\u0434\u0430\u043d\u0456 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u043b\u0430\u043d\u0446\u0443\u0433 \u0443 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u0446\u044d. \u0401\u043d \u0441\u0445\u0430\u043f\u0456\u045e \u0446\u043c\u043e\u043a\u0430, \u0437\u043c\u0435\u044f \u0441\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u044f\u0433\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0434&rsquo;\u044f\u0431\u043b\u0430\u043c \u0456 \u0441\u0430\u0442\u0430\u043d\u043e\u044e, \u0456 \u0437\u0432\u044f\u0437\u0430\u045e \u044f\u0433\u043e \u043d\u0430 \u0442\u044b\u0441\u044f\u0447\u0443 \u0433\u0430\u0434\u043e\u045e, \u0456 \u045e\u043a\u0456\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u0431\u0435\u0437\u0434\u0430\u043d\u044c, \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u0456 \u0430\u043f\u044f\u0447\u0430\u0442\u0430\u045e \u044f\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u045e \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0440\u043e\u0434\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u0442\u044b\u0441\u044f\u0447\u0430 \u0433\u0430\u0434\u043e\u045e. \u0410 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u044b \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u0442\u0440\u043e\u043d\u044b \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0456\u0445 \u0456 \u043a\u0430\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u0443\u0434\u0437\u0456\u0446\u044c, \u0456 \u0434\u0443\u0448\u044b \u0441\u0446\u044f\u0442\u044b\u0445 \u0437\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0456 \u0437\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. \u042f\u043d\u044b \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0437\u0432\u0435\u0440\u0443, \u043d\u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u044f\u0433\u043e\u043d\u0430\u043c\u0443, \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043a\u043b\u044f\u0439\u043c\u0430 \u043d\u0430 \u0447\u0430\u043b\u043e \u0441\u0432\u0430\u0451 \u0456 \u043d\u0430 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e. \u042f\u043d\u044b \u0430\u0436\u044b\u043b\u0456 \u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0442\u044b\u0441\u044f\u0447\u0443 \u0433\u0430\u0434\u043e\u045e. \u0410 \u0456\u043d\u0448\u044b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u043d\u0435 \u0430\u0436\u044b\u043b\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u0430\u0439\u0448\u043b\u043e \u0442\u044b\u0441\u044f\u0447\u0430 \u0433\u0430\u0434\u043e\u045e. \u0413\u044d\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0456 \u0441\u0432\u044f\u0442\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u043f\u0435\u0440\u0448\u044b\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0456! \u0414\u0440\u0443\u0433\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456 \u045e\u043b\u0430\u0434\u044b, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0437 \u0406\u043c \u0442\u044b\u0441\u044f\u0447\u0443 \u0433\u0430\u0434\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043c\u0456\u043d\u0435 \u0442\u044b\u0441\u044f\u0447\u0430 \u0433\u0430\u0434\u043e\u045e, \u0441\u0430\u0442\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043f\u0443\u0448\u0447\u0430\u043d\u044b \u0437 \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0456 \u0432\u044b\u0439\u0434\u0437\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u043d\u0430 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u043a\u0430\u043d\u0446\u0430\u0445 \u0437\u044f\u043c\u043b\u0456, \u0413\u043e\u0433\u0430 \u0456 \u041c\u0430\u0433\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0432\u0430\u0439\u043d\u0443, \u0430 \u043b\u0456\u043a \u0456\u0445 \u044f\u043a \u043c\u0430\u0440\u0441\u043a\u0456 \u043f\u044f\u0441\u043e\u043a. \u042f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u043d\u0430 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u0443 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0430\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u043b\u0430\u0433\u0435\u0440 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0433\u043e\u0440\u0430\u0434. \u0410\u0434\u043d\u0430\u043a \u0441\u044b\u0448\u043e\u045e \u0430\u0433\u043e\u043d\u044c \u0437 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u0456\u0445. \u0410 \u0434&rsquo;\u044f\u0431\u0430\u043b, \u044f\u043a\u0456 \u0437\u0432\u043e\u0434\u0437\u0456\u045e \u0456\u0445, \u0431\u044b\u045e \u043a\u0456\u043d\u0443\u0442\u044b \u045e \u0432\u043e\u0437\u0435\u0440\u0430 \u0430\u0433\u043d\u044e \u0456 \u0441\u0435\u0440\u044b, \u0434\u0437\u0435 \u0456 \u0437\u0432\u0435\u0440, \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u043a \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u0431\u0435\u043b\u044b \u0442\u0440\u043e\u043d \u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0456\u043c, \u0456 \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u044f\u043a\u043e\u0433\u0430 \u045e\u0446\u044f\u043a\u0430\u043b\u0456 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044f, \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0456\u043c \u043c\u0435\u0441\u0446\u0430. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043c\u0430\u043b\u044b\u0445 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u0445, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u044f\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c, \u0456 \u043a\u043d\u0456\u0433\u0456 \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0433\u043e\u0440\u043d\u0443\u0442\u044b\u044f. \u0406 \u0440\u0430\u0437\u0433\u0430\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0456\u043d\u0448\u0430\u044f \u043a\u043d\u0456\u0433\u0430 &ndash; \u043a\u043d\u0456\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0406 \u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u043c \u0443 \u043a\u043d\u0456\u0433\u0430\u0445, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445. \u0422\u0430\u0434\u044b \u0430\u0434\u0434\u0430\u043b\u043e \u043c\u043e\u0440\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0456\u043c, \u0456 \u0441\u043c\u0435\u0440\u0446\u044c, \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0430\u0434\u0434\u0430\u043b\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0456\u0445. \u0406 \u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u0410 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0431\u044b\u043b\u0456 \u045e\u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u0432\u043e\u0437\u0435\u0440\u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0435. \u0412\u043e\u0437\u0435\u0440\u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c. \u0406 \u043a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u0433\u0430 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u043c \u0443 \u043a\u043d\u0456\u0437\u0435 \u0436\u044b\u0446\u0446\u044f, \u0442\u043e\u0439 \u0431\u044b\u045e \u0443\u043a\u0456\u043d\u0443\u0442\u044b \u045e \u0432\u043e\u0437\u0435\u0440\u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 25. 26; \u043f\u0430\u0440. \u0410\u043f 20, 13\u0430. 14b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435 \u045e\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u0441\u0432\u0430\u0435. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043a \u0430\u043f\u043e\u0448\u043d\u0456 \u0432\u043e\u0440\u0430\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u0434\u044b \u043c\u043e\u0440\u0430 \u0456 \u043f\u0435\u043a\u043b\u0430 \u0430\u0434\u0434\u0430\u0434\u0443\u0446\u044c \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0441\u0432\u0430\u0456\u0445, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u043f\u0435\u043a\u043b\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u0432\u043e\u0437\u0435\u0440\u0430 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0430\u043f\u043e\u0448\u043d\u0456 \u0432\u043e\u0440\u0430\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5054","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">21, 1-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u043d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0411\u043e \u043f\u0435\u0440\u0448\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0435\u0440\u0448\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u043c\u0456\u043d\u0443\u043b\u0456, \u0456 \u043c\u043e\u0440\u0430 \u045e\u0436\u043e \u043d\u044f\u043c\u0430. \u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u044f \u0441\u0432\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434, \u043d\u043e\u0432\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0437 \u043d\u0435\u0431\u0430, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u044f\u0432\u0435\u0441\u0442\u0430, \u043f\u0440\u044b\u0431\u0440\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u0430\u043d\u0456\u0445\u0430. \u0406 \u043f\u0430\u0447\u0443\u045e \u044f \u0433\u0443\u0447\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0437 \u0442\u0440\u043e\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u043e\u0441\u044c \u0441\u043a\u0456\u043d\u0456\u044f \u0411\u043e\u0433\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0437 \u0456\u043c\u0456; \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0430 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 &ldquo;\u0411\u043e\u0433\u0430\u043c \u0437 \u0456\u043c\u0456&rdquo;. \u0406 \u0432\u044b\u0442\u0440\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043b\u044f\u0437\u0443 \u0437 \u0432\u0430\u0447\u044d\u0439 \u0456\u0445\u043d\u0456\u0445, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u0456 \u0441\u043c\u0443\u0442\u043a\u0443, \u043d\u0456 \u043f\u043b\u0430\u0447\u0443, \u043d\u0456 \u0431\u043e\u043b\u044e \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u0431\u043e \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u043c\u0456\u043d\u0443\u043b\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0442\u0440\u043e\u043d\u0435: &laquo;\u0412\u043e\u0441\u044c \u0447\u044b\u043d\u044e \u045e\u0441\u0451 \u043d\u043e\u0432\u0430\u0435&raquo;. \u0406 \u0434\u0430\u0434\u0430\u045e: &laquo;\u041d\u0430\u043f\u0456\u0448\u044b, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u044b \u0433\u044d\u0442\u044b\u044f \u0432\u0435\u0440\u043d\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f&raquo;. \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0421\u0442\u0430\u043b\u0430\u0441\u044f! \u042f &mdash; \u0410\u043b\u044c\u0444\u0430 \u0456 \u0410\u043c\u0435\u0433\u0430, \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u043a\u0430\u043d\u0435\u0446. \u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u042f \u0434\u0430\u043c \u0437\u0430\u0434\u0430\u0440\u043c\u0430 \u043f\u0456\u0446\u044c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u0430\u0434\u044b \u0436\u044b\u0446\u0446\u044f. \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u045e\u0441\u0451, \u0456 \u042f \u0431\u0443\u0434\u0443 \u044f\u043c\u0443 \u0411\u043e\u0433\u0430\u043c, \u0430 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0441\u044b\u043d\u0430\u043c. \u0410 \u043b\u0451\u0441 \u0431\u0430\u044f\u0437\u043b\u0456\u045e\u0446\u0430\u045e, \u0456 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0430\u0433\u0456\u0434\u0443, \u0456 \u0437\u0430\u0431\u043e\u0439\u0446\u0430\u045e, \u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u043a\u0430\u045e, \u0456 \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u044f\u045e, \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u043d\u0456\u043a\u0430\u045e \u0456 \u045e\u0441\u0456\u0445 \u043f\u0430\u0434\u043c\u0430\u043d\u0448\u0447\u044b\u043a\u0430\u045e &ndash; \u0432\u043e\u0437\u0435\u0440\u0430, \u0448\u0442\u043e \u043f\u0430\u043b\u0430\u0435 \u0430\u0433\u043d\u0451\u043c \u0456 \u0441\u0435\u0440\u0430\u0439. \u0413\u044d\u0442\u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 21, 3b. 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u043a\u0456\u043d\u0456\u044f \u0411\u043e\u0433\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0437 \u0456\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0411\u043e\u0433 \u0432\u044b\u0442\u0440\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043b\u044f\u0437\u0443 \u0437 \u0432\u0430\u0447\u044d\u0439 \u0456\u0445\u043d\u0456\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u0456 \u0441\u043c\u0443\u0442\u043a\u0443, \u043d\u0456 \u043f\u043b\u0430\u0447\u0443, \u043d\u0456 \u0431\u043e\u043b\u044e \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u0431\u043e \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u043c\u0456\u043d\u0443\u043b\u0430. \u041d. \u0406 \u0411\u043e\u0433 \u0432\u044b\u0442\u0440\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043b\u044f\u0437\u0443 \u0437 \u0432\u0430\u0447\u044d\u0439 \u0456\u0445\u043d\u0456\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5055","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">21, 9-27<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0430\u0447\u0430\u043d\u043d\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 &ndash; \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b \u0411\u0430\u0440\u0430\u043d\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0437 \u0441\u044f\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0441\u0435\u043c \u0447\u0430\u0448\u0430\u045e, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u0445 \u0441\u044f\u043c\u044e \u0430\u043f\u043e\u0448\u043d\u0456\u043c\u0456 \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0456, \u0456 \u0437\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0425\u0430\u0434\u0437\u0456, \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u0436\u043e\u043d\u043a\u0443 \u0411\u0430\u0440\u0430\u043d\u043a\u0430&raquo;. \u0406 \u045e\u0437\u043d\u0451\u0441 \u043c\u044f\u043d\u0435 \u045e \u0434\u0443\u0445\u0443 \u0430\u043d\u0451\u043b \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0443\u044e, \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0433\u0430\u0440\u0443 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0441\u0432\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u043c\u0435\u045e \u0411\u043e\u0436\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u0417\u0437\u044f\u043d\u043d\u0435 \u044f\u0433\u043e\u043d\u0430\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u044f\u0448\u043c\u0430, \u043a\u0430\u043c\u0435\u043d\u044f, \u0447\u044b\u0441\u0442\u0430\u0433\u0430, \u044f\u043a \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c. \u041c\u0435\u045e \u0451\u043d \u043c\u0443\u0440 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0432\u044b\u0441\u043e\u043a\u0456, \u043c\u0435\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0431\u0440\u0430\u043c\u0430\u045e, \u0430 \u043d\u0430 \u0431\u0440\u0430\u043c\u0430\u0445 &ndash; \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u0456\u043c\u0451\u043d\u044b \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0417 \u0443\u0441\u0445\u043e\u0434\u0443 \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b \u0456 \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b, \u0456 \u0437 \u043f\u043e\u045e\u0434\u043d\u044f \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b, \u0456 \u0437 \u0437\u0430\u0445\u0430\u0434\u0443 \u0442\u0440\u044b \u0431\u0440\u0430\u043c\u044b. \u041c\u0443\u0440 \u0433\u043e\u0440\u0430\u0434\u0430 \u043c\u0435\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0430\u045e, \u0430 \u043d\u0430 \u0456\u0445 &ndash; \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0456\u043c\u0451\u043d\u0430\u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u043e\u0439, \u0445\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u043c\u0435\u045e \u0437\u0430\u043b\u0430\u0442\u0443\u044e \u043c\u0435\u0440\u043d\u0443\u044e \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0443, \u043a\u0430\u0431 \u043f\u0430\u043c\u0435\u0440\u0430\u0446\u044c \u0433\u043e\u0440\u0430\u0434, \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0440\u0430\u043c\u044b \u0456 \u043c\u0443\u0440. \u0413\u043e\u0440\u0430\u0434 \u0431\u044b\u045e \u0447\u0430\u0442\u044b\u0440\u043e\u0445\u0432\u0443\u0433\u043e\u043b\u044c\u043d\u044b, \u0430 \u0434\u0430\u045e\u0436\u044b\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u044f \u0431\u044b\u043b\u0430 \u0440\u043e\u045e\u043d\u0430\u044f \u0448\u044b\u0440\u044b\u043d\u0456. \u0406 \u0451\u043d \u043f\u0430\u043c\u0435\u0440\u0430\u045e \u0433\u043e\u0440\u0430\u0434 \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0430\u044e, \u0431\u044b\u043b\u043e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0441\u0442\u0430\u0434\u044b\u044f\u045e. \u042f\u0433\u043e \u0434\u0430\u045e\u0436\u044b\u043d\u044f, \u0448\u044b\u0440\u044b\u043d\u044f \u0456 \u0432\u044b\u0448\u044b\u043d\u044f \u0440\u043e\u045e\u043d\u044b\u044f. \u0406 \u043f\u0430\u043c\u0435\u0440\u0430\u045e \u044f\u0433\u043e\u043d\u044b \u043c\u0443\u0440, \u0451\u043d \u0431\u044b\u045e \u0441\u0442\u043e \u0441\u043e\u0440\u0430\u043a \u0447\u0430\u0442\u044b\u0440\u044b \u043b\u043e\u043a\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043c\u0435\u0440\u044b, \u044f\u043a\u043e\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e\u0441\u044f \u0430\u043d\u0451\u043b. \u041c\u0443\u0440 \u0431\u044b\u045e \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0437 \u044f\u0448\u043c\u044b, \u0430 \u0433\u043e\u0440\u0430\u0434 &ndash; \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u0434\u0430 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0448\u043a\u043b\u0430. \u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u044b \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0456\u0445 \u043c\u0443\u0440\u043e\u045e \u0431\u044b\u043b\u0456 \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c: \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u0431\u044b\u045e \u0437 \u044f\u0448\u043c\u044b, \u0434\u0440\u0443\u0433\u0456 &ndash; \u0437 \u0441\u0430\u043f\u0444\u0456\u0440\u0443, \u0442\u0440\u044d\u0446\u0456 &ndash; \u0437 \u0445\u0430\u043b\u0446\u044d\u0434\u043e\u043d\u0443, \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b &ndash; \u0441\u0430 \u0441\u043c\u0430\u0440\u0430\u0433\u0434\u0443, \u043f\u044f\u0442\u044b &ndash; \u0437 \u0441\u0430\u0440\u0434\u0430\u043d\u0456\u043a\u0441\u0443, \u0448\u043e\u0441\u0442\u044b &ndash; \u0437 \u0441\u0435\u0440\u0434\u0430\u043b\u0456\u043a\u0443, \u0441\u0451\u043c\u044b &ndash; \u0437 \u0445\u0440\u044b\u0437\u0430\u043b\u0456\u0442\u0443, \u0432\u043e\u0441\u044c\u043c\u044b &ndash; \u0437 \u0431\u044d\u0440\u044b\u043b\u0443, \u0434\u0437\u0435\u0432\u044f\u0442\u044b &ndash; \u0437 \u0442\u0430\u043f\u0430\u0437\u0443, \u0434\u0437\u0435\u0441\u044f\u0442\u044b &ndash; \u0437 \u0445\u0440\u044b\u0437\u0430\u043f\u0440\u0430\u0441\u0443, \u0430\u0434\u0437\u0456\u043d\u0430\u0446\u0446\u0430\u0442\u044b &ndash; \u0437 \u0433\u0456\u044f\u0446\u044b\u043d\u0442\u0443, \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u044b &ndash; \u0437 \u0430\u043c\u0435\u0442\u044b\u0441\u0442\u0443. \u0410 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0431\u0440\u0430\u043c\u0430\u045e \u0431\u044b\u043b\u0456 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0446\u044e \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u043c\u0456, \u043a\u043e\u0436\u043d\u0430\u044f \u0431\u0440\u0430\u043c\u0430 \u0431\u044b\u043b\u0430 \u0437 \u0430\u0441\u043e\u0431\u043d\u0430\u0439 \u043f\u044f\u0440\u043b\u0456\u043d\u044b. \u0410 \u043f\u043b\u043e\u0448\u0447\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a \u043f\u0440\u0430\u0437\u0440\u044b\u0441\u0442\u0430\u0435 \u0448\u043a\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e \u0456\u043c \u044f \u043d\u0435 \u0431\u0430\u0447\u044b\u045e, \u0431\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u0411\u0430\u0440\u0430\u043d\u0430\u043a. \u0406 \u0433\u043e\u0440\u0430\u0434\u0443 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u043d\u0456 \u0441\u043e\u043d\u0446\u0430, \u043d\u0456 \u043c\u0435\u0441\u044f\u0446, \u043a\u0430\u0431 \u044f\u043c\u0443 \u0441\u0432\u044f\u0446\u0456\u043b\u0456, \u0431\u043e \u0441\u043b\u0430\u0432\u0430 \u0411\u043e\u0436\u0430\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u043b\u0430 \u044f\u0433\u043e, \u0430 \u0441\u0432\u0435\u0442\u0430\u0447 \u044f\u0433\u043e\u043d\u044b &ndash; \u0411\u0430\u0440\u0430\u043d\u0430\u043a. \u0406 \u045e \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u044f\u043c\u0443 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443. \u0406 \u0431\u0440\u0430\u043c\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043d\u044c, \u0430 \u043d\u043e\u0447\u044b \u0442\u0430\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435. \u0406 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u0442\u0443\u0434\u044b \u0441\u043b\u0430\u0432\u0443 \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0406 \u043d\u0456\u0448\u0442\u043e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u0442\u0443\u0434\u044b, \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0430\u0433\u0456\u0434\u0443 \u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u043a\u043d\u0456\u0437\u0435 \u0436\u044b\u0446\u0446\u044f \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 21, 21; \u0422\u043e\u0431 13, 17. 18. 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0432\u0430\u0435 \u0432\u0443\u043b\u0456\u0446\u044b, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0447\u044b\u0441\u0442\u044b\u043c, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0443 \u0442\u0430\u0431\u0435 \u0440\u0430\u0434\u0430\u0441\u043d\u0443\u044e \u043f\u0435\u0441\u043d\u044e. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430 \u045e\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u0437\u0430\u0432\u0443\u043b\u043a\u0430\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c: \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u0430\u0437\u0437\u044f\u0435\u0448 \u044f\u0440\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u045e\u0441\u0435 \u043a\u0430\u043d\u0446\u044b \u0437\u044f\u043c\u043b\u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430 \u045e\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u0437\u0430\u0432\u0443\u043b\u043a\u0430\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c: \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5056","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">22, 1-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0442\u043e\u043a \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0440\u0430\u043a\u0443 \u0432\u0430\u0434\u044b \u0436\u044b\u0446\u0446\u044f, \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0443\u044e, \u044f\u043a \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c, \u044f\u043a\u0430\u044f \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u043b\u0430 \u0430\u0434 \u0442\u0440\u043e\u043d\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430. \u041f\u0430\u0441\u044f\u0440\u043e\u0434 \u043f\u043b\u043e\u0448\u0447\u044b \u0433\u043e\u0440\u0430\u0434\u0430 \u0456 \u0440\u0430\u043a\u0456, \u043f\u0430 \u0442\u043e\u0439 \u0431\u043e\u043a \u0456 \u043f\u0430 \u0433\u044d\u0442\u044b, &ndash; \u0434\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043f\u043b\u0430\u0434\u0430\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0440\u0430\u0437\u043e\u045e. \u041a\u043e\u0436\u043d\u044b \u043c\u0435\u0441\u044f\u0446 \u0434\u0430\u0435 \u043f\u043b\u043e\u0434 \u0441\u0432\u043e\u0439, \u0430 \u043b\u0456\u0441\u0446\u0435 \u0434\u0440\u044d\u0432\u0430 &ndash; \u0434\u043b\u044f \u043b\u044f\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0406 \u043d\u0456\u0447\u043e\u0433\u0430 \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u0430\u0433\u0430 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435. \u0410 \u0442\u0440\u043e\u043d \u0411\u043e\u0433\u0430 \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c, \u0456 \u0441\u043b\u0443\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443. \u0406 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u042f\u0433\u043e\u043d\u0430\u0435, \u0456 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0456\u0445 \u0447\u043e\u043b\u0430\u0445. \u0406 \u043d\u043e\u0447\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043d\u0456 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u043b\u044f\u043c\u043f\u044b, \u043d\u0456 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u0441\u043e\u043d\u0446\u0430, \u0431\u043e \u041f\u0430\u043d \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u044f\u0446\u0456\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456; \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u044d\u045e\u043d\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f, \u0456 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0434\u0443\u0445\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u0445, \u043f\u0430\u0441\u043b\u0430\u045e \u0430\u043d\u0451\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435. \u0406 \u0432\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0434\u0443 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u042f\u043d, \u0447\u0443\u045e \u0456 \u0431\u0430\u0447\u044b\u045e \u0433\u044d\u0442\u0430. \u0410 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e \u044f\u043a \u043f\u0430\u0447\u0443\u045e \u0456 \u045e\u0431\u0430\u0447\u044b\u045e, \u0443\u043f\u0430\u045e \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u043d\u043e\u0433\u0456 \u0430\u043d\u0451\u043b\u0443, \u044f\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043c\u043d\u0435 \u0433\u044d\u0442\u0430. \u0406 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: &laquo;\u041d\u0435 \u0440\u0430\u0431\u0456 \u0442\u0430\u043a. \u042f \u0441\u043b\u0443\u0433\u0430 \u044f\u043a \u0456 \u0442\u044b, \u0456 \u0442\u0432\u0430\u0435 \u0431\u0440\u0430\u0442\u044b &ndash; \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0456; \u0411\u043e\u0433\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0441\u044f!&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 22, 5. 3b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u043e\u0447\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u0431\u043e \u041f\u0430\u043d \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410 \u0442\u0440\u043e\u043d \u0411\u043e\u0433\u0430 \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0456 \u0441\u043b\u0443\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5057","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">22, 10-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0430\u0446\u0432\u0435\u0440\u0434\u0436\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435, \u042f\u043d\u0443: &laquo;\u041d\u0435 \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0432\u0430\u0439 \u0441\u043b\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0456, \u0431\u043e \u0447\u0430\u0441 \u0431\u043b\u0456\u0437\u043a\u0456! \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u044f\u0448\u0447\u044d \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u044b \u043d\u044f\u0445\u0430\u0439 \u044f\u0448\u0447\u044d \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0432\u0430\u0435\u0446\u0446\u0430, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043d\u044f\u0445\u0430\u0439 \u0434\u0430\u043b\u0435\u0439 \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0456 \u0441\u0432\u044f\u0442\u044b \u043d\u044f\u0445\u0430\u0439 \u044f\u0448\u0447\u044d \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0434\u0443 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u0456 \u0430\u0434\u043f\u043b\u0430\u0442\u0430 \u041c\u0430\u044f \u0441\u0430 \u041c\u043d\u043e\u044e, \u043a\u0430\u0431 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u042f &ndash; \u0410\u043b\u044c\u0444\u0430 \u0456 \u0410\u043c\u0435\u0433\u0430, \u043f\u0435\u0440\u0448\u044b \u0456 \u0430\u043f\u043e\u0448\u043d\u0456, \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u043a\u0430\u043d\u0435\u0446. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u044b\u0435 \u0448\u0430\u0442\u044b \u0441\u0432\u0430\u0435, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0434\u0440\u044d\u0432\u0430\u043c \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0440\u0430\u0437 \u0431\u0440\u0430\u043c\u0443 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0433\u043e\u0440\u0430\u0434. \u0417\u0432\u043e\u043d\u043a\u0443 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u0441\u0430\u0431\u0430\u043a\u0456, \u0456 \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u0456, \u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u043a\u0456, \u0456 \u0437\u0430\u0431\u043e\u0439\u0446\u044b, \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u043d\u0456\u043a\u0456 \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u0456 \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0430\u0434\u043c\u0430\u043d!<\/p>\r\n<p style=\"text-align: justify;\">\u042f, \u0415\u0437\u0443\u0441, \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u0430\u0439\u0433\u043e \u0430\u043d\u0451\u043b\u0430 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0432\u0430\u043c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u0445. \u042f &ndash; \u043a\u043e\u0440\u0430\u043d\u044c \u0456 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u0441\u043d\u0430\u044f \u0440\u0430\u043d\u0456\u0448\u043d\u044f\u044f \u0437\u043e\u0440\u043a\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0414\u0443\u0445 \u0456 \u043d\u044f\u0432\u0435\u0441\u0442\u0430 \u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456!&raquo; \u0406 \u0445\u0442\u043e \u0447\u0443\u0435, \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456!&raquo; \u0406 \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430, \u043d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u0432\u0430\u0434\u0443 \u0436\u044b\u0446\u0446\u044f \u0434\u0430\u0440\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u0432\u0435\u0434\u0447\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0456. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0434\u0430\u0434\u0430\u0441\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435\u0448\u0442\u0430, \u0411\u043e\u0433 \u0441\u043f\u0430\u0448\u043b\u0435 \u043d\u0430 \u044f\u0433\u043e \u0431\u0435\u0434\u0441\u0442\u0432\u044b, \u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0437\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0432\u044b\u043a\u0456\u043d\u0435 \u043d\u0435\u0448\u0442\u0430 \u0441\u0430 \u0441\u043b\u043e\u045e \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u0411\u043e\u0433 \u0430\u0434\u043a\u0456\u043d\u0435 \u044f\u0433\u043e \u0430\u0434 \u0434\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0432\u044b\u043a\u0456\u043d\u0435 \u0441\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430, \u0430\u043f\u0456\u0441\u0430\u043d\u044b\u0445 \u0443 \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u043a\u0430\u0436\u0430: &laquo;\u0422\u0430\u043a, \u0445\u0443\u0442\u043a\u0430 \u043f\u0440\u044b\u0439\u0434\u0443&raquo;. &laquo;\u0410\u043c\u044d\u043d. \u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u041f\u0430\u043d\u0435 \u0415\u0437\u0443!&raquo; \u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0443\u0441\u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 22, 16b. 17ab. 20c; \u0406\u0441 55, 1a. 3a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u043a\u043e\u0440\u0430\u043d\u044c \u0456 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u0441\u043d\u0430\u044f \u0440\u0430\u043d\u0456\u0448\u043d\u044f\u044f \u0437\u043e\u0440\u043a\u0430. \u0410 \u0414\u0443\u0445 \u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u043a\u0430\u0436\u0443\u0446\u044c: \u041f\u0440\u044b\u0439\u0434\u0437\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0445\u0442\u043e \u0447\u0443\u0435, \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430: \u041f\u0440\u044b\u0439\u0434\u0437\u0456. \u0410\u043c\u044d\u043d. \u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0430\u0441\u043c\u0430\u0433\u043b\u044b\u044f, \u0443\u0441\u0435 \u0456\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0432\u043e\u0434\u0430\u045e; \u0441\u0445\u0456\u043b\u0456\u0446\u0435 \u0432\u0443\u0445\u0430 \u0441\u0432\u0430\u0451 \u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0445\u0442\u043e \u0447\u0443\u0435, \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430: \u041f\u0440\u044b\u0439\u0434\u0437\u0456. \u0410\u043c\u044d\u043d. \u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5061","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">1, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0411\u043e\u0436\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e <\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0448\u0442\u043e \u043c\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u043d\u0430 \u0448\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0456 \u0434\u0430 \u0447\u0430\u0433\u043e \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456, &ndash; \u0431\u043e \u0436\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c, &ndash; \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456 \u0447\u0443\u043b\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0456 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0456 \u0432\u044b \u043c\u0435\u043b\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u043d\u0430\u043c\u0456. \u0410 \u043d\u0430\u0448\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0451\u0441\u0446\u044c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c, \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0413\u044d\u0442\u0430 \u043f\u0456\u0448\u0430\u043c \u043c\u044b, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439. \u041d\u0430\u0432\u0456\u043d\u0443, \u044f\u043a\u0443\u044e \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0421\u0432\u044f\u0442\u043b\u043e \u0456 \u043d\u044f\u043c\u0430 \u045e \u0406\u043c \u043d\u0456\u044f\u043a\u0430\u0439 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043c\u0430\u0435\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0406\u043c, \u0430 \u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0442\u043e \u043c\u044b \u0445\u043b\u0443\u0441\u0456\u043c \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043d\u0435 \u043f\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a \u0401\u043d \u0451\u0441\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u0442\u043e \u043c\u0430\u0435\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e, \u0456 \u043a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430, \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443, \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0456 \u043d\u044f\u043c\u0430 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u045e\u0434\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0401\u043d, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456 \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456, \u0442\u043e \u0440\u043e\u0431\u0456\u043c \u042f\u0433\u043e \u0456\u043b\u0433\u0443\u043d\u043e\u043c, \u0456 \u043d\u044f\u043c\u0430 \u045e \u043d\u0430\u0441 \u0441\u043b\u043e\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 1, 2; 5, 20\u0430.\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451,<span style=\"color: #ff0000;\"> *<\/span> \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e. \u0401\u043d &ndash; \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5062","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">2, 1-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u0433\u044d\u0442\u0430 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0442\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430. \u0401\u043d \u0451\u0441\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430 \u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0425\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e \u042f\u0433\u043e&raquo;, \u0430 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e\u043d\u044b\u044f, \u0442\u043e\u0439 \u0456\u043b\u0433\u0443\u043d \u0456 \u043d\u044f\u043c\u0430 \u045e \u0456\u043c \u043f\u0440\u0430\u045e\u0434\u044b. \u0410 \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0435, \u0443 \u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f; \u043f\u0430 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u045e \u0406\u043c. \u0425\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043f\u0456\u0448\u0443 \u0432\u0430\u043c \u043d\u0435 \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c, \u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u045e\u043d\u044e\u044e, \u044f\u043a\u0443\u044e \u0432\u044b \u043c\u0435\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0414\u0430\u045e\u043d\u044f\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0434\u0437\u044e \u0451\u0441\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0432\u044b \u0447\u0443\u043b\u0456. \u0410\u0434\u043d\u0430\u043a \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u045e \u0406\u043c \u0456 \u045e \u0432\u0430\u0441, \u0431\u043e \u0446\u0435\u043c\u0440\u0430 \u0437\u043d\u0456\u043a\u0430\u0435 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u045e\u0436\u043e \u044f\u0441\u043d\u0435\u0435. \u0425\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0451\u043d \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u0430 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u044f\u0448\u0447\u044d \u045e \u0446\u0435\u043c\u0440\u044b. \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u0456 \u043d\u044f\u043c\u0430 \u045e \u0456\u043c \u0441\u043f\u0430\u043a\u0443\u0441\u044b. \u0410 \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0446\u0435\u043c\u0440\u044b \u0456 \u045e \u0446\u0435\u043c\u0440\u044b \u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u043a\u0443\u0434\u044b \u0456\u0434\u0437\u0435, \u0431\u043e \u0446\u0435\u043c\u0440\u0430 \u0437\u0430\u0441\u043b\u044f\u043f\u0456\u043b\u0430 \u044f\u043c\u0443 \u0432\u043e\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 13, 34; 1 \u042f\u043d 2, 10\u0430. 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430 \u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5063","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">2, 12-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0456\u0448\u0443 \u0432\u0430\u043c, \u0434\u0437\u0435\u0446\u0456, \u0431\u043e \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u044b \u0432\u0430\u043c \u0433\u0440\u0430\u0445\u0456 \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430. \u041f\u0456\u0448\u0443 \u0432\u0430\u043c, \u0430\u0439\u0446\u044b, \u0431\u043e \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u041f\u0456\u0448\u0443 \u0432\u0430\u043c, \u044e\u043d\u0430\u043a\u0456, \u0431\u043e \u0432\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u0437\u043b\u043e\u0433\u0430. \u041f\u0456\u0448\u0443 \u0432\u0430\u043c, \u0434\u0437\u0435\u0446\u0456, \u0431\u043e \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0410\u0439\u0446\u0430. \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u0430\u0439\u0446\u044b, \u0431\u043e \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u044e\u043d\u0430\u043a\u0456, \u0431\u043e \u0432\u044b \u043c\u043e\u0446\u043d\u044b\u044f, \u0456 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441, \u0456 \u0432\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u0437\u043b\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043b\u044e\u0431\u0456\u0446\u0435 \u0441\u0432\u0435\u0442\u0443, \u043d\u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0441\u0432\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0443 \u0442\u044b\u043c \u043d\u044f\u043c\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0410\u0439\u0446\u0430. \u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0441\u0432\u0435\u0446\u0435: \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430, \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u0430\u0447\u044d\u0439 \u0456 \u0436\u044b\u0446\u0446\u0451\u0432\u0430\u044f \u043f\u044b\u0445\u0430 &ndash; \u043d\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0406 \u0441\u0432\u0435\u0442 \u043c\u0456\u043d\u0430\u0435, \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u044f, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u0432\u0435\u0447\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 2, 17. 15b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u0435\u0442 \u043c\u0456\u043d\u0430\u0435, \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e, \u0436\u044b\u0432\u0435 \u0432\u0435\u0447\u043d\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0443 \u0442\u044b\u043c \u043d\u044f\u043c\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0410\u0439\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e, \u0436\u044b\u0432\u0435 \u0432\u0435\u0447\u043d\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5064","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">2, 18-29<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0440\u0430 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456, \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430, \u0456 \u044f\u043a \u0432\u044b \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442, \u0442\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0448\u043c\u0430\u0442 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442\u0430\u045e. \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u0451\u043c, \u0448\u0442\u043e \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430. \u042f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0430\u0434 \u043d\u0430\u0441, \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u0434\u0430 \u043d\u0430\u0441. \u0411\u043e \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u0434\u0430 \u043d\u0430\u0441, \u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0431 \u0437 \u043d\u0430\u043c\u0456. \u0410\u043b\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u043d\u0430\u0441. \u0412\u044b \u0436 \u043c\u0430\u0435\u0446\u0435 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u045e\u0441\u0451 \u0432\u0435\u0434\u0430\u0435\u0446\u0435. \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u044f\u0435, \u044f\u043a \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0444\u0430\u043b\u044c\u0448 \u043d\u0435 \u0430\u0434 \u043f\u0440\u0430\u045e\u0434\u044b. \u0425\u0442\u043e \u0456\u043b\u0433\u0443\u043d, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u041c\u0435\u0441\u0456\u044f? \u0422\u043e\u0439 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442, \u0445\u0442\u043e \u0430\u0434\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0430\u0434\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0421\u044b\u043d\u0430, \u043d\u0435 \u043c\u0430\u0435 \u0456 \u0410\u0439\u0446\u0430, \u0430 \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u0421\u044b\u043d\u0430, \u043c\u0430\u0435 \u0456 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0447\u0443\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441. \u041a\u0430\u043b\u0456 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0447\u0443\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0434\u044b\u043a \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0436\u044b\u0446\u044c \u0443 \u0421\u044b\u043d\u0435 \u0456 \u0410\u0439\u0446\u0443. \u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0436, \u044f\u043a\u043e\u0435 \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c, \u0433\u044d\u0442\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043f\u0456\u0441\u0430\u045e \u044f \u0433\u044d\u0442\u0430 \u0432\u0430\u043c \u043f\u0440\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441. \u0410 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e, \u0443 \u0432\u0430\u0441 \u0436\u044b\u0432\u0435, \u0456 \u0432\u044b \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0435, \u043a\u0430\u0431 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u0443\u0447\u044b\u045e \u0432\u0430\u0441. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c\u043e \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043c\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0456 \u043d\u0435\u0456\u043b\u0436\u044b\u0432\u044b\u043c, \u0442\u043e \u045e \u0442\u044b\u043c, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0430 \u0432\u0430\u0441, \u0436\u044b\u0432\u0456\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440, \u0434\u0437\u0435\u0446\u0456, \u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0406\u043c, \u043a\u0430\u0431, \u043a\u0430\u043b\u0456 \u0401\u043d \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u043c\u0435\u043b\u0456 \u0430\u0434\u0432\u0430\u0433\u0443 \u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0443 \u0447\u0430\u0441 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f. \u041a\u0430\u043b\u0456 \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0442\u043e \u0432\u0435\u0434\u0430\u0439\u0446\u0435 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u042f\u043d 2, 27; \u0401\u044d\u043b 2, 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456, \u0443 \u0432\u0430\u0441 \u0436\u044b\u0432\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0432\u0430\u043c \u043d\u0435 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u0443\u0447\u044b\u045e \u0432\u0430\u0441, \u0430\u043b\u0435 \u0441\u0430\u043c\u043e \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043c\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u0456 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0443, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u0432\u0430\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u0430\u043c \u043d\u0435 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u0443\u0447\u044b\u045e \u0432\u0430\u0441, \u0430\u043b\u0435 \u0441\u0430\u043c\u043e \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043c\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5065","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e <span style=\"color: #ff0000;\">4, 1-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0423\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0437 \u0443\u0441\u0451\u044e \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0437 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u0410\u0434\u0437\u0456\u043d \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0456\u0445, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0423\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u043f\u0430\u043b\u0430\u043d\u0456\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445 \u0456 \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b&raquo;. \u0410 \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u045e\u0437\u044b\u0448\u043e\u045e\u0448\u044b&raquo;, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0439\u043d\u0456\u0436\u044d\u0439\u0448\u044b\u0445 \u0447\u0430\u0441\u0442\u0430\u043a \u0437\u044f\u043c\u043b\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u044b\u0448\u043e\u045e, \u0451\u0441\u0446\u044c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u0437\u044b\u0448\u043e\u045e \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u0435 \u043d\u044f\u0431\u0451\u0441\u044b, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0451. \u0401\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0430\u0434\u043d\u044b\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0434\u0440\u0443\u0433\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430 \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0445\u0456\u0441\u0442\u0430\u0435 \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0446\u0435\u0440 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c \u043b\u044e\u0434\u0441\u043a\u0456\u043c, \u0445\u0456\u0442\u0440\u044b\u043c \u0448\u0442\u0443\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0435\u0441\u0446\u0456 \u045e \u0437\u043c\u0430\u043d. \u0410\u043b\u0435, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0443\u0441\u0451 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, &ndash; \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0417 \u042f\u0433\u043e \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0456 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0440\u043e\u0437\u043d\u044b\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u044f \u0441\u0443\u0432\u044f\u0437\u0456, \u0443 \u043c\u0435\u0440\u0443 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u043d\u0430\u0439 \u0447\u0430\u0441\u0442\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0446\u0435\u043b\u0430 \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0456 \u0441\u0432\u0435\u0434\u0447\u0443 \u045e \u041f\u0430\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u044b\u043b\u0456, \u044f\u043a \u0436\u044b\u0432\u0443\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u0437 \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u043c \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u0456\u0445, \u043f\u0440\u0430\u0437 \u0443\u043f\u0430\u0440\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430\u045e \u0456\u0445\u043d\u0456\u0445. \u042f\u043d\u044b, \u0441\u0442\u0430\u045e\u0448\u044b \u043d\u044f\u0447\u0443\u043b\u044b\u043c\u0456, \u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435, \u0440\u043e\u0431\u044f\u0447\u044b \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0433\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u042f\u0433\u043e \u0456 \u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u045e \u0406\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0415\u0437\u0443\u0441\u0435, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0448\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0437\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u043c\u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u043c\u0456; \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0434\u0443\u0445 \u0432\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0433\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 4, 8 (\u041f\u0441 68 (67), 19); 47 (46), 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u0430\u043d\u0456\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445<span style=\"color: #ff0000;\"> *<\/span> \u0456 \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u043a\u043b\u0456\u0447\u044b, \u041f\u0430\u043d &ndash; \u043f\u0440\u044b \u0433\u0443\u043a\u0430\u0445 \u0442\u0440\u0443\u0431\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5066","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">3, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041c\u044b &ndash; \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u045e \u043d\u0430\u043c \u0410\u0439\u0446\u0435\u0446, \u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0456 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0456\u043c\u0456! \u0422\u0430\u043c\u0443 \u0441\u0432\u0435\u0442 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0441, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u042f\u0433\u043e. \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043c\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u042f\u0433\u043e, \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c, \u044f\u043a \u0401\u043d \u0451\u0441\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u0447\u044b\u043d\u0456\u0446\u044c \u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0431\u043e \u0433\u0440\u044d\u0445 &ndash; \u0433\u044d\u0442\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435. \u0412\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0456, \u0443 \u0406\u043c \u0436\u0430 \u043d\u044f\u043c\u0430 \u0433\u0440\u0430\u0445\u0443. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0430 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u042f\u0433\u043e \u0456 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441. \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u044f\u043a \u0456 \u0401\u043d \u0451\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c. \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445 &mdash; \u0442\u043e\u0439 \u0430\u0434 \u0434&rsquo;\u044f\u0431\u043b\u0430, \u0431\u043e \u0434&rsquo;\u044f\u0431\u0430\u043b \u0433\u0440\u0430\u0448\u044b\u0446\u044c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0414\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u0430\u0445\u0443, \u0431\u043e \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0435 \u0436\u044b\u0432\u0435 \u045e \u0456\u043c, \u0456 \u0451\u043d \u043d\u0435 \u043c\u043e\u0436\u0430 \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0431\u043e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445 \u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u0434&rsquo;\u044f\u0431\u043b\u0430: \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e\u0439 \u043d\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430, \u044f\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 3, 1. 2b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u045e \u043d\u0430\u043c \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0456 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0456\u043c\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0456 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0456\u043c\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5067","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">3, 11-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0422\u0430\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f, \u044f\u043a\u0443\u044e \u0432\u044b \u0447\u0443\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043a\u0430\u0431 \u043c\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. \u041d\u0435 \u0442\u0430\u043a, \u044f\u043a \u041a\u0430\u0456\u043d, \u044f\u043a\u0456 \u0431\u044b\u045e \u0430\u0434 \u0437\u043b\u043e\u0433\u0430 \u0456 \u0437\u0430\u0431\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430. \u0410 \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u0437\u0430\u0431\u0456\u045e \u044f\u0433\u043e? \u0411\u043e \u045e\u0447\u044b\u043d\u043a\u0456 \u044f\u0433\u043e \u0431\u044b\u043b\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u044f, \u0430 \u0431\u0440\u0430\u0442\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 &ndash; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0439\u0446\u0435\u0441\u044f, \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0442 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441. \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u043c \u0431\u0440\u0430\u0442\u043e\u045e. \u0425\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043c\u0435\u0440\u0446\u0456. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u0430, \u0430 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u0430 \u043d\u0435 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043c\u044b \u043b\u044e\u0431\u043e\u045e, \u0448\u0442\u043e \u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u0430\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u0430\u043a \u0443 \u0441\u0432\u0435\u0446\u0435 \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0442\u043e \u044f\u043a \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0436\u0430 \u0436\u044b\u0446\u044c \u0443 \u0456\u043c?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 3, 16. 14\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0443\u044e, \u0448\u0442\u043e \u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u043c \u0431\u0440\u0430\u0442\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5071","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">3, 18-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0417\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u043c\u043e\u0432\u0430\u044e, \u0430\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u043c \u0456 \u043f\u0440\u0430\u045e\u0434\u0430\u044e. \u0406 \u043f\u0430 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u0430\u0434 \u043f\u0440\u0430\u045e\u0434\u044b, \u0456 \u0441\u0443\u043f\u0430\u043a\u043e\u0456\u043c \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b. \u0411\u043e \u043a\u0430\u043b\u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0435 \u043d\u0430\u0441, \u0442\u043e \u0411\u043e\u0433 \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0456 \u0432\u0435\u0434\u0430\u0435 \u045e\u0441\u0451. \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043a\u0430\u043b\u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0435 \u043d\u0430\u0441, \u0442\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0443 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u0410\u0431 \u0447\u044b\u043c \u043d\u0456 \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u043c, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0434 \u042f\u0433\u043e, \u0431\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0456 \u0440\u043e\u0431\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u042f\u043c\u0443 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u042f\u0433\u043e \u0442\u0430\u043a\u0430\u044f, \u043a\u0430\u0431 \u043c\u044b \u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0456\u043c\u044f \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c. \u0406 \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e\u043d\u044b\u044f, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0406\u043c \u0411\u043e\u0433\u0443, \u0430 \u0401\u043d \u0411\u043e\u0433 \u0443 \u0456\u043c. \u0406 \u043f\u0430 \u0414\u0443\u0445\u0443, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u045e \u043d\u0430\u043c, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 3, 24; \u043f\u0430\u0440. \u0421\u0456\u0440 1, 9\u0430. 10ab<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0411\u043e\u0436\u044b\u044f, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0411\u043e\u0433\u0443, \u0430 \u0411\u043e\u0433 \u0443 \u0456\u043c.<span style=\"color: #ff0000;\"> *<\/span> \u0406 \u043f\u0430 \u0414\u0443\u0445\u0443, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u045e \u043d\u0430\u043c, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u043f\u0440\u0430\u043b\u0456\u045e \u044f\u0435 \u043d\u0430 \u045e\u0441\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430 \u0414\u0443\u0445\u0443, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u045e \u043d\u0430\u043c, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5072","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">4, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0443\u0445\u0443 \u0432\u0435\u0440\u0446\u0435, \u0430\u043b\u0435 \u043f\u0440\u0430\u0432\u044f\u0440\u0430\u0439\u0446\u0435 \u0434\u0443\u0445\u0430\u045e, \u0446\u0456 \u044f\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430, \u0431\u043e \u0448\u043c\u0430\u0442 \u0456\u043b\u0436\u044d\u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0441\u0432\u0435\u0446\u0435. \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430: \u043a\u043e\u0436\u043d\u044b \u0434\u0443\u0445, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0446\u0435\u043b\u0435, \u0451\u0441\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430. \u0406 \u043a\u043e\u0436\u043d\u044b \u0434\u0443\u0445, \u044f\u043a\u0456 \u043d\u0435 \u0432\u044b\u0437\u043d\u0430\u0435 \u0415\u0437\u0443\u0441\u0430, \u0442\u043e\u0439 \u043d\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430; \u0433\u044d\u0442\u0430 \u0434\u0443\u0445 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u0451\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u0446\u044f\u043f\u0435\u0440 \u0443\u0436\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0446\u0435. \u0414\u0437\u0435\u0446\u0456, \u0432\u044b \u0430\u0434 \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u0456\u0445, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u045e \u0432\u0430\u0441, \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e \u0441\u0432\u0435\u0446\u0435. \u042f\u043d\u044b \u0441\u0430 \u0441\u0432\u0435\u0442\u0443, \u0442\u0430\u043c\u0443 \u0456 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u0441\u0432\u0435\u0442, \u0456 \u0441\u0432\u0435\u0442 \u0441\u043b\u0443\u0445\u0430\u0435 \u0456\u0445. \u041c\u044b \u0430\u0434 \u0411\u043e\u0433\u0430. \u0425\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430, \u0441\u043b\u0443\u0445\u0430\u0435 \u043d\u0430\u0441, \u0445\u0442\u043e \u043d\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0442\u043e\u0439 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0435 \u043d\u0430\u0441. \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u0456 \u043f\u0430\u0437\u043d\u0430\u0451\u043c \u0434\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0434\u0443\u0445\u0430 \u0444\u0430\u043b\u044c\u0448\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0431\u043e \u043b\u044e\u0431\u043e\u045e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430. \u0425\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u043e\u0439 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e. \u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u043d\u0430\u0441 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u0432\u0435\u0442 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e. \u0423 \u0442\u044b\u043c \u043f\u0440\u0430\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e, \u0448\u0442\u043e \u043d\u0435 \u043c\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0411\u043e\u0433\u0430, \u0430 \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 9; \u042f\u043d 3, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0442\u044b\u043c \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u043d\u0430\u0441, \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u045e \u0441\u0432\u0435\u0442, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043c\u0435\u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0441\u0432\u0435\u0442, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043c\u0435\u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5073","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">4, 11-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u044b\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u041a\u0430\u043b\u0456 \u043c\u044b \u043b\u044e\u0431\u0456\u043c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0442\u043e \u0411\u043e\u0433 \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441, \u0456 \u043b\u044e\u0431\u043e\u045e \u042f\u0433\u043e\u043d\u0430\u044f \u045e \u043d\u0430\u0441 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f. \u041f\u0430 \u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u0451\u043c, \u0448\u0442\u043e \u043c\u044b \u0436\u044b\u0432\u0451\u043c \u0443 \u0406\u043c, \u0430 \u0401\u043d \u0443 \u043d\u0430\u0441, \u0448\u0442\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0430\u0434 \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0406 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0448\u0442\u043e \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430, \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443. \u0425\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 &ndash; \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u0443 \u0442\u044b\u043c \u0436\u044b\u0432\u0435 \u0411\u043e\u0433, \u0430 \u0451\u043d \u0443 \u0411\u043e\u0433\u0443. \u0406 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0433. \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e, \u0456 \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0411\u043e\u0433\u0443, \u0456 \u0411\u043e\u0433 \u0443 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u043c \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u045e \u043d\u0430\u0441, \u0448\u0442\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0443 \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430, \u0431\u043e \u044f\u043a\u0456 \u0401\u043d, \u0442\u0430\u043a\u0456\u044f \u0456 \u043c\u044b \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u0423 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u044f\u043c\u0430 \u0441\u0442\u0440\u0430\u0445\u0443, \u0430\u043b\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043f\u0440\u0430\u0433\u0430\u043d\u044f\u0435 \u0441\u0442\u0440\u0430\u0445, \u0431\u043e \u0441\u0442\u0440\u0430\u0445 \u0451\u0441\u0446\u044c \u0437-\u0437\u0430 \u0431\u043e\u044f\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c; \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430, \u0442\u043e\u0439 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043b\u044e\u0431\u0456\u043c \u0411\u043e\u0433\u0430, \u0431\u043e \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441. \u041a\u0430\u043b\u0456 \u0431 \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043b\u044e\u0431\u043b\u044e \u0411\u043e\u0433\u0430&raquo;, \u0430 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c, \u0451\u043d \u0456\u043b\u0433\u0443\u043d, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u043e\u0433\u0430 \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c. \u0406 \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434 \u042f\u0433\u043e \u0442\u0430\u043a\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u0456\u045e \u0456 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u042f\u043d 4, 10. 16\u0430; \u043f\u0430\u0440. \u0406\u0441 63, 8\u0441. 9\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b; <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0433, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0441\u0442\u0430\u045e \u0417\u0431\u0430\u045e\u0446\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0433, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5074","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">5, 1-12<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0413\u044d\u0442\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u0439 \u0451\u0441\u0446\u044c \u043d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0451\u0441\u0446\u044c \u041c\u0435\u0441\u0456\u044f, \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b, \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e, \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u042f\u0433\u043e. \u041f\u0430 \u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u0451\u043c, \u0448\u0442\u043e \u043c\u044b \u043b\u044e\u0431\u0456\u043c \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445, \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u043c \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e. \u0411\u043e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0443 \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c\u0456. \u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0441\u0432\u0435\u0442. \u0406 \u0433\u044d\u0442\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u0439, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0430 \u0441\u0432\u0435\u0442, \u0451\u0441\u0446\u044c \u043d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0441\u0432\u0435\u0442, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0451\u0441\u0446\u044c \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c? \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u043a\u0440\u043e\u045e. \u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u043a\u0440\u043e\u045e; \u0456 \u0414\u0443\u0445 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e, \u0431\u043e \u0414\u0443\u0445 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430. \u0411\u043e \u0442\u0440\u043e\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c: \u0414\u0443\u0445 \u0456 \u0432\u0430\u0434\u0430, \u0456 \u043a\u0440\u043e\u045e, \u0456 \u0433\u044d\u0442\u044b\u044f \u0442\u0440\u044b &ndash; \u0430\u0434\u043d\u043e. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043b\u044e\u0434\u0437\u0435\u0439, \u0442\u043e \u0411\u043e\u0436\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0435, \u0431\u043e \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0435 \u0401\u043d \u0434\u0430\u045e \u043f\u0440\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0442\u043e\u0439 \u043c\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435; \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0440\u044b\u0446\u044c \u0411\u043e\u0433\u0443, \u0442\u043e\u0439 \u0440\u043e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u0456\u043b\u0433\u0443\u043d\u043e\u043c, \u0431\u043e \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044e, \u044f\u043a\u043e\u0435 \u0411\u043e\u0433 \u0434\u0430\u045e \u043f\u0440\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0413\u044d\u0442\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435, \u0456 \u0433\u044d\u0442\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0443 \u0421\u044b\u043d\u0435 \u042f\u0433\u043e\u043d\u044b\u043c. \u0425\u0442\u043e \u043c\u0430\u0435 \u0421\u044b\u043d\u0430, \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430 \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u043d\u0435 \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 5, 6; \u0417\u0430\u0445 13, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u043a\u0440\u043e\u045e, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u043a\u0440\u043e\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0414\u0443\u0445 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e, \u0431\u043e \u0414\u0443\u0445 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0434\u043b\u044f \u0434\u043e\u043c\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043a\u0430\u0431 \u0430\u0431\u043c\u044b\u0446\u044c \u0433\u0440\u044d\u0445 \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0443\u0445 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e, \u0431\u043e \u0414\u0443\u0445 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5075","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430 <span style=\"color: #ff0000;\">5, 13-21<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0433\u044d\u0442\u0430 \u0432\u0430\u043c, \u044f\u043a\u0456\u044f \u0432\u0435\u0440\u044b\u0446\u0435 \u045e \u0456\u043c\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u043c\u0430\u0435\u0446\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0435\u0440, \u044f\u043a\u0456 \u043c\u044b \u043c\u0430\u0435\u043c \u0434\u0430 \u042f\u0433\u043e, \u0451\u0441\u0446\u044c \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u043d\u0435\u0447\u044b\u043c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0432\u043e\u043b\u044f\u0439 \u042f\u0433\u043e\u043d\u0430\u0439, \u0401\u043d \u0447\u0443\u0435 \u043d\u0430\u0441. \u0410 \u043a\u0430\u043b\u0456 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0401\u043d \u0447\u0443\u0435 \u043d\u0430\u0441, \u0430\u0431 \u0447\u044b\u043c \u0431\u044b \u043c\u044b \u043d\u0456 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0456, \u0434\u044b\u043a \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0442\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0431\u0440\u0430\u0442 \u044f\u0433\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u0456 \u0411\u043e\u0433 \u0434\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0410\u043b\u0435 \u0451\u0441\u0446\u044c \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043c\u0443 \u043d\u0435 \u043a\u0430\u0436\u0443, \u043a\u0430\u0431 \u0442\u044b \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0437\u0430 \u0442\u0430\u043a\u043e\u0433\u0430. \u0423\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0433\u0440\u044d\u0445, \u0430\u043b\u0435 \u0451\u0441\u0446\u044c \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0431\u043e \u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u044f\u0433\u043e, \u0456 \u0437\u043b\u044b \u044f\u0433\u043e \u043d\u0435 \u043a\u0440\u0430\u043d\u0430\u0435. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0437\u043b\u044b\u043c. \u0412\u0435\u0434\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430. \u0406 \u043c\u044b &ndash; \u0443 \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c, \u0443 \u0421\u044b\u043d\u0435 \u042f\u0433\u043e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u0401\u043d &ndash; \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433 \u0456 \u0416\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435. \u0414\u0437\u0435\u0446\u0456, \u0441\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f \u0456\u0434\u0430\u043b\u0430\u045e!<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u042f\u043d 5, 20; \u042f\u043d 1, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e; \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0430\u0431&rsquo;\u0432\u044f\u0441\u0446\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0430\u045e \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5076","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0425\u0442\u043e \u0436 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u0442\u043e\u0439 \u043c\u0430\u0435 \u0456 \u0410\u0439\u0446\u0430, \u0456 \u0421\u044b\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b &ndash; \u0434\u0430 \u0412\u044b\u0431\u0440\u0430\u043d\u0430\u0439 \u041f\u0430\u043d\u0456 \u0456 \u044f\u0435 \u0434\u0437\u044f\u0446\u0435\u0439, \u044f\u043a\u0456\u0445 \u044f \u043b\u044e\u0431\u043b\u044e \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f, \u0430\u043b\u0435 \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0437\u043d\u0430\u045e \u043f\u0440\u0430\u045e\u0434\u0443 \u0434\u0437\u0435\u043b\u044f \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0430\u044f \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u043d\u0430\u0441 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437 \u043d\u0430\u043c\u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u041b\u0430\u0441\u043a\u0430, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0430\u0434 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u0410\u0439\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437 \u043d\u0430\u043c\u0456 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0441\u044f\u0440\u043e\u0434 \u0442\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0442\u0430\u043a\u0456\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043f\u0440\u0430\u045e\u0434\u0430\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u044f\u043a\u0443\u044e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u0410\u0439\u0446\u0430. \u0406 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0448\u0443 \u0446\u044f\u0431\u0435, \u041f\u0430\u043d\u0456, \u043d\u0435 \u044f\u043a \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043f\u0456\u0448\u0443\u0447\u044b \u0442\u0430\u0431\u0435, \u0430\u043b\u0435 \u0442\u0443\u044e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u043c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043a\u0430\u0431 \u043c\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. \u041b\u044e\u0431\u043e\u045e \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e\u043d\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u0410 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0433\u044d\u0442\u0430\u044f \u0442\u0430\u044f, \u044f\u043a\u0443\u044e \u0432\u044b \u0447\u0443\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0448\u043c\u0430\u0442 \u0430\u0448\u0443\u043a\u0430\u043d\u0446\u0430\u045e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u045e \u0441\u0432\u0435\u0442, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0446\u0435\u043b\u0435. \u0422\u0430\u043a\u0456 \u0451\u0441\u0446\u044c \u0430\u0448\u0443\u043a\u0430\u043d\u0446\u0430\u043c \u0456 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442\u0430\u043c. \u0417\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u0442\u0430\u0433\u043e, \u043d\u0430\u0434 \u0447\u044b\u043c \u043c\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u043e\u045e\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u043f\u0435\u0440\u0430\u0434 \u0456 \u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u043c\u0430\u0435 \u0411\u043e\u0433\u0430. \u0425\u0442\u043e \u0436 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u0442\u043e\u0439 \u043c\u0430\u0435 \u0456 \u0410\u0439\u0446\u0430, \u0456 \u0421\u044b\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0432\u0430\u0441 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0439\u0446\u0435 \u044f\u0433\u043e \u045e \u0434\u043e\u043c \u0456 \u043d\u0435 \u0432\u0456\u0442\u0430\u0439\u0446\u0435. \u0425\u0442\u043e \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u0435 \u044f\u0433\u043e, \u0442\u043e\u0439 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u044f\u0433\u043e \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u043c\u043d\u043e\u0433\u0430\u0435 \u043c\u0430\u044e \u043d\u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0432\u0430\u043c, \u0430\u043b\u0435 \u043d\u0435 \u0445\u0430\u0447\u0443 \u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u044b \u0430\u0442\u0440\u0430\u043c\u0430\u043d\u0442\u0430\u043c, \u0431\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u0431\u044b\u0446\u044c \u0443 \u0432\u0430\u0441 \u0456 \u043f\u0430\u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0437 \u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435 \u0434\u0437\u0435\u0446\u0456 \u0442\u0432\u0430\u0451\u0439 \u0412\u044b\u0431\u0440\u0430\u043d\u0430\u0439 \u0421\u044f\u0441\u0442\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u042f\u043d 5, 4b; \u0414\u0440\u0433 5, 33\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c, \u044f\u043a\u0443\u044e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u0410\u0439\u0446\u0430, \u043d\u0435 \u044f\u043a \u043d\u043e\u0432\u0443\u044e, \u0430\u043b\u0435 \u0442\u0443\u044e, \u044f\u043a\u0443\u044e \u043c\u0435\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0416\u044b\u0432\u0456\u0446\u0435 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406\u0434\u0437\u0456\u0446\u0435 \u043f\u0430 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a\u0456 \u0432\u0430\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448, \u043a\u0430\u0431 \u0432\u044b \u0436\u044b\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0432\u0456\u0446\u0435 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5077","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u044d\u0446\u044f\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u042f\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b &ndash; \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443 \u0413\u0430\u044e, \u044f\u043a\u043e\u0433\u0430 \u044f \u043b\u044e\u0431\u043b\u044e \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u043c\u0430\u043b\u044e\u0441\u044f, \u043a\u0430\u0431 \u0442\u044b \u0431\u044b\u045e \u0437\u0434\u0430\u0440\u043e\u0432\u044b \u0456 \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u0448\u0447\u0430\u0441\u0446\u0456\u043b\u0430 \u0442\u0430\u0431\u0435, \u044f\u043a \u0448\u0447\u0430\u0441\u0446\u0456\u0446\u044c \u0442\u0432\u0451\u0439 \u0434\u0443\u0448\u044b. \u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0440\u0430 \u0442\u0432\u0430\u044e \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0448\u0442\u043e \u0442\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0448 \u043f\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u044f\u043c\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u044f\u043a \u0447\u0443\u0446\u044c, \u0448\u0442\u043e \u043c\u0430\u0435 \u0434\u0437\u0435\u0446\u0456 \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u0442\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0448 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0432\u0435\u0440\u0430\u044e \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0448 \u0434\u043b\u044f \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430\u045e. \u042f\u043d\u044b \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u043f\u0440\u0430 \u0442\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e. \u041a\u0430\u043b\u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u0448 \u0456\u0445 \u043f\u0430-\u0411\u043e\u0436\u0430\u043c\u0443, \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u043e\u0431\u0456\u0448. \u0411\u043e \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u044f\u043d\u044b \u043f\u0430\u0439\u0448\u043b\u0456, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0435\u0440\u0443\u0447\u044b \u0430\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0443\u0436\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u0430\u043b\u0435 \u0414\u044b\u044f\u0442\u0440\u044d\u0444, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u043d\u0430\u0441. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0443, \u0443\u0437\u0433\u0430\u0434\u0430\u044e \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u043a\u0456, \u044f\u043a\u0456\u044f \u0440\u043e\u0431\u0456\u0446\u044c, \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u044f\u0447\u044b \u043d\u0430\u0441. \u041d\u0435 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0433\u044d\u0442\u044b\u043c, \u0456 \u0441\u0430\u043c \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u043e\u045e, \u0456 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0440\u044b\u043c\u0430\u0446\u044c, \u0434\u044b \u0432\u044b\u0433\u0430\u043d\u044f\u0435 \u0456\u0445 \u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u0437\u043b\u043e, \u0430\u043b\u0435 \u0434\u0430\u0431\u0440\u043e. \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0442\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430 \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0414\u044b\u043c\u0435\u0442\u0440\u044b\u044f \u045e\u0441\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c, \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u045e\u0434\u0430. \u0406 \u043c\u044b \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0430 \u0442\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u043c\u043d\u043e\u0433\u0430\u0435 \u043c\u0435\u045e \u043d\u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u043f\u0456\u0441\u0430\u0446\u044c \u0430\u0442\u0440\u0430\u043c\u0430\u043d\u0442\u0430\u043c \u0456 \u043f\u044f\u0440\u043e\u043c, \u0431\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u0445\u0443\u0442\u043a\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0456 \u043f\u0430\u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u043a\u043e\u0439 \u0442\u0430\u0431\u0435. \u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u044f\u0431\u0440\u044b. \u0406 \u0442\u044b \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u0439 \u0441\u044f\u0431\u0440\u043e\u045e \u043f\u0430\u0439\u043c\u0435\u043d\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 3 \u042f\u043d 11; 1 \u041f 2, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u0434\u0430\u0431\u0440\u043e, \u0430 \u043d\u0435 \u0437\u043b\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0442\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433\u0443 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0437 \u0434\u0443\u043c\u043a\u0430\u044e \u043f\u0440\u0430 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0442\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"5081","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e <span style=\"color: #ff0000;\">8, 5-27<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0423\u0441\u0435, \u043a\u0430\u0433\u043e \u0432\u044f\u0434\u0437\u0435 \u0414\u0443\u0445 \u0411\u043e\u0436\u044b, &ndash; \u0433\u044d\u0442\u0430 \u0421\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0422\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u0430\u0431 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c. \u0410 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u0445\u0430, &ndash; \u0430\u0431 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c. \u0411\u043e \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0446\u0435\u043b\u0430 &ndash; \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0434\u0443\u0445\u0430 &ndash; \u0436\u044b\u0446\u0446\u0451 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439. \u041f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0446\u0435\u043b\u0430 &ndash; \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0456 \u0411\u043e\u0433\u0430, \u0431\u043e \u043d\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0411\u043e\u0436\u0430\u043c\u0443, \u0434\u044b \u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c. \u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0411\u043e\u0433\u0443 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0436 \u043d\u0435 \u045e \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u045e \u0434\u0443\u0445\u0443, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0414\u0443\u0445 \u0411\u043e\u0436\u044b \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441. \u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u0414\u0443\u0445\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043d\u0435 \u043c\u0430\u0435, \u0442\u043e\u0439 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0443 \u0432\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0442\u043e \u0446\u0435\u043b\u0430 \u043c\u0451\u0440\u0442\u0432\u0430\u0435 \u0437-\u0437\u0430 \u0433\u0440\u0430\u0445\u0443, \u0430 \u0434\u0443\u0445 \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0414\u0443\u0445 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0415\u0437\u0443\u0441\u0430, \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441, \u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u0456 \u0432\u0430\u0448\u044b\u044f \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u0446\u0435\u043b\u044b \u0414\u0443\u0445\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u0431\u0440\u0430\u0442\u044b, \u043c\u044b \u0434\u0430\u045e\u0436\u043d\u0456\u043a\u0456 \u043d\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430: \u0431\u043e \u043a\u0430\u043b\u0456 \u0436\u044b\u0432\u044f\u0446\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u043c\u0443\u0441\u0456\u0446\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456; \u0430 \u043a\u0430\u043b\u0456 \u0434\u0443\u0445\u0430\u043c \u0437\u0430\u0431\u0456\u0432\u0430\u0435\u0446\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u0446\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u0435, \u043a\u0430\u0433\u043e \u0432\u044f\u0434\u0437\u0435 \u0414\u0443\u0445 \u0411\u043e\u0436\u044b, &ndash; \u0433\u044d\u0442\u0430 \u0441\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f. \u0411\u043e \u0432\u044b \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0434\u0443\u0445\u0430 \u043d\u044f\u0432\u043e\u043b\u0456, \u043a\u0430\u0431 \u0437\u043d\u043e\u045e \u0431\u0430\u044f\u0446\u0446\u0430, \u0430\u043b\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0414\u0443\u0445\u0430 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043a\u043b\u0456\u0447\u0430\u043c: &laquo;\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430!&raquo; \u0413\u044d\u0442\u044b \u0441\u0430\u043c\u044b \u0414\u0443\u0445 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0434\u0443\u0445\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f. \u0410 \u043a\u0430\u043b\u0456 \u0434\u0437\u0435\u0446\u0456, \u0442\u043e \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b. \u0421\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0446\u0435\u0440\u043f\u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0447\u0430\u043a\u0430\u0435 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u044f \u0441\u044b\u043d\u043e\u045e \u0411\u043e\u0436\u044b\u0445. \u0421\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043f\u0430\u043a\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u043d\u0435 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u0430\u0440\u044b\u045e \u044f\u0433\u043e, \u0443 \u043d\u0430\u0434\u0437\u0435\u0456, \u0448\u0442\u043e \u0456 \u0441\u0430\u043c\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0442\u043b\u0435\u043d\u043d\u044f \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0445\u0432\u0430\u043b\u044b \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0442\u043e\u0433\u043d\u0435 \u0456 \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0430\u0436\u043d\u043e \u0434\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u043e, \u0430\u043b\u0435 \u0456 \u043c\u044b \u0441\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043c\u0430\u0435\u043c \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430, \u0456 \u043c\u044b \u045e \u0441\u0430\u0431\u0435 \u0441\u0442\u043e\u0433\u043d\u0435\u043c, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u0446\u0435\u043b\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u041c\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0437\u0435\u044e. \u0410 \u043d\u0430\u0434\u0437\u0435\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u0451\u0441\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f\u0439. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u044f\u043c\u0443 \u044f\u0448\u0447\u044d \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430? \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u043c, \u0442\u0430\u0434\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0414\u0443\u0445 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u0445 \u043d\u0430\u0448\u044b\u0445, \u0431\u043e \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u0441\u0430\u043c \u0414\u0443\u0445 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b\u043c\u0456. \u0422\u043e\u0439 \u0436\u0430, \u0445\u0442\u043e \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0441\u044d\u0440\u0446\u044b, \u0432\u0435\u0434\u0430\u0435, \u044f\u043a\u0430\u044f \u0434\u0443\u043c\u043a\u0430 \u045e \u0414\u0443\u0445\u0430, \u0431\u043e \u0401\u043d \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u043f\u0430 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 4, 6; 3, 26; 2 \u0426\u0456\u043c 1, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0441\u044b\u043d\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0414\u0443\u0445\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435: \u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u043d\u0435 \u0414\u0443\u0445\u0430 \u0431\u043e\u044f\u0437\u0456, \u0430\u043b\u0435 \u0441\u0456\u043b\u044b, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0414\u0443\u0445\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435: \u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"9010","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456&nbsp;<span style=\"color: #ff0000;\">7, 10-14; 8, 10\u0441; 11, 1-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044c, \u043a\u043d\u044f\u0437\u044c \u0441\u043f\u0430\u043a\u043e\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u044b\u044f \u0434\u043d\u0456: \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u0410\u0445\u0430\u0437\u0430 \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0440\u0430\u0441\u0456 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0437\u043d\u0430\u043a \u0446\u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u0446\u0456 \u0432\u044b\u0441\u043e\u043a\u0430 \u045e\u0433\u0430\u0440\u044b\u00bb. \u0410\u043b\u0435 \u0410\u0445\u0430\u0437 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430\u00bb. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0406\u0441\u0430\u044f: \u00ab\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0436, \u0434\u043e\u043c\u0435 \u0414\u0430\u0432\u0456\u0434\u0430\u045e! \u0426\u0456 \u043c\u0430\u043b\u0430 \u0432\u0430\u043c, \u0448\u0442\u043e \u0434\u0430\u043a\u0443\u0447\u0430\u0435\u0446\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0434\u044b\u043a \u0432\u044b \u044f\u0448\u0447\u044d \u0434\u0430\u043a\u0443\u0447\u0430\u0435\u0446\u0435 \u043c\u0430\u0439\u043c\u0443 \u0411\u043e\u0433\u0443? \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0441\u0430\u043c \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0437\u043d\u0430\u043a: \u0432\u043e\u0441\u044c \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u043d\u0435 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0421\u044b\u043d\u0430, \u0456 \u0434\u0430\u0441\u0446\u044c \u042f\u043c\u0443 \u0456\u043c\u044f \u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044c, \u0431\u043e \u0437 \u043d\u0430\u043c\u0456 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0437 \u043f\u043d\u044f \u0415\u0441\u044d\u0435\u0432\u0430\u0433\u0430, \u0456 \u0430\u0442\u043e\u0436\u044b\u043b\u0430\u043a \u0437 \u043a\u043e\u0440\u0430\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u043e\u0434; \u0456 \u0441\u043f\u0430\u0447\u043d\u0435 \u043d\u0430 \u0456\u043c \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0434\u0443\u0445 \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043c\u043e\u0446\u044b, \u0434\u0443\u0445 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0456 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430. \u041d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0431\u043e\u044f\u0437\u0437\u044e \u041f\u0430\u043d\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u0437 \u043f\u043e\u0433\u043b\u044f\u0434\u0443 \u0432\u0430\u0447\u044d\u0439 \u0441\u0432\u0430\u0456\u0445, \u0456 \u043d\u0435 \u0441\u0430 \u0441\u043b\u044b\u0445\u0443 \u0432\u0443\u0448\u044d\u0439 \u0441\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0440\u044b\u0441\u0443\u0434 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435; \u0436\u0430\u0437\u043b\u043e\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0443\u0434\u0430\u0440\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u0456 \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0431\u2019\u0435 \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430. \u0406 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0431\u0451\u0434\u0440\u0430\u0445 \u044f\u0433\u043e, \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u2013 \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445. \u0422\u0430\u0434\u044b \u0432\u043e\u045e\u043a \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043d\u0451\u043c, \u0456 \u043b\u0435\u0430\u043f\u0430\u0440\u0434 \u0440\u0430\u0437\u0430\u043c \u0437 \u043a\u0430\u0437\u043b\u044f\u043d\u0451\u043c \u0431\u0443\u0434\u0437\u0435 \u043b\u044f\u0436\u0430\u0446\u044c; \u0456 \u0446\u044f\u043b\u044f, \u0456 \u043c\u0430\u043b\u0430\u0434\u044b \u043b\u0435\u045e, \u0456 \u0432\u043e\u043b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c, \u0430 \u043c\u0430\u043b\u044b \u0445\u043b\u043e\u043f\u0447\u044b\u043a \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0433\u0430\u043d\u044f\u0446\u044c \u0456\u0445. \u0406 \u043a\u0430\u0440\u043e\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043c\u044f\u0434\u0437\u0432\u0435\u0434\u0437\u0456\u0446\u0430\u0439, \u0456 \u0434\u0437\u0435\u0446\u0456 \u0456\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u043b\u044f\u0436\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c, \u0456 \u043b\u0435\u045e, \u044f\u043a \u0432\u043e\u043b, \u0431\u0443\u0434\u0437\u0435 \u0435\u0441\u0446\u0456 \u0441\u0430\u043b\u043e\u043c\u0443. \u0406 \u043d\u0435\u043c\u0430\u045e\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0433\u0443\u043b\u044f\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u044e \u0430\u0441\u043f\u0456\u0434\u0430, \u0456 \u0434\u0437\u0456\u0446\u044f \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0435 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u0433\u043d\u044f\u0437\u0434\u0430 \u0433\u0430\u0434\u0437\u044e\u043a\u0456. \u041d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0456 \u0437\u043b\u0430, \u043d\u0456 \u0448\u043a\u043e\u0434\u044b \u043d\u0430 \u045e\u0441\u0451\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b \u041c\u0430\u0451\u0439, \u0431\u043e \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0437\u044f\u043c\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u041f\u0430\u043d\u0430, \u044f\u043a \u0432\u043e\u0434\u0430\u043c\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u043c\u043e\u0440\u0430\u00bb.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 7, 14; 9, 6. 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u043d\u0435 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0421\u044b\u043d\u0430; <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u042f\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0414\u0430\u0440\u0430\u0434\u0447\u044b\u043a, \u0411\u043e\u0433 \u043c\u043e\u0446\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u043d\u0430\u0434 \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u0431\u043e \u0456\u043d\u0448\u0430\u0435:<\/span><br\/><\/p>\r\n\r\n<p>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e<span style=\"color: #ff0000;\">3, 22 \u2013 4, 7<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043c\u044b \u0441\u044b\u043d\u044b \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0430 \u045e\u0441\u0451 \u043f\u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u043c, \u043a\u0430\u0431 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0430\u044e \u0417\u0430\u043a\u043e\u043d\u0443 \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0432\u0435\u0440\u044b. \u0422\u0430\u043c\u0443 \u0417\u0430\u043a\u043e\u043d \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u043c, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443. \u0423\u0441\u0435 \u0432\u044b \u0441\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0411\u043e \u045e\u0441\u0435 \u0432\u044b, \u0445\u0442\u043e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f. \u041d\u044f\u043c\u0430 \u045e\u0436\u043e \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0433\u0440\u044d\u043a\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u0440\u0430\u0431\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u043d\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0431\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f, \u0442\u043e \u0432\u044b \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u043f\u0430\u043a\u0443\u043b\u044c \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430 \u0434\u0437\u0456\u0446\u044f, \u0451\u043d \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u043b\u0443\u0433\u0456, \u0445\u043e\u0446\u044c \u0451\u043d \u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0430\u043b\u0435 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0433\u0430 \u0430\u0439\u0446\u043e\u043c \u0447\u0430\u0441\u0443 \u0430\u043f\u0435\u043a\u0443\u043d\u0430\u043c \u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c. \u0422\u0430\u043a \u0456 \u043c\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u0431\u044b\u043b\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0441\u0442\u044b\u0445\u0456\u044f\u043c \u0441\u0432\u0435\u0442\u0443. \u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0441\u044b\u043d\u044b, \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0414\u0443\u0445\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435: \u00ab\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430!\u00bb \u0422\u0430\u043c\u0443 \u0442\u044b \u045e\u0436\u043e \u043d\u0435 \u0441\u043b\u0443\u0433\u0430, \u0430 \u0441\u044b\u043d, \u0430 \u043a\u0430\u043b\u0456 \u0441\u044b\u043d, \u0442\u043e \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430 \u0411\u043e\u0436\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 4, 4-5; \u042d\u0444 2, 4; \u0420\u044b\u043c 8, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0417\u0430\u043a\u043e\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"9020","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 1-16<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041c\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u044f\u043a \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\"><em><span style=\"color: #ff0000;\"><\/span><\/em>\u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u043b\u0456\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0411\u043e\u0436\u044b\u0445. \u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0436\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c. \u041c\u043d\u0435 \u0436 \u043d\u0435\u0456\u0441\u0442\u043e\u0442\u043d\u0430, \u044f\u043a \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u0435 \u043c\u044f\u043d\u0435 \u0432\u044b \u0446\u0456 \u043b\u044e\u0434\u0441\u043a\u0456 \u0441\u0443\u0434, \u044f \u0456 \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u043d\u0435 \u0441\u0443\u0434\u0436\u0443. \u0411\u043e \u044f \u043d\u0456 \u045e \u0447\u044b\u043c \u0441\u044f\u0431\u0435 \u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u044e, \u0430\u043b\u0435 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435 \u043c\u044f\u043d\u0435. \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043c\u044f\u043d\u0435! \u0422\u0430\u043c\u0443 \u043d\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u0435 \u0437\u0430\u045e\u0447\u0430\u0441\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0430\u0441\u0432\u0435\u0442\u043b\u0456\u0446\u044c \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435 \u045e \u0446\u0435\u043c\u0440\u044b \u0456 \u0432\u044b\u044f\u0432\u0456\u0446\u044c \u043d\u0430\u043c\u0435\u0440\u044b \u0441\u044d\u0440\u0446\u0430\u045e. \u0406 \u0442\u0430\u0434\u044b \u043a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u0430\u0434 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u044f \u0430\u0434\u043d\u0451\u0441 \u0433\u044d\u0442\u0430 \u0434\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0410\u043f\u043e\u043b\u0430\u0441\u0430, \u043a\u0430\u0431 \u0432\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u043d\u0430\u0441 \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430-\u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u045e\u0437\u0432\u044b\u0448\u0430\u043b\u0456\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u043d\u0430\u0434 \u0430\u0434\u043d\u044b\u043c. \u0411\u043e \u0445\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u044b\u043c? \u0428\u0442\u043e \u0436 \u043c\u0430\u0435\u0448 \u0442\u044b, \u0447\u0430\u0433\u043e \u0431 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e? \u0410 \u043a\u0430\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e, \u0442\u043e \u0447\u0430\u043c\u0443 \u0445\u0432\u0430\u043b\u0456\u0448\u0441\u044f, \u043d\u0456\u0431\u044b\u0442\u0430 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e?<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u045e\u0436\u043e \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0456\u0441\u044f, \u0443\u0436\u043e \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0431\u0435\u0437 \u043d\u0430\u0441. \u0406 \u043d\u044f\u0445\u0430\u0439 \u0431\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0456, \u043a\u0430\u0431 \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0447\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456. \u0411\u043e \u044f \u0434\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0441, \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430\u043f\u043e\u0448\u043d\u0456\u043c\u0456, \u044f\u043a \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u0445 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430\u043c \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u043b\u044e\u0434\u0437\u0435\u0439. \u041c\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b \u0436 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435; \u043c\u044b \u0441\u043b\u0430\u0431\u044b\u044f, \u0432\u044b \u0436 \u043c\u043e\u0446\u043d\u044b\u044f; \u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0435, \u0430 \u043c\u044b \u0431\u0435\u0437 \u043f\u0430\u0448\u0430\u043d\u044b. \u041d\u0430\u0432\u0430\u0442 \u0434\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u043c\u044b \u0433\u0430\u043b\u0430\u0434\u0430\u0435\u043c \u0456 \u0441\u043c\u0430\u0433\u043d\u0435\u043c, \u0446\u0435\u0440\u043f\u0456\u043c \u0433\u0430\u043b\u0435\u0447\u0443 \u0456 \u043f\u0430\u0431\u043e\u0456, \u043d\u0435 \u043c\u0430\u0435\u043c \u0434\u043e\u043c\u0443 \u0456 \u0446\u044f\u0436\u043a\u0430 \u043f\u0440\u0430\u0446\u0443\u0435\u043c, \u0437\u0430\u0440\u0430\u0431\u043b\u044f\u044e\u0447\u044b \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u043d\u0430\u0441 \u043f\u0440\u0430\u043a\u043b\u0456\u043d\u0430\u044e\u0446\u044c, \u043c\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c; \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u043c\u044b \u0446\u0435\u0440\u043f\u0456\u043c; \u043a\u0430\u043b\u0456 \u043d\u0430\u0441 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u044e\u0446\u044c, \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f. \u041c\u044b \u0441\u0442\u0430\u043b\u0456 \u044f\u043a \u0441\u043c\u0435\u0446\u0446\u0435 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a \u0430\u0434\u043a\u0456\u0434\u044b \u045e\u0441\u044f\u0433\u043e \u0430\u0436\u043d\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0456\u0448\u0443 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u0432\u0430\u0441, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u0430\u0441 \u044f\u043a \u0441\u0432\u0430\u0456\u0445 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439. \u0411\u043e \u043a\u0430\u043b\u0456 \u0431 \u043d\u0430\u0432\u0430\u0442 \u0432\u044b \u043c\u0435\u043b\u0456 \u0431\u0435\u0437\u043b\u0456\u0447 \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u045e \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0443 \u0432\u0430\u0441 \u0443\u0441\u0451 \u0430\u0434\u043d\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0448\u043c\u0430\u0442 \u0430\u0439\u0446\u043e\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435. \u0414\u044b\u043a \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u043c\u044f\u043d\u0435!<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0436\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u044e \u0432\u0430\u0441 \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u042f \u0436 \u043d\u0430\u0437\u0432\u0430\u045e \u0432\u0430\u0441 \u0441\u044f\u0431\u0440\u0430\u043c\u0456,\u00a0 <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u0447\u0443\u045e \u0430\u0434 \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c. \r\n <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0435\u0434\u0430\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430; \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0432\u043e\u0447\u044b \u0432\u0430\u0448\u044b\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u0447\u0430\u0446\u044c, \u0456 \u0432\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0447\u0443\u044e\u0446\u044c. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0441\u0451.<\/p>\r\n"}, {"GCH_CH_1_ID":"9021","GCH_CH_1_Text":"<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">5, 12-32<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u045e \u043f\u0435\u0440\u0448\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u043e\u0432\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\"><em><span style=\"color: #ff0000;\"><\/span><\/em>\u0420\u0443\u043a\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0431\u044b\u043b\u043e \u045e\u0447\u044b\u043d\u0435\u043d\u0430 \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u0448\u043c\u0430\u0442 \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0446\u0443\u0434\u0430\u045e. \u0423\u0441\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u0433\u0430\u043d\u0430\u043a \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430. \u0417 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u0436\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0441\u043c\u0435\u043b\u044c\u0432\u0430\u045e\u0441\u044f \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445, \u0430 \u043d\u0430\u0440\u043e\u0434 \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u045e \u0456\u0445. \u0423\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0434\u0430\u043b\u0443\u0447\u0430\u043b\u0430\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u0442\u0430\u043a \u0448\u0442\u043e \u0432\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0445\u0432\u043e\u0440\u044b\u0445 \u043d\u0430 \u0432\u0443\u043b\u0456\u0446\u044b \u0456 \u043a\u043b\u0430\u043b\u0456 \u0456\u0445 \u043d\u0430 \u043d\u0430\u0441\u0456\u043b\u043a\u0430\u0445 \u0456 \u043b\u043e\u0436\u043a\u0430\u0445, \u043a\u0430\u0431 \u0445\u043e\u0446\u044c \u0446\u0435\u043d\u044c \u041f\u044f\u0442\u0440\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e, \u0443\u043f\u0430\u043b\u0430 \u043d\u0430 \u043a\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437 \u0456\u0445. \u0421\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0437 \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u0445 \u043c\u044f\u0441\u0442\u044d\u0447\u0430\u043a \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u044b\u0445 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u0434\u0443\u0445\u0430\u043c\u0456, \u0456 \u045e\u0441\u0435 \u044f\u043d\u044b \u0432\u044b\u043b\u0435\u0447\u0432\u0430\u043b\u0456\u0441\u044f. \u0422\u0430\u0434\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0456 \u045e\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c, \u0437 \u043a\u043e\u043b\u0430 \u0441\u0430\u0434\u0443\u043a\u0435\u044f\u045e, \u043f\u043e\u045e\u043d\u044b\u044f \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043a\u0456\u043d\u0443\u043b\u0456 \u0456\u0445 \u0443 \u0433\u0430\u0440\u0430\u0434\u0441\u043a\u0443\u044e \u0442\u0443\u0440\u043c\u0443. \u0410\u043b\u0435 \u043d\u043e\u0447\u0447\u0443 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u0430\u0434\u0447\u044b\u043d\u0456\u045e \u0434\u0437\u0432\u0435\u0440\u044b \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u0432\u044b\u0432\u0435\u045e \u0456\u0445 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b \u0436\u044b\u0446\u0446\u044f \u0433\u044d\u0442\u0430\u0433\u0430\u00bb. \u042f\u043d\u044b \u0436, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e\u0448\u044b\u0441\u044f, \u0443\u0432\u0430\u0439\u0448\u043b\u0456 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c, \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0421\u0456\u043d\u044d\u0434\u0440\u044b\u0451\u043d \u0456 \u045e\u0441\u0456\u0445 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0456 \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u0443, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u041a\u0430\u043b\u0456 \u0436 \u0441\u043b\u0443\u0433\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0456\u0445 \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u044b. \u0412\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f, \u044f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0422\u0443\u0440\u043c\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u0430\u0439 \u0456 \u045e \u043f\u043e\u045e\u043d\u0430\u0439 \u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u0456 \u0432\u0430\u0440\u0442\u0430 \u0441\u0442\u0430\u044f\u043b\u0430 \u043f\u0440\u044b \u0434\u0437\u0432\u044f\u0440\u0430\u0445. \u0410\u0434\u043d\u0430\u043a, \u0430\u0434\u0447\u044b\u043d\u0456\u045e\u0448\u044b, \u043c\u044b \u043d\u0456\u043a\u043e\u0433\u0430 \u0442\u0430\u043c \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456\u00bb. \u041a\u0430\u043b\u0456 \u0434\u0430\u0437\u043e\u0440\u0430\u0446 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f. \u0410\u043b\u0435 \u043d\u0435\u0445\u0442\u0430 \u043f\u0440\u044b\u0431\u044b\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: \u00ab\u0412\u043e\u0441\u044c \u043c\u0443\u0436\u044b, \u044f\u043a\u0456\u0445 \u0432\u044b \u043a\u0456\u043d\u0443\u043b\u0456 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u0443, \u0441\u0442\u0430\u044f\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u00bb.\r\n<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0434\u0430\u0437\u043e\u0440\u0430\u0446 \u043f\u0430\u0439\u0448\u043e\u045e \u0441\u0430 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0456\u0445 \u0431\u0435\u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u043a\u0456\u0434\u0430\u043b\u0456 \u0456\u0445 \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456. \u041a\u0430\u043b\u0456 \u0441\u043b\u0443\u0433\u0456 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0443 \u0421\u0456\u043d\u044d\u0434\u0440\u044b\u0451\u043d, \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0456\u0445: \u00ab\u0426\u0456 \u043d\u0435 \u0441\u0442\u0440\u043e\u0433\u0430 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u043b\u0456 \u043c\u044b \u0432\u0430\u043c \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0443 \u0456\u043c\u044f \u0433\u044d\u0442\u0430\u0435? \u0406 \u0432\u043e\u0441\u044c \u0432\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u045e\u0432\u0435\u0441\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0432\u0430\u0448\u044b\u043c \u0456 \u0445\u043e\u0447\u0430\u0446\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u0443 \u043a\u0440\u044b\u0432\u0456 \u0442\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb. \u041f\u0451\u0442\u0440 \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0422\u0440\u044d\u0431\u0430 \u0441\u043b\u0443\u0445\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043b\u044e\u0434\u0437\u0435\u0439. \u0411\u043e\u0433 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u0456 \u043f\u0430\u0432\u0435\u0441\u0456\u043b\u0456 \u043d\u0430 \u0434\u0440\u044d\u0432\u0435. \u0411\u043e\u0433 \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u042f\u0433\u043e \u043f\u0440\u0430\u0432\u0456\u0446\u0430\u044e \u0441\u0432\u0430\u0451\u0439 \u044f\u043a \u0423\u043b\u0430\u0434\u0430\u0440\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u0443, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044e \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e. \u0406 \u043c\u044b \u0441\u0432\u0435\u0434\u043a\u0456 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u045e, \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u043e\u0433\u0430 \u0411\u043e\u0433 \u0434\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u042f\u043c\u0443\u00bb.\r\n<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u043e\u0446\u0430\u044e \u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430,\u00a0 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u045e\u0441\u0435 \u044f\u043d\u044b \u043c\u0435\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.\r\n <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u0430\u0434\u0432\u0430\u0436\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0441\u0435 \u044f\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_1_ID":"9042","GCH_CH_1_Text":"<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 7 - 5, 8<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u043e\u0446 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u044b \u043c\u0430\u0435\u043c \u0441\u043a\u0430\u0440\u0431 \u0443 \u0433\u043b\u0456\u043d\u044f\u043d\u044b\u0445 \u043d\u0430\u0447\u044b\u043d\u043d\u044f\u0445, \u043a\u0430\u0431 \u0432\u0435\u043b\u0456\u0447 \u043c\u043e\u0446\u044b \u0431\u044b\u043b\u0430 \u0411\u043e\u0436\u0430\u044f, \u0430 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0430\u0434 \u043d\u0430\u0441. \u0423\u0441\u044f\u043b\u044f\u043a \u0443\u0446\u0456\u0441\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u044f. \u041c\u044b \u045e \u0440\u0430\u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0451\u043c\u0441\u044f \u0440\u043e\u0441\u043f\u0430\u0447\u044b. \u041d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u044f. \u0417\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u0433\u0456\u043d\u0435\u043c. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0441\u0456\u043c \u0443 \u0446\u0435\u043b\u0435 \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0441\u0443\u0441\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0435 \u043d\u0430\u0448\u044b\u043c. \u0411\u043e \u043c\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0451\u043c, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0434\u0437\u0451\u043c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0422\u0430\u043a \u0448\u0442\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u043d\u0430\u0441, \u0430 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0443 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0443\u0445 \u0432\u0435\u0440\u044b, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u042f \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e\u00bb, \u0456 \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0442\u0430\u043c\u0443 \u0456 \u043a\u0430\u0436\u0430\u043c, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0456 \u043d\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456. \u0411\u043e \u045e\u0441\u0451 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u043f\u0430\u043c\u043d\u0430\u0436\u044d\u043d\u043d\u0435 \u043b\u0430\u0441\u043a\u0456 \u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u043f\u0430\u0434\u0437\u044f\u043a\u0443 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0456, \u0431\u043e, \u0445\u043e\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u0456 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0442\u043b\u0435\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430. \u041d\u0430\u0448\u0430\u0435 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u043b\u0451\u0433\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0434\u0430\u0435 \u043d\u0430\u043c \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u041c\u044b \u043d\u0435 \u045e\u0437\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u045e \u0431\u0430\u0447\u043d\u0430\u0435, \u0430\u043b\u0435 \u045e \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435 \u2013 \u0447\u0430\u0441\u043e\u0432\u0430\u0435, \u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435 \u2013 \u0432\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0437\u044f\u043c\u043d\u044b \u0434\u043e\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0442\u043e \u0430\u0434 \u0411\u043e\u0433\u0430 \u043c\u0430\u0435\u043c \u0436\u044b\u043b\u043b\u0451 \u2013 \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u044b \u0432\u0435\u0447\u043d\u044b \u0434\u043e\u043c \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u0422\u0430\u043c\u0443 \u043c\u044b \u0456 \u045e\u0437\u0434\u044b\u0445\u0430\u0435\u043c, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u043e\u043c. \u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c, \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f, \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u044b\u043c\u0456. \u0411\u043e \u043c\u044b, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c \u0448\u0430\u0442\u0440\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u043b\u043b\u044f, \u0443\u0437\u0434\u044b\u0445\u0430\u0435\u043c \u043f\u0430\u0434 \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0431\u043e \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0440\u0430\u0441\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u0430\u043b\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u0431\u044b\u043b\u043e \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0442\u0430 \u0436\u044b\u0446\u0446\u0451\u043c. \u0410 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u0434\u0430\u045e \u043d\u0430\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0445\u0432\u0456\u043b\u0456\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0446\u0435\u043b\u0435, \u043c\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430. \u0411\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043c\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u044f. \u0410\u0434\u043d\u0430\u043a, \u043c\u0430\u044e\u0447\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c, \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0445\u043e\u0447\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 5, 11. 12\u0430. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0432\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u0441 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0446\u044c, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0456 \u045e\u0441\u044f\u043b\u044f\u043a \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0437\u0430 \u041c\u044f\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0432\u0430\u0448\u0430 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u0433\u043e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0431\u043e \u0456\u0445 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"9050","GCH_CH_1_Text":"<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0426\u0456\u0442\u0430&nbsp;<span style=\"color: #ff0000;\">1, 7-11; 2, 1-8<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0412\u0443\u0447\u044d\u043d\u043d\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u043f\u0440\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0411\u0456\u0441\u043a\u0443\u043f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b, \u044f\u043a \u0411\u043e\u0436\u044b \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a, \u043d\u0435 \u0434\u0437\u0451\u0440\u0437\u043a\u0456, \u043d\u0435 \u0433\u043d\u044f\u045e\u043b\u0456\u0432\u044b, \u043d\u0435 \u043f\u2019\u044f\u043d\u0456\u0446\u0430, \u043d\u0435 \u0437\u0430\u0434\u0437\u0456\u0440\u044b\u0441\u0442\u044b, \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u044b, \u0430\u043b\u0435 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u044b, \u043b\u044e\u0431\u044f\u0447\u044b \u0434\u0430\u0431\u0440\u043e, \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u043f\u0430\u0431\u043e\u0436\u043d\u044b, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b, \u044f\u043a\u0456 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u0431\u044b\u045e \u043c\u043e\u0446\u043d\u044b, \u043c\u043e\u0433 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0443 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u0456 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0451\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445, \u043f\u0443\u0441\u0442\u0430\u0441\u043b\u043e\u0432\u0430\u045e \u0434\u044b \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0441\u044f\u0440\u043e\u0434 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u044f\u043a\u0456\u043c \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u043a\u0440\u044b\u0446\u044c \u0432\u0443\u0441\u043d\u044b, \u0431\u043e \u044f\u043d\u044b \u0446\u044d\u043b\u044b\u044f \u0434\u0430\u043c\u044b \u0440\u0443\u0439\u043d\u0443\u044e\u0446\u044c, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0434\u0437\u0435\u043b\u044f \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435 \u043a\u0430\u0436\u044b, \u0448\u0442\u043e \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u043c\u0443 \u0432\u0443\u0447\u044d\u043d\u043d\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u044f, \u0433\u043e\u0434\u043d\u044b\u044f \u043f\u0430\u0448\u0430\u043d\u044b, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f, \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u044f \u045e \u0432\u0435\u0440\u044b, \u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u0443 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0442\u0430\u043a, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u043c, \u043d\u0435 \u0430\u0431\u043c\u0430\u045e\u043b\u044f\u0446\u044c, \u043d\u0435 \u0431\u044b\u0446\u044c \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u0430\u043c\u0456 \u0432\u0456\u043d\u0430, \u0430\u043b\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043c\u0443. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0446\u044c \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d \u043a\u0430\u0445\u0430\u0446\u044c \u043c\u0443\u0436\u043e\u045e, \u043b\u044e\u0431\u0456\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439, \u0431\u044b\u0446\u044c \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u043c\u0456, \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u044b\u043c\u0456, \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u044b\u043d\u044f\u043c\u0456, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0441\u0432\u0430\u0456\u043c \u043c\u0443\u0436\u0430\u043c, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u043b\u0430\u0441\u044f \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042e\u043d\u0430\u043a\u043e\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0443\u0447\u044b \u0431\u044b\u0446\u044c \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u043c\u0456. \u0412\u0430 \u045e\u0441\u0456\u043c \u0434\u0430\u0432\u0430\u0439 \u0441\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u0443 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0435 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0441\u0446\u044c, \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0441\u043b\u043e\u0432\u0430 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u0435, \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u0430\u0435, \u043a\u0430\u0431 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a \u0431\u044b\u045e \u043f\u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0456 \u043d\u0435 \u043c\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u043d\u0430\u0441 \u043d\u0456\u0447\u043e\u0433\u0430 \u043a\u0435\u043f\u0441\u043a\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0437 20, 28; 1 \u041a\u0430\u0440 4, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0456\u043b\u044c\u043d\u0443\u0439\u0446\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0411\u043e\u0433 \u043f\u0440\u044b\u0434\u0431\u0430\u045e \u043a\u0440\u044b\u0432\u0451\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0431\u044b\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"9051","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043di\u043ai\u0439\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">2, 1-13. 19-20<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0435\u0446\u0435 \u043f\u0440\u0430\u0446\u0443 \u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0441\u0430\u043c\u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u043d\u0430\u0448 \u043f\u0440\u044b\u0445\u043e\u0434 \u0434\u0430 \u0432\u0430\u0441 \u043d\u0435 \u0431\u044b\u045e \u0434\u0430\u0440\u044d\u043c\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0443 \u0424\u0456\u043b\u0456\u043f\u0430\u0445, \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043c\u044b \u0437\u0430\u0437\u043d\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0430\u0434\u043d\u0430\u043a \u0430\u0434\u0432\u0430\u0436\u044b\u043b\u0456\u0441\u044f \u045e \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u044b\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456. \u0411\u043e \u0437\u0430\u0430\u0445\u0432\u043e\u0442\u0430 \u043d\u0430\u0448\u0430 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u0443, \u0430\u043b\u0435, \u044f\u043a \u043c\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0442\u0430\u043a \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430\u043b\u0435 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e, \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043c\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u043b\u0456\u0441\u044f \u043d\u0456 \u0437 \u043b\u0456\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043d\u0456 \u0437 \u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430\u0439 \u043c\u044d\u0442\u0430\u0439, \u0411\u043e\u0433 \u0441\u0432\u0435\u0434\u043a\u0430. \u041c\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456 \u0441\u043b\u0430\u0432\u044b \u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u043d\u0456 \u045e \u0432\u0430\u0441, \u043d\u0456 \u045e \u0456\u043d\u0448\u044b\u0445. \u042f\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0431\u044b\u0446\u044c \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u0434\u043b\u044f \u0432\u0430\u0441, \u0430\u043b\u0435 \u043c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456, \u044f\u043a \u043a\u0430\u0440\u043c\u0456\u043b\u0456\u0446\u0430 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0435\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430\u0446\u0443 \u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u043a\u0430\u043b\u0456, \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u045e\u043d\u0430\u0447\u044b \u0456 \u045e\u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u0431 \u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430 \u0437 \u0432\u0430\u0441, \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0435. \u0412\u044b \u0441\u0432\u0435\u0434\u043a\u0456 \u0456 \u0411\u043e\u0433, \u044f\u043a \u0441\u0432\u044f\u0442\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430 \u043c\u044b \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0432\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0432\u0430\u0441, \u044f\u043a \u0431\u0430\u0446\u044c\u043a\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u0441\u0432\u0430\u0456\u0445, \u043c\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043b\u0456 \u0456 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u043b\u0456, \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043a\u043b\u0456\u0447\u0430 \u0432\u0430\u0441 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u0448\u0442\u043e \u0432\u044b, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u0447\u0443\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u0433\u043e \u043d\u0435 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0430\u043b\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u044f\u043a \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0432\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0445\u0442\u043e \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u0430\u0431\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0431\u043e \u0432\u044f\u043d\u043e\u043a \u0445\u0432\u0430\u043b\u044b? \u0426\u0456 \u0436 \u043d\u0435 \u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430? \u0411\u043e \u0432\u044b &ndash; \u043d\u0430\u0448\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 20, 28; 1 \u041a\u0430\u0440 4, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0456\u043b\u044c\u043d\u0443\u0439\u0446\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0431\u044b\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0431\u044b\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"9081","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">5, 1-15<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f &ndash; \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u0434\u0437\u0435\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0441\u0442\u0430\u043d\u0435 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u043f\u0440\u044b\u0446\u0456\u0441\u043a\u0430\u045e \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u045e \u044f\u0433\u043e&not;\u043d\u044b\u043c\u0456 \u0432\u044b\u0441\u0456\u043b\u043a\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c, \u0456\u0445 \u0430\u0445\u043e\u043f\u0456\u0446\u044c \u0436\u0443\u0434\u0430\u0441\u043d\u044b \u0441\u0442\u0440\u0430\u0445, \u0456 \u044f\u043d\u044b \u0437\u0434\u0437\u0456\u0432\u044f\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u044f\u043a \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u042f\u043d\u044b \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0441\u0430\u0431\u0435 \u045e \u0441\u043a\u0440\u0443\u0441\u0435 \u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u0445 \u0434\u0443\u0445\u0443: &laquo;\u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043c\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043b\u0456\u0447\u044b\u043b\u0456 \u043f\u0430\u0441\u043c\u0435\u0448\u044b\u0448\u0447\u0430\u043c \u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u043a\u043f\u0456\u043d\u0430\u045e. \u041c\u044b, \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043b\u0456\u0447\u044b\u043b\u0456 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u044f\u0433\u043e\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430 \u044f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u0430\u043d\u044c\u0431\u0430\u0439. \u042f\u043a \u0436\u0430 \u0432\u044b\u0439\u0448\u043b\u0430, \u0448\u0442\u043e \u0451\u043d \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0411\u043e\u0436\u044b\u0445 \u0421\u044b\u043d\u043e\u045e \u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445 \u042f\u0433\u043e\u043d\u044b \u043b\u0451\u0441?<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u043c\u044b \u0437\u0431\u043e\u0447\u044b\u043b\u0456 \u0437 \u0434\u0430\u0440\u043e\u0433\u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u043b\u0430 \u043d\u0430\u0441, \u0456 \u0441\u043e\u043d\u0446\u0430 \u043d\u0435 \u045e\u0437\u044b\u0448\u043b\u043e \u0434\u043b\u044f \u043d\u0430\u0441. \u041c\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0437\u0433\u0443\u0431\u044b, \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0440\u0430\u0445\u043e\u0434\u043d\u044b\u044f \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0434\u0430\u0440\u043e\u0433\u0456 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u043c \u043d\u0430\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u0448\u0430\u044f \u0434\u0437\u0451\u0440\u0437\u043a\u0430\u0441\u0446\u044c, \u0448\u0442\u043e \u0434\u0430\u043b\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0437 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043d\u043d\u0435\u043c? \u0423\u0441\u0451 \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0446\u0435\u043d\u044c; \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u0432\u0456\u043d\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u043b\u044f\u0442\u0430\u0435; \u0431\u044b\u0446\u0446\u0430\u043c \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c, \u044f\u043a\u0456 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0431\u0443\u0440\u043d\u044b\u044f \u0432\u043e\u0434\u044b: \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043f\u043b\u044b\u0432\u0435, \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0456 \u0441\u043b\u0435\u0434\u0443 \u0441\u044f\u0440\u043e\u0434 \u0445\u0432\u0430\u043b\u044f\u045e; \u044f\u043a \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0434\u043e\u043a\u0430\u0437\u0443, \u0448\u0442\u043e \u043f\u0442\u0443\u0448\u043a\u0430 \u043f\u0440\u0430\u043b\u044f\u0446\u0435\u043b\u0430 \u045e \u043f\u0430\u0432\u0435\u0442\u0440\u044b: \u0434\u0430\u043b\u044f\u0442\u0430\u0435 \u043b\u0451\u0433\u043a\u0456 \u0432\u0435\u0446\u0435\u0440 \u0430\u0434 \u0448\u0443\u043c\u0443 \u043a\u0440\u044b\u043b\u0430\u045e \u0443 \u0440\u0430\u0437\u0440\u044d\u0437\u0430\u043d\u044b\u043c \u0443\u0437\u043c\u0430\u0445\u0430\u043c\u0456 \u043f\u0430\u0432\u0435\u0442\u0440\u044b, \u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0441\u043b\u0435\u0434\u0443. \u041a\u0430\u043b\u0456 \u0441\u0442\u0440\u044d\u043b\u044b, \u043f\u0443\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u043c\u0456\u0448\u044d\u043d\u044c, \u0440\u0430\u0441\u0441\u044f\u043a\u0430\u044e\u0446\u044c \u043f\u0430\u0432\u0435\u0442\u0440\u0430, \u044f\u043d\u043e \u0437\u043d\u043e\u045e \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430, \u0456 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0448, \u044f\u043a \u043f\u0440\u0430\u043b\u044f\u0446\u0435\u043b\u0456. \u0422\u0430\u043a \u0456 \u043c\u044b, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f, \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u043d\u0456\u043a\u043b\u0456 \u0456 \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0437\u043d\u0430\u043a\u0443 \u0446\u043d\u043e\u0442\u044b, \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u043d\u0430\u0441 \u043d\u0430\u0448\u0430 \u0437\u043b\u0430\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0434\u0437\u0435\u044f \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430, \u044f\u043a \u043c\u044f\u043a\u0456\u043d\u0430, \u0448\u0442\u043e \u0440\u0430\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0432\u0435\u0446\u0435\u0440, \u0456 \u044f\u043a \u043b\u0451\u0433\u043a\u0430\u044f \u043f\u0435\u043d\u0430, \u044f\u043a\u0443\u044e \u0440\u0430\u0437\u0430\u0433\u043d\u0430\u043b\u0430 \u0431\u0443\u0440\u0430. \u042f\u043a \u0434\u044b\u043c \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0432\u0435\u0442\u0440\u0443, \u0442\u0430\u043a \u043c\u0456\u043d\u0430\u0435 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0430\u0434\u043d\u0430\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0433\u043e\u0441\u0446\u044f. \u0410 \u0441\u043f\u0440\u0430\u0432\u044f\u043b\u0456\u0432\u044b\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456, \u0456\u0445 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 &ndash; \u0443 \u041f\u0430\u043d\u0443, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 3, 7. 8. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441; \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b; <span style=\"color: #ff0000;\">*<\/span> \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u0442\u043e\u0439 \u0430\u0434 \u0434&rsquo;\u044f\u0431\u043b\u0430, \u0431\u043e \u0434&rsquo;\u044f\u0431\u0430\u043b \u0433\u0440\u0430\u0448\u044b\u0446\u044c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445 \u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u0434&rsquo;\u044f\u0431\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445, \u0442\u043e\u0439 \u0430\u0434 \u0434&rsquo;\u044f\u0431\u043b\u0430, \u0431\u043e \u0434&rsquo;\u044f\u0431\u0430\u043b \u0433\u0440\u0430\u0448\u044b\u0446\u044c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"9082","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">1, 29 &ndash; 2, 16<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0412\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u042f\u0433\u043e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0432\u044f\u0434\u0437\u0435\u0446\u0435 \u0442\u0443\u044e \u0436 \u0431\u0456\u0442\u0432\u0443, \u044f\u043a\u0443\u044e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u043c\u044f\u043d\u0435 \u0456 \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0430\u0434 \u043c\u044f\u043d\u0435 \u0447\u0443\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u043e\u0435 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u0430\u044f \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0443, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u044f\u043a\u043e\u0435 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0435 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435, \u0442\u043e \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u044e, \u043a\u0430\u0431 \u0432\u044b \u0434\u0443\u043c\u0430\u043b\u0456 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u043c\u0435\u043b\u0456 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u044b\u043c\u0456 \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456. \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0434\u0437\u0435\u043b\u044f \u0440\u0430\u0437\u043b\u0430\u0434\u0443 \u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u043f\u0443\u0441\u0442\u043e\u0439 \u043f\u0430\u0445\u0432\u0430\u043b\u044c\u0431\u044b, \u0430\u043b\u0435 \u045e \u043f\u0430\u043a\u043e\u0440\u044b \u043b\u0456\u0447\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0441\u044f\u0431\u0435. \u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u044f\u043a\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0437 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430\u043b\u0435 \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0406 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0441\u0442\u0430\u045e\u0448\u044b, \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439. \u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u042f\u0433\u043e, \u0456 \u0434\u0430\u045e \u042f\u043c\u0443 \u0456\u043c\u044f \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0456\u043c\u044f, \u043a\u0430\u0431 \u043d\u0430 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0441\u0445\u0456\u043b\u0456\u043b\u0430\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u043a\u0430\u043b\u0435\u043d\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445, \u0437\u044f\u043c\u043d\u044b\u0445 \u0456 \u043f\u0430\u0434\u0437\u0435\u043c\u043d\u044b\u0445, \u0456 \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u044f\u0437\u044b\u043a \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u045e, \u0448\u0442\u043e \u041f\u0430\u043d\u0430\u043c \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u0430\u0435, \u044f\u043a \u0432\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u043c\u0430\u0451\u0439, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0446\u044f\u043f\u0435\u0440, \u0443 \u0447\u0430\u0441 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u043c\u0430\u0451\u0439, \u0442\u0430\u043a \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0439\u0446\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0411\u043e \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u0431\u0435\u0437 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f\u045e \u0456 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456, \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u043b\u0436\u044b\u0432\u0430\u0433\u0430 \u0456 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f, \u0443 \u044f\u043a\u0456\u043c \u0432\u044b \u0437\u0437\u044f\u0435\u0446\u0435, \u044f\u043a \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u045e \u0441\u0432\u0435\u0446\u0435. \u0422\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u043d\u0430 \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u043c\u043d\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0448\u0442\u043e \u044f \u043d\u0435 \u043c\u0430\u0440\u043d\u0430 \u0431\u0435\u0433 \u0456 \u043d\u0435 \u043c\u0430\u0440\u043d\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 2, 12-13; \u042f\u043d 15, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0435\u0437 \u041c\u044f\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u0437\u0440\u0430\u0431\u0456\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_1_ID":"9083","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430&nbsp;<span style=\"color: #ff0000;\">3, 7-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0436\u044b, \u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u0436\u044b\u0432\u0443\u0447\u044b \u0437 \u0456\u043c\u0456, \u044f\u043a \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u0430\u043c\u0443 \u0436\u0430\u043d\u043e\u0447\u0430\u043c\u0443 \u043d\u0430\u0447\u044b\u043d\u043d\u044e \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u043b\u0430\u0441\u043a\u0456 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0432\u0430\u0448\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0447\u0443\u043b\u044b\u043c\u0456, \u043b\u044e\u0431\u044f\u0447\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u043e\u045e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456. \u041d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0437\u043b\u043e\u043c \u0437\u0430 \u0437\u043b\u043e \u0446\u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439 \u0437\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0443, \u0430\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435, \u0431\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0434\u043d\u0456, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0437\u044b\u043a \u0430\u0434 \u0437\u043b\u0430, \u0430 \u0432\u0443\u0441\u043d\u044b &ndash; \u0430\u0434 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443. \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u043d\u044f\u0445\u0430\u0439 \u0448\u0443\u043a\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0456\u043c. \u0411\u043e \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0456 \u0432\u0443\u0448\u044b \u042f\u0433\u043e &ndash; \u043d\u0430 \u0456\u0445\u043d\u0456\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0430\u043b\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0443\u043f\u043b\u0456\u045e\u0446\u0430\u043c\u0456 \u0434\u0430\u0431\u0440\u0430, \u0442\u043e \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u0435 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f. \u0410 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f. \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u0434\u0430\u0446\u044c \u0430\u0434\u043a\u0430\u0437 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0432\u0430\u0441 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443 \u043d\u0430\u0434\u0437\u0435\u044e. \u0410\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430, \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0411\u043e\u0436\u0430\u0439 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0443 \u0442\u044b\u043c, \u0437\u0430 \u0448\u0442\u043e \u0430\u0431\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u044f\u043a \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0431\u044b\u043b\u0456 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u0430\u043d\u0456\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u0435\u043f\u0435\u0439, \u043a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0447\u044b\u043c \u0437\u0430 \u0431\u043b\u0430\u0433\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 1, 13. 15; \u041b\u0435\u0432 11, 44<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0443\u0439\u0446\u0435 \u043d\u0430\u0434 \u0443\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0432\u0430\u0441 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0412\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u041f\u0430\u043d, \u0432\u0430\u0448 \u0411\u043e\u0433. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u043e \u042f \u0421\u0432\u044f\u0442\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"9084","GCH_CH_1_Text":"<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e &nbsp;<span style=\"color: #ff0000;\">3, 7 \u2013 4, 1. 4-9<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u041f\u0430\u043d\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0428\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0430\u0431\u044b\u0442\u043a\u0430\u043c, \u0442\u043e\u0435 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0441\u0442\u0440\u0430\u0442\u0430\u0439. \u0414\u044b \u0456 \u045e\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043c\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u044f \u045e\u0441\u0451 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0456 \u043b\u0456\u0447\u0443 \u0441\u043c\u0435\u0446\u0446\u0435\u043c, \u043a\u0430\u0431 \u043d\u0430\u0431\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u045e \u0406\u043c \u043d\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0417\u0430\u043a\u043e\u043d\u0443, \u0430\u043b\u0435 \u0437 \u0442\u043e\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0435\u0440\u044b \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u043d\u0430 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u043d\u0435\u0439\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. \u041d\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u044f \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430 \u0456 \u045e\u0436\u043e \u0441\u0442\u0430\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0430\u043b\u0435 \u044f \u0456\u043c\u043a\u043d\u0443\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u043e\u0435, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u043c\u044f\u043d\u0435 \u0437\u0434\u0430\u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0415\u0437\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u044f \u043d\u0435 \u043b\u0456\u0447\u0443, \u0448\u0442\u043e \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0431\u044b\u0432\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0441\u044f\u0433\u0430\u044e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044d\u0442\u044b \u0456\u043c\u043a\u043d\u0443\u0441\u044f \u0434\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0432\u044b\u0441\u043e\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0443\u0447\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0446\u044c, \u0430 \u043a\u0430\u043b\u0456 \u0456\u043d\u0430\u043a\u0448 \u0434\u0443\u043c\u0430\u0435\u0446\u0435, \u0442\u043e \u0411\u043e\u0433 \u0432\u0430\u043c \u0430\u0434\u043a\u0440\u044b\u0435. \u0410\u0434\u043d\u0430\u043a, \u0434\u0430 \u0447\u0430\u0433\u043e \u043c\u044b \u045e\u0436\u043e \u0434\u0430\u0439\u0448\u043b\u0456, \u0442\u0430\u0433\u043e \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0431\u0440\u0430\u0442\u044b, \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0437\u043e\u0440\u0443, \u044f\u043a\u0456 \u043c\u0430\u0435\u0446\u0435 \u045e \u043d\u0430\u0441. \u0411\u043e \u043c\u043d\u043e\u0433\u0456\u044f, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0447\u0430\u0441\u0442\u0430 \u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0432\u0430\u0442 \u0437 \u043f\u043b\u0430\u0447\u0430\u043c \u043a\u0430\u0436\u0443, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c, \u044f\u043a \u0432\u043e\u0440\u0430\u0433\u0456 \u043a\u0440\u044b\u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430. \u0406\u0445\u043d\u0456 \u043a\u0430\u043d\u0435\u0446 \u2013 \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c, \u0456\u0445\u043d\u0456 \u0431\u043e\u0433 \u2013 \u0447\u044d\u0440\u0430\u0432\u0430, \u0456 \u0441\u043b\u0430\u0432\u0430 \u0456\u0445 \u2013 \u0443 \u0441\u043e\u0440\u0430\u043c\u0435 \u0456\u0445\u043d\u0456\u043c; \u044f\u043d\u044b \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435. \u0410 \u043d\u0430\u0448\u0430 \u0430\u0439\u0447\u044b\u043d\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0430\u0434\u043a\u0443\u043b\u044c \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0417\u0431\u0430\u045e\u0446\u0443, \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u043f\u0440\u0430\u0437 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043c\u043e\u0446\u044b, \u044f\u043a\u043e\u0439 \u0401\u043d \u043c\u043e\u0436\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043f\u0430 \u044f\u043a\u0456\u0445 \u0441\u0443\u043c\u0443\u044e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043d\u0435\u0446 \u043c\u043e\u0439, \u0442\u0430\u043a \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u041f\u0430\u043d\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f!<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u041f\u0430\u043d\u0443. \u042f\u0448\u0447\u044d \u0440\u0430\u0437 \u043a\u0430\u0436\u0443: \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f! \u041b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0434\u043e\u043c\u0430\u044f \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c. \u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430. \u041d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f, \u0430\u043b\u0435 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. \u0406 \u0441\u043f\u0430\u043a\u043e\u0439 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0440\u043e\u0437\u0443\u043c, \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u0443\u043c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0433\u043e\u0434\u043d\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435, \u0448\u0442\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0435, \u0448\u0442\u043e \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043d\u0435\u0439\u043a\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0430\u0431\u043e \u043d\u0435\u0448\u0442\u0430 \u0433\u043e\u0434\u043d\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b \u2013 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u0443\u043c\u0430\u0439\u0446\u0435. \u0427\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u0456 \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u0456 \u043f\u0430\u0447\u0443\u043b\u0456, \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435, \u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435, \u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 12, 35-36; \u041c\u0446 24, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0441\u0446\u0451\u0433\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u043d\u044b\u044f \u0456 \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0430 \u0432\u044b \u2013 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0437 \u0432\u044f\u0441\u0435\u043b\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043c\u0443 \u0447\u0443\u0432\u0430\u0439\u0446\u0435, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0443 \u044f\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0432\u0430\u0448 \u043f\u0440\u044b\u0439\u0434\u0437\u0435. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0440\u0430 \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u0446\u0443: \u041f\u0441 45 (44), 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u043a\u0456\u043d\u0443\u043b\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u045e\u0441\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u044f\u0433\u043e \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u041f\u0430\u043d\u0430 \u043c\u0430\u0439\u0433\u043e, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430; <span style=\"color: #ff0000;\">*<\/span> \u042f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0456 \u0432\u044b\u0431\u0440\u0430\u043b\u0430, \u0443 \u042f\u0433\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430 \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u043b\u043e\u0432\u0430; \u044f \u0441\u043f\u044f\u0432\u0430\u044e \u043f\u0435\u0441\u043d\u044e \u043c\u0430\u044e \u0434\u043b\u044f \u041a\u0430\u0440\u0430\u043b\u044f. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u043b\u0430.<\/p>\r\n"}, {"GCH_CH_1_ID":"9091","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430&nbsp;<span style=\"color: #ff0000;\">31, 10-31<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0416\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0416\u0430\u043d\u0447\u044b\u043d\u0443 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0445\u0442\u043e \u0436 \u0437\u043d\u043e\u0439\u0434\u0437\u0435? \u0426\u0430\u043d\u0430 \u044f\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u044f, \u0447\u044b\u043c \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u045e. \u0414\u0430\u0432\u044f\u0440\u0430\u0435 \u0451\u0439 \u0441\u044d\u0440\u0446\u0430 \u043c\u0443\u0436\u0430 \u044f\u0435, \u0456 \u0451\u043d \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u043f\u0440\u044b\u0431\u044b\u0442\u043a\u0443. \u042f\u043d\u0430 \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0435 \u044f\u043c\u0443 \u0434\u0430\u0431\u0440\u043e\u043c, \u0430 \u043d\u0435 \u0437\u043b\u043e\u043c, \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0448\u0443\u043a\u0430\u0435 \u0432\u043e\u045e\u043d\u0443 \u0456 \u043b\u0451\u043d \u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u0430\u0446\u0443\u0435 \u0440\u0443\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456. \u042f\u043a \u043a\u0443\u043f\u0435\u0446\u043a\u0456 \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c, \u044f\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0435\u0436\u0443 \u0437\u0434\u0430\u043b\u0451\u043a. \u0423\u0441\u0442\u0430\u0435, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u0446\u0451\u043c\u043d\u0430, \u0456 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0432\u0430\u0435 \u0435\u0436\u0430\u0439 \u0434\u043e\u043c, \u0430 \u0441\u043b\u0443\u0433\u0430\u043c \u0440\u0430\u0437\u0434\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0434\u0443\u043c\u0430\u0435 \u043f\u0440\u0430 \u043f\u043e\u043b\u0435 \u0456 \u043a\u0443\u043f\u043b\u044f\u0435 \u044f\u0433\u043e; \u043d\u0430 \u0437\u0430\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0441\u0430\u0434\u0437\u0456\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a. \u042f\u043d\u0430 \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435. \u042f\u0435 \u043b\u044f\u043c\u043f\u0430 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435 \u045e\u043d\u0430\u0447\u044b.<br \/>\u0420\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u0434\u0430 \u043f\u0440\u0431\u0441\u043d\u0456\u0446\u044b, \u0456 \u043f\u0430\u043b\u044c\u0446\u044b \u044f\u0435 \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u0435\u0440\u0430\u0446\u044f\u043d\u043e. \u0414\u0430\u043b\u043e\u043d\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u045e\u0431\u043e\u0433\u0430\u043c\u0443 \u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043f\u0430\u0434\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u043c\u0443. \u0421\u043d\u0435\u0433 \u043d\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u044b \u0434\u043b\u044f \u044f\u0435 \u0434\u043e\u043c\u0443, \u0431\u043e \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u044f\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0441\u0430\u043c\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u044f\u0435 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430 \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u043b\u0451\u043d\u0443 \u0456 \u043f\u0443\u0440\u043f\u0443\u0440\u044b. \u042f\u0435 \u043c\u0443\u0436\u0430 \u043f\u0430\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445, \u043a\u0430\u043b\u0456 \u0451\u043d \u0441\u044f\u0434\u0430\u0435 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043d\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456. \u042f\u043d\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0430\u043b\u0430\u0442\u043d\u043e \u0456 \u043f\u0440\u0430\u0434\u0430\u0435 \u044f\u0433\u043e, \u0456 \u0434\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043a\u0443\u043f\u0446\u0430\u043c \u043f\u0430\u044f\u0441\u044b. \u041c\u043e\u0446 \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c &ndash; \u044f\u0435 \u0441\u0442\u0440\u043e\u0439, \u044f\u043d\u0430 \u045e\u0441\u043c\u0456\u0445\u0430\u0435\u0446\u0446\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0434\u043d\u044f\u043c. \u0410\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0432\u0443\u0441\u043d\u044b, \u0456 \u044f\u0435 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u043f\u043e\u045e\u043d\u044b\u044f \u0432\u0435\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u043e\u0431\u0440\u0430 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043a\u0443 \u0456 \u043d\u0435 \u043a\u0430\u0448\u0442\u0443\u0435 \u0445\u043b\u0435\u0431\u0430 \u043b\u044f\u043d\u043e\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0435 \u0441\u044b\u043d\u044b \u043f\u0430\u0434\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u044f\u0435 \u0441\u0430\u043c\u0430\u0439 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439, \u0430 \u043c\u0443\u0436 \u044f\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u044c: &laquo;\u0428\u043c\u0430\u0442 \u0436\u0430\u043d\u0447\u044b\u043d \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430, \u0430\u043b\u0435 \u0442\u044b \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0448 \u0443\u0441\u0456\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0432\u0430\u0431\u043d\u0430\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0437\u043c\u0430\u043d, \u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c, \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0433\u043e\u0434\u043d\u0430\u044f \u043f\u0430\u0445\u0432\u0430\u043b\u044b. \u0410\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0451\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0446\u044b \u0440\u0443\u043a \u044f\u0435, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u044f\u0446\u044c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u044f\u0435 \u0447\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 31, 17. 18; \u043f\u0430\u0440. \u041f\u0441 46 (45), 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u0430 \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043c\u0443 \u044f\u0435 \u0441\u0432\u0435\u0442\u0430\u0447 \u043d\u0435 \u043f\u0430\u0433\u0430\u0441\u043d\u0435 \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0435 \u044f\u0435 \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456; \u0411\u043e\u0433 \u0436\u044b\u0432\u0435 \u045e \u0451\u0439, \u0456 \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0435\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u044f\u0435 \u0441\u0432\u0435\u0442\u0430\u0447 \u043d\u0435 \u043f\u0430\u0433\u0430\u0441\u043d\u0435 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_1_ID":"9092","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430&nbsp;<span style=\"color: #ff0000;\">3, 1-6. 8-17<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b, \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u0432\u0430\u0456\u043c \u043c\u0443\u0436\u0430\u043c, \u043a\u0430\u0431 \u0442\u044b\u044f \u0437 \u0456\u0445, \u044f\u043a\u0456\u044f \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u0443, \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u0431\u044b\u043b\u0456 \u0437\u0434\u0430\u0431\u044b\u0442\u044b\u044f \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b. \u041d\u044f\u0445\u0430\u0439 \u0430\u0437\u0434\u043e\u0431\u0430\u044e \u0432\u0430\u0448\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435 \u0432\u043e\u043d\u043a\u0430\u0432\u0430\u0435 \u0437\u0430\u043f\u043b\u044f\u0442\u0430\u043d\u043d\u0435 \u0432\u0430\u043b\u0430\u0441\u043e\u045e, \u043d\u0435 \u0437\u0430\u043b\u0430\u0442\u043e\u0435 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0435 \u0446\u0456 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u045e\u043a\u0440\u044b\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u044d\u0440\u0446\u0430 \u045e \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0456 \u0440\u0430\u0445\u043c\u0430\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u0443, \u044f\u043a\u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u0411\u043e \u0433\u044d\u0442\u0430\u043a \u043d\u0435\u043a\u0430\u043b\u0456 \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u0436\u043e\u043d\u043a\u0456, \u044f\u043a\u0456\u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043b\u0456 \u0441\u044f\u0431\u0435, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0441\u0432\u0430\u0456\u043c \u043c\u0443\u0436\u0430\u043c. \u0413\u044d\u0442\u0430\u043a \u0421\u0430\u0440\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0439 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u044f\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c. \u0412\u044b \u0441\u0442\u0430\u043b\u0456 \u044f\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0431\u043e \u0440\u043e\u0431\u0456\u0446\u0435 \u0434\u0430\u0431\u0440\u043e \u0456 \u043d\u0435 \u0431\u0430\u0456\u0446\u0435\u0441\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0447\u0443\u043b\u044b\u043c\u0456, \u043b\u044e\u0431\u044f\u0447\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u043e\u045e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456. \u041d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0437\u043b\u043e\u043c \u0437\u0430 \u0437\u043b\u043e \u0446\u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439 \u0437\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0443, \u0430\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435, \u0431\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0411\u043e \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0434\u043d\u0456, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0437\u044b\u043a \u0430\u0434 \u0437\u043b\u0430, \u0430 \u0432\u0443\u0441\u043d\u044b &ndash; \u0430\u0434 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443. \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u043d\u044f\u0445\u0430\u0439 \u0448\u0443\u043a\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0456\u043c. \u0411\u043e \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0456 \u0432\u0443\u0448\u044b \u042f\u0433\u043e &ndash; \u043d\u0430 \u0456\u0445\u043d\u0456\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0430\u043b\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041f\u0430\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0443\u043f\u043b\u0456\u045e\u0446\u0430\u043c\u0456 \u0434\u0430\u0431\u0440\u0430, \u0442\u043e \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c \u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u0435 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f. \u0410 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0439\u0446\u0435\u0441\u044f. \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u0434\u0430\u0446\u044c \u0430\u0434\u043a\u0430\u0437 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0432\u0430\u0441 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443 \u043d\u0430\u0434\u0437\u0435\u044e. \u0410\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430, \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0411\u043e\u0436\u0430\u0439 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0443 \u0442\u044b\u043c, \u0437\u0430 \u0448\u0442\u043e \u0430\u0431\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u044f\u043a \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0431\u044b\u043b\u0456 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u0430\u043d\u0456\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u0435\u043f\u0435\u0439, \u043a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0447\u044b\u043c \u0437\u0430 \u0431\u043b\u0430\u0433\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 2, 2. 3. 4; 1 \u0422\u044d\u0441 5, 14-15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0446\u0435 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u043b\u0456\u0447\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0441\u044f\u0431\u0435.<span style=\"color: #ff0000;\"> *<\/span> \u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0446\u0435 \u0445\u0432\u043e\u0440\u044b\u0445, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u044f \u0434\u0430 \u045e\u0441\u0456\u0445, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u045e\u0441\u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_1_ID":"9102","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 1-24<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u043b\u0430\u0441\u043a\u0430 \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0437 \u0443\u0441\u0451\u044e \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0437 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u0410\u0434\u0437\u0456\u043d \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0456\u0445, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u0423\u0437\u044b\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456, \u043f\u0430\u043b\u0430\u043d\u0456\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445 \u0456 \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u0440\u044b. \u0410 \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u045e\u0437\u044b\u0448\u043e\u045e\u0448\u044b&raquo;, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0439\u043d\u0456\u0436\u044d\u0439\u0448\u044b\u0445 \u0447\u0430\u0441\u0442\u0430\u043a \u0437\u044f\u043c\u043b\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u044b\u0448\u043e\u045e, \u0451\u0441\u0446\u044c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u0437\u044b\u0448\u043e\u045e \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u0435 \u043d\u044f\u0431\u0451\u0441\u044b, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0451. \u0401\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0430\u0434\u043d\u044b\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0434\u0440\u0443\u0433\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u043c\u0456, \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430 \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0445\u0456\u0441\u0442\u0430\u0435 \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0446\u0435\u0440 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c \u043b\u044e\u0434\u0441\u043a\u0456\u043c, \u0445\u0456\u0442\u0440\u044b\u043c \u0448\u0442\u0443\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0435\u0441\u0446\u0456 \u045e \u0437\u043c\u0430\u043d. \u0410\u043b\u0435, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0443\u0441\u0451 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, &ndash; \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0417 \u042f\u0433\u043e \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0456 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0440\u043e\u0437\u043d\u044b\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u044f \u0441\u0443\u0432\u044f\u0437\u0456, \u0443 \u043c\u0435\u0440\u0443 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u043d\u0430\u0439 \u0447\u0430\u0441\u0442\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0456 \u0441\u0432\u0435\u0434\u0447\u0443 \u045e \u041f\u0430\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u044b\u043b\u0456, \u044f\u043a \u0436\u044b\u0432\u0443\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u045e \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u0437 \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u043c \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u0456\u0445, \u043f\u0440\u0430\u0437 \u0437\u0430\u0446\u0432\u044f\u0440\u0434\u0437\u0435\u043b\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430\u045e \u0456\u0445\u043d\u0456\u0445. \u042f\u043d\u044b, \u0441\u0442\u0430\u045e\u0448\u044b \u043d\u044f\u0447\u0443\u043b\u044b\u043c\u0456, \u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0441\u043f\u0443\u0441\u0446\u0435, \u0440\u043e\u0431\u044f\u0447\u044b \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0433\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u042f\u0433\u043e \u0456 \u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u045e \u0406\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0415\u0437\u0443\u0441\u0435, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0448\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0437\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u043c\u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u043c\u0456; \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0434\u0443\u0445 \u0432\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0433\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 10, 42. 39<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u043e.<span style=\"color: #ff0000;\"> *<\/span> \u042f\u043d\u0430 \u0432\u044b\u0431\u0440\u0430\u043b\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u043a\u0443, \u044f\u043a\u0430\u044f \u043d\u0435 \u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u045e \u044f\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0435\u043b\u0430 \u043a\u0430\u043b\u044f \u043d\u043e\u0433 \u0415\u0437\u0443\u0441\u0430 \u0456 \u0441\u043b\u0443\u0445\u0430\u043b\u0430 \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u0430 \u0432\u044b\u0431\u0440\u0430\u043b\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u043a\u0443, \u044f\u043a\u0430\u044f \u043d\u0435 \u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u045e \u044f\u0435.<\/p>\r\n"}, {"GCH_CH_1_ID":"9251","GCH_CH_1_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">15, 12-34<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u043d\u0430\u0434\u0437\u0435\u044f \u0432\u0435\u0440\u043d\u044b\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e\u0446\u044c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0442\u043e \u0447\u0430\u043c\u0443 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0432\u0430\u0441 \u043a\u0430\u0436\u0443\u0446\u044c, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u044f\u043c\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445? \u041a\u0430&shy;\u043b\u0456 \u0436 \u043d\u044f\u043c\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0442\u043e \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0430 \u043a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0442\u043e \u043c\u0430\u0440\u043d\u0430\u0435 \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435, \u0456 \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430 \u043c\u0430\u0440\u043d\u0430\u044f. \u0422\u0430\u0434\u044b \u0431 \u043c\u044b \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0411\u043e\u0433\u0430, \u0431\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u0431 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u045e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0446\u044c. \u0411\u043e \u043a\u0430\u043b\u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0446\u044c, \u0442\u043e \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441. \u0410 \u043a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0442\u043e \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430 \u043c\u0430\u0440\u043d\u0430\u044f \u0456 \u0432\u044b \u0434\u0430\u043b\u0435\u0439 \u0443 \u0433\u0440\u0430\u0445\u0430\u0445 \u0432\u0430\u0448\u044b\u0445. \u0422\u0430\u0434\u044b \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0406 \u043a\u0430\u043b\u0456 \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0442\u043e \u043c\u044b \u0441\u0430\u043c\u044b\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u044f \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u0430\u0441\u043d\u0443\u043b\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435. \u0411\u043e, \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b. \u041a\u043e\u0436\u043d\u044b \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441: \u043f\u0435\u0440\u0448\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u043e\u0442\u044b\u043c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443, \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430. \u041a\u0430\u043d\u0435\u0446 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0435\u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443, \u043a\u0430\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443, \u0456 \u0441\u0456\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0401\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435 \u045e\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u0441\u0432\u0430\u0435. \u042f\u043a \u0430\u043f\u043e\u0448\u043d\u0456 \u0432\u043e\u0440\u0430\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0431\u043e \u045e\u0441\u0451 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430 \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f. \u041a\u0430\u043b\u0456 \u0436 \u0441\u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u045e\u0441\u0451 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430, \u0442\u043e \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u042f\u043c\u0443 \u045e\u0441\u0451. \u041a\u0430\u043b\u0456 \u0436 \u0443\u0441\u0451 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u0421\u044b\u043d\u0443, \u0442\u0430\u0434\u044b \u0456 \u0441\u0430\u043c \u0421\u044b\u043d \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0443\u0435\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u042f\u043c\u0443 \u045e\u0441\u0451, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0431\u044b\u045e \u0443\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0448\u0442\u043e \u0436 \u0437\u0440\u043e\u0431\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0445\u0440\u043e\u0441\u0442 \u0434\u0437\u0435\u043b\u044f \u043c\u0451\u0440\u0442\u0432\u044b\u0445? \u041a\u0430\u043b\u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0446\u044c, \u0442\u043e \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u044f\u043d\u044b \u0456 \u0445\u0440\u044b\u0441\u0446\u044f\u0446\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u0456\u0445? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u0456 \u043c\u044b \u043a\u043e\u0436\u043d\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0442\u0440\u0430\u043f\u043b\u044f\u0435\u043c \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443? \u042f \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u044e. \u0421\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u0430\u0448\u0430 \u043f\u0430\u0445\u0432\u0430\u043b\u0430, \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0443\u044e \u043c\u0430\u044e \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u041f\u0430\u043d\u0443 \u043d\u0430\u0448\u044b\u043c. \u041a\u0430\u043b\u0456 \u044f, \u044f\u043a \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a, \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u045e \u042d\u0444\u0435\u0441\u0435 \u0441\u0430 \u0437\u0432\u044f\u0440\u0430\u043c\u0456, \u0442\u043e \u044f\u043a\u0430\u044f \u043c\u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0446\u044c? \u041a\u0430\u043b\u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0446\u044c, \u0431\u0443\u0434\u0437\u0435\u043c \u0435\u0441\u0446\u0456 \u0456 \u043f\u0456\u0446\u044c, \u0431\u043e \u0437\u0430\u045e\u0442\u0440\u0430 \u043f\u0430\u043c\u0440\u043e\u043c. \u041d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435: \u0434\u043e\u0431\u0440\u044b\u044f \u0437\u0432\u044b\u0447\u0430\u0456 \u043f\u0441\u0443\u044e\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u0440\u0430\u0437\u043c\u043e\u0432\u044b. \u0410\u0431\u0443\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0456 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u0435, \u0431\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0411\u043e\u0433\u0430. \u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u0432\u0430\u043c \u043d\u0430 \u0441\u043e\u0440\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 25-26; \u043f\u0430\u0440. \u0410\u043f 20, 13. 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u0411\u043e\u0433 \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435 \u045e\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u042f\u0433\u043e, <span style=\"color: #ff0000;\">*<\/span> \u0430 \u044f\u043a \u0430\u043f\u043e\u0448\u043d\u0456 \u0432\u043e\u0440\u0430\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u0434\u044b \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0430\u0434\u0434\u0430\u0434\u0443\u0446\u044c \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0441\u0432\u0430\u0456\u0445, \u0456 \u0441\u0430\u043c\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0435 \u0432\u043e\u0437\u0435\u0440\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u044f\u043a \u0430\u043f\u043e\u0448\u043d\u0456 \u0432\u043e\u0440\u0430\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_1_ID":"9252","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0435\u0440\u0448\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">15, 35-57<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0425\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u043a\u0430\u0436\u0430: &laquo;\u042f\u043a \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c? \u0423 \u044f\u043a\u0456\u043c \u0446\u0435\u043b\u0435 \u044f\u043d\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c?&raquo; \u041d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b! \u0422\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0441\u0435\u0435\u0448, \u043d\u0435 \u0430\u0436\u044b\u0432\u0435, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043d\u0435 \u043f\u0430\u043c\u0440\u044d. \u0422\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0441\u0435\u0435\u0448, \u0441\u0435\u0435\u0448 \u043d\u0435 \u044f\u043a \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u044f\u043a \u0433\u043e\u043b\u0430\u0435 \u0437\u0435\u0440\u043d\u0435, \u043d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043f\u0448\u0430\u043d\u0456\u0446\u044b \u0446\u0456 \u0447\u0430\u0433\u043e \u0456\u043d\u0448\u0430\u0433\u0430. \u0411\u043e\u0433 \u0436\u0430 \u0434\u0430\u0435 \u044f\u043c\u0443 \u0442\u0430\u043a\u043e\u0435 \u0446\u0435\u043b\u0430, \u044f\u043a \u0445\u043e\u0447\u0430, \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043d\u0430\u0441\u0435\u043d\u043d\u044e \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0446\u0435\u043b\u0430. \u041d\u0435 \u045e\u0441\u0435 \u0446\u0435\u043b\u044b \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u044b\u044f, \u0430\u043b\u0435 \u0430\u0434\u043d\u043e \u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u0456\u043d\u0448\u0430\u0435 \u045e \u0437\u0432\u044f\u0440\u043e\u045e, \u0456\u043d\u0448\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u043f\u0442\u0443\u0448\u0430\u043a, \u044f\u0448\u0447\u044d \u0456\u043d\u0448\u0430\u0435 \u045e \u0440\u044b\u0431. \u0401\u0441\u0446\u044c \u0446\u0435\u043b\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0456 \u0446\u0435\u043b\u044b \u0437\u044f\u043c\u043d\u044b\u044f, \u0430\u043b\u0435 \u0456\u043d\u0448\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445, \u0430 \u0456\u043d\u0448\u0430\u044f &ndash; \u0437\u044f\u043c\u043d\u044b\u0445; \u0456\u043d\u0448\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u0441\u043e\u043d\u0446\u0430, \u0456 \u0456\u043d\u0448\u0430\u044f &ndash; \u043c\u0435\u0441\u044f\u0446\u0430, \u0456\u043d\u0448\u0430\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u0430\u0432\u0430 \u0437\u043e\u0440\u0430\u043a, \u0431\u043e \u0437\u043e\u0440\u043a\u0430 \u0430\u0434 \u0437\u043e\u0440\u043a\u0456 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u043b\u0430\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. \u0421\u0435\u0435\u0446\u0446\u0430 \u045e \u0442\u043b\u0435\u043d\u043d\u0456, \u0443\u0441\u0442\u0430\u0435 \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456; \u0441\u0435\u0435\u0446\u0446\u0430 \u045e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0435, \u0443\u0441\u0442\u0430\u0435 \u045e \u0441\u043b\u0430\u0432\u0435; \u0441\u0435\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0443\u0441\u0442\u0430\u0435 \u045e \u043c\u043e\u0446\u044b; \u0441\u0435\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0443\u0441\u0442\u0430\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430. \u041a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u0437\u044f\u043c\u043d\u043e\u0435 \u0446\u0435\u043b\u0430, \u0451\u0441\u0446\u044c \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435. \u0422\u0430\u043a \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0410\u0434\u0430\u043c \u0441\u0442\u0430\u045e \u0436\u044b\u0432\u043e\u0439 \u0456\u0441\u0442\u043e\u0442\u0430\u0439&raquo;, \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c &ndash; \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c. \u0410\u043b\u0435 \u043d\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0435, \u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u043f\u043e\u0442\u044b\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043f\u044b\u043b\u0443, \u0437\u044f\u043c\u043d\u044b; \u0434\u0440\u0443\u0433\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043d\u0435\u0431\u0430. \u042f\u043a\u0456 \u0431\u044b\u045e \u0437\u044f\u043c\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u0437\u044f\u043c\u043d\u044b\u044f; \u044f\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430. \u0410\u043b\u0435 \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u043e\u045e \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u0456 \u0442\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u044f \u043a\u0430\u0436\u0443 \u0432\u0430\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443: \u043d\u0435 \u045e\u0441\u0435 \u043c\u044b \u043f\u0430\u043c\u0440\u043e\u043c, \u0430\u043b\u0435 \u045e\u0441\u0435 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u043c\u0441\u044f. \u0423 \u043c\u043e\u043c\u0430\u043d\u0442, \u0443 \u0456\u043c\u0433\u043d\u0435\u043d\u043d\u0435 \u0432\u043e\u043a\u0430, \u043d\u0430 \u0433\u0443\u043a \u0430\u043f\u043e\u0448\u043d\u044f\u0439 \u0442\u0440\u0443\u0431\u044b, \u0431\u043e \u044f\u043d\u0430 \u0437\u0430\u0433\u0443\u0447\u044b\u0446\u044c &ndash; \u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u044f\u043a \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u044b\u044f, \u0430 \u043c\u044b \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u043c\u0441\u044f. \u0411\u043e \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u043b\u0435\u043d\u043d\u0430\u0435, \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u0434\u044b \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430: &laquo;\u041f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c. C\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u0421\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0434\u0436\u0430\u043b\u0430?&raquo; \u0414\u0436\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 &ndash; \u0433\u0440\u044d\u0445, \u0430 \u0441\u0456\u043b\u0430 \u0433\u0440\u0430\u0445\u0443 &ndash; \u0437\u0430\u043a\u043e\u043d. \u0411\u043e\u0433\u0443 \u0436 \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 19, 25. 26. 27<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u0440\u0443, \u0448\u0442\u043e \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u043c\u043e\u0439 \u0436\u044b\u0432\u0435 \u0456 \u045e \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u044f \u045e\u0441\u0442\u0430\u043d\u0443 \u0437 \u0437\u044f\u043c\u043b\u0456 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0431\u0430\u0447\u0443 \u0411\u043e\u0433\u0430, \u043c\u0430\u0439\u0433\u043e \u0417\u0431\u0430\u045e\u0446\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0431\u0430\u0447\u0443 \u042f\u0433\u043e \u0441\u0430\u043c; \u0432\u043e\u0447\u044b \u043c\u0430\u0435, \u043d\u0435 \u0456\u043d\u0448\u0430\u0433\u0430, \u0443\u0431\u0430\u0447\u0430\u0446\u044c \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0431\u0430\u0447\u0443 \u0411\u043e\u0433\u0430, \u043c\u0430\u0439\u0433\u043e \u0417\u0431\u0430\u045e\u0446\u0443.<\/p>\r\n"}, {"GCH_CH_1_ID":"9253","GCH_CH_1_Text":"\r\n<p><span style=\"color: #ff0000;\">\u041f\u0415\u0420\u0428\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&nbsp;<span style=\"color: #ff0000;\">4, 16 &ndash; 5, 10<\/span><\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u041a\u0430\u043b\u0456 \u0437\u044f\u043c\u043d\u044b \u0434\u043e\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430, <\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u0442\u043e \u043c\u0430\u0435\u043c \u0432\u0435\u0447\u043d\u044b \u0434\u043e\u043c \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0425\u043e\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u0456 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u0442\u043b\u0435\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430. \u0427\u0430\u0441\u043e\u0432\u0430\u0435 \u043b\u0451\u0433\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435 \u0434\u0430\u0435 \u043d\u0430\u043c \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437\u0432\u0430\u0436\u0430\u0435\u043c \u043d\u0435 \u043d\u0430 \u0431\u0430\u0447\u043d\u0430\u0435, \u0430 \u043d\u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0447\u0430\u0441\u043e\u0432\u0430\u0435, \u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0432\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0437\u044f\u043c\u043d\u044b \u0434\u043e\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0442\u043e \u0430\u0434 \u0411\u043e\u0433\u0430 \u043c\u0430\u0435\u043c \u0436\u044b\u043b\u043b\u0451 &ndash; \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u044b \u0432\u0435\u0447\u043d\u044b \u0434\u043e\u043c \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u0422\u0430\u043c\u0443 \u043c\u044b \u0456 \u045e\u0437\u0434\u044b\u0445\u0430\u0435\u043c, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u043e\u043c. \u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c, \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f, \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u0433\u043e\u043b\u044b\u043c\u0456. \u0411\u043e \u043c\u044b, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c \u0448\u0430\u0442\u0440\u044b, \u0443\u0437\u0434\u044b\u0445\u0430\u0435\u043c \u043f\u0430\u0434 \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0431\u043e \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0440\u0430\u0441\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u0430\u043b\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u0431\u044b\u043b\u043e \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0442\u0430 \u0436\u044b\u0446\u0446\u0451\u043c. \u0410 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u0434\u0430\u045e \u043d\u0430\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0445\u0432\u0456\u043b\u0456\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0446\u0435\u043b\u0435, \u043c\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430. \u0411\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043c\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0431\u0430\u0447\u0430\u043d\u043d\u044f. \u0410\u0434\u043d\u0430\u043a, \u043c\u0430\u044e\u0447\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c, \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0445\u043e\u0447\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443. \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u042f\u043c\u0443, \u0446\u0456 \u0442\u043e \u0431\u0443\u0434\u0443\u0447\u044b \u0437 \u0406\u043c, \u0446\u0456 \u0442\u043e \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u042f\u0433\u043e. \u0411\u043e \u045e\u0441\u0435 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u0440\u0430\u0431\u0456\u045e, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0446\u0435\u043b\u0435: \u0434\u043e\u0431\u0440\u0430\u0435 \u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 51 (50), 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u0431\u043e \u044f \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430, \u0442\u0430\u043c\u0443 \u043c\u0430\u043b\u044e \u0422\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u0447: <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0436\u0430, \u0437\u043d\u0456\u0448\u0447\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0431\u043c\u044b\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0430\u0434 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u043c\u0430\u0456\u0445 \u0456 \u0430\u0447\u044b\u0441\u0446\u0456 \u043c\u044f\u043d\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443 \u043c\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u0437\u043d\u0456\u0448\u0447\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043c\u0430\u0435.<\/p>\r\n"}]
